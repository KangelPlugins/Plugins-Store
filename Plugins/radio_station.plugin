class _PreparedListener(dynamic_proxy(MediaPlayer.OnPreparedListener)):
    def __init__(self, plugin: "RadioStationPlugin", request_id: int, station_name: str):
        super().__init__()
        self._plugin = weakref.ref(plugin)
        self._request_id = request_id
        self._station_name = station_name

    def onPrepared(self, mp: MediaPlayer):
        plugin = self._plugin()
        if plugin is None:
            try:
                mp.release()
            except Exception:
                pass
            return
        plugin._on_prepared(mp, self._request_id, self._station_name)


class _ErrorListener(dynamic_proxy(MediaPlayer.OnErrorListener)):
    def __init__(self, plugin: "RadioStationPlugin", request_id: int, station_name: str):
        super().__init__()
        self._plugin = weakref.ref(plugin)
        self._request_id = request_id
        self._station_name = station_name

    def onError(self, mp: MediaPlayer, what: int, extra: int) -> bool:
        plugin = self._plugin()
        if plugin is not None:
            plugin._on_player_error(mp, self._request_id, self._station_name, what, extra)
        else:
            try:
                mp.release()
            except Exception:
                pass
        return True  # handled — do not call OnCompletion


class _CompletionListener(dynamic_proxy(MediaPlayer.OnCompletionListener)):
    def __init__(self, plugin: "RadioStationPlugin", request_id: int):
        super().__init__()
        self._plugin = weakref.ref(plugin)
        self._request_id = request_id

    def onCompletion(self, mp: MediaPlayer):
        plugin = self._plugin()
        if plugin is not None:
            plugin._on_completion(mp, self._request_id)
        else:
            try:
                mp.release()
            except Exception:
                pass


def _check_https_stream(url: str, timeout: int = SSL_CHECK_TIMEOUT):
    """Validate that `url` is https and completes a real, certificate-verified
    TLS handshake with the target server.

    Returns (True, None) on success, or (False, (error_key, fmt_kwargs)) on
    failure, where error_key/fmt_kwargs are meant to be passed to the plugin's
    localization helper.
    """
    try:
        parsed = urlparse(url)
    except Exception:
        return False, ("err_bad_url", {})

    if parsed.scheme.lower() != "https":
        return False, ("err_not_https", {})

    host = parsed.hostname
    if not host:
        return False, ("err_no_host", {})
    port = parsed.port or 443

    sock = None
    ssock = None
    try:
        context = ssl.create_default_context()
        sock = socket.create_connection((host, port), timeout=timeout)
        ssock = context.wrap_socket(sock, server_hostname=host)
        ssock.getpeercert()
        return True, None
    except ssl.SSLCertVerificationError as e:
        return False, ("err_ssl_invalid", {"error": str(e)})
    except ssl.SSLError as e:
        return False, ("err_ssl_invalid", {"error": str(e)})
    except (socket.timeout, OSError) as e:
        return False, ("err_connect_failed", {"error": str(e)})
    except Exception as e:
        return False, ("err_check_failed", {"error": str(e)})
    finally:
        try:
            if ssock is not None:
                ssock.close()
            elif sock is not None:
                sock.close()
        except Exception:
            pass


class RadioStationPlugin(BasePlugin):
    """Application-wide internet radio player controlled by chat commands."""

    def on_plugin_load(self):
        self._player: Optional[MediaPlayer] = None
        self._pending_player: Optional[MediaPlayer] = None
        self._player_lock = Lock()
        self._request_id = 0
        self._is_loaded = True
        self._is_playing = False
        self._current_station_name = ""
        # Keep strong refs to listeners only while a player exists;
        # they hold weakref back to the plugin.
        self._active_listeners: list = []
        self.add_on_send_message_hook()
        self.log("Radio Station v%s loaded" % __version__)

    def on_plugin_unload(self):
        with self._player_lock:
            self._is_loaded = False
            self._is_playing = False
            self._request_id += 1  # invalidate any in-flight prepare
            active = self._player
            pending = self._pending_player
            self._player = None
            self._pending_player = None
            self._current_station_name = ""
            listeners = list(self._active_listeners)
            self._active_listeners.clear()

        self._release_player(active)
        self._release_player(pending)
        # Drop listener refs so GC can collect them + any bound media objects
        del listeners
        gc.collect()
        self.log("Radio Station unloaded")

    # ── Localization ─────────────────────────────────────────────────────

    def _lang(self) -> str:
        code = ""
        try:
            locale = LocaleController.getInstance().getCurrentLocale()
            code = str(locale.getLanguage()).lower()
        except Exception:
            code = ""
        if not code:
            try:
                from java.util import Locale as _JLocale
                code = str(_JLocale.getDefault().getLanguage()).lower()
            except Exception:
                code = "en"
        return "ru" if code.startswith("ru") else "en"

    def _t(self, key: str, **kwargs) -> str:
        lang = self._lang()
        table = STRINGS.get(lang, STRINGS["en"])
        template = table.get(key) or STRINGS["en"].get(key) or STRINGS["ru"].get(key) or key
        try:
            return template.format(**kwargs)
        except Exception:
            return template

    # ── Station data ────────────────────────────────────────────────────

    def _base_stations(self) -> Tuple[Tuple[str, str], ...]:
        return STATIONS_RU if self._lang() == "ru" else STATIONS_EN

    def _custom_stations(self) -> List[Tuple[str, str]]:
        raw = self.get_setting("custom_stations_json", "[]")
        try:
            data = json.loads(raw) if isinstance(raw, str) else raw
        except Exception:
            return []
        if not isinstance(data, list):
            return []
        result: List[Tuple[str, str]] = []
        for item in data:
            try:
                if isinstance(item, dict):
                    name = str(item.get("name", "")).strip()
                    url = str(item.get("url", "")).strip()
                elif isinstance(item, (list, tuple)) and len(item) == 2:
                    name, url = str(item[0]).strip(), str(item[1]).strip()
                else:
                    continue
                if name and url:
                    result.append((name, url))
            except Exception:
                continue
        return result

    def _save_custom_stations(self, stations: List[Tuple[str, str]]):
        data = [{"name": n, "url": u} for n, u in stations]
        try:
            self.set_setting(
                "custom_stations_json", json.dumps(data, ensure_ascii=False), reload_settings=True
            )
        except Exception as e:
            self.log("Failed to save custom stations: %s" % e)

    def _all_stations(self) -> Tuple[Tuple[str, str], ...]:
        return tuple(self._base_stations()) + tuple(self._custom_stations())

    # ── Custom station management ───────────────────────────────────────

    def _add_custom_station(self, name: str, url: str) -> Tuple[bool, str]:
        """Validate & persist a new custom station. Returns (ok, message)."""
        name = (name or "").strip()
        url = (url or "").strip()

        if not name:
            return False, self._t("err_name_required")
        if len(name) > CUSTOM_NAME_MAX_LEN:
            return False, self._t("err_name_too_long", max=CUSTOM_NAME_MAX_LEN)
        if not url:
            return False, self._t("err_url_required")

        custom = self._custom_stations()
        if any(n.lower() == name.lower() for n, _u in custom):
            return False, self._t("err_duplicate_name")
        if len(custom) >= MAX_CUSTOM_STATIONS:
            return False, self._t("err_limit_reached", max=MAX_CUSTOM_STATIONS)

        ok, err = _check_https_stream(url)
        if not ok:
            key, fmt = err
            return False, self._t(key, **fmt)

        custom.append((name, url))
        self._save_custom_stations(custom)
        return True, self._t("ok_station_added", name=name)

    def _remove_custom_station(self, name: str) -> Tuple[bool, str]:
        name = (name or "").strip()
        if not name:
            return False, self._t("err_name_required")

        custom = self._custom_stations()
        for i, (n, _u) in enumerate(custom):
            if n.lower() == name.lower():
                removed = custom.pop(i)
                self._save_custom_stations(custom)
                return True, self._t("ok_station_removed", name=removed[0])

        base_names = {n.lower() for n, _u in self._base_stations()}
        if name.lower() in base_names:
            return False, self._t("err_cannot_delete_builtin", name=name)
        return False, self._t("err_not_found_custom", name=name)

    def _on_add_custom_click(self, _view=None):
        def worker():
            name = str(self.get_setting("new_station_name", "")).strip()
            url = str(self.get_setting("new_station_url", "")).strip()
            ok, message = self._add_custom_station(name, url)
            if ok:
                self.set_setting("new_station_name", "", reload_settings=False)
                self.set_setting("new_station_url", "", reload_settings=True)
                self._show_bulletin(message)
                self._notify_status("added", extra_name=name)
            else:
                self._notify_error(message)

        Thread(target=worker, daemon=True, name="radio-add-station").start()

    def _on_delete_custom_click(self, name: str):
        def worker():
            ok, message = self._remove_custom_station(name)
            if ok:
                self._show_bulletin(message)
                self._notify_status("removed", extra_name=name)
            else:
                self._notify_error(message)

        Thread(target=worker, daemon=True, name="radio-del-station").start()

    def _run_add_station_command(self, name: str, url: str):
        def worker():
            ok, message = self._add_custom_station(name, url)
            if ok:
                self._show_bulletin(message)
                self._notify_status("added", extra_name=name)
            else:
                self._notify_error(message)

        Thread(target=worker, daemon=True, name="radio-cmd-add").start()

    def _run_remove_station_command(self, name: str):
        def worker():
            ok, message = self._remove_custom_station(name)
            if ok:
                self._show_bulletin(message)
                self._notify_status("removed", extra_name=name)
            else:
                self._notify_error(message)

        Thread(target=worker, daemon=True, name="radio-cmd-del").start()

    # ── Settings UI ──────────────────────────────────────────────────────

    def create_settings(self) -> List[Any]:
        return self._build_settings(PAGE_MAIN)

    def _build_settings(self, page_id: str) -> List[Any]:
        subpage = lambda pid: (lambda: self._build_settings(pid))
        t = self._t

        if page_id == PAGE_COMMANDS:
            return [
                Header(text=t("commands_header")),
                Divider(text=t("commands_hint")),
                Text(text=t("cmd_radio"), subtext=t("cmd_radio_sub"), icon="msg_played"),
                Text(text=t("cmd_radio_n"), subtext=t("cmd_radio_n_sub"), icon="msg_list"),
                Text(text=t("cmd_vp"), subtext=t("cmd_vp_sub"), icon="msg_forward"),
                Text(text=t("cmd_nz"), subtext=t("cmd_nz_sub"), icon="msg_reply"),
                Text(text=t("cmd_stop"), subtext=t("cmd_stop_sub"), icon="msg_close"),
                Text(text=t("cmd_add"), subtext=t("cmd_add_sub"), icon="msg_add"),
                Text(text=t("cmd_del"), subtext=t("cmd_del_sub"), icon="msg_delete"),
            ]

        if page_id == PAGE_NOTIFICATIONS:
            notify_on = bool(self.get_setting("notify_saved", True))
            status_text = t("notify_on") if notify_on else t("notify_off")
            return [
                Header(text=t("notif_header")),
                Divider(text=t("notif_status_line", state=status_text)),
                Divider(text=t("notif_explain")),
                Switch(
                    key="notify_saved",
                    text=t("notif_switch"),
                    subtext=t("notif_switch_sub"),
                    default=True,
                    icon="msg_message",
                ),
                Header(text=t("notif_what_header")),
                Divider(text=t("notif_what_1")),
                Divider(text=t("notif_what_2")),
                Divider(text=t("notif_what_3")),
                Divider(text=t("notif_what_4")),
            ]

        if page_id == PAGE_STATIONS:
            stations = self._all_stations()
            base_count = len(self._base_stations())
            current = self._get_station_index()
            entries: List[Any] = [
                Header(text=t("stations_header")),
                Divider(text=t("stations_hint")),
            ]
            for i, (name, url) in enumerate(stations):
                mark = " ▶" if (self._is_playing and i == current) else ""
                tag = t("stations_custom_tag") if i >= base_count else ""
                idx = i

                def make_click(station_index: int):
                    def _on_click(_view):
                        self.set_setting("station_index", station_index, reload_settings=False)
                        self._start_station(station_index)
                        self._notify_status("play")

                    return _on_click

                entries.append(
                    Text(
                        text="%d. %s%s%s" % (i + 1, name, tag, mark),
                        subtext=url,
                        icon="msg_played" if (self._is_playing and i == current) else (
                            "msg_pin" if i >= base_count else "msg_media"
                        ),
                        accent=(i == current),
                        on_click=make_click(idx),
                    )
                )
            entries.append(Header(text=t("stations_control_header")))
            entries.append(
                Text(
                    text=t("stations_stop"),
                    subtext=t("stations_stop_sub"),
                    icon="msg_close",
                    red=True,
                    on_click=lambda _v: (self._stop_playback(), self._notify_status("stop")),
                )
            )
            return entries

        if page_id == PAGE_CUSTOM:
            custom = self._custom_stations()
            entries: List[Any] = [
                Header(text=t("custom_header")),
                Divider(text=t("custom_hint")),
                Input(
                    key="new_station_name",
                    text=t("custom_name_label"),
                    default="",
                    subtext=t("custom_name_sub"),
                    icon="msg_edit",
                ),
                Input(
                    key="new_station_url",
                    text=t("custom_url_label"),
                    default="",
                    subtext=t("custom_url_sub"),
                    icon="msg_link",
                ),
                Text(
                    text=t("custom_add_btn"),
                    subtext=t("custom_add_btn_sub"),
                    icon="msg_add",
                    accent=True,
                    on_click=self._on_add_custom_click,
                ),
                Header(text=t("custom_list_header", count=len(custom), limit=MAX_CUSTOM_STATIONS)),
            ]
            if not custom:
                entries.append(Divider(text=t("custom_empty")))
            else:
                for name, url in custom:
                    entries.append(Text(text=name, subtext=url, icon="msg_media"))

                    def make_delete(station_name: str):
                        def _on_click(_view):
                            self._on_delete_custom_click(station_name)

                        return _on_click

                    entries.append(
                        Text(
                            text=t("custom_delete_prefix", name=name),
                            subtext=t("custom_delete_sub"),
                            icon="msg_delete",
                            red=True,
                            on_click=make_delete(name),
                        )
                    )
            return entries

        if page_id == PAGE_SERVICE:
            playing_value = (
                t("status_playing", name=self._current_station_name)
                if self._is_playing
                else t("status_off")
            )
            return [
                Header(text=t("service_header")),
                Divider(text=t("service_playing", value=playing_value)),
                Divider(text=t("service_hint")),
                Text(
                    text=t("service_force_stop"),
                    subtext=t("service_force_stop_sub"),
                    icon="msg_close",
                    red=True,
                    on_click=lambda _v: self._force_stop_and_cleanup(),
                ),
                Text(
                    text=t("service_reset_index"),
                    subtext=t("service_reset_index_sub"),
                    icon="msg_reset",
                    on_click=lambda _v: self._reset_station_index(),
                ),
                Text(
                    text=t("service_clear_state"),
                    subtext=t("service_clear_state_sub"),
                    icon="msg_delete",
                    red=True,
                    on_click=lambda _v: self._clear_plugin_state(),
                ),
                Header(text=t("service_diag_header")),
                Divider(text=t("service_diag_request", value=self._request_id)),
                Divider(text=t("service_diag_flags", loaded=self._is_loaded, playing=self._is_playing)),
                Divider(text=t("service_diag_listeners", value=len(self._active_listeners))),
                Divider(text=t("service_diag_lang", value=self._lang())),
            ]

        if page_id == PAGE_ABOUT:
            return [
                Header(text=t("about_dev_header")),
                Divider(text="Radio Station v%s" % __version__),
                Text(text=t("about_dev_name"), subtext="@RapFurBitches", icon="msg_contact"),
                Text(text=t("about_channel"), subtext="@ccsFM", icon="msg_channel"),
                Header(text=t("about_plugin_header")),
                Divider(text=t("about_plugin_text")),
                Divider(
                    text=t(
                        "about_count",
                        builtin=len(self._base_stations()),
                        custom=len(self._custom_stations()),
                    )
                ),
                Divider(text=t("about_versions")),
            ]

        # PAGE_MAIN
        status_line = (
            t("status_playing", name=self._current_station_name)
            if self._is_playing
            else t("status_off")
        )
        notify_on = bool(self.get_setting("notify_saved", True))
        notify_label = t("notify_on") if notify_on else t("notify_off")
        custom_count = len(self._custom_stations())
        return [
            Header(text="Radio Station"),
            Divider(text=t("main_header_sub", version=__version__, status=status_line)),
            Header(text=t("main_quick_actions")),
            Text(
                text=t("main_play_current"),
                subtext=t("main_play_current_sub"),
                icon="msg_played",
                accent=True,
                on_click=lambda _v: (self._play_current_station(), self._notify_status("play")),
            ),
            Text(
                text=t("main_stop"),
                subtext=t("main_stop_sub"),
                icon="msg_close",
                red=True,
                on_click=lambda _v: (self._stop_playback(), self._notify_status("stop")),
            ),
            Header(text=t("main_sections")),
            Text(
                text=t("main_commands"),
                subtext=t("main_commands_sub"),
                icon="msg_info",
                accent=True,
                create_sub_fragment=subpage(PAGE_COMMANDS),
            ),
            Text(
                text=t("main_stations"),
                subtext=t("main_stations_sub", count=len(self._all_stations())),
                icon="msg_media",
                accent=True,
                create_sub_fragment=subpage(PAGE_STATIONS),
            ),
            Text(
                text=t("main_custom"),
                subtext=t("main_custom_sub", count=custom_count, limit=MAX_CUSTOM_STATIONS),
                icon="msg_add",
                accent=True,
                create_sub_fragment=subpage(PAGE_CUSTOM),
            ),
            Text(
                text=t("main_notifications"),
                subtext=t("main_notifications_sub", state=notify_label),
                icon="msg_message",
                accent=True,
                create_sub_fragment=subpage(PAGE_NOTIFICATIONS),
            ),
            Text(
                text=t("main_service"),
                subtext=t("main_service_sub"),
                icon="msg_settings",
                accent=True,
                create_sub_fragment=subpage(PAGE_SERVICE),
            ),
            Text(
                text=t("main_about"),
                subtext="@RapFurBitches  ·  @ccsFM",
                icon="msg_contact",
                create_sub_fragment=subpage(PAGE_ABOUT),
            ),
            Header(text=t("main_short")),
            Divider(text=t("main_short_line")),
            Divider(text=t("main_notify_line", state=notify_label)),
        ]

    # ── Service actions ──────────────────────────────────────────────────

    def _force_stop_and_cleanup(self):
        self._stop_playback()
        with self._player_lock:
            self._active_listeners.clear()
        gc.collect()
        self._show_bulletin(self._t("ok_force_stop"))

    def _reset_station_index(self):
        self.set_setting("station_index", 0, reload_settings=False)
        self._show_bulletin(self._t("ok_index_reset"))

    def _clear_plugin_state(self):
        self._stop_playback()
        self.set_setting("station_index", 0, reload_settings=False)
        with self._player_lock:
            self._active_listeners.clear()
            self._current_station_name = ""
        gc.collect()
        self._show_bulletin(self._t("ok_state_cleared"))

    # ── Command hook ────────────────────────────────────────────────────

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        message = getattr(params, "message", None)
        if not isinstance(message, str):
            return HookResult()

        raw = message.strip()
        command = raw.lower()
        if not command:
            return HookResult()

        handled = False

        if command == ".radio":
            self._play_current_station()
            self._notify_status("play")
            handled = True
        elif command.startswith(".radio add "):
            payload = raw[len(".radio add "):].strip()
            if ";" not in payload:
                self._notify_error(self._t("err_usage_add"))
            else:
                name_part, url_part = payload.split(";", 1)
                self._run_add_station_command(name_part.strip(), url_part.strip())
            handled = True
        elif command.startswith(".radio del "):
            name_part = raw[len(".radio del "):].strip()
            if not name_part:
                self._notify_error(self._t("err_usage_del"))
            else:
                self._run_remove_station_command(name_part)
            handled = True
        elif command.startswith(".radio "):
            arg = command[len(".radio "):].strip()
            stations = self._all_stations()
            if arg.isdigit():
                num = int(arg)
                if 1 <= num <= len(stations):
                    index = num - 1
                    self.set_setting("station_index", index, reload_settings=False)
                    self._start_station(index)
                    self._notify_status("play")
                else:
                    self._notify_error(
                        self._t("err_station_not_found", num=num, max=len(stations))
                    )
            else:
                self._notify_error(self._t("err_usage_radio"))
            handled = True
        elif command == ".vp":
            self._change_station(1)
            self._notify_status("next")
            handled = True
        elif command == ".nz":
            self._change_station(-1)
            self._notify_status("prev")
            handled = True
        elif command == ".stop":
            self._stop_playback()
            self._notify_status("stop")
            handled = True

        if handled:
            return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult()

    # ── Station helpers ─────────────────────────────────────────────────

    def _get_station_index(self) -> int:
        try:
            index = int(self.get_setting("station_index", 0))
        except (TypeError, ValueError):
            index = 0
        stations = self._all_stations()
        if not stations:
            return 0
        return index % len(stations)

    def _change_station(self, step: int):
        stations = self._all_stations()
        if not stations:
            return
        index = (self._get_station_index() + step) % len(stations)
        self.set_setting("station_index", index, reload_settings=False)
        self._start_station(index)

    def _play_current_station(self):
        self._start_station(self._get_station_index())

    def _stop_playback(self):
        self._stop_player()
        with self._player_lock:
            self._is_playing = False
            self._current_station_name = ""

    def _start_station(self, index: int):
        stations = self._all_stations()
        if not stations:
            return
        index = index % len(stations)
        station_name, station_url = stations[index]

        with self._player_lock:
            if not self._is_loaded:
                return
            self._request_id += 1
            request_id = self._request_id
            active_player = self._player
            pending_player = self._pending_player
            self._player = None
            self._pending_player = None
            self._is_playing = False
            self._current_station_name = station_name
            # Drop old listeners so they don't keep dead players alive
            old_listeners = list(self._active_listeners)
            self._active_listeners.clear()

        self._release_player(active_player)
        self._release_player(pending_player)
        del old_listeners

        self.log("Starting radio station: %s (req=%d)" % (station_name, request_id))
        Thread(
            target=self._prepare_and_play,
            args=(request_id, station_name, station_url),
            daemon=True,
            name="radio-prepare-%d" % request_id,
        ).start()

    def _prepare_and_play(self, request_id: int, station_name: str, station_url: str):
        player = None
        try:
            with self._player_lock:
                if not self._is_loaded or request_id != self._request_id:
                    return

            player = MediaPlayer()
            attributes = (
                AudioAttributes.Builder()
                .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
                .setUsage(AudioAttributes.USAGE_MEDIA)
                .build()
            )
            player.setAudioAttributes(attributes)
            player.setDataSource(station_url)

            prepared_l = _PreparedListener(self, request_id, station_name)
            error_l = _ErrorListener(self, request_id, station_name)
            completion_l = _CompletionListener(self, request_id)

            player.setOnPreparedListener(prepared_l)
            player.setOnErrorListener(error_l)
            player.setOnCompletionListener(completion_l)

            with self._player_lock:
                if not self._is_loaded or request_id != self._request_id:
                    self._release_player(player)
                    return
                self._pending_player = player
                self._active_listeners.extend([prepared_l, error_l, completion_l])

            # Non-blocking network prepare — old requests are ignored via request_id
            player.prepareAsync()
        except Exception as error:
            with self._player_lock:
                if self._pending_player is player:
                    self._pending_player = None
                self._is_playing = False
            self.log("Could not start %s: %s" % (station_name, error))
            self._release_player(player)
            self._notify_error(self._t("err_start_failed", name=station_name, error=error))

    def _on_prepared(self, mp: MediaPlayer, request_id: int, station_name: str):
        with self._player_lock:
            if not self._is_loaded or request_id != self._request_id:
                self._release_player(mp)
                if self._pending_player is mp:
                    self._pending_player = None
                return
            try:
                mp.start()
                self._player = mp
                self._pending_player = None
                self._is_playing = True
                self._current_station_name = station_name
                self.log("Radio is playing: %s" % station_name)
            except Exception as e:
                self.log("start() failed for %s: %s" % (station_name, e))
                self._player = None
                self._pending_player = None
                self._is_playing = False
                self._release_player(mp)
                self._notify_error(self._t("err_start_play_failed", name=station_name))

    def _on_player_error(
        self, mp: MediaPlayer, request_id: int, station_name: str, what: int, extra: int
    ):
        with self._player_lock:
            if self._player is mp:
                self._player = None
            if self._pending_player is mp:
                self._pending_player = None
            if request_id == self._request_id:
                self._is_playing = False
        self.log("MediaPlayer error what=%s extra=%s station=%s" % (what, extra, station_name))
        self._release_player(mp)
        if request_id == self._request_id:
            self._notify_error(
                self._t("err_stream_error", name=station_name, what=what, extra=extra)
            )

    def _on_completion(self, mp: MediaPlayer, request_id: int):
        # Streams rarely complete; if they do — treat as stop for this request
        with self._player_lock:
            if self._player is mp and request_id == self._request_id:
                self._player = None
                self._is_playing = False
                self._current_station_name = ""
        self._release_player(mp)

    def _stop_player(self):
        with self._player_lock:
            self._request_id += 1
            active_player = self._player
            pending_player = self._pending_player
            self._player = None
            self._pending_player = None
            self._is_playing = False
            old_listeners = list(self._active_listeners)
            self._active_listeners.clear()
        self._release_player(active_player)
        self._release_player(pending_player)
        del old_listeners

    @staticmethod
    def _release_player(player):
        if player is None:
            return
        try:
            player.setOnPreparedListener(None)
            player.setOnErrorListener(None)
            player.setOnCompletionListener(None)
        except Exception:
            pass
        try:
            if player.isPlaying():
                player.stop()
        except Exception:
            pass
        try:
            player.reset()
        except Exception:
            pass
        try:
            player.release()
        except Exception:
            pass

    # ── Notifications ───────────────────────────────────────────────────

    def _get_self_user_id(self) -> Optional[int]:
        try:
            account = UserConfig.selectedAccount
            return int(UserConfig.getInstance(account).getClientUserId())
        except Exception:
            try:
                return int(UserConfig.getInstance(UserConfig.selectedAccount).clientUserId)
            except Exception:
                self.log("Failed to resolve self user id")
                return None

    def _stations_list_md(self) -> str:
        stations = self._all_stations()
        base_count = len(self._base_stations())
        current = self._get_station_index()
        lines = []
        for i, (name, _url) in enumerate(stations):
            prefix = "▶ " if (self._is_playing and i == current) else ""
            tag = self._t("stations_custom_tag") if i >= base_count else ""
            lines.append("%s`%d.` %s%s" % (prefix, i + 1, name, tag))
        return "\n".join(lines)

    def _build_status_message(self, action: str, **extra) -> str:
        stations = self._all_stations()
        index = self._get_station_index()
        name = stations[index][0] if stations else "—"

        if action == "stop":
            header = self._t("status_header_stop")
            body = self._t("status_body_stop")
        elif action == "next":
            header = self._t("status_header_next")
            body = self._t("status_body_playing", name=name, num=index + 1)
        elif action == "prev":
            header = self._t("status_header_prev")
            body = self._t("status_body_playing", name=name, num=index + 1)
        elif action == "added":
            header = self._t("status_header_added")
            body = self._t("status_body_added", name=extra.get("extra_name", ""))
        elif action == "removed":
            header = self._t("status_header_removed")
            body = self._t("status_body_removed", name=extra.get("extra_name", ""))
        else:
            header = self._t("status_header_play")
            body = self._t("status_body_playing", name=name, num=index + 1)

        commands = self._t("status_commands_block")
        stations_block = self._t("status_stations_block", list=self._stations_list_md())
        return header + "\n" + body + commands + stations_block

    def _notify_status(self, action: str, **extra):
        if not self.get_setting("notify_saved", True):
            return
        peer_id = self._get_self_user_id()
        if not peer_id:
            self._show_bulletin(self._t("err_no_self_id"))
            return
        text = self._build_status_message(action, **extra)

        def _send():
            try:
                send_text(peer_id, text, parse_mode="Markdown")
            except Exception as e:
                self.log("Failed to send status to Saved Messages: %s" % e)
                try:
                    send_text(peer_id, text)
                except Exception as e2:
                    self.log("Fallback send also failed: %s" % e2)

        Thread(target=_send, daemon=True).start()

    def _notify_error(self, message: str):
        peer_id = self._get_self_user_id()
        if peer_id and self.get_setting("notify_saved", True):
            text = "⚠️ **Radio Station**\n%s" % message

            def _send():
                try:
                    send_text(peer_id, text, parse_mode="Markdown")
                except Exception:
                    try:
                        send_text(peer_id, "Radio Station: %s" % message)
                    except Exception:
                        pass

            Thread(target=_send, daemon=True).start()
        self._show_bulletin(message)

    def _show_bulletin(self, message: str):
        def _show():
            try:
                fragment = None
                try:
                    from client_utils import get_last_fragment
                    fragment = get_last_fragment()
                except Exception:
                    pass
                if fragment is not None:
                    BulletinHelper.show_info("Radio Station: %s" % message, fragment)
            except Exception:
                pass

        try:
            run_on_ui_thread(_show)
        except Exception:
            pass
