# -*- coding: utf-8 -*-

import threading
import traceback
from java.util import Locale

from base_plugin import BasePlugin, HookResult, HookStrategy
from android_utils import run_on_ui_thread, log
from ui.bulletin import BulletinHelper

from android.content import Context, Intent
from android.view import KeyEvent
from android.media import AudioManager
from org.telegram.messenger import ApplicationLoader

__id__ = "device_music_controller"
__name__ = "Device Music Controller"
__description__ = "Управляет воспроизведением музыки на устройстве. Команды: .pl, .vd, .vu, .next, .prev"
__version__ = "1.0.5"
__author__ = "@anivdev"
__min_version__ = "11.9.0"
__icon__ = ""


class LocalizationManager:
    def __init__(self):
        self.language = Locale.getDefault().getLanguage()
        self.strings = {
            "ru": {
                "command_sent": "✅ Команда '{0}' отправлена.",
                "error_sending_command": "❌ Ошибка при отправке команды '{0}': {1}",
                "action_play_pause": "Воспроизведение/Пауза",
                "action_pause": "Пауза",
                "action_next": "Следующий трек",
                "action_prev": "Предыдущий трек",
                "action_vol_up": "Громкость увеличена",
                "action_vol_down": "Громкость уменьшена",
                "audio_manager_not_available": "⚠️ AudioManager недоступен",
                "music_is_active": "🎶 Музыка сейчас активна.",
                "music_is_not_active": "🔇 Музыка сейчас неактивна.",
                "status_check_error": "⚠️ Не удалось проверить статус музыки."
            },
            "en": {
                "command_sent": "✅ Command '{0}' sent.",
                "error_sending_command": "❌ Error sending command '{0}': {1}",
                "action_play_pause": "Play/Pause",
                "action_pause": "Pause",
                "action_next": "Next Track",
                "action_prev": "Previous Track",
                "action_vol_up": "Volume Up",
                "action_vol_down": "Volume Down",
                "audio_manager_not_available": "⚠️ AudioManager not available",
                "music_is_active": "🎶 Music is currently active.",
                "music_is_not_active": "🔇 Music is currently not active.",
                "status_check_error": "⚠️ Failed to check music status."
            }
        }

    def get_string(self, key, *args):
        lang_strings = self.strings.get(self.language, self.strings["en"])
        template = lang_strings.get(key, key)
        return template.format(*args) if args else template

class DeviceMusicControllerPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.loc = LocalizationManager()
        self.audio_manager = None
        try:
            context = ApplicationLoader.applicationContext
            if context:
                self.audio_manager = context.getSystemService(Context.AUDIO_SERVICE)
            if not self.audio_manager:
                log(f"[{__id__}] Failed to get AudioManager service during init.")
        except Exception as e:
            log(f"[{__id__}] Error initializing AudioManager: {e}")


    def on_plugin_load(self):
        self.add_on_send_message_hook()
        if not self.audio_manager:
            try:
                context = ApplicationLoader.applicationContext
                if context:
                    self.audio_manager = context.getSystemService(Context.AUDIO_SERVICE)
                if self.audio_manager:
                    log(f"[{__id__}] AudioManager initialized successfully on_plugin_load.")
                else:
                    log(f"[{__id__}] Failed to get AudioManager service on_plugin_load.")
            except Exception as e:
                log(f"[{__id__}] Error initializing AudioManager on_plugin_load: {e}")
        log(f"[{__id__}] plugin loaded successfully.")

    def _send_media_key_event(self, key_code):
        if not self.audio_manager:
            log(f"[{__id__}] AudioManager not available, cannot send media key event.")
            return False
        try:
            log(f"[{__id__}] Attempting to dispatch media key event: {key_code} using AudioManager.")
            down_event = KeyEvent(KeyEvent.ACTION_DOWN, key_code)
            self.audio_manager.dispatchMediaKeyEvent(down_event)

            up_event = KeyEvent(KeyEvent.ACTION_UP, key_code)
            self.audio_manager.dispatchMediaKeyEvent(up_event)

            log(f"[{__id__}] Dispatched media key event: {key_code} via AudioManager")
            return True
        except Exception as e:
            log(f"[{__id__}] Error dispatching media key event {key_code} via AudioManager: {e}\n{traceback.format_exc()}")
            log(f"[{__id__}] Falling back to sendOrderedBroadcast for media key event: {key_code}")
            try:
                context = ApplicationLoader.applicationContext
                if not context:
                    log(f"[{__id__}] ApplicationContext is null for fallback sendOrderedBroadcast.")
                    return False

                down_intent = Intent(Intent.ACTION_MEDIA_BUTTON)
                key_event_down = KeyEvent(KeyEvent.ACTION_DOWN, key_code)
                down_intent.putExtra(Intent.EXTRA_KEY_EVENT, key_event_down)
                context.sendOrderedBroadcast(down_intent, None)

                up_intent = Intent(Intent.ACTION_MEDIA_BUTTON)
                key_event_up = KeyEvent(KeyEvent.ACTION_UP, key_code)
                up_intent.putExtra(Intent.EXTRA_KEY_EVENT, key_event_up)
                context.sendOrderedBroadcast(up_intent, None)
                log(f"[{__id__}] Sent media key event via fallback sendOrderedBroadcast: {key_code}")
                return True
            except Exception as e_broadcast:
                log(f"[{__id__}] Error in fallback sendOrderedBroadcast for media key event {key_code}: {e_broadcast}\n{traceback.format_exc()}")
                return False


    def _adjust_volume(self, direction):
        if not self.audio_manager:
            log(f"[{__id__}] AudioManager not available for volume adjustment.")
            return False
        try:
            self.audio_manager.adjustStreamVolume(AudioManager.STREAM_MUSIC, direction, AudioManager.FLAG_SHOW_UI)
            log(f"[{__id__}] Volume adjusted: direction {direction}")
            return True
        except Exception as e:
            log(f"[{__id__}] Error adjusting volume: {e}\n{traceback.format_exc()}")
            return False

    def on_send_message_hook(self, account, params):
        if not hasattr(params, 'message') or not isinstance(params.message, str):
            return HookResult()

        message_text = params.message.strip().lower()
        command_name = ""
        success = False
        error_detail = "Failed"
        is_control_command = True

        # peer_id_for_message и reply_to_for_message больше не нужны для Bulletin
        # peer_id_for_message = params.peer
        # reply_to_for_message = params.replyToMsg

        if not self.audio_manager and message_text in [".play", ".pause", ".next", ".prev", ".volup", ".voldown", ".musicstatus"]:
             error_detail = self.loc.get_string("audio_manager_not_available")
             command_name = message_text
        elif message_text == ".pl":
            command_name = self.loc.get_string("action_play_pause")
            success = self._send_media_key_event(KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE)
        elif message_text == ".pause":
            command_name = self.loc.get_string("action_pause")
            success = self._send_media_key_event(KeyEvent.KEYCODE_MEDIA_PAUSE)
        elif message_text == ".next":
            command_name = self.loc.get_string("action_next")
            success = self._send_media_key_event(KeyEvent.KEYCODE_MEDIA_NEXT)
        elif message_text == ".prev":
            command_name = self.loc.get_string("action_prev")
            success = self._send_media_key_event(KeyEvent.KEYCODE_MEDIA_PREVIOUS)
        elif message_text == ".vu":
            command_name = self.loc.get_string("action_vol_up")
            success = self._adjust_volume(AudioManager.ADJUST_RAISE)
        elif message_text == ".vd":
            command_name = self.loc.get_string("action_vol_down")
            success = self._adjust_volume(AudioManager.ADJUST_LOWER)
        else:
            is_control_command = False

        if command_name and is_control_command:
            if success:
                run_on_ui_thread(lambda: BulletinHelper.show_info(self.loc.get_string("command_sent", command_name)))
            else:
                final_error_detail = error_detail if error_detail != "Failed" and not self.audio_manager else "Failed"
                run_on_ui_thread(lambda: BulletinHelper.show_error(self.loc.get_string("error_sending_command", command_name, final_error_detail)))
            return HookResult(strategy=HookStrategy.CANCEL)
        elif message_text == ".musicstatus":
             return HookResult(strategy=HookStrategy.CANCEL)

        return HookResult()

