__id__ = "voice_timing"
__name__ = "Voice Timing"
__description__ = "автоматически добавляет тайминг при ответе на голосовые/видео/музыку.\nautomatically adds timing when replying to voice messages, video messages, and music."
__author__ = "@itskotovski & @mishabotov"
__version__ = "2.0"
__icon__ = "DateRegBot_by_MoiStikiBot/17"

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Switch, Input, Divider
from java.util import Locale
from hook_utils import find_class
from android_utils import run_on_ui_thread
from java import jclass

class Locales:
    en = {
        "header_media": "Media Types",
        "header_appearance": "Appearance",
        "voice_title": "Voice messages",
        "round_title": "Video messages",
        "music_title": "Music",
        "format_title": "Timing format",
        "format_hint": "Example: [{time}] or ({time})",
        "suffix_title": "Add to the end",
        "suffix_hint": "Place timing after your text",
        "insert_on_type_title": "Insert when typing",
        "insert_on_type_hint": "Insert timing when you start typing",
        "ignore_zeros_title": "Ignore 00:00",
        "ignore_zeros_hint": "Do not add timing if time is 00:00",
    }
    ru = {
        "header_media": "Типы медиа",
        "header_appearance": "Внешний вид",
        "voice_title": "Голосовые",
        "round_title": "Видеокружки",
        "music_title": "Музыка",
        "format_title": "Формат времени",
        "format_hint": "Пример: [{time}] или ({time})",
        "suffix_title": "В конец сообщения",
        "suffix_hint": "Размещать тайминг после вашего текста",
        "insert_on_type_title": "Вставлять при наборе",
        "insert_on_type_hint": "Вставлять таймкод при наборе",
        "ignore_zeros_title": "Не вставлять 00:00",
        "ignore_zeros_hint": "Не добавлять тайминг, если время равно 00:00",
    }
    default = en

LOCALE = Locale.getDefault().getLanguage()

def localise(key: str) -> str:
    locale_dict = getattr(Locales, LOCALE, Locales.default)
    return locale_dict.get(key, Locales.default.get(key, key))

DEFAULT_FORMAT = "[{time}]"
DEFAULT_VOICE_ENABLED = True
DEFAULT_ROUND_ENABLED = True
DEFAULT_MUSIC_ENABLED = True
DEFAULT_SUFFIX_MODE = False
DEFAULT_INSERT_ON_TYPE = False
DEFAULT_IGNORE_ZEROS = False


def _to_class(value):
    if value is None:
        return None
    try:
        if hasattr(value, "getDeclaredMethods"):
            return value
    except Exception:
        pass
    try:
        return value.getClass()
    except Exception:
        return None


def _find_declared_method(clazz, name: str, argc: int):
    if clazz is None:
        return None
    try:
        methods = clazz.getDeclaredMethods()
    except Exception:
        return None
    for method in methods:
        try:
            if method.getName() != name:
                continue
            if len(method.getParameterTypes()) != argc:
                continue
            return method
        except Exception:
            continue
    return None


def _text_of(value) -> str:
    if value is None:
        return ""
    try:
        return str(value)
    except Exception:
        return ""


class VoiceTimingPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._active = False
        self._classes_ready = False
        self.MediaController = None
        self.EnterViewClass = None
        self._reply_unhook = None
        self._send_button_unhook = None
        self._inserted_reply = None
        self._last_reply = None
        self._field_empty = True
        self._inserting = False

    def on_plugin_load(self):
        self._active = True
        if self._load_classes():
            self._setup_hooks()
        self.add_on_send_message_hook()

    def on_plugin_unload(self):
        self._active = False
        for name in ("_reply_unhook", "_send_button_unhook"):
            unhook = getattr(self, name, None)
            if unhook is not None:
                try:
                    self.unhook_method(unhook)
                except Exception as e:
                    self.log(f"Failed to unhook {name}: {e}")
                setattr(self, name, None)

        self._inserted_reply = None
        self._last_reply = None
        self._inserting = False
        self.MediaController = None
        self.EnterViewClass = None
        self._classes_ready = False

    def _load_classes(self) -> bool:
        if self._classes_ready:
            return True
        try:
            self.MediaController = jclass("org.telegram.messenger.MediaController")
            self.EnterViewClass = _to_class(find_class("org.telegram.ui.Components.ChatActivityEnterView"))
            if self.EnterViewClass is None:
                self.log("ChatActivityEnterView not found")
                return False
            self._classes_ready = True
            return True
        except Exception as e:
            self.log(f"Failed to load classes: {e}")
            return False

    def _setup_hooks(self):
        try:
            method = _find_declared_method(self.EnterViewClass, "setReplyingMessageObject", 3)
            if method is None:
                method = _find_declared_method(self.EnterViewClass, "setReplyingMessageObject", 2)
            if method is None:
                self.log("setReplyingMessageObject not found")
            else:
                method.setAccessible(True)
                self._reply_unhook = self.hook_method(method, ReplyHook(self))
        except Exception as e:
            self.log(f"Failed to hook setReplyingMessageObject: {e}")

        try:
            method = _find_declared_method(self.EnterViewClass, "checkSendButton", 1)
            if method is None:
                self.log("checkSendButton not found")
                return
            method.setAccessible(True)
            self._send_button_unhook = self.hook_method(method, TextChangeHook(self))
        except Exception as e:
            self.log(f"Failed to hook checkSendButton: {e}")

    def create_settings(self):
        return [
            Header(text=localise("header_media")),
            Switch(key="voice_enabled", text=localise("voice_title"), default=DEFAULT_VOICE_ENABLED, icon="msg_voice_unmuted"),
            Switch(key="round_enabled", text=localise("round_title"), default=DEFAULT_ROUND_ENABLED, icon="msg_videocall"),
            Switch(key="music_enabled", text=localise("music_title"), default=DEFAULT_MUSIC_ENABLED, icon="files_music"),
            Divider(),

            Header(text=localise("header_appearance")),
            Input(key="format", text=localise("format_title"), subtext=localise("format_hint"), default=DEFAULT_FORMAT, icon="msg_stories_timer"),
            Switch(key="suffix_mode", text=localise("suffix_title"), subtext=localise("suffix_hint"), default=DEFAULT_SUFFIX_MODE, icon="msg2_chats_add"),
            Switch(key="insert_on_type", text=localise("insert_on_type_title"), subtext=localise("insert_on_type_hint"), default=DEFAULT_INSERT_ON_TYPE, icon="fab_compose_small_solar"),
            Switch(key="ignore_zeros", text=localise("ignore_zeros_title"), subtext=localise("ignore_zeros_hint"), default=DEFAULT_IGNORE_ZEROS, icon="filled_stop_location"),
        ]

    def _flag(self, key: str, default: bool) -> bool:
        try:
            return bool(self.get_setting(key, default))
        except Exception:
            return default

    def _format_time(self, seconds):
        if seconds is None:
            return None
        try:
            total = int(seconds)
        except Exception:
            total = 0
        if total < 0:
            total = 0
        if total == 0 and self._flag("ignore_zeros", DEFAULT_IGNORE_ZEROS):
            return None
        hours, rest = divmod(total, 3600)
        minutes, secs = divmod(rest, 60)
        if hours:
            return f"{hours:02d}:{minutes:02d}:{secs:02d}"
        return f"{minutes:02d}:{secs:02d}"

    def _playback_position(self, reply_msg) -> float:
        if reply_msg is None or not self._load_classes():
            return 0.0
        try:
            controller = self.MediaController.getInstance()
        except Exception:
            return 0.0
        try:
            progress_ms = controller.getProgressMs(reply_msg)
            if progress_ms is not None and progress_ms > 0:
                return float(progress_ms) / 1000.0
        except Exception:
            pass
        try:
            if controller.isPlayingMessage(reply_msg):
                return float(reply_msg.audioProgressSec or 0)
        except Exception:
            pass
        return 0.0

    def _build_timing(self, reply_msg):
        time_str = self._format_time(self._playback_position(reply_msg))
        if not time_str:
            return None
        try:
            fmt = self.get_setting("format", DEFAULT_FORMAT)
        except Exception:
            fmt = DEFAULT_FORMAT
        if not isinstance(fmt, str) or "{time}" not in fmt:
            fmt = DEFAULT_FORMAT
        return fmt.replace("{time}", time_str).strip()

    def _check_reply_type(self, reply_msg) -> bool:
        if reply_msg is None:
            return False
        try:
            if bool(reply_msg.isVoice()):
                return self._flag("voice_enabled", DEFAULT_VOICE_ENABLED)
            if bool(reply_msg.isRoundVideo()):
                return self._flag("round_enabled", DEFAULT_ROUND_ENABLED)
            if bool(reply_msg.isMusic()):
                return self._flag("music_enabled", DEFAULT_MUSIC_ENABLED)
        except Exception:
            return False
        return False

    @staticmethod
    def _reply_key(reply_msg):
        if reply_msg is None:
            return None
        try:
            return (int(reply_msg.getDialogId()), int(reply_msg.getId()))
        except Exception:
            return None

    def on_reply_changed(self, enter_view, reply_msg):
        self._last_reply = self._reply_key(reply_msg)
        self._inserted_reply = None
        text = ""
        if enter_view is not None:
            try:
                text = _text_of(enter_view.getFieldText())
            except Exception:
                text = ""
        self._field_empty = not text.strip()

    def on_field_text_changed(self, enter_view):
        if not self._active or self._inserting or enter_view is None:
            return
        if not self._flag("insert_on_type", DEFAULT_INSERT_ON_TYPE):
            return

        try:
            text = _text_of(enter_view.getFieldText())
        except Exception:
            return

        if not text.strip():
            self._field_empty = True
            return

        was_empty = self._field_empty
        self._field_empty = False

        try:
            reply_msg = enter_view.getReplyingMessageObject()
        except Exception:
            return

        reply_key = self._reply_key(reply_msg)
        if reply_key is None:
            self._last_reply = None
            return
        if reply_key != self._last_reply:
            self._last_reply = reply_key
            self._inserted_reply = None

        if not was_empty or reply_key == self._inserted_reply:
            return
        if not self._check_reply_type(reply_msg):
            return

        timing = self._build_timing(reply_msg)
        if not timing or timing in text:
            return

        self._inserted_reply = reply_key
        self._inserting = True
        suffix = self._flag("suffix_mode", DEFAULT_SUFFIX_MODE)
        run_on_ui_thread(lambda: self._insert_timing(enter_view, timing, suffix))

    def _insert_timing(self, enter_view, timing: str, suffix: bool):
        try:
            if not self._active or enter_view is None:
                return

            edit_field = None
            try:
                edit_field = enter_view.getEditField()
            except Exception:
                edit_field = None

            editable = None
            if edit_field is not None:
                try:
                    editable = edit_field.getText()
                except Exception:
                    editable = None

            current = _text_of(editable) if editable is not None else _text_of(enter_view.getFieldText())
            if not current.strip():
                self._inserted_reply = None
                self._field_empty = True
                return
            if timing in current:
                return

            if editable is not None:
                try:
                    if suffix:
                        position = editable.length()
                        editable.insert(position, " " + timing)
                        edit_field.setSelection(position)
                    else:
                        editable.insert(0, timing + " ")
                        edit_field.setSelection(editable.length())
                    return
                except Exception as e:
                    self.log(f"Editable insert failed: {e}")

            new_text = f"{current} {timing}" if suffix else f"{timing} {current}"
            enter_view.setFieldText(new_text)
        except Exception as e:
            self.log(f"Insert error: {e}")
        finally:
            self._inserting = False

    def on_send_message_hook(self, account: int, params) -> HookResult:
        try:
            if not self._active:
                return HookResult()
            if self._flag("insert_on_type", DEFAULT_INSERT_ON_TYPE):
                return HookResult()

            reply_msg = getattr(params, "replyToMsg", None)
            if reply_msg is None or not self._check_reply_type(reply_msg):
                return HookResult()

            msg_text = getattr(params, "message", None)
            if not isinstance(msg_text, str) or not msg_text.strip():
                return HookResult()

            timing = self._build_timing(reply_msg)
            if not timing or timing in msg_text:
                return HookResult()

            if self._flag("suffix_mode", DEFAULT_SUFFIX_MODE):
                params.message = f"{msg_text} {timing}"
            else:
                params.message = f"{timing} {msg_text}"

            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        except Exception as e:
            self.log(f"Send hook error: {e}")
            return HookResult()


class ReplyHook:
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        plugin = self.plugin
        try:
            if not plugin._active:
                return
            reply_msg = param.args[0] if len(param.args) > 0 else None
            plugin.on_reply_changed(param.thisObject, reply_msg)
        except Exception as e:
            plugin.log(f"ReplyHook error: {e}")


class TextChangeHook:
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        plugin = self.plugin
        try:
            if not plugin._active:
                return
            plugin.on_field_text_changed(param.thisObject)
        except Exception as e:
            plugin.log(f"TextChangeHook error: {e}")