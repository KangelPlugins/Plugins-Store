from typing import Any, List

import os
import signal
import threading
import time

from android.content import Intent
from android_utils import log, run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import get_last_fragment
from ui.bulletin import BulletinHelper
from ui.settings import Header, Text

try:
    from com.exteragram.messenger.plugins import PluginsController
except Exception as e:
    log(f"[ERROR] [SdkInstaller] import PluginsController failed: {e}")
    PluginsController = None

__id__ = "shareui_sdkinstaller"
__name__ = "Installer"
__description__ = "Select a file and install it: exteraGram SDK or elyxcore plugin"
__author__ = "@shareui"
__version__ = "2.0.0"
__sdk_version__ = ">=1.4.5.1"
__app_version__ = ">=12.9.0"

PICK_REQUEST_CODE = 7742
PICK_ELYX_REQUEST_CODE = 7743

def filesDir() -> str:
    from org.telegram.messenger import ApplicationLoader
    return ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()

def getCacheRoot() -> str:
    return filesDir() + "/chaquopy"

class SdkInstallerPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._result_hooked = False

    def on_plugin_load(self) -> None:
        self.log("SDK Installer plugin loaded")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="SDK Installer"),
            Text(
                text="Select SDK",
                icon="msg_download",
                on_click=lambda v: self._pick_sdk_file(),
            ),
            Text(
                text="Install ElyxCore plugin",
                icon="msg_addbot",
                on_click=lambda v: self._pick_elyx_plugin_file(),
            ),
            Text(
                text="Reload",
                icon="msg_retry",
                on_click=lambda v: self._reload_app(),
            ),
        ]

    def _pick_sdk_file(self) -> None:
        try:
            fragment = get_last_fragment()
            act = fragment.getParentActivity() if fragment else None
        except Exception as e:
            log(f"[ERROR] [SdkInstaller] get activity: {e}")
            act = None
        if not act:
            log("[ERROR] [SdkInstaller] activity is None")
            return
        self._ensure_result_hook(act)
        try:
            intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            intent.setType("*/*")
            try:
                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            except Exception:
                pass
            act.startActivityForResult(intent, PICK_REQUEST_CODE)
        except Exception as e:
            log(f"[ERROR] [SdkInstaller] ACTION_OPEN_DOCUMENT failed: {e}")

    def _pick_elyx_plugin_file(self) -> None:
        try:
            fragment = get_last_fragment()
            act = fragment.getParentActivity() if fragment else None
        except Exception as e:
            log(f"[ERROR] [SdkInstaller] get activity: {e}")
            act = None
        if not act:
            log("[ERROR] [SdkInstaller] activity is None")
            return
        self._ensure_result_hook(act)
        try:
            intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            intent.setType("*/*")
            try:
                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            except Exception:
                pass
            act.startActivityForResult(intent, PICK_ELYX_REQUEST_CODE)
        except Exception as e:
            log(f"[ERROR] [SdkInstaller] ACTION_OPEN_DOCUMENT (elyx) failed: {e}")

    def _ensure_result_hook(self, act) -> None:
        if self._result_hooked:
            return
        self._result_hooked = True
        plugin_ref = self
        try:
            cls = act.getClass()

            class _ActResHook(MethodHook):
                def after_hooked_method(self, param):
                    try:
                        req = int(param.args[0])
                        res = int(param.args[1])
                        data = param.args[2]
                    except Exception as e:
                        log(f"[ERROR] [SdkInstaller] onActivityResult args: {e}")
                        return
                    code = req & 0xFFFF
                    if code not in (PICK_REQUEST_CODE, PICK_ELYX_REQUEST_CODE):
                        return
                    if res != -1 or not data:
                        return
                    try:
                        uri = data.getData()
                    except Exception as e:
                        log(f"[ERROR] [SdkInstaller] getData: {e}")
                        uri = None
                    if uri is None:
                        return
                    if code == PICK_ELYX_REQUEST_CODE:
                        threading.Thread(
                            target=plugin_ref._handle_picked_elyx_plugin,
                            args=(uri,),
                            daemon=True,
                        ).start()
                    else:
                        threading.Thread(
                            target=plugin_ref._handle_picked_file,
                            args=(uri,),
                            daemon=True,
                        ).start()

            for m in cls.getDeclaredMethods():
                name = str(m.getName() or "")
                if name == "onActivityResult" and len(m.getParameterTypes()) == 3:
                    self.hook_method(m, _ActResHook())
                    break
        except Exception as e:
            log(f"[ERROR] [SdkInstaller] hooking onActivityResult: {e}")

    def _handle_picked_file(self, uri) -> None:
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            cr = ctx.getContentResolver()
            dest_path = os.path.join(getCacheRoot(), "newSdk")
            os.makedirs(getCacheRoot(), exist_ok=True)
            inp = cr.openInputStream(uri)
            if inp is None:
                raise RuntimeError("openInputStream returned None")
            try:
                with open(dest_path, "wb") as out:
                    buf = bytearray(8192)
                    while True:
                        n = int(inp.read(buf))
                        if n <= 0:
                            break
                        out.write(bytes(buf[:n]))
            finally:
                inp.close()
            log(f"[SdkInstaller] SDK saved to {dest_path}")
            run_on_ui_thread(lambda: BulletinHelper.show_success("Successfully installed SDK"))
        except Exception as e:
            log(f"[ERROR] [SdkInstaller] install failed: {e}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"Error: {e}"))

    def _handle_picked_elyx_plugin(self, uri) -> None:
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            cr = ctx.getContentResolver()
            temp_dir = os.path.join(getCacheRoot(), "elyx_install")
            os.makedirs(temp_dir, exist_ok=True)
            temp_path = os.path.join(temp_dir, "picked_plugin.eaf")
            inp = cr.openInputStream(uri)
            if inp is None:
                raise RuntimeError("openInputStream returned None")
            try:
                with open(temp_path, "wb") as out:
                    buf = bytearray(8192)
                    while True:
                        n = int(inp.read(buf))
                        if n <= 0:
                            break
                        out.write(bytes(buf[:n]))
            finally:
                inp.close()
            log(f"[SdkInstaller] ElyxCore plugin saved to {temp_path}")
            run_on_ui_thread(lambda: self._show_elyx_install_dialog(temp_path))
        except Exception as e:
            log(f"[ERROR] [SdkInstaller] elyx plugin install failed: {e}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"Error: {e}"))

    def _show_elyx_install_dialog(self, temp_path: str) -> None:
        try:
            fragment = get_last_fragment()
            if fragment is None:
                raise RuntimeError("no active fragment")
            if PluginsController is None:
                raise RuntimeError("PluginsController not available")
            from java.io import File as _JFile
            eng = None
            try:
                eng = PluginsController.getPluginEngine(_JFile(temp_path))
            except Exception as e:
                log(f"[ERROR] [SdkInstaller] getPluginEngine check error: {e}")
            if eng is not None:
                log(f"[SdkInstaller] elyx install via host showInstallDialog ('{temp_path}')")
                PluginsController.getInstance().showInstallDialog(fragment, temp_path, True)
            else:
                log("[SdkInstaller] no engine claimed elyx temp file, using direct engine call")
                try:
                    from elyxcore._plugin_engine import ElyxEngine
                except ImportError:
                    from elyxcore import ElyxEngine  # older SDKs
                from com.exteragram.messenger.plugins.ui.components import InstallPluginBottomSheet
                install_params = InstallPluginBottomSheet.PluginInstallParams(temp_path, False)
                ElyxEngine.instance.showInstallDialog(fragment, install_params)
        except Exception as e:
            log(f"[ERROR] [SdkInstaller] show install dialog failed: {e}")
            BulletinHelper.show_error(f"Error: {e}")

    def _reload_app(self) -> None:
        def kill():
            time.sleep(1)
            os.kill(os.getpid(), signal.SIGKILL)

        threading.Thread(target=kill, daemon=True).start()
