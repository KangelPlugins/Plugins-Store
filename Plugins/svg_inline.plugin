                        if len(nums)>=4:
                            p=Path(); p.moveTo(float(nums[0]),float(nums[1]))
                            for i in range(2,len(nums),2):
                                if i+1<len(nums): p.lineTo(float(nums[i]),float(nums[i+1]))
                            if tag=="polygon": p.close()
                            if tag=="polygon" and fill_col is not None and style.get("fill","")!="none": canvas.drawPath(p, mk(fill_col,False))
                            if stroke_col is not None and style.get("stroke","none")!="none": canvas.drawPath(p, mk(stroke_col,True))
                            elif fill_col is None and stroke_col is None and tag=="polygon": canvas.drawPath(p, mk(0xFF000000,False))
                except Exception as e: self.log(f"poly {e}")
            elif tag=="path":
                try:
                    d=el.get("d","")
                    if d:
                        path=self._0x23(d, Path)
                        if path:
                            hf=fill_col is not None and style.get("fill","")!="none"
                            hs=stroke_col is not None and style.get("stroke","none")!="none"
                            if hf:
                                try:
                                    if style.get("fill-rule","nonzero").lower()=="evenodd": path.setFillType(Path.FillType.EVEN_ODD)
                                except: pass
                                canvas.drawPath(path, mk(fill_col,False))
                            if hs: canvas.drawPath(path, mk(stroke_col,True))
                            if not hf and not hs: canvas.drawPath(path, mk(0xFF000000,False))
                except Exception as e: self.log(f"path {e}")
            elif tag=="text":
                try:
                    x=self._0x20(el.get("x","0"),0); y=self._0x20(el.get("y","12"),12)
                    txt="".join(el.itertext()) or el.text or ""
                    if txt.strip():
                        sz=self._0x20(el.get("font-size","12"),12)
                        p=Paint(); p.setAntiAlias(True); p.setTextSize(float(sz))
                        col=fill_col if (fill_col is not None and style.get("fill","")!="none") else 0xFF000000
                        p.setColor(int(col))
                        try: canvas.drawText(txt,float(x),float(y),p)
                        except: pass
                except Exception as e: self.log(f"text {e}")
            else:
                for ch in list(el): self._0x1e(ch, canvas, False)
            if has:
                try: canvas.restore()
                except: pass
        except Exception as e: self.log(f"elem {e}")

    def _0x1f(self,s):
        d={}
        try:
            for part in s.split(";"):
                if ":" in part:
                    k,v=part.split(":",1); d[k.strip().lower()]=v.strip()
        except: pass
        return d
    def _0x20(self,v,df):
        try:
            if v is None: return df
            m=LENGTH_RE.match(str(v).strip())
            return float(m.group(1)) if m else float(str(v).strip())
        except: return df
    def _0x25(self, col):
        if col is None: return None
        try:
            unsigned = col & 0xFFFFFFFF if col < 0 else col
            a=(unsigned>>24)&0xFF; r=(unsigned>>16)&0xFF; g=(unsigned>>8)&0xFF; b=unsigned&0xFF
            gray=int(0.299*r + 0.587*g + 0.114*b)
            gray=min(255,max(0,gray))
            u2=(a<<24)|(gray<<16)|(gray<<8)|gray
            return u2 - 0x100000000 if u2>=0x80000000 else u2
        except: return col

    def _0x26(self, bmp):
        try:
            Canvas=_jc("android.graphics.Canvas")
            Paint=_jc("android.graphics.Paint")
            ColorMatrix=_jc("android.graphics.ColorMatrix")
            ColorMatrixColorFilter=_jc("android.graphics.ColorMatrixColorFilter")
            cm=ColorMatrix()
            cm.setSaturation(float(0)) # 0 = grayscale
            paint=Paint()
            paint.setColorFilter(ColorMatrixColorFilter(cm))
            canvas=Canvas(bmp)
            Bitmap=_jc("android.graphics.Bitmap")
            BC=_jc("android.graphics.Bitmap$Config")
            copy=Bitmap.createBitmap(int(bmp.getWidth()), int(bmp.getHeight()), BC.ARGB_8888)
            c2=Canvas(copy)
            c2.drawBitmap(bmp, float(0), float(0), paint)
            return copy
        except Exception as e:
            self.log(f"gray bmp {e}")
            return bmp

    def _0x21(self,s,op=None):
        try:
            if s is None: return None
            s=s.strip()
            if s=="" or s.lower()=="none": return None
            if s.lower()=="transparent": return 0
            try:
                Color=_jc("android.graphics.Color")
                col=int(Color.parseColor(s))
                if op is not None:
                    try:
                        o=float(str(op).strip())
                        if o>1: o/=100.0
                        o=max(0,min(1,o))
                        unsigned=col & 0xFFFFFFFF if col<0 else col
                        a=(unsigned>>24)&0xFF; a=int(a*o)
                        rgb=unsigned & 0x00FFFFFF; u2=(a<<24)|rgb
                        col=u2 - 0x100000000 if u2>=0x80000000 else u2
                    except: pass
                return int(col)
            except: pass
            low=s.lower()
            if low in NAMED_COLORS:
                base=NAMED_COLORS[low]
                if op is not None:
                    try:
                        o=float(str(op).strip())
                        if o>1: o/=100.0
                        o=max(0,min(1,o))
                        unsigned=base & 0xFFFFFFFF if base<0 else base
                        a=(unsigned>>24)&0xFF; a=int(a*o); rgb=unsigned & 0x00FFFFFF; u2=(a<<24)|rgb
                        base=u2 - 0x100000000 if u2>=0x80000000 else u2
                    except: pass
                return int(base)
            if s.startswith("#"):
                hexv=s[1:]
                if len(hexv)==3: hexv="".join([c*2 for c in hexv]); base=int("ff"+hexv,16)
                elif len(hexv)==6: base=int("ff"+hexv,16)
                elif len(hexv)==8: r=hexv[0:2]; g=hexv[2:4]; b=hexv[4:6]; a=hexv[6:8]; base=(int(a,16)<<24)|(int(r,16)<<16)|(int(g,16)<<8)|int(b,16)
                else: return None
                if base>=0x80000000: base-=0x100000000
                return int(base)
            return None
        except: return None
    def _0x22(self,s,MC):
        try:
            m=MC(); has=False
            for name,args_str in TRANSFORM_RE.findall(s):
                args=[float(x) for x in re.findall(r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?",args_str)]
                name=name.lower(); tmp=MC()
                if name=="translate": tmp.setTranslate(float(args[0] if len(args)>=1 else 0), float(args[1] if len(args)>=2 else 0))
                elif name=="scale":
                    sx=args[0] if len(args)>=1 else 1; sy=args[1] if len(args)>=2 else sx
                    tmp.setScale(float(sx),float(sy))
                elif name=="rotate":
                    a=args[0] if len(args)>=1 else 0
                    if len(args)>=3: tmp.setRotate(float(a),float(args[1]),float(args[2]))
                    else: tmp.setRotate(float(a))
                elif name=="skewx": tmp.setSkew(float(math.tan(math.radians(args[0] if len(args)>=1 else 0))),0)
                elif name=="skewy": tmp.setSkew(0,float(math.tan(math.radians(args[0] if len(args)>=1 else 0))))
                elif name=="matrix":
                    if len(args)>=6:
                        vals=[0]*9; vals[0]=float(args[0]);vals[1]=float(args[2]);vals[2]=float(args[4]);vals[3]=float(args[1]);vals[4]=float(args[3]);vals[5]=float(args[5]);vals[6]=0;vals[7]=0;vals[8]=1
                        try: tmp.setValues(vals)
                        except: continue
                    else: continue
                else: continue
                try: m.postConcat(tmp); has=True
                except:
                    try: m.preConcat(tmp); has=True
                    except: pass
            return m if has else None
        except Exception as e: self.log(f"tr {e}"); return None
    def _0x23(self,d,PC):
        try:
            tokens=TOKEN_RE.findall(d); path=PC(); i=0; cmd=None; x=y=0; sx=sy=0; lcx=lcy=None; lqx=lqy=None
            def isc(idx): return idx<len(tokens) and tokens[idx].isalpha()
            while i<len(tokens):
                tok=tokens[i]
                if tok.isalpha(): cmd=tok; i+=1
                elif cmd is None: i+=1; continue
                rel=cmd.islower(); u=cmd.upper()
                if u=="M":
                    while i+1<len(tokens) and not isc(i):
                        nx=float(tokens[i]); ny=float(tokens[i+1]); i+=2
                        if rel: nx+=x; ny+=y
                        path.moveTo(float(nx),float(ny)); x=nx; y=ny; sx=x; sy=y
                        if u=="M": cmd="L" if not rel else "l"; rel=cmd.islower(); u=cmd.upper()
                        if i>=len(tokens) or isc(i): break
                elif u=="Z": path.close(); x=sx; y=sy
                elif u=="L":
                    while i+1<len(tokens) and not isc(i):
                        nx=float(tokens[i]); ny=float(tokens[i+1]); i+=2
                        if rel: nx+=x; ny+=y
                        path.lineTo(float(nx),float(ny)); x=nx; y=ny; lcx=None; lqx=None
                elif u=="H":
                    while i<len(tokens) and not isc(i):
                        nx=float(tokens[i]); i+=1
                        if rel: nx+=x
                        path.lineTo(float(nx),float(y)); x=nx
                elif u=="V":
                    while i<len(tokens) and not isc(i):
                        ny=float(tokens[i]); i+=1
                        if rel: ny+=y
                        path.lineTo(float(x),float(ny)); y=ny
                elif u=="C":
                    while i+5<len(tokens) and not isc(i):
                        x1=float(tokens[i]); y1=float(tokens[i+1]); x2=float(tokens[i+2]); y2=float(tokens[i+3]); x3=float(tokens[i+4]); y3=float(tokens[i+5]); i+=6
                        if rel: x1+=x; y1+=y; x2+=x; y2+=y; x3+=x; y3+=y
                        path.cubicTo(float(x1),float(y1),float(x2),float(y2),float(x3),float(y3))
                        lcx=x2; lcy=y2; x=x3; y=y3; lqx=None
                elif u=="S":
                    while i+3<len(tokens) and not isc(i):
                        x2=float(tokens[i]); y2=float(tokens[i+1]); x3=float(tokens[i+2]); y3=float(tokens[i+3]); i+=4
                        if rel: x2+=x; y2+=y; x3+=x; y3+=y
                        x1=2*x-lcx if lcx is not None else x; y1=2*y-lcy if lcy is not None else y
                        path.cubicTo(float(x1),float(y1),float(x2),float(y2),float(x3),float(y3))
                        lcx=x2; lcy=y2; x=x3; y=y3; lqx=None
                elif u=="Q":
                    while i+3<len(tokens) and not isc(i):
                        x1=float(tokens[i]); y1=float(tokens[i+1]); x2=float(tokens[i+2]); y2=float(tokens[i+3]); i+=4
                        if rel: x1+=x; y1+=y; x2+=x; y2+=y
                        path.quadTo(float(x1),float(y1),float(x2),float(y2)); lqx=x1; lqy=y1; x=x2; y=y2; lcx=None
                elif u=="T":
                    while i+1<len(tokens) and not isc(i):
                        x2=float(tokens[i]); y2=float(tokens[i+1]); i+=2
                        if rel: x2+=x; y2+=y
                        x1=2*x-lqx if lqx is not None else x; y1=2*y-lqy if lqy is not None else y
                        path.quadTo(float(x1),float(y1),float(x2),float(y2)); lqx=x1; lqy=y1; x=x2; y=y2; lcx=None
                elif u=="A":
                    while i+6<len(tokens) and not isc(i):
                        rx=float(tokens[i]); ry=float(tokens[i+1]); phi=float(tokens[i+2]); lg=int(float(tokens[i+3])); sw=int(float(tokens[i+4])); nx=float(tokens[i+5]); ny=float(tokens[i+6]); i+=7
                        if rel: nx+=x; ny+=y
                        if rx==0 or ry==0:
                            path.lineTo(float(nx),float(ny))
                        else:
                            try:
                                self._0x24(path, float(x),float(y), float(nx),float(ny), float(rx),float(ry), float(phi), lg, sw)
                            except Exception as e:
                                self.log(f"arc fallback {e}")
                                path.lineTo(float(nx),float(ny))
                        x=nx; y=ny; lcx=None; lqx=None
                else: i+=1
            return path
        except Exception as e:
            self.log(f"p {e}")
            try:
                return PC()
            except:
                return None

    def _0x24(self, path, x1, y1, x2, y2, rx, ry, phi_deg, large, sweep):
        import math
        RectF=_jc("android.graphics.RectF")
        phi=math.radians(phi_deg % 360)
        cos_phi=math.cos(phi); sin_phi=math.sin(phi)
        dx=(x1 - x2)/2.0; dy=(y1 - y2)/2.0
        x1p= cos_phi*dx + sin_phi*dy
        y1p=-sin_phi*dx + cos_phi*dy
        rx=abs(rx); ry=abs(ry)
        if rx==0 or ry==0:
            return
        lam=(x1p*x1p)/(rx*rx) + (y1p*y1p)/(ry*ry)
        if lam > 1:
            s=math.sqrt(lam)
            rx*=s; ry*=s
        sign = -1 if large == sweep else 1
        num = max(0, (rx*rx*ry*ry - rx*rx*y1p*y1p - ry*ry*x1p*x1p) / (rx*rx*y1p*y1p + ry*ry*x1p*x1p))
        if num < 0: num = 0
        coef = sign * math.sqrt(num)
        cxp = coef * (rx*y1p/ry)
        cyp = coef * (-ry*x1p/rx)
        cx = cos_phi*cxp - sin_phi*cyp + (x1+x2)/2.0
        cy = sin_phi*cxp + cos_phi*cyp + (y1+y2)/2.0
        def v_angle(ux, uy, vx, vy):
            dot = ux*vx + uy*vy
            det = ux*vy - uy*vx
            ang = math.degrees(math.atan2(det, dot))
            return ang
        ux = (x1p - cxp)/rx
        uy = (y1p - cyp)/ry
        vx = (-x1p - cxp)/rx
        vy = (-y1p - cyp)/ry
        theta1 = v_angle(1,0, ux,uy)
        dtheta = v_angle(ux,uy, vx,vy)
        if not sweep and dtheta > 0:
            dtheta -= 360
        elif sweep and dtheta < 0:
            dtheta += 360
        if abs(phi) < 0.01:
            oval=RectF(float(cx - rx), float(cy - ry), float(cx + rx), float(cy + ry))
            try:
                path.arcTo(oval, float(theta1), float(dtheta), False)
            except Exception:
                try: path.arcTo(oval, float(theta1), float(dtheta))
                except: pass
        else:
            segs = max(12, int(abs(dtheta)/6))
            for i in range(1, segs+1):
                t = i/float(segs)
                ang = math.radians(theta1 + dtheta*t)
                px = cx + rx*math.cos(ang)*cos_phi - ry*math.sin(ang)*sin_phi
                ca = math.cos(math.radians(theta1 + dtheta*t))
                sa = math.sin(math.radians(theta1 + dtheta*t))
                px2 = cx + rx*ca*cos_phi - ry*sa*sin_phi
                py2 = cy + rx*ca*sin_phi + ry*sa*cos_phi
                path.lineTo(float(px2), float(py2))