            if not param.args: return
            msg=param.args[0]
            if msg is None: return
            for fn in ("messageText","caption"):
                try:
                    txt=getattr(msg,fn,None)
                    if txt is None: txt=_gpf(msg,fn)
                    if txt is None: continue
                    s=str(txt)
                    if "<svg" not in s.lower(): continue
                    new=self.plugin._0x1a(txt)
                    if new is not None:
                        try: setattr(msg,fn,new)
                        except:
                            from hook_utils import set_private_field
                            set_private_field(msg,fn,new)
                except: pass
        except Exception as e: self.plugin.log(f"cell {e}")

