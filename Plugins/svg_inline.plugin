class SvgMessageHook(MethodHook):
    def __init__(self,p): super().__init__();self.plugin=p
    def after_hooked_method(self,param):
        try:
            if not self.plugin.get_setting("enabled",True): return
            obj=param.thisObject
            if obj is None: return
            oid=id(obj)
            if oid in self.plugin._0xa1: return
            changed=False
            for fn in ("messageText","caption"):
                try:
                    txt=getattr(obj,fn,None)
                    if txt is None: txt=_gpf(obj,fn)
                    if txt is None: continue
                    s=str(txt)
                    if "<svg" not in s.lower(): continue
                    new=self.plugin._0x1a(txt)
                    if new is not None and str(new)!=s:
                        try: setattr(obj,fn,new)
                        except:
                            from hook_utils import set_private_field
                            set_private_field(obj,fn,new)
                        changed=True
                except Exception as e: self.plugin.log(f"{fn} {e}")
            if changed:
                self.plugin._0xa1.add(oid)
                if len(self.plugin._0xa1)>2000: self.plugin._0xa1.clear()
                for mname in ("checkLayout","resetLayout","generateLayout"):
                    try:
                        m=obj.getClass().getMethod(mname); m.setAccessible(True); m.invoke(obj); break
                    except: continue
        except Exception as e: self.plugin.log(f"hook {e}")

