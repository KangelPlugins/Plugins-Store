        ("gate_verdict.json",         "БЛОКИРОВКА", "⛔", "не прошёл проверку при старте", None),
        ("cxa_verdict.json",          "C++ ИСКЛЮЧЕНИЕ", "💣", "выбросил C++ исключение", None),
        ("globalref_verdict.json",    "УТЕЧКА JNI-ССЫЛОК", "🩸", "переполнил таблицу JNI global-references", None),
        ("selfkill_blocked_verdict.json",  "СУИЦИД ПРЕДОТВРАЩЁН",   "🛡️", "пытался убить процесс (kill/exit)", None),
        ("exitinfo_verdict.json",          "СМЕРТЬ ПРОЦЕССА (post-mortem)", "⚰️", "убил процесс без in-process следа во время/сразу после своей загрузки (ExitInfo)", None),
        ("fileguard_blocked_verdict.json", "УДАЛЕНИЕ ПРЕДОТВРАЩЕНО", "🛡️", "пытался удалить детектор", None),
