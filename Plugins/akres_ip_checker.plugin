    "Плагин для проверки IP-адресов и доменов.\n\n"
    " .wh <IP/домен> – инфо о цели: страна, город, провайдер и так далее через несколько API, .whh тоже самое но IP скрыт.\n"
    " .bs <IP/домен> – проверка на белый IP по операторам, .bsh тоже самое но IP скрыт."
)

LATENCYLAB_BASE = "https://console.latencylab.ru"

class IPCheckerPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.progress_dialog = None

    def on_plugin_load(self):
        self.add_on_send_message_hook()

    def _open_account_page(self, view):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if not activity:
            return
        instruction = (
            "1. Нажмите кнопку «Перейти» ниже\n"
            "2. На открывшейся странице нажмите «Войти»\n"
            "3. Авторизуйтесь через Telegram\n"
            "4. Вернитесь на страницу и пролистайте вниз\n"
            "5. Нажмите «Создать ключ» и скопируйте его\n"
            "6. Вернитесь сюда и вставьте ключ в поле выше\n\n"
            "⚠️ Важно: никому не передавайте этот ключ.\n"
            "Если ключ случайно утёк — вернитесь на страницу, нажмите «Отозвать» и создайте новый."
        )
        def _open_site():
            intent = Intent(Intent.ACTION_VIEW, Uri.parse("https://latencylab.ru/account.html"))
            activity.startActivity(intent)
        dialog = AlertDialogBuilder(activity, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
        dialog.set_title("Получение API ключа")
        dialog.set_message(instruction)
        dialog.set_positive_button("Перейти", lambda d, w: _open_site())
        dialog.set_negative_button("Отмена", None)
        dialog.show()

    def _open_api_key_input(self, view):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if not activity:
            return
        from android.text import InputType
        from android.widget import EditText as AndroidEditText
        from org.telegram.messenger import AndroidUtilities
        input_field = AndroidEditText(activity)
        input_field.setText(self.get_setting("latencylab_api_key", ""))
        input_field.setInputType(InputType.TYPE_CLASS_TEXT)
        input_field.setPadding(
            AndroidUtilities.dp(16), AndroidUtilities.dp(8),
            AndroidUtilities.dp(16), AndroidUtilities.dp(8),
        )
        def _save(d, w):
            self.set_setting("latencylab_api_key", str(input_field.getText()).strip(), reload_settings=True)
        dialog = AlertDialogBuilder(activity, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
        dialog.set_title("API ключ LatencyLab")
        dialog.set_view(input_field)
        dialog.set_positive_button("Готово", _save)
        dialog.set_negative_button("Отмена", None)
        dialog.show()

