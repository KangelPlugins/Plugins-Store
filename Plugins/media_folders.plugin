# __DEX_END__


class Dex:
    def __init__(self, ec):
        self.ec = ec
        self.clazz = None
        self.loaded = False
        self._m = {}

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            ctx = ApplicationLoader.applicationContext
            if not ctx:
                raise RuntimeError("no ctx")
            self.clazz = jclass("dalvik.system.InMemoryDexClassLoader")(jclass("java.nio.ByteBuffer").wrap(self._rp()), ctx.getClassLoader()).loadClass(self.ec)
            for m in self.clazz.getDeclaredMethods():
                m.setAccessible(True)
                self._m[str(m.getName())] = m
        self._m["load"].invoke(None)
        self.loaded = True

    def unload(self):
        try:
            if self.loaded and "unload" in self._m:
                self._m["unload"].invoke(None)
        except Exception:
            pass
        self.loaded = False

    def call(self, name, *args):
        try:
            if self.loaded and name in self._m:
                return self._m[name].invoke(None, *args)
        except Exception as e:
            log("dex.%s: %s" % (name, e))
        return None

    def _rp(self):
        with open(__file__, "r", encoding="utf-8") as f:
            t = f.read()
        b = t.split(f"# {DEX_BEGIN}", 1)[1].split(f"# {DEX_END}", 1)[0]
        p = "".join(l.strip()[1:].strip() for l in b.splitlines() if l.strip().startswith("#"))
        if not p:
            raise RuntimeError("dex empty")
        return zlib.decompress(base64.b64decode(p))


class Plugin(BasePlugin):

    def on_plugin_load(self):
        try:
            self.dex = Dex(ENTRY_CLASS)
            self.dex.load()
        except Exception as e:
            self.log("dex load error: %s" % e)

    def on_plugin_unload(self):
        try:
            if hasattr(self, "dex"):
                self.dex.unload()
        except Exception:
            pass

    def _call(self, name, *args):
        try:
            if hasattr(self, "dex"):
                return self.dex.call(name, *args)
        except Exception:
            pass
        return None

    def _open_url_internal(self, url):
        def handler(view):
            try:
                Browser = jclass("org.telegram.messenger.browser.Browser")
                ctx = view.getContext()
                uri = jclass("android.net.Uri").parse(url)
                Browser.openUrl(ctx, uri, True, False, None)
            except Exception:
                try:
                    Browser = jclass("org.telegram.messenger.browser.Browser")
                    ctx = view.getContext()
                    Browser.openInTelegramBrowser(ctx, url, None)
                except Exception as e:
                    self.log("open url error: %s" % e)
        return handler

    def _on_color_change(self, key):
        def cb(value):
            self._call("pySetColor", JString(key), JString(str(value).strip()))
        return cb

    def _on_glass_toggle(self, value):
        self._call("pySetGlassEnabled", jboolean(bool(value)))

    def _on_glass_tabs_toggle(self, value):
        self._call("pySetGlassTabs", jboolean(bool(value)))

    def _on_glass_alpha_change(self, value):
        try:
            self._call("pySetGlassAlpha", float(value))
        except Exception:
            BulletinHelper.show_error("Enter a number between 0.1 and 1.0")

    def _on_trending_toggle(self, value):
        self._call("pySetHideTrending", jboolean(bool(value)))

    def _on_folders_toggle(self, media_type):
        def cb(value):
            self._call("pySetFoldersEnabled", JString(media_type), jboolean(bool(value)))
        return cb

    def _on_collapse_toggle(self, value):
        self._call("pySetCollapseOnScroll", jboolean(bool(value)))

    def _get_folder_items_for_type(self, media_type):
        items = []
        plugin = self
        order = _get_ordered_tabs(media_type)
        folders = _load_folders(media_type)
        folder_map = {f.get("id"): f.get("name", "Folder") for f in folders}
        for i, tab_id in enumerate(order):
            if tab_id == "all":
                name = _get_all_tab_name(media_type)
                is_hidden = _get_all_tab_hidden(media_type)
                sub = "\U0001F6AB Hidden" if is_hidden else None
                items.append(Text(
                    text=name,
                    subtext=sub,
                    icon="msg_folder",
                    on_click=lambda v, mt=media_type, tid=tab_id, tname=name: plugin._call("pyShowFolderManage", JString(mt), JString(tid), JString(tname))
                ))
            elif tab_id in folder_map:
                name = folder_map[tab_id]
                items.append(Text(
                    text=name,
                    icon="msg_folder",
                    on_click=lambda v, mt=media_type, tid=tab_id, tname=name: plugin._call("pyShowFolderManage", JString(mt), JString(tid), JString(tname))
                ))
        return items

    def create_settings(self):
        plugin = self
        items = [
            Header(text="\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f"),
            Text(text="\u041a\u0430\u043d\u0430\u043b \u0430\u0432\u0442\u043e\u0440\u0430", icon="msg_channel", on_click=self._open_url_internal("https://t.me/MaxExteraPlugins")),
            Text(text="\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f", icon="msg_link", on_click=self._open_url_internal("https://telegra.ph/Dokumentaciya-k-plaginu-Media-Folders-07-08")),
            Divider(),
        ]
        for mt, label in [("gif", "GIF"), ("sticker", "Sticker"), ("emoji", "Emoji")]:
            items.append(Header(text="%s Folders" % (label,)))
            items.append(Switch(key="folders_enabled_%s" % mt, text="Folders in %s panel" % (label,), subtext="Show folder tabs in the %s panel" % (label,), default=_get_folders_enabled(mt), icon="msg_folders", on_change=plugin._on_folders_toggle(mt)))
            items.extend(self._get_folder_items_for_type(mt))
            items.append(Divider())
        items.extend([
            Header(text="Design"),
            Input(key="tab_bg_color", text="Folder tab color", subtext="Hex, e.g. #2F80ED", default=_get_color_setting("tab_bg_color"), icon="msg_edit", on_change=self._on_color_change("tab_bg_color")),
            Input(key="tab_text_color", text="Folder tab text color", subtext="Hex, e.g. #FFFFFF", default=_get_color_setting("tab_text_color"), icon="msg_edit", on_change=self._on_color_change("tab_text_color")),
            Input(key="subtab_bg_color", text="Sub-tab color", subtext="Color for pack tabs inside folders", default=_get_color_setting("subtab_bg_color"), icon="msg_edit", on_change=self._on_color_change("subtab_bg_color")),
            Input(key="subtab_text_color", text="Sub-tab text color", subtext="Text color for pack tabs", default=_get_color_setting("subtab_text_color"), icon="msg_edit", on_change=self._on_color_change("subtab_text_color")),
            Divider(),
            Header(text="Liquid Glass"),
            Switch(key="glass_enabled", text="Enable Liquid Glass", subtext="Frosted glass effect for the folder bar", default=_get_glass_enabled(), icon="msg_theme", on_change=plugin._on_glass_toggle),
            Switch(key="glass_tabs", text="Glass tabs", subtext="Glass effect on individual tabs", default=_get_glass_tabs(), icon="msg_photo_settings", on_change=plugin._on_glass_tabs_toggle),
            Input(key="glass_alpha", text="Glass opacity", subtext="0.1 - 1.0", default=str(_get_glass_alpha()), icon="msg_edit", on_change=plugin._on_glass_alpha_change),
            Divider(),
            Header(text="Settings"),
            Switch(key="hide_trending_gifs", text="Hide Trending GIFs", subtext="Hide popular GIFs section in GIF panel", default=_get_hide_trending(), icon="msg_theme", on_change=plugin._on_trending_toggle),
            Switch(key="collapse_on_scroll", text="Collapse folders bar on scroll", subtext="Hide the folder bar when scrolling down, show it again when scrolling up", default=_get_collapse_on_scroll(), icon="msg_reorder", on_change=plugin._on_collapse_toggle),
            Divider(),
            Header(text="Backup"),
            Text(text="Backup to Saved Messages", subtext="Save all folder structures to restore later", icon="msg_saved", on_click=lambda v: plugin._call("pyDoBackup")),
            Divider(text="Tap a .mediafolder_backup file in Saved Messages to restore."),
            Divider(),
            Text(text="Reset All Folders", icon="msg_delete", red=True, on_click=lambda v: plugin._call("pyResetAll")),
        ])
        return items
