_MALW_IPS = ["185.246.223.127", "62.133.62.97"]
_GEMINI_IP_CACHE = {"ip": None, "expires": 0}
_CACHED_CUSTOM_MODELS = []
_CACHED_GEMINI_MODELS = []

def _get_gemini_proxy_ip():
    now = time.time()
    if _GEMINI_IP_CACHE["ip"] and _GEMINI_IP_CACHE["expires"] > now:
        return _GEMINI_IP_CACHE["ip"]

    try:
        r = requests.get(
            "https://cloudflare-dns.com/dns-query?name=dns.malw.link&type=A",
            headers={"accept": "application/dns-json"},
            timeout=2
        )
        if r.status_code == 200:
            data = r.json()
            for ans in data.get("Answer", []):
                if ans.get("type") == 1 and ans.get("data"):
                    ip = str(ans.get("data")).strip()
                    if ip:
                        _GEMINI_IP_CACHE["ip"] = ip
                        _GEMINI_IP_CACHE["expires"] = now + 300
                        return ip
    except Exception:
        pass

    ip = _MALW_IPS[int(now) % len(_MALW_IPS)]
    _GEMINI_IP_CACHE["ip"] = ip
    _GEMINI_IP_CACHE["expires"] = now + 300
    return ip

def _gemini_request(method, url, json_payload=None, headers=None, timeout=20, use_custom_dns=True):
    if not headers:
        headers = {}
    headers.setdefault("User-Agent", "exteraGram-AI/1.2")

    if not use_custom_dns:
        if method == "POST":
            return requests.post(url, json=json_payload, headers=headers, timeout=timeout)
        return requests.get(url, headers=headers, timeout=timeout)

    orig_gai = socket.getaddrinfo

    def _scoped_gai(host, port, family=0, type=0, proto=0, flags=0):
        try:
            if host and "googleapis.com" in str(host).lower():
                ip = _get_gemini_proxy_ip()
                if ip:
                    return orig_gai(ip, port, family, type, proto, flags)
        except Exception:
            pass
        return orig_gai(host, port, family, type, proto, flags)

    try:
        socket.getaddrinfo = _scoped_gai
        if method == "POST":
            return requests.post(url, json=json_payload, headers=headers, timeout=timeout)
        return requests.get(url, headers=headers, timeout=timeout)
    finally:
        socket.getaddrinfo = orig_gai

