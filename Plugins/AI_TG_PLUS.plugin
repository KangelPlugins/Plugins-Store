def get_field(obj, name):
    if not obj:
        return None
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            return f.get(obj)
        except Exception:
            cls = cls.getSuperclass()
    return None

def set_field(obj, name, val):
    if not obj:
        return
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            f.set(obj, val)
            return
        except Exception:
            cls = cls.getSuperclass()

def sort_models_key(name):
    low = name.lower()
    if "flash-lite" in low:
        group = 0
    elif "flash" in low:
        group = 1
    else:
        group = 2

    m = re.search(r'gemini[^\d]*(\d+(?:\.\d+)?)', low)
    ver = float(m.group(1)) if m else 0.0
    is_preview = 1 if ("preview" in low or "exp" in low) else 0
    return (group, -ver, is_preview, name)

class AIEditorRequestHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            param.setResult(None)
            alert = param.thisObject
            api_key = self.plugin.get_api_key()
            self.plugin.process_ai_request(alert, api_key)
        except Exception:
            pass
        finally:
            del param

    def after_hooked_method(self, param):
        try:
            pass
        finally:
            del param

class SummarizeRequestHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            param.setResult(None)
            message_object = param.args[0] if len(param.args) > 0 else None
            to_lang = str(param.args[1]) if len(param.args) > 1 and param.args[1] is not None else "ru"
            callback = param.args[2] if len(param.args) > 2 else None

            api_key = self.plugin.get_api_key()
            self.plugin.process_summarize_request(message_object, to_lang, callback, api_key)
        except Exception:
            pass
        finally:
            del param

    def after_hooked_method(self, param):
        try:
            pass
        finally:
            del param

class AIEditorGeminiPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._unhooks = []
        self._cached_custom_models = []
        self._cached_gemini_models = []

    def on_plugin_load(self):
        try:
            self.add_hook("TL_messages_composeMessageWithAI")
            self.add_hook("TL_messages_summarizeText")
        except Exception:
            pass

        try:
            ai_alert_cls = find_class("org.telegram.ui.Components.AIEditorAlert")
            if ai_alert_cls:
                unhooks = self.hook_all_methods(ai_alert_cls, "request", AIEditorRequestHook(self))
                if unhooks:
                    self._unhooks.extend(unhooks)
        except Exception:
            pass

        try:
            tc_cls = find_class("org.telegram.messenger.TranslateController")
            if tc_cls:
                unhooks = self.hook_all_methods(tc_cls, "pushToSummarize", SummarizeRequestHook(self))
                if unhooks:
                    self._unhooks.extend(unhooks)
        except Exception:
            pass

    def on_plugin_unload(self):
        for unhook in self._unhooks:
            try:
                unhook.unhook()
            except Exception:
                pass
        self._unhooks.clear()

    def pre_request_hook(self, request_name, account, request):
        try:
            if request_name in ("TL_messages_composeMessageWithAI", "TL_messages_summarizeText"):
                return HookResult(strategy=HookStrategy.CANCEL)
        except Exception:
            pass
        finally:
            del request
        return HookResult()

    def get_api_key(self):
        api_type = self.get_setting("api_type", 0)
        if isinstance(api_type, str) and api_type.isdigit():
            api_type = int(api_type)
        if api_type == 1:
            return self.get_setting("custom_api_key", "").strip()
        gemini_key = self.get_setting("gemini_api_key", "").strip()
        if not gemini_key:
            gemini_key = self.get_setting("api_key", "").strip()
        return gemini_key

    def open_api_site(self):
        fragment = get_last_fragment()
        context = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
        Browser.openUrl(context, "https://aistudio.google.com/app/apikey")

    def get_models_list(self):
        global _CACHED_CUSTOM_MODELS, _CACHED_GEMINI_MODELS
        api_type = self.get_setting("api_type", 0)
        if isinstance(api_type, str) and api_type.isdigit():
            api_type = int(api_type)

        ignored = ["realtime", "embedding", "tts", "whisper", "translate", "transcribe", "live", "image", "audio", "voice", "dall-e", "moderation", "rerank", "gpt-3.5", "sora"]

        if api_type == 1:
            if _CACHED_CUSTOM_MODELS:
                return _CACHED_CUSTOM_MODELS
            if getattr(self, "_cached_custom_models", None):
                filtered = [m for m in self._cached_custom_models if not any(bad in m.lower() for bad in ignored)]
                if filtered:
                    _CACHED_CUSTOM_MODELS = filtered
                    return filtered
            cached_val = self.get_setting("cached_custom_models", None)
            if isinstance(cached_val, list) and len(cached_val) > 0:
                filtered = [str(x) for x in cached_val if not any(bad in str(x).lower() for bad in ignored)]
                if filtered:
                    _CACHED_CUSTOM_MODELS = filtered
                    self._cached_custom_models = filtered
                    return filtered
            if isinstance(cached_val, str) and cached_val.strip():
                try:
                    models = json.loads(cached_val)
                    if isinstance(models, list) and len(models) > 0:
                        filtered = [str(x) for x in models if not any(bad in str(x).lower() for bad in ignored)]
                        if filtered:
                            _CACHED_CUSTOM_MODELS = filtered
                            self._cached_custom_models = filtered
                            return filtered
                except Exception:
                    pass
            return []

        if _CACHED_GEMINI_MODELS:
            return _CACHED_GEMINI_MODELS
        if getattr(self, "_cached_gemini_models", None):
            return self._cached_gemini_models
        cached_val = self.get_setting("cached_models", None)
        if isinstance(cached_val, list) and len(cached_val) > 0:
            filtered = [str(m) for m in cached_val if "gemini" in str(m).lower() and ("flash" in str(m).lower()) and not any(v in str(m).lower() for v in ["1.0", "1.5", "2.0"]) and not any(bad in str(m).lower() for bad in ["image", "tts", "omni", "realtime", "embedding", "live", "sora"])]
            if filtered:
                filtered.sort(key=sort_models_key)
                _CACHED_GEMINI_MODELS = filtered
                self._cached_gemini_models = filtered
                return filtered
        if isinstance(cached_val, str) and cached_val.strip():
            try:
                models = json.loads(cached_val)
                if isinstance(models, list) and len(models) > 0:
                    filtered = [str(m) for m in models if "gemini" in str(m).lower() and ("flash" in str(m).lower()) and not any(v in str(m).lower() for v in ["1.0", "1.5", "2.0"]) and not any(bad in str(m).lower() for bad in ["image", "tts", "omni", "realtime", "embedding", "live", "sora"])]
                    if filtered:
                        filtered.sort(key=sort_models_key)
                        _CACHED_GEMINI_MODELS = filtered
                        self._cached_gemini_models = filtered
                        return filtered
            except Exception:
                pass
        return []

    def fetch_remote_models(self, api_key):
        global _CACHED_CUSTOM_MODELS, _CACHED_GEMINI_MODELS
        api_type = self.get_setting("api_type", 0)
        if isinstance(api_type, str) and api_type.isdigit():
            api_type = int(api_type)

        if api_type == 1:
            raw_endpoint = self.get_setting("custom_endpoint", "https://api.openai.com/v1").strip()
            if not raw_endpoint:
                raw_endpoint = "https://api.openai.com/v1"
            if not raw_endpoint.startswith("https://"):
                raw_endpoint = f"https://{raw_endpoint.replace('http://', '')}"
            endpoint = raw_endpoint.rstrip("/")
            if endpoint.endswith("/chat/completions"):
                endpoint = endpoint[:-len("/chat/completions")]

            models_url = f"{endpoint}/models"
            headers = {"User-Agent": "exteraGram-AI/1.2"}
            if api_key:
                headers["Authorization"] = f"Bearer {api_key}"

            try:
                resp = requests.get(models_url, headers=headers, timeout=12)
                if resp.status_code == 200:
                    data = resp.json()
                    items = data.get("data", []) or data.get("models", [])
                    extracted = []
                    ignored = ["realtime", "embedding", "tts", "whisper", "translate", "transcribe", "live", "image", "audio", "voice", "dall-e", "moderation", "rerank", "gpt-3.5", "sora"]
                    for item in items:
                        m_id = None
                        if isinstance(item, dict):
                            m_id = item.get("id") or item.get("name")
                        elif isinstance(item, str):
                            m_id = item
                        if m_id and isinstance(m_id, str):
                            m_id = m_id.strip()
                            low = m_id.lower()
                            if any(bad in low for bad in ignored):
                                continue
                            if m_id not in extracted:
                                extracted.append(m_id)

                    if extracted:
                        extracted.sort()
                        _CACHED_CUSTOM_MODELS = extracted
                        self._cached_custom_models = extracted
                        self.set_setting("cached_custom_models", json.dumps(extracted))
                        if hasattr(self, "save_settings"):
                            try:
                                self.save_settings()
                            except Exception:
                                pass
                        return extracted, None
                    return None, "Список моделей пуст или не поддерживается эндпоинтом"
                else:
                    return None, f"Ошибка API {resp.status_code}: {resp.text[:100]}"
            except Exception as e:
                return None, f"Ошибка сети: {e}"

        try:
            url = f"https://generativelanguage.googleapis.com/v1beta/models?key={api_key}"
            use_custom_dns = bool(self.get_setting("use_custom_dns", True))
            resp = _gemini_request("GET", url, timeout=12, use_custom_dns=use_custom_dns)
            if resp.status_code == 200:
                data = resp.json()
                raw_models = data.get("models", [])
                extracted = []
                for m in raw_models:
                    methods = m.get("supportedGenerationMethods", [])
                    if "generateContent" in methods:
                        name = m.get("name", "")
                        model_id = name.replace("models/", "").strip()
                        low = model_id.lower()

                        if "gemini" in low and ("flash" in low or "flash-lite" in low):
                            if not any(v in low for v in ["1.0", "1.5", "2.0"]):
                                if not any(bad in low for bad in ["image", "tts", "omni"]):
                                    if model_id not in extracted:
                                        extracted.append(model_id)

                if extracted:
                    extracted.sort(key=sort_models_key)
                    _CACHED_GEMINI_MODELS = extracted
                    self._cached_gemini_models = extracted
                    self.set_setting("cached_models", json.dumps(extracted))
                    if hasattr(self, "save_settings"):
                        try:
                            self.save_settings()
                        except Exception:
                            pass
                    return extracted, None
                return None, "Подходящие модели Gemini (>=2.5 Flash) не найдены"
            else:
                return None, f"Ошибка API {resp.status_code}"
        except Exception as e:
            return None, f"Ошибка сети: {e}"

    def refresh_models(self, v):
        fragment = get_last_fragment()
        api_key = self.get_api_key()
        if not api_key:
            if fragment:
                BulletinHelper.show_error("Сначала укажите API Key в настройках", fragment)
            return

        if fragment:
            BulletinHelper.show_info("Загрузка списка моделей из API...", fragment)

        def worker():
            models, err = self.fetch_remote_models(api_key)
            def update_ui():
                frag = get_last_fragment()
                if models and frag:
                    BulletinHelper.show_success(f"Загружено {len(models)} моделей! Переоткройте настройки для обновления списка", frag)
                elif err and frag:
                    BulletinHelper.show_error(err, frag)
            run_on_ui_thread(update_ui)

        run_on_queue(worker, PLUGINS_QUEUE)

    def get_selected_model(self):
        api_type = self.get_setting("api_type", 0)
        if isinstance(api_type, str) and api_type.isdigit():
            api_type = int(api_type)

        custom_override = self.get_setting("custom_model", "").strip()
        if api_type == 1 and custom_override:
            return custom_override

        models = self.get_models_list()
        if not models:
            return custom_override

        setting_key = "custom_model_index" if api_type == 1 else "model_index"
        cur_idx = self.get_setting(setting_key, 0)
        if isinstance(cur_idx, str) and cur_idx.isdigit():
            cur_idx = int(cur_idx)
        if not isinstance(cur_idx, int) or cur_idx < 0 or cur_idx >= len(models):
            cur_idx = 0
        return models[cur_idx]

    def create_settings(self):
        api_type = self.get_setting("api_type", 0)
        if isinstance(api_type, str) and api_type.isdigit():
            api_type = int(api_type)

        models = self.get_models_list()
        setting_key = "custom_model_index" if api_type == 1 else "model_index"
        cur_idx = self.get_setting(setting_key, 0)
        if isinstance(cur_idx, str) and cur_idx.isdigit():
            cur_idx = int(cur_idx)
        if not isinstance(cur_idx, int) or cur_idx < 0 or cur_idx >= len(models):
            cur_idx = 0

        settings = [
            Header(text="Основные настройки"),
            Selector(key="api_type", text="Тип API / Провайдер", default=api_type, items=["Google Gemini", "OpenAI / Custom Endpoint"], icon="msg_settings"),
        ]

        if api_type == 1:
            custom_items = [
                Header(text="Пользовательский Endpoint (OpenAI / Прочие)"),
                Input(key="custom_endpoint", text="API Endpoint URL", default=self.get_setting("custom_endpoint", "https://api.openai.com/v1"), subtext="Базовый HTTPS URL (напр. https://api.openai.com/v1 или https://openrouter.ai/api/v1)"),
                Input(key="custom_api_key", text="API Ключ (OpenAI / Custom)", default=self.get_setting("custom_api_key", ""), subtext="Ключ авторизации выбранного эндпоинта"),
            ]
            if models:
                custom_items.append(Selector(key="custom_model_index", text="Выбрать модель из списка", default=cur_idx, items=models, icon="msg_list"))
            custom_items.extend([
                Input(key="custom_model", text="Название модели", default=self.get_setting("custom_model", ""), subtext="Введите название модели вручную или выберите из списка выше"),
                Text(text="Обновить список моделей с Endpoint", icon="msg_retry", accent=True, on_click=self.refresh_models)
            ])
            settings.extend(custom_items)
        else:
            gemini_val = self.get_setting("gemini_api_key", "").strip() or self.get_setting("api_key", "").strip()
            gemini_items = [
                Header(text="Google Gemini"),
                Text(text="Получить Gemini API Key", icon="msg_link", accent=True, on_click=lambda v: self.open_api_site()),
                Input(key="gemini_api_key", text="Gemini API Ключ", default=gemini_val, subtext="Ключ из Google AI Studio"),
            ]
            if models:
                gemini_items.append(Selector(key="model_index", text="Активная модель Gemini", default=cur_idx, items=models, icon="msg_list"))
            gemini_items.append(Text(text="Обновить список моделей Gemini", icon="msg_retry", accent=True, on_click=self.refresh_models))
            settings.extend(gemini_items)

        settings.extend([
            Header(text="Обход блокировок Gemini (Malw DNS)"),
            Switch(key="use_custom_dns", text="Обход блокировок", default=True, subtext="Резолв через Malw DNS"),
            Header(text="Настройки сокращения сообщений"),
            Switch(key="force_russian_summary", text="Форсировать русский язык", default=False, subtext="Всегда переводить краткое содержание длинных сообщений на русский")
        ])

        return settings

    def _execute_api_call(self, prompt, sys_inst, api_key):
        api_type = self.get_setting("api_type", 0)
        if isinstance(api_type, str) and api_type.isdigit():
            api_type = int(api_type)

        if api_type == 1:
            raw_endpoint = self.get_setting("custom_endpoint", "https://api.openai.com/v1").strip()
            if not raw_endpoint:
                raw_endpoint = "https://api.openai.com/v1"
            if not raw_endpoint.startswith("https://"):
                raw_endpoint = f"https://{raw_endpoint.replace('http://', '')}"
            endpoint = raw_endpoint.rstrip("/")
            if not endpoint.endswith("/chat/completions"):
                endpoint = f"{endpoint}/chat/completions"

            model = self.get_selected_model()
            if not model:
                return None, "Не выбрана модель. Введите название модели или нажмите 'Обновить список моделей' в настройках"

            headers = {
                "Content-Type": "application/json",
                "User-Agent": "exteraGram-AI/1.2"
            }
            if api_key:
                headers["Authorization"] = f"Bearer {api_key}"

            messages = []
            if sys_inst:
                messages.append({"role": "system", "content": sys_inst})
            messages.append({"role": "user", "content": prompt})

            payload = {
                "model": model,
                "messages": messages
            }

            try:
                resp = requests.post(endpoint, json=payload, headers=headers, timeout=25)
                if resp.status_code == 200:
                    data = resp.json()
                    try:
                        return data["choices"][0]["message"]["content"].strip(), None
                    except Exception:
                        return None, "Не удалось извлечь content из ответа API"
                else:
                    try:
                        err_json = resp.json()
                        err_text = err_json.get("error", {}).get("message", resp.text)
                        return None, f"API Error {resp.status_code}: {err_text}"
                    except Exception:
                        return None, f"API Error {resp.status_code}: {resp.text}"
            except requests.exceptions.RequestException as e:
                return None, f"Ошибка сети ({endpoint}): {e}"
            except Exception as e:
                return None, f"Ошибка запроса: {e}"
        else:
            model = self.get_selected_model()
            if not model:
                model = "gemini-2.5-flash"
            url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
            headers = {"Content-Type": "application/json"}
            payload = {
                "system_instruction": {
                    "parts": [
                        {"text": sys_inst}
                    ]
                },
                "contents": [
                    {
                        "parts": [
                            {"text": prompt}
                        ]
                    }
                ]
            }
            use_custom_dns = bool(self.get_setting("use_custom_dns", True))
            try:
                resp = _gemini_request("POST", url, json_payload=payload, headers=headers, timeout=20, use_custom_dns=use_custom_dns)
                if resp.status_code == 200:
                    data = resp.json()
                    try:
                        return data["candidates"][0]["content"]["parts"][0]["text"].strip(), None
                    except Exception:
                        return None, "Не удалось прочитать ответ Gemini API"
                else:
                    try:
                        err_json = resp.json()
                        err_text = err_json.get("error", {}).get("message", resp.text)
                        return None, f"Gemini API {resp.status_code}: {err_text}"
                    except Exception:
                        return None, f"Gemini API {resp.status_code}"
            except requests.exceptions.RequestException as e:
                return None, f"Ошибка сети Gemini: {e}"
            except Exception as e:
                return None, f"Ошибка Gemini: {e}"

    def process_ai_request(self, alert, api_key):
        try:
            if not api_key:
                def show_key_error():
                    try:
                        set_field(alert, "loading", False)
                        set_field(alert, "translatedTextLoading", False)
                        set_field(alert, "styledTextLoading", False)
                        set_field(alert, "fixedTextLoading", False)
                        button = get_field(alert, "button")
                        if button and hasattr(button, "setLoading"):
                            button.setLoading(False)
                        adapter = get_field(alert, "adapter")
                        if adapter and hasattr(adapter, "update"):
                            adapter.update(True)
                    except Exception:
                        pass
                    frag = get_last_fragment()
                    if frag:
                        BulletinHelper.show_error("Укажите API Key в настройках плагина", frag)
                run_on_ui_thread(show_key_error)
                return

            text_val = get_field(alert, "text")
            if not text_val:
                text_val = get_field(alert, "currentText") or get_field(alert, "sourceText")
            text = str(text_val) if text_val is not None else ""
            if not text:
                def show_empty():
                    set_field(alert, "loading", False)
                    adapter = get_field(alert, "adapter")
                    if adapter and hasattr(adapter, "update"):
                        adapter.update(True)
                    frag = get_last_fragment()
                    if frag:
                        BulletinHelper.show_error("Текст для обработки пуст", frag)
                run_on_ui_thread(show_empty)
                return

            selected_tab = get_field(alert, "selectedTab")
            if selected_tab is None:
                tabs = get_field(alert, "tabs")
                if tabs and hasattr(tabs, "getSelectedTab"):
                    selected_tab = tabs.getSelectedTab()
            try:
                selected_tab = int(selected_tab)
            except Exception:
                selected_tab = 0

            emojify_val = get_field(alert, "emojify")
            emojify = bool(emojify_val) if emojify_val is not None else False

            to_lang_val = get_field(alert, "to_lang")
            to_lang = str(to_lang_val) if to_lang_val is not None else "ru"

            tone_title = ""
            if selected_tab == 1:
                try:
                    style_tabs = get_field(alert, "styleTabs")
                    if style_tabs:
                        selected_tone = style_tabs.getSelectedTone()
                        if selected_tone:
                            if hasattr(selected_tone, "title") and selected_tone.title:
                                tone_title = str(selected_tone.title)
                            elif hasattr(selected_tone, "tone") and selected_tone.tone:
                                tone_title = str(selected_tone.tone)
                except Exception:
                    pass

            run_on_ui_thread(lambda: self._set_alert_loading(alert))

            run_on_queue(lambda: self._worker_ai(alert, text, selected_tab, to_lang, tone_title, emojify, api_key), PLUGINS_QUEUE)
        except Exception as e:
            frag = get_last_fragment()
            if frag:
                BulletinHelper.show_error(f"Ошибка: {e}", frag)

    def process_summarize_request(self, message_object, to_lang, callback, api_key):
        try:
            if not api_key:
                frag = get_last_fragment()
                if frag:
                    BulletinHelper.show_error("Укажите API Key в настройках плагина", frag)
                if callback:
                    callback.run(None)
                return

            owner = getattr(message_object, "messageOwner", None) if message_object else None
            text = ""
            if owner and hasattr(owner, "message") and owner.message:
                text = str(owner.message)
            elif message_object and hasattr(message_object, "caption") and message_object.caption:
                text = str(message_object.caption)

            if not text:
                if callback:
                    run_on_ui_thread(lambda: callback.run(None))
                return

            force_ru = bool(self.get_setting("force_russian_summary", False))

            run_on_queue(lambda: self._worker_summarize(text, to_lang, callback, api_key, force_ru), PLUGINS_QUEUE)
        except Exception:
            if callback:
                run_on_ui_thread(lambda: callback.run(None))

    def _set_alert_loading(self, alert):
        try:
            set_field(alert, "loading", True)
            selected_tab = get_field(alert, "selectedTab") or 0
            if selected_tab == 0:
                set_field(alert, "translatedTextLoading", True)
            elif selected_tab == 1:
                set_field(alert, "styledTextLoading", True)
            else:
                set_field(alert, "fixedTextLoading", True)

            button = get_field(alert, "button")
            if button and hasattr(button, "setLoading"):
                button.setLoading(True)

            action_bar = get_field(alert, "actionBar")
            if action_bar and hasattr(action_bar, "getTitleTextView"):
                title_tv = action_bar.getTitleTextView()
                loading_drawable = get_field(alert, "titleLoadingDrawable")
                if title_tv and loading_drawable:
                    title_tv.setRightDrawable(loading_drawable)
                    if hasattr(loading_drawable, "start"):
                        loading_drawable.start()

            adapter = get_field(alert, "adapter")
            if adapter and hasattr(adapter, "update"):
                adapter.update(True)
        except Exception:
            pass

    def _worker_ai(self, alert, text, selected_tab, to_lang, tone_title, emojify, api_key):
        result_text = None
        error_msg = None

        try:
            target_lang = LANG_MAP.get(str(to_lang).lower(), str(to_lang))

            if selected_tab == 0:
                prompt = f"Translate the following text into {target_lang}. Output ONLY the final translated text without any explanation or extra text:\n\n{text}"
            elif selected_tab == 1:
                tone_str = tone_title if tone_title else "Stylized"
                prompt = f"Rewrite the following text in a '{tone_str}' tone/style while strictly preserving all languages present in the input:\n1. If the text contains mixed languages (e.g. both Russian and English), rewrite the Russian parts in Russian and the English parts in English, in the EXACT SAME order as in the original text.\n2. DO NOT translate any text between languages.\n3. Output ONLY the rewritten text without explanations:\n\n{text}"
            else:
                prompt = f"Proofread and fix all grammar, spelling, and punctuation errors in the following text while strictly preserving all languages present in the input:\n1. If the text contains mixed languages (e.g. both Russian and English), fix the Russian parts in Russian and the English parts in English, in the EXACT SAME order as in the original text.\n2. DO NOT translate any text between languages.\n3. Output ONLY the corrected text without explanations:\n\n{text}"

            if emojify:
                prompt += "\nAdd appropriate emojis where fitting throughout the text."

            sys_inst = "You are a professional text editor. If the input text contains a mix of languages (e.g. Russian and English), you MUST preserve each language in its respective section and maintain the exact original order of languages. NEVER translate text from one language to another unless explicitly requested."

            result_text, error_msg = self._execute_api_call(prompt, sys_inst, api_key)
        except Exception as e:
            error_msg = f"Ошибка: {e}"
        finally:
            def finish_ui():
                try:
                    set_field(alert, "loading", False)
                    set_field(alert, "requestId", -1)
                    set_field(alert, "translatedTextLoading", False)
                    set_field(alert, "styledTextLoading", False)
                    set_field(alert, "fixedTextLoading", False)

                    button = get_field(alert, "button")
                    if button and hasattr(button, "setLoading"):
                        button.setLoading(False)

                    action_bar = get_field(alert, "actionBar")
                    if action_bar and hasattr(action_bar, "getTitleTextView"):
                        title_tv = action_bar.getTitleTextView()
                        if title_tv and hasattr(title_tv, "setRightDrawable"):
                            title_tv.setRightDrawable(None)

                    loading_drawable = get_field(alert, "titleLoadingDrawable")
                    if loading_drawable and hasattr(loading_drawable, "stop"):
                        loading_drawable.stop()

                    if result_text:
                        if selected_tab == 0:
                            set_field(alert, "translatedText", result_text)
                        elif selected_tab == 1:
                            set_field(alert, "styledText", result_text)
                        elif selected_tab == 2:
                            set_field(alert, "fixedText", result_text)
                            set_field(alert, "fixedTextToCopy", result_text)
                        else:
                            set_field(alert, "translatedText", result_text)
                            set_field(alert, "styledText", result_text)
                            set_field(alert, "fixedText", result_text)
                            set_field(alert, "fixedTextToCopy", result_text)

                        last_req = get_field(alert, "lastRequest")
                        if last_req is not None:
                            try:
                                last_req[selected_tab] = 0
                            except Exception:
                                pass
                    elif error_msg:
                        fragment = get_last_fragment()
                        if fragment:
                            BulletinHelper.show_error(error_msg, fragment)

                    try:
                        if hasattr(alert, "updateButton"):
                            alert.updateButton(False)
                    except Exception:
                        pass

                    adapter = get_field(alert, "adapter")
                    if adapter:
                        if hasattr(adapter, "update"):
                            adapter.update(True)
                        elif hasattr(adapter, "notifyDataSetChanged"):
                            adapter.notifyDataSetChanged()
                except Exception:
                    pass

            run_on_ui_thread(finish_ui)

    def _worker_summarize(self, text, to_lang, callback, api_key, force_ru):
        result_text = None
        error_msg = None
        if force_ru:
            prompt = f"Summarize the following text concisely. CRITICAL: The summary MUST be entirely translated into RUSSIAN. Output ONLY the summary in Russian without any introductions, explanations or markdown quotes:\n\n{text}"
            sys_inst = "You are a professional text summarizer. You MUST ALWAYS write the output summary in Russian language regardless of the input text language."
        else:
            prompt = (
                f"Summarize the following text concisely. STRICT LANGUAGE RULES:\n"
                f"1. You MUST write the summary in the EXACT SAME language(s) that the original text is written in. (For example, if the original text is written in English, the summary MUST be written in English. Do NOT translate it to Spanish or any other language!).\n"
                f"2. Ignore any flag emojis (like 🇪🇸) or country names when determining the language. Look strictly at the actual text language.\n"
                f"3. If the original text contains mixed languages, preserve the original language for each respective section in the exact same order.\n"
                f"4. Output ONLY the concise summary without introductions, explanations, or markdown quotes:\n\n{text}"
            )
            sys_inst = (
                "You are a professional text summarizer. You MUST ALWAYS write the summary in the exact same language as the input text. "
                "NEVER translate English text into Spanish or any other language unless explicitly requested. "
                "Country names and flag emojis MUST NOT influence the language of the output summary."
            )

        try:
            result_text, error_msg = self._execute_api_call(prompt, sys_inst, api_key)
        except Exception as e:
            error_msg = f"Ошибка подключения: {e}"

        def finish_ui():
            try:
                if result_text:
                    ent_cls = find_class("org.telegram.tgnet.TLRPC$TL_textWithEntities")
                    if ent_cls:
                        ent_obj = ent_cls()
                        ent_obj.text = result_text
                        if callback:
                            callback.run(ent_obj)
                            return

                if error_msg:
                    fragment = get_last_fragment()
                    if fragment:
                        BulletinHelper.show_error(error_msg, fragment)

                if callback:
                    callback.run(None)
            except Exception:
                if callback:
                    callback.run(None)

        run_on_ui_thread(finish_ui)
