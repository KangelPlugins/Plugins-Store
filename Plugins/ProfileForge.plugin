    def _apply_preset(self, preset_key: str):
        try:
            preset = self.PRESETS.get(preset_key)
            if not preset:
                return

            self.set_setting(self.SETTINGS_EFFECT_PRESET, preset_key)

            if preset.get("blur") is not None:
                self.set_setting(self.SETTINGS_BLUR_INTENSITY, preset["blur"])
            if preset.get("darken") is not None:
                self.set_setting(self.SETTINGS_DARKEN_INTENSITY, preset["darken"])

            self._reload_plugin_settings()
            self._drop_all_bitmap_cache()

            fragment = self._safe_get_fragment()
            self._invalidate_profile_view(fragment)

        except Exception as e:
            self._log(f"Error applying preset: {e}")

