    def _show_preset_choice_dialog(self):
        try:
            fragment = get_last_fragment()
            parent = fragment.getParentActivity() if fragment else None
            if parent is None:
                self._notify(self._s("screen_error"))
                return

            preset_names = [self._get_preset_name(k) for k in self.PRESETS.keys()]
