    def __init__(self):
        super().__init__()
        self._last_target_fragment_ref = None
        self._activity_hook = None

        self._bmp_map = {}
        self._bmp_blur_map = {}
        self._src_map = {}

        self._plugin_dir = ""
        self._hook_on_draw_ref = None
        self._hooked_topview_classname = None
        self._watcher_stop = False

        self._theme_hook_refs = []
        self._theme_keys = {}

        self._last_blur_percent = None

        self._log_buffer = []
        self._debug_enabled = False

        self._custom_typeface = None
        self._bitmap_cache = {}

        self._current_lang = self.LANG_EN

        try:
            self._CanvasClass = find_class("android.graphics.Canvas")
        except Exception:
            self._CanvasClass = None

        self.HAS_DIVIDER = True
        try:
            Divider
        except NameError:
            self.HAS_DIVIDER = False

    # ====================== LOCALIZATION HELPERS ======================

    def _get_lang(self):
        try:
            lang = self._get_str(self.SETTINGS_LANGUAGE, self.LANG_EN).strip().lower()
            if lang not in (self.LANG_EN, self.LANG_RU):
                lang = self.LANG_EN
            return lang
        except Exception:
            return self.LANG_EN

    def _s(self, key, *args):
        """Get localized string by key"""
        lang = self._get_lang()
        try:
            text = self.STRINGS[lang].get(key, self.STRINGS[self.LANG_EN].get(key, key))
            if args:
                return text.format(*args)
            return text
        except Exception:
            return key

    def _get_font_name(self, key):
        lang = self._get_lang()
        if lang == self.LANG_RU:
            return self.FONTS_RU.get(key, self.FONTS.get(key, key))
        return self.FONTS.get(key, key)

    def _get_preset_name(self, key):
        lang = self._get_lang()
        preset = self.PRESETS.get(key, {})
        if lang == self.LANG_RU:
            return preset.get("name_ru", preset.get("name_en", key))
        return preset.get("name_en", key)

    def _get_effect_options(self):
        lang = self._get_lang()
        if lang == self.LANG_RU:
            return self.EFFECT_OPTIONS_RU
        return self.EFFECT_OPTIONS_EN

    def _get_gradient_direction_name(self, key):
        lang = self._get_lang()
        if lang == self.LANG_RU:
            return self.GRADIENT_DIRECTIONS_RU.get(key, key)
        return self.GRADIENT_DIRECTIONS.get(key, key)

    # ====================== LOGGING ======================

    def _log(self, msg: str, also_ui: bool = False):
        try:
            ts = datetime.now().strftime("%H:%M:%S")
            line = f"{ts} {msg}"
            self._log_buffer.append(line)
            if len(self._log_buffer) > 300:
                self._log_buffer = self._log_buffer[-200:]
            log(f"{_TAG} {msg}")
            if also_ui:
                try:
                    BulletinHelper.show(f"{_TAG} {msg}")
                except Exception:
                    pass
        except Exception:
            pass

    def _dump_logs_dialog(self, parent_activity):
        try:
            text = "\n".join(self._log_buffer[-200:]) if self._log_buffer else self._s("logs_empty")
            b = AlertDialogBuilder(parent_activity)
            b.set_title(self._s("logs_title"))
            b.set_message(text)
            b.set_positive_button("OK", None)
            b.set_neutral_button(self._s("copy_logs"), lambda d, w: self._copy_logs_to_clipboard(parent_activity))
            b.show()
        except Exception:
            try:
                BulletinHelper.show("Failed to show logs")
            except Exception:
                pass

    def _copy_logs_to_clipboard(self, parent_activity=None):
        try:
            text = "\n".join(self._log_buffer[-200:]) if self._log_buffer else self._s("logs_empty")
            clipboard = ApplicationLoader.applicationContext.getSystemService(Context.CLIPBOARD_SERVICE)
            clip = ClipData.newPlainText("ProfileForge Logs", text)
            clipboard.setPrimaryClip(clip)
            BulletinHelper.show(self._s("logs_copied"))
        except Exception:
            try:
                BulletinHelper.show(self._s("copy_failed"))
            except Exception:
                pass

    # ====================== LIFECYCLE ======================

    def on_plugin_load(self):
        self._ensure_defaults()
        self._ensure_plugin_dir()
        self._load_custom_fonts()

        self._debug_enabled = self._get_bool(self.SETTINGS_DEBUG_ENABLE, False)
        self._current_lang = self._get_lang()

        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.PROFILE_ACTION_MENU,
                text=self._s("custom_background"),
                icon="msg_gallery",
                on_click=self._menu_set_custom_bg,
                priority=1000
            ))
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.PROFILE_ACTION_MENU,
                text=self._s("effect_presets"),
                icon="msg_effect",
                on_click=self._menu_show_presets,
                priority=990
            ))
        except Exception as e:
            self._log(f"Error adding menu items: {e}")

        self._install_theme_hooks()

        t = threading.Thread(target=self._watcher_loop, name="ProfileForgeWatcher", daemon=True)
        t.start()

    def on_plugin_unload(self):
        self._watcher_stop = True

        if self._hook_on_draw_ref:
            try:
                self.unhook_method(self._hook_on_draw_ref)
            except Exception:
                pass
            self._hook_on_draw_ref = None
        self._hooked_topview_classname = None

        for ref in self._theme_hook_refs:
            try:
                if ref:
                    self.unhook_method(ref)
            except Exception:
                pass
        self._theme_hook_refs = []

        if self._activity_hook:
            try:
                self._activity_hook.unhook()
            except Exception:
                pass
            self._activity_hook = None

    def _load_custom_fonts(self):
        try:
            font_family = self._get_str(self.SETTINGS_FONT_FAMILY, "default")
            if font_family != "default":
                self._custom_typeface = Typeface.create(font_family, Typeface.NORMAL)
            else:
                self._custom_typeface = None
        except Exception as e:
            self._log(f"Error loading fonts: {e}")
            self._custom_typeface = None

    # ====================== SETTINGS UI ======================

    def create_settings(self):
        return self._build_settings()

    def get_settings(self):
        return self._build_settings()

    def _build_settings(self):
        try:
            blur_percent = self._get_percent(self.SETTINGS_BLUR_INTENSITY, 60)
            darken_percent = self._get_percent(self.SETTINGS_DARKEN_INTENSITY, 70)
            is_avatar_banner_enabled = self._get_bool(self.SETTINGS_AVATAR_BANNER_ENABLE, True)
            
            font_family = self._get_str(self.SETTINGS_FONT_FAMILY, "default")
            font_size = self._get_int(self.SETTINGS_FONT_SIZE, 18)
            is_gradient_enabled = self._get_bool(self.SETTINGS_GRADIENT_ENABLE, False)
            gradient_direction = self._get_str(self.SETTINGS_GRADIENT_DIRECTION, "horizontal").strip().lower()
            if gradient_direction not in self.GRADIENT_DIRECTIONS:
                gradient_direction = "horizontal"

            current_effect_value = self._get_effect_str(self.SETTINGS_AVATAR_BANNER_EFFECT, "darken")
            try:
                effect_default_index = self.EFFECT_VALUES.index(current_effect_value)
            except ValueError:
                effect_default_index = 0

            current_preset = self._get_str(self.SETTINGS_EFFECT_PRESET, "cinematic")
            current_lang = self._get_lang()
            
            rows = [
                Header(text=self._s("plugin_name"))
            ]

            # Language selector
            rows.append(Header(text=self._s("language")))
            rows.append(Text(
                text=self._s("language_en") if current_lang == self.LANG_EN else self._s("language_ru"),
                on_click=lambda view: self._show_language_choice_dialog()
            ))
            if self.HAS_DIVIDER:
                rows.append(Divider())

            rows.append(Header(text=self._s("effect_presets")))
            rows.append(Text(
                text=self._s("current_preset", self._get_preset_name(current_preset)),
                on_click=lambda view: self._show_preset_choice_dialog()
            ))
            if self.HAS_DIVIDER:
                rows.append(Divider())

            rows.append(Header(text=self._s("fonts")))
            rows.append(Text(
                text=self._s("font", self._get_font_name(font_family)),
                on_click=lambda view: self._show_font_choice_dialog()
            ))
            rows.append(Input(
                key=self.SETTINGS_FONT_SIZE,
                text=self._s("font_size"),
                subtext=self._s("font_size_sub"),
                default=str(font_size),
                on_change=self._on_font_size_changed
            ))
            if self.HAS_DIVIDER:
                rows.append(Divider())

            rows.append(Header(text=self._s("gradient_nicknames")))
            rows.append(Switch(
                key=self.SETTINGS_GRADIENT_ENABLE,
                text=self._s("enable_gradient"),
                subtext=self._s("enable_gradient_sub"),
                default=is_gradient_enabled,
                on_change=self._on_gradient_enable_changed
            ))
            rows.append(Input(
                key=self.SETTINGS_GRADIENT_START,
                text=self._s("gradient_start"),
                subtext=self._s("gradient_start_sub"),
                default=self._get_str(self.SETTINGS_GRADIENT_START, "#FF5F6D"),
                on_change=self._on_gradient_start_changed
            ))
            rows.append(Input(
                key=self.SETTINGS_GRADIENT_END,
                text=self._s("gradient_end"),
                subtext=self._s("gradient_end_sub"),
                default=self._get_str(self.SETTINGS_GRADIENT_END, "#6A82FB"),
                on_change=self._on_gradient_end_changed
            ))
            rows.append(Text(
                text=self._s("gradient_direction", self._get_gradient_direction_name(gradient_direction)),
                on_click=lambda view: self._show_gradient_direction_dialog()
            ))
            if self.HAS_DIVIDER:
                rows.append(Divider(text=self._s("gradient_global_info")))
            else:
                rows.append(Text(text=self._s("gradient_global_info")))
            if self.HAS_DIVIDER:
                rows.append(Divider())

            rows.append(Header(text=self._s("custom_background")))
            rows.append(Input(
                key=self.SETTINGS_BLUR_INTENSITY,
                text=self._s("blur_intensity"),
                subtext=self._s("blur_intensity_sub"),
                default=str(blur_percent),
                on_change=self._on_blur_intensity_changed
            ))
            rows.append(Input(
                key=self.SETTINGS_DARKEN_INTENSITY,
                text=self._s("darken_intensity"),
                subtext=self._s("darken_intensity_sub"),
                default=str(darken_percent),
                on_change=self._on_darken_intensity_changed
            ))

            if self.HAS_DIVIDER:
                rows.append(Divider(text=self._s("bg_info")))
            else:
                rows.append(Text(text=self._s("bg_info")))

            if self.HAS_DIVIDER:
                rows.append(Divider())

            rows.append(Header(text=self._s("avatar_banner")))
            rows.append(Switch(
                key=self.SETTINGS_AVATAR_BANNER_ENABLE,
                text=self._s("enable_avatar"),
                subtext=self._s("enable_avatar_sub"),
                default=is_avatar_banner_enabled,
                on_change=self._on_avatar_banner_enable_changed
            ))
            if is_avatar_banner_enabled:
                effect_options = self._get_effect_options()
                rows.append(Text(
                    text=self._s("avatar_effect", effect_options[effect_default_index]),
                    on_click=lambda view: self._show_effect_choice_dialog()
                ))

            if self.HAS_DIVIDER:
                rows.append(Divider(text=self._s("avatar_priority")))
            else:
                rows.append(Text(text=self._s("avatar_priority")))

            if self.HAS_DIVIDER:
                rows.append(Divider())

            rows.append(Header(text=self._s("debug")))
            rows.append(Switch(
                key=self.SETTINGS_DEBUG_ENABLE,
                text=self._s("enable_logging"),
                subtext=self._s("enable_logging_sub"),
                default=self._debug_enabled,
                on_change=self._on_debug_changed
            ))
            if self._debug_enabled:
                rows.append(Text(
                    text=self._s("show_logs"),
                    on_click=lambda view: self._show_debug_logs()
                ))

            return rows
        except Exception as e:
            self._log(f"Error building settings: {e}")
            return [Header("Profile Forge"), Text(self._s("settings_error"))]

    # ====================== LANGUAGE DIALOG ======================

    def _show_language_choice_dialog(self):
        try:
            fragment = get_last_fragment()
            parent = fragment.getParentActivity() if fragment else None
            if parent is None:
                self._notify(self._s("screen_error"))
                return

            lang_options = [self._s("language_en"), self._s("language_ru")]
            lang_values = [self.LANG_EN, self.LANG_RU]

            def on_lang_selected(dialog_builder, index):
                try:
                    selected = lang_values[index]
                    self.set_setting(self.SETTINGS_LANGUAGE, selected)
                    self._reload_plugin_settings()
                    self._notify(f"Language set to: {lang_options[index]}")
                except IndexError:
                    pass
                except Exception as e:
                    self._log(f"Error applying language: {e}")

            builder = AlertDialogBuilder(parent)
            builder.set_title(self._s("language"))
            builder.set_items(lang_options, on_lang_selected)
            builder.set_negative_button(self._s("cancel"), None)
            builder.show()
        except Exception as e:
            self._log(f"Error showing language dialog: {e}")

    # ====================== SELECTION DIALOGS ======================

    def _show_font_choice_dialog(self):
        try:
            fragment = get_last_fragment()
            parent = fragment.getParentActivity() if fragment else None
            if parent is None:
                self._notify(self._s("screen_error"))
                return

            font_names = [self._get_font_name(k) for k in self.FONTS.keys()]
            font_keys = list(self.FONTS.keys())

            def on_font_selected(dialog_builder, index):
                try:
                    selected_font = font_keys[index]
                    self.set_setting(self.SETTINGS_FONT_FAMILY, selected_font)
                    self._load_custom_fonts()
                    self._reload_plugin_settings()
                    self._invalidate_profile_view(self._safe_get_fragment())
                    self._notify(self._s("font_applied", self._get_font_name(selected_font)))
                except IndexError:
                    pass
                except Exception as e:
                    self._log(f"Error applying font: {e}")

            builder = AlertDialogBuilder(parent)
            builder.set_title(self._s("select_font"))
            builder.set_items(font_names, on_font_selected)
            builder.set_negative_button(self._s("cancel"), None)
            builder.show()
        except Exception as e:
            self._log(f"Error showing font dialog: {e}")

