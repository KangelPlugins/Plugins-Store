_CALENDAR_ICON_NAMES = ("msg_calendar2", "msg_calendar", "calendar")
_CLEAR_ICON_NAMES = ("ic_close_white", "ic_ab_search_clear", "input_clear_material", "msg_close")

_ICON_ID_CACHE: dict = {}

def _resolve_icon_id_cached(cache_key: str, ctx, tg_names: tuple, fallback_names: tuple) -> int:
    if cache_key in _ICON_ID_CACHE:
        return _ICON_ID_CACHE[cache_key]
    rid = 0
    try:
        for name in tg_names:
            rid = getattr(R_tg.drawable, name, 0)
            if rid:
                break
    except Exception:
        rid = 0
    if not rid:
        try:
            res = ctx.getResources()
            pkg = ctx.getPackageName()
            for name in fallback_names:
                found = res.getIdentifier(name, "drawable", pkg)
                if found != 0:
                    rid = found
                    break
        except Exception:
            pass
    rid = int(rid or 0)
    _ICON_ID_CACHE[cache_key] = rid
    return rid

def _resolve_search_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("search", ctx, ("outline_header_search", "msg_search"), _SEARCH_ICON_NAMES)

def _resolve_status_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("status", ctx, ("iv_lists", "outline_header_search", "msg_search"), _STATUS_ICON_NAMES)

def _resolve_star_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("star", ctx, ("star_small_outline",), _STAR_ICON_NAMES)

def _resolve_calendar_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("calendar", ctx, ("msg_calendar2",), _CALENDAR_ICON_NAMES)

def _resolve_clear_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("clear", ctx, ("ic_close_white", "ic_ab_search_clear"), _CLEAR_ICON_NAMES)

def _wrap_custom_emoji(emoji_char: str) -> str:
    eid = CUSTOM_EMOJI_IDS.get(emoji_char)
    if not eid:
        return emoji_char
    return f'<emoji id="{eid}">{emoji_char}</emoji>'

def _apply_custom_emoji(text: str) -> str:
    if not text:
        return text
    if not any(ch in text for ch in CUSTOM_EMOJI_IDS):
        return text
    out = []
    i, n = 0, len(text)
    while i < n:
        if text.startswith("<emoji", i):
            end = text.find("</emoji>", i)
            if end != -1:
                end += len("</emoji>")
                out.append(text[i:end])
                i = end
                continue
        ch = text[i]
        if ch in CUSTOM_EMOJI_IDS:
            out.append(_wrap_custom_emoji(ch))
            i += 1
            continue
        out.append(ch)
        i += 1
    return "".join(out)

