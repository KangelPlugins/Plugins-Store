MD3_SHAPE_FULL = 100

MD3_ELEVATION_RESTING = 2
MD3_ELEVATION_PRESSED = 6

_MATERIAL_SPRING = OvershootInterpolator(0.4)
_MATERIAL_STANDARD = PathInterpolator(0.4, 0.0, 0.2, 1.0)


@java_subclass(JObject, TextWatcher)
class _QueryWatcher(Base):
    def __init__(self, callback):
        self.callback = callback

    @joverride()
    def beforeTextChanged(self, s, start, count, after):
        pass

    @joverride()
    def onTextChanged(self, s, start, before, count):
        pass

    @joverride()
    def afterTextChanged(self, s):
        try:
            self.callback("" if s is None else str(s))
        except Exception:
            pass


@java_subclass(JObject, ViewOutlineProvider)
class _RoundedOutlineProvider(Base):
    def __init__(self, radius_px: float):
        self.radius_px = radius_px

    @joverride()
    def getOutline(self, view, outline):
        try:
            outline.setRoundRect(0, 0, view.getWidth(), view.getHeight(), float(self.radius_px))
        except Exception:
            pass


@java_subclass(JObject, View.OnTouchListener)
class _PressElevationListener(Base):
    def __init__(self, target, resting_px: float, pressed_px: float):
        self.target = target
        self.resting_px = float(resting_px)
        self.pressed_px = float(pressed_px)

    @joverride()
    def onTouch(self, v, event):
        try:
            action = event.getAction()
            if action == MotionEvent.ACTION_DOWN:
                self.target.setElevation(self.pressed_px)
            elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                self.target.setElevation(self.resting_px)
        except Exception:
            pass
        return False


@java_subclass(JObject, View.OnTouchListener)
class _ClearFieldTouchListener(Base):
    def __init__(self, edit_text, on_clear):
        self.edit_text = edit_text
        self.on_clear = on_clear

    @joverride()
    def onTouch(self, v, event):
        try:
            if event.getAction() == MotionEvent.ACTION_UP:
                drawables = self.edit_text.getCompoundDrawables()
                end_drawable = drawables[2] if drawables else None
                if end_drawable is not None:
                    icon_w = end_drawable.getBounds().width()
                    hit_zone = icon_w + dp(16)
                    if event.getX() >= v.getWidth() - v.getPaddingRight() - hit_zone:
                        self.on_clear()
                        return True
        except Exception:
            pass
        return False


class ShikimoriPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        try:
            self.search_menu_item_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="Поиск аниме",
                    on_click=self._handle_menu_search,
                    icon="msg_media",
                    subtext="Shikimori",
                    priority=5,
                )
            )
        except Exception as e:
            self.log(f"Не удалось добавить пункт меню: {e}")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Аккаунт"),
            Input(
                key="nickname",
                text="Никнейм",
                default="",
                subtext="Ваш ник на Shikimori — нужен для команды .i",
                icon="settings_account",
            ),
            Text(
                text="Проверить никнейм",
                subtext="Проверка аккаунта на Shikimori",
                icon="menu_verification",
                on_click=self._manual_check_nickname,
            ),
            Header(text="Справка"),
            Text(
                text="Команды",
                subtext="Как искать аниме и смотреть статистику",
                icon="msg_help",
                on_click=self._show_help_dialog,
            ),
        ]

    def _show_help_dialog(self, view=None):
        self._show_dialog(
            "Команды",
            ".s <запрос> - открыть inline-поиск аниме "
            "(можно сразу с текстом или пустым полем)\n\n"
            ".i - ваша статистика с количеством просмотренных серий "
            "по каждому статусу (нужен никнейм в настройках)",
        )

    def _manual_check_nickname(self, view=None):
        nick = self.get_setting("nickname", "").strip()
        if not nick:
            self._show_dialog("Никнейм не указан", "Сначала введите его в поле выше")
            return
        run_on_queue(lambda: self._do_check_nickname(nick))

    def _do_check_nickname(self, nickname: str, silent: bool = False):
        try:
            data = self._api_get(f"/users/{nickname}", {"is_nickname": 1})
            if not data or not data.get("id"):
                if not silent:
                    self._show_dialog("Профиль не найден", f"На Shikimori нет пользователя «{nickname}»")
                return None
            if not silent:
                self._show_dialog("Всё в порядке", f"Профиль {data.get('nickname')} найден и доступен")
            return data
        except Exception as e:
            if not silent:
                self._show_dialog("Не удалось проверить", str(e))
            return None

    def _resolve_user_id(self):
        nick = self.get_setting("nickname", "").strip()
        return nick or None

    def _api_get(self, path: str, query: dict = None, timeout=DEFAULT_TIMEOUT) -> Any:
        url = f"{BASE_URL}{path}"
        if query:
            url += "?" + urlencode(query)
        resp = _throttled_get(url, timeout)
        resp.raise_for_status()
        return resp.json()

    def _bulletin_info(self, text: str):
        try:
            BulletinHelper.show_info(text)
        except Exception:
            pass

    def _bulletin_error(self, text: str):
        try:
            BulletinHelper.show_error(text)
        except Exception:
            pass

    def _send_formatted(self, peer_id: int, text: str, parse_mode: str = "HTML"):
        if not peer_id:
            return
        try:
            if parse_mode and parse_mode.upper() == "HTML":
                text_to_parse = _apply_custom_emoji(text)
            else:
                text_to_parse = text
            parsed = parse_text(text_to_parse, parse_mode=parse_mode)
            send_message({"peer": peer_id, "message": parsed["message"], "entities": parsed.get("entities")})
        except Exception:
            try:
                send_text(peer_id, text)
            except Exception:
                pass

    def _show_dialog(self, title: str, message: str):
        def _do():
            try:
                frag = get_last_fragment()
                if not frag:
                    return
                act = frag.getParentActivity()
                if not act:
                    return
                b = AlertDialogBuilder(act)
                b.set_title(title)
                b.set_message(message)
                b.set_positive_button("OK", lambda b, w: b.dismiss())
                b.show()
            except Exception:
                pass
        run_on_ui_thread(_do)

    def _format_anime(self, a: dict, anime_id: int = 0) -> str:
        title_ru = a.get("russian") or a.get("name") or "Без названия"
        year = ""
        aired = a.get("aired_on")
        if aired and len(str(aired)) >= 4:
            year = str(aired)[:4]
        status_key = a.get("status")
        status = STATUS_LABELS.get(status_key, status_key or "?")
        status_icon = STATUS_ICONS.get(status_key, "❔")
        kind = KIND_LABELS.get(a.get("kind"), a.get("kind") or "?")
        score = a.get("score") or 0
        ep_aired = a.get("episodes_aired") or 0
        ep_total = a.get("episodes") or 0

        lines = [
            f"<b>{title_ru}</b>",
            "",
            f"\u2B50 <b>Рейтинг:</b> {score}",
            f"{status_icon} <b>Статус:</b> {status}",
            f"\U0001F4C5 <b>Год:</b> {year or '—'}",
            f"<emoji id=\"5447512780515078098\">\U0001F3AC</emoji> <b>Тип:</b> {kind}",
            f"\U0001F4FA <b>Эпизоды:</b> {ep_aired}/{ep_total if ep_total else '?'}",
        ]
        card = f"<blockquote>{chr(10).join(lines)}</blockquote>"
        if anime_id:
            card += f"\n\U0001F517 <a href='{SITE_URL}/animes/{anime_id}'>Открыть на Shikimori</a>"
        return card

    def _send_anime(self, peer_id: int, anime: dict):
        aid = anime.get("id", 0)
        caption = self._format_anime(anime, anime_id=aid)
        run_on_ui_thread(lambda: self._send_formatted(peer_id, caption, "HTML"))

    def _stats_from_user_payload(self, user: dict) -> dict:
        stats = {}
        try:
            entries = ((user.get("stats") or {}).get("statuses") or {}).get("anime") or []
            for entry in entries:
                name = entry.get("name")
                if not name:
                    continue
                stats[name] = {"count": entry.get("size") or 0, "episodes": None}
        except Exception as e:
            self.log(f"_stats_from_user_payload: {e}")
        return stats

    def _fetch_user_payload(self, nickname: str) -> Optional[dict]:
        key = ("user_profile", nickname.lower())
        cached = _cache_get(key, PROFILE_TTL)
        if cached is not None:
            return cached
        user = self._api_get(f"/users/{nickname}", {"is_nickname": 1})
        if user and user.get("id"):
            _cache_set(key, user)
        return user

    def _get_user_stats(self, nickname: str) -> dict:
        stats = {
            "watching": {"count": 0, "episodes": 0},
            "planned": {"count": 0, "episodes": 0},
            "rewatching": {"count": 0, "episodes": 0},
            "completed": {"count": 0, "episodes": 0},
            "on_hold": {"count": 0, "episodes": 0},
            "dropped": {"count": 0, "episodes": 0},
        }
        page = 1
        limit = STATS_PAGE_LIMIT

        def fetch_page(p: int):
            return self._api_get(
                f"/users/{nickname}/anime_rates",
                {"is_nickname": 1, "page": p, "limit": limit},
                timeout=PAGE_TIMEOUT,
            )

        with ThreadPoolExecutor(max_workers=STATS_BATCH_SIZE) as ex:
            while True:
                batch_pages = list(range(page, page + STATS_BATCH_SIZE))
                futures = {ex.submit(fetch_page, p): p for p in batch_pages}
                page_results, page_errors = {}, {}
                for fut in as_completed(futures):
                    p = futures[fut]
                    try:
                        page_results[p] = fut.result() or []
                    except Exception as e:
                        page_errors[p] = e

                stop = False
                for p in batch_pages:
                    if p in page_errors:
                        raise page_errors[p]
                    rates = page_results.get(p, [])
                    for rate in rates:
                        status = rate.get("status")
                        if status not in stats:
                            continue
                        stats[status]["count"] += 1
                        anime = rate.get("anime", {})
                        stats[status]["episodes"] += anime.get("episodes_aired", 0)
                    if len(rates) < limit:
                        stop = True
                        break
                if stop:
                    break
                page += STATS_BATCH_SIZE
        return stats

    def _cmd_profile(self, peer_id: int):
        nickname = self._resolve_user_id()
        if not nickname:
            run_on_ui_thread(lambda: self._send_formatted(
                peer_id,
                "Укажите ваш никнейм в настройках плагина",
                "HTML",
            ))
            return
        run_on_queue(lambda: self._fetch_profile(peer_id, nickname))

    def _fetch_profile(self, peer_id: int, nickname: str):
        try:
            user = self._fetch_user_payload(nickname)
            if not user or not user.get("id"):
                run_on_ui_thread(lambda: self._send_formatted(
                    peer_id,
                    f"Профиль «{nickname}» не найден",
                    "HTML",
                ))
                return

            cache_key = ("profile_stats_full", nickname.lower())
            stats = _cache_get(cache_key, PROFILE_TTL)
            if stats is None:
                self._bulletin_info("Собираю информацию…")
                stats = self._get_user_stats(nickname)
                _cache_set(cache_key, stats)

            self._send_profile(peer_id, user, stats)
        except Exception as e:
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"Ошибка: {e}", "HTML"))

    def _send_profile(self, peer_id: int, user: dict, stats: dict):
        total_count = sum(s.get("count", 0) for s in stats.values())
        total_episodes = sum((s.get("episodes") or 0) for s in stats.values())

        status_map = {
            "watching": ("\U0001F4FA", "Смотрю"),
            "rewatching": ("\U0001f504", "Пересматриваю"),
            "completed": ("\u2705", "Просмотрено"),
            "planned": ("\U0001F4C5", "В планах"),
            "on_hold": ("\u23F8", "Отложено"),
            "dropped": ("\u274C", "Брошено"),
        }

        lines = [
            f"\U0001F464 <b>{user.get('nickname', 'Unknown')}</b>",
        ]
        if user.get("name"):
            lines.append(f"<i>{user['name']}</i>")
        lines.append("")

        shown_any = False
        for status, (icon, label) in status_map.items():
            data = stats.get(status)
            if not data or not data.get("count"):
                continue
            count = data["count"]
            episodes = data.get("episodes") or 0
            lines.append(f"{icon} {label}: {count} · {episodes} эп.")
            shown_any = True
        if not shown_any:
            lines.append("<i>Список пуст</i>")

        lines.append("")
        lines.append(f"\U0001F4CA Итого: {total_count} тайтлов, {total_episodes} серий")

        text = f"<blockquote expandable>{chr(10).join(lines)}</blockquote>"
        text += f"\n\U0001F517 <a href='{SITE_URL}/{user['nickname']}'>Открыть профиль на Shikimori</a>"
        run_on_ui_thread(lambda: self._send_formatted(peer_id, text, "HTML"))

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        try:
            msg = getattr(params, "message", None)
            if not isinstance(msg, str):
                return HookResult()
            text = msg.strip()
            low = text.lower()

            if low == ".i":
                mode, arg = "i", ""
            elif low.startswith(".i "):
                peer = getattr(params, "peer", None) or getattr(params, "dialog_id", None)
                peer_id = self._extract_peer_id(peer)
                if peer_id:
                    run_on_ui_thread(lambda: self._send_formatted(peer_id, "\u274C Используйте просто .i", "HTML"))
                return HookResult(strategy=HookStrategy.CANCEL)
            elif low == ".s" or low.startswith(".s "):
                mode, arg = "s", text[2:].strip()
            else:
                return HookResult()

            peer = getattr(params, "peer", None) or getattr(params, "dialog_id", None)
            peer_id = self._extract_peer_id(peer)
            if not peer_id:
                return HookResult()

            if mode == "s":
                run_on_ui_thread(lambda: self._open_inline_search(peer_id, arg))
                return HookResult(strategy=HookStrategy.CANCEL)

            if mode == "i":
                run_on_queue(lambda: self._cmd_profile(peer_id))
                return HookResult(strategy=HookStrategy.CANCEL)

            return HookResult()
        except Exception:
            return HookResult()

    def _handle_menu_search(self, context: dict):
        try:
            peer_id = 0
            dialog_id = context.get("dialog_id")
            if isinstance(dialog_id, int):
                peer_id = dialog_id
            if not peer_id:
                user_id = context.get("userId")
                chat_id = context.get("chatId")
                if user_id:
                    peer_id = user_id
                elif chat_id:
                    peer_id = -chat_id
            if not peer_id:
                return
            self._open_inline_search(peer_id, "")
        except Exception as e:
            self.log(f"Не удалось открыть поиск из меню: {e}")

    def _extract_peer_id(self, peer) -> int:
        if peer is None:
            return 0
        if isinstance(peer, int):
            return peer
        try:
            uid = getattr(peer, "user_id", 0)
            if uid:
                return uid
            cid = getattr(peer, "chat_id", 0)
            if cid:
                return -cid
            chid = getattr(peer, "channel_id", 0)
            if chid:
                return -(1000000000000 + chid)
            return 0
        except Exception:
            return 0

    def _search_animes(self, query: str, page: int = 1, limit: int = SEARCH_LIMIT) -> list:
        key = ("search", query.lower(), page, limit)
        cached = _cache_get(key, SEARCH_TTL)
        if cached is not None:
            return cached
        results = self._api_get("/animes", {"search": query, "limit": limit, "page": page}, timeout=SEARCH_TIMEOUT) or []
        _cache_set(key, results)
        return results

    def _search_with_fallback(self, query: str, page: int = 1) -> Tuple[list, str]:
        attempts = [query]
        stripped = query.strip(" .,!?-_\u2014\u2013\"'")
        if stripped and stripped != query:
            attempts.append(stripped)
        words = query.split()
        if len(words) > 1:
            attempts.append(" ".join(words[:-1]))
            if len(words) > 2:
                attempts.append(" ".join(words[:1]))

        seen = set()
        ordered = []
        for q in attempts:
            q = q.strip()
            if q and q not in seen:
                seen.add(q)
                ordered.append(q)
        if not ordered:
            return [], query
        if len(ordered) == 1:
            try:
                return self._search_animes(ordered[0], page), ordered[0]
            except Exception:
                return [], query

        with ThreadPoolExecutor(max_workers=min(4, len(ordered))) as ex:
            futures = {ex.submit(self._search_animes, q, page): q for q in ordered}
            results_map = {}
            for fut in as_completed(futures):
                q = futures[fut]
                try:
                    results_map[q] = fut.result() or []
                except Exception:
                    results_map[q] = []
                for candidate in ordered:
                    if candidate not in results_map:
                        break
                    if results_map[candidate]:
                        return results_map[candidate], candidate
        return [], query

    def _cmd_info(self, peer_id: int, aid: int):
        try:
            cache_key = ("anime", aid)
            data = _cache_get(cache_key, ANIME_TTL)
            if data is None:
                self._bulletin_info(f"📥 Загружаю карточку #{aid}…")
                data = self._api_get(f"/animes/{aid}")
                if data and data.get("id"):
                    _cache_set(cache_key, data)
            if not data or not data.get("id"):
                run_on_ui_thread(lambda: self._send_formatted(peer_id, f"\u274C Аниме с ID {aid} не найдено", "HTML"))
                return
            self._send_anime(peer_id, data)
        except Exception as e:
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"\u274C Ошибка: {e}", "HTML"))

    def _calc_in_sample_size(self, options, req_w_px: int, req_h_px: int) -> int:
        height = options.outHeight
        width = options.outWidth
        in_sample_size = 1
        if req_w_px > 0 and req_h_px > 0 and (height > req_h_px or width > req_w_px):
            half_h = height // 2
            half_w = width // 2
            while (half_h // in_sample_size) >= req_h_px and (half_w // in_sample_size) >= req_w_px:
                in_sample_size *= 2
        return in_sample_size

    def _load_poster_bitmap(self, url: str, target_w_px: int = 0, target_h_px: int = 0):
        if not url:
            return None
        key = ("poster", url, target_w_px, target_h_px)
        cached = _cache_get(key, POSTER_TTL)
        if cached is not None:
            return cached
        try:
            resp = SESSION.get(url, timeout=(6, 10))
            resp.raise_for_status()
            data = resp.content
            if target_w_px > 0 and target_h_px > 0:
                bounds_opts = BitmapFactory.Options()
                bounds_opts.inJustDecodeBounds = True
                BitmapFactory.decodeByteArray(data, 0, len(data), bounds_opts)
                bounds_opts.inSampleSize = self._calc_in_sample_size(bounds_opts, target_w_px, target_h_px)
                bounds_opts.inJustDecodeBounds = False
                bmp = BitmapFactory.decodeByteArray(data, 0, len(data), bounds_opts)
            else:
                bmp = BitmapFactory.decodeByteArray(data, 0, len(data))
            if bmp is not None:
                _cache_set(key, bmp)
            else:
                self.log(f"Не удалось декодировать постер: {url}")
            return bmp
        except Exception as e:
            self.log(f"Ошибка загрузки постера {url}: {e}")
            return None

    def _rounded_background(self, color_hex: str, radius_dp: float) -> "GradientDrawable":
        d = GradientDrawable()
        d.setShape(GradientDrawable.RECTANGLE)
        d.setColor(AndroidColor.parseColor(color_hex))
        d.setCornerRadius(dp(radius_dp))
        return d

    def _clip_rounded(self, view, radius_dp: float):
        try:
            view.setOutlineProvider(_RoundedOutlineProvider.new_instance(init_args=[float(dp(radius_dp))]))
            view.setClipToOutline(True)
        except Exception:
            pass

    def _prepare_poster_bitmap(self, bitmap, target_w_px: int, target_h_px: int, radius_px: float):
        try:
            if bitmap is None or target_w_px <= 0 or target_h_px <= 0:
                return bitmap
            cropped = ThumbnailUtils.extractThumbnail(bitmap, target_w_px, target_h_px)
            if cropped is None:
                cropped = bitmap
            output = Bitmap.createBitmap(target_w_px, target_h_px, Bitmap.Config.ARGB_8888)
            canvas = Canvas(output)
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            rect = RectF(0.0, 0.0, float(target_w_px), float(target_h_px))
            canvas.drawRoundRect(rect, radius_px, radius_px, paint)
            paint.setXfermode(PorterDuffXfermode(PorterDuff.Mode.SRC_IN))
            canvas.drawBitmap(cropped, 0.0, 0.0, paint)
            return output
        except Exception as e:
            self.log(f"Не удалось скруглить обложку: {e}")
            return bitmap

    def _ripple_foreground(self, ctx):
        try:
            cached_id = _ICON_ID_CACHE.get("ripple")
            if cached_id is None:
                from android.R import attr as AndroidAttr
                tv = TypedValue()
                ctx.getTheme().resolveAttribute(AndroidAttr.selectableItemBackground, tv, True)
                cached_id = int(tv.resourceId or 0)
                _ICON_ID_CACHE["ripple"] = cached_id
            if cached_id:
                return ctx.getResources().getDrawable(cached_id, ctx.getTheme())
        except Exception:
            pass
        return None

    def _theme_color(self, key_name: str, fallback_hex: str) -> int:
        try:
            key = getattr(Theme, key_name)
            return Theme.getColor(key)
        except Exception:
            return AndroidColor.parseColor(fallback_hex)

    def _status_color_hex(self, status_key: str) -> str:
        if status_key == "released":
            try:
                accent_color = self._theme_color("key_windowBackgroundWhiteBlueText", "#5C9EFF")
                return "#" + format(accent_color & 0x00FFFFFF, '06x')
            except Exception:
                return "#5C9EFF"
        return STATUS_COLORS.get(status_key) or "#888888"

    def _build_status_badge(self, ctx, status_key: str):
        label = STATUS_LABELS.get(status_key)
        if not label:
            return None
        try:
            accent = AndroidColor.parseColor(self._status_color_hex(status_key))
        except Exception:
            return None

        badge = LinearLayout(ctx)
        badge.setOrientation(LinearLayout.HORIZONTAL)
        badge.setGravity(Gravity.CENTER_VERTICAL)
        bg = GradientDrawable()
        bg.setShape(GradientDrawable.RECTANGLE)
        bg.setCornerRadius(dp(MD3_SHAPE_FULL))
        tonal = (accent & 0x00FFFFFF) | 0x28000000 
        bg.setColor(tonal)
        badge.setBackground(bg)
        badge.setPadding(dp(8), dp(3), dp(9), dp(3))

        dot = View(ctx)
        dot_bg = GradientDrawable()
        dot_bg.setShape(GradientDrawable.OVAL)
        dot_bg.setColor(accent)
        dot.setBackground(dot_bg)
        dot_size = dp(6)
        dot_lp = LinearLayout.LayoutParams(dot_size, dot_size)
        dot_lp.setMargins(0, 0, dp(5), 0)
        dot.setLayoutParams(dot_lp)
        badge.addView(dot)

        text = TextView(ctx)
        text.setText(label)
        text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
        text.setTypeface(None, Typeface.BOLD)
        text.setIncludeFontPadding(False)
        try:
            text.setTextColor(accent)
        except Exception:
            pass
        badge.addView(text)
        return badge

    def _extract_poster_url(self, item: dict) -> str:
        url = None

        image_data = item.get("image")
        if isinstance(image_data, dict):
            for field in ("original", "preview", "x96"):
                val = image_data.get(field)
                if val:
                    url = val
                    break
        elif isinstance(image_data, str) and image_data.startswith("http"):
            url = image_data

        if not url:
            url = item.get("poster") or item.get("cover") or ""

        if url and not url.startswith("http"):
            url = SITE_URL + url

        return url or ""

    def _make_result_cell(self, activity, item: dict, on_pick, poster_executor, enrich_executor, is_stale=None):
        ctx = activity
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        pad_v, pad_h = dp(12), dp(14)
        row.setPadding(pad_h, pad_v, pad_h, pad_v)

        card_bg = self._rounded_background("#00000000", MD3_SHAPE_MEDIUM)
        try:
            card_color = self._theme_color("key_windowBackgroundGray", "#F0F0F0")
            card_bg.setColor(card_color)
        except Exception:
            pass
        row.setBackground(card_bg)

        ripple = self._ripple_foreground(ctx)
        if ripple is not None:
            try:
                row.setForeground(ripple)
            except Exception:
                pass

        try:
            row.setElevation(float(dp(MD3_ELEVATION_RESTING)))
            row.setOnTouchListener(_PressElevationListener.new_instance(
                init_args=[row, dp(MD3_ELEVATION_RESTING), dp(MD3_ELEVATION_PRESSED)]
            ).java)
        except Exception:
            pass

        lp_row = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
        lp_row.setMargins(dp(6), dp(6), dp(6), dp(6))
        row.setLayoutParams(lp_row)

        poster = ImageView(ctx)
        poster.setScaleType(ImageView.ScaleType.CENTER_CROP)
        poster_bg = self._rounded_background("#22000000", MD3_SHAPE_MEDIUM)
        poster.setBackground(poster_bg)
        poster_lp = LinearLayout.LayoutParams(dp(56), dp(78))
        poster.setLayoutParams(poster_lp)
        self._clip_rounded(poster, MD3_SHAPE_MEDIUM)
        poster.setAlpha(0.0)
        row.addView(poster)

        poster_url = self._extract_poster_url(item)
        status_key_for_poster = item.get("status")

        def _show_placeholder():
            placeholder_hex = self._status_color_hex(status_key_for_poster)
            soft_hex = "#33" + placeholder_hex.lstrip("#")
            poster.setBackground(self._rounded_background(soft_hex, MD3_SHAPE_MEDIUM))
            poster.setAlpha(1.0)

        def _apply_bitmap(bmp):
            if is_stale and is_stale():
                return
            if bmp is None:
                run_on_ui_thread(_show_placeholder)
                return
            rounded = self._prepare_poster_bitmap(
                bmp, dp(56), dp(78), float(dp(MD3_SHAPE_MEDIUM))
            )
            def apply():
                try:
                    poster.setScaleType(ImageView.ScaleType.FIT_XY)
                    poster.setImageBitmap(rounded)
                    poster.animate().alpha(1.0).setDuration(300).setInterpolator(_MATERIAL_SPRING).start()
                except Exception:
                    pass
            run_on_ui_thread(apply)

        def _fallback_chain():
            if is_stale and is_stale():
                return
            full_item = self._enrich_with_poster(dict(item))
            url = self._extract_poster_url(full_item)
            bmp = self._load_poster_bitmap(url, dp(56), dp(78)) if url else None
            _apply_bitmap(bmp)

        aid = item.get("id")

        if poster_url:
            def load():
                if is_stale and is_stale():
                    return
                bmp = self._load_poster_bitmap(poster_url, dp(56), dp(78))
                if bmp is not None:
                    _apply_bitmap(bmp)
                elif aid:
                    _fallback_chain()
                else:
                    _apply_bitmap(None)
            poster_executor.submit(load)
        else:
            _show_placeholder()
            if aid:
                enrich_executor.submit(_fallback_chain)

        text_col = LinearLayout(ctx)
        text_col.setOrientation(LinearLayout.VERTICAL)
        text_lp = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0)
        text_lp.setMargins(dp(12), 0, 0, 0)
        text_col.setLayoutParams(text_lp)

        title = item.get("russian") or item.get("name") or "Без названия"
        title_view = TextView(ctx)
        title_view.setText(title)
        title_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
        title_view.setTypeface(None, Typeface.BOLD)
        title_view.setMaxLines(2)
        try:
            title_view.setTextColor(self._theme_color("key_windowBackgroundWhiteBlackText", "#000000"))
        except Exception:
            pass
        text_col.addView(title_view)

        score = item.get("score") or 0
        year = ""
        aired = item.get("aired_on")
        if aired and len(str(aired)) >= 4:
            year = str(aired)[:4]

        kind = item.get("kind")
        kind_label = KIND_LABELS.get(kind, "")

        status_badge = self._build_status_badge(ctx, item.get("status"))

        parts = []
        if score:
            parts.append(f"{score:.1f}" if isinstance(score, float) else str(score))
        if year:
            parts.append(year)
        if kind_label and kind not in ("tv", "special", "tv_special"):
            parts.append(kind_label)
        elif kind in ("special", "tv_special"):
            parts.append(kind_label)

        meta_view = None
        if parts:
            builder = SpannableStringBuilder()
            sep = " · "

            star_id = _resolve_star_icon_id(ctx)
            cal_id = _resolve_calendar_icon_id(ctx)

            def insert_icon(icon_id):
                try:
                    drawable = ctx.getResources().getDrawable(icon_id, None)
                    if drawable is not None:
                        drawable = drawable.mutate()
                        try:
                            drawable.setTint(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
                        except Exception:
                            pass
                        size = dp(14)
                        drawable.setBounds(0, 0, size, size)
                        span = ImageSpan(drawable, ImageSpan.ALIGN_CENTER)
                        placeholder = '\uFFFC'
                        start = builder.length()
                        builder.append(placeholder)
                        builder.setSpan(span, start, start + 1, 0)
                except Exception as e:
                    self.log(f"Ошибка вставки иконки: {e}")

            for i, part in enumerate(parts):
                if i > 0:
                    builder.append(sep)

                if i == 0 and score:
                    insert_icon(star_id)
                    builder.append(" ")
                    builder.append(part)
                elif i == (1 if score else 0) and year:
                    insert_icon(cal_id)
                    builder.append(" ")
                    builder.append(part)
                else:
                    builder.append(part)

            meta_view = TextView(ctx)
            meta_view.setText(builder)
            meta_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            meta_view.setSingleLine(True)
            meta_view.setEllipsize(TextUtils.TruncateAt.END)
            meta_view.setIncludeFontPadding(False)
            try:
                meta_view.setTextColor(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
            except Exception:
                pass

            def _enable_marquee_if_truncated(tv=meta_view):
                try:
                    layout = tv.getLayout()
                    if layout is None:
                        return
                    truncated = False
                    for line in range(layout.getLineCount()):
                        if layout.getEllipsisCount(line) > 0:
                            truncated = True
                            break
                    if truncated:
                        tv.setEllipsize(TextUtils.TruncateAt.MARQUEE)
                        tv.setMarqueeRepeatLimit(-1)
                        tv.setHorizontalFadingEdgeEnabled(True)
                        tv.setSelected(True)  # marquee у Android анимируется только у "selected" TextView
                except Exception:
                    pass
            try:
                meta_view.post(R(_enable_marquee_if_truncated))
            except Exception:
                pass

        if status_badge is not None or meta_view is not None:
            meta_row = LinearLayout(ctx)
            meta_row.setOrientation(LinearLayout.HORIZONTAL)
            meta_row.setGravity(Gravity.CENTER_VERTICAL)
            meta_row_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT)
            meta_row_lp.setMargins(0, dp(5), 0, 0)
            meta_row.setLayoutParams(meta_row_lp)

            if status_badge is not None:
                badge_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT)
                badge_lp.setMargins(0, 0, dp(8) if meta_view is not None else 0, 0)
                status_badge.setLayoutParams(badge_lp)
                meta_row.addView(status_badge)

            if meta_view is not None:
                meta_view.setLayoutParams(LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT
                ))
                meta_row.addView(meta_view)

            text_col.addView(meta_row)

        row.addView(text_col)
        row.setClickable(True)
        row.setOnClickListener(OnClickListener(lambda v: on_pick(item)))
        return row

    def _append_results(self, results, replace, activity, on_pick, results_col, do_load_more,
                         poster_executor, enrich_executor, stale_check=None):
        def _do():
            if stale_check and stale_check():
                return
            try:
                if replace:
                    for i in range(results_col.getChildCount()):
                        v = results_col.getChildAt(i)
                        try:
                            anim = getattr(v, "_skeleton_anim", None)
                            if anim:
                                anim.cancel()
                        except Exception:
                            pass
                    results_col.removeAllViews()
                for index, item in enumerate(results):
                    cell = self._make_result_cell(
                        activity, item, on_pick,
                        poster_executor=poster_executor,
                        enrich_executor=enrich_executor,
                        is_stale=stale_check,
                    )
                    cell.setAlpha(0.0)
                    cell.setTranslationY(float(dp(10)))
                    results_col.addView(cell)
                    stagger_delay = min(index, 6) * 24
                    cell.animate().alpha(1.0).translationY(0.0).setStartDelay(stagger_delay).setDuration(240).setInterpolator(_MATERIAL_STANDARD).start()
                if len(results) >= SEARCH_LIMIT:
                    more_row = TextView(activity)
                    more_row.setText("Показать ещё ⌄")
                    more_row.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                    more_row.setGravity(Gravity.CENTER)
                    more_row.setPadding(0, dp(16), 0, dp(16))
                    try:
                        more_row.setTextColor(self._theme_color("key_windowBackgroundWhiteBlueText", "#4EA4F5"))
                    except Exception:
                        pass

                    def on_more(v):
                        try:
                            results_col.removeView(more_row)
                        except Exception:
                            pass
                        do_load_more()
                    more_row.setOnClickListener(OnClickListener(on_more))
                    results_col.addView(more_row)
            except Exception as e:
                self.log(f"Не удалось отрисовать результаты: {e}")

        run_on_ui_thread(_do)

    def _open_inline_search(self, peer_id: int, initial_query: str = ""):
        try:
            frag = get_last_fragment()
            if not frag:
                return
            activity = frag.getParentActivity()
            if not activity:
                return

            poster_executor = ThreadPoolExecutor(max_workers=4, thread_name_prefix="shiki-poster")
            enrich_executor = ThreadPoolExecutor(max_workers=6, thread_name_prefix="shiki-enrich")

            root = LinearLayout(activity)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(dp(16), dp(12), dp(16), dp(12))

            query_field = EditText(activity)
            query_field.setHint("Название аниме…")
            query_field.setSingleLine(True)
            query_field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 17)
            query_field.setPadding(dp(20), dp(14), dp(20), dp(14))
            query_field.setMinHeight(dp(60))

            bg = GradientDrawable()
            bg.setShape(GradientDrawable.RECTANGLE)
            bg.setCornerRadius(dp(MD3_SHAPE_FULL))
            try:
                bg_color = self._theme_color("key_windowBackgroundGray", "#F0F0F0")
                bg.setColor(bg_color)
            except Exception:
                bg.setColor(AndroidColor.parseColor("#F0F0F0"))
            try:
                stroke_color = self._theme_color("key_divider", "#00000000")
                bg.setStroke(dp(1), (stroke_color & 0x00FFFFFF) | 0x14000000)
            except Exception:
                pass
            query_field.setBackground(bg)

            try:
                _qf_icon_id = _resolve_search_icon_id(activity)
                if _qf_icon_id:
                    _qf_icon = activity.getResources().getDrawable(_qf_icon_id, None)
                    if _qf_icon is not None:
                        _qf_icon = _qf_icon.mutate()
                        try:
                            _qf_icon.setTint(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
                        except Exception:
                            pass
                        _qf_size = dp(24)
                        _qf_icon.setBounds(0, 0, _qf_size, _qf_size)
                        query_field.setCompoundDrawables(_qf_icon, None, None, None)
                        query_field.setCompoundDrawablePadding(dp(14))
            except Exception:
                pass

            try:
                query_field.setTextColor(self._theme_color("key_windowBackgroundWhiteBlackText", "#000000"))
                query_field.setHintTextColor(self._theme_color("key_windowBackgroundWhiteHintText", "#888888"))
                cursor_color = self._theme_color("key_windowBackgroundWhiteBlackText", "#000000")
                try:
                    query_field.setCursorVisible(True)
                    query_field.setTextCursorDrawable(None)
                except Exception:
                    pass
                try:
                    query_field.setHighlightColor((cursor_color & 0x00FFFFFF) | 0x55000000)
                except Exception:
                    pass
            except Exception:
                pass
            if initial_query:
                query_field.setText(initial_query)
                query_field.setSelection(len(initial_query))

            _clear_icon_id = _resolve_clear_icon_id(activity)

            def _update_clear_icon(has_text: bool):
                if not _clear_icon_id:
                    return
                try:
                    start = query_field.getCompoundDrawables()[0]
                    if has_text:
                        _cd = activity.getResources().getDrawable(_clear_icon_id, None)
                        if _cd is not None:
                            _cd = _cd.mutate()
                            try:
                                _cd.setTint(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
                            except Exception:
                                pass
                            _cd_size = dp(20)
                            _cd.setBounds(0, 0, _cd_size, _cd_size)
                            query_field.setCompoundDrawables(start, None, _cd, None)
                        else:
                            query_field.setCompoundDrawables(start, None, None, None)
                    else:
                        query_field.setCompoundDrawables(start, None, None, None)
                except Exception:
                    pass

            def _do_clear_field():
                try:
                    query_field.setText("")
                    query_field.requestFocus()
                except Exception:
                    pass

            if _clear_icon_id:
                query_field.setOnTouchListener(
                    _ClearFieldTouchListener.new_instance(init_args=[query_field, _do_clear_field]).java
                )
                _update_clear_icon(bool(initial_query))

            lp_field = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
            lp_field.setMargins(0, 0, 0, dp(12))
            root.addView(query_field, lp_field)

            progress_bar = None
            try:
                from android.R import attr as _AndroidAttr
                progress_bar = ProgressBar(activity, None, _AndroidAttr.progressBarStyleHorizontal)
                progress_bar.setIndeterminate(True)
                try:
                    accent = self._theme_color("key_windowBackgroundWhiteBlueText", "#5C9EFF")
                    progress_bar.getIndeterminateDrawable().mutate().setTint(accent)
                except Exception:
                    pass
                progress_bar.setVisibility(View.GONE)
                progress_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(4))
                progress_lp.setMargins(0, 0, 0, dp(8))
                root.addView(progress_bar, progress_lp)
            except Exception as e:
                self.log(f"Не удалось создать индикатор загрузки: {e}")

            def _set_loading(loading: bool):
                if progress_bar is None:
                    return

                def _do():
                    try:
                        progress_bar.setVisibility(View.VISIBLE if loading else View.GONE)
                    except Exception:
                        pass
                run_on_ui_thread(_do)

            status_view = TextView(activity)
            status_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            status_view.setMaxLines(1)
            status_view.setEllipsize(TextUtils.TruncateAt.END)
            try:
                status_view.setTextColor(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
            except Exception:
                pass
            _status_icon_id = _resolve_status_icon_id(activity)
            _status_uses_icon = False
            if _status_icon_id:
                try:
                    _icon_drawable = activity.getResources().getDrawable(_status_icon_id, None)
                    if _icon_drawable is not None:
                        _size = dp(16)
                        _icon_drawable.setBounds(0, 0, _size, _size)
                        try:
                            _icon_drawable.setTint(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
                        except Exception:
                            pass
                        status_view.setCompoundDrawables(_icon_drawable, None, None, None)
                        status_view.setCompoundDrawablePadding(dp(8))
                        _status_uses_icon = True
                except Exception:
                    _status_uses_icon = False

            def _search_prefix(with_space: bool = True) -> str:
                if _status_uses_icon:
                    return ""
                return "🔍 " if with_space else "🔍"

            status_view.setText("Начни вводить название аниме…")
            status_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
            status_lp.setMargins(dp(4), dp(8), dp(4), dp(8))
            root.addView(status_view, status_lp)

            scroll = ScrollView(activity)
            scroll_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(342))
            scroll.setLayoutParams(scroll_lp)
            scroll.setFillViewport(True)
            scroll.setPadding(dp(4), dp(4), dp(4), dp(4))
            results_col = LinearLayout(activity)
            results_col.setOrientation(LinearLayout.VERTICAL)
            scroll.addView(results_col)
            root.addView(scroll)

            outer_scroll = ScrollView(activity)
            outer_scroll.setFillViewport(True)
            outer_scroll.addView(root)

            builder = AlertDialogBuilder(activity)
            _search_icon_id = _resolve_search_icon_id(activity)
            if _search_icon_id:
                builder.set_title("Поиск")
                try:
                    builder.set_icon(_search_icon_id)
                except Exception:
                    builder.set_title("Поиск")
            else:
                builder.set_title("Поиск")
            builder.set_view(outer_scroll, -2)
            builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
            builder.set_cancelable(True)

            state = {
                "seq": 0,
                "runnable": None,
                "page": 1,
                "query": "",
                "used_query": "",
                "closed": False,
                "last_raw_text": "",
                "skeletons_shown": False,
                "clear_icon_shown": bool(initial_query and initial_query.strip()),
            }

            def on_pick(item: dict):
                state["closed"] = True
                builder.dismiss()
                self._send_anime(peer_id, item)

            def set_status(text: str, token: int = None):
                def _do():
                    if token is not None and state["seq"] != token:
                        return
                    try:
                        status_view.setText(text)
                    except Exception:
                        pass
                run_on_ui_thread(_do)

            def clear_results(token: int = None):
                stale = (lambda: state["seq"] != token) if token is not None else None
                self._hide_skeletons(results_col, stale_check=stale)
                state["skeletons_shown"] = False

            def append_results(results: list, replace: bool, token: int = None):
                stale = (lambda: state["seq"] != token) if token is not None else None
                self._append_results(
                    results, replace, activity, on_pick, results_col, do_load_more,
                    poster_executor, enrich_executor, stale_check=stale,
                )

            def do_load_more():
                query = state["used_query"] or state["query"]
                if not query:
                    return
                next_page = state["page"] + 1
                token = state["seq"]
                set_status(f"{_search_prefix()}«{query}» · загружаю ещё…", token)
                _set_loading(True)

                def work():
                    try:
                        results = self._search_animes(query, next_page)
                    except Exception as e:
                        set_status(f"Не удалось загрузить: {e}", token)
                        return
                    finally:
                        _set_loading(False)
                    if state["closed"] or state["seq"] != token:
                        return
                    if not results:
                        set_status(f"{_search_prefix()}«{query}» · больше результатов нет", token)
                        return
                    state["page"] = next_page
                    set_status(f"{_search_prefix()}«{query}» · страница {next_page}", token)
                    append_results(results, replace=False, token=token)

                run_on_queue(work)

            def run_search(query: str):
                if state["closed"]:
                    return
                query = query.strip()
                state["query"] = query
                token = state["seq"]
                stale = lambda: state["seq"] != token
                if not query:
                    clear_results(token)
                    set_status("Начни вводить название аниме…", token)
                    return

                if not state["skeletons_shown"]:
                    self._show_skeletons(results_col, count=5, stale_check=stale)
                    state["skeletons_shown"] = True

                set_status(f"{_search_prefix()}Ищу «{query}»…", token)
                _set_loading(True)

                def work():
                    try:
                        results, used_query = self._search_with_fallback(query, page=1)
                    except Exception as e:
                        if not state["closed"] and not stale():
                            set_status(f"\u274C Ошибка поиска: {e}", token)
                        return
                    finally:
                        _set_loading(False)
                    if state["closed"] or stale():
                        return
                    state["page"] = 1
                    state["used_query"] = used_query
                    state["last_searched_query"] = query
                    state["skeletons_shown"] = False

                    if not results:
                        clear_results(token)
                        site_url = f"{SITE_URL}/animes?" + urlencode({"search": query})
                        set_status(f"Ничего не найдено по «{query}». Открыть на сайте: {site_url}", token)
                        return

                    if used_query != query:
                        set_status(f"{_search_prefix()}«{used_query}» · похоже на «{query}» · {len(results)}", token)
                    else:
                        set_status(f"{_search_prefix()}«{used_query}» · найдено {len(results)}", token)
                    append_results(results, replace=True, token=token)

                run_on_queue(work)

            def schedule_search(text: str):
                has_text = bool(text.strip())
                if has_text != state.get("clear_icon_shown"):
                    state["clear_icon_shown"] = has_text
                    _update_clear_icon(has_text)
                prev_raw = state.get("last_raw_text", "")
                state["last_raw_text"] = text
                state["seq"] += 1
                seq = state["seq"]
                if state["runnable"] is not None:
                    try:
                        query_field.removeCallbacks(state["runnable"])
                    except Exception:
                        pass

                if text.strip() and not prev_raw.strip():
                    run_search(text)
                    return

                def fire():
                    if state["seq"] == seq:
                        run_search(text)

                runnable = R(fire)
                state["runnable"] = runnable
                query_field.postDelayed(runnable, SEARCH_DEBOUNCE_MS)

            watcher = _QueryWatcher.new_instance(init_args=[schedule_search])
            query_field.addTextChangedListener(watcher.java)

            def on_dismiss(b):
                state["closed"] = True
                self._hide_skeletons(results_col)
                try:
                    poster_executor.shutdown(wait=False, cancel_futures=True)
                except Exception:
                    pass
                try:
                    enrich_executor.shutdown(wait=False, cancel_futures=True)
                except Exception:
                    pass
            builder.set_on_dismiss_listener(on_dismiss)

            builder.show()

            try:
                _dlg = builder.get_dialog()
                if _dlg is not None:
                    _window = _dlg.getWindow()
                    if _window is not None:
                        _window.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE)
            except Exception as e:
                self.log(f"Не удалось выставить ADJUST_RESIZE: {e}")

            if initial_query:
                run_search(initial_query)
            else:
                try:
                    query_field.requestFocus()
                except Exception:
                    pass
        except Exception as e:
            self.log(f"Inline-поиск недоступен, использую резервный вариант: {e}")
            self._fallback_search_dialog(peer_id, initial_query)

    def _fallback_search_dialog(self, peer_id: int, query: str):
        query = (query or "").strip()
        if not query:
            self._send_help_fallback(peer_id)
            return
        self._bulletin_info(f"🔍 Ищу «{query}»…")

        def work():
            try:
                results, used_query = self._search_with_fallback(query, page=1)
            except Exception as e:
                run_on_ui_thread(lambda: self._send_formatted(peer_id, f"Ошибка поиска: {e}", "HTML"))
                return
            if not results:
                self._bulletin_error(f"Ничего не найдено по «{query}»")
                return
            self._show_fallback_results(peer_id, query, used_query, results)

        run_on_queue(work)

    def _show_fallback_results(self, peer_id: int, orig_query: str, used_query: str, results: list):
        names, ids = [], []
        for item in results:
            title = item.get("russian") or item.get("name") or "Без названия"
            year = ""
            aired = item.get("aired_on")
            if aired and len(str(aired)) >= 4:
                year = str(aired)[:4]
            icon = STATUS_ICONS.get(item.get("status"), "❔")
            score = item.get("score") or 0
            meta = f"\U0001F4C5 {year}" if year else "—"
            if score:
                meta += f"\u2B50 {score}"
            names.append(f"{icon} {meta}  ·  {title}")
            ids.append(item.get("id", 0))

        def on_click(bld, idx):
            bld.dismiss()
            run_on_queue(lambda: self._cmd_info(peer_id, ids[idx]))

        def show():
            try:
                frag = get_last_fragment()
                if not frag:
                    return
                act = frag.getParentActivity()
                if not act:
                    return
                b = AlertDialogBuilder(act)
                _fb_icon_id = _resolve_search_icon_id(act)
                if _fb_icon_id:
                    b.set_title(f"«{used_query}»  ·  {len(results)}")
                    try:
                        b.set_icon(_fb_icon_id)
                    except Exception:
                        b.set_title(f"«{used_query}»  ·  {len(results)}")
                else:
                    b.set_title(f"«{used_query}»  ·  {len(results)}")
                b.set_items(names, on_click)
                b.set_negative_button("Закрыть", lambda b, w: b.dismiss())
                b.show()
            except Exception as e:
                self._bulletin_error(f"Не удалось показать результаты: {e}")

        run_on_ui_thread(show)

    def _send_help_fallback(self, peer_id: int):
        text = (
            "<b>Shikimori Search</b>\n\n"
            ".s <запрос>  — поиск аниме\n"
            ".i           — статистика профиля (нужен никнейм в настройках)"
        )
        run_on_ui_thread(lambda: self._send_formatted(peer_id, text, "HTML"))

    def _create_skeleton_view(self, activity):
        ctx = activity
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        pad_v, pad_h = dp(12), dp(14)
        row.setPadding(pad_h, pad_v, pad_h, pad_v)
        card_bg = self._rounded_background("#00000000", MD3_SHAPE_MEDIUM)
        try:
            card_color = self._theme_color("key_windowBackgroundGray", "#F0F0F0")
            card_bg.setColor(card_color)
        except Exception:
            pass
        row.setBackground(card_bg)
        row.setElevation(float(dp(MD3_ELEVATION_RESTING)))
        lp_row = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
        lp_row.setMargins(dp(6), dp(6), dp(6), dp(6))
        row.setLayoutParams(lp_row)

        poster = View(ctx)
        poster.setBackground(self._rounded_background("#DDDDDD", MD3_SHAPE_MEDIUM))
        poster_lp = LinearLayout.LayoutParams(dp(56), dp(78))
        poster.setLayoutParams(poster_lp)
        row.addView(poster)

        text_col = LinearLayout(ctx)
        text_col.setOrientation(LinearLayout.VERTICAL)
        text_lp = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0)
        text_lp.setMargins(dp(12), 0, 0, 0)
        text_col.setLayoutParams(text_lp)

        title_placeholder = View(ctx)
        title_placeholder.setBackground(self._rounded_background("#DDDDDD", MD3_SHAPE_SMALL))
        title_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(18))
        title_placeholder.setLayoutParams(title_lp)
        text_col.addView(title_placeholder)

        meta_placeholder = View(ctx)
        meta_placeholder.setBackground(self._rounded_background("#DDDDDD", MD3_SHAPE_SMALL))
        meta_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(14))
        meta_lp.setMargins(0, dp(6), 0, 0)
        meta_placeholder.setLayoutParams(meta_lp)
        text_col.addView(meta_placeholder)

        row.addView(text_col)
        return row

    def _show_skeletons(self, results_col, count=5, stale_check=None, animate=True):
        def _do():
            if stale_check and stale_check():
                return
            try:
                results_col.removeAllViews()
                activity = results_col.getContext()
                for _ in range(count):
                    sk = self._create_skeleton_view(activity)
                    results_col.addView(sk)

                if not animate:
                    for i in range(results_col.getChildCount()):
                        results_col.getChildAt(i).setAlpha(0.7)
                    return

                for i in range(results_col.getChildCount()):
                    v = results_col.getChildAt(i)
                    try:
                        anim = ObjectAnimator.ofFloat(v, "alpha", 0.4, 1.0)
                        anim.setDuration(1200)
                        anim.setRepeatCount(ValueAnimator.INFINITE)
                        anim.setRepeatMode(ValueAnimator.REVERSE)
                        anim.setInterpolator(_MATERIAL_STANDARD)
                        anim.start()
                        setattr(v, "_skeleton_anim", anim)
                    except Exception:
                        pass
            except Exception as e:
                self.log(f"Ошибка отображения скелетонов: {e}")
        run_on_ui_thread(_do)

    def _hide_skeletons(self, results_col, stale_check=None):
        def _do():
            if stale_check and stale_check():
                return
            try:
                for i in range(results_col.getChildCount()):
                    v = results_col.getChildAt(i)
                    try:
                        anim = getattr(v, "_skeleton_anim", None)
                        if anim:
                            anim.cancel()
                    except Exception:
                        pass
                results_col.removeAllViews()
            except Exception:
                pass
        run_on_ui_thread(_do)

    def _enrich_with_poster(self, item: dict) -> dict:
        aid = item.get("id")
        if not aid:
            return item

        cache_key = ("anime_full", aid)
        full = _cache_get(cache_key, ANIME_TTL)
        if full is None:
            try:
                full = self._api_get(f"/animes/{aid}")
                if full and full.get("id"):
                    _cache_set(cache_key, full)
            except Exception as e:
                self.log(f"Не удалось загрузить карточку #{aid}: {e}")
                return item

        if "image" in full and full["image"]:
            item["image"] = full["image"]
        if "poster" in full and full["poster"]:
            item["poster"] = full["poster"]
        return item