import time
import threading
from typing import Any, List

from java import jclass, jint
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.settings import Header, Switch, Divider, Text

__id__ = "hide_recent_reactions"
__name__ = "Hide Recent Reactions"
__description__ = "Hides recent emoji in the reactions list, the \"Popular\" section and trending emoji pack suggestions"
__author__ = "@chestertech"
__version__ = "1.21.0"
__icon__ = "msg_reactions"
__min_version__ = "12.5.1"

MEDIA_DATA_CONTROLLER = "org.telegram.messenger.MediaDataController"

DEFAULT_POPULAR_LIMIT = 8
POPULAR_LIMIT_MIN = 8
POPULAR_LIMIT_MAX = 64

SETTINGS_CACHE_TTL = 5.0

REACTION_PICKER_MARKERS = (
    "SelectAnimatedEmojiDialog",
    "ReactionsContainerLayout",
    "CustomEmojiReactionsWindow",
)

EMOJI_PICKER_MARKERS = REACTION_PICKER_MARKERS + (
    "EmojiView",
    "EmojiTabsStrip",
)

STRINGS = {
    'en': {
        'header_hiding': 'Hide emoji',
        'recent_title': 'Hide recent reactions',
        'recent_sub': 'Removes the recently used emoji section from the reactions and profile status pickers',
        'top_title': 'Hide frequent reactions',
        'top_sub': 'The quick reactions bar will be built from the default set, not from your history',
        'popular_title': 'Hide the "Popular" section',
        'popular_sub': 'Trims the default reaction set in the picker to the limit — the "Popular" block disappears',
        'featured_title': 'Hide popular emoji packs',
        'featured_sub': 'Removes trending emoji pack suggestions in the emoji and reaction pickers',
        'header_tuning': 'Fine tuning',
        'limit_title': 'Headerless reaction limit',
        'limit_row': 'Headerless reaction limit: %d',
        'limit_hint': 'From %d to %d',
        'btn_save': 'Save',
        'btn_cancel': 'Cancel',
    },
    'ru': {
        'header_hiding': 'Скрытие эмодзи',
        'recent_title': 'Скрывать недавние реакции',
        'recent_sub': 'Убирает секцию недавно использованных эмодзи из пикера реакций и пикера статуса профиля',
        'top_title': 'Скрывать частые реакции',
        'top_sub': 'Быстрая панель реакций будет строиться из стандартного набора, а не из вашей истории',
        'popular_title': 'Скрывать секцию «Популярные»',
        'popular_sub': 'Обрезает дефолтный набор реакций в пикере до лимита — блок «Популярные» исчезает',
        'featured_title': 'Скрывать популярные наборы эмодзи',
        'featured_sub': 'Убирает предложения trending-паков эмодзи в пикерах эмодзи и реакций',
        'header_tuning': 'Точная настройка',
        'limit_title': 'Лимит реакций без заголовка',
        'limit_row': 'Лимит реакций без заголовка: %d',
        'limit_hint': 'От %d до %d',
        'btn_save': 'Сохранить',
        'btn_cancel': 'Отмена',
    },
