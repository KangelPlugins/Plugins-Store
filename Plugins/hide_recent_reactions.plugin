def _get_lang():
    try:
        LocaleController = find_class('org.telegram.messenger.LocaleController')
        if LocaleController is None:
            LocaleController = jclass('org.telegram.messenger.LocaleController')
        system_lang = (
            LocaleController
            .getInstance()
            .getCurrentLocale()
            .getLanguage()
        )
        system_lang = str(system_lang).lower()
        system_lang = system_lang.split('-', 1)[0].split('_', 1)[0]
        if system_lang in STRINGS:
            return system_lang
    except Exception:
        pass
    return 'en'


class BaseListHook(MethodHook):
    def __init__(self, plugin: "HideRecentReactionsPlugin", setting_key: str,
                 label: str, caller_markers=None):
        self._plugin = plugin
        self._setting_key = setting_key
        self._label = label
        self._caller_markers = caller_markers

    def _is_enabled(self) -> bool:
        return bool(self._plugin.cfg(self._setting_key, True))

    def _method_threw(self, param) -> bool:
        try:
            return param.getThrowable() is not None
        except Exception:
            try:
                return getattr(param, "throwable", None) is not None
            except Exception:
                return False

    def _get_result_and_size(self, param):
        try:
            original = param.getResult()
        except Exception:
            return None, -1
        if original is None:
            return None, -1
        try:
            return original, int(original.size())
        except Exception:
            return original, -1

    def _caller_allowed(self) -> bool:
        if not self._caller_markers:
            return True
        return self._plugin.caller_matches(self._caller_markers, self._label)


class EmptyListResultHook(BaseListHook):
    def after_hooked_method(self, param):
        try:
            if not self._is_enabled():
                return
            if self._method_threw(param):
                return
            original, orig_size = self._get_result_and_size(param)
            if orig_size <= 0:
                return
            if not self._caller_allowed():
                return
            param.setResult(self._plugin.new_array_list())
        except Exception:
            pass


class TruncateListResultHook(BaseListHook):
    def after_hooked_method(self, param):
        try:
            if not self._is_enabled():
                return
            if self._method_threw(param):
                return
            original, orig_size = self._get_result_and_size(param)
            limit = self._plugin.popular_limit()
            if orig_size < 0 or orig_size <= limit:
                return
            if not self._caller_allowed():
                return
            try:
                safe_limit = min(limit, int(original.size()))
                if safe_limit <= 0:
                    return
                truncated = self._plugin.new_array_list()
                try:
                    truncated.addAll(original.subList(0, safe_limit))
                except Exception:
                    truncated.clear()
                    for i in range(safe_limit):
                        truncated.add(original.get(i))
            except Exception:
                return
            param.setResult(truncated)
        except Exception:
            pass


class HideRecentReactionsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._cfg = {}
        self._cfg_ts = 0.0
        self._cfg_lock = threading.Lock()
        self._ArrayList = None
        self._Log = None
        self._Throwable = None

    def new_array_list(self):
        try:
            if self._ArrayList is None:
                self._ArrayList = jclass("java.util.ArrayList")
            return self._ArrayList()
        except Exception:
            self._ArrayList = jclass("java.util.ArrayList")
            return self._ArrayList()

    def _refresh_settings_cache(self):
        try:
            raw_limit = self.get_setting("popular_limit", str(DEFAULT_POPULAR_LIMIT))
            try:
                limit = int(str(raw_limit).strip())
            except (TypeError, ValueError):
                limit = DEFAULT_POPULAR_LIMIT
            limit = max(POPULAR_LIMIT_MIN, min(POPULAR_LIMIT_MAX, limit))
            self._cfg = {
                "hide_recent_reactions": bool(self.get_setting("hide_recent_reactions", True)),
                "hide_top_reactions": bool(self.get_setting("hide_top_reactions", True)),
                "hide_popular_reactions": bool(self.get_setting("hide_popular_reactions", True)),
                "hide_featured_emoji": bool(self.get_setting("hide_featured_emoji", True)),
                "popular_limit": limit,
            }
        except Exception:
            pass
        finally:
            self._cfg_ts = time.time()

    def cfg(self, key, default=None):
        if time.time() - self._cfg_ts > SETTINGS_CACHE_TTL:
            with self._cfg_lock:
                if time.time() - self._cfg_ts > SETTINGS_CACHE_TTL:
                    self._refresh_settings_cache()
        return self._cfg.get(key, default)

    def popular_limit(self) -> int:
        return int(self.cfg("popular_limit", DEFAULT_POPULAR_LIMIT))

    def caller_matches(self, markers, label="") -> bool:
        try:
            if self._Log is None or self._Throwable is None:
                self._Log = jclass("android.util.Log")
                self._Throwable = jclass("java.lang.Throwable")
            stack_str = str(self._Log.getStackTraceString(self._Throwable()))
        except Exception:
            try:
                self._Log = jclass("android.util.Log")
                self._Throwable = jclass("java.lang.Throwable")
                stack_str = str(self._Log.getStackTraceString(self._Throwable()))
            except Exception:
                return False
        try:
            for marker in markers:
                if marker in stack_str:
                    return True
            return False
        except Exception:
            return False

    def _install_hooks_for_target(self, wrapper_clazz, java_clazz, list_class,
                                  method_name, hook) -> int:
        if java_clazz is not None and list_class is not None:
            installed = 0
            for m in java_clazz.getDeclaredMethods():
                try:
                    if str(m.getName()) != method_name:
                        continue
                    if len(m.getParameterTypes()) != 0:
                        continue
                    if not list_class.isAssignableFrom(m.getReturnType()):
                        continue
                    m.setAccessible(True)
                    self.hook_method(m, hook)
                    installed += 1
                except Exception:
                    pass
            return installed

        try:
            unhooks = self.hook_all_methods(wrapper_clazz, method_name, hook)
            if unhooks is None:
                return 1
            try:
                return len(unhooks)
            except Exception:
                return 1 if unhooks else 0
        except Exception:
            return 0

    def _load_reflection(self):
        try:
            Class = jclass("java.lang.Class")
            list_class = Class.forName("java.util.List")
            try:
                java_clazz = Class.forName(MEDIA_DATA_CONTROLLER)
            except Exception:
                Thread = jclass("java.lang.Thread")
                loader = Thread.currentThread().getContextClassLoader()
                java_clazz = Class.forName(MEDIA_DATA_CONTROLLER, False, loader)
            return java_clazz, list_class
        except Exception:
            return None, None

    def _install_hooks(self):
        wrapper_clazz = find_class(MEDIA_DATA_CONTROLLER)
        if not wrapper_clazz:
            return

        java_clazz, list_class = self._load_reflection()

        hook_targets = [
            ("getRecentReactions",
             EmptyListResultHook(self, "hide_recent_reactions", "recent_reactions")),
            ("getTopReactions",
             EmptyListResultHook(self, "hide_top_reactions", "top_reactions")),
            ("getRecentEmojiStatuses",
             EmptyListResultHook(self, "hide_recent_reactions", "recent_emoji_statuses")),
            ("getDefaultEmojiStatuses",
             EmptyListResultHook(self, "hide_recent_reactions", "default_emoji_statuses",
                                 caller_markers=EMOJI_PICKER_MARKERS)),
            ("getFeaturedEmojiSets",
             EmptyListResultHook(self, "hide_featured_emoji", "featured_emoji",
                                 caller_markers=EMOJI_PICKER_MARKERS)),
            ("getEnabledReactionsList",
             TruncateListResultHook(self, "hide_popular_reactions", "popular_reactions",
                                    caller_markers=REACTION_PICKER_MARKERS)),
        ]

        for method_name, hook in hook_targets:
            self._install_hooks_for_target(
                wrapper_clazz, java_clazz, list_class, method_name, hook)

    def on_plugin_load(self):
        self._refresh_settings_cache()
        self._install_hooks()

    def _str(self, key):
        lang = _get_lang()
        return STRINGS.get(lang, STRINGS['en']).get(key, key)

    def _set_popular_limit(self, value):
        raw = str(value or '').replace(',', '.').split('.')[0]
        digits = ''.join(ch for ch in raw if ch.isdigit())
        try:
            n = int(digits) if digits else DEFAULT_POPULAR_LIMIT
        except Exception:
            n = DEFAULT_POPULAR_LIMIT
        n = max(POPULAR_LIMIT_MIN, min(POPULAR_LIMIT_MAX, n))
        self.set_setting("popular_limit", str(n))
        self._cfg_ts = 0.0

    def _edit_limit(self, view=None):
        try:
            from client_utils import get_last_fragment
            from ui.alert import AlertDialogBuilder
            from android.widget import EditText, LinearLayout
            from android.text import InputType, InputFilter
            from android.text.method import DigitsKeyListener
            from android.view import ViewGroup
            f = get_last_fragment()
            if not f:
                return
            ctx = f.getParentActivity()
            cur = str(self.get_setting("popular_limit", str(DEFAULT_POPULAR_LIMIT)))
            layout = LinearLayout(ctx)
            layout.setOrientation(LinearLayout.VERTICAL)
            layout.setPadding(48, 24, 48, 24)
            edit = EditText(ctx)
            edit.setHint(self._str('limit_hint') % (POPULAR_LIMIT_MIN, POPULAR_LIMIT_MAX))
            edit.setInputType(InputType.TYPE_CLASS_NUMBER)
            try:
                Theme = find_class('org.telegram.ui.ActionBar.Theme')
                edit.setTextColor(jint(Theme.getColor(Theme.key_dialogTextBlack)))
                edit.setHintTextColor(jint(Theme.getColor(Theme.key_dialogTextHint)))
            except Exception:
                pass
            try:
                edit.setKeyListener(DigitsKeyListener.getInstance('0123456789'))
            except Exception:
                pass
            try:
                edit.setFilters([InputFilter.LengthFilter(len(str(POPULAR_LIMIT_MAX)))])
            except Exception:
                pass
            try:
                edit.setText(cur)
                edit.setSelection(len(cur))
            except Exception:
                pass
            layout.addView(edit, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
            builder = AlertDialogBuilder(ctx)
            builder.set_title(self._str('limit_title'))
            builder.set_view(layout)

            def on_ok(dialog, which):
                self._set_popular_limit(str(edit.getText()))
                try:
                    self.notify_settings_changed()
                except Exception:
                    pass
            builder.set_positive_button(self._str('btn_save'), on_ok)
            builder.set_negative_button(self._str('btn_cancel'), None)
            builder.show()
        except Exception:
            pass

    def create_settings(self) -> List[Any]:
        lang = _get_lang()

        def tr(key):
            return STRINGS.get(lang, STRINGS['en']).get(key, key)

        return [
            Header(text=tr('header_hiding')),
            Switch(
                key="hide_recent_reactions",
                text=tr('recent_title'),
                subtext=tr('recent_sub'),
                default=True,
                on_change=lambda v: setattr(self, "_cfg_ts", 0.0),
            ),
            Switch(
                key="hide_top_reactions",
                text=tr('top_title'),
                subtext=tr('top_sub'),
                default=True,
                on_change=lambda v: setattr(self, "_cfg_ts", 0.0),
            ),
            Switch(
                key="hide_popular_reactions",
                text=tr('popular_title'),
                subtext=tr('popular_sub'),
                default=True,
                on_change=lambda v: setattr(self, "_cfg_ts", 0.0),
            ),
            Switch(
                key="hide_featured_emoji",
                text=tr('featured_title'),
                subtext=tr('featured_sub'),
                default=True,
                on_change=lambda v: setattr(self, "_cfg_ts", 0.0),
            ),
            Divider(),
            Header(text=tr('header_tuning')),
            Text(
                text=tr('limit_row') % self.popular_limit(),
                icon="msg_settings",
                on_click=self._edit_limit,
            ),
        ]


def create_plugin():
    return HideRecentReactionsPlugin()
