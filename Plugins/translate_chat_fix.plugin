__id__ = "translate_chat_fix"
__name__ = "Translate Chat Fix"
__description__ = "Убирает ошибочную плашку перевода на тот же самый язык (с языка A на язык A).\n\nFixes false translation bar on the same language (A -> A)."
__author__ = "@RnPlugins"
__version__ = "1.0.0"
__icon__ = "RnDev/21"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

import base64
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader

DEX_B64 = """"""

class TranslateChatFixPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.translatechatfix.TranslateChatFix")
            
            for m in self.dex_class.getMethods():
                if m.getName() == "start":
                    m.invoke(None)
                    break
        except Exception as e:
            self.log(f"Load error: {e}")

    def on_plugin_unload(self):
        try:
            if hasattr(self, "dex_class") and self.dex_class is not None:
                for m in self.dex_class.getMethods():
                    if m.getName() == "stop":
                        m.invoke(None)
                        break
        except Exception:
            pass
        finally:
            self.dex_class = None
            self.dex_loader = None
