from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from java.lang import Boolean
from java import dynamic_proxy

from android.view import View, Gravity
from org.telegram.ui.Components import LayoutHelper


__id__ = "gifter_avatar"
__name__ = "Gifter Avatar"
__description__ = "Отображает аватар подарившего подарок в меню добавления подарков в коллекцию\nПрямо как в профиле. По удержанию на подарке открывается меню подарка"
__author__ = "@alexeykasp"
__version__ = "1.2.1"
__app_version__ = ">=12.8.1"
__sdk_version__ = ">=1.4.3.10"

GIFT_CELL_CLASS_NAME = "org.telegram.ui.Gifts.GiftSheet$GiftCell"
SELECT_SHEET_CLASS_NAME = "org.telegram.ui.Gifts.ProfileGiftsContainer$SelectGiftsBottomSheet"
CHECK_BOX_SIZE = 24
CHECK_BOX_MARGIN = 4


class SelectSheetConstructorHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        sheet = param.thisObject
        if sheet is None:
            return
        try:
            list_view = get_private_field(sheet, "recyclerListView")
            if list_view is None:
                return
            self.plugin._select_lists[list_view] = (
                get_private_field(sheet, "currentAccount"),
                get_private_field(sheet, "dialogId"),
                get_private_field(sheet, "resourcesProvider"),
            )
            list_view.setOnItemLongClickListener(self.plugin._long_click_proxy)
        except Exception:
            pass


class SelectSheetDismissHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        sheet = param.thisObject
        if sheet is None:
            return
        try:
            list_view = get_private_field(sheet, "recyclerListView")
            if list_view is not None:
                self.plugin._select_lists.pop(list_view, None)
        except Exception:
            pass


class GiftCellSetCheckedHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        cell = param.thisObject
        if cell is None:
            return
        try:
            avatar_view = get_private_field(cell, "avatarView")
            if avatar_view is not None:
                avatar_view.setVisibility(View.VISIBLE)

            check_box = get_private_field(cell, "checkBox")
            if check_box is not None:
                check_box.setLayoutParams(
                    LayoutHelper.createFrame(
                        CHECK_BOX_SIZE,
                        CHECK_BOX_SIZE,
                        Gravity.BOTTOM | Gravity.RIGHT,
                        CHECK_BOX_MARGIN,
                        CHECK_BOX_MARGIN,
                        CHECK_BOX_MARGIN,
                        CHECK_BOX_MARGIN,
                    )
                )
        except Exception:
            pass


class GiftGiverAvatarPlugin(BasePlugin):

    def on_plugin_load(self):
        self._unhooks = []
        self._select_lists = {}
        self._long_click_proxy = None
        try:
            long_click_interface = find_class("org.telegram.ui.Components.RecyclerListView$OnItemLongClickListener")
            if long_click_interface is not None:

                class GiftItemLongClickProxy(dynamic_proxy(long_click_interface)):

                    def __init__(self, plugin):
                        super().__init__()
                        self.plugin = plugin

                    def onItemClick(self, view, position):
                        return self.plugin._on_gift_long_click(view)

                self._long_click_proxy = GiftItemLongClickProxy(self)
        except Exception:
            self.log("long click proxy failed")
        self._star_gift_sheet_class = None
        self._last_open_ms = 0
        try:
            from org.telegram.ui.Stars import StarGiftSheet
            self._star_gift_sheet_class = StarGiftSheet
        except Exception:
            self.log("StarGiftSheet class not found")
        try:
            gift_cell_class = find_class(GIFT_CELL_CLASS_NAME)
            if gift_cell_class is None:
                self.log("GiftCell class not found")
                return
            set_checked_method = gift_cell_class.getClass().getDeclaredMethod("setChecked", Boolean.TYPE, Boolean.TYPE)
            unhook = self.hook_method(set_checked_method, GiftCellSetCheckedHook(self), 10)
            if unhook is not None:
                self._unhooks.append(unhook)
        except Exception:
            self.log("setChecked hook failed")
        try:
            select_sheet_class = find_class(SELECT_SHEET_CLASS_NAME)
            if select_sheet_class is not None:
                unhooks = self.hook_all_constructors(select_sheet_class, SelectSheetConstructorHook(self), 10)
                if unhooks:
                    self._unhooks.extend(unhooks)
                unhooks = self.hook_all_methods(select_sheet_class, "dismiss", SelectSheetDismissHook(self), 10)
                if unhooks:
                    self._unhooks.extend(unhooks)
        except Exception:
            self.log("SelectSheet hooks failed")
        self.log("hooks registered, version " + str(__version__))

    def on_plugin_unload(self):
        for unhook in getattr(self, "_unhooks", []):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self._unhooks = []
        self._select_lists = {}

    def _on_gift_long_click(self, view):
        try:
            import time
            now = int(time.time() * 1000)
            if now - self._last_open_ms < 1000:
                return True
            cell = view
            parent = cell.getParent()
            while parent is not None and parent not in self._select_lists:
                parent = parent.getParent()
            entry = self._select_lists.get(parent) if parent is not None else None
            if entry is None:
                return False
            saved_gift = cell.getSavedGift()
            if saved_gift is None or saved_gift.gift is None:
                return False
            account, dialog_id, resources_provider = entry
            sheet_class = self._star_gift_sheet_class
            if sheet_class is None:
                return False
            self._last_open_ms = now
            sheet = sheet_class(cell.getContext(), account, dialog_id, resources_provider)
            sheet.set(saved_gift, None)
            sheet.show()
            return True
        except Exception:
            return False
