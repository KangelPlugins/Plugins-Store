from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from java.lang import Boolean

from android.view import View, Gravity
from org.telegram.ui.Components import LayoutHelper


__id__ = "gifter_avatar"
__name__ = "Gifter Avatar"
__description__ = "Отображает аватар подарившего подарок в меню добавления подарков в коллекцию\nПрямо как в профиле"
__author__ = "@alexeykasp"
__version__ = "1.0.1"
__app_version__ = ">=12.8.1"
__sdk_version__ = ">=1.4.3.10"

GIFT_CELL_CLASS_NAME = "org.telegram.ui.Gifts.GiftSheet$GiftCell"
CHECK_BOX_SIZE = 24
CHECK_BOX_MARGIN = 4


class GiftCellSetCheckedHook(MethodHook):

    def after_hooked_method(self, param):
        cell = param.thisObject
        if cell is None:
            return
        try:
            avatar_view = get_private_field(cell, "avatarView")
            if avatar_view is not None:
                avatar_view.setVisibility(View.VISIBLE)

            check_box = get_private_field(cell, "checkBox")
            if check_box is not None:
                check_box.setLayoutParams(
                    LayoutHelper.createFrame(
                        CHECK_BOX_SIZE,
                        CHECK_BOX_SIZE,
                        Gravity.BOTTOM | Gravity.RIGHT,
                        CHECK_BOX_MARGIN,
                        CHECK_BOX_MARGIN,
                        CHECK_BOX_MARGIN,
                        CHECK_BOX_MARGIN,
                    )
                )
        except Exception:
            pass


class GiftGiverAvatarPlugin(BasePlugin):

    def on_plugin_load(self):
        try:
            gift_cell_class = find_class(GIFT_CELL_CLASS_NAME)
            if gift_cell_class is None:
                return
            set_checked_method = gift_cell_class.getClass().getDeclaredMethod("setChecked", Boolean.TYPE, Boolean.TYPE)
            self._unhook = self.hook_method(set_checked_method, GiftCellSetCheckedHook(), 10)
        except Exception:
            pass

    def on_plugin_unload(self):
        unhook = getattr(self, "_unhook", None)
        if unhook is not None:
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
            self._unhook = None
