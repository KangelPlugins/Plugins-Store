# Жест "гладить" распознаётся как несколько разворотов пальца влево-вправо
# подряд (в отличие от обычного перетаскивания в одну сторону).
PET_DIRECTION_CHANGES_THRESHOLD = 3
PET_MIN_STEP_DP = 8       # минимальный шаг по X между событиями move, чтобы не ловить дрожание пальца
PET_MAX_VERTICAL_DRIFT_DP = 40  # насколько можно "гулять" по Y, чтобы жест всё ещё считался поглаживанием

# Бросок бойкиссера с инерцией: если в момент отпускания пальца (в конце
# перетаскивания) палец двигался быстрее порога — бойкиссер не
# останавливается на месте, а продолжает лететь в этом направлении и
# постепенно тормозит, отскакивая от краёв экрана, пока не остановится.
# Скорость пальца считаем вручную по "сырым" координатам событий
# ACTION_MOVE (см. DragTouchListener), а не через VelocityTracker — сама
# вью двигается вместе с пальцем во время драга, так что координаты
# события ОТНОСИТЕЛЬНО вью почти не меняются и дали бы скорость ~0;
# нужны именно координаты в системе координат экрана (getRawX/getRawY).
THROW_MIN_VELOCITY_DP = 300       # dp/с — ниже этого порога отпускание считается просто "положили"
THROW_MAX_VELOCITY_DP = 6000      # dp/с — потолок начальной скорости броска (чтобы не улетал мгновенно)
THROW_VELOCITY_SMOOTHING = 0.35   # сглаживание мгновенной скорости пальца между соседними move-событиями
                                  # (было 0.5 — уменьшили, чтобы дрожание пальца меньше "дёргало"
                                  # итоговую скорость броска и полёт получался более плавным)
THROW_RETENTION_PER_SEC = 0.5     # доля скорости, остающаяся спустя 1 секунду полёта (торможение)
                                  # (было 0.35 — увеличили: тормозит медленнее, бойкиссер дольше
                                  # катится по инерции, а не резко "прилипает")
THROW_BOUNCE_DAMPING = 0.6        # доля скорости, сохраняемая при отскоке от края экрана
                                  # (было 0.55 — чуть живее отскок в паре с более плавным торможением)
THROW_FRAME_MS = 12               # период кадра цикла анимации броска (~83 кадра/с, было 16мс/60кадров —
                                  # более частые кадры = более плавная (менее "дёрганая") анимация полёта)
THROW_STOP_VELOCITY_DP = 40       # dp/с — при такой или меньшей скорости полёт считается завершённым

# "Желейный" отскок: при ударе о край экрана картинка на мгновение
# сплющивается вдоль оси удара и чуть раздувается в перпендикулярной —
# и потом несколько раз быстро колеблется туда-сюда, затухая, как желе
# (см. _trigger_jelly_bounce/_run_jelly_frame). Чисто визуальный эффект,
# на физику полёта (vx/vy) не влияет.
JELLY_BOUNCE_MAX_SQUASH = 0.28     # максимальная амплитуда сплющивания (доля от размера)
JELLY_BOUNCE_DURATION_MS = 320     # сколько длится затухающее колебание
JELLY_BOUNCE_FREQUENCY_HZ = 7.0    # частота колебания туда-сюда
JELLY_BOUNCE_DAMPING_RATE = 9.0    # скорость затухания амплитуды (больше = быстрее гаснет)
JELLY_BOUNCE_FRAME_MS = 12         # период кадра анимации желейного эффекта

# Ограничения размера картинки (dp), чтобы нельзя было поставить
# неадекватно большой/маленький размер и сломать интерфейс чата.
MIN_SIZE_DP = 40
MAX_SIZE_DP = 400

# Ограничения прозрачности (%), 100 = полностью непрозрачно.
MIN_ALPHA_PERCENT = 10
MAX_ALPHA_PERCENT = 100
DEFAULT_ALPHA_PERCENT = 100

# Минимальная длительность проигрывания половины звука (на случай очень
# коротких файлов), чтобы звук не обрывался мгновенно.
MIN_MEOW_HALF_MS = 200

