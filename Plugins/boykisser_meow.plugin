# ------------------------------------------------------------------------ #
# Несколько boykisser-ов (v1.4.2): вместо одного глобального набора
# self._overlay_view/self._drawable/... плагин теперь может держать
# сразу несколько независимых "котов" на экране, каждый — отдельный
# _BoykisserInstance со своей собственной вью, гифкой, звуком, физикой
# броска/желе, сном и "просто так"-таймерами. Общие для всех остаются
# только настройки поведения (тап/глажка/иногда/сон/перетаскивание/
# реакция на сообщения) — они по-прежнему одни на всех, а вот РАЗМЕР,
# ПРОЗРАЧНОСТЬ и ПОЗИЦИЯ у каждого boykisser-а свои (см. create_settings/
# _create_appearance_settings).
#
# Количество активных котов хранится ОДНИМ числом — BOYKISSER_COUNT_KEY
# (сколько первых индексов из BOYKISSER_LABELS сейчас включены), вместо
# отдельного тумблера на каждого. В настройках это выглядит как кнопки
# "Добавить Бойкиссера" / "Убрать бойкиссера" внизу списка (см.
# _create_appearance_settings/_on_add_boykisser_click/
# _on_remove_boykisser_click) — новый кот добавляется/убирается по одному
# с конца, а не выбором произвольной галочки.
# ------------------------------------------------------------------------ #
MAX_BOYKISSERS = 5
BOYKISSER_LABELS = [f"Boykisser {i + 1}" for i in range(MAX_BOYKISSERS)]
BOYKISSER_COUNT_KEY = "boykisser_count"
DEFAULT_BOYKISSER_COUNT = 1

# Уникальные теги на вью оверлея. Нужны, чтобы при (пере)подключении можно
# было найти и убрать ЛЮБУЮ уже висящую в дереве вью бойкиссера — даже если
# она была добавлена другим (например, старым, "осиротевшим" после
# перезагрузки/обновления плагина) экземпляром этого класса, у которого нет
# рабочей ссылки в self._instances. Полагаться только на внутренние
# Python-ссылки текущего инстанса недостаточно: это и есть главная причина
# бага с "2+ бойкиссерами" в исходной (одиночной) версии плагина — см.
# _purge_stale_overlays. Каждый инстанс добавляет к базовому тегу свой
# суффикс (см. _instance_suffix), поэтому теги вида
# "boykisser_meow_overlay_main_3" однозначно принадлежат Boykisser-у №3.
OVERLAY_VIEW_TAG = "boykisser_meow_overlay_main"
PET_OVERLAY_VIEW_TAG = "boykisser_meow_overlay_pet"


def _data_dir() -> str:
    # Используем общую files-директорию Telegram, а не папку плагина —
    # так гифка/звук не потеряются при переустановке .plugin файла.
    d = os.path.join(get_files_dir(), PLUGIN_DATA_DIRNAME)
    ensure_dir_exists(d)
    return d


def _instance_suffix(index: int) -> str:
    """Суффикс для ключей настроек/тегов конкретного boykisser-а. Первый
    (index=0) не имеет суффикса — это сохраняет обратную совместимость со
    старыми настройками (width_dp/height_dp/alpha_percent/pos_*_dp),
    сохранёнными версиями плагина до появления нескольких котов."""
    return "" if index == 0 else f"_{index + 1}"


class _BoykisserInstance:
    """Всё изменяемое состояние ОДНОГО boykisser-а на экране: его вью,
    текущий drawable, звук, флаги анимации/глажки/сна и токены броска/желе.
    Раньше всё это было полями self._... самого плагина (единственного
    boykisser-а на экране); теперь плагин хранит список таких объектов —
    по одному на каждого включённого кота (см. self._instances)."""

    def __init__(self, index: int):
        self.index = index
        self.suffix = _instance_suffix(index)

        self.overlay_view = None
        self.drawable = None
        self.gif_path = None

        self.pet_view = None
        self.pet_drawable = None
        self.pet_gif_path = None
        self.is_petting = False
        self.pet_session_id = 0
        # True, пока основная гифка boykisser-а подменена на PET_MAIN_GIF_URL.
        self.pet_main_active = False

        # Пока True — анимация/звук ещё проигрываются, повторные тапы
        # игнорируются (см. _on_boykisser_tap).
        self.is_animating = False

        # "Просто так"-гифка (см. _idle_gif_tick).
        self.is_idle_playing = False
        self.idle_drawable = None
        self.idle_gif_token = 0

        # Бросок с инерцией (см. _start_throw/_run_throw_frame).
        self.is_throwing = False
        self.throw_token = 0
        # "Желейный" отскок (см. _trigger_jelly_bounce/_run_jelly_frame).
        self.jelly_token = 0

        # Сон (см. _fall_asleep/_wake_up).
        self.is_sleeping = False
        self.last_interaction_ms = 0

        # Звук — свой MediaPlayer у каждого boykisser-а, чтобы мяу одного
        # кота не обрывало мяу/мурчание другого.
        self.media_player = None
        self.purr_media_player = None
        self.is_purring = False


class BoykisserMeowPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._activity_hook = None
        # Флаг для остановки цепочки отложенных таймеров "иногда"/сна
        # после выгрузки плагина — см. _schedule_idle_gif/_schedule_idle_meow/
        # _schedule_sleep_check (каждый инстанс дополнительно проверяет,
        # что он всё ещё присутствует в self._instances).
        self._destroyed = False
        # True, пока приложение реально на экране (после onResume/onCreate,
        # до ближайшего onPause). Пока False — случайные "просто так"
        # срабатывания (гифка/мяу) не запускаются и не издают звук, даже
        # если их таймер сработал в этот момент — см. _on_activity_paused,
        # _idle_gif_tick, _idle_meow_tick.
        self._is_foreground = True
        # Список активных boykisser-ов, по одному _BoykisserInstance на
        # каждого показанного сейчас на экране кота (см. _attach_overlay).
        self._instances: List[_BoykisserInstance] = []

    # ------------------------------------------------------------------ #
    # Жизненный цикл плагина
    # ------------------------------------------------------------------ #

    def on_plugin_load(self):
        self.log("Boykisser Corner: загрузка плагина")
        self._destroyed = False
        # Скачиваем гифку/звук в фоне, чтобы не блокировать UI-поток
        threading.Thread(target=self._prepare_assets, daemon=True).start()
        self._install_activity_hook()
        # Хук на исходящие сообщения — нужен для реакции на собственные
        # триггер-слова (см. on_send_message_hook/_check_trigger_words).
        self.add_on_send_message_hook()
        # Пробуем прицепить оверлей сразу, не дожидаясь onCreate/onResume —
        # это нужно, если плагин включили в уже открытом приложении.
        # Планирование "иногда"-гифки/мяу и проверки сна запускается для
        # каждого boykisser-а отдельно, сразу после создания его вью — см.
        # _attach_overlay.
        self._try_attach_to_current_activity()

    def _try_attach_to_current_activity(self):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            activity = fragment.getParentActivity()
            if activity is None:
                return
            self._is_foreground = True
            run_on_ui_thread(lambda: self._attach_overlay(activity))
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось получить текущую активность — {e}")

    def _on_activity_paused(self):
        """Вызывается, когда приложение уходит с переднего плана (свёрнуто,
        экран выключен, поверх открылось другое приложение). Останавливает
        уже играющий звук и случайную гифку "просто так" немедленно для
        КАЖДОГО boykisser-а — без этого MediaPlayer продолжал бы играть
        звук, даже когда пользователь не видит и не трогает приложение (это
        и был баг со звуком в свёрнутом состоянии)."""
        self._is_foreground = False
        for instance in list(self._instances):
            self._interrupt_idle_gif(instance)
            self._stop_throw(instance)
            if instance.media_player is not None:
                mp = instance.media_player
                instance.media_player = None
                try:
                    if mp.isPlaying():
                        mp.stop()
                    mp.release()
                except Exception:
                    pass
        # Мурчание при глажке отдельно останавливать не нужно: сам жест
        # физически не может продолжаться в свёрнутом приложении — палец
        # уже не на экране, ACTION_UP/ACTION_CANCEL сами остановят его
        # штатным путём (_hide_pet_overlay_now -> _stop_purr).

    def on_plugin_unload(self):
        self._destroyed = True
        for instance in list(self._instances):
            instance.is_animating = False
            self._stop_throw(instance)
        self._remove_overlay_view()
        if self._activity_hook:
            try:
                for unhook_obj in self._activity_hook:
                    self.unhook_method(unhook_obj)
            except Exception as e:
                self.log(f"Boykisser Corner: не удалось снять хук — {e}")
            self._activity_hook = None

    # ------------------------------------------------------------------ #
    # Настройки
    # ------------------------------------------------------------------ #

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Boykisser Corner"),
            Switch(
                key="enabled",
                text="Показывать boykisser",
                default=True,
                on_change=self._on_enabled_change,
            ),
            Text(
                text="Внешний вид",
                subtext="Сколько котов, размер и прозрачность каждого",
                icon="msg_photo_settings",
                create_sub_fragment=self._create_appearance_settings,
            ),
            Text(
                text="Тап",
                subtext="Анимация, звук, уведомление по тапу",
                icon="msg_reactions",
                create_sub_fragment=self._create_tap_settings,
            ),
            Text(
                text="Глажка",
                subtext="Свайп по верхней части и уведомление",
                icon="msg_fave",
                create_sub_fragment=self._create_petting_settings,
            ),
            Text(
                text="Иногда",
                subtext="Случайные гифки и мяу без причины",
                icon="msg_reactions",
                create_sub_fragment=self._create_idle_settings,
            ),
            Text(
                text="Сон",
                subtext="Засыпает, если долго не трогать",
                icon="msg_mute",
                create_sub_fragment=self._create_sleep_settings,
            ),
            Text(
                text="Перетаскивание",
                subtext="Перетаскивание и инерция броска",
                icon="msg_photo_settings",
                create_sub_fragment=self._create_movement_settings,
            ),
            Text(
                text="Реакция на сообщения",
                subtext="Мяукать на триггер-слова в открытом чате",
                icon="msg_reactions",
                create_sub_fragment=self._create_message_reaction_settings,
            ),
        ]

    def _create_message_reaction_settings(self) -> List[Any]:
        return [
            Header(text="Реакция на сообщения"),
            Switch(
                key="message_reaction_enabled",
                text="Включить реакцию на сообщения",
                default=False,
            ),
            Switch(
                key="react_own_messages",
                text="Реагировать и на свои сообщения",
                default=True,
            ),
            Input(
                key="trigger_words",
                text="Триггер-слова (через запятую)",
                default="кот, мяу, boykisser",
                subtext="Слова, при появлении которых boykisser мяукнёт",
                icon="msg_photo_settings",
            ),
        ]

    def _create_movement_settings(self) -> List[Any]:
        return [
            Header(text="Перетаскивание"),
            Switch(
                key="dragging_enabled",
                text="Перетаскивание",
                default=True,
            ),
            Switch(
                key="throw_enabled",
                text="Инерция",
                default=True,
            ),
            Switch(
                key="jelly_bounce_enabled",
                text="Желейный отскок",
                default=True,
            ),
        ]

    def _create_appearance_settings(self) -> List[Any]:
        """Настройки внешнего вида для КАЖДОГО boykisser-а по отдельности.
        Сколько котов сейчас включено — определяется одним числом
        (см. _get_boykisser_count), а не отдельным тумблером на каждого:
        внизу списка есть кнопки "Добавить Бойкиссера" / "Убрать
        бойкиссера", которые добавляют/убирают кота с конца."""
        count = self._get_boykisser_count()
        items: List[Any] = [
            Header(text="Внешний вид"),
            Text(
                text="Настраивайте размер и прозрачность каждого boykisser-а "
                     "по отдельности. Кнопки внизу добавляют или убирают котов.",
                subtext="",
                icon="msg_info",
            ),
        ]
        for index in range(count):
            suffix = _instance_suffix(index)
            items.append(Header(text=BOYKISSER_LABELS[index]))
            items.append(
                Input(
                    key=f"width_dp{suffix}",
                    text="Ширина (dp)",
                    default=str(DEFAULT_SIZE_DP),
                    subtext=f"От {MIN_SIZE_DP} до {MAX_SIZE_DP} dp",
                    icon="msg_photo_settings",
                    on_change=self._make_appearance_handler("width", index),
                )
            )
            items.append(
                Input(
                    key=f"height_dp{suffix}",
                    text="Высота (dp)",
                    default=str(DEFAULT_SIZE_DP),
                    subtext=f"От {MIN_SIZE_DP} до {MAX_SIZE_DP} dp",
                    icon="msg_photo_settings",
                    on_change=self._make_appearance_handler("height", index),
                )
            )
            items.append(
                Input(
                    key=f"alpha_percent{suffix}",
                    text="Прозрачность (%)",
                    default=str(DEFAULT_ALPHA_PERCENT),
                    subtext=f"От {MIN_ALPHA_PERCENT} до {MAX_ALPHA_PERCENT}%, 100 — непрозрачно",
                    icon="msg_photo_settings",
                    on_change=self._make_appearance_handler("alpha", index),
                )
            )

        items.append(Divider())
        if count < MAX_BOYKISSERS:
            items.append(
                Text(
                    text="Добавить Бойкиссера",
                    subtext=f"Сейчас: {count} из {MAX_BOYKISSERS}",
                    icon="msg_add",
                    accent=True,
                    on_click=self._on_add_boykisser_click,
                )
            )
        if count > 1:
            items.append(
                Text(
                    text="Убрать бойкиссера",
                    subtext=f"Уберёт {BOYKISSER_LABELS[count - 1]}",
                    icon="msg_delete",
                    red=True,
                    on_click=self._on_remove_boykisser_click,
                )
            )
        return items

    def _get_boykisser_count(self) -> int:
        return self._get_clamped_int_setting(
            BOYKISSER_COUNT_KEY, DEFAULT_BOYKISSER_COUNT, 1, MAX_BOYKISSERS
        )

    def _on_add_boykisser_click(self, view=None):
        """Кнопка "Добавить Бойкиссера" — включает следующего по счёту
        кота и сразу пересобирает страницу настроек, чтобы под него
        появились свои поля размера/прозрачности."""
        count = self._get_boykisser_count()
        if count >= MAX_BOYKISSERS:
            return
        new_count = count + 1
        self.set_setting(BOYKISSER_COUNT_KEY, str(new_count), reload_settings=True)
        self._try_attach_to_current_activity()
        run_on_ui_thread(
            lambda: BulletinHelper.show_success(
                f"{BOYKISSER_LABELS[new_count - 1]} добавлен", get_last_fragment()
            )
        )

    def _on_remove_boykisser_click(self, view=None):
        """Кнопка "Убрать бойкиссера" — выключает последнего по счёту
        кота (не любого произвольного) и пересобирает страницу настроек."""
        count = self._get_boykisser_count()
        if count <= 1:
            return
        removed_label = BOYKISSER_LABELS[count - 1]
        new_count = count - 1
        self.set_setting(BOYKISSER_COUNT_KEY, str(new_count), reload_settings=True)
        self._try_attach_to_current_activity()
        run_on_ui_thread(
            lambda: BulletinHelper.show_success(f"{removed_label} убран", get_last_fragment())
        )

    def _create_tap_settings(self) -> List[Any]:
        return [
            Header(text="Тап"),
            Switch(
                key="tap_enabled",
                text="Реакция по тапу (анимация + звук + уведомление)",
                default=True,
            ),
            Switch(
                key="tap_notification_enabled",
                text="Уведомление по тапу (только если включена \"Реакция по тапу\")",
                default=True,
            ),
        ]

    def _create_petting_settings(self) -> List[Any]:
        return [
            Header(text="Глажка"),
            Switch(
                key="petting_enabled",
                text="Гладить свайпом по верхней части",
                default=True,
            ),
            Switch(
                key="pet_notification_enabled",
                text="Уведомление при глажке",
                default=True,
            ),
        ]

    def _create_idle_settings(self) -> List[Any]:
        return [
            Header(text="Иногда"),
            Switch(
                key="idle_gif_enabled",
                text="Изредка проигрывать случайную гифку",
                default=True,
            ),
            Selector(
                key="idle_gif_preset",
                text="Гифка: частота",
