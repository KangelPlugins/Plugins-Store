            ),
        ]

    # ------------------------------------------------------------------ #
    # Живые реакции на изменение настроек (без перезахода в приложение)
    # ------------------------------------------------------------------ #

    def _on_enabled_change(self, new_value: bool):
        if new_value:
            self._try_attach_to_current_activity()
        else:
            self._remove_overlay_view()

    def _make_appearance_handler(self, dimension: str, index: int):
        """dimension — "width"/"height"/"alpha". Возвращает on_change для
        Input конкретного boykisser-а, применяющий изменение сразу же, без
        ожидания следующего перезахода в приложение (см.
        _apply_live_appearance_for_index)."""

        def handler(new_value: str):
            kwargs = {f"{dimension}_str": new_value}
            self._apply_live_appearance_for_index(index, **kwargs)

        return handler

    def _apply_live_appearance_for_index(
        self, index: int, width_str=None, height_str=None, alpha_str=None
    ):
        """Применяет ширину/высоту/прозрачность к уже показанной вью
        конкретного boykisser-а сразу, без ожидания следующего перезахода
        в приложение."""
        instance = self._get_instance(index)
        if instance is None or instance.overlay_view is None:
            return
        suffix = instance.suffix
        view = instance.overlay_view
        try:
            if width_str is not None:
                width_dp = self._clamp_str_int(width_str, DEFAULT_SIZE_DP, MIN_SIZE_DP, MAX_SIZE_DP)
            else:
                width_dp = self._get_clamped_int_setting(
                    f"width_dp{suffix}", DEFAULT_SIZE_DP, MIN_SIZE_DP, MAX_SIZE_DP
                )

            if height_str is not None:
                height_dp = self._clamp_str_int(height_str, DEFAULT_SIZE_DP, MIN_SIZE_DP, MAX_SIZE_DP)
            else:
                height_dp = self._get_clamped_int_setting(
                    f"height_dp{suffix}", DEFAULT_SIZE_DP, MIN_SIZE_DP, MAX_SIZE_DP
                )

            if alpha_str is not None:
                alpha_percent = self._clamp_str_int(
                    alpha_str, DEFAULT_ALPHA_PERCENT, MIN_ALPHA_PERCENT, MAX_ALPHA_PERCENT
                )
            else:
                alpha_percent = self._get_clamped_int_setting(
                    f"alpha_percent{suffix}", DEFAULT_ALPHA_PERCENT, MIN_ALPHA_PERCENT, MAX_ALPHA_PERCENT
                )

            density = view.getResources().getDisplayMetrics().density
            params = view.getLayoutParams()
            params.width = int(width_dp * density)
            params.height = int(height_dp * density)

            pet_view = instance.pet_view
            pet_params = pet_view.getLayoutParams() if pet_view is not None else None
            if pet_params is not None:
                pet_params.width = params.width
                pet_params.height = params.height

            def _apply():
                view.setLayoutParams(params)
                view.setAlpha(alpha_percent / 100.0)
                if pet_view is not None:
                    pet_view.setLayoutParams(pet_params)
                    pet_view.setAlpha(alpha_percent / 100.0)

            run_on_ui_thread(_apply)
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось применить внешний вид на лету — {e}")

    # ------------------------------------------------------------------ #
    # Хелперы для безопасного чтения настроек с ограничениями
    # ------------------------------------------------------------------ #

    @staticmethod
    def _clamp_str_int(raw: str, default: int, lo: int, hi: int) -> int:
        try:
            value = int(float(raw))
        except (TypeError, ValueError):
            value = default
        return max(lo, min(hi, value))

    def _get_clamped_int_setting(self, key: str, default: int, lo: int, hi: int) -> int:
        raw = self.get_setting(key, str(default))
        try:
            value = int(float(raw))
        except (TypeError, ValueError):
            value = default
        return max(lo, min(hi, value))

    # ------------------------------------------------------------------ #
    # Управление списком инстансов
    # ------------------------------------------------------------------ #

    def _get_instance(self, index: int) -> Optional[_BoykisserInstance]:
        for instance in self._instances:
            if instance.index == index:
                return instance
        return None

    def _is_instance_enabled(self, index: int) -> bool:
        """index=0 — первый кот, управляется общим тумблером "enabled"
        (уже проверенным в _attach_overlay до вызова этого метода).
        index>=1 — включён, пока он входит в текущее количество котов
        (см. _get_boykisser_count/_on_add_boykisser_click/
        _on_remove_boykisser_click) — коты добавляются/убираются по
        одному с конца, а не произвольной галочкой."""
        if index == 0:
            return True
        return index < self._get_boykisser_count()

    def _enabled_indices(self) -> List[int]:
        return [i for i in range(MAX_BOYKISSERS) if self._is_instance_enabled(i)]

    @staticmethod
    def _default_pos_right_dp(index: int) -> int:
        return 16

    @staticmethod
    def _default_pos_bottom_dp(index: int) -> int:
        # Каждый следующий кот по умолчанию появляется выше предыдущего,
        # чтобы новые boykisser-ы не спавнились друг на друге — после
        # первого перетаскивания позиция каждого сохраняется независимо
        # (см. pos_right_dp{suffix}/pos_bottom_dp{suffix}).
        return 16 + index * 160

    # ------------------------------------------------------------------ #
    # Загрузка ресурсов
    # ------------------------------------------------------------------ #

    def _prepare_assets(self):
        gif_url = DEFAULT_GIF_URL
        sound_url = DEFAULT_SOUND_URL
        purr_sound_url = PURR_SOUND_URL
        pet_gif_url = PET_GIF_URL
        pet_main_gif_url = PET_MAIN_GIF_URL

        gif_path = os.path.join(_data_dir(), GIF_FILENAME)
        sound_path = os.path.join(_data_dir(), SOUND_FILENAME)
        purr_sound_path = os.path.join(_data_dir(), PURR_SOUND_FILENAME)
        pet_gif_path = os.path.join(_data_dir(), PET_GIF_FILENAME)
        pet_main_gif_path = os.path.join(_data_dir(), PET_MAIN_GIF_FILENAME)

        if gif_url and not os.path.exists(gif_path):
            try:
                self._download(gif_url, gif_path)
                self.log("Boykisser Corner: гифка скачана")
            except Exception as e:
                self.log(f"Boykisser Corner: не удалось скачать гифку — {e}")

        if sound_url and not os.path.exists(sound_path):
            try:
                self._download(sound_url, sound_path)
                self.log("Boykisser Corner: звук скачан")
            except Exception as e:
                self.log(f"Boykisser Corner: не удалось скачать звук — {e}")

        if purr_sound_url and not os.path.exists(purr_sound_path):
            try:
                self._download(purr_sound_url, purr_sound_path)
                self.log("Boykisser Corner: звук мурчания скачан")
            except Exception as e:
                self.log(f"Boykisser Corner: не удалось скачать звук мурчания — {e}")

        if pet_gif_url and not os.path.exists(pet_gif_path):
            try:
                self._download(pet_gif_url, pet_gif_path)
                self.log("Boykisser Corner: гифка для гладения скачана")
            except Exception as e:
                self.log(f"Boykisser Corner: не удалось скачать гифку гладения — {e}")

        if pet_main_gif_url and not os.path.exists(pet_main_gif_path):
            try:
                self._download(pet_main_gif_url, pet_main_gif_path)
                self.log("Boykisser Corner: гифка boykisser-а для глажки скачана")
            except Exception as e:
                self.log(f"Boykisser Corner: не удалось скачать гифку boykisser-а для глажки — {e}")

        for index, idle_gif_url in enumerate(IDLE_RANDOM_GIF_URLS):
            idle_gif_path = os.path.join(
                _data_dir(), IDLE_RANDOM_GIF_FILENAME_TEMPLATE.format(index=index)
            )
            if idle_gif_url and not os.path.exists(idle_gif_path):
                try:
                    self._download(idle_gif_url, idle_gif_path)
                    self.log(f"Boykisser Corner: случайная гифка №{index} скачана")
                except Exception as e:
                    self.log(f"Boykisser Corner: не удалось скачать случайную гифку №{index} — {e}")

        sleep_gif_path = os.path.join(_data_dir(), SLEEP_GIF_FILENAME)
        if SLEEP_GIF_URL and not os.path.exists(sleep_gif_path):
            try:
                self._download(SLEEP_GIF_URL, sleep_gif_path)
                self.log("Boykisser Corner: гифка сна скачана")
            except Exception as e:
                self.log(f"Boykisser Corner: не удалось скачать гифку сна — {e}")

    @staticmethod
    def _now_ms() -> int:
        return int(time.time() * 1000)

    @staticmethod
    def _download(url: str, dest_path: str):
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = resp.read()
        with open(dest_path, "wb") as f:
            f.write(data)

    # ------------------------------------------------------------------ #
    # Хук на LaunchActivity, чтобы получить окно приложения
    # ------------------------------------------------------------------ #

    def _install_activity_hook(self):
        LaunchActivityClass = find_class("org.telegram.ui.LaunchActivity")
        if not LaunchActivityClass:
            self.log("Boykisser Corner: не найден класс LaunchActivity")
            return

        plugin = self

        class ActivityReadyHook(MethodHook):
            def after_hooked_method(self, param):
                activity = param.thisObject
                # onCreate/onResume означают, что активность снова видна
                # пользователю — снимаем блокировку фоновых звуков/гифок
                # (см. _on_activity_paused и её проверки в _idle_gif_tick/
                # _idle_meow_tick).
                plugin._is_foreground = True
                run_on_ui_thread(lambda: plugin._attach_overlay(activity))

        class ActivityPausedHook(MethodHook):
            def after_hooked_method(self, param):
                run_on_ui_thread(plugin._on_activity_paused)

        self._activity_hook = []
        # onCreate сработает при полном (пере)запуске приложения.
        # onResume дополнительно сработает при каждом выходе активности на
        # передний план — это позволяет не убивать процесс вручную, если
        # плагин включили уже во время работающего приложения.
        for method_name in ("onCreate", "onResume"):
            try:
                unhooks = self.hook_all_methods(
                    LaunchActivityClass, method_name, ActivityReadyHook()
                )
                if unhooks:
                    self._activity_hook.extend(unhooks)
                    self.log(f"Boykisser Corner: захукан {method_name}")
                else:
                    self.log(f"Boykisser Corner: не удалось захукать {method_name}")
            except Exception as e:
                self.log(f"Boykisser Corner: ошибка хука {method_name} — {e}")

        # onPause сработает, когда приложение уходит с переднего плана
        # (свёрнуто, экран выключен, поверх открылось другое приложение).
        # Используем его, чтобы прервать/заглушить фоновые "просто так"
        # срабатывания — см. _on_activity_paused.
        try:
            unhooks = self.hook_all_methods(
                LaunchActivityClass, "onPause", ActivityPausedHook()
            )
            if unhooks:
                self._activity_hook.extend(unhooks)
                self.log("Boykisser Corner: захукан onPause")
            else:
                self.log("Boykisser Corner: не удалось захукать onPause")
        except Exception as e:
            self.log(f"Boykisser Corner: ошибка хука onPause — {e}")

        self._install_new_message_hook()

    # ------------------------------------------------------------------ #
    # Хук на реально новые чужие сообщения (NotificationsController)
    # ------------------------------------------------------------------ #

    def _install_new_message_hook(self):
        NotificationsControllerClass = find_class("org.telegram.messenger.NotificationsController")
        if not NotificationsControllerClass:
            self.log("Boykisser Corner: не найден класс NotificationsController")
            return

        plugin = self

        class NewMessagesHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    if not plugin.get_setting("message_reaction_enabled", False):
                        return
                    messages = param.args[0] if param.args else None
                    if messages is None:
                        return
                    # Реагируем только на сообщения из чата, который прямо
                    # сейчас открыт на экране — иначе boykisser мяукал бы
                    # на триггер-слова в ЛЮБОМ чате/канале, даже пока
                    # пользователь сидит совсем в другой переписке или в
                    # списке диалогов. Если открытого чата нет вовсе
                    # (список диалогов, настройки и т.п.) — сверять не с
                    # чем, пропускаем все сообщения этой пачки.
                    current_dialog_id = plugin._get_current_open_dialog_id()
                    if current_dialog_id is None:
                        return
                    size = messages.size()
                    for i in range(size):
                        msg_obj = messages.get(i)
                        msg_dialog_id = plugin._get_message_dialog_id(msg_obj)
                        if msg_dialog_id is None or msg_dialog_id != current_dialog_id:
                            continue
                        text = getattr(msg_obj, "messageText", None)
                        if not text:
                            owner = getattr(msg_obj, "messageOwner", None)
                            text = getattr(owner, "message", None) if owner is not None else None
                        if text:
                            plugin._check_trigger_words(str(text))
                except Exception as e:
                    plugin.log(f"Boykisser Corner: ошибка хука новых сообщений — {e}")

        try:
            unhooks = self.hook_all_methods(
                NotificationsControllerClass, "processNewMessages", NewMessagesHook()
            )
            if unhooks:
                self._activity_hook.extend(unhooks)
                self.log("Boykisser Corner: захукан NotificationsController.processNewMessages")
            else:
                self.log("Boykisser Corner: не удалось захукать processNewMessages")
        except Exception as e:
            self.log(f"Boykisser Corner: ошибка хука processNewMessages — {e}")

    # ------------------------------------------------------------------ #
    # Определение текущего открытого чата (для реакции "только тут")
    # ------------------------------------------------------------------ #

    def _get_current_open_dialog_id(self):
        """Возвращает dialog_id чата, который прямо сейчас открыт на
        экране (ChatActivity), или None, если открытого чата нет (список
        диалогов, настройки, звонок и т.п.). Используется, чтобы реакция
        на триггер-слова не срабатывала на сообщения из других чатов —
        см. NewMessagesHook."""
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return None
            if fragment.getClass().getSimpleName() != "ChatActivity":
                return None
            return fragment.getDialogId()
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось получить id текущего чата — {e}")
            return None

    def _get_message_dialog_id(self, msg_obj):
        """Достаёт dialog_id из MessageObject — сперва пробуем штатный
        геттер, если его нет (или он упал) — читаем поле dialog_id прямо
        из messageOwner (TLRPC.Message)."""
        try:
            get_dialog_id = getattr(msg_obj, "getDialogId", None)
            if callable(get_dialog_id):
                return get_dialog_id()
        except Exception:
            pass
        try:
            owner = getattr(msg_obj, "messageOwner", None)
            if owner is not None:
                return getattr(owner, "dialog_id", None)
        except Exception:
            pass
        return None

    # ------------------------------------------------------------------ #
    # Реакция на триггер-слова в сообщениях
    # ------------------------------------------------------------------ #

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        try:
            if self.get_setting("message_reaction_enabled", False) and self.get_setting("react_own_messages", True):
                text = getattr(params, "message", None)
                if isinstance(text, str) and text:
                    self._check_trigger_words(text)
        except Exception as e:
            self.log(f"Boykisser Corner: ошибка в обработчике исходящих сообщений — {e}")
        return HookResult()

    def _check_trigger_words(self, text: str):
        raw_words = self.get_setting("trigger_words", "кот, мяу, boykisser")
        trigger_list = [w.strip().lower() for w in raw_words.split(",") if w.strip()]
        if not trigger_list:
            return
        text_lower = text.lower()
        for word in trigger_list:
            if word in text_lower:
                self._on_trigger_word()
                break

    def _on_trigger_word(self):
        # Реакция на триггер-слово работает как обычный тап (звук + анимация
        # классической гифки + уведомление) — срабатывает у КАЖДОГО
        # показанного сейчас boykisser-а по отдельности; если конкретный кот
        # занят (глажка/анимация/сон) — просто пропускаем именно его, не
        # трогая остальных.
        for instance in list(self._instances):
            if self._destroyed:
                return
            if instance.is_petting or instance.pet_main_active or instance.is_sleeping:
                continue
            self._interrupt_idle_gif(instance)
            if instance.is_animating:
                continue
            instance.is_animating = True

            run_on_ui_thread(
                lambda: BulletinHelper.show_success("Meow!", get_last_fragment()),
                BULLETIN_DELAY_MS,
            )

            meow_ms = self._play_meow(instance)
            self._play_animation(instance)
            busy_ms = max(ANIM_DURATION_MS, meow_ms or 0)
            run_on_ui_thread(lambda inst=instance: self._clear_busy(inst), busy_ms)

    # ------------------------------------------------------------------ #
    # Наложение вью поверх интерфейса
    # ------------------------------------------------------------------ #

    def _attach_overlay(self, activity):
        if not self.get_setting("enabled", True):
            self._remove_overlay_view()
            return

        desired_indices = self._enabled_indices()
        currently_attached = [
            instance.index
            for instance in self._instances
            if instance.overlay_view is not None and instance.overlay_view.getParent() is not None
        ]
        if desired_indices and currently_attached == desired_indices:
            # Уже показаны именно те коты, что и должны быть — повторно
            # не пересоздаём (та же оптимизация, что была в исходной
            # однокотовой версии).
            return

        gif_path = os.path.join(_data_dir(), GIF_FILENAME)
        if not os.path.exists(gif_path):
            # Гифка ещё не скачалась — пробуем позже
            run_on_ui_thread(lambda: self._attach_overlay(activity), 1500)
            return

        try:
            from android.view import ViewGroup
            from java import cast

            window = activity.getWindow()
            decor = window.getDecorView()
            root = cast(ViewGroup, decor)
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось получить окно приложения — {e}")
            return

        self._remove_overlay_view()
        self._purge_stale_overlays(root)

        density = activity.getResources().getDisplayMetrics().density

        for index in desired_indices:
            instance = _BoykisserInstance(index)
            self._create_instance_views(instance, activity, root, gif_path, density)
            if instance.overlay_view is None:
                # Не удалось создать вью для этого кота — не добавляем
                # его в список и не запускаем для него таймеры.
                continue
            self._instances.append(instance)
            instance.last_interaction_ms = self._now_ms()
            self._schedule_idle_gif(instance)
            self._schedule_idle_meow(instance)
            self._schedule_sleep_check(instance)

        self.log(f"Boykisser Corner: вью добавлена(ы) — {len(self._instances)} шт.")

    def _create_instance_views(self, instance: "_BoykisserInstance", activity, root, gif_path: str, density: float):
        """Создаёт и добавляет в дерево вью ОДНОГО boykisser-а (классическую
        + гифку глажения) и вешает на них DragTouchListener. Аналог тела
        исходного _attach_overlay, но параметризован конкретным instance —
        чтобы то же самое можно было повторить независимо для каждого
        включённого кота."""
        try:
            from android.view import Gravity, ViewGroup, View, MotionEvent
            from android.widget import FrameLayout, ImageView
            from android.graphics import ImageDecoder
            from java.io import File as JFile
            from java import cast, dynamic_proxy

            suffix = instance.suffix

            image_view = ImageView(activity)
            # По умолчанию у ImageView стоит FIT_CENTER, который сохраняет
            # пропорции гифки внутри контейнера — из-за этого раздельные
            # настройки ширины/высоты визуально не работали независимо
            # (картинка всегда скейлилась по меньшей стороне). FIT_XY
            # растягивает содержимое строго по заданным width/height.
            image_view.setScaleType(ImageView.ScaleType.FIT_XY)

            source = ImageDecoder.createSource(JFile(gif_path))
            drawable = ImageDecoder.decodeDrawable(source)
            image_view.setImageDrawable(drawable)
            instance.drawable = drawable
            instance.gif_path = gif_path
            # Гифка не проигрывается сама — стоит статичной картинкой,
            # анимация запускается только по тапу (см. _on_boykisser_tap).

            width_dp = self._get_clamped_int_setting(
                f"width_dp{suffix}", DEFAULT_SIZE_DP, MIN_SIZE_DP, MAX_SIZE_DP
            )
            height_dp = self._get_clamped_int_setting(
                f"height_dp{suffix}", DEFAULT_SIZE_DP, MIN_SIZE_DP, MAX_SIZE_DP
            )
            alpha_percent = self._get_clamped_int_setting(
                f"alpha_percent{suffix}", DEFAULT_ALPHA_PERCENT, MIN_ALPHA_PERCENT, MAX_ALPHA_PERCENT
            )

            width_px = int(width_dp * density)
            height_px = int(height_dp * density)

            default_right = self._default_pos_right_dp(instance.index)
            default_bottom = self._default_pos_bottom_dp(instance.index)
            right_margin_px = int(
                float(self.get_setting(f"pos_right_dp{suffix}", default_right)) * density
            )
            bottom_margin_px = int(
                float(self.get_setting(f"pos_bottom_dp{suffix}", default_bottom)) * density
            )

            params = FrameLayout.LayoutParams(width_px, height_px)
            params.gravity = Gravity.BOTTOM | Gravity.RIGHT
            params.rightMargin = right_margin_px
            params.bottomMargin = bottom_margin_px
            image_view.setLayoutParams(params)
            image_view.setAlpha(alpha_percent / 100.0)
            image_view.setClickable(True)
            image_view.setTag(f"{OVERLAY_VIEW_TAG}{suffix}")

            plugin = self
            drag_slop_px = int(10 * density)
            pet_min_step_px = int(PET_MIN_STEP_DP * density)
            pet_max_vertical_drift_px = int(PET_MAX_VERTICAL_DRIFT_DP * density)
            pet_vertical_offset_px = int(PET_VERTICAL_OFFSET_DP * density)

            class DragTouchListener(dynamic_proxy(View.OnTouchListener)):
                def __init__(self):
                    super().__init__()
                    self.start_x = 0.0
                    self.start_y = 0.0
                    self.start_right = 0
                    self.start_bottom = 0
                    self.dragging = False
                    # Зона тача определяется один раз в ACTION_DOWN по
                    # локальной Y-координате внутри вью: верхняя половина
                    # картинки — "погладить", нижняя половина — "тащить"/
                    # "тапнуть, чтобы мяукнуть".
                    self.top_zone = False
                    # Отслеживание жеста "погладить" в верхней зоне: считаем
                    # развороты пальца влево-вправо (см. _on_boykisser_pet).
                    # Простой тап без разворотов в верхней зоне — это обычный
                    # тап (мяу), как и в нижней зоне.
                    self.pet_last_x = 0.0
                    self.pet_last_direction = 0
                    self.pet_direction_changes = 0
                    self.pet_triggered = False
                    # Ручной расчёт скорости пальца в системе координат
                    # экрана (для броска с инерцией после ACTION_UP) — см.
                    # комментарий у THROW_MIN_VELOCITY_DP: VelocityTracker
                    # тут не годится, т.к. вью следует за пальцем и
                    # локальные координаты события почти не меняются.
                    self.vel_last_time = 0
                    self.vel_last_x = 0.0
                    self.vel_last_y = 0.0
                    self.vel_x = 0.0
                    self.vel_y = 0.0

                def onTouch(self, v, event):
                    action = event.getAction()

                    if action == MotionEvent.ACTION_DOWN:
                        # Любое касание — тап, глажка или перетаскивание —
                        # начинается с ACTION_DOWN, так что это единая точка
                        # входа, чтобы сбросить таймер бездействия и
                        # разбудить boykisser-а, если он спал (см.
                        # _register_interaction).
                        plugin._register_interaction(instance)
                        self.start_x = event.getRawX()
                        self.start_y = event.getRawY()
                        self.start_right = params.rightMargin
                        self.start_bottom = params.bottomMargin
                        self.dragging = False
                        # event.getY() — координата в системе координат самой
                        # вью (0 = верх картинки), а не экрана, поэтому не
                        # зависит от текущей позиции boykisser-а на экране.
                        local_y = event.getY()
                        # Если гладение выключено в настройках — вся вью
                        # ведёт себя как раньше (без верхней зоны): тап/драг
                        # работают везде, свайп-жест не распознаётся.
                        petting_enabled = plugin.get_setting("petting_enabled", True)
                        self.top_zone = petting_enabled and local_y < (params.height / 2.0)

                        self.pet_last_x = event.getRawX()
                        self.pet_last_direction = 0
                        self.pet_direction_changes = 0
                        self.pet_triggered = False

                        # Хватаем бойкиссера заново — если он в этот момент
                        # ещё летел по инерции от предыдущего броска,
                        # останавливаем полёт и начинаем считать скорость
                        # с нуля.
                        plugin._stop_throw(instance)
                        self.vel_last_time = event.getEventTime()
                        self.vel_last_x = event.getRawX()
                        self.vel_last_y = event.getRawY()
                        self.vel_x = 0.0
                        self.vel_y = 0.0
                        return True

                    if action == MotionEvent.ACTION_MOVE:
                        if self.top_zone:
                            # Верхняя зона: перетаскивание тут не работает,
                            # только жест "погладить" — несколько разворотов
                            # пальца влево-вправо подряд. Обычный тап без
                            # разворотов обрабатывается в ACTION_UP как мяу.
                            # pet_triggered здесь НЕ блокирует повторные
                            # срабатывания — палец продолжает гладить, и
                            # гифка должна запускаться заново на каждый новый
                            # набор разворотов; флаг используется только в
                            # ACTION_UP, чтобы не засчитать этот же жест ещё
                            # и как обычный тап.

                            vertical_drift = abs(event.getRawY() - self.start_y)
                            if vertical_drift > pet_max_vertical_drift_px:
                                # Слишком "гуляет" по Y — не похоже на
                                # поглаживание, разворот не засчитываем.
                                return True

                            step_dx = event.getRawX() - self.pet_last_x
                            if abs(step_dx) >= pet_min_step_px:
                                direction = 1 if step_dx > 0 else -1
                                if self.pet_last_direction != 0 and direction != self.pet_last_direction:
                                    self.pet_direction_changes += 1
                                self.pet_last_direction = direction
                                self.pet_last_x = event.getRawX()

                                if self.pet_direction_changes >= PET_DIRECTION_CHANGES_THRESHOLD:
                                    self.pet_triggered = True
                                    # Сбрасываем счётчик разворотов — так
                                    # следующая порция разворотов (пока
                                    # палец продолжает гладить) сможет снова
                                    # набрать порог и запустить гифку заново.
                                    self.pet_direction_changes = 0
                                    plugin._on_boykisser_pet(instance, v)
                            return True

                        now = event.getEventTime()
                        dt_ms = now - self.vel_last_time
                        if dt_ms > 0:
                            raw_x = event.getRawX()
                            raw_y = event.getRawY()
                            dt_s = dt_ms / 1000.0
                            inst_vx = (raw_x - self.vel_last_x) / dt_s
                            inst_vy = (raw_y - self.vel_last_y) / dt_s
                            # Экспоненциальное сглаживание — иначе дрожание
                            # пальца между двумя move-событиями давало бы
                            # случайные выбросы скорости.
                            s = THROW_VELOCITY_SMOOTHING
                            self.vel_x = self.vel_x * (1 - s) + inst_vx * s
                            self.vel_y = self.vel_y * (1 - s) + inst_vy * s
                            self.vel_last_time = now
                            self.vel_last_x = raw_x
                            self.vel_last_y = raw_y

                        dx = event.getRawX() - self.start_x
                        dy = event.getRawY() - self.start_y

                        if (
                            plugin.get_setting("dragging_enabled", True)
                            and not self.dragging
                            and (abs(dx) > drag_slop_px or abs(dy) > drag_slop_px)
                        ):
                            self.dragging = True

                        if self.dragging:
                            new_right = int(self.start_right - dx)
                            new_bottom = int(self.start_bottom - dy)

                            max_right = max(0, root.getWidth() - v.getWidth())
                            max_bottom = max(0, root.getHeight() - v.getHeight())

                            new_right = min(max(new_right, 0), max_right)
                            new_bottom = min(max(new_bottom, 0), max_bottom)

                            params.rightMargin = new_right
                            params.bottomMargin = new_bottom
                            image_view.setLayoutParams(params)

                            pet_view = instance.pet_view
                            if pet_view is not None:
                                pet_view_params = pet_view.getLayoutParams()
                                pet_view_params.rightMargin = new_right
                                pet_view_params.bottomMargin = new_bottom + pet_vertical_offset_px
                                pet_view.setLayoutParams(pet_view_params)
                        return True

                    if action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        if self.top_zone:
                            if self.pet_triggered:
                                # Палец отпущен (или жест отменён) —
                                # прячем гифку глажения сразу, не дожидаясь
                                # её собственного таймера.
                                plugin._hide_pet_overlay_now(instance)
                            elif action == MotionEvent.ACTION_UP:
                                # Свайпа влево-вправо не было — обычный тап
                                # по верхней зоне работает как тап (мяу),
                                # так же, как и в нижней зоне.
                                plugin._on_boykisser_tap(instance, v)
                        elif self.dragging:
                            plugin.set_setting(f"pos_right_dp{suffix}", params.rightMargin / density)
                            plugin.set_setting(f"pos_bottom_dp{suffix}", params.bottomMargin / density)
                            speed_dp = (self.vel_x * self.vel_x + self.vel_y * self.vel_y) ** 0.5 / density
                            if (
                                action == MotionEvent.ACTION_UP
                                and plugin.get_setting("throw_enabled", True)
                                and speed_dp >= THROW_MIN_VELOCITY_DP
                            ):
                                # Кинули с достаточной скоростью (и инерция
                                # включена в настройках) — летит дальше сам
                                # и постепенно тормозит.
                                plugin._start_throw(instance, self.vel_x, self.vel_y, density)
                        else:
                            plugin._on_boykisser_tap(instance, v)
                        return True

                    return False

            # Отдельная вью для гифки поглаживания — рисуется поверх
            # boykisser-а и по умолчанию скрыта (см. _show_pet_overlay).
            pet_gif_path = os.path.join(_data_dir(), PET_GIF_FILENAME)
            instance.pet_gif_path = pet_gif_path

            pet_view = ImageView(activity)
            pet_view.setScaleType(ImageView.ScaleType.FIT_XY)
            pet_params = FrameLayout.LayoutParams(width_px, height_px)
            pet_params.gravity = Gravity.BOTTOM | Gravity.RIGHT
            pet_params.rightMargin = right_margin_px
            pet_params.bottomMargin = bottom_margin_px + pet_vertical_offset_px
            pet_view.setLayoutParams(pet_params)
            pet_view.setAlpha(alpha_percent / 100.0)
            # Гифка руки — декоративный слой поверх boykisser-а: у неё те же
            # width/height/margins, что и у основной вью (см. выше), поэтому
            # она физически не может вылезти за пределы кота. Некликабельна/
            # нефокусируема, чтобы не ловить ripple и системный фокус, но на
            # неё вешается тот же обработчик жестов, что и на boykisser-а —
            # так свайп "погладить" продолжает работать, даже когда палец
            # оказывается поверх самой гифки руки, а не под ней.
            pet_view.setClickable(False)
            pet_view.setLongClickable(False)
            pet_view.setFocusable(False)
            pet_view.setVisibility(View.GONE)
            pet_view.setTag(f"{PET_OVERLAY_VIEW_TAG}{suffix}")

            touch_listener = DragTouchListener()
            image_view.setOnTouchListener(touch_listener)
            pet_view.setOnTouchListener(touch_listener)

            root.addView(image_view)
            root.addView(pet_view)  # добавлена позже image_view -> отрисовывается поверх неё
            instance.overlay_view = image_view
            instance.pet_view = pet_view
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось добавить вью (Boykisser {instance.index + 1}) — {e}")

    def _purge_stale_overlays(self, root):
        """Убирает из дерева вью ЛЮБЫЕ уже висящие бойкиссер-оверлеи —
        находит их по тегу (OVERLAY_VIEW_TAG/PET_OVERLAY_VIEW_TAG + суффикс
        индекса), а не по внутренним Python-ссылкам self._instances.

        Это отдельная защита от главного источника бага "спавнится 2+
        бойкиссера": если по какой-то причине (перезагрузка/обновление
        плагина, hot-reload, гонка хуков onCreate/onResume и т.п.) когда-то
        создаётся новый экземпляр этого класса, у него в __init__ список
        self._instances пуст — он ничего не знает о вью, которые реально
        добавил в decor старый экземпляр, и те вью просто остаются висеть
        в интерфейсе как "сироты". self._remove_overlay_view() такие вью не
        находит, потому что они вообще не хранятся в состоянии текущего
        экземпляра. Поэтому перед добавлением новых вью явно сканируем
        прямых детей root и вычищаем всё, что помечено нашими тегами
        (с любым суффиксом), кем бы оно ни было добавлено.
        """
        try:
            for i in range(root.getChildCount() - 1, -1, -1):
                child = root.getChildAt(i)
                tag = child.getTag()
                if tag is None:
                    continue
                tag_str = str(tag)
                if tag_str.startswith(OVERLAY_VIEW_TAG) or tag_str.startswith(PET_OVERLAY_VIEW_TAG):
                    root.removeViewAt(i)
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось зачистить старые вью — {e}")

    def _remove_overlay_view(self):
        """Убирает вью ВСЕХ boykisser-ов из иерархии и освобождает их
        звуковые плееры.

        ВАЖНО (главная причина бага с "2 бойкиссерами" в исходной версии):
        этот метод вызывается не только из UI-потока (например, из
        _attach_overlay), но и из on_plugin_unload — а его, как показывают
        логи, движок exteragram (PythonPluginsEngine.setPluginEnabled) может
        дёрнуть с фонового DispatchQueue-потока, а не с UI-потока. Прямой
        вызов ViewGroup.removeView() в этом случае падал с "Only the
        original thread that created a view hierarchy can touch its views"
        — removeView не успевал выполниться, старая вью так и оставалась
        висеть в дереве (с тегом, но "осиротевшая"), и после следующей
        перезагрузки плагина рядом с ней добавлялась ещё одна.
        _purge_stale_overlays подчищает такие "сироты" по тегу, но
        полагаться только на неё как на единственную линию обороны не
        стоит — правильнее вообще не допускать падения самого removeView.

        Поэтому здесь python-ссылки (self._instances и поля каждого
        instance) обнуляются сразу и синхронно — независимо от потока
        вызова, — а реальное обращение к вью (getParent()/removeView())
        всегда выполняется на UI-потоке через run_on_ui_thread, откуда бы
        этот метод ни вызвали.
        """
        instances = self._instances
        self._instances = []
        if not instances:
            return

        views_to_remove = []
        for instance in instances:
            if instance.pet_view is not None:
                views_to_remove.append(instance.pet_view)
            if instance.overlay_view is not None:
                views_to_remove.append(instance.overlay_view)

            instance.pet_view = None
            instance.pet_drawable = None
            instance.pet_gif_path = None
            instance.is_petting = False

            instance.overlay_view = None
            instance.drawable = None
            instance.gif_path = None
            instance.pet_main_active = False
            instance.is_sleeping = False

            if instance.media_player is not None:
                try:
                    instance.media_player.release()
                except Exception:
                    pass
                instance.media_player = None

            if instance.purr_media_player is not None:
                try:
                    instance.purr_media_player.release()
                except Exception:
                    pass
                instance.purr_media_player = None
                instance.is_purring = False

        if not views_to_remove:
            return

        def _detach():
            from android.view import ViewGroup
            from java import cast

            for view in views_to_remove:
                try:
                    parent = view.getParent()
                    if parent is not None:
                        cast(ViewGroup, parent).removeView(view)
                except Exception as e:
                    self.log(f"Boykisser Corner: ошибка при удалении вью — {e}")

        run_on_ui_thread(_detach)

    # ------------------------------------------------------------------ #
    # Бросок с инерцией: отпустили после быстрого перетаскивания —
    # бойкиссер летит дальше сам и тормозит, отскакивая от краёв экрана.
    # ------------------------------------------------------------------ #

    def _stop_throw(self, instance: "_BoykisserInstance"):
        """Останавливает текущий полёт (если он идёт), инвалидируя токен —
        уже запланированный через run_on_ui_thread кадр _run_throw_frame
        увидит несовпадение токена и молча завершится, ничего не трогая."""
        instance.throw_token += 1
        instance.is_throwing = False
        self._stop_jelly_bounce(instance)

    def _start_throw(self, instance: "_BoykisserInstance", vx_px_s: float, vy_px_s: float, density: float):
        """Запускает бросок. vx_px_s/vy_px_s — скорость пальца в момент
        отпускания, в пикселях/с, в системе координат экрана (тот же знак,
        что и getRawX/getRawY, использованные при перетаскивании)."""
        view = instance.overlay_view
        if view is None:
            return
        try:
            from android.view import ViewGroup
            from java import cast

            root = cast(ViewGroup, view.getParent())
        except Exception:
            root = None
        if root is None:
            return

        max_speed = THROW_MAX_VELOCITY_DP * density
        speed = (vx_px_s * vx_px_s + vy_px_s * vy_px_s) ** 0.5
        if speed > max_speed and speed > 0:
            scale = max_speed / speed
            vx_px_s *= scale
            vy_px_s *= scale

        instance.throw_token += 1
        token = instance.throw_token
        instance.is_throwing = True
        params = view.getLayoutParams()
        self._run_throw_frame(instance, token, view, params, root, vx_px_s, vy_px_s, density)

    def _run_throw_frame(self, instance: "_BoykisserInstance", token, view, params, root, vx, vy, density):
        if self._destroyed or token != instance.throw_token:
            return
        if view.getParent() is None:
            instance.is_throwing = False
            return

        dt = THROW_FRAME_MS / 1000.0

        new_right = params.rightMargin - vx * dt
        new_bottom = params.bottomMargin - vy * dt

        max_right = max(0, root.getWidth() - view.getWidth())
        max_bottom = max(0, root.getHeight() - view.getHeight())

        bounced_x = False
        bounced_y = False

        if new_right < 0:
            new_right = 0
            vx = -vx * THROW_BOUNCE_DAMPING
            bounced_x = True
        elif new_right > max_right:
            new_right = max_right
            vx = -vx * THROW_BOUNCE_DAMPING
            bounced_x = True

        if new_bottom < 0:
            new_bottom = 0
            vy = -vy * THROW_BOUNCE_DAMPING
            bounced_y = True
        elif new_bottom > max_bottom:
            new_bottom = max_bottom
            vy = -vy * THROW_BOUNCE_DAMPING
            bounced_y = True

        params.rightMargin = int(new_right)
        params.bottomMargin = int(new_bottom)

        try:
            view.setLayoutParams(params)
            pet_view = instance.pet_view
            if pet_view is not None:
                pet_params = pet_view.getLayoutParams()
                pet_params.rightMargin = params.rightMargin
                pet_params.bottomMargin = params.bottomMargin + int(PET_VERTICAL_OFFSET_DP * density)
                pet_view.setLayoutParams(pet_params)
        except Exception as e:
            self.log(f"Boykisser Corner: ошибка кадра броска — {e}")
            instance.is_throwing = False
            return

        if (bounced_x or bounced_y) and self.get_setting("jelly_bounce_enabled", True):
            axis = "both" if (bounced_x and bounced_y) else ("x" if bounced_x else "y")
            self._trigger_jelly_bounce(instance, view, axis)

        # Экспоненциальное торможение: THROW_RETENTION_PER_SEC — доля
        # скорости, остающаяся через 1 секунду, приведённая к длительности
        # одного кадра.
        friction_factor = THROW_RETENTION_PER_SEC ** dt
        vx *= friction_factor
        vy *= friction_factor

        stop_speed = THROW_STOP_VELOCITY_DP * density
        if (vx * vx + vy * vy) ** 0.5 <= stop_speed:
            instance.is_throwing = False
            self.set_setting(f"pos_right_dp{instance.suffix}", params.rightMargin / density)
            self.set_setting(f"pos_bottom_dp{instance.suffix}", params.bottomMargin / density)
            return

        run_on_ui_thread(
            lambda: self._run_throw_frame(instance, token, view, params, root, vx, vy, density),
            THROW_FRAME_MS,
        )

    # ------------------------------------------------------------------ #
    # "Желейный" отскок: чисто визуальное сплющивание/раздувание вью в
    # момент удара о край экрана и несколько быстрых затухающих колебаний
    # после — картинка "дрожит", как желе. На физику полёта (vx/vy в
    # _run_throw_frame) не влияет, только на scaleX/scaleY вью.
    # ------------------------------------------------------------------ #

    def _trigger_jelly_bounce(self, instance: "_BoykisserInstance", view, axis: str):
        """Запускает (или перезапускает, если отскок случился повторно
        пока колебание ещё не затухло) желейное колебание. axis — "x",
        "y" или "both", в зависимости от того, по какой оси произошёл
        отскок в этом кадре _run_throw_frame."""
        instance.jelly_token += 1
        token = instance.jelly_token
        self._run_jelly_frame(instance, token, view, axis, 0.0)

    def _run_jelly_frame(self, instance: "_BoykisserInstance", token, view, axis: str, elapsed_ms: float):
        if self._destroyed or token != instance.jelly_token:
            return
        if view.getParent() is None:
            return

        if elapsed_ms >= JELLY_BOUNCE_DURATION_MS:
            # Колебание закончилось — возвращаем вью к нормальному
            # размеру точно (не полагаясь на то, что затухание уже
            # сошлось достаточно близко к нулю).
            try:
                view.setScaleX(1.0)
                view.setScaleY(1.0)
            except Exception:
                pass
            return

        t_s = elapsed_ms / 1000.0
        decay = math.exp(-JELLY_BOUNCE_DAMPING_RATE * t_s)
        wobble = math.cos(2 * math.pi * JELLY_BOUNCE_FREQUENCY_HZ * t_s)
        squash = JELLY_BOUNCE_MAX_SQUASH * decay * wobble

        if axis == "x":
            scale_x = 1.0 - squash
            scale_y = 1.0 + squash
        elif axis == "y":
            scale_x = 1.0 + squash
            scale_y = 1.0 - squash
        else:
            # Отскок сразу от двух краёв (угол экрана) — сплющиваем
            # равномерно по обеим осям, без "растягивания" в другую.
            scale_x = 1.0 - squash
            scale_y = 1.0 - squash

        try:
            view.setScaleX(scale_x)
            view.setScaleY(scale_y)
        except Exception as e:
            self.log(f"Boykisser Corner: ошибка желейного отскока — {e}")
            return

        run_on_ui_thread(
            lambda: self._run_jelly_frame(instance, token, view, axis, elapsed_ms + JELLY_BOUNCE_FRAME_MS),
            JELLY_BOUNCE_FRAME_MS,
        )

    def _stop_jelly_bounce(self, instance: "_BoykisserInstance"):
        """Немедленно останавливает желейное колебание (если оно идёт) и
        возвращает вью к нормальному размеру — вызывается, когда
        бойкиссера хватают пальцем посреди отскока (см. _stop_throw)."""
        instance.jelly_token += 1
        view = instance.overlay_view
        if view is None:
            return
        try:
            view.setScaleX(1.0)
            view.setScaleY(1.0)
        except Exception:
            pass

    # ------------------------------------------------------------------ #
    # Тап -> мяу + маленькая анимация
    # ------------------------------------------------------------------ #

    def _on_boykisser_tap(self, instance: "_BoykisserInstance", view, from_petting=False):
        # Если в этот момент сама по себе крутится случайная гифка "просто
        # так" — прерываем её немедленно. Раньше case проигрывания
        # случайной гифки помечался тем же флагом is_animating, что и
        # реакция на тап/глажку, из-за чего тап/глажка во время неё просто
        # молча игнорировались. Теперь это два разных состояния: тап/глажка
        # всегда обрабатываются как обычно, даже если в этот момент шла
        # случайная гифка (см. _interrupt_idle_gif).
        self._interrupt_idle_gif(instance)
        if instance.is_animating:
            # Анимация/звук уже идут — просто игнорируем тап, ничего не
            # переигрываем и не ломаем состояние (фикс зависаний при
            # быстрых повторных нажатиях).
            return
        instance.is_animating = True

        if from_petting:
            # Реакция на глажку — своя, независимая от тумблера "Реакция
            # по тапу": у неё отдельный тумблер уведомления
            # (pet_notification_enabled). Мяу во время глажки НЕ играет —
            # вместо него уже запущено зацикленное мурчание (см.
            # _play_purr в _on_boykisser_pet).
            reaction_allowed = True
            notification_allowed = self.get_setting("pet_notification_enabled", True)
        else:
            # Обычный тап: мастер-тумблер "tap_enabled" выключает разом
            # анимацию, звук и уведомление. tap_notification_enabled
            # управляет только уведомлением (и то лишь пока tap_enabled
            # включён) и на звук не влияет.
            reaction_allowed = self.get_setting("tap_enabled", True)
            notification_allowed = reaction_allowed and self.get_setting("tap_notification_enabled", True)

        if notification_allowed:
            # Во время глажки boykisser мурчит, а не мяукает — текст
            # уведомления должен соответствовать (см. from_petting выше).
            bulletin_text = "Purr..!" if from_petting else "Meow..!"
            run_on_ui_thread(
                lambda: BulletinHelper.show_success(bulletin_text, get_last_fragment()),
                BULLETIN_DELAY_MS,
            )

        meow_ms = 0
        anim_ms = 0
        if reaction_allowed:
            if from_petting:
                # Пока гладят, звук уже обеспечивает зацикленное мурчание
                # (_play_purr), а картинка boykisser-а подменена и
                # зациклена через _show_pet_main_gif — не запускаем поверх
                # них обычное мяу и "тап"-анимацию классической гифки,
                # иначе _stop_animation() через ANIM_DURATION_MS сбросит
                # вью обратно на классику прямо посреди глажки.
                pass
            else:
                meow_ms = self._play_meow(instance)
                self._play_animation(instance)
                anim_ms = ANIM_DURATION_MS

        busy_ms = max(anim_ms, meow_ms or 0)
        run_on_ui_thread(lambda: self._clear_busy(instance), busy_ms)

    def _clear_busy(self, instance: "_BoykisserInstance"):
        instance.is_animating = False

    # ------------------------------------------------------------------ #
    # Гладение -> гифка поверх boykisser-а + он сам мяукает и анимируется
    # ------------------------------------------------------------------ #

    def _on_boykisser_pet(self, instance: "_BoykisserInstance", view):
        # См. комментарий в _on_boykisser_tap — прерываем случайную гифку
        # сразу, до того как _show_pet_main_gif/_show_pet_overlay начнут
        # менять drawable'ы, чтобы не было "гонки" между устаревшим
        # отложенным _stop_idle_gif и свежим состоянием глажки.
        self._interrupt_idle_gif(instance)
        self._show_pet_overlay(instance)
        # Подменяем ОСНОВНУЮ гифку boykisser-а на "поглаживаемую" версию —
        # гифка руки (см. _show_pet_overlay выше) при этом не трогается,
        # это отдельный слой. Возврат к классической — в _hide_pet_main_gif,
        # вызывается при отпускании пальца (см. _hide_pet_overlay_now).
        self._show_pet_main_gif(instance)
        # Мурчание — крутится по кругу, пока палец гладит, останавливается
        # при отпускании (см. _hide_pet_overlay_now/_stop_purr).
        self._play_purr(instance)
        # Гладение работает как обычный тап (общая блокировка от
        # наложения анимаций), но со своим отдельным тумблером мяу —
        # см. from_petting в _on_boykisser_tap.
        self._on_boykisser_tap(instance, view, from_petting=True)

    def _show_pet_overlay(self, instance: "_BoykisserInstance"):
        if instance.is_petting:
            # Гифка уже показывается и крутится по кругу — не пересоздаём
            # её на каждый повторный "разворот" пальца (раньше это вызывало
            # заметный "скачок"/телепортацию на первый кадр). Она сама
            # доиграет столько, сколько продолжается глажение, и спрячется
            # только когда палец отпустят (см. _hide_pet_overlay_now).
            return
        pet_view = instance.pet_view
        gif_path = instance.pet_gif_path
        if pet_view is None or not gif_path or not os.path.exists(gif_path):
            return
        instance.pet_session_id += 1
        instance.is_petting = True
        try:
            from android.graphics import ImageDecoder
            from android.graphics.drawable import AnimatedImageDrawable
            from android.view import View
            from java.io import File as JFile

            source = ImageDecoder.createSource(JFile(gif_path))
            drawable = ImageDecoder.decodeDrawable(source)
            if isinstance(drawable, AnimatedImageDrawable):
                # Зацикливаем полностью: пока палец продолжает гладить,
                # гифка проигрывается целиком и повторяется снова и снова,
                # а не обрывается по таймеру.
                drawable.setRepeatCount(AnimatedImageDrawable.REPEAT_INFINITE)
            pet_view.setImageDrawable(drawable)
            pet_view.setVisibility(View.VISIBLE)
            drawable.start()
            instance.pet_drawable = drawable
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось показать гифку гладения — {e}")
            instance.is_petting = False

    def _hide_pet_overlay_now(self, instance: "_BoykisserInstance"):
        """Прячет гифку глажения немедленно — при отпускании пальца."""
        instance.pet_session_id += 1
        self._hide_pet_overlay(instance, instance.pet_session_id)
        self._hide_pet_main_gif(instance)
        self._stop_purr(instance)

    def _show_pet_main_gif(self, instance: "_BoykisserInstance"):
        """Подменяет основную гифку boykisser-а на PET_MAIN_GIF_URL и
        зацикливает её, пока продолжается глажка. Гифки руки не касается."""
        if instance.pet_main_active:
            # Уже показывается и крутится по кругу — не пересоздаём на
            # каждый новый триггер, чтобы не было "скачка" на первый кадр
            # (та же логика, что и в _show_pet_overlay для гифки руки).
            return
        view = instance.overlay_view
        gif_path = os.path.join(_data_dir(), PET_MAIN_GIF_FILENAME)
        if view is None or not os.path.exists(gif_path):
            return
        try:
            from android.graphics import ImageDecoder
            from android.graphics.drawable import AnimatedImageDrawable
            from java.io import File as JFile

            source = ImageDecoder.createSource(JFile(gif_path))
            drawable = ImageDecoder.decodeDrawable(source)
            if isinstance(drawable, AnimatedImageDrawable):
                drawable.setRepeatCount(AnimatedImageDrawable.REPEAT_INFINITE)
            view.setImageDrawable(drawable)
            drawable.start()
            instance.drawable = drawable
            instance.pet_main_active = True
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось показать гифку boykisser-а для глажки — {e}")

    def _hide_pet_main_gif(self, instance: "_BoykisserInstance"):
        """Возвращает классическую гифку boykisser-а — при отпускании
        пальца (или если глажку выключили/убрали оверлей)."""
        if not instance.pet_main_active:
            return
        instance.pet_main_active = False
        if instance.drawable is not None:
            try:
                instance.drawable.stop()
            except Exception:
                pass
        # Пересобираем классический drawable с первого кадра — та же
        # техника, что и в _reset_drawable_to_first_frame после обычного
        # тапа, чтобы не унаследовать случайный кадр гифки глажки.
        self._reset_drawable_to_first_frame(instance)

    def _hide_pet_overlay(self, instance: "_BoykisserInstance", session_id):
        if session_id != instance.pet_session_id:
            return
        pet_view = instance.pet_view
        try:
            if pet_view is not None:
                from android.view import View
                pet_view.setVisibility(View.GONE)
            if instance.pet_drawable is not None:
                try:
                    instance.pet_drawable.stop()
                except Exception:
                    pass
                instance.pet_drawable = None
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось скрыть гифку гладения — {e}")
        finally:
            instance.is_petting = False

    def _play_animation(self, instance: "_BoykisserInstance"):
        drawable = instance.drawable
        if drawable is None:
            return
        try:
            drawable.start()  # AnimatedImageDrawable.start()
            run_on_ui_thread(lambda: self._stop_animation(instance, drawable), ANIM_DURATION_MS)
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось запустить анимацию — {e}")

    def _stop_animation(self, instance: "_BoykisserInstance", drawable):
        try:
            drawable.stop()  # AnimatedImageDrawable.stop()
        except Exception:
            pass
        # Баг: stop() останавливает гифку на том кадре, на котором она
        # оказалась в момент остановки (а не на первом), и у
        # AnimatedImageDrawable нет публичного API, чтобы перемотать её на
        # начало — из-за этого boykisser иногда "зависал" с открытым ртом
        # до следующего тапа. Чиним это, пересоздавая drawable из файла
        # гифки: новый экземпляр всегда отрисовывается с первого кадра и
        # при этом остаётся в остановленном состоянии (start() мы не
        # вызываем), так что гифка просто "перематывается" на начало и
        # ждёт следующего тапа, не проигрывая его сама.
        self._reset_drawable_to_first_frame(instance)

    def _reset_drawable_to_first_frame(self, instance: "_BoykisserInstance"):
        view = instance.overlay_view
        gif_path = instance.gif_path
        if view is None or not gif_path or not os.path.exists(gif_path):
            return
        try:
            from android.graphics import ImageDecoder
            from java.io import File as JFile

            source = ImageDecoder.createSource(JFile(gif_path))
            fresh_drawable = ImageDecoder.decodeDrawable(source)
            view.setImageDrawable(fresh_drawable)
            instance.drawable = fresh_drawable
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось сбросить гифку на первый кадр — {e}")

    # ------------------------------------------------------------------ #
    # "Иногда" -> случайная гифка сама по себе, без участия пользователя
    # ------------------------------------------------------------------ #

    def _get_idle_interval_ms(self, preset_key, presets_sec):
        """Читает выбранный пользователем пресет скорости из настроек
        (индекс в presets_sec), зажимает его в допустимый диапазон списка
        пресетов и возвращает (мин, макс) в миллисекундах. При некорректном
        значении (не число и т.п.) откатывается на пресет по умолчанию."""
        try:
            preset_index = int(
                str(self.get_setting(preset_key, IDLE_SPEED_PRESET_DEFAULT_INDEX)).strip()
            )
        except (TypeError, ValueError):
            preset_index = IDLE_SPEED_PRESET_DEFAULT_INDEX

        preset_index = max(0, min(preset_index, len(presets_sec) - 1))
        min_sec, max_sec = presets_sec[preset_index]
        return min_sec * 1000, max_sec * 1000

    def _schedule_idle_gif(self, instance: "_BoykisserInstance"):
        if self._destroyed or instance not in self._instances:
            return
        min_ms, max_ms = self._get_idle_interval_ms(
            "idle_gif_preset", IDLE_GIF_INTERVAL_PRESETS_SEC,
        )
        delay_ms = random.randint(min_ms, max_ms)
        run_on_ui_thread(lambda: self._idle_gif_tick(instance), delay_ms)

    def _idle_gif_tick(self, instance: "_BoykisserInstance"):
        if self._destroyed or instance not in self._instances:
            return
        try:
            if (
                self.get_setting("enabled", True)
                and self.get_setting("idle_gif_enabled", True)
                and self._is_foreground
                and instance.overlay_view is not None
                and not instance.is_petting
                and not instance.pet_main_active
                and not instance.is_animating
                and not instance.is_idle_playing
                and not instance.is_sleeping
            ):
                self._play_random_idle_gif(instance)
        finally:
            # Планируем следующее срабатывание в любом случае — даже если
            # это сработало впустую (плагин выключен, идёт глажка и т.п.).
            self._schedule_idle_gif(instance)

    def _play_random_idle_gif(self, instance: "_BoykisserInstance"):
        view = instance.overlay_view
        if view is None:
            return
        index = random.randrange(len(IDLE_RANDOM_GIF_URLS))
        gif_path = os.path.join(_data_dir(), IDLE_RANDOM_GIF_FILENAME_TEMPLATE.format(index=index))
        if not os.path.exists(gif_path):
            return
        instance.is_idle_playing = True
        instance.idle_gif_token += 1
        token = instance.idle_gif_token
        try:
            from android.graphics import ImageDecoder
            from java.io import File as JFile

            source = ImageDecoder.createSource(JFile(gif_path))
            drawable = ImageDecoder.decodeDrawable(source)
            view.setImageDrawable(drawable)
            drawable.start()
            instance.drawable = drawable
            # Храним отдельно от instance.drawable: если тап/глажка случатся
            # раньше её собственного таймера, instance.drawable подменится
            # на что-то другое, а отложенный _stop_idle_gif ниже должен
            # трогать именно ЭТОТ drawable (или не трогать вовсе, если
            # token уже устарел — см. _interrupt_idle_gif).
            instance.idle_drawable = drawable
            # Раньше здесь безусловно вызывался _play_meow() — гифка
            # всегда тянула за собой звук. Это противоречило исходной идее
            # (см. комментарий у IDLE_RANDOM_GIF_MIN/MAX_INTERVAL_MS выше):
            # гифка и мяу "просто так" должны быть НЕЗАВИСИМЫМИ событиями,
            # каждое со своим случайным интервалом (_schedule_idle_gif /
            # _schedule_idle_meow). Убрано, чтобы звук не запускался
            # каждый раз одновременно с показом случайной гифки.
            run_on_ui_thread(lambda: self._stop_idle_gif(instance, token), IDLE_RANDOM_GIF_DURATION_MS)
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось проиграть случайную гифку — {e}")
            instance.is_idle_playing = False

    def _stop_idle_gif(self, instance: "_BoykisserInstance", token):
        if token != instance.idle_gif_token:
            # Устарело: этот показ уже был прерван тапом/глажкой
            # (_interrupt_idle_gif) или сменился новым показом — состояние
            # уже принадлежит кому-то другому, трогать нельзя.
            return
        instance.is_idle_playing = False
        drawable = instance.idle_drawable
        instance.idle_drawable = None
        try:
            if drawable is not None:
                drawable.stop()
        except Exception:
            pass
        if instance.pet_main_active:
            # На всякий случай: если глажка успела начаться без прохода
            # через _interrupt_idle_gif — не трогаем текущую основную вью.
            return
        self._reset_drawable_to_first_frame(instance)

    def _interrupt_idle_gif(self, instance: "_BoykisserInstance"):
        """Прерывает случайную гифку "просто так", если она в этот момент
        играет — вызывается из _on_boykisser_tap/_on_boykisser_pet, чтобы
        реальный тап или жест глажки пользователя обрабатывался как обычно,
        не дожидаясь окончания случайной гифки."""
        if not instance.is_idle_playing:
            return
        instance.is_idle_playing = False
        # Инвалидируем токен — отложенный _stop_idle_gif от этого показа
        # теперь распознает себя как устаревший и ничего не тронет, даже
        # если к тому моменту instance.drawable уже указывает на что-то,
        # запущенное тапом или глажкой поверх.
        instance.idle_gif_token += 1
        drawable = instance.idle_drawable
        instance.idle_drawable = None
        if drawable is not None:
            try:
                drawable.stop()
            except Exception:
                pass
        if not instance.pet_main_active:
            # Возвращаем классическую гифку на первый кадр — дальше либо
            # обычный тап запустит на ней анимацию (_play_animation), либо
            # глажка тут же подменит её на PET_MAIN_GIF (_show_pet_main_gif).
            self._reset_drawable_to_first_frame(instance)

    # ------------------------------------------------------------------ #
    # "Иногда" -> мяу просто так, без тапа и без гифки
    # ------------------------------------------------------------------ #

    def _schedule_idle_meow(self, instance: "_BoykisserInstance"):
        if self._destroyed or instance not in self._instances:
            return
        min_ms, max_ms = self._get_idle_interval_ms(
            "idle_meow_preset", IDLE_MEOW_INTERVAL_PRESETS_SEC,
        )
        delay_ms = random.randint(min_ms, max_ms)
        run_on_ui_thread(lambda: self._idle_meow_tick(instance), delay_ms)

    def _idle_meow_tick(self, instance: "_BoykisserInstance"):
        if self._destroyed or instance not in self._instances:
            return
        try:
            if (
                self.get_setting("enabled", True)
                and self.get_setting("idle_meow_enabled", True)
                and self._is_foreground
                and instance.overlay_view is not None
                and not instance.is_petting
                and not instance.pet_main_active
                and not instance.is_animating
                and not instance.is_idle_playing
                and not instance.is_sleeping
            ):
                # Мяу "просто так" должно сопровождаться такой же анимацией
                # (открытый рот и т.п.), как и при обычном тапе — раньше
                # тут проигрывался только звук без картинки. is_animating
                # ставим сами, как это делает _on_boykisser_tap, чтобы на
                # это время не могла влезть ни случайная гифка, ни ещё одно
                # срабатывание мяу/тапа поверх.
                instance.is_animating = True
                busy_ms = ANIM_DURATION_MS
                try:
                    meow_ms = self._play_meow(instance)
                    self._play_animation(instance)
                    busy_ms = max(ANIM_DURATION_MS, meow_ms or 0)
                finally:
                    # Гарантированно снимаем busy-флаг, даже если что-то
                    # внутри неожиданно упадёт — иначе он мог бы залипнуть
                    # навсегда и блокировать все дальнейшие срабатывания
                    # (и мяу, и случайную гифку, см. _idle_gif_tick).
                    run_on_ui_thread(lambda: self._clear_busy(instance), busy_ms)
            else:
                self.log(
                    "Boykisser Corner: пропуск случайного мяу — "
                    f"boykisser={instance.index + 1}, "
                    f"enabled={self.get_setting('enabled', True)}, "
                    f"idle_meow_enabled={self.get_setting('idle_meow_enabled', True)}, "
                    f"foreground={self._is_foreground}, "
                    f"overlay={instance.overlay_view is not None}, "
                    f"petting={instance.is_petting}, pet_main={instance.pet_main_active}, "
                    f"animating={instance.is_animating}, idle_gif={instance.is_idle_playing}"
                )
        finally:
            self._schedule_idle_meow(instance)

    # ------------------------------------------------------------------ #
    # Сон -> засыпает при долгом бездействии, просыпается от касания
    # ------------------------------------------------------------------ #

    def _get_sleep_timeout_ms(self) -> int:
        """Читает выбранный пользователем пресет времени бездействия перед
        засыпанием, зажимает индекс в допустимый диапазон и переводит в мс.
        При некорректном значении откатывается на пресет по умолчанию —
        та же схема, что и в _get_idle_interval_ms."""
        try:
            preset_index = int(
                str(
                    self.get_setting("sleep_timeout_preset", IDLE_SPEED_PRESET_DEFAULT_INDEX)
                ).strip()
            )
        except (TypeError, ValueError):
            preset_index = IDLE_SPEED_PRESET_DEFAULT_INDEX

        preset_index = max(0, min(preset_index, len(SLEEP_TIMEOUT_PRESETS_SEC) - 1))
        return SLEEP_TIMEOUT_PRESETS_SEC[preset_index] * 1000

    def _register_interaction(self, instance: "_BoykisserInstance"):
        """Вызывается при любом касании boykisser-а (см. ACTION_DOWN в
        DragTouchListener.onTouch) — сбрасывает таймер бездействия и, если
        он в этот момент спал, будит его. Единая точка входа для тапа,
        глажки и перетаскивания, поскольку все они начинаются с ACTION_DOWN
        на той же вью."""
        instance.last_interaction_ms = self._now_ms()
        if instance.is_sleeping:
            self._wake_up(instance)

    def _schedule_sleep_check(self, instance: "_BoykisserInstance"):
        if self._destroyed or instance not in self._instances:
            return
        run_on_ui_thread(lambda: self._sleep_check_tick(instance), SLEEP_CHECK_INTERVAL_MS)

    def _sleep_check_tick(self, instance: "_BoykisserInstance"):
        if self._destroyed or instance not in self._instances:
            return
        try:
            if (
                self.get_setting("enabled", True)
                and self.get_setting("sleep_enabled", True)
                and self._is_foreground
                and instance.overlay_view is not None
                and not instance.is_sleeping
                and not instance.is_petting
                and not instance.pet_main_active
                and not instance.is_animating
                and not instance.is_idle_playing
                and not instance.is_throwing
            ):
                timeout_ms = self._get_sleep_timeout_ms()
                if self._now_ms() - instance.last_interaction_ms >= timeout_ms:
                    self._fall_asleep(instance)
        finally:
            # Планируем следующую проверку в любом случае — точно так же,
            # как _schedule_idle_gif/_meow переназначают себя после
            # каждого срабатывания.
            self._schedule_sleep_check(instance)

    def _fall_asleep(self, instance: "_BoykisserInstance"):
        """Подменяет основную гифку на спящую (SLEEP_GIF_URL) и зацикливает
        её — тот же приём, что и в _show_pet_main_gif для гифки глажки."""
        if instance.is_sleeping:
            return
        view = instance.overlay_view
        gif_path = os.path.join(_data_dir(), SLEEP_GIF_FILENAME)
        if view is None or not os.path.exists(gif_path):
            return
        try:
            from android.graphics import ImageDecoder
            from android.graphics.drawable import AnimatedImageDrawable
            from java.io import File as JFile

            source = ImageDecoder.createSource(JFile(gif_path))
            drawable = ImageDecoder.decodeDrawable(source)
            view.setImageDrawable(drawable)
            if isinstance(drawable, AnimatedImageDrawable):
                drawable.setRepeatCount(AnimatedImageDrawable.REPEAT_INFINITE)
                drawable.start()
            else:
                # Файл гифки сна распознался как статичная картинка (не
                # AnimatedImageDrawable) — у неё нет .start(), но это не
                # повод падать: просто показываем её статично.
                self.log(
                    "Boykisser Corner: гифка сна не анимированная "
                    f"({type(drawable).__name__}) — показываю статично"
                )
            instance.drawable = drawable
            instance.is_sleeping = True
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось показать гифку сна — {e}")

    def _wake_up(self, instance: "_BoykisserInstance"):
        """Возвращает классическую гифку — вызывается из
        _register_interaction при любом касании спящего boykisser-а."""
        if not instance.is_sleeping:
            return
        instance.is_sleeping = False
        if instance.drawable is not None:
            try:
                instance.drawable.stop()
            except Exception:
                pass
        self._reset_drawable_to_first_frame(instance)

    def _is_media_playing(self) -> bool:
        """True, если прямо сейчас реально играет какое-то медиа Telegram
        (голосовое/кружок/музыка) — тогда мяу проигрывать не должны: оно
        будет мешать и накладываться поверх звука. Используем штатный
        синглтон MediaController — у него есть проигрываемый MessageObject
        (getPlayingMessageObject) и флаг паузы (isMessagePaused); "играет"
        значит объект есть И он не на паузе."""
        try:
            MediaControllerClass = find_class("org.telegram.messenger.MediaController")
            if not MediaControllerClass:
                return False
            media_controller = MediaControllerClass.getInstance()
            if media_controller is None:
                return False
            playing_obj = media_controller.getPlayingMessageObject()
            if playing_obj is None:
                return False
            return not media_controller.isMessagePaused()
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось проверить состояние медиаплеера — {e}")
            return False

    def _play_meow(self, instance: "_BoykisserInstance"):
        """Проигрывает мяу для конкретного boykisser-а. Со случайной
        вероятностью проигрывается либо первая, либо вторая половина
        звукового файла — для вариативности. Возвращает примерную
        длительность проигрывания в мс (или None при ошибке), чтобы
        вызывающий код мог правильно снять флаг busy."""
        if self._is_media_playing():
            # Сейчас играет голосовое/кружок/музыка — не лезем поверх со
            # своим мяу. Не трогаем busy-флаг тут: вызывающий код сам
            # знает, что делать, если meow_ms == None (см. _on_trigger_word,
            # _idle_meow_tick, _on_boykisser_tap).
            self.log("Boykisser Corner: пропуск мяу — сейчас играет медиа")
            return None
        sound_path = os.path.join(_data_dir(), SOUND_FILENAME)
        if not os.path.exists(sound_path):
            self.log("Boykisser Corner: нет файла звука — добавь ссылку в настройках "
                      f"или положи {SOUND_FILENAME} в папку плагина")
            return None

        try:
            from android.media import MediaPlayer

            if instance.media_player is not None:
                try:
                    instance.media_player.release()
                except Exception:
                    pass
                instance.media_player = None

            mp = MediaPlayer()
            mp.setDataSource(sound_path)
            mp.prepare()

            start_pos = SOUND_START_OFFSET_MS
            play_ms = SOUND_DURATION_MS

            try:
                duration_ms = mp.getDuration()
            except Exception:
                duration_ms = 0

            if duration_ms and duration_ms > 0:
                half_ms = duration_ms // 2
                play_second_half = random.random() < 0.5
                if play_second_half:
                    start_pos = half_ms
                    play_ms = max(duration_ms - half_ms, MIN_MEOW_HALF_MS)
                else:
                    start_pos = SOUND_START_OFFSET_MS
                    play_ms = max(half_ms - SOUND_START_OFFSET_MS, MIN_MEOW_HALF_MS)

            try:
                mp.seekTo(start_pos)
            except Exception:
                pass  # если файл короче отступа — просто играем с начала

            mp.start()
            instance.media_player = mp
            run_on_ui_thread(lambda: self._stop_meow(instance, mp), play_ms)
            return play_ms
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось проиграть звук — {e}")
            return None

    def _play_purr(self, instance: "_BoykisserInstance"):
        """Запускает зацикленное мурчание на всё время глажки. Пока
        мурчание уже играет — повторно не запускаем (тот же принцип, что и
        у _show_pet_overlay/_show_pet_main_gif: жест продолжается, звук не
        должен дёргаться/перезапускаться на каждый новый триггер)."""
        if instance.is_purring:
            return
        purr_path = os.path.join(_data_dir(), PURR_SOUND_FILENAME)
        if not os.path.exists(purr_path):
            self.log("Boykisser Corner: нет файла звука мурчания — он ещё не скачался "
                      f"или положи {PURR_SOUND_FILENAME} в папку плагина")
            return

        try:
            from android.media import MediaPlayer

            if instance.purr_media_player is not None:
                try:
                    instance.purr_media_player.release()
                except Exception:
                    pass
                instance.purr_media_player = None

            mp = MediaPlayer()
            mp.setDataSource(purr_path)
            mp.setLooping(True)
            mp.prepare()
            mp.start()
            instance.purr_media_player = mp
            instance.is_purring = True
        except Exception as e:
            self.log(f"Boykisser Corner: не удалось проиграть мурчание — {e}")

    def _stop_purr(self, instance: "_BoykisserInstance"):
        """Останавливает мурчание — при отпускании пальца."""
        if not instance.is_purring:
            return
        instance.is_purring = False
        mp = instance.purr_media_player
        instance.purr_media_player = None
        if mp is None:
            return
        try:
            if mp.isPlaying():
                mp.stop()
            mp.release()
        except Exception:
            pass

    def _stop_meow(self, instance: "_BoykisserInstance", mp):
        try:
            if mp.isPlaying():
                mp.stop()
            mp.release()
        except Exception:
            pass
        if instance.media_player is mp:
            instance.media_player = None
