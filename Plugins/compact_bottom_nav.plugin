__id__ = "compact_bottom_nav"
__name__ = "CompactBottomNav"
__description__ = "Компактная нижняя панель без подписей и с плавающей кнопкой поиска."
__author__ = "@YouRooni"
__version__ = "1.0.0"
__icon__ = "RnDev/18"
__app_version__ = ">=12.6.4"
__sdk_version__ = ">=1.4.3.3"

import base64
import traceback
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader
from ui.settings import Header, Switch, Text

DEX_B64 = """"""

class CompactBottomNavPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.compactbottomnav.CompactBottomNav")
            
            start_method = self.dex_class.getMethod("start")
            start_method.invoke(None)
            
            self.apply_settings()
        except Exception as e:
            self.log(f"Failed to load Java CompactBottomNav module: {e}\n{traceback.format_exc()}")

    def on_plugin_unload(self):
        try:
            if hasattr(self, "dex_class") and self.dex_class is not None:
                stop_method = self.dex_class.getMethod("stop")
                stop_method.invoke(None)
            self.dex_class = None
            self.dex_loader = None
        except Exception as e:
            self.log(f"Failed to unload Java CompactBottomNav module: {e}")

    def apply_settings(self):
        try:
            add_search_button = bool(self.get_setting("add_search_button", True))
            
            if self.dex_class is not None:
                for method in self.dex_class.getMethods():
                    if method.getName() == "updateSettings":
                        method.invoke(None, True, add_search_button)
                        break
        except Exception as e:
            self.log(f"[CompactBottomNav] Apply settings error: {e}\n{traceback.format_exc()}")

    def create_settings(self):
        return [
            Header(text="Настройки нижней панели"),
            Switch(
                key="add_search_button",
                text="Кнопка поиска",
                subtext="Добавить плавающей кнопку поиска рядом с панелью",
                default=True,
                icon="msg_search",
                on_change=lambda val: self.apply_settings()
            )
        ]
