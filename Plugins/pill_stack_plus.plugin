def _argb(hex_color: str) -> int:
    value = int(hex_color.replace("#", ""), 16) | 0xFF000000
    return value - 0x100000000 if value >= 0x80000000 else value


class WidgetDef:
    def __init__(
        self,
        key: str,
        pill_id: int,
        title: str,
        icon_name: str,
        color1: int,
        color2: int,
        compute: Callable[["PillStackPlusPlugin"], Any],
        render: Callable[["PillStackPlusPlugin", Any, Any], None],
        update_interval: int = 15,
        on_click: Optional[Callable[["PillStackPlusPlugin", "WidgetDef", Any], None]] = None,
        extra_settings: Optional[Callable[["PillStackPlusPlugin", "WidgetDef"], List[Any]]] = None,
        extra_menu_actions: Optional[Callable[["PillStackPlusPlugin", "WidgetDef", Any], List[Any]]] = None,
    ):
        self.key = key
        self.pill_id = pill_id
        self.title = title
        self.icon_name = icon_name
        self.color1 = color1
        self.color2 = color2
        self.compute = compute
        self.render = render
        self.update_interval = update_interval
        self.on_click = on_click
        self.extra_settings = extra_settings
        self.extra_menu_actions = extra_menu_actions
        self.icon_res: int = 0

# 1. Скорость сети

def _format_speed(bytes_per_sec: float) -> str:
    if bytes_per_sec < 1024:
        return f"{bytes_per_sec:.0f} B/s"
    kb = bytes_per_sec / 1024
    if kb < 1024:
        return f"{kb:.0f} KB/s"
    return f"{kb / 1024:.1f} MB/s"


def _compute_network_speed(plugin: "PillStackPlusPlugin"):
    rx = TrafficStats.getTotalRxBytes()
    tx = TrafficStats.getTotalTxBytes()
    now = time.time()
    prev = plugin.state.get("network_speed")
    plugin.state["network_speed"] = (rx, tx, now)
    if not prev or rx < 0 or tx < 0:
        return (0, 0)
    prev_rx, prev_tx, prev_time = prev
    dt = max(now - prev_time, 0.001)
    down = max((rx - prev_rx) / dt, 0)
    up = max((tx - prev_tx) / dt, 0)
    return (down, up)


def _render_network_speed(plugin: "PillStackPlusPlugin", pill, data):
    down, up = data
    plugin.set_pill_text(pill, f"↓{_format_speed(down)} ↑{_format_speed(up)}")


# 2. Пинг Telegram

def _get_current_dc_id(plugin: "PillStackPlusPlugin") -> int:
    try:
        UserConfig = find_class("org.telegram.messenger.UserConfig")
        ConnectionsManager = find_class("org.telegram.messenger.ConnectionsManager")
        account = int(UserConfig.selectedAccount)
        cm = ConnectionsManager.getInstance(jint(account))
        dc_id = int(cm.getCurrentDatacenterId())
        if dc_id in TELEGRAM_DC_IPS:
            return dc_id
    except Exception as e:
        plugin.log(f"ошибка определения DC: {e}")
    return 2


def _compute_telegram_ping(plugin: "PillStackPlusPlugin"):
    dc_id = _get_current_dc_id(plugin)
    ip = TELEGRAM_DC_IPS[dc_id]
    start = time.time()
    try:
        with socket.create_connection((ip, TELEGRAM_DC_PORT), timeout=3):
            pass
        ping_ms = int((time.time() - start) * 1000)
    except Exception as e:
        plugin.state["telegram_ping_error"] = str(e)
        return None
    plugin.state["telegram_ping_error"] = None
    return (dc_id, ping_ms)


def _render_telegram_ping(plugin: "PillStackPlusPlugin", pill, data):
    if not data:
        error = plugin.state.get("telegram_ping_error")
        plugin.set_pill_text(pill, f"Ошибка: {error}"[:40] if error else "N/A")
        return
    dc_id, ping_ms = data
    plugin.set_pill_text(pill, f"DC{dc_id}: {ping_ms} ms")


# 3. Температура батареи

def _compute_battery_temp(plugin: "PillStackPlusPlugin"):
    try:
        ctx = plugin.ApplicationLoader.applicationContext
        battery_status = ctx.registerReceiver(None, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
        if not battery_status:
            return None
        temp_tenths = battery_status.getIntExtra("temperature", -1)
        return temp_tenths / 10.0 if temp_tenths >= 0 else None
    except Exception:
        return None


def _render_battery_temp(plugin: "PillStackPlusPlugin", pill, data):
    plugin.set_pill_text(pill, f"{data:.1f}°C" if data is not None else "N/A")


# 4. Загрузка CPU

def _read_cpu_times():
    with open("/proc/stat", "r") as f:
        line = f.readline()
    values = list(map(int, line.split()[1:]))
    idle = values[3] + values[4]
    total = sum(values)
    return total, idle


def _compute_cpu_usage(plugin: "PillStackPlusPlugin"):
    try:
        total, idle = _read_cpu_times()
        prev = plugin.state.get("cpu_usage_proc")
        plugin.state["cpu_usage_proc"] = (total, idle)
        if prev:
            total_delta = total - prev[0]
            idle_delta = idle - prev[1]
            if total_delta > 0:
                return max(0.0, min(100.0, (1 - idle_delta / total_delta) * 100))
    except Exception:
        pass

    try:
        cpu_time = Process.getElapsedCpuTime()
        now_ms = time.time() * 1000
        prev = plugin.state.get("cpu_usage_fallback")
        plugin.state["cpu_usage_fallback"] = (cpu_time, now_ms)
        if prev:
            cpu_delta = cpu_time - prev[0]
            wall_delta = now_ms - prev[1]
            if wall_delta > 0:
                return max(0.0, min(100.0, (cpu_delta / wall_delta) * 100))
    except Exception:
        pass
    return None


def _render_cpu_usage(plugin: "PillStackPlusPlugin", pill, data):
    plugin.set_pill_text(pill, f"{data:.0f}%" if data is not None else "N/A")


# 5. Непрочитанные сообщения

def _compute_unread_count(plugin: "PillStackPlusPlugin"):
    try:
        from client_utils import get_messages_controller
        controller = get_messages_controller()
        dialogs = get_private_field(controller, "allDialogs")
        if not dialogs:
            return None
        total = 0
        for i in range(dialogs.size()):
            dialog = dialogs.get(i)
            if dialog is None:
                continue
            try:
                total += int(controller.getDialogUnreadCount(dialog))
            except Exception:
                total += int(dialog.unread_count)
        return total
    except Exception as e:
        plugin.log(f"ошибка подсчёта непрочитанных: {e}")
        return None


def _render_unread_count(plugin: "PillStackPlusPlugin", pill, data):
    plugin.set_pill_text(pill, str(data) if data is not None else "N/A")


# 6. Размер кэша Telegram

def _dir_size(path: str) -> int:
    total = 0
    for root, _dirs, files in os.walk(path):
        for name in files:
            try:
                total += os.path.getsize(os.path.join(root, name))
            except OSError:
                pass
    return total


def _compute_cache_size(plugin: "PillStackPlusPlugin"):
    try:
        ctx = plugin.ApplicationLoader.applicationContext
        return _dir_size(ctx.getCacheDir().getAbsolutePath()) + _dir_size(ctx.getFilesDir().getAbsolutePath())
    except Exception:
        return None


def _render_cache_size(plugin: "PillStackPlusPlugin", pill, data):
    if data is None:
        plugin.set_pill_text(pill, "N/A")
        return
    mb = data / (1024 * 1024)
    plugin.set_pill_text(pill, f"{mb:.0f} MB" if mb < 1024 else f"{mb / 1024:.2f} GB")


# 7. Счётчик

def _compute_counter(plugin: "PillStackPlusPlugin"):
    return int(plugin.get_setting("counter_value", 0))


def _render_counter(plugin: "PillStackPlusPlugin", pill, data):
    plugin.set_pill_text(pill, f"👆 {data}")


def _on_click_counter(plugin: "PillStackPlusPlugin", widget: "WidgetDef", pill):
    value = int(plugin.get_setting("counter_value", 0)) + 1
    plugin.set_setting("counter_value", value)
    plugin.set_pill_text(pill, f"👆 {value}")


def _counter_extra_settings(plugin: "PillStackPlusPlugin", widget: WidgetDef) -> List[Any]:
    from ui.settings import Text

    def _reset(_view):
        plugin.set_setting("counter_value", 0)
        plugin.force_update_all(widget, manual=True)

    return [Text(text="Сбросить счётчик", icon="msg_delete", on_click=_reset)]


def _counter_menu_actions(plugin: "PillStackPlusPlugin", widget: WidgetDef, pill) -> List[Any]:
    def _reset():
        plugin.set_setting("counter_value", 0)
        plugin.force_update_all(widget, manual=True)

    return [("Сбросить счётчик", "msg_delete", _reset)]


# 8. Аптайм устройства

def _compute_device_uptime(plugin: "PillStackPlusPlugin"):
    return SystemClock.elapsedRealtime() / 1000


def _render_device_uptime(plugin: "PillStackPlusPlugin", pill, data):
    hours = int(data // 3600)
    minutes = int((data % 3600) // 60)
    plugin.set_pill_text(pill, f"{hours}ч {minutes}м")


# 9. IP-адрес локальный/внешний

def _get_local_ip():
    try:
        NetworkInterface = find_class("java.net.NetworkInterface")
        interfaces = NetworkInterface.getNetworkInterfaces()
        while interfaces.hasMoreElements():
            iface = interfaces.nextElement()
            if iface.isLoopback() or not iface.isUp():
                continue
            addresses = iface.getInetAddresses()
            while addresses.hasMoreElements():
                addr = addresses.nextElement()
                ip = addr.getHostAddress()
                if ip and ":" not in ip:
                    return ip
    except Exception:
        pass
    return None


def _get_external_ip():
    try:
        import urllib.request as urllib2
        req = urllib2.Request("https://api.ipify.org", headers={"User-Agent": "Mozilla/5.0"})
        with urllib2.urlopen(req, timeout=4) as resp:
            return resp.read().decode("utf-8").strip()
    except Exception:
        return None


def _compute_ip_address(plugin: "PillStackPlusPlugin"):
    local_ip = _get_local_ip()
    state = plugin.state.setdefault("ip_address", {"external": None, "last_fetch": 0})
    now = time.time()
    if now - state["last_fetch"] > 300:
        state["external"] = _get_external_ip()
        state["last_fetch"] = now
    return (local_ip, state["external"])


def _render_ip_address(plugin: "PillStackPlusPlugin", pill, data):
    local_ip, external_ip = data
    mode = plugin.state.get("ip_display_mode", "local")
    if mode == "external":
        plugin.set_pill_text(pill, f"🌍 {external_ip or '…'}")
    else:
        plugin.set_pill_text(pill, f"🏠 {local_ip or 'N/A'}")


def _on_click_ip(plugin: "PillStackPlusPlugin", widget: "WidgetDef", pill):
    current_mode = plugin.state.get("ip_display_mode", "local")
    new_mode = "external" if current_mode == "local" else "local"
    plugin.state["ip_display_mode"] = new_mode

    cached = plugin.last_data.get(widget.pill_id)
    if cached is not None:
        widget.render(plugin, pill, cached)

    if new_mode == "external":
        state = plugin.state.get("ip_address", {})
        if not state.get("external"):
            plugin.force_update_all(widget, manual=True)


# 10. Статус VPN

def _compute_vpn_status(plugin: "PillStackPlusPlugin"):
    try:
        ctx = plugin.ApplicationLoader.applicationContext
        cm = ctx.getSystemService(Context.CONNECTIVITY_SERVICE)
        network = cm.getActiveNetwork()
        if not network:
            return False
        capabilities = cm.getNetworkCapabilities(network)
        if not capabilities:
            return False
        return bool(capabilities.hasTransport(NetworkCapabilities.TRANSPORT_VPN))
    except Exception:
        return None


def _render_vpn_status(plugin: "PillStackPlusPlugin", pill, data):
    if data is None:
        plugin.set_pill_text(pill, "N/A")
    else:
        plugin.set_pill_text(pill, "VPN: Вкл" if data else "VPN: Выкл")


# 11. Мировые часы

def _compute_world_clock(plugin: "PillStackPlusPlugin"):
    try:
        Calendar = find_class("java.util.Calendar")
        TimeZone = find_class("java.util.TimeZone")
        tz_id = plugin.get_setting("world_clock_tz", "Europe/Moscow")
        tz = TimeZone.getTimeZone(tz_id)
        cal = Calendar.getInstance(tz)
        hour = int(cal.get(Calendar.HOUR_OF_DAY))
        minute = int(cal.get(Calendar.MINUTE))
        return (tz_id, hour, minute)
    except Exception as e:
        plugin.log(f"ошибка мировых часов: {e}")
        return None


def _render_world_clock(plugin: "PillStackPlusPlugin", pill, data):
    if not data:
        plugin.set_pill_text(pill, "N/A")
        return
    tz_id, hour, minute = data
    city = tz_id.split("/")[-1].replace("_", " ")
    plugin.set_pill_text(pill, f"{city} {hour:02d}:{minute:02d}")


WORLD_CLOCK_TIMEZONES = [
    ("Москва", "Europe/Moscow"),
    ("Киев", "Europe/Kyiv"),
    ("Лондон", "Europe/London"),
    ("Берлин", "Europe/Berlin"),
    ("Стамбул", "Europe/Istanbul"),
    ("Дубай", "Asia/Dubai"),
    ("Алматы", "Asia/Almaty"),
    ("Нью-Дели", "Asia/Kolkata"),
    ("Пекин", "Asia/Shanghai"),
    ("Токио", "Asia/Tokyo"),
    ("Сидней", "Australia/Sydney"),
    ("Нью-Йорк", "America/New_York"),
    ("Лос-Анджелес", "America/Los_Angeles"),
]


def _world_clock_default_index(plugin: "PillStackPlusPlugin") -> int:
    current_tz = plugin.get_setting("world_clock_tz", "Europe/Moscow")
    for i, (_label, tz_id) in enumerate(WORLD_CLOCK_TIMEZONES):
        if tz_id == current_tz:
            return i
    return 0


def _on_world_clock_tz_change(plugin: "PillStackPlusPlugin", widget: "WidgetDef", new_index):
    try:
        tz_id = WORLD_CLOCK_TIMEZONES[int(new_index)][1]
    except (IndexError, ValueError):
        return
    plugin.set_setting("world_clock_tz", tz_id)
    plugin.force_update_all(widget, manual=True)


def _world_clock_extra_settings(plugin: "PillStackPlusPlugin", widget: "WidgetDef") -> List[Any]:
    from ui.settings import Selector

    return [
        Selector(
            key="world_clock_tz_index",
            text="Часовой пояс",
            default=_world_clock_default_index(plugin),
            items=[label for label, _tz_id in WORLD_CLOCK_TIMEZONES],
            icon="msg_calendar2",
            on_change=lambda idx, p=plugin, w=widget: _on_world_clock_tz_change(p, w, idx),
        )
    ]


# 12. Версия приложения / номер сборки

def _compute_app_version(plugin: "PillStackPlusPlugin"):
    try:
        ctx = plugin.ApplicationLoader.applicationContext
        pkg = ctx.getPackageName()
        info = ctx.getPackageManager().getPackageInfo(pkg, 0)
        return (str(info.versionName), int(info.versionCode))
    except Exception as e:
        plugin.log(f"ошибка получения версии приложения: {e}")
        return None


def _render_app_version(plugin: "PillStackPlusPlugin", pill, data):
    if not data:
        plugin.set_pill_text(pill, "N/A")
        return
    version_name, version_code = data
    plugin.set_pill_text(pill, f"v{version_name} ({version_code})")


