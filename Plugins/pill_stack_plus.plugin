class PillStackPlusPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.state: Dict[str, Any] = {}
        self.last_data: Dict[int, Any] = {}
        self.widgets_by_id: Dict[int, WidgetDef] = {w.pill_id: w for w in WIDGETS}
        self.active_pills: Dict[int, "weakref.WeakSet"] = {w.pill_id: weakref.WeakSet() for w in WIDGETS}
        self._creating_id: Optional[int] = None
        self._registered_ids: set = set()
        self._tickers: set = set()
        self._creator_refs: List[Any] = []
        self._menu_runnable_refs: List[Any] = []
        self._work_queue: "queue.Queue" = queue.Queue()
        threading.Thread(target=self._worker_loop, daemon=True).start()

        self.AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
        self.PillRegistry = find_class("com.exteragram.messenger.pillstack.core.PillRegistry")
        self.PillInfo = find_class("com.exteragram.messenger.pillstack.core.PillRegistry$PillInfo")
        self.PillCreator = find_class("com.exteragram.messenger.pillstack.core.PillRegistry$PillCreator")
        self.PillStackConfig = find_class("com.exteragram.messenger.pillstack.core.PillStackConfig")
        self.WeatherPill = find_class("com.exteragram.messenger.pillstack.ui.pills.weather.WeatherPill")
        self.ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")

    def on_plugin_load(self):
        if not self.PillRegistry:
            self.log("PillRegistry не найден")
            return
        try:
            self._install_dispatch_hooks()
            for widget in WIDGETS:
                widget.update_interval = int(self.get_setting(f"interval_{widget.key}", widget.update_interval))
                self._register_widget(widget)
                if not self.get_setting(f"activated_once_{widget.key}", False):
                    run_on_ui_thread(lambda w=widget: self._activate_widget(w))
                    self.set_setting(f"activated_once_{widget.key}", True)
        except Exception as e:
            self.log(f"ошибка загрузки Pill Stack Plus: {e}")

    def _register_widget(self, widget: WidgetDef):
        if widget.pill_id in self._registered_ids:
            return
        ctx = self.ApplicationLoader.applicationContext
        res = ctx.getResources()
        pkg = ctx.getPackageName()
        icon_res = res.getIdentifier(widget.icon_name, "drawable", pkg)
        if icon_res == 0:
            icon_res = res.getIdentifier("msg_info", "drawable", pkg)
        if icon_res == 0:
            icon_res = res.getIdentifier("msg_settings", "drawable", pkg)
        widget.icon_res = icon_res
        plugin_ref = self

        class Creator(dynamic_proxy(self.PillCreator)):
            def __init__(self, w: WidgetDef):
                super().__init__()
                self.w = w

            def create(self, context, resources_provider):
                try:
                    plugin_ref._creating_id = self.w.pill_id
                    pill = plugin_ref.WeatherPill(context, resources_provider)
                    plugin_ref._creating_id = None
                    pill.setTag(TAG_KEY, jint(self.w.pill_id))
                    plugin_ref.active_pills[self.w.pill_id].add(pill)
                    plugin_ref.set_pill_appearance(pill, self.w)
                    plugin_ref.set_pill_icon(pill, self.w.icon_res)
                    if self.w.pill_id in plugin_ref.last_data:
                        cached = plugin_ref.last_data[self.w.pill_id]
                        run_on_ui_thread(lambda p=pill, w=self.w, d=cached: w.render(plugin_ref, p, d))
                    plugin_ref.ensure_ticker(self.w)
                    return pill
                except Exception as e:
                    plugin_ref._creating_id = None
                    plugin_ref.log(f"ошибка создания {self.w.key}: {e}")
                    return None

        creator = Creator(widget)
        self._creator_refs.append(creator)
        pill_info = self.PillInfo(
            jint(widget.pill_id), widget.title, jint(icon_res),
            jint(widget.color1), jint(widget.color2), creator,
        )
        self._creator_refs.append(pill_info)
        self.PillRegistry.register(pill_info)
        self._registered_ids.add(widget.pill_id)

    def _activate_widget(self, widget: WidgetDef):
        if not self.PillStackConfig:
            return
        active = self.PillStackConfig.activePills
        already = any(int(active.get(i)) == widget.pill_id for i in range(active.size()))
        if not already:
            active.add(jint(widget.pill_id))
            self.PillStackConfig.savePillsLayout()
            run_on_ui_thread(self.PillStackConfig.notifySettingsChanged)

    def _install_dispatch_hooks(self):
        plugin_ref = self

        def resolve_widget(this_obj) -> Optional[WidgetDef]:
            tag = this_obj.getTag(TAG_KEY)
            if tag is not None:
                return plugin_ref.widgets_by_id.get(int(tag))
            if plugin_ref._creating_id is not None:
                this_obj.setTag(TAG_KEY, jint(plugin_ref._creating_id))
                return plugin_ref.widgets_by_id.get(plugin_ref._creating_id)
            return None

        class GetIdHook(MethodHook):
            def before_hooked_method(self, param):
                widget = resolve_widget(param.thisObject)
                if widget:
                    param.setResult(jint(widget.pill_id))

        class InteractionHook(MethodHook):
            def before_hooked_method(self, param):
                widget = resolve_widget(param.thisObject)
                if not widget:
                    return
                name = param.method.getName()
                if name == "onPillClicked":
                    if widget.on_click:
                        widget.on_click(plugin_ref, widget, param.thisObject)
                    else:
                        plugin_ref.force_update_all(widget, manual=True)
                    param.setResult(None)
                elif name == "onPillLongClicked":
                    plugin_ref.show_pill_menu(param.thisObject, widget)
                    param.setResult(True)
                elif name in ("onUpdateData", "setData"):
                    param.setResult(None)

        self.hook_all_methods(self.WeatherPill, "getPillId", GetIdHook())
        self.hook_all_methods(self.WeatherPill, "onPillClicked", InteractionHook())
        self.hook_all_methods(self.WeatherPill, "onPillLongClicked", InteractionHook())
        self.hook_all_methods(self.WeatherPill, "onUpdateData", InteractionHook())
        self.hook_all_methods(self.WeatherPill, "setData", InteractionHook())

    def ensure_ticker(self, widget: WidgetDef):
        if widget.pill_id in self._tickers:
            return
        self._tickers.add(widget.pill_id)

        def tick():
            self.force_update_all(widget)
            run_on_ui_thread(tick, delay=widget.update_interval * 1000)

        self.force_update_all(widget)
        run_on_ui_thread(tick, delay=widget.update_interval * 1000)

    def _worker_loop(self):
        while True:
            widget = self._work_queue.get()
            self._compute_and_apply(widget)
            self._work_queue.task_done()

    def _compute_and_apply(self, widget: WidgetDef):
        try:
            data = widget.compute(self)
        except Exception as e:
            self.log(f"ошибка вычисления {widget.key}: {e}")
            return
        self.last_data[widget.pill_id] = data

        def apply():
            for pill in list(self.active_pills.get(widget.pill_id, ())):
                self.set_pill_appearance(pill, widget)
                self.set_pill_icon(pill, widget.icon_res)
                widget.render(self, pill, data)

        run_on_ui_thread(apply)

    def force_update_all(self, widget: WidgetDef, manual: bool = False):
        if manual:
            threading.Thread(target=lambda: self._compute_and_apply(widget), daemon=True).start()
        else:
            self._work_queue.put(widget)

    def set_pill_appearance(self, pill, widget: WidgetDef):
        try:
            layout = get_private_field(pill, "layout")
            if layout:
                from android.graphics.drawable import GradientDrawable
                drawable = GradientDrawable(
                    GradientDrawable.Orientation.TL_BR,
                    [jint(widget.color1), jint(widget.color2)],
                )
                drawable.setShape(GradientDrawable.RECTANGLE)
                drawable.setCornerRadius(float(self.AndroidUtilities.dp(100)))
                layout.setBackground(drawable)
            tv = get_private_field(pill, "textView")
            if tv:
                from android.graphics import Color
                tv.setTextColor(Color.WHITE)
        except Exception as e:
            self.log(f"ошибка стилизации пилюли: {e}")

    def set_pill_icon(self, pill, icon_res: int):
        if not icon_res:
            return
        try:
            iv = get_private_field(pill, "iconView")
            if not iv:
                return
            iv.setVisibility(jint(0))
            try:
                iv.setImageResource(jint(icon_res))
            except Exception:
                ctx = self.ApplicationLoader.applicationContext
                drawable = ctx.getResources().getDrawable(jint(icon_res))
                iv.setImageDrawable(drawable)
            from android.graphics import Color, PorterDuff
            iv.setColorFilter(Color.WHITE, PorterDuff.Mode.SRC_IN)
        except Exception as e:
            self.log(f"не удалось установить иконку пилюли: {e}")

    def set_pill_text(self, pill, text: str):
        try:
            pill.stopLoading()
            tv = get_private_field(pill, "textView")
            if tv:
                tv.setText(text)
            iv = get_private_field(pill, "iconView")
            if iv:
                iv.setVisibility(jint(0))
        except Exception as e:
            self.log(f"ошибка отрисовки: {e}")

    def show_pill_menu(self, pill, widget: WidgetDef):
        try:
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            fragment = LaunchActivity.getSafeLastFragment()
            if not fragment:
                return
            ItemOptions = find_class("org.telegram.ui.Components.ItemOptions")
            ctx = self.ApplicationLoader.applicationContext
            res = ctx.getResources()
            pkg = ctx.getPackageName()
            icon_refresh = res.getIdentifier("msg_retry", "drawable", pkg)
            options = ItemOptions.makeOptions(fragment, pill)
            plugin_ref = self

            class RefreshRunnable(dynamic_proxy(find_class("java.lang.Runnable"))):
                def run(self):
                    plugin_ref.force_update_all(widget, manual=True)

            class PluginSettingsRunnable(dynamic_proxy(find_class("java.lang.Runnable"))):
                def run(self):
                    try:
                        from com.exteragram.messenger.plugins import PluginsController
                        PluginSettingsActivity = find_class("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
                        java_plugin = PluginsController.getInstance().plugins.get(plugin_ref.id)
                        if java_plugin:
                            from client_utils import get_last_fragment
                            get_last_fragment().presentFragment(PluginSettingsActivity(java_plugin))
                    except Exception as e:
                        plugin_ref.log(f"ошибка открытия настроек плагина: {e}")

            class PillStackSettingsRunnable(dynamic_proxy(find_class("java.lang.Runnable"))):
                def run(self):
                    try:
                        PillStackPreferencesActivity = find_class(
                            "com.exteragram.messenger.pillstack.ui.PillStackPreferencesActivity"
                        )
                        from client_utils import get_last_fragment
                        get_last_fragment().presentFragment(PillStackPreferencesActivity())
                    except Exception as e:
                        plugin_ref.log(f"ошибка открытия настроек Pill Stack: {e}")

            icon_settings = res.getIdentifier("msg_settings", "drawable", pkg)
            refresh_runnable = RefreshRunnable()
            plugin_settings_runnable = PluginSettingsRunnable()
            pill_stack_settings_runnable = PillStackSettingsRunnable()
            menu_refs = [refresh_runnable, plugin_settings_runnable, pill_stack_settings_runnable]
            options.add(jint(icon_refresh), f"Обновить: {widget.title}", refresh_runnable)

            if widget.extra_menu_actions:
                Runnable = find_class("java.lang.Runnable")
                for label, icon_name, callback in widget.extra_menu_actions(self, widget, pill):
                    icon_extra = res.getIdentifier(icon_name, "drawable", pkg) or icon_refresh

                    class ExtraActionRunnable(dynamic_proxy(Runnable)):
                        def __init__(self, cb):
                            super().__init__()
                            self.cb = cb

                        def run(self):
                            self.cb()

                    extra_runnable = ExtraActionRunnable(callback)
                    menu_refs.append(extra_runnable)
                    options.add(jint(icon_extra), label, extra_runnable)

            options.addGap()
            options.add(jint(icon_settings), "Настройки виджета", plugin_settings_runnable)
            options.add(jint(icon_settings), "Настройки Pill Stack", pill_stack_settings_runnable)
            self._menu_runnable_refs = menu_refs
            options.setDrawScrim(False).setDimAlpha(jint(0)).show()
        except Exception as e:
            self.log(f"ошибка меню: {e}")

    def create_settings(self) -> List[Any]:
        from ui.settings import Divider, Header, Text

        items: List[Any] = [Header(text="Pill Stack Plus")]
        for widget in WIDGETS:
            items.append(
                Text(
                    text=widget.title,
                    icon=widget.icon_name,
                    create_sub_fragment=lambda w=widget: self._widget_settings_page(w),
                )
            )
        items.append(Divider())
        items.append(Header(text="Связь с разработчиком"))
        items.append(
            Text(
                text="Написать @Exorned",
                icon="msg_info",
                on_click=self._contact_dev,
            )
        )
        return items

    def _contact_dev(self, _view):
        try:
            from android.content import Intent
            from android.net import Uri
            intent = Intent(Intent.ACTION_VIEW, Uri.parse("https://t.me/Exorned"))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            self.ApplicationLoader.applicationContext.startActivity(intent)
        except Exception as e:
            self.log(f"ошибка открытия ссылки на разработчика: {e}")

    def _widget_settings_page(self, widget: WidgetDef) -> List[Any]:
        from ui.settings import Header, Input

        items: List[Any] = [
            Header(text=widget.title),
            Input(
                key=f"interval_{widget.key}",
                text="Интервал обновления (сек)",
                default=str(widget.update_interval),
                on_change=lambda v, w=widget: self._on_interval_change(w, v),
            ),
        ]
        if widget.extra_settings:
            items.extend(widget.extra_settings(self, widget))
        return items

    def _on_interval_change(self, widget: WidgetDef, value: str):
        try:
            interval = max(1, int(value))
        except ValueError:
            return
        widget.update_interval = interval
        self.set_setting(f"interval_{widget.key}", interval)