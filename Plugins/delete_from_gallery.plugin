__id__ = "delete_from_gallery"
__name__ = "Delete From Gallery"
__description__ = "Adds a Delete button to the attachment media picker menu.\nPermanently removes selected photos/videos from the device gallery."
__author__ = "@itNotMax - @MaxExteraPlugins"
__version__ = "1.0"
__icon__ = "MaxExteraPluginsStickers/23"
__min_version__ = "12.1.1"
__app_version__ = ">=12.0.1"
__sdk_version__ = ">=1.4.3.3"

from base_plugin import BasePlugin, MethodHook
from android_utils import run_on_ui_thread, OnClickListener


DELETE_ITEM_ID = 101


class DeleteFromGalleryPlugin(BasePlugin):

    def on_plugin_load(self):
        try:
            self._setup_hook()
        except Exception as e:
            self.log(f"[DeleteFromGallery] Hook setup error: {e}")

    def _setup_hook(self):
        from java.lang import Class, Integer as JInt

        clazz = Class.forName("org.telegram.ui.Components.ChatAttachAlertPhotoLayout")

        try:
            method = clazz.getDeclaredMethod("onSelectedItemsCountChanged", JInt.TYPE)
        except Exception:
            method = clazz.getMethod("onSelectedItemsCountChanged", JInt.TYPE)

        method.setAccessible(True)
        plugin_ref = self

        class MenuHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    layout = param.thisObject
                    count = param.args[0]
                    if count <= 0:
                        return

                    pa = layout.parentAlert
                    if pa is None:
                        return

                    menu = pa.selectedMenuItem
                    if menu is None:
                        return

                    try:
                        popup = menu.getPopupLayout()
                        if popup is not None:
                            ll = popup.linearLayout
                            if ll is not None:
                                for i in range(ll.getChildCount()):
                                    try:
                                        tag = ll.getChildAt(i).getTag()
                                        if tag is not None and int(tag) == DELETE_ITEM_ID:
                                            return
                                    except:
                                        pass
                    except:
                        pass

                    from org.telegram.messenger import R as R_tg
                    sub = menu.addSubItem(DELETE_ITEM_ID, R_tg.drawable.msg_delete, "Delete from device")
                    sub.setOnClickListener(OnClickListener(
                        lambda v, lo=layout, p=pa: plugin_ref._on_delete(lo, p)
                    ))
                except Exception as e:
                    plugin_ref.log(f"[DeleteFromGallery] Menu hook error: {e}")

        self.hook_method(method, MenuHook())

    def _on_delete(self, layout, parent_alert):
        try:
            self._perform_delete(layout, parent_alert)
        except Exception as e:
            self.log(f"[DeleteFromGallery] Delete error: {e}")

    def _perform_delete(self, layout, parent_alert):
        from org.telegram.ui.Components import ChatAttachAlertPhotoLayout
        from org.telegram.messenger import ApplicationLoader, MediaController
        from android.provider import MediaStore
        from android.content import ContentUris
        from android.os import Build
        from java.util import ArrayList as JArrayList
        from ui.bulletin import BulletinHelper

        menu = parent_alert.selectedMenuItem
        if menu is not None:
            try:
                menu.closeSubMenu()
            except:
                pass

        sel_photos = ChatAttachAlertPhotoLayout.selectedPhotos
        sel_order = ChatAttachAlertPhotoLayout.selectedPhotosOrder

        if sel_photos is None or sel_photos.isEmpty():
            BulletinHelper.show_error("No media selected")
            return

        entries = []
        it = sel_photos.values().iterator()
        while it.hasNext():
            entries.append(it.next())

        ctx = ApplicationLoader.applicationContext
        resolver = ctx.getContentResolver()
        sdk = Build.VERSION.SDK_INT

        uris = JArrayList()
        valid = []

        for entry in entries:
            try:
                img_id = int(entry.imageId)
                if img_id <= 0:
                    continue
                base = MediaStore.Video.Media.EXTERNAL_CONTENT_URI if entry.isVideo else MediaStore.Images.Media.EXTERNAL_CONTENT_URI
                uris.add(ContentUris.withAppendedId(base, img_id))
                valid.append(entry)
            except Exception as e:
                self.log(f"[DeleteFromGallery] URI build error: {e}")

        if uris.isEmpty():
            BulletinHelper.show_error("No valid media to delete")
            return

        self._clear_selection(layout, parent_alert, valid)

        if sdk >= 30:
            try:
                pi = MediaStore.createDeleteRequest(resolver, uris)
                activity = None
                try:
                    activity = parent_alert.baseFragment.getParentActivity()
                except:
                    pass
                if activity is None:
                    try:
                        activity = parent_alert.getOwnerActivity()
                    except:
                        pass
                if activity is not None:
                    activity.startIntentSenderForResult(pi.getIntentSender(), 110, None, 0, 0, 0)
                    BulletinHelper.show_info("Confirm deletion in system dialog")
                else:
                    BulletinHelper.show_error("Cannot get activity context")
            except Exception as e:
                self.log(f"[DeleteFromGallery] createDeleteRequest error: {e}")
                BulletinHelper.show_error("Failed to request deletion")
        else:
            deleted = 0
            for i in range(uris.size()):
                try:
                    if resolver.delete(uris.get(i), None, None) > 0:
                        deleted += 1
                except Exception as e:
                    self.log(f"[DeleteFromGallery] ContentResolver.delete error: {e}")

            if deleted < len(valid):
                for entry in valid:
                    try:
                        path = str(entry.path) if entry.path is not None else None
                        if path is None:
                            continue
                        from java.io import File as JFile
                        f = JFile(path)
                        if f.exists() and f.delete():
                            deleted += 1
                    except:
                        pass

            if deleted > 0:
                BulletinHelper.show_success(f"Deleted {deleted} file(s)")
            else:
                BulletinHelper.show_error("Could not delete files")

    def _clear_selection(self, layout, parent_alert, entries):
        from org.telegram.ui.Components import ChatAttachAlertPhotoLayout
        from org.telegram.messenger import MediaController

        def do_clear():
            try:
                ChatAttachAlertPhotoLayout.selectedPhotos.clear()
                ChatAttachAlertPhotoLayout.selectedPhotosOrder.clear()

                try:
                    album = layout.JA.selectedAlbumEntry
                    if album is not None and album.photos is not None:
                        for e in entries:
                            try:
                                album.photos.remove(e)
                            except:
                                pass
                except:
                    pass

                try:
                    all_media = MediaController.allMediaAlbumEntry
                    if all_media is not None and all_media.photos is not None:
                        for e in entries:
                            try:
                                all_media.photos.remove(e)
                            except:
                                pass
                except:
                    pass

                try:
                    all_photos = MediaController.allPhotosAlbumEntry
                    if all_photos is not None and all_photos.photos is not None:
                        for e in entries:
                            try:
                                all_photos.photos.remove(e)
                            except:
                                pass
                except:
                    pass

                try:
                    adapter = layout.JA.adapter
                    if adapter is not None:
                        adapter.notifyDataSetChanged()
                except:
                    pass

                try:
                    parent_alert.updateCountButton(2)
                except:
                    pass

            except Exception as e:
                self.log(f"[DeleteFromGallery] Clear selection error: {e}")

        run_on_ui_thread(do_clear)
