def get_language():
    try:
        return "ru" if Locale.getDefault().getLanguage() == "ru" else "en"
    except Exception:
        return "en"

def get_string(key):
    lang = get_language()
    return STRINGS.get(lang, STRINGS["en"]).get(key, STRINGS["en"].get(key, ""))

# === utils\helpers.py ===
def parse_dp_value(value, default=0.0):
    try:
        text = str(value).strip().replace(",", ".")
        if not text:
            return float(default)
        return float(text)
    except Exception:
        return float(default)

def normalize_numeric_text(value, fallback="0"):
    try:
        text = str(value).strip()
        if not text:
            return fallback
        text = text.replace(",", ".")

        if re.fullmatch(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)", text):
            return text
        return None
    except Exception:
        return None

def safe_text(value, fallback="unknown"):
    try:
        text = str(value).strip()
        return text if text else fallback
    except Exception:
        return fallback

def android_sdk_int():
    try:
        Build = find_class("android.os.Build")
        Version = getattr(Build, "VERSION", None)
        return int(getattr(Version, "SDK_INT", 0) or 0)
    except Exception:
        return 0

def is_android_cutout_supported():
    sdk_int = android_sdk_int()
    return sdk_int == 0 or sdk_int >= 28

def show_android_warning_if_needed(plugin):
    if is_android_cutout_supported():
        return
    if bool(plugin.get_setting("_android_unsupported_warning_shown", False)):
        return

    def _do():
        try:
            fragment = get_last_fragment()
            host = fragment.getParentActivity() if fragment else None
            if host is None:
                BulletinHelper.show_info(get_string("android_unsupported_title"))
                return

            dlg = AlertDialogBuilder(host)
            dlg.set_title(get_string("android_unsupported_title"))
            dlg.set_message(get_string("android_unsupported_message"))

            def _ok(bld, which):
                try:
                    bld.dismiss()
                except Exception:
                    pass

            dlg.set_positive_button(get_string("android_unsupported_ok"), _ok)
            dlg.show()
            plugin.set_setting("_android_unsupported_warning_shown", True, reload_settings=False)
        except Exception as e:
            plugin.log(f"Android warning dialog error: {e}")

    run_on_ui_thread(_do)

# === features\export.py ===
def export_notch_config(plugin):
    def _share_file(target_path, context):
        def _do_share():
            try:
                Intent = find_class("android.content.Intent")
                File = find_class("java.io.File")
                Uri = find_class("android.net.Uri")
                LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
                file_obj = File(str(target_path))
                file_uri = Uri.fromFile(file_obj)

                intent = Intent(context, LaunchActivity)
                intent.setAction(Intent.ACTION_SEND)
                intent.setType("application/octet-stream")
                intent.putExtra(Intent.EXTRA_STREAM, file_uri)
                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                context.startActivity(intent)
            except Exception as e:
                plugin.log(f"Share Error: {e}")
                err_msg = f"{get_string('share_fail')}: {e}"
                run_on_ui_thread(lambda: BulletinHelper.show_info(err_msg))

        run_on_ui_thread(_do_share)

    def _do_export():
        try:
            ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")
            context = ApplicationLoader.applicationContext

            mode_id = plugin._get_mode_id()
            payload = {"mode_id": mode_id}
            if mode_id != 0:
                payload.update(
                    {
                        "offset_x": safe_text(plugin.get_setting(CONF_RECT_X, "0"), "0"),
                        "offset_y": safe_text(plugin.get_setting(CONF_RECT_Y, "0"), "0"),
                        "width": safe_text(plugin.get_setting(CONF_RECT_W, "0"), "0"),
                        "height": safe_text(plugin.get_setting(CONF_RECT_H, "0"), "0"),
                    }
                )

            directory_path = str(get_cache_dir())
            os.makedirs(directory_path, exist_ok=True)

            stamp = str(int(time.time()))
            filename = f"notch_{stamp}.notch"
            target_path = os.path.join(directory_path, filename)

            with open(target_path, "w", encoding="utf-8") as f:
                f.write(json.dumps(payload, ensure_ascii=False, indent=2))

            _share_file(target_path, context)
        except Exception as e:
            plugin.log(f"Export Error: {e}")
            err_msg = f"{get_string('export_fail')}: {e}"
            run_on_ui_thread(lambda: BulletinHelper.show_info(err_msg))

    threading.Thread(target=_do_export, daemon=True).start()

# === features\import_notch.py ===
class NotchImportHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            args = param.args
            if args is None or len(args) == 0:
                return

            chat_cell = args[0]
            if chat_cell is None:
                return

            message_object = chat_cell.getMessageObject()
            if message_object is None:
                return

            document = None
            try:
                document = message_object.getDocument()
            except Exception:
                document = None
            if document is None:
                return

            file_name = ""
            try:
                file_name = str(getattr(document, "file_name", "") or "")
            except Exception:
                file_name = ""
            if not file_name:
                try:
                    FileLoader = find_class("org.telegram.messenger.FileLoader")
                    file_name = str(FileLoader.getAttachFileName(document) or "")
                except Exception:
                    file_name = ""

            if not file_name.lower().endswith(".notch"):
                return

            import_notch_from_message(self.plugin, message_object, document)
            param.setResult(None)
        except Exception as e:
            self.plugin.log(f"Notch import hook failed: {e}")

def resolve_message_file_path(plugin, message_object, document):
    FileLoader = find_class("org.telegram.messenger.FileLoader")
    UserConfig = find_class("org.telegram.messenger.UserConfig")

    try:
        account = int(getattr(message_object, "currentAccount", UserConfig.selectedAccount))
    except Exception:
        account = int(UserConfig.selectedAccount)

    loader = FileLoader.getInstance(account)
    path = None

    try:
        path = loader.getPathToMessage(message_object.messageOwner)
        if path is not None and path.exists():
            return str(path.getAbsolutePath())
    except Exception:
        pass

    try:
        path = loader.getPathToAttach(document, True)
        if path is not None and path.exists():
            return str(path.getAbsolutePath())
    except Exception:
        pass

    try:
        path = loader.getPathToAttach(document, False)
        if path is not None and path.exists():
            return str(path.getAbsolutePath())
    except Exception:
        pass

    return None

def apply_imported_config(plugin, config):
    try:
        try:
            mode_id = int(config.get("mode_id", 1))
        except Exception:
            mode_id = 1
        mode_id = 0 if mode_id == 0 else 1

        if mode_id != 0:
            x = normalize_numeric_text(config.get("offset_x", "0"), "0") or "0"
            y = normalize_numeric_text(config.get("offset_y", "0"), "0") or "0"
            w = normalize_numeric_text(config.get("width", "0"), "0") or "0"
            h = normalize_numeric_text(config.get("height", "0"), "0") or "0"

            plugin.set_setting(CONF_RECT_X, x, reload_settings=False)
            plugin.set_setting(CONF_RECT_Y, y, reload_settings=False)
            plugin.set_setting(CONF_RECT_W, w, reload_settings=False)
            plugin.set_setting(CONF_RECT_H, h, reload_settings=False)

        plugin.set_setting(CONF_MODE, str(mode_id), reload_settings=True)
        run_on_ui_thread(lambda: BulletinHelper.show_info(get_string("import_success")))
    except Exception as e:
        err_msg = f"{get_string('import_fail')}: {e}"
        run_on_ui_thread(lambda: BulletinHelper.show_info(err_msg))

def show_import_dialog(plugin, config):
    def _do_show():
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            activity = fragment.getParentActivity()
            host = activity if activity is not None else fragment.getContext()

            lines = []
            try:
                mode_id = int(config.get("mode_id", 1))
            except Exception:
                mode_id = 1
            mode_text = get_string("mode_hide") if mode_id == 0 else get_string("mode_force")
            lines.append(f"mode: {mode_text} ({mode_id})")

            if mode_id != 0:
                lines.append(f"offset_x: {config.get('offset_x', '0')} px")
                lines.append(f"offset_y: {config.get('offset_y', '0')} px")
                lines.append(f"width: {config.get('width', '0')} dp")
                lines.append(f"height: {config.get('height', '0')} dp")

            dlg = AlertDialogBuilder(host)
            dlg.set_title(get_string("import_title"))
            dlg.set_message("\n".join(lines))
            dlg.set_positive_button(get_string("import_apply"), lambda bld, which: apply_imported_config(plugin, config))
            dlg.set_negative_button(get_string("import_cancel"), lambda bld, which: bld.dismiss())
            dlg.show()
        except Exception as e:
            plugin.log(f"Import dialog error: {e}")

    run_on_ui_thread(_do_show)

def import_notch_from_message(plugin, message_object, document):
    key = None
    try:
        key = str(getattr(document, "id", None))
    except Exception:
        key = None
    if not key:
        key = str(id(document))
    if key in plugin._import_inflight:
        return
    plugin._import_inflight.add(key)

    def _job():
        try:
            path = resolve_message_file_path(plugin, message_object, document)
            if not path:
                raise RuntimeError("notch file path not found")

            with open(path, encoding="utf-8") as f:
                config = json.loads(f.read())

            if not isinstance(config, dict) or "mode_id" not in config:
                raise RuntimeError(get_string("import_invalid"))

            show_import_dialog(plugin, config)
        except Exception as e:
            plugin.log(f"Import Error: {e}")
            err_msg = f"{get_string('import_fail')}: {e}"
            run_on_ui_thread(lambda: BulletinHelper.show_info(err_msg))
        finally:
            plugin._import_inflight.discard(key)

    threading.Thread(target=_job, daemon=True).start()

# === main.py ===
class Plugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._import_unhooks = []
        self._import_inflight = set()
        self.last_original_notch = None
        self.last_modified_notch = None

    def _sanitize_numeric_setting(self, key, fallback="0"):
        current = str(self.get_setting(key, fallback) or fallback)
        normalized = normalize_numeric_text(current, fallback)
        if normalized is None:
            normalized = fallback
        if normalized != current:
            self.set_setting(key, normalized, reload_settings=False)
        return normalized

    def _on_numeric_input_changed(self, key, value):
        current = str(self.get_setting(key, "0") or "0")
        normalized = normalize_numeric_text(value, current)
        if normalized is None:
            run_on_ui_thread(lambda: BulletinHelper.show_info(get_string("invalid_number")))
            self.set_setting(key, current, reload_settings=False)
            return
        self.set_setting(key, normalized, reload_settings=False)

    def _ensure_manual_defaults(self):
        x_str = self._sanitize_numeric_setting(CONF_RECT_X, "0")
        y_str = self._sanitize_numeric_setting(CONF_RECT_Y, "0")
        w_str = self._sanitize_numeric_setting(CONF_RECT_W, "0")
        h_str = self._sanitize_numeric_setting(CONF_RECT_H, "0")
        return x_str, y_str, w_str, h_str

    def _on_mode_changed(self, new_index):
        normalized_mode = MODE_HIDE if int(new_index) == 0 else MODE_FORCE
        current_mode = str(self.get_setting(CONF_MODE, MODE_FORCE))
        if current_mode == normalized_mode:
            return
        if normalized_mode == MODE_FORCE:
            self._ensure_manual_defaults()
        self.set_setting(CONF_MODE, normalized_mode, reload_settings=True)

    def _get_mode_id(self):
        try:
            mode_id = int(self.get_setting(CONF_MODE, MODE_FORCE))
        except Exception:
            mode_id = int(MODE_FORCE)
        return 0 if mode_id == 0 else 1

    def _get_field_unit(self, field_key):
        if field_key == CONF_RECT_X or field_key == CONF_RECT_Y:
            return 1
        return 0

    def on_plugin_load(self):
        show_android_warning_if_needed(self)
        try:
            target = find_class("org.telegram.messenger.NotchInfoUtils")
            m = target.getClass().getDeclaredMethod("getInfo", find_class("android.content.Context"))
            m.setAccessible(True)
            self.hook_method(m, NotchHook(self))
        except Exception as e:
            self.log(f"Hook Error: {e}")
        self._install_import_hook()

    def on_plugin_unload(self):
        if self._import_unhooks:
            for unhook in self._import_unhooks:
                try:
                    self.unhook_method(unhook)
                except Exception:
                    pass
        self._import_unhooks = []
        self._import_inflight.clear()

    def _install_import_hook(self):
        try:
            target = find_class("org.telegram.ui.ChatActivity$ChatMessageCellDelegate")
            if not target:
                return
            hook = NotchImportHook(self)
            self._import_unhooks = self.hook_all_methods(target, "didPressImage", hook, 50)
        except Exception as e:
            self.log(f"Import hook install failed: {e}")

    def create_settings(self):
        try:
            current_mode = self._get_mode_id()
            current_x, current_y, current_w, current_h = self._ensure_manual_defaults()

            items = [get_string("mode_hide"), get_string("mode_force")]

            settings = [Selector(key=CONF_MODE, text=get_string("label_mode"), default=current_mode, items=items, on_change=self._on_mode_changed)]

            if current_mode == 1:
                settings.append(
                    Input(
                        key=CONF_RECT_X,
                        text=f"{get_string('label_x_base')} (PX)",
                        default=current_x,
                        on_change=lambda value, k=CONF_RECT_X: self._on_numeric_input_changed(k, value),
                    )
                )

                settings.append(
                    Input(
                        key=CONF_RECT_Y,
                        text=f"{get_string('label_y_base')} (PX)",
                        default=current_y,
                        on_change=lambda value, k=CONF_RECT_Y: self._on_numeric_input_changed(k, value),
                    )
                )

                settings.append(
                    Input(
                        key=CONF_RECT_W,
                        text=f"{get_string('label_w_base')} (DP)",
                        default=current_w,
                        on_change=lambda value, k=CONF_RECT_W: self._on_numeric_input_changed(k, value),
                    )
                )

                settings.append(
                    Input(
                        key=CONF_RECT_H,
                        text=f"{get_string('label_h_base')} (DP)",
                        default=current_h,
                        on_change=lambda value, k=CONF_RECT_H: self._on_numeric_input_changed(k, value),
                    )
                )

                settings.append(Header(text=get_string("force_hint")))

            settings.append(Divider())

            settings.append(Text(text=get_string("export_btn"), accent=True, icon="action_share", on_click=lambda v: export_notch_config(self)))

            return settings
        except Exception as e:
            self.log(f"Settings error: {e}")
            return [Header(text="Error"), Text(text=str(e))]

class NotchHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin
        self._au_class = None

    def _get_au_class(self):
        if self._au_class is None:
            self._au_class = find_class("org.telegram.messenger.AndroidUtilities")
        return self._au_class

    def after_hooked_method(self, param):
        try:
            original = param.getResult()

            if original is not None:
                self.plugin.last_original_notch = {
                    "left": float(original.bounds.left),
                    "top": float(original.bounds.top),
                    "right": float(original.bounds.right),
                    "bottom": float(original.bounds.bottom),
                    "gravity": int(original.gravity) if hasattr(original, "gravity") else 0,
                    "isAccurate": bool(original.isAccurate) if hasattr(original, "isAccurate") else False,
                    "isLikelyCircle": bool(original.isLikelyCircle) if hasattr(original, "isLikelyCircle") else False,
                    "rawPath": str(original.rawPath) if (hasattr(original, "rawPath") and original.rawPath is not None) else None,
                    "hasPath": (original.path is not None) if hasattr(original, "path") else False,
                }
            else:
                self.plugin.last_original_notch = None

            mode = self.plugin._get_mode_id()

            if mode == 0:
                if original is not None:
                    param.setResult(None)
                self.plugin.last_modified_notch = None
                return

            if mode != 0:
                self.plugin._ensure_manual_defaults()
                x_str = self.plugin._sanitize_numeric_setting(CONF_RECT_X, "0")
                y_str = self.plugin._sanitize_numeric_setting(CONF_RECT_Y, "0")
                w_str = self.plugin._sanitize_numeric_setting(CONF_RECT_W, "0")
                h_str = self.plugin._sanitize_numeric_setting(CONF_RECT_H, "0")

                x_val = parse_dp_value(x_str, 0.0)
                y_val = parse_dp_value(y_str, 0.0)
                w_val = parse_dp_value(w_str, 0.0)
                h_val = parse_dp_value(h_str, 0.0)

                if original is None and w_val <= 0 and h_val <= 0:
                    return

                if original is None:
                    NotchInfo = find_class("org.telegram.messenger.NotchInfoUtils$NotchInfo")
                    RectF = find_class("android.graphics.RectF")
                    original = NotchInfo.newInstance()
                    original.bounds = RectF.newInstance()
                    param.setResult(original)

                base_left_px = float(original.bounds.left) if original is not None else 0.0
                base_top_px = float(original.bounds.top) if original is not None else 0.0
                base_width_px = float(original.bounds.width()) if original is not None else 0.0
                base_height_px = float(original.bounds.height()) if original is not None else 0.0

                AU = self._get_au_class()

                if self.plugin._get_field_unit(CONF_RECT_X) == 1:
                    x_px = x_val
                else:
                    x_px = float(AU.dp(float(x_val)))

                if self.plugin._get_field_unit(CONF_RECT_Y) == 1:
                    y_px = y_val
                else:
                    y_px = float(AU.dp(float(y_val)))

                if self.plugin._get_field_unit(CONF_RECT_W) == 1:
                    w_px = w_val
                else:
                    w_px = float(AU.dp(float(w_val)))

                if self.plugin._get_field_unit(CONF_RECT_H) == 1:
                    h_px = h_val
                else:
                    h_px = float(AU.dp(float(h_val)))

                if original is not None:
                    l_px = base_left_px + x_px
                    t_px = base_top_px + y_px
                else:
                    l_px = x_px
                    t_px = y_px

                if w_val <= 0.0:
                    width_px = base_width_px
                else:
                    width_px = w_px

                if h_val <= 0.0:
                    height_px = base_height_px
                else:
                    height_px = h_px

                r_px = l_px + width_px
                b_px = t_px + height_px

                b = original.bounds
                b.left = l_px
                b.top = t_px
                b.right = r_px
                b.bottom = b_px

                original.gravity = 17
                original.isLikelyCircle = True

                self.plugin.last_modified_notch = {
                    "left": float(b.left),
                    "top": float(b.top),
                    "right": float(b.right),
                    "bottom": float(b.bottom),
                    "gravity": int(original.gravity) if hasattr(original, "gravity") else 0,
                    "isAccurate": bool(original.isAccurate) if hasattr(original, "isAccurate") else False,
                    "isLikelyCircle": bool(original.isLikelyCircle) if hasattr(original, "isLikelyCircle") else False,
                    "rawPath": str(original.rawPath) if (hasattr(original, "rawPath") and original.rawPath is not None) else None,
                    "hasPath": (original.path is not None) if hasattr(original, "path") else False,
                }

        except Exception:
            pass



