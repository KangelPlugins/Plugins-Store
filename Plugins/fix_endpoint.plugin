# Notch Fix plugin for exteraGram / Ayugram
# Plugin created by @nonPlugins
# https://github.com/nonFeature/notch_fix

import json
import os
import re
import threading
import time
from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import get_last_fragment
from file_utils import get_cache_dir
from hook_utils import find_class
from java.util import Locale
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input, Selector, Text

# === header.py ===
__id__ = "fix_endpoint_gooey"
__name__ = "Notch Fix"
__description__ = "изменяет конечную точку аватарки в профиле"
__icon__ = "feature_plugins/0"
__version__ = "3.3"
__min_version__ = "12.1.1"
__author__ = "@nonPlugins"

# === data\constants.py ===
CONF_MODE = "notch_mode"
CONF_RECT_X = "notch_rect_x"
CONF_RECT_Y = "notch_rect_y"
CONF_RECT_W = "notch_rect_w"
CONF_RECT_H = "notch_rect_h"

MODE_HIDE = "0"
MODE_FORCE = "1"

