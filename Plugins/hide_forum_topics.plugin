GENERAL_TOPIC_ID = 1

_FIELD_CACHE = {}
_CLASS_CACHE = {}

def _field_route(obj, cls, name):
    try:
        value = getattr(obj, name)
        if value is not None:
            return ('attr', None)
    except Exception:
        pass
    current = cls
    for _ in range(8):
        if current is None:
            break
        try:
            field = current.getDeclaredField(name)
            field.setAccessible(True)
            field.get(obj)
            return ('field', field)
        except Exception:
            pass
        try:
            current = current.getSuperclass()
        except Exception:
            break
    return ('none', None)

def _jfield(obj, name):
    if obj is None:
        return None
    try:
        cls = obj.getClass()
        cache_key = (str(cls.getName()), name)
    except Exception:
        cls = None
        cache_key = None
    route = _FIELD_CACHE.get(cache_key) if cache_key is not None else None
    if route is None:
        route = _field_route(obj, cls, name)
        if cache_key is not None and route[0] != 'none':
            _FIELD_CACHE[cache_key] = route
    kind, field = route
    if kind == 'attr':
        try:
            return getattr(obj, name)
        except Exception:
            return None
    if kind == 'field':
        try:
            return field.get(obj)
        except Exception:
            return None
    return None

def _java_class(name):
    cached = _CLASS_CACHE.get(name)
    if cached is not None:
        return cached
    found = None
    try:
        found = JavaClass.forName(name)
    except Exception:
        found = None
    if found is None and find_class is not None:
        try:
            obj = find_class(name)
            if obj is not None:
                found = obj.getClass()
        except Exception:
            found = None
    if found is not None:
        _CLASS_CACHE[name] = found
    return found

def _int(value, default=0):
    try:
        if value is None:
            return default
        return int(value)
    except Exception:
        return default

def _topic_id_from_tl_message(message):
    if message is None:
        return 0
    try:
        reply = getattr(message, 'reply_to', None)
        if reply is not None:
            top = _int(getattr(reply, 'reply_to_top_id', 0))
            is_topic = bool(getattr(reply, 'forum_topic', False))
            if is_topic:
                if top:
                    return top
                mid = _int(getattr(reply, 'reply_to_msg_id', 0))
                if mid:
                    return mid
                return GENERAL_TOPIC_ID
            if top:
                return top
    except Exception:
        pass
    return 0

def _topic_id_of(msg_obj, dialog_id, is_forum):
    try:
        fn = getattr(msg_obj, 'getTopicId', None)
        if fn is not None:
            tid = _int(fn())
            if tid:
                return tid
    except Exception:
        pass
    owner = None
    try:
        owner = msg_obj.messageOwner
    except Exception:
        owner = None
    tid = _topic_id_from_tl_message(owner)
    if tid:
        return tid
    if is_forum:
        return GENERAL_TOPIC_ID
    return 0
