def _class_name(obj):
    try:
        return str(obj.getClass().getName())
    except Exception:
        try:
            return type(obj).__name__
        except Exception:
            return '?'

def _has_method(obj, name):
    cache_key = '%s#%s' % (_class_name(obj), name)
    cached = _CAPABILITY_CACHE.get(cache_key)
    if cached is not None:
        return cached
    ok = callable(getattr(obj, name, None))
    _CAPABILITY_CACHE[cache_key] = ok
    return ok

def _reflection_class(clazz):
    if clazz is None:
        return None
    get_name = getattr(clazz, 'getName', None)
    if callable(get_name):
        try:
            get_name()
            return clazz
        except Exception:
            pass
    try:
        reflected = clazz.getClass()
    except Exception:
        return None
    if reflected is not None and callable(getattr(reflected, 'getName', None)):
        try:
            reflected.getName()
            return reflected
        except Exception:
            pass
    return None

def _java_array_to_list(array):
    if array is None:
        return []
    items = []
    try:
        length = len(array)
    except Exception:
        try:
            for item in array:
                items.append(item)
        except Exception:
            return []
        return items
    for index in range(length):
        try:
            items.append(array[index])
        except Exception:
            pass
    return items

def _collect_methods(clazz, method_name):
    current = clazz
    while current is not None:
        found = []
        for getter in ('getDeclaredMethods', 'getMethods'):
            try:
                members = _java_array_to_list(getattr(current, getter)())
            except Exception:
                members = []
            for member in members:
                try:
                    if member.getName() == method_name:
                        found.append(member)
                except Exception:
                    pass
            if found:
                return found
        try:
            current = current.getSuperclass()
        except Exception:
            return []
    return []

def _get_field(obj, name):
    try:
        cls = obj.getClass()
    except Exception:
        return None
    while cls is not None:
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            return field.get(obj)
        except Exception:
            try:
                cls = cls.getSuperclass()
            except Exception:
                return None
    return None

def _locale_controller():
    try:
        if find_class is not None:
            cls = find_class(LOCALE_CONTROLLER)
            if cls is not None:
                return cls
    except Exception:
        pass
    try:
        return jclass(LOCALE_CONTROLLER)
    except Exception:
        return None

def _locale_instance():
    cls = _locale_controller()
    if cls is None:
        return None
    try:
        return cls.getInstance()
    except Exception:
        return None

def _norm_lang(raw):
    if raw is None:
        return None
    try:
        code = str(raw).strip().lower()
    except Exception:
        return None
    if not code or code in ('null', 'none'):
        return None
    code = _LANG_NAME_MAP.get(code, code)
    code = code.replace('_', '-').split('-', 1)[0]
    return code if code in STRINGS else None

def _lang_from_locale_info(inst):
    info = None
    if _has_method(inst, 'getCurrentLocaleInfo'):
        try:
            info = inst.getCurrentLocaleInfo()
        except Exception:
            info = None
    if info is None:
        info = _get_field(inst, 'currentLocaleInfo')
    if info is None:
        return None
    for getter in ('getLangCode', 'getBaseLangCode', 'getPluralLangCode', 'getKey'):
        if not _has_method(info, getter):
            continue
        try:
            code = _norm_lang(getattr(info, getter)())
        except Exception:
            code = None
        if code:
            return code
    for fld in ('shortName', 'pluralLangCode', 'baseLangCode', 'langCode', 'name'):
        code = _norm_lang(_get_field(info, fld))
        if code:
            return code
    return None

def _get_lang():
    inst = _locale_instance()
    if inst is not None:
        try:
            code = _lang_from_locale_info(inst)
            if code:
                return code
        except Exception:
            pass
        if _has_method(inst, 'getCurrentLocale'):
            try:
                locale_obj = inst.getCurrentLocale()
                if locale_obj is not None:
                    code = _norm_lang(locale_obj.getLanguage())
                    if code:
                        return code
            except Exception:
                pass
        locale_obj = _get_field(inst, 'currentLocale')
        if locale_obj is not None:
            try:
                code = _norm_lang(locale_obj.getLanguage())
                if code:
                    return code
            except Exception:
                pass
        if _has_method(inst, 'getCurrentLanguageName'):
            try:
                code = _norm_lang(inst.getCurrentLanguageName())
                if code:
                    return code
            except Exception:
                pass
    try:
        code = _norm_lang(jclass('java.util.Locale').getDefault().getLanguage())
        if code:
            return code
    except Exception:
        pass
    return 'en'

def _tr(key):
    return STRINGS.get(_get_lang(), STRINGS['en']).get(key, key)

class _LanguageChangeHook(MethodHook):

    def __init__(self, plugin):
        self._plugin = plugin

    def after_hooked_method(self, param):
        try:
            self._plugin._refresh_language()
        except Exception:
            pass

class ProcessNewMessagesHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not self.plugin._is_enabled() or not self.plugin._has_entries():
                return
            messages = param.args[0]
            if messages is None:
                return
            suppress = True
            auto_read = True
            for i in range(messages.size() - 1, -1, -1):
                msg = messages.get(i)
                try:
                    dialog_id = int(msg.getDialogId())
                    msg_id = int(msg.getId())
                except Exception:
                    continue
                topic_id = self.plugin._topic_of(msg, dialog_id)
                if topic_id <= 0:
                    continue
                entry = self.plugin._entry_for(dialog_id, topic_id)
                if entry is None:
                    continue
                if suppress and entry.get('n', True):
                    messages.remove(i)
                if auto_read and entry.get('n', True):
                    run_on_ui_thread(lambda d=dialog_id, t=topic_id, m=msg_id: self.plugin._mark_read(d, t, m))
        except Exception:
            pass

class ShowNotificationHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not self.plugin._is_enabled():
                return
            if not self.plugin._has_entries():
                return
            controller = param.thisObject
            try:
                field = controller.getClass().getDeclaredField('pushMessages')
                field.setAccessible(True)
                push_messages = field.get(controller)
            except Exception:
                return
            if push_messages is None or push_messages.size() == 0:
                return
            for i in range(push_messages.size() - 1, -1, -1):
                msg = push_messages.get(i)
                try:
                    dialog_id = int(msg.getDialogId())
                except Exception:
                    continue
                topic_id = self.plugin._topic_of(msg, dialog_id)
                if topic_id <= 0:
                    continue
                entry = self.plugin._entry_for(dialog_id, topic_id)
                if entry is not None and entry.get('n', True):
                    push_messages.remove(i)
        except Exception:
            pass

class GetTopicsHook(MethodHook):

    def __init__(self, plugin, source):
        self.plugin = plugin
        self.source = source
        self._last_dump = {}

    def after_hooked_method(self, param):
        try:
            if not self.plugin._is_enabled() or not self.plugin._has_entries():
                return
            result = param.getResult()
            if result is None:
                return
            try:
                size = int(result.size())
            except Exception:
                return
            if size == 0:
                return
            args = list(param.args) if param.args is not None else []
            chat_id = _int(args[0]) if args else 0
            if chat_id == 0 or not self.plugin._tracked(chat_id):
                return
            dialog_id = -abs(chat_id)
            zero_counters = True
            hide_in_list = True
            hidden = []
            kept = ArrayList()
            changed = False
            for i in range(size):
                topic = result.get(i)
                topic_id = _int(getattr(topic, 'id', 0))
                entry = self.plugin._entry_for(dialog_id, topic_id)
                if entry is None:
                    kept.add(topic)
                    continue
                if zero_counters and entry.get('n', True):
                    if self._zero(topic):
                        changed = True
                if hide_in_list and entry.get('h', False):
                    hidden.append(topic_id)
                    changed = True
                    continue
                kept.add(topic)
            if hidden:
                param.setResult(kept)
            elif changed:
                pass
            self.plugin._prune_storage(chat_id)
        except Exception:
            pass

    def _zero(self, topic):
        touched = False
        for field in ('unread_count', 'unread_mentions_count', 'unread_reactions_count'):
            try:
                if _int(getattr(topic, field, 0)) != 0:
                    setattr(topic, field, 0)
                    touched = True
            except Exception:
                pass
        return touched

class ForumUnreadHook(MethodHook):

    def __init__(self, plugin, source):
        self.plugin = plugin
        self.source = source

    def after_hooked_method(self, param):
        try:
            if not self.plugin._is_enabled() or not self.plugin._has_entries():
                return
            args = list(param.args) if param.args is not None else []
            chat_id = abs(_int(args[0])) if args else 0
            if chat_id == 0 or not self.plugin._tracked(chat_id):
                return
            result = param.getResult()
            if result is None:
                return
            try:
                length = len(result)
            except Exception:
                length = 0
            if length < 1:
                return
            self.plugin._prune_storage(chat_id)
            before = [_int(result[i]) for i in range(min(length, 3))]
            fixed = self.plugin._forum_counts(param.thisObject, chat_id, before[0])
            if fixed is None:
                return
            for i in range(min(length, 3)):
                result[i] = int(fixed[i])
            after = [_int(result[i]) for i in range(min(length, 3))]
            if before != after:
                pass
        except Exception:
            pass

class DialogUnreadHook(MethodHook):

    def __init__(self, plugin, source):
        self.plugin = plugin
        self.source = source

    def after_hooked_method(self, param):
        try:
            if not self.plugin._is_enabled() or not self.plugin._has_entries():
                return
            args = list(param.args) if param.args is not None else []
            if not args:
                return
            dialog_id = _int(getattr(args[0], 'id', 0))
            if dialog_id >= 0 or not self.plugin._tracked(dialog_id):
                return
            if not self.plugin._is_forum(dialog_id):
                return
            result = param.getResult()
            if result is None:
                return
            before = _int(result)
            fixed = self.plugin._forum_counts(None, abs(dialog_id), before)
            if fixed is None:
                return
            value = int(fixed[0])
            if value != before:
                param.setResult(Integer(value))
        except Exception:
            pass

class SaveTopicsHook(MethodHook):

    def __init__(self, plugin, source):
        self.plugin = plugin
        self.source = source

    def _chat_id(self, param):
        args = list(param.args) if param.args is not None else []
        return abs(_int(args[0])) if args else 0

    def before_hooked_method(self, param):
        try:
            chat_id = self._chat_id(param)
            if chat_id and self.plugin._restore_storage(chat_id):
                pass
        except Exception:
            pass

    def after_hooked_method(self, param):
        try:
            chat_id = self._chat_id(param)
            if chat_id:
                self.plugin._prune_storage(chat_id)
        except Exception:
            pass

class BuildLayoutHook(MethodHook):

    def __init__(self, plugin, source):
        self.plugin = plugin
        self.source = source
        self._stash = {}
        self._last_dump = {}

    @staticmethod
    def _thread_key():
        try:
            return threading.current_thread().ident
        except Exception:
            return 0

    def before_hooked_method(self, param):
        key = self._thread_key()
        self._restore(key)
        try:
            if not self.plugin._is_enabled() or not self.plugin._has_entries():
                return
            dialog_id = self.plugin._cell_dialog_id(param.thisObject)
            if dialog_id >= 0 or not self.plugin._tracked(dialog_id):
                return
            if not self.plugin._is_forum(dialog_id):
                return
            removed = self.plugin._detach_messages(dialog_id)
            if removed:
                self._stash[key] = removed
        except Exception:
            self._restore(key)

    def after_hooked_method(self, param):
        self._restore(self._thread_key())

    def _restore(self, key):
        removed = self._stash.pop(key, None)
        if not removed:
            return
        for action, messages, index, msg in reversed(removed):
            try:
                if action == 'set':
                    messages.set(int(index), msg)
                else:
                    messages.add(int(index), msg)
            except Exception:
                try:
                    messages.add(msg)
                except Exception:
                    pass

class CellUpdateHook(BuildLayoutHook):

    def after_hooked_method(self, param):
        self._restore(self._thread_key())

class SetDialogHook(MethodHook):

    def __init__(self, plugin, source):
        self.plugin = plugin
        self.source = source
        self._last_log = 0.0

    def before_hooked_method(self, param):
        try:
            args = param.args
            if args is None:
                return
            dialog_id = self.plugin._dialog_id_from_args(args)
            if dialog_id == 0:
                dialog_id = self.plugin._cell_dialog_id(param.thisObject)
            if dialog_id >= 0 or not self.plugin._tracked(dialog_id):
                return
            if not self.plugin._is_enabled() or not self.plugin._has_entries():
                return
            if not self.plugin._is_forum(dialog_id):
                return
            hidden = self.plugin._hidden_set(dialog_id, only='h')
            if not hidden:
                return
            replacement = None
            searched = False
            for i in range(len(args)):
                arg = args[i]
                if arg is None:
                    continue
                if self.plugin._is_message_list(arg):
                    filtered = self.plugin._filtered_list(arg, dialog_id, hidden)
                    if filtered is not None:
                        args[i] = filtered
                    continue
                topic_id = self.plugin._topic_of(arg, dialog_id)
                if topic_id <= 0 or topic_id not in hidden:
                    continue
                if not searched:
                    replacement = self.plugin._visible_message(dialog_id, hidden)
                    searched = True
                args[i] = replacement
        except Exception:
            pass

class FormatTopicsNamesHook(MethodHook):

    def __init__(self, plugin, source):
        self.plugin = plugin
        self.source = source
        self._stash = {}
        self._last_log = 0.0

    @staticmethod
    def _thread_key():
        try:
            return threading.current_thread().ident
        except Exception:
            return 0

    def before_hooked_method(self, param):
        key = self._thread_key()
        self._restore(key)
        try:
            if not self.plugin._is_enabled() or not self.plugin._has_entries():
                return
            dialog_id = self.plugin._cell_dialog_id(param.thisObject)
            if dialog_id >= 0 or not self.plugin._tracked(dialog_id):
                return
            removed = self.plugin._detach_hidden(abs(dialog_id))
            if removed:
                self._stash[key] = removed
        except Exception:
            self._restore(key)

    def after_hooked_method(self, param):
        self._restore(self._thread_key())

    def _restore(self, key):
        removed = self._stash.pop(key, None)
        if not removed:
            return
        for topics, index, topic in reversed(removed):
            try:
                topics.add(int(index), topic)
            except Exception:
                try:
                    topics.add(topic)
                except Exception:
                    pass

class HideForumTopicsPlugin(BasePlugin):
    MENU_NOTIFY_ID = 'hide_forum_topics_notify'
    MENU_HIDE_ID = 'hide_forum_topics_hide'

    def on_plugin_load(self):
        self._hft_hooks = []
        self._hft_entries = {}
        self._hft_detached = {}
        self._hft_last_visible = {}
        self._hft_built = {}
        self._hft_forums = set()
        self._hft_hidden_index = {}
        self._hft_muted_index = {}
        self._hft_counts_cache = {}
        self._hft_prune_ts = {}
        self._hft_forum_flag = {}
        self._hft_enabled_cache = None
        self._hft_ctor = None
        self._load_entries()
        self._hook_notifications()
        self._hook_topics()
        self._hook_unread()
        self._hook_cells()
        self._hook_locale()
        for update in ('TL_updateNewMessage', 'TL_updateNewChannelMessage', 'TL_updates', 'TL_updatesCombined'):
            try:
                self.add_hook(update)
            except Exception:
                pass
        self._refresh_menu()

    def on_plugin_unload(self):
        self._restore_storage()
        for hook in list(self._hft_hooks):
            try:
                self.unhook_method(hook)
            except Exception:
                try:
                    hook.unhook()
                except Exception:
                    pass
        self._hft_hooks = []
        for item_id in (self.MENU_NOTIFY_ID, self.MENU_HIDE_ID):
            try:
                self.remove_menu_item(item_id)
            except Exception:
                pass

    def _is_enabled(self):
        now = time.time()
        cached = getattr(self, '_hft_enabled_cache', None)
        if cached is not None and now - cached[0] < 1.0:
            return cached[1]
        try:
            value = bool(self.get_setting('enabled', True))
        except Exception:
            value = True
        self._hft_enabled_cache = (now, value)
        return value

    def _hook_notifications(self):
        cls = _java_class('org.telegram.messenger.NotificationsController')
        if cls is None:
            return
        try:
            list_cls = _java_class('java.util.ArrayList')
            latch_cls = _java_class('java.util.concurrent.CountDownLatch')
            method = cls.getDeclaredMethod('processNewMessages', [list_cls, jbool, jbool, latch_cls])
            method.setAccessible(True)
            self._hft_hooks.append(self.hook_method(method, ProcessNewMessagesHook(self)))
        except Exception:
            pass
        try:
            method = cls.getDeclaredMethod('showOrUpdateNotification', [jbool])
            method.setAccessible(True)
            self._hft_hooks.append(self.hook_method(method, ShowNotificationHook(self)))
        except Exception:
            pass

    def _hook_topics(self):
        cls = _java_class('org.telegram.messenger.TopicsController')
        if cls is None:
            return
        try:
            methods = cls.getDeclaredMethods()
        except Exception:
            return
        wanted = ('getTopics',)
        for m in methods:
            try:
                name = str(m.getName())
            except Exception:
                continue
            if name not in wanted:
                continue
            try:
                if len(m.getParameterTypes()) != 1:
                    continue
                m.setAccessible(True)
                self._hft_hooks.append(self.hook_method(m, GetTopicsHook(self, 'TopicsController.' + name)))
            except Exception:
                pass

    def _hook_unread(self):
        targets = (('org.telegram.messenger.TopicsController', ('getForumUnreadCount',), ForumUnreadHook), ('org.telegram.messenger.MessagesController', ('getDialogUnreadCount',), DialogUnreadHook), ('org.telegram.messenger.TopicsController', ('saveTopics',), SaveTopicsHook))
        for class_name, names, hook_cls in targets:
            cls = _java_class(class_name)
            short = class_name.rsplit('.', 1)[-1]
            if cls is None:
                continue
            try:
                methods = cls.getDeclaredMethods()
            except Exception:
                continue
            found = False
            for m in methods:
                try:
                    name = str(m.getName())
                except Exception:
                    continue
                if name not in names:
                    continue
                source = '%s.%s' % (short, name)
                try:
                    params = [str(p.getSimpleName()) for p in m.getParameterTypes()]
                    if not params:
                        continue
                    m.setAccessible(True)
                    self._hft_hooks.append(self.hook_method(m, hook_cls(self, source)))
                    found = True
                except Exception:
                    pass
            if not found:
                pass

    def _hook_cells(self):
        cls = _java_class('org.telegram.ui.Cells.DialogCell')
        if cls is None:
            return
        try:
            methods = cls.getDeclaredMethods()
        except Exception:
            return
        wanted = {'formatTopicsNames': FormatTopicsNamesHook, 'buildLayout': BuildLayoutHook, 'setDialog': SetDialogHook, 'update': CellUpdateHook}
        with_params = ('setDialog', 'update')
        found = set()
        for m in methods:
            try:
                name = str(m.getName())
            except Exception:
                continue
            hook_cls = wanted.get(name)
            if hook_cls is None:
                continue
            source = 'DialogCell.%s' % name
            try:
                params = [str(p.getSimpleName()) for p in m.getParameterTypes()]
                if params and name not in with_params:
                    continue
                source = 'DialogCell.%s(%s)' % (name, ', '.join(params))
                m.setAccessible(True)
                self._hft_hooks.append(self.hook_method(m, hook_cls(self, source)))
                found.add(name)
            except Exception:
                pass
        for name in wanted:
            if name not in found:
                pass

    def _hook_members(self, members, hook):
        unhooks = []
        for member in members:
            try:
                member.setAccessible(True)
            except Exception:
                pass
            try:
                unhook = self.hook_method(member, hook)
            except Exception:
                unhook = None
            if unhook:
                unhooks.append(unhook)
        return unhooks

    def _hook_methods(self, clazz, method_name, hook):
        try:
            unhooks = self.hook_all_methods(clazz, method_name, hook)
        except Exception:
            unhooks = None
        if unhooks:
            unhooks = list(unhooks)
        else:
            unhooks = self._hook_members(_collect_methods(clazz, method_name), hook)
        self._hft_hooks.extend(unhooks)
        return unhooks

    def _hook_locale(self):
        global _LAST_LANG
        _CAPABILITY_CACHE.clear()
        try:
            _LAST_LANG = _get_lang()
        except Exception:
            _LAST_LANG = None
        try:
            clazz = _reflection_class(_locale_controller())
            if clazz:
                lang_hook = _LanguageChangeHook(self)
                for method_name in ('applyLanguage', 'recreateFormatters'):
                    self._hook_methods(clazz, method_name, lang_hook)
        except Exception:
            pass

    def _refresh_language(self):
        global _LAST_LANG
        try:
            lang = _get_lang()
        except Exception:
            return
        if lang == _LAST_LANG:
            return
        _LAST_LANG = lang

        def do_reload():
            try:
                self._refresh_menu()
            except Exception:
                pass
            for name in ('reload_settings', 'reloadSettings'):
                fn = getattr(self, name, None)
                if callable(fn):
                    try:
                        fn()
                        return
                    except Exception:
                        pass
            try:
                tick = int(self.get_setting('lang_tick', 0) or 0) + 1
            except Exception:
                tick = 1
            try:
                self.set_setting('lang_tick', tick, reload_settings=True)
            except Exception:
                pass
        try:
            if run_on_ui_thread is not None:
                run_on_ui_thread(do_reload)
            else:
                do_reload()
        except Exception:
            pass

    def _rebuild_index(self):
        forums = set()
        hidden = {}
        muted = {}
        for key, entry in list(getattr(self, '_hft_entries', {}).items()):
            try:
                raw_dialog, raw_topic = str(key).split(':')
                dialog_id = int(raw_dialog)
                topic_id = int(raw_topic)
            except Exception:
                continue
            chat_id = abs(dialog_id)
            forums.add(chat_id)
            is_hidden = bool(entry.get('h', False))
            if is_hidden:
                hidden.setdefault(chat_id, set()).add(topic_id)
            if is_hidden or entry.get('n', True):
                muted.setdefault(chat_id, set()).add(topic_id)
        self._hft_forums = forums
        self._hft_hidden_index = hidden
        self._hft_muted_index = muted
        self._hft_counts_cache = {}
        self._hft_prune_ts = {}
        self._hft_forum_flag = {}
        self._hft_enabled_cache = None

    def _tracked(self, dialog_id):
        try:
            return abs(int(dialog_id)) in self._hft_forums
        except Exception:
            return False

    def _hidden_set(self, dialog_id, only=None):
        try:
            chat_id = abs(int(dialog_id))
        except Exception:
            return frozenset()
        index = self._hft_hidden_index if only == 'h' else self._hft_muted_index
        return index.get(chat_id) or frozenset()

    def _hidden_topic_ids(self, dialog_id, only=None):
        return list(self._hidden_set(dialog_id, only=only))

    def _invalidate_caches(self, chat_id=None):
        if chat_id is None:
            self._hft_counts_cache = {}
            self._hft_prune_ts = {}
            return
        try:
            key = abs(int(chat_id))
        except Exception:
            return
        self._hft_counts_cache.pop(key, None)
        self._hft_prune_ts.pop(key, None)

    def _find_topic(self, controller, chat_id, topic_id):
        attempts = []
        if controller is not None:
            attempts.append(lambda: controller.findTopic(int(chat_id), int(topic_id)))
        attempts.append(lambda: get_messages_controller().getTopicsController().findTopic(int(chat_id), int(topic_id)))
        for call in attempts:
            try:
                topic = call()
                if topic is not None:
                    return topic
            except Exception:
                pass
        return None

    def _topics_controller(self, controller=None):
        if controller is not None:
            return controller
        try:
            return get_messages_controller().getTopicsController()
        except Exception:
            return None

    def _raw_topics(self, controller, chat_id):
        controller = self._topics_controller(controller)
        if controller is None:
            return None
        storage = _jfield(controller, 'topicsByChatId')
        if storage is None:
            return None
        try:
            return storage.get(int(abs(int(chat_id))))
        except Exception:
            return None

    def _counts_mode(self, original, all_flags, all_msgs):
        mode = getattr(self, '_hft_counts_mode', None)
        if mode:
            return mode
        if original == all_flags:
            mode = 'flags'
        elif original == all_msgs:
            mode = 'messages'
        else:
            return None
        self._hft_counts_mode = mode
        return mode

    def _forum_counts(self, controller, chat_id, original):
        try:
            key = abs(int(chat_id))
        except Exception:
            return None
        now = time.time()
        cached = self._hft_counts_cache.get(key)
        if cached is not None and cached[0] == original and now - cached[1] < 0.3:
            return cached[2]
        result = self._forum_counts_now(controller, key, original)
        self._hft_counts_cache[key] = (original, now, result)
        return result

    def _forum_counts_now(self, controller, chat_id, original):
        chat_id = abs(int(chat_id))
        muted = self._hidden_set(-chat_id)
        if not muted:
            return None
        topics = self._raw_topics(controller, chat_id)
        if topics is None:
            return None
        try:
            size = int(topics.size())
        except Exception:
            return None
        fields = ('unread_count', 'unread_mentions_count', 'unread_reactions_count')
        all_msgs = [0, 0, 0]
        all_flags = [0, 0, 0]
        vis_msgs = [0, 0, 0]
        vis_flags = [0, 0, 0]
        pool = []
        for i in range(size):
            try:
                pool.append(topics.get(i))
            except Exception:
                continue
        detached = self._detached_topics(chat_id)
        pool.extend(detached)
        detached_ids = set()
        for topic in detached:
            detached_ids.add(_int(getattr(topic, 'id', 0)))
        for topic in pool:
            try:
                topic_id = _int(getattr(topic, 'id', 0))
            except Exception:
                continue
            skip = topic_id in muted or topic_id in detached_ids
            for idx, field in enumerate(fields):
                value = max(0, _int(getattr(topic, field, 0)))
                all_msgs[idx] += value
                all_flags[idx] += 1 if value > 0 else 0
                if not skip:
                    vis_msgs[idx] += value
                    vis_flags[idx] += 1 if value > 0 else 0
        if original == vis_msgs[0]:
            return None
        return vis_msgs

    def _prune_storage(self, chat_id):
        try:
            key = abs(int(chat_id))
        except Exception:
            return 0
        now = time.time()
        if now - self._hft_prune_ts.get(key, 0.0) < 0.3:
            return 0
        self._hft_prune_ts[key] = now
        return self._prune_storage_now(key)

    def _prune_storage_now(self, chat_id):
        chat_id = abs(int(chat_id))
        hidden = self._hidden_set(-chat_id, only='h')
        if not hidden:
            self._restore_storage(chat_id)
            return 0
        topics = self._raw_topics(None, chat_id)
        if topics is None:
            return 0
        try:
            size = int(topics.size())
        except Exception:
            return 0
        store = self._hft_detached.setdefault(chat_id, {})
        removed = 0
        for i in range(size - 1, -1, -1):
            try:
                topic = topics.get(i)
                topic_id = _int(getattr(topic, 'id', 0))
            except Exception:
                continue
            if topic_id not in hidden:
                continue
            try:
                topics.remove(int(i))
                store[topic_id] = topic
                removed += 1
            except Exception:
                pass
        if removed:
            pass
        return removed

    def _restore_storage(self, chat_id=None):
        detached = getattr(self, '_hft_detached', None)
        if not detached:
            return 0
        keys = [abs(int(chat_id))] if chat_id is not None else list(detached.keys())
        back = 0
        for key in keys:
            store = detached.get(key)
            if not store:
                continue
            topics = self._raw_topics(None, key)
            if topics is None:
                continue
            present = set()
            try:
                for i in range(int(topics.size())):
                    present.add(_int(getattr(topics.get(i), 'id', 0)))
            except Exception:
                pass
            for topic_id, topic in list(store.items()):
                if topic_id in present:
                    store.pop(topic_id, None)
                    continue
                try:
                    topics.add(topic)
                    store.pop(topic_id, None)
                    back += 1
                except Exception:
                    pass
            if not store:
                detached.pop(key, None)
        if back:
            pass
        return back

    def _detached_topics(self, chat_id):
        try:
            return list(getattr(self, '_hft_detached', {}).get(abs(int(chat_id)), {}).values())
        except Exception:
            return []

    def _is_message_list(self, obj):
        try:
            size = int(obj.size())
        except Exception:
            return False
        try:
            if size == 0:
                return True
            return hasattr(obj.get(0), 'getId')
        except Exception:
            return False

    def _filtered_list(self, source_list, dialog_id, hidden):
        try:
            size = int(source_list.size())
            keep = ArrayList()
            dropped = 0
            for i in range(size):
                msg = source_list.get(i)
                topic_id = self._topic_of(msg, dialog_id)
                if topic_id > 0 and topic_id in hidden:
                    dropped += 1
                    continue
                keep.add(msg)
            if dropped == 0:
                return None
            return keep
        except Exception:
            return None

    def _visible_message(self, dialog_id, hidden):
        chat_id = abs(int(dialog_id))
        messages = self._dialog_messages(dialog_id)
        if messages is not None:
            try:
                for i in range(int(messages.size())):
                    msg = messages.get(i)
                    topic_id = self._topic_of(msg, dialog_id)
                    if topic_id > 0 and topic_id in hidden:
                        continue
                    self._hft_last_visible[chat_id] = msg
                    return msg
            except Exception:
                pass
        cached = self._hft_last_visible.get(chat_id)
        if cached is not None:
            return cached
        return self._topic_top_message(dialog_id, hidden)

    def _topic_top_message(self, dialog_id, hidden):
        chat_id = abs(int(dialog_id))
        topics = self._raw_topics(None, chat_id)
        if topics is None:
            return None
        try:
            size = int(topics.size())
        except Exception:
            return None
        best = None
        best_date = -1
        for i in range(size):
            try:
                topic = topics.get(i)
                topic_id = _int(getattr(topic, 'id', 0))
                if topic_id in hidden:
                    continue
                top = _jfield(topic, 'topMessage')
                if top is None:
                    continue
                date = _int(getattr(top, 'date', 0))
                if date == 0:
                    try:
                        date = _int(getattr(_jfield(top, 'messageOwner'), 'date', 0))
                    except Exception:
                        date = 0
                if date >= best_date:
                    best_date = date
                    best = top
            except Exception:
                continue
        if best is None:
            return None
        if hasattr(best, 'getId'):
            return best
        return self._wrap_message(chat_id, best)

    def _message_ctor(self):
        ctor = getattr(self, '_hft_ctor', None)
        if ctor is not None:
            return ctor
        cls = _java_class('org.telegram.messenger.MessageObject')
        if cls is None:
            return None
        try:
            constructors = cls.getDeclaredConstructors()
        except Exception:
            return None
        for candidate in constructors:
            try:
                params = [str(p.getSimpleName()) for p in candidate.getParameterTypes()]
            except Exception:
                continue
            if len(params) != 4:
                continue
            if params[0] != 'int' or params[2] != 'boolean' or params[3] != 'boolean':
                continue
            if 'Message' not in params[1]:
                continue
            try:
                candidate.setAccessible(True)
            except Exception:
                continue
            self._hft_ctor = candidate
            return candidate
        return None

    def _wrap_message(self, chat_id, tl_message):
        try:
            msg_id = _int(getattr(tl_message, 'id', 0))
        except Exception:
            msg_id = 0
        key = '%s:%s' % (chat_id, msg_id)
        built = self._hft_built.get(key)
        if built is not None:
            return built
        ctor = self._message_ctor()
        if ctor is None:
            return None
        try:
            from org.telegram.messenger import UserConfig
            account = int(UserConfig.selectedAccount)
        except Exception:
            return None
        try:
            built = ctor.newInstance([Integer(account), tl_message, Boolean(True), Boolean(False)])
        except Exception:
            return None
        if built is None:
            return None
        if len(self._hft_built) > 64:
            self._hft_built.clear()
        self._hft_built[key] = built
        return built

    def _dialog_id_from_args(self, args):
        try:
            for arg in args:
                if arg is None:
                    continue
                try:
                    value = int(arg)
                    if value < -1000:
                        return value
                    continue
                except Exception:
                    pass
                try:
                    value = int(_jfield(arg, 'id'))
                    if value < -1000:
                        return value
                except Exception:
                    continue
        except Exception:
            pass
        return 0

    def _dialog_messages(self, dialog_id):
        try:
            controller = get_messages_controller()
        except Exception:
            return None
        storage = _jfield(controller, 'dialogMessage')
        if storage is None:
            return None
        try:
            messages = storage.get(int(dialog_id))
        except Exception:
            return None
        if messages is None:
            return None
        try:
            int(messages.size())
        except Exception:
            return None
        return messages

    def _detach_messages(self, dialog_id):
        dialog_id = int(dialog_id)
        hidden = self._hidden_set(dialog_id, only='h')
        if not hidden:
            return []
        messages = self._dialog_messages(dialog_id)
        if messages is None:
            return []
        try:
            size = int(messages.size())
        except Exception:
            return []
        marked = []
        for i in range(size):
            try:
                msg = messages.get(i)
            except Exception:
                continue
            topic_id = self._topic_of(msg, dialog_id)
            if topic_id > 0 and topic_id in hidden:
                marked.append((i, msg))
        if not marked:
            return []
        changes = []
        if size - len(marked) > 0:
            marked_ids = set((index for index, _ in marked))
            for i in range(size):
                if i in marked_ids:
                    continue
                try:
                    self._hft_last_visible[abs(int(dialog_id))] = messages.get(i)
                    break
                except Exception:
                    continue
            for index, msg in reversed(marked):
                try:
                    messages.remove(int(index))
                    changes.append(('remove', messages, index, msg))
                except Exception:
                    pass
            return changes
        replacement = self._visible_message(dialog_id, hidden)
        if replacement is None:
            for index, msg in reversed(marked):
                try:
                    messages.remove(int(index))
                    changes.append(('remove', messages, index, msg))
                except Exception:
                    pass
            return changes
        for index, msg in marked:
            try:
                messages.set(int(index), replacement)
                changes.append(('set', messages, index, msg))
            except Exception:
                pass
        if changes:
            pass
        return changes

    def _cell_dialog_id(self, cell):
        value = _int(_jfield(cell, 'currentDialogId'))
        if value:
            return value
        for name in ('getDialogId', 'getCurrentDialogId'):
            try:
                value = _int(getattr(cell, name)())
                if value:
                    return value
            except Exception:
                continue
        return 0

    def _detach_hidden(self, chat_id):
        chat_id = abs(int(chat_id))
        hidden = self._hidden_set(-chat_id, only='h')
        if not hidden:
            return []
        topics = self._raw_topics(None, chat_id)
        if topics is None:
            return []
        try:
            size = int(topics.size())
        except Exception:
            return []
        removed = []
        for i in range(size - 1, -1, -1):
            try:
                topic = topics.get(i)
                topic_id = _int(getattr(topic, 'id', 0))
            except Exception:
                continue
            if topic_id not in hidden:
                continue
            try:
                topics.remove(int(i))
                removed.append((topics, i, topic))
            except Exception:
                pass
        return removed

    def _notify_topics_changed(self, dialog_id):
        chat_id = abs(int(dialog_id))
        self._invalidate_caches()
        self._restore_storage(chat_id)
        try:
            from org.telegram.messenger import NotificationCenter, UserConfig
        except Exception:
            return

        def _post():
            try:
                nc = NotificationCenter.getInstance(UserConfig.selectedAccount)
            except Exception:
                return
            attempts = (('topicsDidLoaded', lambda: nc.postNotificationName(NotificationCenter.topicsDidLoaded, Long(chat_id), Boolean.TRUE)), ('dialogsNeedReload', lambda: nc.postNotificationName(NotificationCenter.dialogsNeedReload)))
            for name, call in attempts:
                try:
                    call()
                except Exception:
                    pass
        run_on_ui_thread(_post)

    @staticmethod
    def _key(dialog_id, topic_id):
        return '%s:%s' % (int(dialog_id), int(topic_id))

    def _load_entries(self):
        try:
            raw = self.get_setting('topics', '{}')
            data = json.loads(raw) if raw else {}
            if not isinstance(data, dict):
                data = {}
        except Exception:
            data = {}
        self._hft_entries = data
        self._rebuild_index()

    def _save_entries(self):
        try:
            payload = json.dumps(self._hft_entries, ensure_ascii=False)
            self.set_setting('topics', payload, reload_settings=True)
        except Exception:
            pass
        self._rebuild_index()

    def _has_entries(self):
        if not hasattr(self, '_hft_entries'):
            self._load_entries()
        return bool(self._hft_entries)

    def _entry_for(self, dialog_id, topic_id):
        if not hasattr(self, '_hft_entries') or not self._hft_entries:
            return None
        return self._hft_entries.get(self._key(dialog_id, topic_id))

    def _chat(self, dialog_id):
        try:
            if int(dialog_id) >= 0:
                return None
            return get_messages_controller().getChat(-int(dialog_id))
        except Exception:
            return None

    def _is_forum(self, dialog_id):
        try:
            key = int(dialog_id)
        except Exception:
            return False
        cache = getattr(self, '_hft_forum_flag', None)
        if cache is None:
            cache = {}
            self._hft_forum_flag = cache
        value = cache.get(key)
        if value is not None:
            return value
        chat = self._chat(key)
        value = bool(chat and getattr(chat, 'forum', False))
        if chat is not None:
            cache[key] = value
        return value

    def _topic_of(self, msg_obj, dialog_id):
        try:
            if not self._is_forum(dialog_id):
                return 0
            return _topic_id_of(msg_obj, dialog_id, True)
        except Exception:
            return 0

    def _mark_read(self, dialog_id, topic_id, max_id):
        try:
            get_messages_controller().markDialogAsRead(int(dialog_id), int(max_id), 0, 0, False, int(topic_id), 0, True, 0)
        except Exception:
            pass

    def _handle_tl_message(self, message):
        try:
            peer = getattr(message, 'peer_id', None)
            dialog_id = 0
            if peer is not None:
                if _int(getattr(peer, 'channel_id', 0)):
                    dialog_id = -_int(getattr(peer, 'channel_id', 0))
                elif _int(getattr(peer, 'chat_id', 0)):
                    dialog_id = -_int(getattr(peer, 'chat_id', 0))
            if dialog_id == 0 or not self._is_forum(dialog_id):
                return
            topic_id = _topic_id_from_tl_message(message) or GENERAL_TOPIC_ID
            entry = self._entry_for(dialog_id, topic_id)
            if entry is None or not entry.get('n', True):
                return
            msg_id = _int(getattr(message, 'id', 0))
            run_on_ui_thread(lambda: self._mark_read(dialog_id, topic_id, msg_id))
        except Exception:
            pass

    def on_update_hook(self, update_name, account, update):
        try:
            if self._is_enabled() and update_name in ('TL_updateNewMessage', 'TL_updateNewChannelMessage'):
                message = getattr(update, 'message', None)
                if message is not None:
                    self._handle_tl_message(message)
        except Exception:
            pass
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        try:
            if not self._is_enabled() or not hasattr(updates, 'updates'):
                return HookResult()
            upd_list = updates.updates
            for i in range(upd_list.size()):
                upd = upd_list.get(i)
                if 'NewMessage' in type(upd).__name__:
                    message = getattr(upd, 'message', None)
                    if message is not None:
                        self._handle_tl_message(message)
        except Exception:
            pass
        return HookResult()

    def _refresh_menu(self):
        for item_id in (self.MENU_NOTIFY_ID, self.MENU_HIDE_ID):
            try:
                self.remove_menu_item(item_id)
            except Exception:
                pass
        try:
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, text=_tr('menu_notify'), icon='msg_mute', on_click=self._on_toggle_notify, item_id=self.MENU_NOTIFY_ID, priority=900))
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, text=_tr('menu_hide'), icon='msg_archive', on_click=self._on_toggle_hide, item_id=self.MENU_HIDE_ID, priority=899))
        except Exception:
            pass

    def _dialog_id_from_context(self, context):
        for key in ('dialog_id', 'dialogId', 'chatId', 'chat_id'):
            try:
                val = context.get(key)
                if val is not None:
                    val = int(val)
                    if val != 0:
                        return val if val < 0 or key in ('dialog_id', 'dialogId') else -abs(val)
            except Exception:
                pass
        try:
            chat = context.get('chat')
            if chat is not None:
                return -abs(int(chat.id))
        except Exception:
            pass
        fragment = self._fragment(context)
        try:
            if fragment is not None and hasattr(fragment, 'getDialogId'):
                return int(fragment.getDialogId())
        except Exception:
            pass
        return 0

    def _fragment(self, context):
        try:
            fragment = context.get('fragment')
            if fragment is not None:
                return fragment
        except Exception:
            pass
        try:
            return get_last_fragment()
        except Exception:
            return None

    def _topic_id_from_context(self, context):
        for key in ('topic_id', 'topicId', 'thread_id', 'threadId'):
            try:
                val = context.get(key)
                if val is not None and int(val) != 0:
                    return int(val)
            except Exception:
                pass
        fragment = self._fragment(context)
        if fragment is None:
            return 0
        for name in ('getTopicId', 'getThreadId', 'getThreadMessageId'):
            try:
                fn = getattr(fragment, name, None)
                if fn is not None:
                    tid = _int(fn())
                    if tid:
                        return tid
            except Exception:
                pass
        try:
            fn = getattr(fragment, 'getThreadMessage', None)
            if fn is not None:
                thread_msg = fn()
                if thread_msg is not None:
                    tid = _int(getattr(thread_msg, 'getId', lambda: 0)())
                    if tid:
                        return tid
        except Exception:
            pass
        tid = self._reflect_topic_id(fragment)
        if tid:
            return tid
        return 0

    def _reflect_topic_id(self, fragment):
        names = ('threadMessageId', 'topicId', 'threadId')
        try:
            cls = fragment.getClass()
        except Exception:
            return 0
        depth = 0
        while cls is not None and depth < 6:
            for name in names:
                try:
                    field = cls.getDeclaredField(name)
                    field.setAccessible(True)
                    tid = _int(field.get(fragment))
                    if tid:
                        return tid
                except Exception:
                    pass
            try:
                cls = cls.getSuperclass()
            except Exception:
                cls = None
            depth += 1
        return 0

    def _topic_title(self, dialog_id, topic_id):
        try:
            controller = get_messages_controller()
            topics_controller = getattr(controller, 'getTopicsController', None)
            tc = topics_controller() if topics_controller is not None else None
            if tc is None:
                tc = getattr(controller, 'topicsController', None)
            if tc is not None:
                topic = tc.findTopic(-int(dialog_id), int(topic_id))
                if topic is not None:
                    title = str(getattr(topic, 'title', '') or '')
                    if title:
                        return title
        except Exception:
            pass
        if int(topic_id) == GENERAL_TOPIC_ID:
            return 'General'
        return 'Топик %s' % topic_id

    def _chat_title(self, dialog_id):
        chat = self._chat(dialog_id)
        try:
            return str(getattr(chat, 'title', '') or dialog_id) if chat else str(dialog_id)
        except Exception:
            return str(dialog_id)

    def _resolve(self, context):
        dialog_id = self._dialog_id_from_context(context)
        if dialog_id == 0:
            BulletinHelper.show_error(_tr('err_no_chat'))
            return (None, None)
        if not self._is_forum(dialog_id):
            BulletinHelper.show_error(_tr('err_not_forum'))
            return (None, None)
        topic_id = self._topic_id_from_context(context)
        if topic_id <= 0:
            topic_id = GENERAL_TOPIC_ID
        return (dialog_id, topic_id)

    def _toggle(self, context, flag, on_text, off_text):
        dialog_id, topic_id = self._resolve(context)
        if dialog_id is None:
            return
        key = self._key(dialog_id, topic_id)
        entry = self._hft_entries.get(key)
        if entry is None:
            entry = {'n': False, 'h': False, 't': self._topic_title(dialog_id, topic_id), 'c': self._chat_title(dialog_id)}
            self._hft_entries[key] = entry
        entry[flag] = not bool(entry.get(flag, False))
        state = entry[flag]
        if not entry.get('n', False) and (not entry.get('h', False)):
            self._hft_entries.pop(key, None)
        self._save_entries()
        self._notify_topics_changed(dialog_id)
        if state:
            BulletinHelper.show_info(on_text)
            if flag == 'n':
                run_on_ui_thread(lambda: self._mark_read(dialog_id, topic_id, 0))
        else:
            BulletinHelper.show_info(off_text)

    def _on_toggle_notify(self, context):
        self._toggle(context, 'n', _tr('notify_on'), _tr('notify_off'))

    def _on_toggle_hide(self, context):
        self._toggle(context, 'h', _tr('hide_on'), _tr('hide_off'))

    def create_settings(self):
        global _LAST_LANG
        lang = _get_lang()
        _LAST_LANG = lang

        def tr(key):
            return STRINGS.get(lang, STRINGS['en']).get(key, key)
        if not hasattr(self, '_hft_entries'):
            self._load_entries()
        items = [Header(text=tr('header_main')), Switch(key='enabled', text=tr('enabled_title'), subtext=tr('enabled_sub'), default=True), Divider(text=tr('hint')), Header(text=tr('header_topics'))]
        if not self._hft_entries:
            items.append(Text(text=tr('empty_title'), subtext=tr('empty_sub')))
            return items

        def remover(key):

            def on_click(view):
                self._hft_entries.pop(key, None)
                self._save_entries()
                try:
                    self._notify_topics_changed(int(key.split(':')[0]))
                except Exception:
                    pass
                BulletinHelper.show_info(tr('removed'))
            return on_click
        for key in sorted(self._hft_entries.keys()):
            entry = self._hft_entries[key]
            marks = []
            if entry.get('n', False):
                marks.append(tr('mark_muted'))
            if entry.get('h', False):
                marks.append(tr('mark_hidden'))
            items.append(Text(text='%s / %s' % (entry.get('c', '?'), entry.get('t', '?')), subtext='%s · %s' % (', '.join(marks) or tr('no_flags'), tr('tap_remove')), icon='msg_delete', red=True, on_click=remover(key)))
        return items
