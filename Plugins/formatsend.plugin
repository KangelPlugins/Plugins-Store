    "settings_enable": {"ru": "Включить FormatSend", "en": "Enable FormatSend"},
    "settings_language": {"ru": "Язык", "en": "Language"},
    "menu_title": {"ru": "Выберите формат", "en": "Choose format"},
    "menu_spoiler": {"ru": "Скрытый", "en": "Spoiler"},
    "menu_bold": {"ru": "Жирный", "en": "Bold"},
    "menu_italic": {"ru": "Курсив", "en": "Italic"},
    "menu_bold_italic": {"ru": "Жирный курсив", "en": "Bold Italic"},
    "menu_mono": {"ru": "Моноширинный", "en": "Monospace"},
    "menu_strike": {"ru": "Зачёркнутый", "en": "Strikethrough"},
    "menu_underline": {"ru": "Подчёркнутый", "en": "Underline"},
    "menu_quote": {"ru": "Цитата", "en": "Quote"},
    "menu_close": {"ru": "Закрыть", "en": "Close"},
    "bulletin_on": {"ru": "Форматирование включено", "en": "Formatting ON"},
    "bulletin_off": {"ru": "Форматирование выключено", "en": "Formatting OFF"},
    "bulletin_selected": {"ru": "Выбрано", "en": "Selected"},
    "settings_about": {"ru": "О плагине", "en": "About"},
    "about_text": {"ru": "FormatSend v1.2.3 — авто-форматирование сообщений.", "en": "FormatSend v1.2.3 — auto message formatting."},
}

MODE_CONFIG = [
    ("spoiler", ["msg_spoiler", "msg2_spoiler", "ic_spoiler", "msg_text_spoiler"]),
    ("bold", ["msg_text_bold", "ic_bold", "msg_bold", "ic_text_bold"]),
    ("italic", ["msg_text_italic", "ic_italic", "msg_italic", "ic_text_italic"]),
    ("bold_italic", ["msg_text_bold", "ic_bold", "msg_bold"]),
    ("mono", ["msg_text_monospace", "ic_code", "msg_code", "ic_text_monospace", "msg_mono"]),
    ("strike", ["msg_text_strikethrough", "ic_strikethrough", "msg_strike", "ic_text_strikethrough"]),
    ("underline", ["msg_text_underline", "ic_underline", "msg_underline", "ic_text_underline"]),
    ("quote", ["msg_text_quote", "ic_quote", "msg_quote", "ic_text_quote"]),
]

MODE_LETTERS = {
    "bold":        {"ru": "Ж",  "en": "B"},
    "italic":      {"ru": "К",  "en": "I"},
    "bold_italic": {"ru": "ЖК", "en": "BI"},
    "mono":        {"ru": "М",  "en": "M"},
    "strike":      {"ru": "З",  "en": "S"},
    "underline":   {"ru": "П",  "en": "U"},
    "quote":       {"ru": "Ц",  "en": "Q"},
}

def _getf(obj, name, d=None):
    try:
        if not obj or not name: return d
        c = obj.getClass()
        while c:
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                return f.get(obj)
            except: pass
            try: c = c.getSuperclass()
            except: c = None
        return d
    except: return d

class FormatCreateHook(MethodHook):
    def __init__(self, p): self.p = p
    def after_hooked_method(self, param):
        try:
            f = param.thisObject
            run_on_ui_thread(lambda: self.p._attach(f))
            run_on_ui_thread(lambda: self.p._stab(f))
        except Exception as e: self.p._log("create: " + str(e))

class FormatResumeHook(MethodHook):
    def __init__(self, p): self.p = p
    def after_hooked_method(self, param):
        try:
            f = param.thisObject
            run_on_ui_thread(lambda: self.p._attach(f))
            run_on_ui_thread(lambda: self.p._stab(f))
        except Exception as e: self.p._log("resume: " + str(e))

class FormatPauseHook(MethodHook):
    def __init__(self, p): self.p = p
    def after_hooked_method(self, param):
        try: run_on_ui_thread(self.p._detach)
        except Exception as e: self.p._log("pause: " + str(e))

class FormatSendPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hooks = []
        self._btn = None
        self._icon = None
        self._frag = None
        self._did = 0
        self._retry = set()
        self._mode_dialog = None

    def _log(self, m):
        try: log("[FormatSend] " + str(m))
        except: pass

    def _lang(self):
        try:
            idx = int(self.get_setting("formatsend_lang", 0) or 0)
            return "en" if idx == 1 else "ru"
        except: return "ru"

    def _tr(self, key):
        try:
            return STRINGS.get(key, {}).get(self._lang(), key)
        except: return key

    def _on(self):
        try: return bool(self.get_setting("formatsend_enabled", True))
        except: return True

    def _did_from(self, params=None, fragment=None):
        try:
            if params:
                for k in ("peer", "dialog_id", "dialogId", "peer_id"):
                    try:
                        v = getattr(params, k, None)
                        if v is not None:
                            return int(v)
                    except: pass
            if fragment and hasattr(fragment, "getDialogId"):
                try:
                    d = int(fragment.getDialogId() or 0)
                    if d: return d
                except: pass
            try:
                from client_utils import get_last_fragment
                f = get_last_fragment()
                if f and hasattr(f, "getDialogId"):
                    d = int(f.getDialogId() or 0)
                    if d: return d
            except: pass
        except: pass
        return getattr(self, "_did", 0) or 0

    def _prefs(self):
        try:
            r = self.get_setting("formatsend_chat_prefs", {}) or {}
            return r if isinstance(r, dict) else {}
        except: return {}

    def _save_prefs(self, p):
        try: self.set_setting("formatsend_chat_prefs", p if isinstance(p, dict) else {})
        except: pass

    def _cfg(self, did):
        p = self._prefs()
        k = str(int(did or 0))
        c = p.get(k) or {}
        if not isinstance(c, dict): c = {}
        return {"enabled": bool(c.get("enabled", False)), "mode": str(c.get("mode", "spoiler"))}

    def _set_cfg(self, did, enabled=None, mode=None):
        try:
            did = int(did or 0)
            if not did: return
            p = self._prefs()
            k = str(did)
            c = p.get(k) or {}
            if not isinstance(c, dict): c = {}
            if enabled is not None: c["enabled"] = bool(enabled)
            if mode is not None: c["mode"] = str(mode)
            p[k] = c
            self._save_prefs(p)
        except Exception as e: self._log("set: " + str(e))

    def _find_drawable(self, names):
        try:
            pkg = ApplicationLoader.applicationContext.getPackageName()
            res = ApplicationLoader.applicationContext.getResources()
            for name in names:
                try:
                    rid = res.getIdentifier(name, "drawable", pkg)
                    if rid: return rid
                except: pass
        except: pass
        return 0

    def _mode_icon_names(self, mode):
        for m, names in MODE_CONFIG:
            if m == mode: return names
        return ["msg_spoiler"]

    def _mode_letter(self, mode):
        return MODE_LETTERS.get(mode, {}).get(self._lang(), "?")

    def _apply_text_style(self, tv, mode):
        try:
            if mode == "bold":
                tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"), Typeface.BOLD)
            elif mode == "italic":
                tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"), Typeface.ITALIC)
            elif mode == "bold_italic":
                tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"), Typeface.BOLD_ITALIC)
            elif mode == "mono":
                tv.setTypeface(Typeface.MONOSPACE)
            else:
                tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except: pass
        try:
            flags = tv.getPaintFlags()
            flags &= ~Paint.STRIKE_THRU_TEXT_FLAG
            flags &= ~Paint.UNDERLINE_TEXT_FLAG
            if mode == "strike":
                flags |= Paint.STRIKE_THRU_TEXT_FLAG
            elif mode == "underline":
                flags |= Paint.UNDERLINE_TEXT_FLAG
            tv.setPaintFlags(flags)
        except: pass

    def _mkicon(self, ctx, mode="spoiler"):
        if mode == "spoiler":
            iv = ImageView(ctx)
            names = self._mode_icon_names(mode)
            rid = self._find_drawable(names)
            if not rid: rid = self._find_drawable(["msg_spoiler", "msg_edit"])
            if rid:
                try: iv.setImageResource(rid)
                except: pass
            try: iv.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            except: pass
            return iv
        else:
            tv = TextView(ctx)
            tv.setText(self._mode_letter(mode))
            tv.setGravity(Gravity.CENTER)
            try: tv.setTextSize(14)
            except: pass
            self._apply_text_style(tv, mode)
            return tv

    def _update_icon(self, mode):
        try:
            if self._icon is None or self._btn is None: return
            parent = self._btn
            if mode == "spoiler":
                if not isinstance(self._icon, ImageView):
                    parent.removeView(self._icon)
                    new_icon = self._mkicon(parent.getContext(), mode)
                    parent.addView(new_icon, FrameLayout.LayoutParams(AndroidUtilities.dp(24), AndroidUtilities.dp(24), Gravity.CENTER))
                    self._icon = new_icon
                    self._refresh()
                    return
                names = self._mode_icon_names(mode)
                rid = self._find_drawable(names)
                if not rid: rid = self._find_drawable(["msg_spoiler", "msg_edit"])
                if rid:
                    try:
                        self._icon.setImageResource(rid)
                        self._icon.invalidate()
                    except Exception as e: self._log("setImageResource: " + str(e))
            else:
                if isinstance(self._icon, ImageView):
                    parent.removeView(self._icon)
                    new_icon = self._mkicon(parent.getContext(), mode)
                    parent.addView(new_icon, FrameLayout.LayoutParams(AndroidUtilities.dp(24), AndroidUtilities.dp(24), Gravity.CENTER))
                    self._icon = new_icon
                    self._refresh()
                    return
                if isinstance(self._icon, TextView):
                    self._icon.setText(self._mode_letter(mode))
                    self._apply_text_style(self._icon, mode)
                    self._icon.invalidate()
        except Exception as e: self._log("update_icon: " + str(e))

    def _color(self, fragment, icon):
        try:
            did = self._did_from(fragment=fragment)
            c = self._cfg(did)
            if c["enabled"]:
                try: col = int(Theme.getColor(Theme.key_featuredStickers_addButton))
                except: col = 0xFF38A8FF
            else:
                try: col = int(Theme.getColor(Theme.key_chat_messagePanelIcons))
                except: col = 0xFF8A8A8A
            if isinstance(icon, ImageView): icon.setColorFilter(col)
            elif isinstance(icon, TextView): icon.setTextColor(col)
        except: pass

    def _refresh(self):
        try:
            if self._btn and self._frag and self._icon:
                self._color(self._frag, self._icon)
        except: pass

    def _refresh_all(self):
        try:
            did = self._did_from(fragment=self._frag)
            cfg = self._cfg(did)
            run_on_ui_thread(lambda: self._update_icon(cfg["mode"]))
            run_on_ui_thread(self._refresh)
        except: pass

    def _retry_attach(self, fragment, reason="retry"):
        try:
            if not fragment: return
            k = str(id(fragment))
            if k in self._retry: return
            self._retry.add(k)
            from client_utils import run_on_queue
            def _w():
                try:
                    for _ in range(5):
                        time.sleep(0.22)
                        ok = {"v": False}
                        def _t():
                            try:
                                self._attach(fragment, True)
                                ok["v"] = self._btn is not None
                            except: pass
                        run_on_ui_thread(_t)
                        if ok["v"]: break
                finally:
                    try: self._retry.discard(k)
                    except: pass
            run_on_queue(_w)
            self._log("retry: " + reason)
        except Exception as e: self._log("retry: " + str(e))

    def _stab(self, fragment):
        try:
            if not fragment: return
            from client_utils import run_on_queue
            def _w():
                for _ in range(5):
                    time.sleep(0.28)
                    run_on_ui_thread(lambda: self._attach(fragment, True))
            run_on_queue(_w)
        except Exception as e: self._log("stab: " + str(e))

    def _attach(self, fragment, from_retry=False):
        try:
            if not fragment: return
            ev = _getf(fragment, "chatActivityEnterView")
            if not ev:
                if not from_retry: self._retry_attach(fragment, "no_ev")
                return
            host = None
            for fn in ("attachLayout", "sendButtonContainer", "textFieldContainer", "messageEditTextContainer", "messageContainer", "topView", "parentView"):
                try:
                    v = _getf(ev, fn)
                    if isinstance(v, ViewGroup):
                        host = v
                        break
                except: pass
            if not host:
                if not from_retry: self._retry_attach(fragment, "no_host")
                return
            try:
                for i in range(host.getChildCount()):
                    if host.getChildAt(i).getTag() == "formatsend_btn": return
            except: pass
            ctx = host.getContext()
            btn = FrameLayout(ctx)
            btn.setTag("formatsend_btn")
            did = self._did_from(fragment=fragment)
            cfg = self._cfg(did)
            icon = self._mkicon(ctx, cfg["mode"])
            btn.addView(icon, FrameLayout.LayoutParams(AndroidUtilities.dp(24), AndroidUtilities.dp(24), Gravity.CENTER))
            
            class _Click(dynamic_proxy(View.OnClickListener)):
                def __init__(self_obj, p, f):
                    super().__init__()
                    self_obj.p = p
                    self_obj.f = f
                def onClick(self_obj, v):
                    try:
                        d = self_obj.p._did_from(fragment=self_obj.f)
                        c = self_obj.p._cfg(d)
                        new_en = not c["enabled"]
                        self_obj.p._set_cfg(d, enabled=new_en)
                        self_obj.p._refresh()
                        BulletinHelper.show_info(self_obj.p._tr("bulletin_on") if new_en else self_obj.p._tr("bulletin_off"))
                    except Exception as e: self_obj.p._log("click: " + str(e))
            
            class _LongClick(dynamic_proxy(View.OnLongClickListener)):
                def __init__(self_obj, p, f):
                    super().__init__()
                    self_obj.p = p
                    self_obj.f = f
                def onLongClick(self_obj, v):
                    try:
                        self_obj.p._show_menu(v.getContext())
                        return True
                    except Exception as e:
                        self_obj.p._log("long: " + str(e))
                        return False
            
            btn.setOnClickListener(_Click(self, fragment))
            btn.setOnLongClickListener(_LongClick(self, fragment))
            try:
                bg = Theme.createSelectorDrawable(int(Theme.getColor(Theme.key_listSelector)), 1, AndroidUtilities.dp(14))
                btn.setBackground(bg)
            except: pass
            
            lp = LinearLayout.LayoutParams(AndroidUtilities.dp(34), AndroidUtilities.dp(34))
            lp.gravity = Gravity.CENTER_VERTICAL
            lp.rightMargin = AndroidUtilities.dp(4)
            host.addView(btn, 0, lp)
            
            self._btn = btn
            self._icon = icon
            self._frag = fragment
            self._did = int(did or 0)
            self._refresh()
        except Exception as e: self._log("attach: " + str(e))

    def _detach(self):
        try:
            if self._btn and self._btn.getParent():
                self._btn.getParent().removeView(self._btn)
            self._btn = None
            self._icon = None
        except: pass

    def _show_menu(self, ctx):
        try:
            from client_utils import get_last_fragment
            frag = self._frag or get_last_fragment()
            did = self._did_from(fragment=frag)
            cfg = self._cfg(did)
            cur_mode = cfg["mode"]
            builder = AlertDialogBuilder(ctx)
            builder.set_title(self._tr("menu_title"))
            scroll = ScrollView(ctx)
            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(8), AndroidUtilities.dp(16), AndroidUtilities.dp(8))
            
            mode_labels = {
                "spoiler": self._tr("menu_spoiler"),
                "bold": self._tr("menu_bold"),
                "italic": self._tr("menu_italic"),
                "bold_italic": self._tr("menu_bold_italic"),
                "mono": self._tr("menu_mono"),
                "strike": self._tr("menu_strike"),
                "underline": self._tr("menu_underline"),
                "quote": self._tr("menu_quote"),
            }
            
            for mode, _ in MODE_CONFIG:
                row = LinearLayout(ctx)
                row.setOrientation(LinearLayout.HORIZONTAL)
                row.setGravity(Gravity.CENTER_VERTICAL)
                row.setPadding(0, AndroidUtilities.dp(10), 0, AndroidUtilities.dp(10))
                bg = Theme.createSelectorDrawable(int(Theme.getColor(Theme.key_listSelector)), 0)
                row.setBackground(bg)
                
                if mode == "spoiler":
                    iv = ImageView(ctx)
                    rid = self._find_drawable(self._mode_icon_names(mode))
                    if not rid: rid = self._find_drawable(["msg_spoiler", "msg_edit"])
                    if rid: iv.setImageResource(rid)
                    iv.setColorFilter(int(Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon)))
                    row.addView(iv, LinearLayout.LayoutParams(AndroidUtilities.dp(28), AndroidUtilities.dp(28)))
                else:
                    tv_icon = TextView(ctx)
                    tv_icon.setText(MODE_LETTERS.get(mode, {}).get(self._lang(), "?"))
                    tv_icon.setGravity(Gravity.CENTER)
                    tv_icon.setTextSize(14)
                    tv_icon.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon)))
                    self._apply_text_style(tv_icon, mode)
                    row.addView(tv_icon, LinearLayout.LayoutParams(AndroidUtilities.dp(28), AndroidUtilities.dp(28)))
                
                lbl = TextView(ctx)
                lbl.setText(mode_labels.get(mode, mode))
                lbl.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)))
                lbl.setTextSize(16)
                lbl.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                lp_lbl = LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT)
                lp_lbl.leftMargin = AndroidUtilities.dp(16)
                row.addView(lbl, lp_lbl)
                
                mark = TextView(ctx)
                mark.setText(" ✓" if mode == cur_mode else "")
                mark.setTextColor(int(Theme.getColor(Theme.key_featuredStickers_addButton)))
                mark.setTextSize(16)
                mark.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                lp_mark = LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT)
                lp_mark.leftMargin = AndroidUtilities.dp(8)
                row.addView(mark, lp_mark)
                
                class _Pick(dynamic_proxy(View.OnClickListener)):
                    def __init__(self_obj, p, d_id, m):
                        super().__init__()
                        self_obj.p = p
                        self_obj.d_id = d_id
                        self_obj.m = m
                    def onClick(self_obj, v):
                        try:
                            self_obj.p._set_cfg(self_obj.d_id, mode=self_obj.m)
                            self_obj.p._update_icon(self_obj.m)
                            self_obj.p._refresh()
                            BulletinHelper.show_success(self_obj.p._tr("bulletin_selected") + ": " + mode_labels.get(self_obj.m, ""))
                        except Exception as e: self_obj.p._log("pick: " + str(e))
                        try:
                            md = getattr(self_obj.p, "_mode_dialog", None)
                            if md: md.dismiss()
                        except: pass
                
                row.setOnClickListener(_Pick(self, did, mode))
                root.addView(row, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT))
            
            scroll.addView(root)
            builder.set_view(scroll)
            builder.set_negative_button(self._tr("menu_close"), lambda d, w: d.dismiss() if d else None)
            self._mode_dialog = builder.show()
        except Exception as e: self._log("menu: " + str(e))

    def _get_entity_class(self, name):
        try: return find_class("org.telegram.tgnet.TLRPC$TL_messageEntity" + name)
        except: pass
        try: return find_class("org.telegram.tgnet.TLRPC$MessageEntity" + name)
        except: pass
        return None

    def _add_entity(self, params, text, entity):
        try:
            existing = getattr(params, "entities", None)
            if existing is not None and hasattr(existing, "add"):
                existing.add(entity)
                return True
            params.entities = ArrayList()
            params.entities.add(entity)
            return True
        except Exception as e: self._log("add ent: " + str(e))
        return False

    def _make_entity(self, cls, offset, length):
        try:
            ent = cls()
            ent.offset = offset
            ent.length = length
            return ent
        except Exception as e:
            self._log("make ent: " + str(e))
            return None

    def _apply_format(self, params, text, mode):
        try:
            if mode == "spoiler":
                cls = self._get_entity_class("Spoiler")
                if cls:
                    ent = self._make_entity(cls, 0, len(text))
                    if ent and self._add_entity(params, text, ent): return True
                params.message = "||" + text + "||"
                return True
            elif mode == "bold":
                cls = self._get_entity_class("Bold")
                if cls:
                    ent = self._make_entity(cls, 0, len(text))
                    if ent and self._add_entity(params, text, ent): return True
                params.message = "**" + text + "**"
                return True
            elif mode == "italic":
                cls = self._get_entity_class("Italic")
                if cls:
                    ent = self._make_entity(cls, 0, len(text))
                    if ent and self._add_entity(params, text, ent): return True
                params.message = "__" + text + "__"
                return True
            elif mode == "bold_italic":
                b_cls = self._get_entity_class("Bold")
                i_cls = self._get_entity_class("Italic")
                if b_cls and i_cls:
                    b_ent = self._make_entity(b_cls, 0, len(text))
                    i_ent = self._make_entity(i_cls, 0, len(text))
                    if b_ent and i_ent:
                        self._add_entity(params, text, b_ent)
                        self._add_entity(params, text, i_ent)
                        return True
                params.message = "***" + text + "***"
                return True
            elif mode == "mono":
                cls = self._get_entity_class("Code")
                if cls:
                    ent = self._make_entity(cls, 0, len(text))
                    if ent and self._add_entity(params, text, ent): return True
                params.message = "`" + text + "`"
                return True
            elif mode == "strike":
                cls = self._get_entity_class("Strike")
                if cls:
                    ent = self._make_entity(cls, 0, len(text))
                    if ent and self._add_entity(params, text, ent): return True
                params.message = "~~" + text + "~~"
                return True
            elif mode == "underline":
                cls = self._get_entity_class("Underline")
                if cls:
                    ent = self._make_entity(cls, 0, len(text))
                    if ent and self._add_entity(params, text, ent): return True
                params.message = "--" + text + "--"
                return True
            elif mode == "quote":
                cls = self._get_entity_class("Blockquote")
                if cls:
                    ent = self._make_entity(cls, 0, len(text))
                    if ent and self._add_entity(params, text, ent): return True
                lines = text.splitlines()
                out = ["> " + ln for ln in lines]
                params.message = chr(10).join(out)
                return True
        except Exception as e: self._log("apply: " + str(e))
        return False

    def create_settings(self):
        try: lang_idx = int(self.get_setting("formatsend_lang", 0) or 0)
        except: lang_idx = 0
        return [
            Header(text="FormatSend"),
            Divider(),
            Switch(key="formatsend_enabled", text=self._tr("settings_enable"), default=True, icon="msg_spoiler", on_change=lambda v: [BulletinHelper.show_info(self._tr("bulletin_on") if v else self._tr("bulletin_off")), self._refresh_all()]),
            Selector(key="formatsend_lang", text=self._tr("settings_language"), items=["Русский", "English"], default=lang_idx, icon="msg_language", on_change=lambda i: self._refresh_all()),
            Divider(),
            Text(text=self._tr("settings_about"), icon="msg_info", on_click=lambda _v: BulletinHelper.show_info(self._tr("about_text"))),
        ]

    def _setup_hooks(self):
        try:
            cls = JClass.forName("org.telegram.ui.ChatActivity")
            cc = find_class("android.content.Context")
            m_create = cls.getDeclaredMethod("createView", cc)
            m_create.setAccessible(True)
            self._hooks.append(self.hook_method(m_create, FormatCreateHook(self)))
            
            m_resume = cls.getDeclaredMethod("onResume")
            m_resume.setAccessible(True)
            self._hooks.append(self.hook_method(m_resume, FormatResumeHook(self)))
            
            m_pause = cls.getDeclaredMethod("onPause")
            m_pause.setAccessible(True)
            self._hooks.append(self.hook_method(m_pause, FormatPauseHook(self)))
            self._log("hooks setup ok")
        except Exception as e: self._log("hooks error: " + str(e))

    def on_plugin_load(self):
        self._log("load")
        try: self.add_on_send_message_hook()
        except Exception as e: self._log("send hook: " + str(e))
        self._setup_hooks()

    def on_plugin_unload(self):
        self._log("unload")
        try:
            for h in list(self._hooks):
                try: self.unhook_method(h)
                except: pass
            self._hooks = []
        except: pass
        try:
            md = getattr(self, "_mode_dialog", None)
            if md: md.dismiss()
        except: pass
        try: run_on_ui_thread(self._detach)
        except: pass

    def on_send_message_hook(self, account, params):
        try:
            if not self._on(): return HookResult()
            text = str(getattr(params, "message", "") or "").strip()
            if not text: return HookResult()
            did = self._did_from(params=params, fragment=self._frag)
            if not did: return HookResult()
            cfg = self._cfg(did)
            if not cfg.get("enabled", False): return HookResult()
            mode = str(cfg.get("mode", "spoiler"))
            if self._apply_format(params, text, mode):
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            return HookResult()
        except Exception as e:
            self._log("hook: " + str(e))
            return HookResult()
