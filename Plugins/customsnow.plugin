import base64
import zlib

from base_plugin import BasePlugin
from client_utils import get_last_fragment
from hook_utils import find_class
from java import dynamic_proxy, jclass
from ui.settings import Custom, Divider, Header, Selector, Switch, Text

__id__ = "custom_snow"
__name__ = "Custom Snow"
__description__ = "Customize Telegram snow particles with sakura, matrix, rain, and autumn leaves."
__author__ = "@mraniv & @anivplugins"
__version__ = "1.0.0"
__icon__ = "LittleGirl56/9"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.0"

ENTRY_CLASS = "com.exteragram.plugins.customsnow.CustomSnowCore"
DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"

BuildVersion = jclass("android.os.Build$VERSION")
_Integer = None


def java_integer():
    global _Integer
    if _Integer is None:
        _Integer = jclass("java.lang.Integer")
    return _Integer


def as_java_color(color: int) -> int:
    color = int(color) & 0xFFFFFFFF
    return color - 0x100000000 if color >= 0x80000000 else color


def call_int_color(target, method_name: str, color: int):
    try:
        method = target.getClass().getMethod(method_name, java_integer().TYPE)
        return method.invoke(target, java_integer()(as_java_color(color)))
    except Exception:
        try:
            return getattr(target, method_name)(as_java_color(color))
        except Exception:
            pass


def is_russian_locale() -> bool:
    try:
        LocaleController = jclass("org.telegram.messenger.LocaleController")
        lang = str(LocaleController.getInstance().getCurrentLocale().getLanguage()).lower()
        return lang.startswith(("ru", "be", "uk"))
    except Exception:
        return False


def tr(ru_text: str, en_text: str) -> str:
    return ru_text if is_russian_locale() else en_text


class DexLoader:
    """Helper class to load embedded DEX payload safely."""

    def __init__(self, entry_class: str):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            if ctx is None:
                raise RuntimeError("Application context is not ready")
            if BuildVersion.SDK_INT < 26:
                raise RuntimeError("Embedded DEX requires Android API 26+")
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            loader = InMemoryDexClassLoader(ByteBuffer.wrap(self._read_payload()), ctx.getClassLoader())
            self.clazz = loader.loadClass(self.entry_class)
        try:
            self._invoke("load")
            self.loaded = True
        except Exception:
            try:
                self._invoke("unload")
            except Exception:
                pass
            self.loaded = False
            raise

    def unload(self):
        try:
            if self.clazz is not None and self.loaded:
                self._invoke("unload")
        except Exception:
            pass
        self.loaded = False

    def call(self, method_name: str, *args):
        if self.clazz is None or (method_name not in ("load", "unload") and not self.loaded):
            self.load()
        return self._invoke(method_name, *args)

    def _invoke(self, method_name: str, *args):
        if self.clazz is None:
            raise RuntimeError("Core class is not loaded")
        matches = []
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) != method_name or len(method.getParameterTypes()) != len(args):
                continue
            method.setAccessible(True)
            matches.append(method)
        if len(matches) > 1:
            raise RuntimeError(f"Ambiguous core method: {method_name}/{len(args)}")
        if matches:
            return matches[0].invoke(None, *args)
        raise RuntimeError(f"Core method not found: {method_name}/{len(args)}")

    def _read_payload(self) -> bytes:
        try:
            with open(__file__, "r", encoding="utf-8") as source:
                text = source.read()
            block = text.split(f"# {DEX_BEGIN}", 1)[1].split(f"# {DEX_END}", 1)[0]
            payload = "".join(line.strip()[1:].strip() for line in block.splitlines() if line.strip().startswith("#"))
        except Exception as exc:
            raise RuntimeError(f"Failed to read DEX payload: {exc}")

        if not payload:
            raise RuntimeError("DEX payload block is empty")

        try:
            return zlib.decompress(base64.b64decode(payload))
        except Exception as exc:
            raise RuntimeError(f"Failed to decode DEX payload: {exc}")


class CustomSnowPlugin(BasePlugin):
    """ExteraGram plugin for custom snow particle effects."""

    def on_plugin_load(self):
        self.dex = DexLoader(ENTRY_CLASS)
        self._row_context = None
        self._row_views = {}
        self._row_refresh = {}
        self._settings_refs = []
        try:
            self.dex.load()
            force_snow = self.get_setting("always_enable", True)
            self._set_extera_force_snow(bool(force_snow))
            self._sync_settings()
            self._invalidate_active_ui()
        except Exception as e:
            self.log(f"Plugin load error: {e}")

    def on_plugin_unload(self):
        if hasattr(self, "dex") and self.dex:
            self.dex.unload()

    def _invalidate_active_ui(self):
        try:
            fragment = get_last_fragment()
            if fragment is not None and hasattr(fragment, "getFragmentView"):
                view = fragment.getFragmentView()
                if view is not None:
                    view.invalidate()
            context = self._get_active_context()
            if context is not None and hasattr(context, "getWindow"):
                decor = context.getWindow().getDecorView()
                if decor is not None:
                    decor.invalidate()
        except Exception:
            pass

    def _get_active_context(self):
        fragment = get_last_fragment()
        if fragment is None:
            return None
        try:
            return fragment.getParentActivity()
        except Exception:
            return None

    def _get_resources_provider(self):
        fragment = get_last_fragment()
        if fragment is None:
            return None
        try:
            if hasattr(fragment, "getResourceProvider"):
                return fragment.getResourceProvider()
        except Exception:
            pass
        try:
            return getattr(fragment, "resourcesProvider", None)
        except Exception:
            return None

    def _settings_theme_color(self, key, resources_provider=None, fallback: int = 0xFF000000) -> int:
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        try:
            if resources_provider is not None:
                return as_java_color(Theme.getColor(key, resources_provider))
        except Exception:
            pass
        try:
            return as_java_color(Theme.getColor(key))
        except Exception:
            return as_java_color(fallback)

    def _settings_text(self, context, text: str, size_dp: int, color: int, bold: bool = False):
        TextView = jclass("android.widget.TextView")
        TypedValue = jclass("android.util.TypedValue")
        AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")

        view = TextView(context)
        view.setText(str(text))
        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, int(size_dp))
        call_int_color(view, "setTextColor", color)
        if bold:
            try:
                view.setTypeface(AndroidUtilities.bold())
            except Exception:
                pass
        return view

    def _create_slider_row(self, context, resources_provider, key: str, title: str, default, min_val, max_val, suffix: str = "", decimals: int = 0):
        LinearLayout = jclass("android.widget.LinearLayout")
        Gravity = jclass("android.view.Gravity")
        AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        SeekBarView = jclass("org.telegram.ui.Components.SeekBarView")
        LayoutHelper = jclass("org.telegram.ui.Components.LayoutHelper")

        min_float = float(min_val)
        max_float = float(max_val)

        def get_current_value():
            val = self.get_setting(key, str(default))
            try:
                return float(val)
            except Exception:
                return float(default)

        def format_value_str(val):
            if decimals <= 0:
                text = str(int(round(float(val))))
            else:
                text = f"{float(val):.{decimals}f}"
            return f"{text} {suffix}" if suffix else text

        def progress_to_val(p):
            raw = min_float + (max_float - min_float) * float(p)
            if decimals <= 0:
                return int(round(raw))
            step = 10 ** decimals
            return round(raw * step) / step

        def val_to_progress(val):
            if max_float == min_float:
                return 0.0
            return (float(val) - min_float) / (max_float - min_float)

        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setPadding(AndroidUtilities.dp(21), AndroidUtilities.dp(10), AndroidUtilities.dp(21), AndroidUtilities.dp(12))

        header_row = LinearLayout(context)
        header_row.setOrientation(LinearLayout.HORIZONTAL)
        header_row.setGravity(Gravity.CENTER_VERTICAL)

        title_color = self._settings_theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider, 0xFF111111)
        title_view = self._settings_text(context, title, 16, title_color)
        header_row.addView(title_view, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0))

        value_color = self._settings_theme_color(Theme.key_windowBackgroundWhiteBlueText, resources_provider, 0xFF3390EC)
        value_view = self._settings_text(context, format_value_str(get_current_value()), 14, value_color, True)
        header_row.addView(value_view, LayoutHelper.createLinear(-2, -2))
        root.addView(header_row, LayoutHelper.createLinear(-1, -2))

        seek_bar = SeekBarView(context, resources_provider)
        seek_bar.setReportChanges(True)
        try:
            track_color = self._settings_theme_color(Theme.key_switchTrack, resources_provider, 0x33000000)
            accent_color = self._settings_theme_color(Theme.key_windowBackgroundWhiteBlueText, resources_provider, 0xFF3390EC)
            seek_bar.setColors(track_color, accent_color)
        except Exception:
            pass
        root.addView(seek_bar, LayoutHelper.createLinear(-1, 38, 0, 2, 0, 0, 0))

        delegate_cls = jclass("org.telegram.ui.Components.SeekBarView$SeekBarViewDelegate")

        class _SliderDelegate(dynamic_proxy(delegate_cls)):
            def onSeekBarDrag(this, stop, progress):
                val = progress_to_val(progress)
                val = max(min_float, min(max_float, float(val)))
                setting_str = str(int(round(val))) if decimals <= 0 else f"{val:.{decimals}f}"
                try:
                    value_view.setText(format_value_str(val))
                except Exception:
                    pass
                self.set_setting(key, setting_str)
                self._sync_settings()

            def onSeekBarPressed(this, pressed):
                return None

            def getContentDescription(this):
                return f"{title}: {format_value_str(get_current_value())}"

            def getStepsCount(this):
                return int(max_float - min_float) if decimals <= 0 else int((max_float - min_float) * (10 ** decimals))

            def needVisuallyDivideSteps(this):
                return False

        delegate = _SliderDelegate()
        self._settings_refs.append(delegate)

        def refresh_row():
            try:
                curr = get_current_value()
                value_view.setText(format_value_str(curr))
                seek_bar.setProgress(float(val_to_progress(curr)))
            except Exception:
                pass

        self._row_refresh[key] = refresh_row
        seek_bar.setDelegate(delegate)
        seek_bar.setProgress(float(val_to_progress(get_current_value())))

        return root

    def create_settings(self):
        UItem = jclass("org.telegram.ui.Components.UItem")
        context = self._get_active_context()
        resources_provider = self._get_resources_provider()

        if self._row_context != context:
            self._row_context = context
            self._row_views = {}
            self._row_refresh = {}
            self._settings_refs = []

        def build_custom_row(key: str, builder, *args):
            if context is None:
                return None
            view = self._row_views.get(key)
            if view is None:
                try:
                    view = builder(context, resources_provider, key, *args)
                except Exception as err:
                    self.log(f"Failed to create settings row '{key}': {err}")
                    return None
                self._row_views[key] = view
            else:
                refresh = self._row_refresh.get(key)
                if refresh is not None:
                    refresh()
            row_id = as_java_color(zlib.crc32(key.encode()) & 0x7FFFFFFF)
            return Custom(item=UItem.asCustom(row_id, view))

        def add_slider(key: str, title: str, default, min_val, max_val, suffix: str = "", decimals: int = 0):
            return build_custom_row(key, self._create_slider_row, title, default, min_val, max_val, suffix, decimals)

        current_force_snow = self._get_extera_force_snow()

        particle_items = [
            tr("Снежинки", "Snowflakes"),
            tr("Сакура", "Sakura"),
            tr("Матрица", "Matrix"),
            tr("Дождик", "Rain"),
            tr("Осенний листопад", "Autumn Leaves"),
        ]

        items = [
            Switch(
                key="always_enable",
                text=tr("Включить частицы", "Enable particles"),
                default=current_force_snow,
                on_change=self._on_settings_changed,
            ),
            Divider(),
            Selector(
                key="particle_mode",
                text=tr("Вид частиц", "Particle type"),
                items=particle_items,
                default=1,
                on_change=self._on_settings_changed,
            ),
            Header(text=tr("Настройка частиц", "Particle Settings")),
        ]

        sliders = [
            add_slider("particle_count", tr("Количество частиц", "Particle count"), 100, 20, 300),
            add_slider("particle_alpha", tr("Прозрачность частиц", "Particle opacity"), 100, 10, 100, "%", 0),
            add_slider("particle_speed", tr("Скорость падения частиц", "Fall speed"), 1.0, 0.2, 3.0, "x", 1),
            add_slider("rotation_speed", tr("Скорость вращения", "Rotation speed"), 1.0, 0.2, 3.0, "x", 1),
        ]

        for s in sliders:
            if s is not None:
                items.append(s)

        items.extend([
            Divider(),
            Text(
                text="@mraniv & @anivplugins",
                subtext=tr("автор, нажмите чтобы подписаться", "author, tap to subscribe"),
                icon="msg_info",
                on_click=self._open_author_channel,
            ),
        ])

        return items

    def _on_settings_changed(self, value=None):
        self._sync_settings()

    def _get_extera_force_snow(self) -> bool:
        possible_classes = (
            "com.exteragram.messenger.ExteraConfig",
            "org.telegram.messenger.ExteraConfig",
            "com.radolyn.ayugram.ExteraConfig",
            "org.telegram.messenger.web.ExteraConfig",
        )
        for class_name in possible_classes:
            try:
                cls = jclass(class_name)
                for getter in ("getForceSnow", "isForceSnow"):
                    try:
                        m = getattr(cls, getter)
                        return bool(m())
                    except Exception:
                        pass
                try:
                    field = cls.getDeclaredField("forceSnow")
                    field.setAccessible(True)
                    return bool(field.getBoolean(None))
                except Exception:
                    pass
            except Exception:
                pass
        return self.get_setting("always_enable", True)

    def _set_extera_force_snow(self, enabled: bool):
        possible_classes = (
            "com.exteragram.messenger.ExteraConfig",
            "org.telegram.messenger.ExteraConfig",
            "com.exteragram.ExteraConfig",
            "org.telegram.messenger.exteragram.ExteraConfig",
        )
        for class_name in possible_classes:
            try:
                cls = jclass(class_name)
                try:
                    cls.setForceSnow(enabled)
                    return
                except Exception:
                    pass
                try:
                    field = cls.getDeclaredField("forceSnow")
                    field.setAccessible(True)
                    field.setBoolean(None, enabled)
                    return
                except Exception:
                    pass
            except Exception:
                pass

    def _sync_settings(self):
        mode = self.get_setting("particle_mode", 1)
        always = self.get_setting("always_enable", True)
        count = self.get_setting("particle_count", 100)
        speed = self.get_setting("particle_speed", 1.0)
        rot_speed = self.get_setting("rotation_speed", 1.0)
        alpha = self.get_setting("particle_alpha", 100)

        self._set_extera_force_snow(bool(always))

        if hasattr(self, "dex") and self.dex:
            try:
                self.dex.call("updateSettings", mode, always, count, speed, rot_speed, alpha)
            except Exception as exc:
                self.log(f"Settings sync failed: {exc}")

        self._invalidate_active_ui()

    def _open_author_channel(self, view=None):
        try:
            Browser = find_class("org.telegram.messenger.browser.Browser")
            context = (
                view.getContext()
                if view and hasattr(view, "getContext")
                else jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            )
            Browser.openUrl(context, "https://anivplugins.t.me")
        except Exception as err:
            self.log(f"Failed to open channel: {err}")

# __DEX_BEGIN__
