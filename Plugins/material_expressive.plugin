def text_setting(text, subtext="", **kwargs):
    label = str(text or "")
    detail = str(subtext or "").strip()
    if detail:
        try:
            return Text(text=label, subtext=detail, **kwargs)
        except TypeError:
            label = f"{label}: {detail}"
    return Text(text=label, **kwargs)


class DexLoader:
    def __init__(self, plugin: BasePlugin):
        self.plugin = plugin
        self.dex_class = None
        self.dex_loader = None
        self.version_code = 0
        self.version_name = ""

    def _run_on_ui_thread_sync(self, fn):
        runner = getattr(self.plugin, "_run_on_ui_thread_sync", None)
        if runner is not None:
            runner(fn)
        else:
            fn()

    def _decode_and_validate_dex(self) -> bytes:
        dex_bytes = base64.b64decode(DEX_BASE64, validate=True)
        if not dex_bytes.startswith(b"dex\n"):
            raise RuntimeError("неверный DEX magic")
        if len(dex_bytes) > MAX_DEX_BYTES:
            raise RuntimeError(f"неверный размер DEX: {len(dex_bytes)}")

        digest = hashlib.sha256(dex_bytes).hexdigest().lower()
        if digest != EXPECTED_DEX_SHA256:
            raise RuntimeError(f"SHA-256 DEX не совпадает: {digest}")
        return dex_bytes

    def _create_class_loader(self, dex_bytes: bytes):
        context = ApplicationLoader.applicationContext
        parent = context.getClassLoader()
        if int(Build.VERSION.SDK_INT) >= 26:
            loader_class = jclass("dalvik.system.InMemoryDexClassLoader")
            return loader_class(ByteBuffer.wrap(dex_bytes), parent)

        cache_root = str(context.getCodeCacheDir().getAbsolutePath())
        cache_dir = os.path.join(cache_root, DEX_CACHE_DIR)
        os.makedirs(cache_dir, exist_ok=True)
        dex_path = os.path.join(cache_dir, DEX_FILE_NAME)
        temp_path = dex_path + ".tmp"
        with open(temp_path, "wb") as output:
            output.write(dex_bytes)
        os.replace(temp_path, dex_path)

        loader_class = jclass("dalvik.system.DexClassLoader")
        return loader_class(dex_path, cache_dir, None, parent)

    def _invoke_static_method(self, method_name: str, *args):
        if self.dex_class is None:
            raise RuntimeError("DEX class not loaded")

        try:
            if args:
                if len(args) != 1 or not isinstance(args[0], str):
                    raise TypeError(f"Unsupported bridge args for {method_name}")
                String = jclass("java.lang.String")
                method = self.dex_class.getMethod(method_name, String)
                method.invoke(None, args[0])
            else:
                method = self.dex_class.getMethod(method_name)
                method.invoke(None)
        except Exception as e:
            if "NoSuchMethodException" in str(e):
                raise RuntimeError(
                    f"DEX missing {method_name}; rebuild {DEX_FILE_NAME} from updated MaterialExpressiveCore.java"
                ) from e
            raise

    def _validate_bridge_methods(self, dex_class):
        String = jclass("java.lang.String")
        dex_class.getMethod(DEX_START_BRIDGE)
        dex_class.getMethod(DEX_SETTINGS_BRIDGE, String)
        dex_class.getMethod(DEX_UNLOAD_BRIDGE)

    def _read_static_field(self, dex_class, field_name: str):
        field = dex_class.getDeclaredField(field_name)
        field.setAccessible(True)
        return field.get(None)

    def start(self) -> tuple[int, str]:
        if self.dex_class is not None:
            self.unload()

        dex_bytes = self._decode_and_validate_dex()
        dex_loader = self._create_class_loader(dex_bytes)
        dex_class = dex_loader.loadClass(DEX_CLASS_NAME)
        self._validate_bridge_methods(dex_class)
        version_code = int(self._read_static_field(dex_class, DEX_VERSION_CODE_FIELD))
        version_name = str(self._read_static_field(dex_class, DEX_VERSION_NAME_FIELD))
        if version_code <= 0:
            raise RuntimeError("invalid DEX VERSION_CODE")

        self.dex_loader = dex_loader
        self.dex_class = dex_class
        try:
            self._run_on_ui_thread_sync(lambda: self._invoke_static_method(DEX_START_BRIDGE))
        except Exception:
            try:
                self._run_on_ui_thread_sync(lambda: self._invoke_static_method(DEX_UNLOAD_BRIDGE))
            except Exception as unload_error:
                self.plugin.log(f"[MaterialExpressive] cleanup after failed start failed: {unload_error}")
            finally:
                self.dex_class = None
                self.dex_loader = None
            raise

        self.version_code = version_code
        self.version_name = version_name
        self.plugin.log(f"[MaterialExpressive] loaded {DEX_CLASS_NAME} v{version_name} ({version_code})")
        return version_code, version_name

    def update_settings(self, settings: dict):
        try:
            if self.dex_class is None:
                return
            settings_json = json.dumps(settings, ensure_ascii=False)
            self._run_on_ui_thread_sync(
                lambda: self._invoke_static_method(DEX_SETTINGS_BRIDGE, settings_json)
            )
        except Exception as e:
            self.plugin.log(f"[MaterialExpressive] settings sync error: {e}")

    def unload(self):
        try:
            if self.dex_class is None:
                return
            self._run_on_ui_thread_sync(lambda: self._invoke_static_method(DEX_UNLOAD_BRIDGE))
        except Exception as e:
            self.plugin.log(f"[MaterialExpressive] unload error: {e}")
        finally:
            self.dex_class = None
            self.dex_loader = None
            self.version_code = 0
            self.version_name = ""


class MaterialExpressiveEngine(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex_loader = DexLoader(self)
        self._dex_error = ""

    def create_settings(self):
        return [
            Header(text="Material Expressive"),
            Selector(
                key=PRESET_KEY,
                text="Движение",
                items=PRESET_ITEMS,
                default=2,
                icon="msg_photo_settings",
                on_change=self._on_preset_change,
            ),
            Selector(
                key=HAPTIC_LEVEL_KEY,
                text="Виброотклик",
                items=HAPTIC_LEVEL_ITEMS,
                default=2,
                icon="msg_notifications",
                on_change=self._on_haptic_level_change,
            ),
            Divider(text=self._preset_hint()),
            text_setting(
                text="Нажатия и списки",
                subtext=self._press_summary(),
                icon="msg_settings",
                accent=True,
                create_sub_fragment=self._create_press_settings,
            ),
            text_setting(
                text="Чаты и меню",
                subtext=self._chat_summary(),
                icon="msg_discuss",
                accent=True,
                create_sub_fragment=self._create_chat_settings,
            ),
            text_setting(
                text="Ввод, реакции и плеер",
                subtext=self._composer_summary(),
                icon="msg_send",
                accent=True,
                create_sub_fragment=self._create_composer_settings,
            ),
            text_setting(
                text="Где вибрировать",
                subtext=self._haptic_summary(),
                icon="msg_notifications",
                accent=True,
                create_sub_fragment=self._create_haptic_settings,
            ),
            Divider(),
            text_setting(
                text="Ядро",
                subtext=self._dex_status_summary(),
                icon="files_storage",
                accent=True,
                create_sub_fragment=self._create_dex_settings,
            ),
        ]


    def _create_press_settings(self):
        custom = self._is_custom_preset()
        items = [
            Header(text="Нажатия"),
            self._switch("enable_bounce", "Анимация нажатия", "Кнопки и ячейки мягко прожимаются."),
            self._switch("phys_avatars", "Живые аватарки", "Аватарка смещается вслед за нажатием."),
            self._switch("ripple_sync", "Ripple от точки касания", "Волна начинается под пальцем."),
        ]
        if custom:
            items += [
                self._level("bounce_depth", "Насколько сжимать", ["Едва", "Мягко", "Заметно", "Сильно"]),
                self._level("spring_tension", "Отскок", ["Без отскока", "Мягкий", "Упругий", "Пружина"]),
                self._level("animation_speed", "Скорость", ["Медленно", "Нормально", "Быстро", "Резво"]),
            ]

        items += [
            Divider(),
            Header(text="Списки"),
            self._switch("scroll_pop", "Мягкое появление строк", "Новые строки всплывают при прокрутке."),
        ]
        if custom:
            items.append(
                self._level("scroll_pop_intensity", "Насколько заметно", ["Мягко", "Заметно", "Сильно"])
            )
        items += [
            self._switch("scroll_elastic", "Упругие края", "Верх и низ списка слегка тянутся."),
            self._switch("suggestion_motion", "Подсказки и команды", "Эмодзи, упоминания и команды."),
            Divider(text=self._levels_hint(custom)),
        ]
        return items

    def _create_chat_settings(self):
        return [
            Header(text="Чаты"),
            self._switch("reply_swipe_elastic", "Свайп для ответа", "Сопротивление жеста и короткий импульс."),
            self._switch("selection_pulse", "Выбор сообщений", "Сообщение и счётчик коротко пульсируют."),
            Divider(),
            Header(text="Меню"),
            self._switch("action_surfaces", "Живые меню действий", "Меню раскрывается от выбранного элемента."),
            self._switch("context_menu_cascade", "Каскад пунктов", "Пункты появляются волной сверху вниз."),
            Divider(text="Работает для ItemOptions и меню долгого нажатия."),
        ]

    def _create_composer_settings(self):
        return [
            Header(text="Панель ввода"),
            self._switch("composer_motion", "Живая панель ввода", "Эмодзи, вложения, запись и отправка."),
            self._switch("composer_send_impulse", "Импульс отправки", "Кнопка сжимается и отскакивает."),
            self._switch("composer_record_lock", "Отклик замка записи", "Пружинный импульс при фиксации записи."),
            Divider(),
            Header(text="Реакции и плеер"),
            self._switch("reaction_motion", "Анимация реакций", "Реакции растут под пальцем."),
            self._switch("media_controls", "Кнопки и ползунок плеера", "Перемотка откликается по шагам."),
            Divider(),
        ]

    def _create_haptic_settings(self):
        items = [Header(text="Где вибрировать")]
        items += [self._switch(key, title, hint) for key, title, hint in HAPTIC_WHERE]
        if self._haptic_level() == 0:
            items.append(Divider(text="Виброотклик выключен на главном экране — эти настройки пока не действуют."))
        else:
            items.append(Divider(text="Сила задаётся селектором «Виброотклик» на главном экране."))
        return items

    def _create_dex_settings(self):
        return [
            Header(text="Ядро"),
            text_setting(text="Состояние", subtext=self._dex_status_summary(), icon="files_storage"),
            Divider(text=f"Плагин v{__version__}. Ядро встроено в файл плагина и обновляется вместе с ним."),
            text_setting(
                text="Перезапустить ядро",
                subtext="Если анимации перестали работать после обновления.",
                icon="msg_retry",
                accent=True,
                on_click=self._restart_dex,
            ),
            text_setting(
                text="Сбросить настройки",
                subtext="Вернуть сбалансированный профиль по умолчанию.",
                icon="msg_reset",
                accent=True,
                on_click=self._reset_settings,
            ),
        ]


    def _switch(self, key: str, text: str, subtext: str = ""):
        return Switch(
            key=key,
            text=text,
            default=CONFIG_DEFAULTS[key],
            subtext=subtext or None,
            on_change=self._on_detail_change,
        )

    def _level(self, key: str, text: str, items: list[str]):
        return Selector(
            key=key,
            text=text,
            items=items,
            default=CONFIG_DEFAULTS[key],
            on_change=self._on_detail_change,
        )


    def _preset_hint(self) -> str:
        preset = self._preset()
        if preset == 0:
            return "Все эффекты выключены — Telegram ведёт себя как обычно."
        if preset == PRESET_CUSTOM:
            return "Глубина, отскок и скорость настраиваются вручную в «Нажатия и списки»."
        return "Пресет задаёт глубину, отскок и скорость. Что именно анимировать — в разделах ниже."

    def _levels_hint(self, custom: bool) -> str:
        if custom:
            return "Сила и скорость действуют только на включённые эффекты."
        return "Выберите «Своё» в «Движение», чтобы настроить силу и скорость вручную."

    def _press_summary(self) -> str:
        return self._on_off_summary([
            ("enable_bounce", "нажатия"),
            ("phys_avatars", "аватарки"),
            ("scroll_pop", "появление строк"),
            ("scroll_elastic", "упругие края"),
            ("suggestion_motion", "подсказки"),
        ])

    def _chat_summary(self) -> str:
        return self._on_off_summary([
            ("reply_swipe_elastic", "свайп"),
            ("selection_pulse", "выбор"),
            ("action_surfaces", "меню"),
            ("context_menu_cascade", "каскад"),
        ])

    def _composer_summary(self) -> str:
        return self._on_off_summary([
            ("composer_motion", "панель ввода"),
            ("composer_send_impulse", "импульс отправки"),
            ("composer_record_lock", "замок записи"),
            ("reaction_motion", "реакции"),
            ("media_controls", "плеер"),
        ])

    def _haptic_summary(self) -> str:
        if self._haptic_level() == 0:
            return "Виброотклик выключен"
        return self._on_off_summary([(key, title.lower()) for key, title, _hint in HAPTIC_WHERE])

    def _on_off_summary(self, pairs: list[tuple[str, str]]) -> str:
        enabled = [title for key, title in pairs if self._flag(key)]
        if not enabled:
            return "Всё выключено"
        if len(enabled) == len(pairs):
            return "Всё включено"
        if len(enabled) <= 2:
            return ", ".join(enabled).capitalize()
        return f"{', '.join(enabled[:2])} и ещё {len(enabled) - 2}".capitalize()

    def _dex_status_summary(self) -> str:
        if self.dex_loader.dex_class is not None:
            return f"загружено, v{self.dex_loader.version_name} ({self.dex_loader.version_code})"
        if self._dex_error:
            return f"не загружено: {self._dex_error}"
        return "не загружено"


    def _flag(self, key: str) -> bool:
        return bool(self.get_setting(key, CONFIG_DEFAULTS[key]))

    def _index(self, key: str, default: int, count: int) -> int:
        try:
            value = int(self.get_setting(key, default))
        except Exception:
            return default
        return value if 0 <= value < count else default

    def _preset(self) -> int:
        return self._index(PRESET_KEY, 2, len(PRESET_ITEMS))

    def _haptic_level(self) -> int:
        return self._index(HAPTIC_LEVEL_KEY, 2, len(HAPTIC_LEVEL_ITEMS))

    def _is_custom_preset(self) -> bool:
        return self._preset() == PRESET_CUSTOM


    def _on_preset_change(self, value=None):
        self._apply_preset(self._preset() if value is None else int(value))
        self._sync_settings_to_dex()

    def _apply_preset(self, preset: int):
        if preset == PRESET_CUSTOM:
            return

        levels = PRESET_LEVELS.get(preset)
        for key in MOTION_FLAG_KEYS:
            self.set_setting(key, levels is not None)
        if levels is not None:
            for key, level in zip(MOTION_LEVEL_KEYS, levels):
                self.set_setting(key, level)

    def _on_haptic_level_change(self, value=None):
        level = self._haptic_level() if value is None else int(value)
        self.set_setting("enable_haptics", level > 0)
        self.set_setting("haptic_type", max(0, level - 1))
        self._sync_settings_to_dex()

    def _on_detail_change(self, _value=None):
        if not self._is_custom_preset():
            self.set_setting(PRESET_KEY, PRESET_CUSTOM)
        self._sync_settings_to_dex()

    def _reset_settings(self, _view=None):
        for key, value in CONFIG_DEFAULTS.items():
            self.set_setting(key, value)
        self.set_setting(PRESET_KEY, 2)
        self.set_setting(HAPTIC_LEVEL_KEY, 2)
        self.set_setting(SETTINGS_VERSION_KEY, SETTINGS_VERSION, reload_settings=True)
        self._sync_settings_to_dex()
        BulletinHelper.show_success("Настройки Material Expressive сброшены", get_last_fragment())

    def _migrate_legacy_settings(self):
        try:
            stored = int(self.get_setting(SETTINGS_VERSION_KEY, 0))
        except Exception:
            stored = 0
        if stored >= SETTINGS_VERSION:
            return

        if stored == 2:
            motion = self._index("motion", 2, 4)
            levels = PRESET_LEVELS.get(motion)
            if levels is not None:
                for key, level in zip(MOTION_LEVEL_KEYS, levels):
                    self.set_setting(key, level)

            all_areas_on = True
            for area_key, targets in LEGACY_AREA_TARGETS.items():
                enabled = motion > 0 and bool(self.get_setting(area_key, True))
                all_areas_on = all_areas_on and enabled
                for key in targets:
                    self.set_setting(key, enabled)

            self.set_setting(PRESET_KEY, motion if (motion == 0 or all_areas_on) else PRESET_CUSTOM)

            haptics = self._index("haptics", 2, len(HAPTIC_LEVEL_ITEMS))
            self.set_setting(HAPTIC_LEVEL_KEY, haptics)
            self.set_setting("enable_haptics", haptics > 0)
            self.set_setting("haptic_type", max(0, haptics - 1))
            self.log("[MaterialExpressive] settings restored from compact 2.5.0 model")
        else:
            if self.get_setting("enable_bounce", None) is not None:
                self.set_setting(PRESET_KEY, PRESET_CUSTOM)
            level = 0
            if self.get_setting("enable_haptics", True):
                try:
                    level = min(2, max(0, int(self.get_setting("haptic_type", 1)))) + 1
                except Exception:
                    level = 2
            self.set_setting(HAPTIC_LEVEL_KEY, level)

        self.set_setting(SETTINGS_VERSION_KEY, SETTINGS_VERSION)

    def on_plugin_load(self) -> None:
        self.log(f"[MaterialExpressive] loading v{__version__}")
        self._migrate_legacy_settings()
        self._start_dex(announce=False)

    def on_plugin_unload(self) -> None:
        try:
            self.dex_loader.unload()
        except Exception as e:
            self.log(f"[MaterialExpressive] core unload failed: {e}")

    def _start_dex(self, announce: bool) -> bool:
        try:
            self.dex_loader.start()
            self._dex_error = ""
            self._sync_settings_to_dex()
            if announce:
                BulletinHelper.show_success("Material Expressive core загружен", get_last_fragment())
            return True
        except Exception as e:
            self._dex_error = str(e)
            self.log(f"[MaterialExpressive] core start failed: {e}")
            if announce:
                BulletinHelper.show_error(f"Не удалось загрузить ядро: {e}", get_last_fragment())
            return False

    def _restart_dex(self, _view=None):
        self._start_dex(announce=True)

    def _collect_settings(self) -> dict:
        return {
            key: self.get_setting(key, default)
            for key, default in CONFIG_DEFAULTS.items()
        }

    def _sync_settings_to_dex(self):
        self.dex_loader.update_settings(self._collect_settings())

    def _run_on_ui_thread_sync(self, fn, timeout_ms: int = 3000):
        try:
            if Looper.getMainLooper().isCurrentThread():
                fn()
                return
        except Exception:
            pass

        finished = threading.Event()
        error_holder = {}

        def wrapped():
            try:
                fn()
            except Exception as error:
                error_holder["error"] = error
            finally:
                finished.set()

        run_on_ui_thread(wrapped)
        if not finished.wait(timeout_ms / 1000.0):
            raise TimeoutError("UI thread bridge call timed out")

        error = error_holder.get("error")
        if error is not None:
            raise error


DEX_BASE64 = ""