EXPECTED_DEX_SHA256 = "c82af33c7ef2bb31750e1f5e4b7fe9bff0b18e3f280067f89a9edcf10de14540"
MAX_DEX_BYTES = 4 * 1024 * 1024

SETTINGS_VERSION_KEY = "settings_version"
