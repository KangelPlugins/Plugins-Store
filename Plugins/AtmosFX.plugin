            Switch(key='weather_disable_rain', text='💧 Отключить дождь', default=False),
            Switch(key='weather_disable_storm', text='⚡ Отключить грозу', default=False),
            Switch(key='weather_disable_fog', text='🌫️ Отключить туман', default=False),
            Switch(key='weather_disable_clear', text='☀️ Отключить ясно', default=False),
            Switch(key='weather_disable_clouds', text='☁️ Отключить облачно', default=False),
            Divider(),
