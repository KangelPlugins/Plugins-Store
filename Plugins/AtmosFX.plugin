            Text(text='✨ Пресеты от @anivPlugins', subtext='Сакура, Матрица, Дождик, Осенний листопад и другое — нажми, чтобы перейти в канал', icon='msg_info', on_click=self._open_aniv_channel),
            Text(text='↩️ Сбросить пресеты всех чатов', subtext='Убрать все персональные пресеты чатов, оставить только общий', on_click=self._reset_chat_shapes),
            Text(text='❄️ Снежинки (пресет)', subtext='Настоящая векторная форма, не эмодзи', on_click=lambda v: self._apply_preset('snowflake', '❄️ Снежинки')),
            Text(text='🌸 Сакура (пресет)', subtext='Настоящая векторная форма, не эмодзи', on_click=lambda v: self._apply_preset('sakura', '🌸 Сакура')),
            Text(text='🟩 Матрица (пресет)', subtext='Настоящая векторная форма, не эмодзи', on_click=lambda v: self._apply_preset('matrix', '🟩 Матрица')),
            Text(text='💧 Дождик (пресет)', subtext='Настоящая векторная форма, не эмодзи', on_click=lambda v: self._apply_preset('rain', '💧 Дождик')),
            Text(text='🍂 Осенний листопад (пресет)', subtext='Настоящая векторная форма, не эмодзи', on_click=lambda v: self._apply_preset('leaves', '🍂 Осенний листопад')),
            Text(text='↩️ Вернуться к эмодзи', subtext='Отключить векторный пресет, снова использовать эмодзи выше', on_click=lambda v: (self._clear_aniv_shape(), run_on_ui_thread(self._on_emoji_settings_changed))),
        ]
        return [item for item in items if item is not None]

    def _apply_preset(self, shape: str, label: str, view=None):
        try:
            self._live_shape = shape
            self.set_setting('aniv_shape', shape, reload_settings=True)
            self._sync_settings()
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_info(f'✅ Пресет применён: {label}')
        except Exception:
            pass

    def _clear_aniv_shape(self):
        try:
            self._live_shape = ''
            self.set_setting('aniv_shape', '', reload_settings=True)
        except Exception:
            pass

    def _open_aniv_channel(self, view=None):
        try:
            Browser = find_class('org.telegram.messenger.browser.Browser')
            if view and hasattr(view, 'getContext'):
                context = view.getContext()
            else:
                AppLoader = find_class('org.telegram.messenger.ApplicationLoader')
                context = AppLoader.applicationContext
            Browser.openUrl(context, 'https://anivplugins.t.me')
        except Exception:
            pass

    def _reset_chat_emojis(self, view=None):
        try:
            self._save_chat_emoji_map({})
            self._bitmaps.clear()
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_info('✅ Настройки чатов сброшены')
            run_on_ui_thread(self._invalidate_current_view)
        except Exception:
            pass

    def _show_count_picker(self):
        try:
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import BottomSheet, Theme
            from org.telegram.ui.Components import LayoutHelper
            from android.view import View, Gravity
            from android.widget import LinearLayout, TextView, NumberPicker
            from android.util import TypedValue
            from android_utils import OnClickListener
            from ui.bulletin import BulletinHelper
            fragment = get_last_fragment()
            if not fragment:
                return
            act = fragment.getParentActivity()
            if not act:
                return
            options = ['10', '20', '30', '50', '75', '100', '150', '200']
            current = str(self.get_setting('max_count', '50'))
            idx = options.index(current) if current in options else 3
            builder = BottomSheet.Builder(act)
            builder.setApplyTopPadding(False)
            builder.setApplyBottomPadding(False)
            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(8), AndroidUtilities.dp(16), AndroidUtilities.dp(24))
            title = TextView(act)
            title.setText('❄️ Количество частиц')
            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            title.setTypeface(AndroidUtilities.bold())
            title.setGravity(Gravity.CENTER)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            title.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(16))
            root.addView(title, LayoutHelper.createLinear(-1, -2))
            picker = NumberPicker(act)
            picker.setMinValue(0)
            picker.setMaxValue(len(options) - 1)
            picker.setDisplayedValues(options)
            picker.setValue(idx)
            picker.setWrapSelectorWheel(False)
            try:
                picker.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            except Exception:
                pass
            root.addView(picker, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 32, 0, 32, 0))
            div = View(act)
            div.setBackgroundColor(Theme.getColor(Theme.key_divider))
            root.addView(div, LayoutHelper.createLinear(-1, 1, 0, 16, 0, 8))
            sheet_ref = [None]
            plugin = self
            ok_btn = TextView(act)
            ok_btn.setText('Готово')
            ok_btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
            ok_btn.setTypeface(AndroidUtilities.bold())
            ok_btn.setGravity(Gravity.CENTER)
            ok_btn.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
            ok_btn.setPadding(0, AndroidUtilities.dp(14), 0, AndroidUtilities.dp(14))
            try:
                ok_btn.setBackground(Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(8), Theme.getColor(Theme.key_featuredStickers_addButton), Theme.getColor(Theme.key_featuredStickers_addButtonPressed)))
            except Exception:
                ok_btn.setBackgroundColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            ok_btn.setClickable(True)

            def on_ok(v):
                val = options[picker.getValue()]
                plugin.set_setting('max_count', val, reload_settings=False)
                plugin._apply_count(int(val))
                BulletinHelper.show_info(f'✅ Частиц: {val}')
                if sheet_ref[0]:
                    sheet_ref[0].dismiss()
            ok_btn.setOnClickListener(OnClickListener(on_ok))
            root.addView(ok_btn, LayoutHelper.createLinear(-1, -2))
            builder.setCustomView(root)
            sheet = builder.create()
            sheet_ref[0] = sheet
            sheet.show()
        except Exception:
            pass

    def _show_speed_picker(self):
        try:
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import BottomSheet, Theme
            from org.telegram.ui.Components import LayoutHelper
            from android.view import View, Gravity
            from android.widget import LinearLayout, TextView, NumberPicker
            from android.util import TypedValue
            from android_utils import OnClickListener
            from ui.bulletin import BulletinHelper
            fragment = get_last_fragment()
            if not fragment:
                return
            act = fragment.getParentActivity()
            if not act:
                return
            options = ['5', '10', '15', '20', '30', '50', '75', '100']
            labels = ['Очень медленно', 'Медленно', 'Чуть медленно', 'Нормально', 'Быстро', 'Очень быстро', 'Стремительно', 'Ураган']
            current = str(self.get_setting('speed', '20'))
            idx = options.index(current) if current in options else 3
            builder = BottomSheet.Builder(act)
            builder.setApplyTopPadding(False)
            builder.setApplyBottomPadding(False)
            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(8), AndroidUtilities.dp(16), AndroidUtilities.dp(24))
            title = TextView(act)
            title.setText('💨 Скорость падения')
            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            title.setTypeface(AndroidUtilities.bold())
            title.setGravity(Gravity.CENTER)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            title.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(16))
            root.addView(title, LayoutHelper.createLinear(-1, -2))
            picker = NumberPicker(act)
            picker.setMinValue(0)
            picker.setMaxValue(len(labels) - 1)
            picker.setDisplayedValues(labels)
            picker.setValue(idx)
            picker.setWrapSelectorWheel(False)
            try:
                picker.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            except Exception:
                pass
            root.addView(picker, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 32, 0, 32, 0))
            div = View(act)
            div.setBackgroundColor(Theme.getColor(Theme.key_divider))
            root.addView(div, LayoutHelper.createLinear(-1, 1, 0, 16, 0, 8))
            sheet_ref = [None]
            plugin = self
            ok_btn = TextView(act)
            ok_btn.setText('Готово')
            ok_btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
            ok_btn.setTypeface(AndroidUtilities.bold())
            ok_btn.setGravity(Gravity.CENTER)
            ok_btn.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
            ok_btn.setPadding(0, AndroidUtilities.dp(14), 0, AndroidUtilities.dp(14))
            try:
                ok_btn.setBackground(Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(8), Theme.getColor(Theme.key_featuredStickers_addButton), Theme.getColor(Theme.key_featuredStickers_addButtonPressed)))
            except Exception:
                ok_btn.setBackgroundColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            ok_btn.setClickable(True)

            def on_ok(v):
                val = options[picker.getValue()]
                plugin.set_setting('speed', val, reload_settings=False)
                BulletinHelper.show_info(f'✅ Скорость: {labels[picker.getValue()]}')
                if sheet_ref[0]:
                    sheet_ref[0].dismiss()
            ok_btn.setOnClickListener(OnClickListener(on_ok))
            root.addView(ok_btn, LayoutHelper.createLinear(-1, -2))
            builder.setCustomView(root)
            sheet = builder.create()
            sheet_ref[0] = sheet
            sheet.show()
        except Exception:
            pass

    def _apply_count(self, count: int):
        try:
            if self._snow_cls is None:
                return
            f = self._snow_cls.getDeclaredField('maxCount')
            f.setAccessible(True)
            self._max_count = count
        except Exception:
            pass

class _WeatherPillHook(MethodHook):

    def __init__(self, plugin):
        self._p = plugin

    def after_hooked_method(self, param):
        try:
            p = self._p
            method_name = param.method.getName()
            if method_name == 'setData' and param.args:
                state = param.args[0]
                if state is not None:
                    try:
                        cls = state.getClass()
                        f_emoji = cls.getDeclaredField('emoji')
                        f_emoji.setAccessible(True)
                        emoji = str(f_emoji.get(state) or '')
                        try:
                            f_temp = cls.getDeclaredField('temperature')
                            f_temp.setAccessible(True)
                            p._weather_temperature = float(str(f_temp.get(state)))
                        except Exception:
                            p._weather_temperature = None
                        if emoji is not None:
                            code = p._weather_emoji_to_code(emoji)
                            if code is not None and code != p._weather_code:
                                old_code = p._weather_code
                                p._weather_code = code
                                p._bitmaps.clear()
                                from android_utils import run_on_ui_thread
                                import threading

                                def _delayed_refresh():
                                    import time
                                    for _ in range(5):
                                        if getattr(p, '_effect_instances', None):
                                            run_on_ui_thread(p._refresh_all_bitmaps)
                                            return
                                        time.sleep(0.3)
                                    run_on_ui_thread(p._refresh_all_bitmaps)
                                threading.Thread(target=_delayed_refresh, daemon=True).start()
                    except Exception:
                        pass
        except Exception:
            pass

class _UpdateHook(MethodHook):

    def __init__(self, plugin):
        self._p = plugin

    def after_hooked_method(self, param):
        try:
            p = self._p
            method_name = param.method.getName()
            if method_name != 'createParticlesBitmap':
                return
            p._effect_instances = getattr(p, '_effect_instances', set())
            try:
                if param.thisObject is not None:
                    p._effect_instances.add(param.thisObject)
            except Exception:
                pass
            if p.get_setting('stars_mode', False):
                return
            emoji = p.get_active_emoji()
            if not emoji:
                return
            orig_bmp = param.getResult()
            if orig_bmp is not None:
                try:
                    orig_w = orig_bmp.getWidth()
                    orig_h = orig_bmp.getHeight()
                    p._last_cell = orig_h
                    emojis = p.get_active_emojis()
                    rotation = p.get_setting('rotation', False)
                    n_emojis = len(emojis) if emojis else 0
                    cell = orig_h
                    orig_count = orig_w // cell if cell > 0 else 1
                    atlas_count = max(orig_count, n_emojis) if n_emojis > 0 else orig_count
                    atlas_w = cell * atlas_count
                    emoji_key = '_'.join(emojis) if emojis else 'default'
                    rot_key = f'{atlas_w}x{cell}_{emoji_key}_r{rotation}'
                    if rot_key not in p._bitmaps or p._bitmaps[rot_key] is None:
                        p._bitmaps[rot_key] = p._build_atlas_bitmap(cell, emojis, rotation, atlas_count)
                    if p._f_bitmap is not None:
                        try:
                            p._f_bitmap.set(param.thisObject, p._bitmaps[rot_key])
                        except Exception:
                            pass
                    cache_key = rot_key
                    param.setResult(p._bitmaps[cache_key])
                except Exception:
                    pass
        except Exception:
            pass

    def before_hooked_method(self, param):
        try:
            p = self._p
            method_name = param.method.getName()
            if method_name == 'createParticlesBitmap':
                return
            if method_name == 'updateParticles' and param.args:
                if p.get_setting('stars_mode', False):
                    effect = param.thisObject
                    effect_id = id(effect)
                    ticks = p._stars_ticks = getattr(p, '_stars_ticks', {})
                    ticks[effect_id] = ticks.get(effect_id, 0) + 1
                    if ticks[effect_id] > 400:
                        param.args[0] = 0
                        return
                if p.get_setting('weather_mode', False):
                    emojis = p.get_active_emojis()
                    if not emojis:
                        param.args[0] = 0
                        return
                speed = int(p.get_setting('speed', '20'))
                dt = param.args[0]
                speed_mult = speed / 20.0
                _, weather_speed = p._get_weather_intensity()
                if p.get_setting('weather_mode', False):
                    speed_mult *= weather_speed
                param.args[0] = int(dt * speed_mult)
                effect = param.thisObject
                import time as _time
                now = _time.time()
                last_check = getattr(p, '_last_live_check_ts', 0)
                if now - last_check > 0.5:
                    p._last_live_check_ts = now
                    try:
                        p._replace_bitmap_on_effect(effect)
                    except Exception:
                        pass
            max_count = getattr(p, '_max_count', None)
            if p._snow_cls is not None:
                try:
                    effect = param.thisObject
                    f = p._snow_cls.getDeclaredField('maxCount')
                    f.setAccessible(True)
                    base = max_count if max_count is not None else int(f.get(effect))
                    count_mult, _ = p._get_weather_intensity()
                    final = max(5, min(150, int(base * count_mult)))
                    f.setInt(effect, final)
                except Exception:
                    pass
        except Exception:
            pass

