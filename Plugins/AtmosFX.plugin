    WEATHER_TYPES = {'snow': ((71, 73, 75, 77, 85, 86), '❄️'), 'rain': ((51, 53, 55, 61, 63, 65, 80, 81, 82), '💧'), 'storm': ((95, 96, 99), '⚡'), 'fog': ((45, 48), '🌫️'), 'clear': ((0, 1), '☀️'), 'clouds': ((2, 3), '☁️')}

    def _weather_to_emoji(self, code: int) -> str:
        for key, (codes, emoji) in self.WEATHER_TYPES.items():
            if code in codes:
                if self.get_setting(f'weather_disable_{key}', False):
                    return None
                return emoji
        if not self.get_setting('weather_disable_snow', False):
            return '❄️'
        return None

    def _init_weather_pill_hook(self):
        try:
            from hook_utils import find_class
            wrapper = find_class('com.exteragram.messenger.pillstack.ui.pills.weather.WeatherPill')
            if not wrapper:
                return
            hook = _WeatherPillHook(self)
            hooked = False
            for mn in ('onUpdateData', 'setData'):
                refs = self.hook_all_methods(wrapper, mn, hook)
                if refs:
                    hooked = True
            if not hooked:
                pass
        except Exception:
            pass

    def _weather_emoji_to_code(self, emoji_val) -> int:
        try:
            e = str(emoji_val)
            cps = [ord(c) for c in e]
            snow_cps = {10052, 127784, 9731, 9927, 10054}
            rain_cps = {127783, 127782, 128167, 9748, 9926}
            storm_cps = {9889, 127785, 9928, 128165}
            fog_cps = {127787, 127745}
            clear_cps = {9728, 127774, 127780, 127773}
            cloudy_cps = {9729, 9925, 127781, 9730}
            for cp in cps:
                if cp in snow_cps:
                    return 71
                if cp in storm_cps:
                    return 95
                if cp in rain_cps:
                    return 61
                if cp in fog_cps:
                    return 45
                if cp in clear_cps:
                    return 0
                if cp in cloudy_cps:
                    return 3
        except Exception:
            pass
        return 2

    def _parse_weather_text(self, text: str) -> int:
        if not text:
            return None
        t = text.lower()
        if any((x in t for x in ('snow', 'снег', '❄'))):
            return 71
        if any((x in t for x in ('rain', 'дождь', '💧', 'drizzle'))):
            return 61
        if any((x in t for x in ('storm', 'thunder', 'гроза', '⚡'))):
            return 95
        if any((x in t for x in ('fog', 'mist', 'туман', '🌫'))):
            return 45
        if any((x in t for x in ('cloud', 'облач', 'overcast', '☁'))):
            return 3
        if any((x in t for x in ('clear', 'sunny', 'sun', 'ясн', '☀', 'солн'))):
            return 0
        import re
        if re.search('[+-]?\\d+°', t):
            return 2
        return None

    def _fetch_weather(self):
        from android_utils import run_on_ui_thread
        run_on_ui_thread(self._init_weather_pill_hook)

    def _fetch_weather_wttr(self):
        try:
            city = str(self.get_setting('city', 'Moscow')).strip().replace(' ', '+')
            from java.net import URL
            from java.io import BufferedReader, InputStreamReader
            url_obj = URL(f'https://wttr.in/{city}?format=j1')
            conn = url_obj.openConnection()
            conn.setConnectTimeout(10000)
            conn.setReadTimeout(10000)
            reader = BufferedReader(InputStreamReader(conn.getInputStream()))
            lines = []
            line = reader.readLine()
            while line is not None:
                lines.append(str(line))
                line = reader.readLine()
            reader.close()
            data = json.loads(''.join(lines))
            code = int(data['current_condition'][0]['weatherCode'])
            self._weather_code = code
            self._bitmaps.clear()
        except Exception:
            pass

    def create_settings(self):
        context = self._get_active_context()
        resources_provider = self._get_resources_provider()

        if self._row_context != context:
            self._row_context = context
            self._row_views = {}
            self._row_refresh = {}
            self._settings_refs = []

        def build_custom_row(key: str, builder, *args):
            if context is None:
                return None
            view = self._row_views.get(key)
            if view is None:
                try:
                    view = builder(context, resources_provider, key, *args)
                except Exception as err:
                    return None
                self._row_views[key] = view
            else:
                refresh = self._row_refresh.get(key)
                if refresh is not None:
                    refresh()
            import zlib
            row_id = as_java_color(zlib.crc32(key.encode()) & 0x7FFFFFFF)
            from org.telegram.ui.Components import UItem
            return Custom(item=UItem.asCustom(row_id, view))

        def add_slider(key: str, title: str, default, min_val, max_val, suffix: str = '', decimals: int = 0):
            return build_custom_row(key, self._create_slider_row, title, default, min_val, max_val, suffix, decimals)

        if self.get_setting('stars_mode', False):
            preview = '⭐ Звёздное небо'
        elif self.get_setting('daynight_mode', False):
            preview = f'Сейчас: {self._get_daynight_emoji()}'
        else:
            emojis = self.get_active_emojis()
            preview = ' '.join(emojis) if emojis else '❄️ (стандартные)'

        items = [
            Header(text='Частицы'),
            Text(text=f'Текущие: {preview}', subtext='Предпросмотр выбранных эмодзи'),
            Input(key='custom_emoji', text='Эмодзи', subtext='Введи эмодзи', default='', on_change=lambda v: (self._clear_aniv_shape(), run_on_ui_thread(self._on_emoji_settings_changed))),
            Text(text='↩️ Сбросить эмодзи всех чатов', subtext='Убрать все персональные настройки чатов, оставить только общие', on_click=self._reset_chat_emojis),
            Divider(),
            Header(text='Параметры'),
            Switch(key='mirror_horizontal', text='Отзеркалить по горизонтали', subtext='Каждая частица отражена по X', default=False, on_change=lambda v: run_on_ui_thread(self._on_emoji_settings_changed)),
            Switch(key='emoji_rotation', text='Вращение эмодзи', subtext='Выключи, чтобы эмодзи просто падали без поворота, как раньше', default=True, on_change=lambda v: run_on_ui_thread(self._on_emoji_settings_changed)),
            add_slider('particle_alpha', 'Прозрачность частиц', 100, 10, 100, '%'),
            add_slider('rotation_speed', 'Скорость вращения', 100, 20, 300, '%'),
            Switch(key='parallax_enabled', text='Параллакс при скролле', subtext='Частицы падают/поднимаются вместе с прокруткой чата', default=False, on_change=lambda v: run_on_ui_thread(self._on_emoji_settings_changed)),
            Switch(key='parallax_invert', text='  ↳ Инверсия параллакса', subtext='Наоборот: листаешь вверх — частицы поднимаются', default=False, on_change=lambda v: run_on_ui_thread(self._on_emoji_settings_changed)),
            Text(text='Количество частиц', subtext='Нажми чтобы выбрать', on_click=lambda v: run_on_ui_thread(self._show_count_picker)),
            Text(text='Скорость падения', subtext='Нажми чтобы выбрать', on_click=lambda v: run_on_ui_thread(self._show_speed_picker)),
            Divider(),
            Header(text='Режим (выбери один)'),
            Switch(key='stars_mode', text='⭐ Звёздное небо', subtext='Снежинки замирают на месте — как звёзды', default=False, on_change=lambda v: self._activate_mode('stars_mode', v)),
            Switch(key='daynight_mode', text='🌙 День/Ночь', subtext='☀️ днём, луна по фазам 🌑🌒🌓🌔🌕🌖🌗🌘 ночью', default=False, on_change=lambda v: self._activate_mode('daynight_mode', v)),
            Switch(key='daynight_disable_dawn', text='  ↳ Отключить рассвет 🌅', default=False),
            Switch(key='daynight_disable_dusk', text='  ↳ Отключить закат 🌇', default=False),
            Switch(key='weather_mode', text='🌦 Погода', subtext='Читает погоду из виджета Pill Stack', default=False, on_change=lambda v: self._activate_mode('weather_mode', v)),
            Switch(key='weather_intensity', text='  ↳ Интенсивность по погоде', subtext='Скорость и количество зависят от силы осадков', default=False),
            Divider(),
            Header(text='Отключить типы погоды'),
