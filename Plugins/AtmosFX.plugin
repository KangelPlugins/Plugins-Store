__id__ = 'AtmosFX'
__name__ = 'AtmosFX'
__version__ = '2.0'
__author__ = '~GRED~(@GREDpl)'
__description__ = 'Замена снега на эмодзи. (форк snowflakes от @swagnoher + пресеты от @anivPluginsс с большим функционалом) '
__min_version__ = '12.1.1'
__icon__ = 'exteraPlugins/0'
import sys
import threading
import json
import random
import base64
import zlib
from base_plugin import BasePlugin, MethodHook, MenuItemData, MenuItemType
from hook_utils import find_class
from android_utils import run_on_ui_thread
from client_utils import get_last_fragment
from ui.settings import Header, Switch, Divider, Input, Text, Custom
from java import jclass, dynamic_proxy

ENTRY_CLASS = "com.gred.atmosfx.AtmosFXCore"
DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"

BuildVersion = jclass("android.os.Build$VERSION")

_JAVA_INTEGER = None


def _java_integer():
    global _JAVA_INTEGER
    if _JAVA_INTEGER is None:
        _JAVA_INTEGER = jclass("java.lang.Integer")
    return _JAVA_INTEGER


def as_java_color(color: int) -> int:
    color = int(color) & 0xFFFFFFFF
    return color - 0x100000000 if color >= 0x80000000 else color


def call_int_color(target, method_name: str, color: int):
    try:
        method = target.getClass().getMethod(method_name, _java_integer().TYPE)
        return method.invoke(target, _java_integer()(as_java_color(color)))
    except Exception:
        try:
            return getattr(target, method_name)(as_java_color(color))
        except Exception:
            pass


class DexLoader:
    def __init__(self, entry_class: str):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            if ctx is None:
                raise RuntimeError("Application context is not ready")
            if BuildVersion.SDK_INT < 26:
                raise RuntimeError("Embedded DEX requires Android API 26+")
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            loader = InMemoryDexClassLoader(ByteBuffer.wrap(self._read_payload()), ctx.getClassLoader())
            self.clazz = loader.loadClass(self.entry_class)
        try:
            self._invoke("load")
            self.loaded = True
        except Exception as e:
            try:
                self._invoke("unload")
            except Exception:
                pass
            self.loaded = False
            raise

    def unload(self):
        try:
            if self.clazz is not None and self.loaded:
                self._invoke("unload")
        except Exception:
            pass
        self.loaded = False

    def call(self, method_name: str, *args):
        if self.clazz is None or (method_name not in ("load", "unload") and not self.loaded):
            self.load()
        return self._invoke(method_name, *args)

    def _invoke(self, method_name: str, *args):
        if self.clazz is None:
            raise RuntimeError("Core class is not loaded")
        matches = []
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) != method_name or len(method.getParameterTypes()) != len(args):
                continue
            method.setAccessible(True)
            matches.append(method)
        if len(matches) > 1:
            raise RuntimeError(f"Ambiguous core method: {method_name}/{len(args)}")
        if matches:
            return matches[0].invoke(None, *args)
        raise RuntimeError(f"Core method not found: {method_name}/{len(args)}")

    def _read_payload(self) -> bytes:
        with open(__file__, "r", encoding="utf-8") as source:
            text = source.read()
        block = text.split(f"# {DEX_BEGIN}", 1)[1].split(f"# {DEX_END}", 1)[0]
        payload = "".join(line.strip()[1:].strip() for line in block.splitlines() if line.strip().startswith("#"))
        if not payload:
            raise RuntimeError("DEX payload block пуст")
        return zlib.decompress(base64.b64decode(payload))


if not hasattr(sys, '_atmosfx_dex_cache'):
    sys._atmosfx_dex_cache = {"loader": None}
_GLOBAL_DEX_CACHE = sys._atmosfx_dex_cache


class SnowflakesPlugin(BasePlugin):
    MENU_ITEM_ID = 'atmosfx_chat_emoji'

    def on_plugin_load(self):
        self._row_context = None
        self._row_views = {}
        self._row_refresh = {}
        self._settings_refs = []
        try:
            self._live_shape = str(self.get_setting('aniv_shape', '') or '').strip()
        except Exception:
            self._live_shape = ''
        self._bitmaps = {}
        self._snow_cls = None
        self._f_particles = None
        self._f_bitmap = None
        self._f_type = None
        self._f_batch_vertex = None
        self._f_batch_colors = None
        self._emoji_text_paint = None
        self._m_drawable = None
        self._m_is_loaded = None
        self._m_preload = None
        self._weather_code = None
        self._hook_ok = False
        self._emoji_sheet = None
        self._current_dialog_id_cache = None
        try:
            self._init()
        except Exception:
            pass
        if _GLOBAL_DEX_CACHE["loader"] is not None and getattr(_GLOBAL_DEX_CACHE["loader"], 'loaded', False):
            self.dex = _GLOBAL_DEX_CACHE["loader"]
            try:
                self._sync_settings()
            except Exception:
                pass
        else:
            self.dex = DexLoader(ENTRY_CLASS)
            try:
                self.dex.load()
                _GLOBAL_DEX_CACHE["loader"] = self.dex
                self._sync_settings()
            except Exception:
                pass
        self._watch_running = True
        threading.Thread(target=self._watch_dialog_change, daemon=True).start()
        try:
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, text='❄️ Эмодзи для этого чата', on_click=self._on_chat_emoji_click, icon='input_smile', item_id=self.MENU_ITEM_ID))
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, text='🎨 Пресет для этого чата', on_click=self._on_chat_shape_click, icon='msg_theme', item_id='atmosfx_chat_shape'))
        except Exception:
            pass
        if self.get_setting('weather_mode', False):
            threading.Thread(target=self._fetch_weather, daemon=True).start()
        self._effect_instances = set()

    def on_plugin_unload(self):
        self._watch_running = False
        try:
            old_view = getattr(self, '_parallax_view', None)
            old_listener = getattr(self, '_parallax_listener', None)
            if old_view is not None and old_listener is not None:
                old_view.removeOnScrollListener(old_listener)
        except Exception:
            pass
        # ВАЖНО: не вызываем self.dex.unload() — модуль общий (_GLOBAL_DEX_CACHE),
        # переиспользуется следующей загрузкой плагина. Если снять хуки здесь,
        # следующий on_plugin_load увидит loaded=False и попытается грузить
        # НОВЫЙ Class.forName поверх старого, снова накапливая копии.
        try:
            if getattr(self, '_emoji_sheet', None) is not None:
                self._emoji_sheet.dismiss()
                self._emoji_sheet = None
        except Exception:
            pass

    def _reset_particle_types(self, effect, fixed_type: int) -> bool:
        if self._f_particles is None or self._f_type is None or effect is None:
            return False
        try:
            arr = self._f_particles.get(effect)
        except Exception:
            return False
        if arr is None:
            return False
        try:
            length = len(arr)
        except Exception:
            return False
        touched = 0
        for i in range(length):
            try:
                p = arr[i]
            except Exception:
                continue
            if p is None:
                continue
            try:
                try:
                    self._f_type.setInt(p, fixed_type)
                except Exception:
                    self._f_type.set(p, fixed_type)
                touched += 1
            except Exception:
                pass
        return touched > 0

    def _randomize_particle_types(self, effect, n_slots: int) -> bool:
        if self._f_particles is None or self._f_type is None or n_slots <= 1:
            return False
        if effect is None:
            return False
        try:
            arr = self._f_particles.get(effect)
        except Exception as e:
            return False
        if arr is None:
            return False
        try:
            length = len(arr)
        except Exception as e:
            return False
        touched = 0
        errors = 0
        for i in range(length):
            try:
                p = arr[i]
            except Exception:
                errors += 1
                continue
            if p is None:
                continue
            try:
                new_type = random.randint(0, n_slots - 1)
                try:
                    self._f_type.setInt(p, new_type)
                except Exception:
                    self._f_type.set(p, new_type)
                touched += 1
            except Exception:
                errors += 1
        return touched > 0

    def _render_single_emoji_bitmap(self, emoji: str, cell: int):
        try:
            from android.graphics import Canvas, Bitmap, Paint
            bmp = Bitmap.createBitmap(cell, cell, Bitmap.Config.ARGB_8888)
            canvas = Canvas(bmp)
            drawn = False
            if self._m_drawable is not None:
                try:
                    drawable = self._m_drawable.invoke(None, emoji)
                    if drawable is not None:
                        loaded = True
                        if self._m_is_loaded:
                            loaded = bool(self._m_is_loaded.invoke(drawable))
                        if loaded:
                            drawable.setBounds(0, 0, cell, cell)
                            drawable.draw(canvas)
                            drawn = True
                        elif self._m_preload:
                            self._m_preload.invoke(drawable)
                except Exception:
                    pass
            if not drawn:
                paint = Paint(Paint.ANTI_ALIAS_FLAG)
                paint.setTextSize(cell * 0.75)
                paint.setTextAlign(Paint.Align.CENTER)
                fm = paint.getFontMetrics()
                y = cell / 2.0 - (fm.ascent + fm.descent) / 2.0
                canvas.drawText(emoji, cell / 2.0, y, paint)
            return bmp
        except Exception as e:
            return None

    def _build_atlas_bitmap(self, cell, emojis, rotation, atlas_count):
        from android.graphics import Canvas, Bitmap, Paint
        n_emojis = len(emojis) if emojis else 0
        atlas_w = cell * atlas_count
        bmp = Bitmap.createBitmap(atlas_w, cell, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)
        for idx in range(atlas_count):
            x0 = idx * cell
            cur_e = emojis[idx % n_emojis] if n_emojis > 0 else None
            angle = idx * (360.0 / atlas_count) % 360 if rotation else 0
            drawn = False
            if cur_e and self._m_drawable is not None:
                try:
                    drawable = self._m_drawable.invoke(None, cur_e)
                    if drawable is not None:
                        loaded = True
                        if self._m_is_loaded:
                            loaded = bool(self._m_is_loaded.invoke(drawable))
                        if loaded:
                            if angle != 0:
                                canvas.save()
                                canvas.rotate(angle, x0 + cell / 2.0, cell / 2.0)
                            drawable.setBounds(x0, 0, x0 + cell, cell)
                            drawable.draw(canvas)
                            if angle != 0:
                                canvas.restore()
                            drawn = True
                except Exception:
                    pass
            if not drawn and cur_e:
                paint = Paint(Paint.ANTI_ALIAS_FLAG)
                paint.setTextSize(cell * 0.75)
                paint.setTextAlign(Paint.Align.CENTER)
                fm = paint.getFontMetrics()
                y = cell / 2.0 - (fm.ascent + fm.descent) / 2.0
                if angle != 0:
                    canvas.save()
                    canvas.rotate(angle, x0 + cell / 2.0, cell / 2.0)
                canvas.drawText(cur_e, x0 + cell / 2.0, y, paint)
                if angle != 0:
                    canvas.restore()
        return bmp

    def _force_refresh_particles(self, n_slots: int = 0):
        try:
            self._bitmaps.clear()
        except Exception:
            pass
        try:
            emojis = self.get_active_emojis()
            if not n_slots:
                n_slots = len(emojis) if emojis else 1
            instances = getattr(self, '_effect_instances', None) or set()
            cell = getattr(self, '_last_cell', None)

            new_bmp = None
            if cell:
                try:
                    rotation = self.get_setting('rotation', False)
                    atlas_count = max(1, n_slots)
                    new_bmp = self._build_atlas_bitmap(cell, emojis, rotation, atlas_count)
                    emoji_key = '_'.join(emojis) if emojis else 'default'
                    rot_key = f'{cell * atlas_count}x{cell}_{emoji_key}_r{rotation}'
                    self._bitmaps[rot_key] = new_bmp
                except Exception as e:
                    new_bmp = None

            touched_total = 0
            for effect in list(instances):
                try:
                    if new_bmp is not None and self._f_bitmap is not None:
                        self._f_bitmap.set(effect, new_bmp)
                    if n_slots <= 1:
                        ok = self._reset_particle_types(effect, 0)
                    else:
                        ok = self._randomize_particle_types(effect, n_slots)
                    touched_total += 1
                except Exception:
                    pass
        except Exception:
            pass
        self._invalidate_current_view()

    def _watch_dialog_change(self):
        import time as _time
        last_did = None
        while getattr(self, '_watch_running', False):
            try:
                did = self._get_current_dialog_id()
                if did is not None and did != last_did:
                    last_did = did
                    self._sync_settings()
                    run_on_ui_thread(self._attach_parallax_listener)
            except Exception:
                pass
            _time.sleep(1)

    def _attach_parallax_listener(self):
        try:
            old_view = getattr(self, '_parallax_view', None)
            old_listener = getattr(self, '_parallax_listener', None)
            if old_view is not None and old_listener is not None:
                try:
                    old_view.removeOnScrollListener(old_listener)
                except Exception:
                    pass
            self._parallax_view = None
            self._parallax_listener = None

            fragment = get_last_fragment()
            if fragment is None:
                return
            try:
                class_name = fragment.getClass().getName()
            except Exception:
                class_name = ''
            if not class_name.endswith('ChatActivity'):
                return

            field = fragment.getClass().getDeclaredField('chatListView')
            field.setAccessible(True)
            chat_list_view = field.get(fragment)
            if chat_list_view is None:
                return

            if not hasattr(self, 'dex') or not self.dex:
                return
            listener = self.dex.call('createParallaxListener')
            if listener is None:
                return
            chat_list_view.addOnScrollListener(listener)
            self._parallax_view = chat_list_view
            self._parallax_listener = listener
        except Exception:
            pass

    def _get_active_context(self):
        fragment = get_last_fragment()
        if fragment is None:
            return None
        try:
            return fragment.getParentActivity()
        except Exception:
            return None

    def _get_resources_provider(self):
        fragment = get_last_fragment()
        if fragment is None:
            return None
        try:
            if hasattr(fragment, 'getResourceProvider'):
                return fragment.getResourceProvider()
        except Exception:
            pass
        try:
            return getattr(fragment, 'resourcesProvider', None)
        except Exception:
            return None

    def _settings_theme_color(self, key, resources_provider=None, fallback: int = 0xFF000000) -> int:
        from org.telegram.ui.ActionBar import Theme
        try:
            if resources_provider is not None:
                return as_java_color(Theme.getColor(key, resources_provider))
        except Exception:
            pass
        try:
            return as_java_color(Theme.getColor(key))
        except Exception:
            return as_java_color(fallback)

    def _settings_text(self, context, text: str, size_dp: int, color: int, bold: bool = False):
        from android.widget import TextView
        from android.util import TypedValue
        from org.telegram.messenger import AndroidUtilities

        view = TextView(context)
        view.setText(str(text))
        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, int(size_dp))
        call_int_color(view, 'setTextColor', color)
        if bold:
            try:
                view.setTypeface(AndroidUtilities.bold())
            except Exception:
                pass
        return view

    def _create_slider_row(self, context, resources_provider, key: str, title: str, default, min_val, max_val, suffix: str = '', decimals: int = 0):
        from android.widget import LinearLayout
        from android.view import Gravity
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.ActionBar import Theme
        from org.telegram.ui.Components import SeekBarView, LayoutHelper

        min_float = float(min_val)
        max_float = float(max_val)

        def get_current_value():
            val = self.get_setting(key, str(default))
            try:
                return float(val)
            except Exception:
                return float(default)

        def format_value_str(val):
            if decimals <= 0:
                text = str(int(round(float(val))))
            else:
                text = f'{float(val):.{decimals}f}'
            return f'{text} {suffix}' if suffix else text

        def progress_to_val(p):
            raw = min_float + (max_float - min_float) * float(p)
            if decimals <= 0:
                return int(round(raw))
            step = 10 ** decimals
            return round(raw * step) / step

        def val_to_progress(val):
            if max_float == min_float:
                return 0.0
            return (float(val) - min_float) / (max_float - min_float)

        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setPadding(AndroidUtilities.dp(21), AndroidUtilities.dp(10), AndroidUtilities.dp(21), AndroidUtilities.dp(12))

        header_row = LinearLayout(context)
        header_row.setOrientation(LinearLayout.HORIZONTAL)
        header_row.setGravity(Gravity.CENTER_VERTICAL)

        title_color = self._settings_theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider, 0xFF111111)
        title_view = self._settings_text(context, title, 16, title_color)
        header_row.addView(title_view, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0))

        value_color = self._settings_theme_color(Theme.key_windowBackgroundWhiteBlueText, resources_provider, 0xFF3390EC)
        value_view = self._settings_text(context, format_value_str(get_current_value()), 14, value_color, True)
        header_row.addView(value_view, LayoutHelper.createLinear(-2, -2))
        root.addView(header_row, LayoutHelper.createLinear(-1, -2))

        seek_bar = SeekBarView(context, resources_provider)
        seek_bar.setReportChanges(True)
        try:
            track_color = self._settings_theme_color(Theme.key_switchTrack, resources_provider, 0x33000000)
            accent_color = self._settings_theme_color(Theme.key_windowBackgroundWhiteBlueText, resources_provider, 0xFF3390EC)
            seek_bar.setColors(track_color, accent_color)
        except Exception:
            pass
        root.addView(seek_bar, LayoutHelper.createLinear(-1, 38, 0, 2, 0, 0, 0))

        delegate_cls = jclass('org.telegram.ui.Components.SeekBarView$SeekBarViewDelegate')
        plugin = self

        class _SliderDelegate(dynamic_proxy(delegate_cls)):
            def onSeekBarDrag(this, stop, progress):
                val = progress_to_val(progress)
                val = max(min_float, min(max_float, float(val)))
                setting_str = str(int(round(val))) if decimals <= 0 else f'{val:.{decimals}f}'
                try:
                    value_view.setText(format_value_str(val))
                except Exception:
                    pass
                plugin.set_setting(key, setting_str)
                plugin._sync_settings()

            def onSeekBarPressed(this, pressed):
                return None

            def getContentDescription(this):
                return f'{title}: {format_value_str(get_current_value())}'

            def getStepsCount(this):
                return int(max_float - min_float) if decimals <= 0 else int((max_float - min_float) * (10 ** decimals))

            def needVisuallyDivideSteps(this):
                return False

        delegate = _SliderDelegate()
        self._settings_refs.append(delegate)

        def refresh_row():
            try:
                curr = get_current_value()
                value_view.setText(format_value_str(curr))
                seek_bar.setProgress(float(val_to_progress(curr)))
            except Exception:
                pass

        self._row_refresh[key] = refresh_row
        seek_bar.setDelegate(delegate)
        seek_bar.setProgress(float(val_to_progress(get_current_value())))

        return root

    def _sync_settings(self):
        if not hasattr(self, 'dex') or not self.dex:
            return
        try:
            emojis = self.get_active_emojis()
            emoji_str = ' '.join(emojis) if emojis else ''
            chat_shape = self._get_chat_shape_override()
            shape = chat_shape if chat_shape is not None else (getattr(self, '_live_shape', '') or '')
            mirror = bool(self.get_setting('mirror_horizontal', False))
            try:
                alpha = max(0.1, min(1.0, float(self.get_setting('particle_alpha', 100)) / 100.0))
            except Exception:
                alpha = 1.0
            try:
                rot_speed = max(0.2, min(3.0, float(self.get_setting('rotation_speed', 100)) / 100.0))
            except Exception:
                rot_speed = 1.0
            parallax = bool(self.get_setting('parallax_enabled', False))
            parallax_inv = bool(self.get_setting('parallax_invert', False))
            emoji_rotation = bool(self.get_setting('emoji_rotation', True))
            self.dex.call('updateSettings', emoji_str, shape, mirror, alpha, rot_speed, parallax, parallax_inv, emoji_rotation)
        except Exception:
            pass

    def _on_emoji_settings_changed(self):
        self._sync_settings()
        run_on_ui_thread(self._invalidate_current_view)

    def _reopen_current_chat(self):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            try:
                class_name = fragment.getClass().getName()
            except Exception:
                class_name = ''
            if not class_name.endswith('ChatActivity'):
                return

            did = int(fragment.getDialogId())
            from android.os import Bundle
            args = Bundle()
            if did < 0:
                args.putLong('chat_id', -did)
            else:
                args.putLong('user_id', did)

            chat_activity_cls = find_class('org.telegram.ui.ChatActivity')
            if chat_activity_cls is None:
                return
            new_fragment = chat_activity_cls(args)
            fragment.presentFragment(new_fragment, True)
        except Exception:
            pass

    def _invalidate_current_view(self):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            view = fragment.getFragmentView()
            if view is None:
                return
            view.invalidate()
        except Exception:
            pass

    def _get_java_cls(self, class_name):
        wrapper = find_class(class_name)
        if wrapper is None:
            return None
        try:
            return wrapper.getClass()
        except Exception:
            pass
        return None

    def _init(self):
        java_cls = self._get_java_cls('org.telegram.ui.Components.SnowflakesEffect')
        if java_cls is None:
            return
        self._snow_cls = java_cls
        try:
            f = java_cls.getDeclaredField('particles')
            f.setAccessible(True)
            self._f_particles = f
        except Exception:
            pass
        try:
            f = java_cls.getDeclaredField('particleBitmap')
            f.setAccessible(True)
            self._f_bitmap = f
        except Exception:
            pass
        for inner in java_cls.getDeclaredClasses():
            if 'Particle' in inner.getSimpleName():
                try:
                    f = inner.getDeclaredField('type')
                    f.setAccessible(True)
                    self._f_type = f
                except Exception:
                    pass
                break
        emoji_cls = self._get_java_cls('org.telegram.messenger.Emoji')
        if emoji_cls:
            cs_wrapper = find_class('java.lang.CharSequence')
            try:
                self._m_drawable = emoji_cls.getMethod('getEmojiDrawable', cs_wrapper)
            except Exception:
                pass
            for inner in emoji_cls.getDeclaredClasses():
                if 'EmojiDrawable' in inner.getSimpleName():
                    try:
                        self._m_is_loaded = inner.getMethod('isLoaded')
                        self._m_preload = inner.getMethod('preload')
                    except Exception:
                        pass
                    break
        try:
            methods = [m.getName() for m in java_cls.getDeclaredMethods() if 'lambda' not in m.getName()]
        except Exception:
            pass
        wrapper = find_class('org.telegram.ui.Components.SnowflakesEffect')
        hook = _UpdateHook(self)
        for mn in ('updateParticles', 'createParticlesBitmap'):
            try:
                refs = self.hook_all_methods(wrapper, mn, hook)
                if refs:
                    self._hook_ok = True
            except Exception:
                pass

        # Реальные хуки Particle.draw / BatchParticlesDrawHelper.draw теперь ставит
        # сам скомпилированный Java-модуль (DexLoader.load() -> AtmosFXCore.load()),
        # точно по паттерну customsnow.plugin: Class.forName() внутри Java + синглтон.

    _ANIV_LEAF_COLORS = ((213, 0, 0), (255, 143, 0), (198, 40, 40), (239, 108, 0), (230, 81, 0))

    def _get_aniv_paints(self, shape):
        cache = getattr(self, '_aniv_paint_cache', None)
        if cache is None:
            cache = {}
            self._aniv_paint_cache = cache
        if shape in cache:
            return cache[shape]

        from android.graphics import Paint, Path, Color
        if shape == 'sakura':
            p = Paint(Paint.ANTI_ALIAS_FLAG)
            p.setStyle(Paint.Style.FILL)
            p.setColor(Color.argb(255, 255, 183, 197))
            result = {'sakura': p}
        elif shape == 'matrix':
            p = Paint(Paint.ANTI_ALIAS_FLAG)
            p.setColor(Color.argb(255, 0, 255, 102))
            p.setTextSize(24.0)
            p.setTextAlign(Paint.Align.CENTER)
            result = {'matrix': p}
        elif shape == 'rain':
            p = Paint(Paint.ANTI_ALIAS_FLAG)
            p.setColor(Color.argb(128, 128, 212, 255))
            p.setStrokeWidth(3.5)
            p.setStyle(Paint.Style.STROKE)
            result = {'rain': p}
        elif shape == 'leaves':
            p = Paint(Paint.ANTI_ALIAS_FLAG)
            p.setStyle(Paint.Style.FILL)
            leaf_path = Path()
            leaf_path.moveTo(0.0, -12.0)
            leaf_path.cubicTo(9.0, -6.0, 9.0, 6.0, 0.0, 12.0)
            leaf_path.cubicTo(-9.0, 6.0, -9.0, -6.0, 0.0, -12.0)
            leaf_path.close()
            result = {'leaf': p, 'leaf_path': leaf_path}
        else:
            p = Paint(Paint.ANTI_ALIAS_FLAG)
            p.setStyle(Paint.Style.STROKE)
            p.setStrokeWidth(2.5)
            p.setColor(Color.argb(255, 255, 255, 255))
            result = {'snowflake': p}

        cache[shape] = result
        return result

    def _to_s32(self, argb):
        argb &= 0xFFFFFFFF
        return argb - 0x100000000 if argb >= 0x80000000 else argb

    _aniv_shape_logged = False

    def _time_angle(self):
        try:
            speed = max(0.2, min(3.0, float(self.get_setting('rotation_speed', 100)) / 100.0))
        except Exception:
            speed = 1.0
        import time as _time
        return (_time.time() * 1000.0 / 12.0 * speed) % 360.0

    def _draw_aniv_shape(self, shape, canvas, x, y, alpha, scale, phash):
        if not SnowflakesPlugin._aniv_shape_logged:
            SnowflakesPlugin._aniv_shape_logged = True
        paints = self._get_aniv_paints(shape)
        a255 = max(0, min(255, int(alpha * 255)))
        spin = self._time_angle()

        if shape == 'sakura':
            paint = paints['sakura']
            paint.setAlpha(a255)
            radius = scale * 8.0
            angle = float(abs(phash) % 360) + spin
            canvas.save()
            try:
                canvas.translate(x, y)
                canvas.rotate(angle)
                canvas.drawOval(-radius * 0.6, -radius, radius * 0.6, radius, paint)
            finally:
                canvas.restore()
            return

        if shape == 'matrix':
            paint = paints['matrix']
            paint.setAlpha(a255)
            import time as _time
            digit = chr(48 + (abs(phash + int(_time.time() * 1000.0 / 500.0)) % 10))
            canvas.drawText(digit, x, y, paint)
            return

        if shape == 'rain':
            paint = paints['rain']
            paint.setAlpha(a255)
            x2 = x - scale * 4.0
            y2 = y + scale * 22.0
            canvas.drawLine(x, y, x2, y2, paint)
            return

        if shape == 'leaves':
            from android.graphics import Color
            paint = paints['leaf']
            path = paints['leaf_path']
            r, g, b = self._ANIV_LEAF_COLORS[abs(phash) % 5]
            paint.setColor(Color.argb(255, r, g, b))
            paint.setAlpha(a255)
            angle = float(abs(phash) % 360) + spin
            canvas.save()
            try:
                canvas.translate(x, y)
                canvas.scale(scale * 0.85, scale * 0.85)
                canvas.rotate(angle)
                canvas.drawPath(path, paint)
            finally:
                canvas.restore()
            return

        # snowflake — 3 линии через 60° (шесть лучей)
        paint = paints['snowflake']
        paint.setAlpha(a255)
        half = scale * 5.5
        angle = float(abs(phash) % 360) + spin
        canvas.save()
        try:
            canvas.translate(x, y)
            canvas.rotate(angle)
            for _ in range(3):
                canvas.drawLine(-half, 0.0, half, 0.0, paint)
                canvas.rotate(60.0)
        finally:
            canvas.restore()

    def _get_emoji_text_paint(self):
        if self._emoji_text_paint is not None:
            return self._emoji_text_paint
        try:
            from android.graphics import Paint
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setTextAlign(Paint.Align.CENTER)
            self._emoji_text_paint = paint
            return paint
        except Exception:
            return None

    def _dp(self, v):
        try:
            from org.telegram.messenger import AndroidUtilities
            return AndroidUtilities.dp(v)
        except Exception:
            return int(v * 2.5)

    def _refresh_all_bitmaps(self):
        try:
            self._bitmaps.clear()
            instances = list(getattr(self, '_effect_instances', set()))
            for effect in instances:
                try:
                    self._replace_bitmap_on_effect(effect)
                    self._reset_batch_buffer(effect)
                except Exception:
                    pass
            self._invalidate_current_view()
        except Exception:
            pass

    def _reset_batch_buffer(self, effect):
        try:
            if self._snow_cls is None:
                return
            f = self._snow_cls.getDeclaredField('batchParticlesBuffer')
            f.setAccessible(True)
            f.set(effect, None)
        except Exception:
            pass

    def _replace_bitmap_on_effect(self, effect):
        try:
            if self._f_bitmap is None:
                return
            orig = self._f_bitmap.get(effect)
            if orig is None:
                return
            orig_w = orig.getWidth()
            orig_h = orig.getHeight()
            emojis = self.get_active_emojis()
            if not emojis:
                return
            rotation = self.get_setting('rotation', False)
            n_emojis = len(emojis)
            cell = orig_h
            orig_count = orig_w // cell if cell > 0 else 1
            atlas_count = max(orig_count, n_emojis)
            atlas_w = cell * atlas_count
            emoji_key = '_'.join(emojis)
            rot_key = f'{atlas_w}x{cell}_{emoji_key}_r{rotation}'
            if rot_key not in self._bitmaps or self._bitmaps[rot_key] is None:
                from android.graphics import Canvas, Bitmap, Paint
                bmp = Bitmap.createBitmap(atlas_w, cell, Bitmap.Config.ARGB_8888)
                canvas = Canvas(bmp)
                for idx in range(atlas_count):
                    x0 = idx * cell
                    cur_e = emojis[idx % n_emojis]
                    angle = idx * (360.0 / atlas_count) % 360 if rotation else 0
                    drawn = False
                    if self._m_drawable is not None:
                        try:
                            drawable = self._m_drawable.invoke(None, cur_e)
                            if drawable is not None:
                                loaded = True
                                if self._m_is_loaded:
                                    loaded = bool(self._m_is_loaded.invoke(drawable))
                                if loaded:
                                    if angle != 0:
                                        canvas.save()
                                        canvas.rotate(angle, x0 + cell / 2.0, cell / 2.0)
                                    drawable.setBounds(x0, 0, x0 + cell, cell)
                                    drawable.draw(canvas)
                                    if angle != 0:
                                        canvas.restore()
                                    drawn = True
                        except Exception:
                            pass
                    if not drawn:
                        paint = Paint(Paint.ANTI_ALIAS_FLAG)
                        paint.setTextSize(cell * 0.75)
                        paint.setTextAlign(Paint.Align.CENTER)
                        fm = paint.getFontMetrics()
                        y = cell / 2.0 - (fm.ascent + fm.descent) / 2.0
                        if angle != 0:
                            canvas.save()
                            canvas.rotate(angle, x0 + cell / 2.0, cell / 2.0)
                        canvas.drawText(cur_e, x0 + cell / 2.0, y, paint)
                        if angle != 0:
                            canvas.restore()
                self._bitmaps[rot_key] = bmp
            self._f_bitmap.set(effect, self._bitmaps[rot_key])
            if n_emojis > 1:
                self._randomize_particle_types(effect, n_emojis)
        except Exception:
            pass

    def get_active_emojis(self) -> list:
        if self.get_setting('stars_mode', False):
            return ['⭐']
        if self.get_setting('daynight_mode', False):
            return [self._get_daynight_emoji()]
        if self.get_setting('weather_mode', False) and self._weather_code is not None:
            emoji = self._weather_to_emoji(self._weather_code)
            if emoji is None:
                return []
            return [emoji] if emoji else ['❄️']
        chat_override = self._get_chat_emoji_override()
        raw = chat_override if chat_override is not None else str(self.get_setting('custom_emoji', '')).strip()
        if not raw:
            return ['❄️']
        import re
        parts = [e.strip() for e in re.split('[ ,]+', raw) if e.strip()]
        return parts if parts else ['❄️']

    def _get_current_dialog_id(self):
        try:
            fragment = get_last_fragment()
            if fragment is not None:
                did = int(fragment.getDialogId())
                self._current_dialog_id_cache = did
                return did
        except Exception:
            pass
        return getattr(self, '_current_dialog_id_cache', None)

    def _chat_emoji_map(self) -> dict:
        try:
            raw = self.get_setting('chat_emoji_map', '') or ''
            data = json.loads(raw) if raw else {}
            return data if isinstance(data, dict) else {}
        except Exception:
            return {}

    def _save_chat_emoji_map(self, data: dict):
        try:
            self.set_setting('chat_emoji_map', json.dumps(data), reload_settings=True)
        except Exception:
            pass

    def _get_chat_emoji_override(self):
        did = self._get_current_dialog_id()
        if did is None:
            return None
        val = self._chat_emoji_map().get(str(did))
        return val if val else None

    def _get_dialog_id(self, context) -> int:
        try:
            for key in ('dialog_id', 'dialogId', 'chatId', 'chat_id', 'userId', 'user_id'):
                try:
                    val = context.get(key)
                    if val is not None:
                        return int(val)
                except Exception:
                    pass
            try:
                chat = context.get('chat')
                if chat is not None:
                    return -int(chat.id)
            except Exception:
                pass
            try:
                user = context.get('user')
                if user is not None:
                    return int(user.id)
            except Exception:
                pass
            fragment = get_last_fragment()
            if fragment is not None and hasattr(fragment, 'getDialogId'):
                return int(fragment.getDialogId())
        except Exception:
            pass
        return 0

    def _chat_shape_map(self) -> dict:
        try:
            raw = self.get_setting('chat_shape_map', '') or ''
            data = json.loads(raw) if raw else {}
            return data if isinstance(data, dict) else {}
        except Exception:
            return {}

    def _save_chat_shape_map(self, data: dict):
        try:
            self.set_setting('chat_shape_map', json.dumps(data), reload_settings=True)
        except Exception:
            pass

    def _get_chat_shape_override(self):
        did = self._get_current_dialog_id()
        if did is None:
            return None
        val = self._chat_shape_map().get(str(did))
        return val if val else None

    def _on_chat_shape_click(self, context):
        try:
            did = self._get_dialog_id(context)
            if did == 0:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_error('Не удалось определить чат')
                return
            self._current_dialog_id_cache = did
            run_on_ui_thread(lambda: self._show_chat_shape_picker(did))
        except Exception:
            pass

    def _show_chat_shape_picker(self, dialog_id):
        try:
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import BottomSheet, Theme
            from org.telegram.ui.Components import LayoutHelper
            from android.view import Gravity
            from android.widget import LinearLayout, TextView
            from android.util import TypedValue
            from android_utils import OnClickListener
            from ui.bulletin import BulletinHelper

            fragment = get_last_fragment()
            if not fragment:
                return
            act = fragment.getParentActivity()
            if not act:
                return
            try:
                if getattr(self, '_shape_sheet', None) is not None:
                    self._shape_sheet.dismiss()
                    self._shape_sheet = None
            except Exception:
                pass

            current = self._chat_shape_map().get(str(dialog_id), '')

            builder = BottomSheet.Builder(act)
            builder.setApplyTopPadding(False)
            builder.setApplyBottomPadding(False)
            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(8), AndroidUtilities.dp(16), AndroidUtilities.dp(16))

            title = TextView(act)
            title.setText('🎨 Пресет для этого чата')
            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            title.setTypeface(AndroidUtilities.bold())
            title.setGravity(Gravity.CENTER)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            title.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(12))
            root.addView(title, LayoutHelper.createLinear(-1, -2))

            sheet_ref = [None]
            plugin = self
            options = [
                ('', '— общие эмодзи/пресет —'),
                ('snowflake', '❄️ Снежинки'),
                ('sakura', '🌸 Сакура'),
                ('matrix', '🟩 Матрица'),
                ('rain', '💧 Дождик'),
                ('leaves', '🍂 Осенний листопад'),
            ]

            def make_row(shape_key, label):
                row = TextView(act)
                row.setText(('✓ ' if shape_key == current else '') + label)
                row.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
                row.setGravity(Gravity.CENTER_VERTICAL)
                row.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                row.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(12), AndroidUtilities.dp(8), AndroidUtilities.dp(12))
                row.setClickable(True)

                def on_pick(v, sk=shape_key):
                    m = plugin._chat_shape_map()
                    if sk:
                        m[str(dialog_id)] = sk
                    else:
                        m.pop(str(dialog_id), None)
                    plugin._save_chat_shape_map(m)
                    plugin._sync_settings()
                    BulletinHelper.show_info('✅ Пресет для чата сохранён')
                    if sheet_ref[0]:
                        sheet_ref[0].dismiss()
                    plugin._shape_sheet = None

                row.setOnClickListener(OnClickListener(on_pick))
                return row

            for key, label in options:
                root.addView(make_row(key, label), LayoutHelper.createLinear(-1, -2))

            builder.setCustomView(root)
            sheet = builder.create()
            sheet_ref[0] = sheet
            self._shape_sheet = sheet
            sheet.show()
        except Exception:
            pass

    def _reset_chat_shapes(self, view=None):
        try:
            self._save_chat_shape_map({})
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_info('✅ Пресеты чатов сброшены')
            run_on_ui_thread(self._on_emoji_settings_changed)
        except Exception:
            pass

    def _on_chat_emoji_click(self, context):
        try:
            did = self._get_dialog_id(context)
            if did == 0:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_error('Не удалось определить чат')
                return
            self._current_dialog_id_cache = did
            run_on_ui_thread(lambda: self._show_chat_emoji_picker(did))
        except Exception:
            pass

    def _show_chat_emoji_picker(self, dialog_id):
        try:
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import BottomSheet, Theme
            from org.telegram.ui.Components import LayoutHelper
            from android.view import View, Gravity
            from android.widget import LinearLayout, TextView, ScrollView
            from android.util import TypedValue
            from android_utils import OnClickListener
            from ui.bulletin import BulletinHelper
            fragment = get_last_fragment()
            if not fragment:
                return
            act = fragment.getParentActivity()
            if not act:
                return
            try:
                if getattr(self, '_emoji_sheet', None) is not None:
                    self._emoji_sheet.dismiss()
                    self._emoji_sheet = None
            except Exception:
                pass
            current = self._chat_emoji_map().get(str(dialog_id), '')
            selected = [e for e in current.split(' ') if e]
            plugin = self
            state = {'saved': False}
            sheet_ref = [None]
            buttons = {}
            color_selected = Theme.getColor(Theme.key_featuredStickers_addButton)
            color_unselected = 0
            builder = BottomSheet.Builder(act)
            builder.setApplyTopPadding(False)
            builder.setApplyBottomPadding(False)
            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(8), AndroidUtilities.dp(16), AndroidUtilities.dp(16))
            title = TextView(act)
            title.setText('❄️ Эмодзи для этого чата')
            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            title.setTypeface(AndroidUtilities.bold())
            title.setGravity(Gravity.CENTER)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            title.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(4))
            root.addView(title, LayoutHelper.createLinear(-1, -2))
            preview = TextView(act)
            preview.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            preview.setGravity(Gravity.CENTER)
            preview.setPadding(0, AndroidUtilities.dp(4), 0, AndroidUtilities.dp(4))
            try:
                preview.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
            except Exception:
                pass
            root.addView(preview, LayoutHelper.createLinear(-1, -2))

            def update_preview():
                preview.setText(' '.join(selected) if selected else '— общие эмодзи —')
            update_preview()
            clear_btn = TextView(act)
            clear_btn.setText('✕ Очистить выбор')
            clear_btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            clear_btn.setGravity(Gravity.CENTER)
            try:
                clear_btn.setTextColor(Theme.getColor(Theme.key_text_RedRegular))
            except Exception:
                pass
            clear_btn.setPadding(0, 0, 0, AndroidUtilities.dp(8))
            clear_btn.setClickable(True)

            def on_clear(v):
                selected.clear()
                for bv in buttons.values():
                    bv.setBackgroundColor(color_unselected)
                update_preview()
            clear_btn.setOnClickListener(OnClickListener(on_clear))
            root.addView(clear_btn, LayoutHelper.createLinear(-1, -2))
            scroll = ScrollView(act)
            scroll_content = LinearLayout(act)
            scroll_content.setOrientation(LinearLayout.VERTICAL)
            scroll.addView(scroll_content)

            def make_toggle(emoji):

                def _toggle(v):
                    if emoji in selected:
                        selected.remove(emoji)
                        v.setBackgroundColor(color_unselected)
                    else:
                        selected.append(emoji)
                        v.setBackgroundColor(color_selected)
                    update_preview()
                return _toggle
            PER_ROW = 8
            for cat_name, emojis in self.EMOJI_CATEGORIES:
                cat_header = TextView(act)
                cat_header.setText(cat_name)
                cat_header.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                try:
                    cat_header.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                except Exception:
                    pass
                cat_header.setPadding(0, AndroidUtilities.dp(10), 0, AndroidUtilities.dp(4))
                scroll_content.addView(cat_header, LayoutHelper.createLinear(-1, -2))
                row = None
                for i, e in enumerate(emojis):
                    if i % PER_ROW == 0:
                        row = LinearLayout(act)
                        row.setOrientation(LinearLayout.HORIZONTAL)
                        scroll_content.addView(row, LayoutHelper.createLinear(-1, -2))
                    btn = TextView(act)
                    btn.setText(e)
                    btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22)
                    btn.setGravity(Gravity.CENTER)
                    btn.setClickable(True)
                    btn.setBackgroundColor(color_selected if e in selected else color_unselected)
                    btn.setOnClickListener(OnClickListener(make_toggle(e)))
                    row.addView(btn, LayoutHelper.createLinear(36, 36, 2, 2, 2, 2))
                    buttons[e] = btn
            root.addView(scroll, LayoutHelper.createLinear(-1, AndroidUtilities.dp(230)))
            div = View(act)
            div.setBackgroundColor(Theme.getColor(Theme.key_divider))
            root.addView(div, LayoutHelper.createLinear(-1, 1, 0, 10, 0, 8))
            btn_row = LinearLayout(act)
            btn_row.setOrientation(LinearLayout.HORIZONTAL)
            cancel_btn = TextView(act)
            cancel_btn.setText('Отмена')
            cancel_btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
            cancel_btn.setGravity(Gravity.CENTER)
            try:
                cancel_btn.setTextColor(Theme.getColor(Theme.key_dialogTextRed))
            except Exception:
                pass
            cancel_btn.setPadding(0, AndroidUtilities.dp(14), 0, AndroidUtilities.dp(14))
            try:
                cancel_btn.setBackground(Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(8), Theme.getColor(Theme.key_dialogBackground), Theme.getColor(Theme.key_dialogBackgroundGray)))
            except Exception:
                pass
            cancel_btn.setClickable(True)

            def on_cancel(v):
                if state['saved']:
                    return
                state['saved'] = True
                if sheet_ref[0]:
                    sheet_ref[0].dismiss()
                plugin._emoji_sheet = None
            cancel_btn.setOnClickListener(OnClickListener(on_cancel))
            lp_cancel = LayoutHelper.createLinear(-2, -2, 1.0)
            btn_row.addView(cancel_btn, lp_cancel)
            spacer = View(act)
            btn_row.addView(spacer, LayoutHelper.createLinear(AndroidUtilities.dp(8), -2))
            ok_btn = TextView(act)
            ok_btn.setText('Сохранить')
            ok_btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
            ok_btn.setTypeface(AndroidUtilities.bold())
            ok_btn.setGravity(Gravity.CENTER)
            ok_btn.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
            ok_btn.setPadding(0, AndroidUtilities.dp(14), 0, AndroidUtilities.dp(14))
            try:
                ok_btn.setBackground(Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(8), Theme.getColor(Theme.key_featuredStickers_addButton), Theme.getColor(Theme.key_featuredStickers_addButtonPressed)))
            except Exception:
                ok_btn.setBackgroundColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            ok_btn.setClickable(True)

            def on_ok(v):
                if state['saved']:
                    return
                state['saved'] = True
                val = ' '.join(selected).strip()
                m = plugin._chat_emoji_map()
                if val:
                    m[str(dialog_id)] = val
                    BulletinHelper.show_info(f'✅ Для этого чата: {val}')
                else:
                    m.pop(str(dialog_id), None)
                    BulletinHelper.show_info('✅ Возвращены общие эмодзи')
                plugin._save_chat_emoji_map(m)
                plugin._clear_aniv_shape()
                run_on_ui_thread(plugin._on_emoji_settings_changed)
                if sheet_ref[0]:
                    sheet_ref[0].dismiss()
                plugin._emoji_sheet = None
            ok_btn.setOnClickListener(OnClickListener(on_ok))
            lp_ok = LayoutHelper.createLinear(-2, -2, 1.0)
            btn_row.addView(ok_btn, lp_ok)
            root.addView(btn_row, LayoutHelper.createLinear(-1, -2))
            builder.setCustomView(root)
            sheet = builder.create()
            sheet_ref[0] = sheet
            self._emoji_sheet = sheet
            sheet.show()
        except Exception:
            pass

    def _get_weather_intensity(self):
        if not self.get_setting('weather_intensity', False):
            return (1.0, 1.0)
        code = self._weather_code
        if code is None:
            return (1.0, 1.0)
        if code in (71, 73, 75, 77, 85, 86):
            temp = getattr(self, '_weather_temperature', None)
            if code in (75, 86):
                return (1.4, 0.7)
            elif code in (73, 85):
                return (1.0, 0.8)
            else:
                return (0.6, 0.9)
        if code in (51, 53, 55, 61, 63, 65, 80, 81, 82):
            if code in (65, 82):
                return (1.5, 1.8)
            elif code in (63, 81):
                return (1.0, 1.4)
            else:
                return (0.5, 1.0)
        if code in (95, 96, 99):
            return (1.3, 1.6)
        if code in (45, 48):
            return (0.4, 0.4)
        if code in (0, 1):
            return (0.3, 0.6)
        return (1.0, 1.0)

    def _activate_mode(self, key: str, value):
        if not value:
            return
        if key == 'stars_mode':
            self._stars_ticks = {}
        modes = ['stars_mode', 'daynight_mode', 'weather_mode']
        for mode in modes:
            if mode != key:
                self.set_setting(mode, False, reload_settings=False)
        self.set_setting(key, True, reload_settings=False)

    def _get_daynight_emoji(self) -> str:
        import time
        hour = int(time.strftime('%H'))
        is_day = 6 <= hour < 21
        if is_day:
            if 6 <= hour < 10:
                if self.get_setting('daynight_disable_dawn', False):
                    return '☀️'
                return '🌅'
            elif 10 <= hour < 17:
                return '☀️'
            else:
                if self.get_setting('daynight_disable_dusk', False):
                    return '☀️'
                return '🌇'
        else:
            return self._get_moon_phase_emoji()

    def _get_moon_phase_emoji(self) -> str:
        import time, math
        known_new_moon = 2451550.1
        lunar_cycle = 29.53058867
        now = time.time()
        jd = now / 86400.0 + 2440587.5
        days_since = jd - known_new_moon
        phase = days_since % lunar_cycle / lunar_cycle
        moon_emojis = [(0.0, '🌑'), (0.07, '🌒'), (0.21, '🌓'), (0.35, '🌔'), (0.46, '🌕'), (0.6, '🌖'), (0.74, '🌗'), (0.88, '🌘'), (1.0, '🌑')]
        emoji = '🌕'
        for threshold, e in reversed(moon_emojis):
            if phase >= threshold:
                emoji = e
                break
        return emoji

    def get_active_emoji(self) -> str:
        emojis = self.get_active_emojis()
        return emojis[0] if emojis else ''
