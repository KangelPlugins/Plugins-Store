_PAYLOAD_SHA256 = "123c771f85c3c9f449d6090d7efdc5ef4cc4bbf7224f658f6b057672fa66dd09"
_RT_PKG = "eblannft_runtime"
_RT_ALIAS = "_eblannft_rt_cat"

_STR_CLS = None
_INT_T = None
_LONG_T = None


def _cause(e):
    msg = repr(e)
    try:
        c = e.getCause()
        d = 0
        while c is not None and d < 6:
            msg += " <- " + str(c)
            c = c.getCause(); d += 1
    except Exception:
        pass
    return msg


def _selected_account():
    try:
        return int(UserConfig.selectedAccount or 0)
    except Exception:
        return 0


def _cache_uid():
    # MUST match production: keyed by account SLOT, not clientUserId.
    return 10000000000 + _selected_account()


def _real_uid():
    try:
        cfg = UserConfig.getInstance(_selected_account())
        uid = getattr(cfg, "clientUserId", 0)
        if not uid:
            try:
                uid = cfg.getClientUserId()
            except Exception:
                uid = 0
        return int(uid or 0)
    except Exception:
        return 0


def _gv(obj, name, default=None):
    """Read a Java field by name: public attr → public field → declared field."""
    if obj is None:
        return default
    try:
        return getattr(obj, name)
    except Exception:
        pass
    try:
        c = obj.getClass()
        while c is not None:
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                return f.get(obj)
            except Exception:
                c = c.getSuperclass()
    except Exception:
        pass
    return default


# ---- native catalog hooks (cold path: only fire while ResaleGiftsFragment is open) ----
if MethodHook is not None:
    class _CatUpdateHook(MethodHook):
        """Block the native server-driven list refresh for our hijacked fragment."""
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                ctrl = getattr(self.plugin, "_cat_ctrl", None)
                if ctrl and ctrl.fragment and ctrl.fragment.equals(param.thisObject):
                    param.setResult(None)
            except Exception:
                pass

    class _CatFillHook(MethodHook):
        """Replace the adapter's item list with our catalog gift cells."""
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                ctrl = getattr(self.plugin, "_cat_ctrl", None)
                if ctrl and ctrl.fragment and ctrl.fragment.equals(param.thisObject):
                    param.setResult(None)
                    ctrl._fill(param.args[0], param.args[1])
            except Exception:
                pass

    class _CatClickHook(MethodHook):
        """Route a cell tap to our constructor instead of the native resale flow."""
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                ctrl = getattr(self.plugin, "_cat_ctrl", None)
                if ctrl and ctrl.fragment and ctrl.fragment.equals(param.thisObject):
                    param.setResult(None)
                    item = param.args[0]
                    ctrl._click_item(item)
            except Exception:
                pass

    class _NoAnimSelectHook(MethodHook):
        """Kill the animated select/deselect of attribute cells in the gift
        constructor. Switching model used to fade the PREVIOUS model's selection
        ring out over ~280ms («обводка моргает … с задержкой») — forcing the
        `animated` arg of GiftAttributeCell.setSelected(boolean,boolean) to false
        makes the ring snap instantly with no flicker."""
        def __init__(self):
            super().__init__()

        def before_hooked_method(self, param):
            try:
                args = param.args
                if args is not None and len(args) >= 2:
                    args[1] = False
            except Exception:
                pass

    class _DoUpgradeHook(MethodHook):
        """Intercept StarGiftSheet.doUpgrade() for OUR upgradable gift: block the real
        network upgrade and play TG's native reveal with a random local NFT instead.
        The preview/roll state is already set up by the native openUpgrade() that ran
        when the user tapped «Улучшить», so the roller animation plays for real."""
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                if self.plugin._on_do_upgrade(getattr(param, "thisObject", None)):
                    param.setResult(None)   # consume → no real RPC / star charge
            except Exception as e:
                # surface a swallowed error → otherwise the native RPC fires and we never know why
                try: self.plugin._toast("upg hook EXC: " + repr(e)[:120])
                except Exception: pass

    class _CraftGateHook(MethodHook):
        """Expose Telegram's own forge shortcut for our locally owned NFT gifts."""
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                sheet = getattr(param, "thisObject", None)
                entry = self.plugin._match_craft_entry(sheet)
                if entry is not None and self.plugin._craft_entry_eligible(entry, sheet, resolve=True):
                    param.setResult(True)
            except Exception:
                pass

    class _OpenCraftHook(MethodHook):
        """Route the native forge button to local crafting instead of Telegram RPC."""
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                sheet = getattr(param, "thisObject", None)
                entry = self.plugin._match_craft_entry(sheet)
                if entry is None:
                    return
                if not self.plugin._craft_entry_eligible(entry, sheet, resolve=True):
                    param.setResult(None)
                    self.plugin._toast("Этот подарок сейчас нельзя использовать для крафта")
                    return
                param.setResult(None)
                plugin = self.plugin
                run_on_ui_thread(lambda: plugin._open_local_crafting(entry, sheet))
            except Exception as e:
                try: self.plugin.log("[craft] native click: " + _cause(e))
                except Exception: pass

    class _CraftSetHook(MethodHook):
        """Make the existing TopView.craftView visible immediately after set()."""
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                sheet = getattr(param, "thisObject", None)
                self.plugin._show_native_craft_button(sheet)
                # StarGiftSheet performs deferred page/layout updates after set().
                # Some builds hide craftView again there, so re-assert visibility
                # after the sheet has settled (eligibility is cached by base id).
                plugin = self.plugin
                if run_on_ui_thread is not None:
                    run_on_ui_thread(lambda: plugin._show_native_craft_button(sheet), 120)
                    run_on_ui_thread(lambda: plugin._show_native_craft_button(sheet), 420)
            except Exception:
                pass

    class _SettingsHeaderHook(MethodHook):
        """After PluginSettingsActivity.fillItems → inject the frog header card + the
        «Обновления»/«Кэш» MD3 cards (production look). Cold path: fires only when the
        plugin settings screen renders."""
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                activity = getattr(param, "thisObject", None)
                args = getattr(param, "args", None)
                items = args[0] if args and len(args) > 0 else None
                if activity is not None and items is not None:
                    self.plugin._inject_settings_header(activity, items)
            except Exception:
                pass

    class _ProfileOpenHook(MethodHook):
        """Tapping a .profile document in a chat → run OUR import sheet instead of the
        native file viewer (port of the regular plugin's ProfileConfigOpenHook)."""
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                args = getattr(param, "args", None)
                msg = args[0] if args and len(args) > 0 else None
                if msg is None:
                    return
                try: fn = str(msg.getFileName() or "")
                except Exception: fn = ""
                if not fn.lower().endswith(".profile"):
                    return
                try:
                    mname = str(param.method.getName() or "")
                except Exception:
                    mname = ""
                try:
                    param.setResult(True if "openForView" in mname else None)  # block native open
                except Exception:
                    pass
                self.plugin._handle_profile_file_open(msg)
            except Exception:
                pass
else:
    _CatUpdateHook = _CatFillHook = _CatClickHook = _NoAnimSelectHook = _DoUpgradeHook = None
    _CraftGateHook = _OpenCraftHook = _CraftSetHook = None
    _SettingsHeaderHook = None
    _ProfileOpenHook = None


class _NativeCatalog:
    """Hijacks the native ResaleGiftsFragment to render the 114-gift NFT catalog
    with real Telegram gift cells. Tapping a gift opens the native constructor."""
    def __init__(self, plugin, nft_only=True):
        self.plugin = plugin
        self.nft_only = bool(nft_only)
        self.fragment = None
        self.adapter = None
        self.items = []
        self._retry = 0
        self.qty = 1            # regular-gifts catalog: how many copies a tap adds
        self._qty_pill = None

    def _load_items(self):
        return self.plugin._catalog_items(self.nft_only)

    def show(self):
        plugin = self.plugin
        uid = _real_uid()
        Frag = jclass("org.telegram.ui.Gifts.ResaleGiftsFragment")
        title = "Каталог NFT" if self.nft_only else "Каталог подарков"
        attempts = [
            lambda: Frag(uid, title, 0, None),
            lambda: Frag(int(uid), title, 0, None),
            lambda: Frag(uid, title, None),
            lambda: Frag(uid, title),
            lambda: Frag(uid),
            lambda: Frag(),
        ]
        last = None
        matched = -1
        for i, f in enumerate(attempts):
            try:
                fr = f()
                if fr is not None:
                    self.fragment = fr
                    matched = i
                    break
            except Exception as e:
                last = e
        if self.fragment is None:
            raise last or Exception("ResaleGiftsFragment ctor unavailable")
        try:
            plugin.log("[cat] fragment ctor variant=%d uid=%s" % (matched, uid))
        except Exception:
            pass
        plugin._cat_ctrl = self
        get_last_fragment().presentFragment(self.fragment)
        run_on_ui_thread(self._init, 150)

    def _init(self):
        try:
            lv = _gv(self.fragment, "listView")
            ev = _gv(self.fragment, "emptyView")
            if ev is not None:
                try:
                    ev.setVisibility(8)
                    ev.setAlpha(0.0)
                except Exception:
                    pass
            self.adapter = _gv(lv, "adapter") if lv is not None else None
            self.items = self._load_items()
            try:
                self.plugin.log("[cat] init: listView=%s adapter=%s items=%d nft=%s" % (
                    lv is not None, self.adapter is not None, len(self.items or []), self.nft_only))
            except Exception:
                pass
            self._refresh()
            if not self.nft_only:
                self._inject_qty_pill()
            if not self.items:
                self.plugin._toast("загружаю каталог…")
                try:
                    c = self.plugin._stars_ctrl()
                    if c is not None:
                        c.loadStarGifts()
                except Exception:
                    pass
                run_on_ui_thread(self._retry_load, 1000)
        except Exception as e:
            try:
                self.plugin.log("[cat] init: " + _cause(e))
            except Exception:
                pass

    def _retry_load(self):
        if self.fragment is None:
            return
        if not self.items:
            self.items = self._load_items()
            self._refresh()
            if not self.items:
                self._retry += 1
                if self._retry < 8:
                    run_on_ui_thread(self._retry_load, 1000)
                else:
                    self.plugin._toast("каталог пуст")

    def _refresh(self):
        try:
            sub = len(self.items or [])
            unit = "NFT" if self.nft_only else "подарков"
            ab = _gv(self.fragment, "actionBar")
            if ab is not None:
                try:
                    ab.setSubtitle(("%d %s" % (sub, unit)) if sub else "Пусто")
                except Exception:
                    pass
            if self.adapter is not None:
                self.adapter.update(True)
                lv = _gv(self.fragment, "listView")
                if lv is not None:
                    try:
                        lv.scrollToPosition(0)
                    except Exception:
                        pass
        except Exception:
            pass

    def _make_cell(self, Factory, g):
        """asStarGift signature drifts between TG builds — try known arities."""
        variants = (
            lambda: Factory.asStarGift(0, g, False, False, False, False, False),
            lambda: Factory.asStarGift(0, g, False, False, False, False),
            lambda: Factory.asStarGift(0, g, False, False, False),
            lambda: Factory.asStarGift(0, g, False, False),
            lambda: Factory.asStarGift(0, g, False),
            lambda: Factory.asStarGift(0, g),
        )
        for i, v in enumerate(variants):
            try:
                it = v()
                if it is not None:
                    if getattr(self, "_cell_variant", -1) != i:
                        self._cell_variant = i
                        try:
                            self.plugin.log("[cat] asStarGift variant=%d argc=%d" % (i, 7 - i))
                        except Exception:
                            pass
                    return it
            except Exception:
                continue
        return None

    def _fill(self, items, adapter):
        try:
            Factory = jclass("org.telegram.ui.Gifts.GiftSheet$GiftCell$Factory")
        except Exception as e:
            Factory = None
            try:
                self.plugin.log("[cat] no GiftCell.Factory: " + _cause(e))
            except Exception:
                pass
        added = 0
        for g in list(self.items or []):
            if self.nft_only:
                try:
                    self.plugin._unsell(g)   # drop the «продан» ribbon on NFT cells
                except Exception:
                    pass
            it = self._make_cell(Factory, g) if Factory is not None else None
            if it is not None:
                try:
                    it.object = g
                except Exception:
                    pass
                items.add(it)
                added += 1
        try:
            self.plugin.log("[cat] fill: items=%d cells=%d" % (len(self.items or []), added))
        except Exception:
            pass
        if added == 0 and UItem is not None:
            try:
                items.add(UItem.asShadow("Каталог недоступен"))
            except Exception:
                pass

    def _qty_label(self):
        try:
            return str(int(self.qty or 1)) + "×"
        except Exception:
            return "1×"

    def _inject_qty_pill(self):
        """Floating «N×» pill (regular-gifts catalog only): choose how many identical
        copies a gift tap adds. Default 1×; tap → numpad → any number."""
        if self.nft_only or PopupWindow is None or TextView is None:
            return
        if self._qty_pill is not None:
            return
        try:
            root = _gv(self.fragment, "fragmentView")
            if root is None:
                try:
                    root = self.fragment.getFragmentView()
                except Exception:
                    root = None
            if root is None:
                self.plugin.log("[cat] qty pill: no fragmentView")
                return
            ctx = root.getContext()
            pill = self.plugin._qty_pill_view(ctx, self._qty_label())
            self._qty_pill = pill
            pill.setOnClickListener(self.plugin._click(lambda v: self._open_qty_pad()))
            lp = FrameLayout.LayoutParams(-2, -2, Gravity.BOTTOM | Gravity.RIGHT)
            lp.rightMargin = AndroidUtilities.dp(16)
            lp.bottomMargin = AndroidUtilities.dp(24)
            root.addView(pill, lp)
            self.plugin.log("[cat] qty pill injected")
        except Exception as e:
            try:
                self.plugin.log("[cat] qty pill: " + _cause(e))
            except Exception:
                pass

    def _open_qty_pad(self):
        ctrl = self

        def _submit(text):
            try:
                n = int(str(text or "1").strip() or "1")
            except Exception:
                n = 1
            ctrl.qty = max(1, min(n, 99))
            try:
                if ctrl._qty_pill is not None:
                    ctrl._qty_pill.setText(ctrl._qty_label())
            except Exception:
                pass
        self.plugin._input("Сколько одинаковых подарков добавить? (1–99)",
                           str(int(self.qty or 1)), _submit, numeric=True)

    def _click_item(self, uitem):
        try:
            gift = None
            try:
                gift = getattr(uitem, "object", None)
            except Exception:
                gift = None
            if gift is None:
                gift = _gv(uitem, "object")
            if gift is None:
                return
            gid = 0
            try:
                gid = int(_gv(gift, "id", 0) or 0)
            except Exception:
                gid = 0
            try:
                self.plugin.log("[cat] click gid=%d" % gid)
            except Exception:
                pass
            if gid <= 0:
                self.plugin._toast("не удалось определить gift_id")
                return
            title = ""
            try:
                title = str(_gv(gift, "title", "") or "")
            except Exception:
                title = ""
            base = gift
            if not self.nft_only:
                # regular gift → add `qty` identical copies to the library (no constructor)
                self.plugin._add_regular_gifts(base, title, self.qty)
                try:
                    self.fragment.finishFragment()
                except Exception:
                    pass
                self.plugin._cat_ctrl = None
                return
            try:
                self.fragment.finishFragment()
            except Exception:
                pass
            self.plugin._cat_ctrl = None
            run_on_ui_thread(lambda: self.plugin._catalog_pick(gid, base, title), 120)
        except Exception as e:
            try:
                self.plugin.log("[cat] click: " + _cause(e))
            except Exception:
                pass


def _resolve_data_dir():
    if get_plugins_dir is None:
        return ""
    base = get_plugins_dir()
    import os
    new_dir = os.path.join(base, "eblannft_data")
    return new_dir


def _extract_runtime(root):
    raw = base64.b64decode(_PAYLOAD_B64)
    if _hashlib.sha256(raw).hexdigest() != _PAYLOAD_SHA256:
        raise RuntimeError("runtime payload hash mismatch")
    os.makedirs(root, exist_ok=True)
    with _zipfile.ZipFile(_io.BytesIO(raw), "r") as zf:
        for info in zf.infolist():
            name = str(info.filename or "").replace("\\", "/")
            if not name.startswith(_RT_PKG + "/") or name.endswith("/"):
                continue
            dest = os.path.abspath(os.path.join(root, name.replace("/", os.sep)))
            with zf.open(info, "r") as src:
                data = src.read()
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest, "wb") as out:
                out.write(data)


def _import_runtime(root):
    pkg_dir = os.path.join(root, _RT_PKG)
    init_py = os.path.join(pkg_dir, "__init__.py")
    plugin_py = os.path.join(pkg_dir, "plugin.py")
    spec = _ilu.spec_from_file_location(_RT_ALIAS, init_py, submodule_search_locations=[pkg_dir])
    pkg_mod = _ilu.module_from_spec(spec)
    _sys.modules[_RT_ALIAS] = pkg_mod
    spec.loader.exec_module(pkg_mod)
    mspec = _ilu.spec_from_file_location(_RT_ALIAS + ".plugin", plugin_py)
    pmod = _ilu.module_from_spec(mspec)
    _sys.modules[_RT_ALIAS + ".plugin"] = pmod
    mspec.loader.exec_module(pmod)
    for attr in ("NftClonerPlugin", "EblanNftPlugin"):
        cls = getattr(pmod, attr, None)
        if isinstance(cls, type):
            return cls, pmod
    raise ImportError("runtime plugin class not found")


class Plugin(BasePlugin):
    # ---------------- lifecycle ----------------
    def on_plugin_load(self):
        global _STR_CLS, _INT_T, _LONG_T, __version__
        self._clazz = None
        try:
            # the displayed version tracks the INSTALLED core (channel-updated), not the
            # embedded baseline — surface it everywhere __version__ is read.
            try:
                iv = self._installed_version()
                if iv:
                    __version__ = iv
            except Exception:
                pass
            dex, src = self._load_core_dex()
            buf = ByteBuffer.wrap(dex)
            parent = ApplicationLoader.applicationContext.getClassLoader()
            self._clazz = InMemoryDexClassLoader(buf, parent).loadClass(_CLASS_NAME)
            _STR_CLS = JavaClass.forName("java.lang.String")
            _INT_T = JInteger.TYPE
            _LONG_T = JLong.TYPE

            data_dir = _resolve_data_dir()
            m = self._clazz.getMethod("init", _STR_CLS, _STR_CLS, _STR_CLS)
            status = m.invoke(None, data_dir, str(_cache_uid()), str(_real_uid()))
            self.log("eblanNFT core[" + src + " v" + __version__ + "]: " + str(status))
        except Exception as e:
            self.log("eblanNFT load error: " + _cause(e))
        # auto-update: start the periodic background poll → the popup can appear ANYWHERE
        # in the client (not only on the settings screen), and re-offers if dismissed.
        try:
            self._start_update_loop()
        except Exception:
            pass
        # The hook installs are pure reflection (Class.forName + getDeclaredMethods over
        # StarGiftSheet / PluginSettingsActivity / AndroidUtilities — hundreds of Method
        # objects each) and all guard COLD screens nobody can reach within the first
        # second of a cold start — so run them off the load path entirely.
        self._unloaded = False
        # Install the doUpgrade hook SYNCHRONOUSLY here (like the known-good v1.1.2) — the deferred
        # timer below apparently didn't fire on some builds, so the fake-upgrade interception was
        # never installed and «Улучшить» hit the real server (STARGIFT_ALREADY_CONVERTED). Idempotent
        # (_gs_hooks_done), so the deferred pass becomes a no-op.
        try:
            self._install_gift_sheet_hooks()
        except Exception:
            pass
        try:
            import threading
            t = threading.Timer(0.8, self._install_deferred_hooks)
            t.daemon = True
            t.start()
        except Exception:
            self._install_deferred_hooks()

        # Prime the compact upgrade lookup away from the UI thread. The first tap on
        # «Улучшить» no longer bridges and parses the complete gift library.
        try:
            import threading
            t = threading.Timer(1.5, self._prewarm_gift_snapshot)
            t.daemon = True
            t.start()
        except Exception:
            pass

    def _prewarm_gift_snapshot(self):
        if getattr(self, "_unloaded", False):
            return
        try:
            idx = {}
            for g in self._gifts():
                try:
                    if str(g.get("kind") or g.get("gift_kind") or "") != "regular":
                        continue
                    base_id = int(g.get("base_gift_id") or 0)
                    # doUpgrade can only fire for a gift Telegram already marked
                    # upgradable, so indexing by base id is sufficient and avoids
                    # deserializing every regular gift during startup.
                    if base_id > 0:
                        idx[base_id] = g
                except Exception:
                    continue
            self._upg_match_cache = idx
        except Exception:
            pass

    def _install_deferred_hooks(self):
        if getattr(self, "_unloaded", False):
            return
        # surface the FULL stack of any crash captured on the previous run (the init
        # status only carries the first line) — so a field crash is diagnosable from the log.
        try:
            lc = self._jvoid("getLastCrash")
            if lc and str(lc) != "(none)":
                self.log("eblanNFT ⚠ LAST CRASH (previous run):\n" + str(lc))
        except Exception:
            pass
        # cold-path: hook StarGiftSheet so OUR upgradable gifts get a native «Улучшить»
        try:
            self._install_gift_sheet_hooks()
        except Exception as e:
            self.log("[upg] install hooks: " + _cause(e))
        # cold-path: inject the frog header + Обновления/Кэш cards into our settings screen
        try:
            self._install_settings_header_hook()
        except Exception as e:
            self.log("[hdr] install hooks: " + _cause(e))
        # cold-path: tapping a .profile file in a chat opens our import sheet
        try:
            self._install_profile_open_hook()
        except Exception as e:
            self.log("[profile] open hook install: " + _cause(e))
        # pre-warm the catalog runtime (zip extract + a huge module import) in the
        # background, so the FIRST catalog / «+» open doesn't freeze weak devices
        # for the 1-2s the import used to take on the UI thread
        try:
            import threading
            t = threading.Timer(6.0, self._prewarm_prod)
            t.daemon = True
            t.start()
        except Exception:
            pass

    def _prewarm_prod(self):
        if getattr(self, "_unloaded", False):
            return
        try:
            self._ensure_prod()
        except Exception:
            pass

    def on_plugin_unload(self):
        self._unloaded = True   # cancel any not-yet-run deferred hook install
        self._upd_stop = True   # stop the background update loop
        try:
            if self._clazz is not None:
                self._clazz.getMethod("shutdown").invoke(None)
        except Exception as e:
            self.log("eblanNFT unload error: " + _cause(e))

    # ---------------- bridge helpers ----------------
    # bridge calls that change the gift list → drop the cached getGiftDisplayJson result
    _GIFT_MUTATORS = frozenset(("updateGift", "removeGift", "removeGifts", "craftGifts", "addGift", "addGifts",
                                "replaceGift", "reloadAll", "importProfile"))

    def _jvoid(self, method, sig=(), args=()):
        """Call a static bridge method. sig items: 'int'|'long'|'str'. Returns the String/primitive result or None."""
        try:
            clazz = self._clazz
            if clazz is None:
                return None
            # getMethod is a reflective scan over the core class on EVERY bridge call —
            # cache the resolved Method per (name, sig); the hot UI paths (settings,
            # gift grid) hit the same few methods repeatedly.
            mcache = getattr(self, "_jm_cache", None)
            if mcache is None:
                mcache = {}
                self._jm_cache = mcache
            m = mcache.get((method, sig))
            if m is None:
                tmap = {"int": _INT_T, "long": _LONG_T, "str": _STR_CLS}
                m = clazz.getMethod(method, *[tmap[t] for t in sig])
                mcache[(method, sig)] = m
            jargs = []
            for t, a in zip(sig, args):
                if t == "int":
                    jargs.append(JInteger(int(a)))
                elif t == "long":
                    jargs.append(JLong(int(a)))
                else:
                    jargs.append("" if a is None else str(a))
            res = m.invoke(None, *jargs)
            if method in self._GIFT_MUTATORS:
                self._gifts_cache = None
                self._upg_match_cache = {}
            return res
        except Exception as e:
            try:
                self.log("eblanNFT bridge " + method + " err: " + _cause(e))
            except Exception:
                pass
            return None

    def _settings(self):
        """Current Java state as a dict (one bridge read)."""
        try:
            raw = self._jvoid("getSettingsJson")
            return json.loads(str(raw)) if raw else {}
        except Exception:
            return {}

    # ---------------- settings menu (1:1 layout, wired to the bridge) ----------------
    def create_settings(self):
        # exteraGram registers the plugin's settings (→ shows the ⚙️ gear in the list) ONLY
        # if create_settings() returns a NON-EMPTY list without throwing (PythonPluginsEngine
        # .loadPluginSettings: null/empty result → no gear). So build defensively + log, and
        # never return empty when the UI classes are available.
        try:
            items = self._build_settings()
            try: self.log("[settings] create_settings -> %d items" % (len(items) if items else 0))
            except Exception: pass
            if items:
                return items
        except Exception as e:
            try: self.log("[settings] create_settings ERROR: " + _cause(e))
            except Exception: pass
        if Text is None:
            return []
        # fallback: a single valid row guarantees the gear appears even if the rich build failed
        try:
            return [Text(text="eblanNFT", subtext="Открыть настройки",
                         icon="msg2_reactions2", on_click=lambda _: self._open_about())]
        except Exception:
            return []

    def _build_settings(self):
        if Text is None:
            return []
        st = self._settings()
        uname = self._uname_status(st)
        num = self._num_status(st)
        return [
            self._menu_header("Коллекция"),
            Text(text="Мои подарки", subtext=self._gifts_subtext(st),
                 icon="msg_emoji_gem", on_click=lambda _: self._open_my_gifts()),
            self._menu_header("Профиль и данные"),
            Text(text="Профиль", subtext=f"Username • {uname}   Number • {num}",
                 icon="msg_edit",
                 create_sub_fragment=self._sub_profile, link_alias="eblannft_profile_subfragment"),
            Text(text="Данные", subtext="Экспорт и импорт .profile",
                 icon="msg_share",
                 create_sub_fragment=self._sub_data, link_alias="eblannft_data_subfragment"),
            self._menu_header("Информация"),
            Text(text="О плагине", subtext="Информация и поддержка",
                 icon="msg2_reactions2",
                 on_click=lambda _: self._open_about()),
        ]

    def _menu_header(self, text):
        try:
            if Header is not None:
                return Header(text=str(text))
        except Exception:
            pass
        return Divider(text=str(text))

    # ---- Профиль ----
    def _sub_profile(self, parent_view=None):
        st = self._settings()
        return [
            self._menu_header("Профиль"),
            Divider(text="Локальные поля профиля и отображение подарков."),
            Text(text="Username", subtext=self._uname_status(st), icon="msg_edit",
                 create_sub_fragment=self._sub_username, link_alias="eblannft_username_subfragment"),
            Text(text="Number", subtext=self._num_status(st), icon="msg_link",
                 create_sub_fragment=self._sub_number, link_alias="eblannft_number_subfragment"),
            Text(text="Рейтинг", subtext=self._rating_label(st), icon="msg_stats_solar",
                 create_sub_fragment=self._sub_rating, link_alias="eblannft_rating_subfragment"),
            Switch(key="eblannft_hide_official_gifts_local", text="Скрыть обычные подарки",
                   subtext="Только локально, в вашем клиенте",
                   default=bool(st.get("hide_official_gifts", False)), icon="msg_delete",
                   on_change=lambda v: self._jvoid("setHideOfficialGifts", ("int",), (1 if v else 0,))),
        ]

    def _sub_username(self, parent_view=None):
        st = self._settings()
        toks = st.get("username_tokens") or []
        items = [
            self._menu_header("Collectible username"),
            Divider(text="Локальный collectible username. Видно только вам."),
            Switch(key="eblannft_username_enabled", text="Показывать",
                   subtext=(self._uname_status(st) if st.get("username_enabled") else "Выключено"),
                   default=bool(st.get("username_enabled", False)), icon="msg_edit",
                   on_change=lambda v: self._set_username(bool(v), toks)),
            Text(text="Добавить", subtext="Новый username без @", icon="msg_edit",
                 on_click=lambda _: self._input("Username (без @)", "", self._add_username)),
            Text(text="Список", subtext=f"{len(toks)} сохранено", icon="msg_emoji_gem",
                 on_click=lambda _: self._toast("Username: " + (", ".join("@" + t for t in toks) or "пусто"))),
        ]
        if toks:
            items.append(Text(text="Очистить всё", subtext="Удалить все username",
                              icon="msg_delete", red=True, on_click=lambda _: self._set_username(False, [])))
        return items

    def _sub_number(self, parent_view=None):
        st = self._settings()
        toks = st.get("number_tokens") or []
        items = [
            self._menu_header("Collectible number"),
            Divider(text="Локальный collectible number. Видно только вам."),
            Switch(key="eblannft_number_enabled", text="Показывать",
                   subtext=(self._num_status(st) if st.get("number_enabled") else "Выключено"),
                   default=bool(st.get("number_enabled", False)), icon="msg_link",
                   on_change=lambda v: self._set_number(bool(v), toks)),
            Text(text="Добавить", subtext="Новый номер в формате +888...", icon="msg_link",
                 on_click=lambda _: self._input("Number (например +888 0413 6929)", "", self._add_number)),
            Text(text="Список", subtext=f"{len(toks)} сохранено", icon="msg_emoji_gem",
                 on_click=lambda _: self._toast("Number: " + (", ".join("+" + t for t in toks) or "пусто"))),
        ]
        if toks:
            items.append(Text(text="Очистить всё", subtext="Удалить все номера",
                              icon="msg_delete", red=True, on_click=lambda _: self._set_number(False, [])))
        return items

    def _sub_rating(self, parent_view=None):
        st = self._settings()
        val = int(st.get("rating_value", 0) or 0)
        lvl = int(st.get("rating_level", 1) or 1)
        goal = int(st.get("rating_next_goal", 0) or 0)
        enabled = bool(st.get("rating_enabled", False))
        return [
            self._menu_header("Рейтинг профиля"),
            Divider(text="Локальный рейтинг профиля. Видно только вам."),
            Switch(key="eblannft_rating_enabled", text="Показывать",
                   subtext=(self._rating_label(st) if enabled and val > 0 else "Выключено"),
                   default=bool(enabled and val > 0), icon="msg_stats_solar",
                   on_change=lambda v: self._set_rating(bool(v), val, lvl, goal)),
            Text(text="Количество очков", subtext=str(val), icon="msg_stats_solar",
                 on_click=lambda _: self._edit_rating_field("value")),
            Text(text="Уровень профиля", subtext=str(lvl), icon="msg_stats_solar",
                 on_click=lambda _: self._edit_rating_field("level")),
            Text(text="Следующая цель", subtext=str(goal), icon="msg_stats_solar",
                 on_click=lambda _: self._edit_rating_field("goal")),
        ]

    # ---- Данные (экспорт/импорт .profile, совместимо с обычным eblanNFT) ----
    _PROFILE_EXT = ".profile"
    _PROFILE_SECTIONS = ("nft_gifts", "nft_usernames", "nft_number", "local_rating")
    _PROFILE_TITLES = {"nft_gifts": "Все NFT подарки", "nft_usernames": "NFT юзернеймы",
                       "nft_number": "NFT номер", "local_rating": "Локальный рейтинг"}
    _PROFILE_SUBS = {"nft_gifts": "Библиотека, активный локальный подарок и wear",
                     "nft_usernames": "Список username, выбранный username и шаблон",
                     "nft_number": "Список номеров, выбранный номер и шаблон",
                     "local_rating": "Очки, уровень и следующая цель"}

    def _sub_data(self, parent_view=None):
        return [
            self._menu_header("Конфигурация"),
            Divider(text="Экспорт/импорт .profile. Совместимо с обычным eblanNFT — файлы в Downloads/eblanNFT."),
            Text(text="Экспорт .profile", subtext="Сохранить и поделиться конфигом",
                 icon="msg_share", on_click=lambda _: self._open_profile_export()),
            Text(text="Импорт .profile", subtext="Загрузить конфиг из Downloads/eblanNFT",
                 icon="msg_download", on_click=lambda _: self._open_profile_import()),
        ]

    def _profile_dir(self):
        """Downloads/eblanNFT (shared with the regular plugin); cache dir fallback."""
        try:
            import os
            Environment = jclass("android.os.Environment")
            downloads = Environment.getExternalStoragePublicDirectory(
                Environment.DIRECTORY_DOWNLOADS).getAbsolutePath()
            target = os.path.join(downloads, "eblanNFT")
            if ensure_dir_exists is not None:
                ensure_dir_exists(target)
            else:
                os.makedirs(target, exist_ok=True)
            return target
        except Exception as e:
            try:
                import os
                target = os.path.join(_resolve_data_dir() or get_plugins_dir(), "profiles")
                os.makedirs(target, exist_ok=True)
                return target
            except Exception:
                self.log("[profile] dir: " + _cause(e))
                return None

    def _sanitize_profile_name(self, raw):
        import re, time as _t
        name = str(raw or "").strip()
        if name.lower().endswith(self._PROFILE_EXT):
            name = name[:-len(self._PROFILE_EXT)]
        name = re.sub(r'[\\/:*?"<>|]+', "_", name)
        name = re.sub(r"\s+", " ", name).strip(" .")
        if not name:
            name = "profile_" + str(int(_t.time()))
        return name[:64]

    # ---- shared section-picker sheet (export + import) ----
    def _profile_section_sheet(self, title, subtitle, action_label, available, on_apply):
        """Multi-toggle sheet to pick which .profile sections to export/import (all ON
        by default), same style as the cache-cleanup sheet. on_apply(selected_keys)."""
        avail = [k for k in available]
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None or BottomSheet is None:
                on_apply(avail); return
            TextCheckCell = jclass("org.telegram.ui.Cells.TextCheckCell")
            sheet = BottomSheet(ctx, False)
            accent = int(self._theme_color("key_featuredStickers_addButton", 0xFF3390EC))

            root = LinearLayout(ctx); root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(18), AndroidUtilities.dp(20), AndroidUtilities.dp(14))
            tv = TextView(ctx); tv.setText(str(title))
            tv.setTextColor(int(self._theme_color("key_dialogTextBlack", 0xFFFFFFFF)))
            try: tv.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            root.addView(tv, LinearLayout.LayoutParams(-1, -2))
            if subtitle:
                sub = TextView(ctx); sub.setText(str(subtitle))
                sub.setTextColor(int(self._theme_color("key_windowBackgroundWhiteGrayText2", 0xFF9AA3AE)))
                sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                lp_s = LinearLayout.LayoutParams(-1, -2); lp_s.topMargin = AndroidUtilities.dp(6)
                root.addView(sub, lp_s)

            selected = {k: True for k in avail}
            cells = LinearLayout(ctx); cells.setOrientation(LinearLayout.VERTICAL)
            lp_c = LinearLayout.LayoutParams(-1, -2); lp_c.topMargin = AndroidUtilities.dp(16)
            for idx, key in enumerate(avail):
                cell = TextCheckCell(ctx, 21, True)
                cell.setTextAndValueAndCheck(self._PROFILE_TITLES.get(key, key),
                                             self._PROFILE_SUBS.get(key, ""), True, True, idx != len(avail) - 1)
                def _t(v, _c=cell, _k=key):
                    nv = not bool(selected.get(_k, False)); selected[_k] = nv
                    try: _c.setChecked(nv)
                    except Exception: pass
                cell.setOnClickListener(self._click(_t))
                cells.addView(cell)
            root.addView(cells, lp_c)

            buttons = LinearLayout(ctx); buttons.setOrientation(LinearLayout.HORIZONTAL)
            lp_b = LinearLayout.LayoutParams(-1, -2); lp_b.topMargin = AndroidUtilities.dp(16)
            cancel = TextView(ctx); cancel.setText("Отмена"); cancel.setGravity(Gravity.CENTER)
            try: cancel.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            cancel.setTextColor(accent)
            cancel.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(14), AndroidUtilities.dp(8), AndroidUtilities.dp(14))
            cancel.setOnClickListener(self._click(lambda v: sheet.dismiss()))
            ok = TextView(ctx); ok.setText(str(action_label)); ok.setGravity(Gravity.CENTER)
            try: ok.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            ok.setTextColor(-1)
            try:
                bg = GradientDrawable(); bg.setCornerRadius(float(AndroidUtilities.dp(12))); bg.setColor(accent); ok.setBackground(self._ripple_bg(bg, accent))
                ok.setElevation(float(AndroidUtilities.dp(2)))
            except Exception: pass
            ok.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(14), AndroidUtilities.dp(8), AndroidUtilities.dp(14))

            def _go(v):
                keys = [k for k in avail if bool(selected.get(k, False))]
                if not keys:
                    self._toast("Выбери хотя бы один пункт"); return
                try: sheet.dismiss()
                except Exception: pass
                on_apply(keys)
            ok.setOnClickListener(self._click(_go))
            buttons.addView(cancel, LinearLayout.LayoutParams(0, -2, 1.0))
            lp_ok = LinearLayout.LayoutParams(0, -2, 1.0); lp_ok.leftMargin = AndroidUtilities.dp(10)
            buttons.addView(ok, lp_ok)
            root.addView(buttons, lp_b)

            sheet.setCustomView(root)
            self._show_sheet_animated(sheet, root)
        except Exception as e:
            self.log("[profile] sheet: " + _cause(e))
            on_apply(avail)

    # ---- export ----
    def _open_profile_export(self):
        # pick sections (toggle sheet) → name → write
        self._profile_section_sheet("Экспорт .profile", "Выбери, что включить в конфиг.",
                                     "Экспортировать", self._PROFILE_SECTIONS, self._export_after_pick)

    def _export_after_pick(self, keys):
        import time as _t
        default = _t.strftime("profile_%Y%m%d_%H%M%S")
        self._input("Имя конфига", default, lambda name: self._do_profile_export(name, keys))

    def _do_profile_export(self, raw_name, keys=None):
        import os, time as _t
        if write_file is None:
            self._toast("file_utils недоступен")
            return
        safe = self._sanitize_profile_name(raw_name)
        try:
            sec_raw = self._jvoid("exportProfile")
            sections = json.loads(str(sec_raw)) if sec_raw else {}
            if not isinstance(sections, dict) or not sections:
                self._toast("нет данных для экспорта")
                return
            if keys:  # keep only the sections the user selected in the toggle sheet
                want = set(str(k) for k in keys)
                sections = {k: v for k, v in sections.items() if k in want}
                if not sections:
                    self._toast("нечего экспортировать")
                    return
            payload = {
                "version": 1,
                "plugin_id": "eblannft",
                "plugin_version": __version__,
                "timestamp": int(_t.time()),
                "profile_name": safe,
                "sections": sections,
            }
            raw_json = json.dumps(payload, indent=2, ensure_ascii=False)
            raw_b64 = base64.b64encode(raw_json.encode("utf-8")).decode("ascii")
            content = ("# eblanNFT profile\n"
                       "# " + _t.strftime("%Y-%m-%d %H:%M:%S") + "\n"
                       "# sections: " + ", ".join(sorted(sections.keys())) + "\n\n"
                       + raw_b64)
            cfg_dir = self._profile_dir()
            if not cfg_dir:
                self._toast("не удалось подготовить папку")
                return
            filename = safe + self._PROFILE_EXT
            filepath = os.path.join(cfg_dir, filename)
            write_file(filepath, content)
            # export = "publish" → push the current state to the VPS now (replaces the
            # old server record), so others immediately see the exported config.
            try:
                self._jvoid("pushSyncNow")
            except Exception:
                pass
            self._show_export_done(filepath, filename)
        except Exception as e:
            self._toast("экспорт: " + repr(e)[:140])
            try: self.log("[profile] export: " + _cause(e))
            except Exception: pass

    def _show_export_done(self, filepath, filename):
        try:
            if AlertDialogBuilder is None or get_last_fragment is None:
                self._toast("Сохранено: " + filename)
                return
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None:
                self._toast("Сохранено: " + filename)
                return
            b = AlertDialogBuilder(ctx)
            b.set_title("Экспорт .profile")
            b.set_message(filename + "\n\n" + str(filepath))
            b.set_positive_button("Поделиться", lambda d, w: self._share_profile_file(filepath, ctx))
            b.set_negative_button("Закрыть", None)
            run_on_ui_thread(b.show)
        except Exception:
            self._toast("Сохранено: " + filename)

    def _share_profile_file(self, filepath, activity):
        try:
            Intent = jclass("android.content.Intent")
            File = jclass("java.io.File")
            FileProvider = jclass("androidx.core.content.FileProvider")
            file_obj = File(filepath)
            uri = FileProvider.getUriForFile(
                activity, ApplicationLoader.getApplicationId() + ".provider", file_obj)
            intent = Intent(Intent.ACTION_SEND)
            intent.setType("application/octet-stream")
            intent.putExtra(Intent.EXTRA_STREAM, uri)
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            activity.startActivity(Intent.createChooser(intent, "Share .profile"))
        except Exception as e:
            self._toast("Поделиться не вышло: " + repr(e)[:120])
            try: self.log("[profile] share: " + _cause(e))
            except Exception: pass

    # ---- import ----
    def _open_profile_import(self):
        import os
        cfg_dir = self._profile_dir()
        if not cfg_dir or not os.path.exists(cfg_dir):
            self._toast("Папка с профилями не найдена")
            return
        try:
            files = [n for n in os.listdir(cfg_dir) if str(n).lower().endswith(self._PROFILE_EXT)]
        except Exception:
            files = []
        files.sort(reverse=True)
        if not files:
            self._toast("Нет сохранённых .profile в Downloads/eblanNFT")
            return
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None or AlertDialogBuilder is None:
                self._toast("нет контекста")
                return

            def _pick(dlg, idx):
                try: dlg.dismiss()
                except Exception: pass
                if idx < 0 or idx >= len(files):
                    return
                self._do_profile_import(os.path.join(cfg_dir, files[idx]), files[idx])
            b = AlertDialogBuilder(ctx)
            b.set_title("Выберите .profile")
            b.set_items(files, _pick)
            b.set_negative_button("Отмена", None)
            run_on_ui_thread(b.show)
        except Exception as e:
            self._toast("импорт: " + repr(e)[:120])

    def _load_profile_file(self, filepath):
        try:
            raw = read_file(filepath) if read_file is not None else None
            if not raw:
                return None
            lines = [ln for ln in str(raw).split("\n") if ln.strip() and not ln.startswith("#")]
            if not lines:
                return None
            decoded = base64.b64decode("".join(lines)).decode("utf-8")
            data = json.loads(decoded)
            if not isinstance(data, dict) or not isinstance(data.get("sections"), dict):
                return None
            return data
        except Exception as e:
            try: self.log("[profile] load: " + _cause(e))
            except Exception: pass
            return None

    def _do_profile_import(self, filepath, filename):
        data = self._load_profile_file(filepath)
        if not data:
            self._toast("Не удалось прочитать .profile")
            return
        sections = data.get("sections", {})
        present = [k for k in self._PROFILE_SECTIONS if k in sections]
        if not present:
            self._toast("В профиле нет поддерживаемых данных")
            return
        # same toggle sheet as export — pick which sections to apply (all ON by default)
        self._profile_section_sheet("Импорт " + str(filename), "Выбери, что применить.",
                                    "Импортировать", present,
                                    lambda keys: self._apply_profile_import(sections, keys))

    def _apply_profile_import(self, sections, keys):
        try:
            res = self._jvoid("importProfile", ("str", "str"),
                              (json.dumps(sections), ",".join(keys)))
            self.log("[profile] import -> " + str(res))
            labels = ", ".join(self._PROFILE_TITLES.get(k, k) for k in keys)
            self._toast("Импортировано: " + labels)
        except Exception as e:
            self._toast("импорт: " + repr(e)[:140])
            try: self.log("[profile] apply: " + _cause(e))
            except Exception: pass

    # ---- tap a .profile file in a chat → open our import sheet ----
    def _install_profile_open_hook(self):
        if getattr(self, "_profile_open_hooked", False):
            return
        if MethodHook is None or _ProfileOpenHook is None or getattr(self, "hook_method", None) is None:
            return
        try:
            AU = JavaClass.forName("org.telegram.messenger.AndroidUtilities")
        except Exception as e:
            self.log("[profile] open hook: no AU " + _cause(e)); return
        refs = []
        try:
            for m in AU.getDeclaredMethods():
                try:
                    nm = str(m.getName() or "")
                    ps = list(m.getParameterTypes() or [])
                except Exception:
                    continue
                if not ps or "MessageObject" not in str(ps[0].getName() or ""):
                    continue
                if (nm == "openDocument" and len(ps) == 3) or (nm == "openForView" and len(ps) == 4):
                    try: m.setAccessible(True)
                    except Exception: pass
                    try: refs.append(self.hook_method(m, _ProfileOpenHook(self)))
                    except Exception as e: self.log("[profile] open hook " + nm + ": " + _cause(e))
        except Exception as e:
            self.log("[profile] open hook scan: " + _cause(e)); return
        self._profile_open_refs = refs
        self._profile_open_hooked = True
        self.log("[profile] open hooks installed: " + str(len(refs)))

    def _handle_profile_file_open(self, msg):
        import os
        path = ""
        try: path = str(msg.messageOwner.attachPath or "")
        except Exception: path = ""
        if not path or not os.path.exists(path):
            try:
                FileLoader = jclass("org.telegram.messenger.FileLoader")
                loader = FileLoader.getInstance(msg.currentAccount)
                resolved = loader.getPathToMessage(msg.messageOwner)
                path = resolved.getAbsolutePath() if resolved is not None else ""
            except Exception as e:
                self.log("[profile] resolve path: " + _cause(e)); path = ""
        if path and os.path.exists(path):
            fn = os.path.basename(path)
            run_on_ui_thread(lambda: self._do_profile_import(path, fn))
        else:
            self._toast("Файл ещё не загружен — открой его в чате и повтори")

    # ---- lazy production runtime, ONLY for the catalog / gift-constructor UI ----
    def _ensure_prod(self):
        """Thread-safe + double-checked: the background pre-warm builds the prod runtime
        while a user tap may race it from the UI thread — only one build ever runs."""
        prod = getattr(self, "_prod", None)
        if prod is not None:
            return prod
        lk = getattr(self, "_prod_lock", None)
        if lk is None:
            import threading
            lk = self._prod_lock = threading.Lock()
        with lk:
            return self._ensure_prod_inner()

    def _ensure_prod_inner(self):
        prod = getattr(self, "_prod", None)
        if prod is not None:
            return prod
        try:
            root = os.path.join(get_plugins_dir(), "eblannft")
            os.makedirs(root, exist_ok=True)
            _extract_runtime(root)
            cls, mod = _import_runtime(root)
            self._prod_mod = mod
            # the header/cards/about reuse prod builders, which read the prod module's
            # __version__ — surface OUR version instead (cosmetic, prod runtime here is
            # used for UI only, never for sync/update where its version matters).
            try:
                mod.__version__ = __version__
            except Exception:
                pass
            prod = cls()
            # bind the framework methods from THIS (framework-loaded) plugin so the
            # production instance can log / hook / read settings.
            for nm in ("log", "hook_method", "unhook_method", "add_menu_item",
                       "remove_menu_item", "get_setting", "set_setting"):
                fn = getattr(self, nm, None)
                if fn is not None:
                    try:
                        setattr(prod, nm, fn)
                    except Exception:
                        pass
            try:
                prod._EBLANNFT_SINGLE_FILE_BUILD = True
            except Exception:
                pass
            # load state from cache — NO on_plugin_load, so NO hot-path hooks
            try:
                prod._load_cache()
            except Exception as e:
                self.log("[cat] _load_cache: " + repr(e))
            # install ONLY the cold catalog UI hooks (fire only when catalog open)
            try:
                prod._hook_native_catalog_ui()
            except Exception as e:
                self.log("[cat] catalog hook: " + repr(e))
            # every production cache save → tell Java to re-read (gift added/edited)
            try:
                _orig = prod._save_cache

                def _save_reload(*a, **k):
                    r = _orig(*a, **k)
                    try:
                        run_on_ui_thread(lambda: self._jvoid("reloadAll"), 500)
                    except Exception:
                        self._jvoid("reloadAll")
                    return r
                prod._save_cache = _save_reload
            except Exception:
                pass
            self._prod = prod
            self.log("[cat] production runtime ready (catalog UI only)")
            return prod
        except Exception as e:
            self.log("[cat] ensure_prod: " + _cause(e))
            return None

    # ---- settings header (frog card + Обновления/Кэш cards) — production look ----
    # All views are built natively in the bootstrap (NO production runtime dependency).
    def _theme_color(self, attr_name, fallback=0xFF222222):
        try:
            key = getattr(Theme, attr_name, None)
            if key is not None:
                return int(Theme.getColor(key))
        except Exception:
            pass
        return self._col(fallback)

    def _create_round_rect(self, color, radius_dp=18, stroke_color=0, stroke_dp=0):
        bg = GradientDrawable()
        try: bg.setCornerRadius(float(AndroidUtilities.dp(radius_dp)))
        except Exception: pass
        try: bg.setColor(int(color))
        except Exception: pass
        try:
            if int(stroke_dp or 0) > 0:
                bg.setStroke(AndroidUtilities.dp(int(stroke_dp)), int(stroke_color or 0))
        except Exception: pass
        return bg

    def _load_welcome_sticker(self, imageView, size="108_108", idx=31):
        """Load the frog welcome sticker (HappyHappyPepe idx 31) into a BackupImageView."""
        if MediaDataController is None or ImageLocation is None or imageView is None:
            return False
        try:
            mc = MediaDataController.getInstance(_selected_account())
        except Exception:
            mc = None
        if mc is None:
            return False
        ss = None
        try:
            ss = mc.getStickerSetByName(EBLANNFT_WELCOME_STICKER_SET)
        except Exception:
            ss = None
        if ss is None:
            try: ss = mc.getStickerSetByEmojiOrName(EBLANNFT_WELCOME_STICKER_SET)
            except Exception: ss = None
        try:
            docs = getattr(ss, "documents", None) if ss is not None else None
            if docs is not None and docs.size() > 0:
                doc = docs.get(min(idx, docs.size() - 1))
                loc = ImageLocation.getForDocument(doc)
                if loc is not None:
                    imageView.setImage(loc, size, None, None, 0, 1)
                    try:
                        rc = imageView.getImageReceiver()
                        if rc is not None:
                            rc.setAllowStartAnimation(True)
                            rc.startAnimation()
                    except Exception:
                        pass
                    return True
        except Exception:
            pass
        try:
            mc.loadStickersByEmojiOrName(EBLANNFT_WELCOME_STICKER_SET, False, False)
        except Exception:
            pass
        return False

    def _frame(self, view, w, h, gravity, l, t, r, b):
        if LayoutHelper is not None:
            try:
                return LayoutHelper.createFrame(w, h, gravity, l, t, r, b)
            except Exception:
                pass
        lp = FrameLayout.LayoutParams(
            AndroidUtilities.dp(w) if w > 0 else w,
            AndroidUtilities.dp(h) if h > 0 else h, gravity)
        lp.leftMargin = AndroidUtilities.dp(l); lp.topMargin = AndroidUtilities.dp(t)
        lp.rightMargin = AndroidUtilities.dp(r); lp.bottomMargin = AndroidUtilities.dp(b)
        return lp

    def _build_header_view(self, ctx):
        try:
            container = FrameLayout(ctx)
            try:
                container.setLayoutParams(LinearLayout.LayoutParams(-1, AndroidUtilities.dp(216)))
            except Exception:
                pass
            try:
                container.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
            except Exception:
                pass
            iv = BackupImageView(ctx)
            try: iv.setRoundRadius(AndroidUtilities.dp(60))
            except Exception: pass
            if not self._load_welcome_sticker(iv):
                try: run_on_ui_thread(lambda: self._load_welcome_sticker(iv), 1500)
                except Exception: pass
            container.addView(iv, self._frame(iv, 112, 112, Gravity.CENTER | Gravity.TOP, 0, 14, 0, 0))

            title = TextView(ctx)
            try: title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            except Exception: pass
            try: title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            except Exception: pass
            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22)
            title.setText("eblanNFT " + __version__)
            title.setSingleLine(True)
            title.setGravity(Gravity.CENTER)
            container.addView(title, self._frame(title, -2, -2, Gravity.CENTER | Gravity.TOP, 24, 136, 24, 0))

            subtitle = TextView(ctx)
            try: subtitle.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            except Exception: pass
            subtitle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            subtitle.setText("Основной канал eblanNFT — NFT подарки, юзернеймы и номера.")
            subtitle.setGravity(Gravity.CENTER)
            container.addView(subtitle, self._frame(subtitle, -2, -2, Gravity.CENTER | Gravity.TOP, 24, 172, 24, 16))
            try:
                iv.setOnClickListener(self._click(lambda v: self._load_welcome_sticker(iv)))
            except Exception:
                pass
            # Staggered hero entrance once UniversalRecyclerView attaches this
            # custom item.  Delayed start avoids animating while still detached.
            try:
                run_on_ui_thread(lambda: self._animate_in(iv, 0, 14, 320, 0.82), 70)
                run_on_ui_thread(lambda: self._animate_in(title, 0, 10, 280, 0.96), 125)
                run_on_ui_thread(lambda: self._animate_in(subtitle, 0, 8, 260, 0.98), 175)
            except Exception:
                pass
            return container
        except Exception as e:
            self.log("[hdr] build header: " + _cause(e))
            return None

    def _build_cards_view(self, ctx):
        try:
            outer = LinearLayout(ctx)
            outer.setOrientation(LinearLayout.HORIZONTAL)
            try: outer.setPadding(AndroidUtilities.dp(24), 0, AndroidUtilities.dp(24), AndroidUtilities.dp(10))
            except Exception: pass
            bg = self._theme_color("key_dialogBackground", 0xFF1A1A1A)
            text = self._theme_color("key_windowBackgroundWhiteBlackText", 0xFFFFFFFF)
            muted = self._theme_color("key_windowBackgroundWhiteGrayText", 0xFF9A9A9A)
            accent = self._theme_color("key_featuredStickers_addButton", 0xFF4E62FF)
            danger = self._theme_color("key_text_RedBold", 0xFFE57373)

            def _card(t, sub, tint, cb):
                card = LinearLayout(ctx)
                card.setOrientation(LinearLayout.VERTICAL)
                try:
                    card.setClickable(True); card.setFocusable(True)
                    card.setPadding(AndroidUtilities.dp(14), AndroidUtilities.dp(9), AndroidUtilities.dp(14), AndroidUtilities.dp(8))
                    card.setBackground(self._ripple_bg(self._create_round_rect(bg, radius_dp=16), accent))
                    card.setElevation(float(AndroidUtilities.dp(1)))
                except Exception: pass
                tv = TextView(ctx)
                tv.setText(t); tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15.0); tv.setTextColor(int(text))
                try: tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                except Exception: pass
                card.addView(tv, LinearLayout.LayoutParams(-1, -2))
                sv = TextView(ctx)
                sv.setText(sub); sv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12.0); sv.setTextColor(int(muted))
                sv.setMaxLines(2)
                lps = LinearLayout.LayoutParams(-1, -2); lps.topMargin = AndroidUtilities.dp(2)
                card.addView(sv, lps)
                line = View(ctx)
                try: line.setBackgroundColor(int(tint))
                except Exception: pass
                lpl = LinearLayout.LayoutParams(AndroidUtilities.dp(30), AndroidUtilities.dp(3)); lpl.topMargin = AndroidUtilities.dp(8)
                card.addView(line, lpl)
                try: card.setOnClickListener(self._click(lambda v: cb()))
                except Exception: pass
                return card

            uc = _card("Обновления", "v" + __version__ + " · Telegram channel", accent, self._open_update_check)
            cc = _card("Кэш", "Выбрать, что очистить", danger, self._open_cache_cleanup)
            lp1 = LinearLayout.LayoutParams(0, AndroidUtilities.dp(72), 1.0)
            lp2 = LinearLayout.LayoutParams(0, AndroidUtilities.dp(72), 1.0); lp2.leftMargin = AndroidUtilities.dp(10)
            outer.addView(uc, lp1); outer.addView(cc, lp2)
            try:
                run_on_ui_thread(lambda: self._animate_in(uc, 0, 12, 260, 0.94), 110)
                run_on_ui_thread(lambda: self._animate_in(cc, 0, 12, 260, 0.94), 165)
            except Exception:
                pass
            return outer
        except Exception as e:
            self.log("[hdr] build cards: " + _cause(e))
            return None

    def _open_update_check(self):
        """«Обновления» card → check now and self-update. Resets the popup/install
        latches so it ALWAYS works even after the auto-popup was dismissed/minimized:
        - _upd_popup_active / _upd_dismissed_until: cleared so the forced sheet shows;
        - _plug_installed: cleared so «Обновить» can re-trigger the install (the guard
          otherwise no-ops a second attempt → «не отдаёт нормально»)."""
        self._toast("Проверяю обновления…")
        self._upd_popup_active = False
        self._upd_dismissed_until = 0
        self._plug_installed = False
        try:
            self._check_for_update(True)
        except Exception as e:
            self.log("[upd] manual: " + _cause(e))
            self._toast("Ошибка проверки обновлений")

    def _open_cache_cleanup(self):
        """Multi-toggle cache-cleanup sheet (ported from the regular eblanNFT plugin):
        Каталог/Временные/Ассеты ON by default; Экспорты/Локальный профиль/Удалить-всё OFF.
        «Удалить плагин и все файлы» auto-enables every other toggle."""
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None or BottomSheet is None:
                self._clear_plugin_cache(); return
            TextCheckCell = jclass("org.telegram.ui.Cells.TextCheckCell")
            sheet = BottomSheet(ctx, False)
            accent = int(self._theme_color("key_featuredStickers_addButton", 0xFF3390EC))

            root = LinearLayout(ctx); root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(18), AndroidUtilities.dp(20), AndroidUtilities.dp(14))

            title = TextView(ctx); title.setText("Очистка кэша")
            title.setTextColor(int(self._theme_color("key_dialogTextBlack", 0xFFFFFFFF)))
            try: title.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            root.addView(title, LinearLayout.LayoutParams(-1, -2))

            subtitle = TextView(ctx)
            subtitle.setText("Выбери, что удалить. Опасные данные профиля по умолчанию выключены.")
            subtitle.setTextColor(int(self._theme_color("key_windowBackgroundWhiteGrayText2", 0xFF9AA3AE)))
            subtitle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            lp_sub = LinearLayout.LayoutParams(-1, -2); lp_sub.topMargin = AndroidUtilities.dp(6)
            root.addView(subtitle, lp_sub)

            selected = {"catalog": True, "temp": True, "assets": True,
                        "profiles": False, "local_profile": False, "purge_plugin": False}
            defs = list(self._cache_cleanup_option_defs()) + [
                ("purge_plugin", "Удалить плагин и все файлы",
                 "Рантайм, кэш, .profile, настройки и локальные данные")]
            cells = LinearLayout(ctx); cells.setOrientation(LinearLayout.VERTICAL)
            lp_cells = LinearLayout.LayoutParams(-1, -2); lp_cells.topMargin = AndroidUtilities.dp(16)
            cells_by_key = {}

            for idx, (key, title_text, desc_text) in enumerate(defs):
                cell = TextCheckCell(ctx, 21, True)
                cell.setTextAndValueAndCheck(str(title_text), str(desc_text), bool(selected.get(key, False)), True, idx != len(defs) - 1)
                cells_by_key[key] = cell

                def _toggle(v, _cell=cell, _key=key):
                    nv = not bool(selected.get(_key, False))
                    selected[_key] = nv
                    try: _cell.setChecked(nv)
                    except Exception: pass
                    if _key == "purge_plugin" and nv:
                        for k2, c2 in list(cells_by_key.items()):
                            selected[k2] = True
                            try: c2.setChecked(True)
                            except Exception: pass

                cell.setOnClickListener(self._click(_toggle))
                if key == "purge_plugin":
                    lpc = LinearLayout.LayoutParams(-1, -2); lpc.topMargin = AndroidUtilities.dp(10)
                    cells.addView(cell, lpc)
                else:
                    cells.addView(cell)
            root.addView(cells, lp_cells)

            buttons = LinearLayout(ctx); buttons.setOrientation(LinearLayout.HORIZONTAL)
            lp_buttons = LinearLayout.LayoutParams(-1, -2); lp_buttons.topMargin = AndroidUtilities.dp(16)

            cancel = TextView(ctx); cancel.setText("Отмена"); cancel.setGravity(Gravity.CENTER)
            try: cancel.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            cancel.setTextColor(accent)
            cancel.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(14), AndroidUtilities.dp(8), AndroidUtilities.dp(14))
            cancel.setOnClickListener(self._click(lambda v: sheet.dismiss()))

            apply = TextView(ctx); apply.setText("Очистить"); apply.setGravity(Gravity.CENTER)
            try: apply.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            apply.setTextColor(-1)
            try:
                bg = GradientDrawable(); bg.setCornerRadius(float(AndroidUtilities.dp(12))); bg.setColor(accent); apply.setBackground(self._ripple_bg(bg, accent))
                apply.setElevation(float(AndroidUtilities.dp(2)))
            except Exception: pass
            apply.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(14), AndroidUtilities.dp(8), AndroidUtilities.dp(14))

            def _apply(v):
                keys = [k for k, _t, _d in defs if bool(selected.get(k, False))]
                if not keys:
                    self._toast("Выбери хотя бы один пункт"); return
                try: sheet.dismiss()
                except Exception: pass
                if "purge_plugin" in keys:
                    self._confirm_purge_plugin(ctx)
                else:
                    self._clear_selected_cache(keys)
            apply.setOnClickListener(self._click(_apply))

            buttons.addView(cancel, LinearLayout.LayoutParams(0, -2, 1.0))
            lp_apply = LinearLayout.LayoutParams(0, -2, 1.0); lp_apply.leftMargin = AndroidUtilities.dp(10)
            buttons.addView(apply, lp_apply)
            root.addView(buttons, lp_buttons)

            sheet.setCustomView(root)
            self._show_sheet_animated(sheet, root)
        except Exception as e:
            self.log("[cache] " + _cause(e))
            self._clear_plugin_cache()

    def _cache_cleanup_option_defs(self):
        return [
            ("catalog", "Каталог и цены", "Списки подарков, фильтры, floor-цены"),
            ("temp", "Временные файлы", ".tmp, .bak, .recover и служебные sidecar-файлы"),
            ("assets", "Ассеты и аватары", "Кэш картинок и about/support ассетов"),
            ("profiles", "Экспорты .profile", "Сохранённые конфиги из Downloads/eblanNFT"),
            ("local_profile", "Локальный профиль", "Подарки, username, number, rating и настройки профиля"),
        ]

    def _remove_path_quiet(self, path):
        import os, shutil
        try:
            if not path or not os.path.exists(path):
                return 0
            if os.path.isdir(path):
                shutil.rmtree(path, ignore_errors=True)
            else:
                os.remove(path)
            return 1
        except Exception:
            return 0

    def _clear_selected_cache(self, keys):
        import os
        keys = set(str(k) for k in (keys or []))
        ddir = _resolve_data_dir() or ""
        removed = 0
        if "catalog" in keys:
            try: self._cat_ctrl = None
            except Exception: pass
            for attr in ("_market_floor_cache", "_catalog_items_cache", "_catalog_base_list", "_catalog_load_requested"):
                try: setattr(self, attr, None)
                except Exception: pass
        if "temp" in keys and ddir and os.path.isdir(ddir):
            try:
                for n in os.listdir(ddir):
                    if n.endswith((".tmp", ".bak", ".recover")):
                        removed += self._remove_path_quiet(os.path.join(ddir, n))
            except Exception: pass
        if "assets" in keys and ddir and os.path.isdir(ddir):
            try:
                for n in os.listdir(ddir):
                    low = n.lower()
                    if low.endswith((".svg", ".png", ".webp", ".jpg")) or "asset" in low or "avatar" in low:
                        removed += self._remove_path_quiet(os.path.join(ddir, n))
            except Exception: pass
        if "profiles" in keys:
            try:
                pdir = self._profile_dir()
                if pdir and os.path.isdir(pdir):
                    for n in os.listdir(pdir):
                        if n.lower().endswith(".profile"):
                            removed += self._remove_path_quiet(os.path.join(pdir, n))
            except Exception: pass
        if "local_profile" in keys and ddir and os.path.isdir(ddir):
            # DANGER: wipes gifts/username/number/rating/settings (the Java cache file(s)).
            try:
                for n in os.listdir(ddir):
                    low = n.lower()
                    if low.startswith("stolen_cache") or low.endswith(".json"):
                        removed += self._remove_path_quiet(os.path.join(ddir, n))
            except Exception: pass
            self._toast("Локальный профиль очищен — перезапусти Telegram")
            return
        self._toast("Кэш очищен ✓" if removed else "Кэш уже пуст")

    def _confirm_purge_plugin(self, ctx):
        try:
            if AlertDialogBuilder is None:
                self._purge_all_plugin_files(); return
            b = AlertDialogBuilder(ctx)
            b.set_title("Удалить плагин и все файлы?")
            b.set_message("Будут удалены рантайм, кэш, .profile, настройки и локальные данные, а также сам плагин. Действие необратимо.")
            b.set_positive_button("Удалить", lambda d, w: self._purge_all_plugin_files())
            b.set_negative_button("Отмена", None)
            run_on_ui_thread(b.show)
        except Exception as e:
            self.log("[cache] purge confirm: " + _cause(e))

    def _purge_all_plugin_files(self):
        import os
        removed = 0
        for p in (_resolve_data_dir(), os.path.join(get_plugins_dir(), "eblannft")):
            removed += self._remove_path_quiet(p)
        try:
            pdir = self._profile_dir()
            if pdir and os.path.isdir(pdir):
                for n in os.listdir(pdir):
                    if n.lower().endswith(".profile"):
                        removed += self._remove_path_quiet(os.path.join(pdir, n))
        except Exception: pass
        # the installed .plugin file itself (authoritative path from PluginsController)
        try:
            PC = jclass("com.exteragram.messenger.plugins.PluginsController")
            pp = PC.getInstance().getPluginPath(__id__)
            if pp: removed += self._remove_path_quiet(str(pp))
        except Exception as e:
            self.log("[cache] purge path: " + _cause(e))
        self._toast("Плагин и все файлы удалены — перезапусти Telegram")

    def _clear_plugin_cache(self):
        import os, shutil
        removed = 0
        try:
            root = os.path.join(get_plugins_dir(), "eblannft")
            if os.path.isdir(root):
                shutil.rmtree(root, ignore_errors=True); removed += 1
        except Exception:
            pass
        self._prod = None
        self._toast("Кэш очищен ✓" if removed else "Кэш уже пуст")

    def _about_avatar_drawable(self, user):
        if AvatarDrawable is None:
            return None
        try:
            if user is not None:
                return AvatarDrawable(user)
        except Exception:
            pass
        try:
            d = AvatarDrawable()
            try: d.setInfo(0, EBLANNFT_ABOUT_USERNAME, "")
            except Exception: pass
            return d
        except Exception:
            return None

    def _bind_about_avatar(self, av, user):
        """Show the support user's profile photo (placeholder initials until loaded)."""
        if av is None:
            return
        drawable = self._about_avatar_drawable(user)
        try:
            if drawable is not None:
                av.setImageDrawable(drawable)
        except Exception:
            pass
        if user is not None:
            try:
                av.setForUserOrChat(user, drawable)
            except Exception:
                try: av.setForUserOrChat(user)
                except Exception: pass

    def _current_user(self):
        """The logged-in account's User object (its avatar is cached locally → loads instantly)."""
        acc = _selected_account()
        try:
            mc = jclass("org.telegram.messenger.MessagesController").getInstance(acc)
            uc = UserConfig.getInstance(acc)
            u = None
            try: u = mc.getUser(uc.getClientUserId())
            except Exception: u = None
            if u is None:
                try: u = uc.getCurrentUser()
                except Exception: u = None
            return u
        except Exception:
            return None

    def _show_about_sheet(self, ctx=None):
        try:
            if ctx is None:
                frag = get_last_fragment()
                ctx = frag.getParentActivity() if frag else None
            if ctx is None:
                try: ctx = ApplicationLoader.applicationContext
                except Exception: ctx = None
            if ctx is None or BottomSheet is None:
                self._toast("eblanNFT " + __version__)
                return
            sheet = BottomSheet(ctx, True)
            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(16), AndroidUtilities.dp(16), AndroidUtilities.dp(16))

            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            av = BackupImageView(ctx)
            try: av.setRoundRadius(AndroidUtilities.dp(14))
            except Exception: pass
            # the user's OWN profile photo (cached locally → loads immediately)
            self._bind_about_avatar(av, self._current_user())
            row.addView(av, LinearLayout.LayoutParams(AndroidUtilities.dp(64), AndroidUtilities.dp(64)))
            desc = TextView(ctx)
            desc.setText("eblanNFT " + __version__ + "\nЛокальный плагин для NFT-подарков,\nпрофиля и визуальных настроек.")
            desc.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            try: desc.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            except Exception: pass
            lpd = LinearLayout.LayoutParams(0, -2, 1.0); lpd.leftMargin = AndroidUtilities.dp(12)
            row.addView(desc, lpd)
            root.addView(row, LinearLayout.LayoutParams(-1, -2))

            btn = TextView(ctx)
            btn.setText("Поддержка")
            btn.setGravity(Gravity.CENTER)
            btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
            try:
                btn.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
                bbg = GradientDrawable(); bbg.setCornerRadius(float(AndroidUtilities.dp(12)))
                bbg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                btn.setBackground(self._ripple_bg(bbg, Theme.getColor(Theme.key_featuredStickers_addButton)))
                btn.setElevation(float(AndroidUtilities.dp(2)))
            except Exception:
                pass
            btn.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(12), AndroidUtilities.dp(12), AndroidUtilities.dp(12))

            def _support(v):
                try:
                    if Browser is not None:
                        Browser.openUrl(v.getContext(), EBLANNFT_SUPPORT_URL)
                except Exception:
                    pass
                try: sheet.dismiss()
                except Exception: pass
            btn.setOnClickListener(self._click(_support))
            lpb = LinearLayout.LayoutParams(-1, -2); lpb.topMargin = AndroidUtilities.dp(14)
            root.addView(btn, lpb)

            sheet.setCustomView(root)
            self._show_sheet_animated(sheet, root)
        except Exception as e:
            self.log("[about] sheet: " + _cause(e))
            self._toast("eblanNFT " + __version__)

    def _install_settings_header_hook(self):
        if getattr(self, "_hdr_hook_done", False):
            return
        if MethodHook is None or _SettingsHeaderHook is None or getattr(self, "hook_method", None) is None:
            self.log("[hdr] hook unavailable (MethodHook/hook_method missing)")
            return
        PSA = None
        for cn in ("com.exteragram.messenger.plugins.ui.PluginSettingsActivity",
                   "com.exteragram.messenger.plugins.PluginSettingsActivity"):
            try:
                PSA = JavaClass.forName(cn)
                if PSA is not None:
                    break
            except Exception:
                PSA = None
        if PSA is None:
            self.log("[hdr] PluginSettingsActivity not found")
            return
        # resolve fillItems by NAME (param signature drifts between builds)
        target = None
        try:
            cands = list(PSA.getDeclaredMethods())
            for m in cands:
                if m.getName() == "fillItems":
                    target = m
                    break
            if target is None:
                for m in PSA.getMethods():
                    if m.getName() == "fillItems":
                        target = m
                        break
        except Exception as e:
            self.log("[hdr] method scan: " + _cause(e))
        if target is None:
            self.log("[hdr] fillItems not found on " + str(PSA.getName()))
            return
        try:
            target.setAccessible(True)
            self._hdr_hook_ref = self.hook_method(target, _SettingsHeaderHook(self))
            self._hdr_hook_done = True
            self.log("[hdr] hook installed: fillItems params=%d on %s"
                     % (target.getParameterCount(), str(PSA.getSimpleName())))
        except Exception as e:
            self.log("[hdr] hook install: " + _cause(e))

    def _hdr_log_once(self, msg):
        seen = getattr(self, "_hdr_seen", None)
        if seen is None:
            seen = set()
            self._hdr_seen = seen
        if msg in seen or len(seen) > 24:
            return
        seen.add(msg)
        try:
            self.log("[hdr] " + msg)
        except Exception:
            pass

    def _is_our_settings(self, activity):
        try:
            plugin_obj = _gv(activity, "plugin")
            if plugin_obj is None:
                plugin_obj = _gv(activity, "currentPlugin") or _gv(activity, "pluginObject")
            if plugin_obj is None:
                return False
            pid = nm = ""
            try: pid = str(plugin_obj.getId() or "").strip().lower()
            except Exception: pid = ""
            try: nm = str(plugin_obj.getName() or "").strip().lower()
            except Exception: nm = ""
            return ("eblan" in pid) or ("eblan" in nm)
        except Exception:
            return False

    def _item_probe(self, it):
        probes = [str(getattr(it, "text", "") or ""),
                  str(getattr(it, "link_alias", "") or "")]
        si = getattr(it, "settingItem", None)
        if si is not None:
            probes.append(str(getattr(si, "text", "") or ""))
            probes.append(str(getattr(si, "title", "") or ""))
            probes.append(str(getattr(si, "link_alias", "") or ""))
        return " | ".join(p for p in probes if p).lower()

    def _is_home_items(self, items):
        """True only for the top-level menu (Мои подарки/Профиль/Данные) — NOT a
        sub-fragment — so the header isn't injected into Профиль/Рейтинг/etc."""
        try:
            found = set()
            for i in range(items.size()):
                try:
                    it = items.get(i)
                except Exception:
                    continue
                joined = self._item_probe(it)
                if "подарки" in joined: found.add("gifts")
                if "профиль" in joined or "profile" in joined: found.add("profile")
                if "данные" in joined or "_data_" in joined: found.add("data")
            return {"gifts", "profile", "data"}.issubset(found)
        except Exception:
            return False

    def _inject_settings_header(self, activity, items):
        try:
            ours = self._is_our_settings(activity)
            try:
                sz = items.size()
            except Exception:
                sz = -1
            home = self._is_home_items(items) if ours else False
            self._hdr_log_once("fire ours=%s home=%s size=%s UItem=%s"
                               % (ours, home, sz, UItem is not None))
            if UItem is None or not ours or not home:
                return
            # auto-find: re-check the channel for updates whenever the plugin opens (throttled)
            try: self._check_for_update(False)
            except Exception: pass
            # de-dup: drop any previously injected custom items (fillItems re-fires)
            markers = ("__eblannft_dex_header__", "__eblannft_dex_cards__")
            for i in range(items.size() - 1, -1, -1):
                try:
                    it = items.get(i)
                    if str(getattr(it, "object2", "") or "") in markers:
                        items.remove(i)
                except Exception:
                    pass
            ctx = activity.getContext() if hasattr(activity, "getContext") else None
            if ctx is None:
                return
            done = []
            # frog header card (built natively in the bootstrap).
            # NOTE: views are built FRESH on every fillItems — do NOT cache/reuse them.
            # UniversalAdapter diffs items by equals; a reused view makes the new UItem
            # «equal» to the old one, the cell is never re-bound, and the detached view
            # simply vanishes (that was the «нет header и карточек» regression).
            try:
                hv = self._build_header_view(ctx)
                if hv is not None:
                    hi = UItem.asCustom(hv)
                    try: hi.object2 = markers[0]
                    except Exception: pass
                    try: hi.setTransparent(True)
                    except Exception: pass
                    items.add(0, hi)
                    done.append("header")
                else:
                    self._hdr_log_once("header view None")
            except Exception as e:
                self.log("[hdr] header: " + _cause(e))
            # Обновления / Кэш MD3 cards
            try:
                cv = self._build_cards_view(ctx)
                if cv is not None:
                    ci = UItem.asCustom(cv)
                    try: ci.object2 = markers[1]
                    except Exception: pass
                    try: ci.setTransparent(True)
                    except Exception: pass
                    items.add(1 if items.size() > 0 else 0, ci)
                    done.append("cards")
                else:
                    self._hdr_log_once("cards view None")
            except Exception as e:
                self.log("[hdr] cards: " + _cause(e))
            if done:
                self._hdr_log_once("injected " + "+".join(done))
        except Exception as e:
            try: self.log("[hdr] inject: " + _cause(e))
            except Exception: pass

    def _open_about(self):
        """«О плагине» → the about bottom sheet (frog avatar + description + Поддержка)."""
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            self._show_about_sheet(ctx)
        except Exception as e:
            self.log("[about] " + _cause(e))
            self._toast("eblanNFT " + __version__)

    # ---- channel-delivered DEX self-update (the bootstrap is a thin loader) ----
    def _toast_ui(self, msg):
        try:
            run_on_ui_thread(lambda: self._toast(str(msg)))
        except Exception:
            self.log("eblanNFT: " + str(msg))

    def _installed_version(self):
        # updates are full-.plugin (dex embedded) → installed version = the loader's
        return _LOADER_VERSION

    def _load_core_dex(self):
        """Updates ship as a full .plugin (dex embedded), so just load the embedded dex.
        b64decode discards whitespace itself (validate=False) — no split/join copies of
        the ~750 KB blob on the cold-start path."""
        return base64.b64decode(_DEX_B64), "embedded v" + _LOADER_VERSION

    def _ver_tuple(self, s):
        import re
        return [int(x) for x in re.findall(r"\d+", str(s or ""))]

    def _is_newer(self, a, b):
        return self._ver_tuple(a) > self._ver_tuple(b)

    def _show_update_popup(self, kind, cur_ver, new_ver, notes, on_update, force=False):
        """Beta-style BottomSheet: hero (frog) + «Доступно обновление» + version chip +
        «Что нового» card + [Обновить]/[Позже]. Does NOT permanently suppress — if you
        dismiss without updating, it re-offers after a short cooldown (anywhere in the
        client). `force` (the «Обновления» card) ignores the cooldown."""
        try:
            import time as _t
            if not force:
                if getattr(self, "_upd_popup_active", False):
                    # self-heal: if the flag has been stuck >5 min (sheet leaked / never
                    # got an onDismiss), clear it so auto-popups resume instead of dying.
                    if _t.time() - getattr(self, "_upd_popup_active_ms", 0) < 300:
                        return  # a sheet is genuinely showing — don't stack
                    self._upd_popup_active = False
                if _t.time() < getattr(self, "_upd_dismissed_until", 0):
                    return  # «Позже» cooldown still active
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None:
                try: ctx = ApplicationLoader.applicationContext
                except Exception: ctx = None
            if ctx is None or BottomSheet is None:
                self._toast("Доступно обновление v" + new_ver)
                return
            accent = self._theme_color("key_featuredStickers_addButton", 0xFF3390EC)
            accent_text = self._theme_color("key_featuredStickers_buttonText", 0xFFFFFFFF)
            text_c = self._theme_color("key_windowBackgroundWhiteBlackText", 0xFFFFFFFF)
            muted = self._theme_color("key_windowBackgroundWhiteGrayText", 0xFF9AA3AE)

            sheet = BottomSheet(ctx, True)
            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(20), AndroidUtilities.dp(20), AndroidUtilities.dp(14))

            hero = LinearLayout(ctx)
            hero.setOrientation(LinearLayout.HORIZONTAL)
            hero.setGravity(Gravity.CENTER_VERTICAL)
            iv = BackupImageView(ctx)
            try: iv.setRoundRadius(AndroidUtilities.dp(14))
            except Exception: pass
            self._load_welcome_sticker(iv, "72_72")
            hero.addView(iv, LinearLayout.LayoutParams(AndroidUtilities.dp(56), AndroidUtilities.dp(56)))
            htext = LinearLayout(ctx); htext.setOrientation(LinearLayout.VERTICAL)
            ttl = TextView(ctx); ttl.setText("Доступно обновление")
            ttl.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18); ttl.setTextColor(int(text_c))
            try: ttl.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            except Exception: pass
            htext.addView(ttl, LinearLayout.LayoutParams(-1, -2))
            sub = TextView(ctx)
            sub.setText(("eblanNFT " + ("ядро" if kind == "dex" else "интерфейс")
                         + " · v" + str(cur_ver) + " → v" + str(new_ver)))
            sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13); sub.setTextColor(int(muted))
            slp = LinearLayout.LayoutParams(-1, -2); slp.topMargin = AndroidUtilities.dp(2)
            htext.addView(sub, slp)
            hlp = LinearLayout.LayoutParams(0, -2, 1.0); hlp.leftMargin = AndroidUtilities.dp(12)
            hero.addView(htext, hlp)
            root.addView(hero, LinearLayout.LayoutParams(-1, -2))

            if notes and str(notes).strip():
                card = LinearLayout(ctx); card.setOrientation(LinearLayout.VERTICAL)
                try: card.setBackground(self._create_round_rect(self._theme_color("key_dialogBackground", 0xFF1A1A1A), radius_dp=14))
                except Exception: pass
                card.setPadding(AndroidUtilities.dp(14), AndroidUtilities.dp(12), AndroidUtilities.dp(14), AndroidUtilities.dp(12))
                wn = TextView(ctx); wn.setText("Что нового")
                wn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13); wn.setTextColor(int(accent))
                try: wn.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                except Exception: pass
                card.addView(wn, LinearLayout.LayoutParams(-1, -2))
                sv = ScrollView(ctx)
                nt = TextView(ctx); nt.setText(str(notes).strip())
                nt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14); nt.setTextColor(int(text_c))
                sv.addView(nt)
                # adapt to the text (no fixed empty box); only long changelogs scroll, capped
                svlp = LinearLayout.LayoutParams(-1, -2); svlp.topMargin = AndroidUtilities.dp(6)
                card.addView(sv, svlp)
                clp = LinearLayout.LayoutParams(-1, -2); clp.topMargin = AndroidUtilities.dp(14)
                root.addView(card, clp)

                def _cap_changelog():
                    try:
                        maxh = AndroidUtilities.dp(220)
                        if sv.getHeight() > maxh:
                            lp = sv.getLayoutParams(); lp.height = maxh; sv.setLayoutParams(lp)
                    except Exception:
                        pass
                try: run_on_ui_thread(_cap_changelog, 60)
                except Exception: pass

            blp = LinearLayout.LayoutParams(-1, -2); blp.topMargin = AndroidUtilities.dp(16)

            # «Обновить» — tapping it does NOT dismiss; it swaps in the progress bar below.
            btn = TextView(ctx); btn.setText("Обновить"); btn.setGravity(Gravity.CENTER)
            btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16); btn.setTextColor(int(accent_text))
            try:
                bg = GradientDrawable(); bg.setCornerRadius(float(AndroidUtilities.dp(12))); bg.setColor(int(accent)); btn.setBackground(self._ripple_bg(bg, accent))
                btn.setElevation(float(AndroidUtilities.dp(2)))
            except Exception: pass
            btn.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
            root.addView(btn, blp)

            # download progress (hidden until «Обновить»): a standard Android horizontal
            # ProgressBar + percent label. The popup stays open the whole time.
            prog = LinearLayout(ctx); prog.setOrientation(LinearLayout.VERTICAL)
            try: prog.setVisibility(View.GONE)
            except Exception: pass
            pstatus = TextView(ctx); pstatus.setText("Загрузка… 0%"); pstatus.setGravity(Gravity.CENTER)
            pstatus.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14); pstatus.setTextColor(int(text_c))
            prog.addView(pstatus, LinearLayout.LayoutParams(-1, -2))
            pbar = None
            try:
                PB = jclass("android.widget.ProgressBar")
                try:
                    attr = jclass("android.R$attr").progressBarStyleHorizontal
                    pbar = PB(ctx, None, attr)
                except Exception:
                    pbar = PB(ctx)   # fallback: indeterminate spinner
                try: pbar.setMax(100); pbar.setProgress(0)
                except Exception: pass
                plp = LinearLayout.LayoutParams(-1, -2); plp.topMargin = AndroidUtilities.dp(10)
                prog.addView(pbar, plp)
            except Exception: pass
            prlp = LinearLayout.LayoutParams(-1, -2); prlp.topMargin = AndroidUtilities.dp(16)
            root.addView(prog, prlp)

            # «Перезагрузить» (hidden until the download + install finishes) — restarts the
            # app so the freshly-installed .plugin loads on a clean start.
            restart = TextView(ctx); restart.setText("Перезагрузить"); restart.setGravity(Gravity.CENTER)
            restart.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16); restart.setTextColor(int(accent_text))
            try:
                rbg = GradientDrawable(); rbg.setCornerRadius(float(AndroidUtilities.dp(12))); rbg.setColor(int(accent)); restart.setBackground(self._ripple_bg(rbg, accent))
                restart.setElevation(float(AndroidUtilities.dp(2)))
            except Exception: pass
            restart.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
            try: restart.setVisibility(View.GONE)
            except Exception: pass
            restart.setOnClickListener(self._click(lambda v: self._restart_app()))
            root.addView(restart, blp)

            later = TextView(ctx); later.setText("Позже"); later.setGravity(Gravity.CENTER)
            later.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15); later.setTextColor(int(muted))
            later.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(6))
            later.setOnClickListener(self._click(lambda v: sheet.dismiss()))
            root.addView(later, LinearLayout.LayoutParams(-1, -2))

            def _vis(view, v):
                try: view.setVisibility(v)
                except Exception: pass

            def _on_progress(pct):
                try:
                    if pbar is not None:
                        try: pbar.setProgress(int(pct))
                        except Exception: pass
                    pstatus.setText("Загрузка… %d%%" % int(pct))
                except Exception: pass

            def _on_done(success, err):
                try:
                    _vis(prog, View.GONE)
                    if success:
                        _vis(restart, View.VISIBLE)   # keep popup open; user taps «Перезагрузить»
                    else:
                        _vis(btn, View.VISIBLE); _vis(later, View.VISIBLE)
                        try: sheet.setCanceledOnTouchOutside(True)
                        except Exception: pass
                        self._toast(str(err or "Ошибка обновления"))
                except Exception as e:
                    self.log("[upd] done: " + _cause(e))

            def _go(v):
                _vis(btn, View.GONE); _vis(later, View.GONE); _vis(prog, View.VISIBLE)
                try: sheet.setCanceledOnTouchOutside(False)  # don't let it vanish mid-download
                except Exception: pass
                try:
                    self._download_and_install(new_ver, _on_progress, _on_done)
                except Exception as e:
                    self.log("[upd] go: " + _cause(e)); _on_done(False, "Ошибка загрузки")
            btn.setOnClickListener(self._click(_go))

            # re-offer after a short cooldown if dismissed without updating (tap-outside,
            # «Позже», back) — clears the active flag so the next check can show it again.
            self._upd_popup_active = True
            self._upd_popup_active_ms = _t.time()
            try:
                DI = jclass("android.content.DialogInterface$OnDismissListener")
                plugin = self

                class _Dis(dynamic_proxy(DI)):
                    def onDismiss(self2, dialog):
                        import time as _t2
                        plugin._upd_popup_active = False
                        plugin._upd_dismissed_until = _t2.time() + 60  # re-offer in ~1 min
                sheet.setOnDismissListener(_Dis())
            except Exception:
                pass

            sheet.setCustomView(root)

            self._show_sheet_animated(sheet, root)
        except Exception as e:
            self._upd_popup_active = False
            self.log("[upd] popup: " + _cause(e))
            self._toast("Доступно обновление v" + str(new_ver))

    def _check_for_update(self, interactive=False):
        """HTTP update check off the UI thread; a newer version pops the update sheet."""
        if not interactive:
            import time as _t
            if _t.time() - getattr(self, "_last_upd_ms", 0) < 12:
                return  # collapse rapid fillItems re-fires only
            self._last_upd_ms = _t.time()
        import threading
        threading.Thread(target=lambda: self._update_check_worker(interactive), name="eblannft-upd", daemon=True).start()

    def _check_now(self):
        import threading
        threading.Thread(target=lambda: self._update_check_worker(False), name="eblannft-upd", daemon=True).start()

    def _start_update_loop(self):
        """Periodic background check so the popup can appear ANYWHERE in the client, not
        only on the plugin-settings screen."""
        if not _AUTO_UPDATE:
            return   # kill switch: never auto-check/auto-overwrite (see _AUTO_UPDATE note)
        if getattr(self, "_upd_loop_started", False):
            return
        self._upd_loop_started = True
        self._upd_stop = False
        import threading
        threading.Thread(target=self._update_loop, name="eblannft-upd-loop", daemon=True).start()

    def _update_loop(self):
        import time as _t
        # fast initial checks — network warms up over the first ~30s after launch, so
        # a freshly-published update pops within seconds instead of waiting a full cycle.
        for delay in (3, 8, 20):
            if getattr(self, "_upd_stop", False):
                return
            _t.sleep(delay)
            try:
                self._update_check_worker(False)
            except Exception:
                pass
        # steady-state: fast polls (~40s) for the first 15 min after launch — a freshly
        # published update still pops within a minute — then back off to 5 min. The old
        # forever-40s loop woke the radio ~90 times per hour for an idle backgrounded app;
        # the «Обновления» card still forces an immediate check at any time.
        started = _t.time()
        while not getattr(self, "_upd_stop", False):
            period = 40 if (_t.time() - started) < 900 else 300
            slept = 0
            while slept < period:  # in 5s steps so unload stops it quickly
                if getattr(self, "_upd_stop", False):
                    return
                _t.sleep(5)
                slept += 5
            try:
                self._update_check_worker(False)
            except Exception:
                pass

    def _update_check_worker(self, interactive=False):
        # Server-based updates are FULLY disabled — updates only via manually downloading the
        # .plugin file. This is the single point that contacts the VPS manifest; short-circuit it.
        if not _AUTO_UPDATE:
            if interactive:
                try: self._toast_ui("Обновление — только скачиванием файла")
                except Exception: pass
            return
        try:
            from urllib.request import Request, urlopen
            url = EBLANNFT_UPDATE_BASE + "/updates/files/eblannft_dex.json"
            with urlopen(Request(url, headers={"User-Agent": "eblannft"}), timeout=8) as r:
                man = json.loads(r.read().decode("utf-8", "replace"))
            ver = str(man.get("version") or "").strip()
            notes = str(man.get("notes") or "")
            self.log("[upd] manifest v%s (installed v%s)" % (ver, _LOADER_VERSION))
            if not ver:
                if interactive: self._toast_ui("Манифест без версии")
                return
            if not self._is_newer(ver, _LOADER_VERSION):
                if interactive: self._toast_ui("Уже последняя версия (v" + _LOADER_VERSION + ")")
                return
            run_on_ui_thread(lambda v=ver, n=notes, f=interactive: self._show_update_popup(
                "plugin", _LOADER_VERSION, v, n, lambda v2=v: self._download_and_install(v2), force=f))
        except Exception as e:
            self.log("[upd] check: " + _cause(e))
            if interactive: self._toast_ui("Не удалось проверить обновления")

    def _download_and_install(self, version, on_progress=None, on_done=None):
        import threading
        threading.Thread(target=lambda: self._download_worker(version, on_progress, on_done),
                         name="eblannft-upd-dl", daemon=True).start()

    def _download_worker(self, version, on_progress=None, on_done=None):
        """Stream the .plugin in chunks so the popup's ProgressBar shows real progress,
        then install + signal `on_done(success, err)` so the popup can offer «Перезагрузить»."""
        def _done(ok, err):
            if on_done is not None:
                run_on_ui_thread(lambda: on_done(ok, err))
            elif not ok:
                self._toast_ui(err or "Ошибка загрузки обновления")
        try:
            import os
            from urllib.request import Request, urlopen
            url = EBLANNFT_UPDATE_BASE + "/updates/files/eblannft_bootstrap.plugin"
            req = Request(url, headers={"User-Agent": "eblannft"})
            last = [-1]
            with urlopen(req, timeout=90) as r:
                try: total = int(r.headers.get("Content-Length") or 0)
                except Exception: total = 0
                chunks = []; read = 0
                while True:
                    buf = r.read(32768)
                    if not buf:
                        break
                    chunks.append(buf); read += len(buf)
                    if on_progress is not None and total > 0:
                        pct = int(read * 100 / total)
                        if pct >= 100 or pct - last[0] >= 3:
                            last[0] = pct
                            run_on_ui_thread(lambda p=pct: on_progress(p))
                data = b"".join(chunks)
            if not data or len(data) < 1000:
                _done(False, "Скачивание не удалось")
                return
            d = _resolve_data_dir()
            if not d:
                _done(False, "нет папки для загрузки")
                return
            dst = os.path.join(d, "update.plugin")
            with open(dst, "wb") as f:
                f.write(data)
            self.log("[upd] downloaded v%s (%d b)" % (version, len(data)))
            def _fin():
                try: self._install_plugin_update(dst, version)
                except Exception as e: self.log("[upd] install: " + _cause(e))
                if on_done is not None: on_done(True, None)
            run_on_ui_thread(_fin)
        except Exception as e:
            self.log("[upd] download: " + _cause(e))
            _done(False, "Ошибка загрузки обновления")

    def _restart_app(self):
        """Kill + relaunch the app so the freshly-installed .plugin loads on a clean start.
        Standard Android pattern: schedule the launch intent via AlarmManager, then kill
        our process. Falls back to a plain startActivity if the alarm path fails."""
        try:
            self._toast("Перезапуск…")
            ctx = ApplicationLoader.applicationContext
            Intent = jclass("android.content.Intent")
            intent = ctx.getPackageManager().getLaunchIntentForPackage(ctx.getPackageName())
            if intent is not None:
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK)
                try:
                    PendingIntent = jclass("android.app.PendingIntent")
                    flags = PendingIntent.FLAG_CANCEL_CURRENT
                    try: flags = flags | PendingIntent.FLAG_IMMUTABLE
                    except Exception: pass
                    pi = PendingIntent.getActivity(ctx, 0, intent, flags)
                    am = ctx.getSystemService("alarm")
                    AlarmManager = jclass("android.app.AlarmManager")
                    System = jclass("java.lang.System")
                    am.set(AlarmManager.RTC, System.currentTimeMillis() + 300, pi)
                except Exception as e:
                    self.log("[upd] alarm: " + _cause(e))
                    try: ctx.startActivity(intent)
                    except Exception: pass
            Process = jclass("android.os.Process")
            Process.killProcess(Process.myPid())
        except Exception as e:
            self.log("[upd] restart: " + _cause(e))
            self._toast("Перезапустите Telegram вручную")

    def _install_plugin_update(self, path, version):
        """Apply the downloaded .plugin by OVERWRITING our OWN installed .plugin file —
        `os.path.abspath(__file__)`, the exact file exteraGram loads on startup. This is
        the SAME proven mechanism eblanNFT-beta uses (updater.py `_download_and_apply_update`:
        os.replace onto `_BOOTSTRAP_PLUGIN_PATH = abspath(__file__)`). A restart then loads
        the new version. (loadPluginFromFile did NOT persist across restart — dropped.)"""
        if getattr(self, "_plug_installed", False):
            return
        try:
            import os
            with open(path, "rb") as f:
                data = f.read()
            if not data or data[:3] == b"dex":
                self.log("[upd] downloaded file is not a .plugin (%d b)" % (len(data) if data else 0))
                return

            overwrote = []

            def _overwrite(dest):
                try:
                    if not dest or os.path.abspath(dest) == os.path.abspath(path):
                        return
                    if os.path.abspath(dest) in [os.path.abspath(x) for x in overwrote]:
                        return
                    parent = os.path.dirname(dest)
                    if parent and not os.path.isdir(parent):
                        return
                    tmp = dest + ".tmp"
                    with open(tmp, "wb") as wf:
                        wf.write(data)
                    os.replace(tmp, dest)            # atomic
                    overwrote.append(dest)
                    self.log("[upd] overwrote " + dest)
                except Exception as e:
                    self.log("[upd] overwrite fail %s: %s" % (dest, _cause(e)))

            # 0) AUTHORITATIVE: ask exteraGram for the exact installed plugin file —
            #    PluginsController.getPluginPath(id) returns the file the host LOADS on
            #    startup (decompiled from the APK). __file__ resolved to the wrong path in
            #    earlier builds, which is why the update never stuck. This is the real fix.
            java_dir = None
            try:
                PC = jclass("com.exteragram.messenger.plugins.PluginsController")
                controller = PC.getInstance()
                try:
                    pp = controller.getPluginPath(__id__)
                    if pp:
                        pp = str(pp)
                        self.log("[upd] getPluginPath(%s) = %s" % (__id__, pp))
                        _overwrite(pp)
                except Exception as e:
                    self.log("[upd] getPluginPath: " + _cause(e))
                try:
                    pdj = controller.getPluginsDir()
                    if pdj is not None:
                        java_dir = str(pdj.getAbsolutePath())
                        self.log("[upd] pluginsDir = " + java_dir)
                except Exception as e:
                    self.log("[upd] pluginsDir: " + _cause(e))
            except Exception as e:
                self.log("[upd] PC path: " + _cause(e))

            # 1) our own .plugin file path (belt).
            try:
                self_path = os.path.abspath(__file__)
                self.log("[upd] self .plugin = " + self_path)
                if self_path.endswith(".plugin"):
                    _overwrite(self_path)
                else:
                    self.log("[upd] __file__ not a .plugin: " + self_path)
            except Exception as e:
                self.log("[upd] self-path: " + _cause(e))

            # 2) belt-and-suspenders: any matching .plugin in the plugins dir(s).
            try:
                from file_utils import get_plugins_dir
                pdir = get_plugins_dir()
            except Exception:
                pdir = None
            scan_bases = []
            if java_dir: scan_bases.append(java_dir)
            if pdir: scan_bases.extend([pdir, os.path.join(pdir, "plugins")])
            for base in scan_bases:
                if not base or not os.path.isdir(base):
                    continue
                try:
                    names = [n for n in os.listdir(base) if n.endswith(".plugin")]
                except Exception:
                    names = []
                if names:
                    self.log("[upd] dir %s -> %s" % (base, names))
                for n in names:
                    fp = os.path.join(base, n)
                    match = (__id__ in n) or ("eblan" in n.lower())
                    if not match:
                        try:
                            with open(fp, "rb") as cf:
                                hd = cf.read(8192)
                            match = (b"eblannft_dex" in hd) or (b"eblanNFT" in hd)
                        except Exception:
                            match = False
                    if match:
                        _overwrite(fp)

            self._plug_installed = True
            if overwrote:
                self.log("[upd] v%s staged (%d file) → restart applies it" % (version, len(overwrote)))
            else:
                self.log("[upd] v%s: NO .plugin overwritten — restart won't apply (see [upd] log)" % version)
                self._toast_ui("Не нашёл файл плагина для замены (см. лог)")
        except Exception as e:
            self.log("[upd] install: " + _cause(e))

    # ---- Мои подарки — карточный лист (как в боевом, на Java-мосте) ----
    def _gifts(self):
        # bridge read + JSON parse of the WHOLE library — called per sheet open, per grid
        # repopulate AND inside the doUpgrade hook. Cache briefly; any local mutation
        # (updateGift/removeGift/…) invalidates via _jvoid, the TTL covers background
        # sync changes landing on the Java side.
        try:
            import time as _t
            c = getattr(self, "_gifts_cache", None)
            if c is not None and _t.time() - c[0] < 2.0:
                return c[1]
            raw = self._jvoid("getGiftDisplayJson")
            data = json.loads(str(raw)) if raw else []
            self._gifts_cache = (_t.time(), data)
            return data
        except Exception:
            return []

    def _open_my_gifts(self):
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx:
                run_on_ui_thread(lambda: self._show_gifts_sheet(ctx))
        except Exception as e:
            self._toast("Мои подарки: " + repr(e))

    def _show_gifts_sheet(self, ctx):
        try:
            try:                                  # drop any open expand-overlay first
                self._close_gift_detail(animated=False)
            except Exception:
                pass
            # Selection is scoped to one sheet session.  Starting fresh avoids
            # keeping stale gift ids after the sheet was closed or the account
            # changed in the background.
            self._gift_select_mode = False
            self._selected_gift_ids = set()
            self._gift_checkbox_views = {}
            self._gift_tile_views = {}
            gifts = self._gifts()
            self._gifts_total_count = len(gifts or [])
            scroll = ScrollView(ctx)
            try:
                scroll.setVerticalScrollBarEnabled(True)
            except Exception:
                pass
            col = LinearLayout(ctx)
            col.setOrientation(LinearLayout.VERTICAL)
            p = AndroidUtilities.dp(12)
            col.setPadding(p, p, p, AndroidUtilities.dp(20))

            # Header uses Telegram's own drawable resources.  Candidate lists
            # keep it compatible with forks where a drawable was renamed.
            head = LinearLayout(ctx)
            head.setOrientation(LinearLayout.HORIZONTAL)
            head.setGravity(Gravity.CENTER_VERTICAL)
            hdr = TextView(ctx)
            hdr.setText("Мои подарки")
            hdr.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            hdr.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            try:
                hdr.setTypeface(AndroidUtilities.bold())
            except Exception:
                pass
            head.addView(hdr, LinearLayout.LayoutParams(0, -2, 1.0))
            self._gifts_header_title = hdr
            count_badge = TextView(ctx)
            count_badge.setText(str(self._gifts_total_count))
            count_badge.setGravity(Gravity.CENTER)
            count_badge.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            count_badge.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            count_badge.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(3),
                                   AndroidUtilities.dp(8), AndroidUtilities.dp(3))
            cbg = GradientDrawable(); cbg.setCornerRadius(float(AndroidUtilities.dp(12)))
            cbg.setColor(self._col(0x223390EC)); count_badge.setBackground(cbg)
            head.addView(count_badge, LinearLayout.LayoutParams(-2, -2))
            self._gifts_count_badge = count_badge
            select_btn = self._tg_icon_button(
                ctx, ("msg_select", "msg_select_all", "msg_check"),
                Theme.getColor(Theme.key_featuredStickers_addButton),
                "Выбрать подарки", lambda v: self._on_gift_select_action(),
            )
            head.addView(select_btn, LinearLayout.LayoutParams(AndroidUtilities.dp(44), AndroidUtilities.dp(44)))
            self._gifts_select_btn = select_btn
            plus = self._tg_icon_button(
                ctx, ("msg_add", "msg_addcontact", "msg_addfolder"),
                Theme.getColor(Theme.key_featuredStickers_addButton),
                "Добавить подарок", lambda v: self._on_gift_add_or_cancel(),
            )
            head.addView(plus, LinearLayout.LayoutParams(AndroidUtilities.dp(44), AndroidUtilities.dp(44)))
            self._gifts_plus_btn = plus
            close = self._tg_icon_button(
                ctx, ("ic_close_white", "msg_close", "msg_clear"),
                Theme.getColor(Theme.key_windowBackgroundWhiteGrayText),
                "Закрыть", lambda v: self._close_gifts_sheet(),
            )
            head.addView(close, LinearLayout.LayoutParams(AndroidUtilities.dp(44), AndroidUtilities.dp(44)))
            self._gifts_close_btn = close
            lp = LinearLayout.LayoutParams(-1, -2)
            lp.bottomMargin = AndroidUtilities.dp(10)
            col.addView(head, lp)

            # 3-column grid of lightweight tiles (preview only — no text/buttons). Tapping a
            # tile opens the full detail card. Far cheaper to render/scroll than full cards.
            grid = LinearLayout(ctx)
            grid.setOrientation(LinearLayout.VERTICAL)
            self._gifts_grid = grid
            self._gifts_ctx = ctx
            col.addView(grid, LinearLayout.LayoutParams(-1, -2))
            self._populate_gift_grid(gifts)   # reuse the list fetched above — one bridge read per open

            scroll.addView(col)

            # cap the sheet height so it doesn't fly up to the very top:
            # height = min(estimated content, ~74% of screen). When it's capped
            # the ScrollView scrolls INSIDE the sheet (it no longer drags/closes).
            screen_h = 0
            try:
                screen_h = int(AndroidUtilities.displaySize.y)
            except Exception:
                screen_h = 0
            max_h = int(screen_h * 0.74) if screen_h > 0 else AndroidUtilities.dp(560)
            n = len(gifts or [])
            rows = (n + 2) // 3                  # 3 tiles per row
            est = AndroidUtilities.dp(58 + 20) + rows * AndroidUtilities.dp(128)
            target_h = max_h if est > max_h else -2
            holder = FrameLayout(ctx)
            self._gifts_holder = holder            # host for the tile→card expand overlay
            holder.addView(scroll, FrameLayout.LayoutParams(-1, target_h))

            builder = BottomSheet.Builder(ctx)
            builder.setCustomView(holder)
            sheet = builder.create()
            self._gifts_sheet = sheet
            # don't close on content scroll / swipe — only the ✕ button closes
            try:
                sheet.setCanDismissWithSwipe(False)
            except Exception:
                pass
            # ANY dismiss (✕, back gesture, activity teardown) → drop the pinned Activity/
            # View refs so the dead sheet can be garbage-collected (leak fix: the plugin
            # instance used to keep ctx + grid + overlay alive until the next open)
            try:
                _LD = jclass("android.content.DialogInterface$OnDismissListener")
                plugin = self
                this_sheet = sheet

                class _GiftsDismiss(dynamic_proxy(_LD)):
                    def onDismiss(self2, dlg):
                        try:
                            cur = getattr(plugin, "_gifts_sheet", None)
                            if cur is not None and not cur.equals(this_sheet):
                                return   # a newer sheet already owns the refs
                        except Exception:
                            pass
                        try:
                            plugin._drop_gifts_sheet_refs()
                        except Exception:
                            pass
                sheet.setOnDismissListener(_GiftsDismiss())
            except Exception:
                pass
            self._show_sheet_animated(sheet, holder)
        except Exception as e:
            self._toast("sheet err: " + repr(e))

    # ---- «Мои подарки» SQUARE grid (3-col tiles → tap = expand into the card) ----
    def _populate_gift_grid(self, gifts=None):
        grid = getattr(self, "_gifts_grid", None)
        ctx = getattr(self, "_gifts_ctx", None)
        if grid is None or ctx is None:
            return
        try:
            grid.removeAllViews()
        except Exception:
            pass
        self._gift_checkbox_views = {}
        self._gift_tile_views = {}
        if gifts is None:
            gifts = self._gifts() or []
        self._gifts_total_count = len(gifts or [])
        try:
            badge = getattr(self, "_gifts_count_badge", None)
            if badge is not None: badge.setText(str(self._gifts_total_count))
        except Exception:
            pass
        if not gifts:
            empty = TextView(ctx)
            empty.setText("Библиотека пуста")
            empty.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            grid.addView(empty)
            return
        cols = 3
        try:
            screen_x = int(AndroidUtilities.displaySize.x)
        except Exception:
            screen_x = AndroidUtilities.dp(360)
        # square side: screen − col padding (dp12·2) − tile margins (dp4·2·3), split 3 ways
        tile_px = (screen_x - AndroidUtilities.dp(48)) // cols
        if tile_px < AndroidUtilities.dp(72):
            tile_px = AndroidUtilities.dp(72)
        m = AndroidUtilities.dp(4)
        row = None
        pending = []
        for i, g in enumerate(gifts):
            if i % cols == 0:
                row = LinearLayout(ctx)
                row.setOrientation(LinearLayout.HORIZONTAL)
                rlp = LinearLayout.LayoutParams(-1, -2)
                rlp.bottomMargin = AndroidUtilities.dp(8)
                grid.addView(row, rlp)
            tile = self._gift_tile(ctx, g, tile_px)
            tlp = LinearLayout.LayoutParams(tile_px, tile_px)   # SQUARE
            tlp.setMargins(m, 0, m, 0)
            row.addView(tile, tlp)
            try:
                tile.setAlpha(0.0)
                tile.setTranslationY(float(AndroidUtilities.dp(14)))
                tile.setScaleX(0.94); tile.setScaleY(0.94)
                ta = tile.animate().alpha(1.0).translationY(0.0).scaleX(1.0).scaleY(1.0) \
                    .setStartDelay(20 + min(i, 12) * 28).setDuration(260)
                it = self._smooth_interp()
                if it is not None: ta.setInterpolator(it)
                ta.start()
            except Exception:
                pass
            pending.append((tile, g))
        # progressive preview fill: the grid appears instantly, previews pop in (no UI block)
        for idx, (tile, g) in enumerate(pending):
            run_on_ui_thread(lambda t=tile, gg=g: self._fill_tile(t, gg), 10 + idx * 12)

    def _gift_tile(self, ctx, g, size):
        """Square grid tile: placeholder (the NATIVE gift cell — incl. its own «#num» ribbon —
        is filled lazily). Tap → expand."""
        tile = FrameLayout(ctx)
        ph = GradientDrawable()
        ph.setCornerRadius(AndroidUtilities.dp(14))
        ph.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
        tile.setBackground(ph)
        tile.setOnClickListener(self._click(lambda v, gg=g: self._on_gift_tile_clicked(gg, v), feedback=False))
        if bool(getattr(self, "_gift_select_mode", False)):
            gid = self._gift_display_id(g)
            check = ImageView(ctx)
            try:
                check.setScaleType(ImageView.ScaleType.CENTER)
            except Exception:
                pass
            check.setPadding(AndroidUtilities.dp(5), AndroidUtilities.dp(5),
                             AndroidUtilities.dp(5), AndroidUtilities.dp(5))
            try:
                check.setContentDescription("Выбрать подарок")
            except Exception:
                pass
            self._set_gift_checkbox_state(check, gid in getattr(self, "_selected_gift_ids", set()))
            csz = AndroidUtilities.dp(28)
            clp = FrameLayout.LayoutParams(csz, csz, Gravity.LEFT | Gravity.TOP)
            clp.leftMargin = AndroidUtilities.dp(7)
            clp.topMargin = AndroidUtilities.dp(7)
            tile.addView(check, clp)
            self._gift_checkbox_views[gid] = check
            self._gift_tile_views[gid] = tile
            try:
                check.setAlpha(0.0)
                check.setScaleX(0.55)
                check.setScaleY(0.55)
                check.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(180).start()
            except Exception:
                pass
        return tile

    def _tg_drawable_id(self, names):
        try:
            drawables = jclass("org.telegram.messenger.R$drawable")
            for name in names or ():
                try:
                    rid = int(getattr(drawables, str(name)) or 0)
                    if rid > 0:
                        return rid
                except Exception:
                    continue
        except Exception:
            pass
        return 0

    def _set_tg_icon(self, view, names, tint=None, description=None):
        try:
            rid = self._tg_drawable_id(names)
            if rid > 0:
                view.setImageResource(rid)
            if tint is not None:
                view.setColorFilter(tint)
            if description:
                view.setContentDescription(description)
        except Exception:
            pass

    def _tg_icon_button(self, ctx, names, tint, description, on_click):
        button = ImageView(ctx)
        try:
            button.setScaleType(ImageView.ScaleType.CENTER)
        except Exception:
            pass
        button.setPadding(AndroidUtilities.dp(10), AndroidUtilities.dp(10),
                          AndroidUtilities.dp(10), AndroidUtilities.dp(10))
        self._set_tg_icon(button, names, tint, description)
        button.setOnClickListener(self._click(on_click))
        return button

    def _animate_tg_icon(self, view, names, tint, description, rotation=0.0, alpha=1.0):
        if view is None:
            return
        try:
            view.animate().cancel()
            self._set_tg_icon(view, names, tint, description)
            view.setAlpha(0.35)
            view.setScaleX(0.72)
            view.setScaleY(0.72)
            view.setRotation(float(rotation) - 12.0)
            view.animate().alpha(float(alpha)).scaleX(1.0).scaleY(1.0).rotation(float(rotation)).setDuration(190).start()
        except Exception:
            self._set_tg_icon(view, names, tint, description)

    def _animate_gift_grid_repopulate(self):
        grid = getattr(self, "_gifts_grid", None)
        if grid is None:
            self._populate_gift_grid()
            return
        try:
            grid.animate().cancel()
            grid.animate().alpha(0.0).scaleX(0.985).scaleY(0.985).setDuration(90).start()

            def _swap():
                try:
                    self._populate_gift_grid()
                    grid.setAlpha(0.0)
                    grid.setScaleX(0.985)
                    grid.setScaleY(0.985)
                    grid.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(180).start()
                except Exception:
                    self._populate_gift_grid()
            run_on_ui_thread(_swap, 95)
        except Exception:
            self._populate_gift_grid()

    def _gift_display_id(self, g):
        """Return the same stable id used by edit/delete actions."""
        try:
            return int(g.get("unique_id") or 0) or int(g.get("saved_id") or 0)
        except Exception:
            return 0

    def _set_gift_checkbox_state(self, check, selected):
        try:
            bg = GradientDrawable()
            bg.setShape(GradientDrawable.OVAL)
            if selected:
                bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                self._set_tg_icon(check, ("msg_check",), self._col(0xFFFFFFFF), "Подарок выбран")
                check.setContentDescription("Подарок выбран")
            else:
                bg.setColor(self._col(0x66000000))
                bg.setStroke(AndroidUtilities.dp(2), self._col(0xFFFFFFFF))
                try:
                    check.setImageResource(0)
                except Exception:
                    pass
                check.setContentDescription("Подарок не выбран")
            check.setBackground(bg)
        except Exception:
            pass

    def _on_gift_tile_clicked(self, g, tile):
        if not bool(getattr(self, "_gift_select_mode", False)):
            self._open_gift_detail(g, tile)
            return
        gid = self._gift_display_id(g)
        if gid <= 0:
            self._toast("Не удалось выбрать подарок: нет id")
            return
        selected = getattr(self, "_selected_gift_ids", None)
        if selected is None:
            selected = set()
            self._selected_gift_ids = selected
        if gid in selected:
            selected.remove(gid)
        else:
            selected.add(gid)
        check = getattr(self, "_gift_checkbox_views", {}).get(gid)
        if check is not None:
            self._set_gift_checkbox_state(check, gid in selected)
            try:
                check.animate().cancel()
                check.setScaleX(0.72)
                check.setScaleY(0.72)
                check.animate().scaleX(1.0).scaleY(1.0).setDuration(170).start()
            except Exception:
                pass
        tile_view = getattr(self, "_gift_tile_views", {}).get(gid)
        if tile_view is not None:
            try:
                target = 0.94 if gid in selected else 1.0
                tile_view.animate().scaleX(target).scaleY(target).setDuration(180).start()
            except Exception:
                pass
        self._update_gift_selection_header()

    def _on_gift_select_action(self):
        if not bool(getattr(self, "_gift_select_mode", False)):
            self._gift_select_mode = True
            self._selected_gift_ids = set()
            self._update_gift_selection_header()
            self._animate_gift_grid_repopulate()
            return
        ids = sorted(getattr(self, "_selected_gift_ids", set()))
        if not ids:
            self._toast("Выберите хотя бы один подарок")
            return
        self._confirm_delete_selected_gifts(ids)

    def _on_gift_add_or_cancel(self):
        if bool(getattr(self, "_gift_select_mode", False)):
            self._gift_select_mode = False
            self._selected_gift_ids = set()
            self._update_gift_selection_header()
            self._animate_gift_grid_repopulate()
            return
        self._on_add_gift()

    def _update_gift_selection_header(self):
        selecting = bool(getattr(self, "_gift_select_mode", False))
        count = len(getattr(self, "_selected_gift_ids", set()))
        try:
            title = getattr(self, "_gifts_header_title", None)
            if title is not None:
                title.setText(("Выбрано: %d" % count) if selecting else "Мои подарки")
                title.animate().cancel()
                title.setAlpha(0.55)
                title.setTranslationX(float(AndroidUtilities.dp(4 if selecting else -4)))
                title.animate().alpha(1.0).translationX(0.0).setDuration(180).start()
        except Exception:
            pass
        try:
            btn = getattr(self, "_gifts_select_btn", None)
            if btn is not None:
                self._animate_tg_icon(
                    btn,
                    ("msg_delete",) if selecting else ("msg_select", "msg_select_all", "msg_check"),
                    Theme.getColor(Theme.key_text_RedRegular if selecting else Theme.key_featuredStickers_addButton),
                    ("Удалить выбранные подарки: %d" % count) if selecting else "Выбрать подарки",
                    alpha=1.0 if (not selecting or count > 0) else 0.42,
                )
        except Exception:
            pass
        try:
            plus = getattr(self, "_gifts_plus_btn", None)
            if plus is not None:
                self._animate_tg_icon(
                    plus,
                    ("ic_ab_back", "msg_back") if selecting else ("msg_add", "msg_addcontact", "msg_addfolder"),
                    Theme.getColor(Theme.key_featuredStickers_addButton),
                    "Отменить выбор" if selecting else "Добавить подарок",
                )
        except Exception:
            pass
        try:
            badge = getattr(self, "_gifts_count_badge", None)
            if badge is not None:
                badge.animate().cancel()
                badge.animate().alpha(0.0 if selecting else 1.0).scaleX(0.8 if selecting else 1.0) \
                    .scaleY(0.8 if selecting else 1.0).setDuration(170).start()
        except Exception:
            pass

    def _confirm_delete_selected_gifts(self, ids):
        count = len(ids or [])
        if count <= 0:
            return
        try:
            if AlertDialogBuilder is None:
                self._delete_selected_gifts(ids)
                return
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None:
                self._delete_selected_gifts(ids)
                return
            b = AlertDialogBuilder(ctx)
            b.set_title("Удалить выбранные подарки?")
            b.set_message("Будет безвозвратно удалено подарков: %d." % count)
            b.set_positive_button("Удалить", lambda d, w: self._delete_selected_gifts(ids))
            b.set_negative_button("Отмена", None)
            run_on_ui_thread(b.show)
        except Exception as e:
            self.log("[gift] confirm bulk del: " + _cause(e))
            self._delete_selected_gifts(ids)

    def _delete_selected_gifts(self, ids):
        deleted = 0
        try:
            clean_ids = [int(gid) for gid in list(ids or []) if int(gid or 0) > 0]
            if clean_ids:
                self._jvoid("removeGifts", ("str",), (json.dumps(clean_ids),))
                deleted = len(clean_ids)
            self._gift_select_mode = False
            self._selected_gift_ids = set()
            self._update_gift_selection_header()
            self._toast("Удалено подарков: %d" % deleted)
            self._refresh_gifts_sheet(120)
        except Exception as e:
            self._toast("bulk del err: " + repr(e))

    def _fill_tile(self, tile, g):
        """Insert the NATIVE gift cell (profile look) behind the badge; if that fails, fall
        back to our custom preview. Staggered (off the sheet-open path)."""
        try:
            ctx = tile.getContext()
            view = self._native_gift_cell(ctx, g)
            if view is None:
                view = self._gift_preview(ctx, g)
            try:
                view.setAlpha(0.0)
                view.setScaleX(0.96); view.setScaleY(0.96)
            except Exception:
                pass
            tile.addView(view, 0, FrameLayout.LayoutParams(-1, -1))   # index 0 → behind the badge
            try:
                va = view.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(220)
                it = self._smooth_interp()
                if it is not None: va.setInterpolator(it)
                va.start()
            except Exception:
                pass
        except Exception:
            pass

    def _native_gift_cell(self, ctx, g, strip_number=False):
        """Render the gift with Telegram's OWN profile cell (GiftSheet.GiftCell) so it matches
        the native «Подарки» grid exactly (backdrop + tiled pattern + 80dp sticker).
        Non-clickable (the parent handles taps). strip_number hides the «#num» ribbon too
        (used in the open card, whose title already shows the number). Returns None on failure."""
        try:
            wrapper = self._deserialize_saved(g.get("b64"))
            if wrapper is None:
                return None
            GiftCell = getattr(self, "_giftcell_cls", None)
            if GiftCell is None:
                GiftCell = jclass("org.telegram.ui.Gifts.GiftSheet$GiftCell")
                self._giftcell_cls = GiftCell   # one jclass lookup, not one per tile
            cell = GiftCell(ctx, _selected_account(), None)   # arg2 = currentAccount
            cell.setStarsGift(wrapper, False, False)
            # strip the cell's built-in «Уникальный»/name/price labels, leaving the visual +
            # (for tiles) the native «#num» ribbon. In the open card we strip the ribbon too
            # (the card title already shows the number).
            self._strip_native_labels(cell, strip_number)
            try:
                cell.setClickable(False)
                cell.setFocusable(False)
            except Exception:
                pass
            return cell
        except Exception:
            return None

    def _strip_native_labels(self, view, hide_ribbon=False):
        """Recursively hide the native GiftCell's text labels («Уникальный»/name/price), leaving
        the visual (backdrop + pattern + sticker). The native «#num» ribbon is kept unless
        hide_ribbon=True. Best-effort."""
        try:
            low = str(view.getClass().getSimpleName()).lower()
        except Exception:
            low = ""
        if "ribbon" in low:
            if hide_ribbon:
                try:
                    view.setVisibility(8)
                except Exception:
                    pass
            return                       # (otherwise keep the native number badge)
        if ("textview" in low) or ("starsbackground" in low):
            try:
                view.setVisibility(8)   # View.GONE
            except Exception:
                pass
            return
        try:
            n = int(view.getChildCount())
        except Exception:
            n = 0
        for i in range(n):
            try:
                self._strip_native_labels(view.getChildAt(i), hide_ribbon)
            except Exception:
                pass

    def _open_gift_detail(self, g, src=None):
        """Stable detail transition: one card layer, no snapshots or view reparenting."""
        try:
            self._close_gift_detail(animated=False)
            ctx = getattr(self, "_gifts_ctx", None)
            host = None
            try:
                s = getattr(self, "_gifts_sheet", None)
                win = s.getWindow() if s is not None else None
                host = win.getDecorView() if win is not None else None
            except Exception:
                pass
            if host is None:
                host = getattr(self, "_gifts_holder", None)
            if host is None or ctx is None:
                return
            overlay = FrameLayout(ctx)
            dim = View(ctx)
            dim.setBackgroundColor(self._col(0xCC000000))
            dim.setAlpha(0.0)
            dim.setOnClickListener(self._click(lambda v: self._close_gift_detail(), feedback=False))
            overlay.addView(dim, FrameLayout.LayoutParams(-1, -1))
            card = self._gift_card(ctx, g)
            holder = FrameLayout(ctx)
            lp = FrameLayout.LayoutParams(-1, -2, Gravity.CENTER)
            margin = AndroidUtilities.dp(16)
            lp.leftMargin = margin; lp.rightMargin = margin
            holder.addView(card, lp)
            overlay.addView(holder, FrameLayout.LayoutParams(-1, -1))
            try: host.addView(overlay, FrameLayout.LayoutParams(-1, -1))
            except Exception: host.addView(overlay)
            self._gift_overlay = overlay
            self._gift_overlay_host = host
            self._gift_overlay_card = card
            self._gift_overlay_dim = dim
            self._gift_overlay_source = None
            self._gift_overlay_shell = None
            self._gift_overlay_ghost = None
            self._gift_overlay_ghost_back = None
            self._gift_overlay_bitmap = None
            self._gift_overlay_reparent = None
            self._gift_overlay_back = None
            card.setAlpha(0.0)
            card.setScaleX(0.965); card.setScaleY(0.965)
            card.setTranslationY(float(AndroidUtilities.dp(10)))
            try: card.setElevation(float(AndroidUtilities.dp(10)))
            except Exception: pass
            dim.animate().alpha(1.0).setDuration(180).start()
            anim = card.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).translationY(0.0).setDuration(240)
            it = self._smooth_interp()
            if it is not None: anim.setInterpolator(it)
            try: anim.withLayer()
            except Exception: pass
            anim.start()
        except Exception as e:
            self._toast("detail err: " + repr(e)[:90])

    def _open_gift_detail_experimental(self, g, src=None):
        """Tap a tile → it EXPANDS into the full card (Apple-style container transform): a
        dimmed overlay drops in and the card grows from the tapped tile's position/size to a
        centered card with buttons. No bottom-sheet. Best-effort; degrades to a centered
        zoom-in if geometry isn't available."""
        try:
            self._close_gift_detail(animated=False)        # clear any previous overlay
            morph_token = int(getattr(self, "_gift_overlay_token", 0) or 0) + 1
            self._gift_overlay_token = morph_token
            ctx = getattr(self, "_gifts_ctx", None)
            # Host the overlay on the sheet's WINDOW decor (full screen) so the card centers on
            # the SCREEN (not just in the bottom sheet area — that was the «card at the bottom»
            # bug) and the dim covers everything. Fall back to the in-sheet holder.
            host = None
            try:
                s = getattr(self, "_gifts_sheet", None)
                win = s.getWindow() if s is not None else None
                host = win.getDecorView() if win is not None else None
            except Exception:
                host = None
            if host is None:
                host = getattr(self, "_gifts_holder", None)
            if host is None or ctx is None:
                return
            overlay = FrameLayout(ctx)
            dim = View(ctx)
            dim.setBackgroundColor(self._col(0xCC000000))
            dim.setAlpha(0.0)
            dim.setOnClickListener(self._click(lambda v: self._close_gift_detail(), feedback=False))
            overlay.addView(dim, FrameLayout.LayoutParams(-1, -1))
            try:
                card = self._gift_card(ctx, g)
            except Exception as e:
                self._toast("detail: " + repr(e)[:90]); return
            try:
                card.setAlpha(0.0)            # hide immediately → no full-size flash before _go
            except Exception:
                pass
            cw_holder = FrameLayout(ctx)
            clp = FrameLayout.LayoutParams(-1, -2, Gravity.CENTER)
            mm = AndroidUtilities.dp(16)
            clp.leftMargin = mm
            clp.rightMargin = mm
            cw_holder.addView(card, clp)
            overlay.addView(cw_holder, FrameLayout.LayoutParams(-1, -1))
            try:
                host.addView(overlay, FrameLayout.LayoutParams(-1, -1))
            except Exception:
                host.addView(overlay)
            self._gift_overlay = overlay
            self._gift_overlay_host = host
            self._gift_overlay_card = card
            self._gift_overlay_dim = dim
            self._gift_overlay_source = src
            self._gift_overlay_shell = None
            self._gift_overlay_ghost = None
            self._gift_overlay_ghost_back = None
            self._gift_overlay_bitmap = None
            self._gift_overlay_reparent = None
            self._gift_overlay_back = None     # set once _go knows the tile geometry
            try:
                card.setElevation(float(AndroidUtilities.dp(12)))
                card.setClipToOutline(True)
            except Exception:
                pass
            def _go():
                try:
                    cw = int(card.getWidth() or 0)
                    ch = int(card.getHeight() or 0)
                    ok = False
                    if cw > 0 and ch > 0 and src is not None:
                        try:
                            cl = jarray(jint)([0, 0]); card.getLocationInWindow(cl)
                            sl = jarray(jint)([0, 0]); src.getLocationInWindow(sl)
                            tw = int(src.getWidth() or 0); th = int(src.getHeight() or 0)
                            if tw > 0 and th > 0:
                                # TRUE shape morph: the square tile must map to
                                # the card on BOTH axes.  A single uniform scale
                                # only zooms an already-rectangular card and does
                                # not look like deformation.
                                sx = float(tw) / float(cw)
                                sy = float(th) / float(ch)
                                sx = 0.18 if sx < 0.18 else (1.0 if sx > 1.0 else sx)
                                sy = 0.18 if sy < 0.18 else (1.0 if sy > 1.0 else sy)
                                dx = (sl[0] + tw / 2.0) - (cl[0] + cw / 2.0)
                                dy = (sl[1] + th / 2.0) - (cl[1] + ch / 2.0)
                                # Animate only a lightweight rounded shell. The
                                # real card contains GiftCell + animated sticker
                                # + text hierarchy and stutters badly when it is
                                # non-uniformly scaled on every frame.
                                shell_bitmap = None
                                ghost = None
                                shell = View(ctx)
                                shell_bg = GradientDrawable()
                                shell_bg.setCornerRadius(float(AndroidUtilities.dp(18)))
                                shell_bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                                shell.setBackground(shell_bg)
                                try:
                                    shell.setClipToOutline(True)
                                    shell.setElevation(float(AndroidUtilities.dp(12)))
                                except Exception:
                                    pass
                                shell_lp = FrameLayout.LayoutParams(cw, ch, Gravity.CENTER)
                                overlay.addView(shell, shell_lp)
                                self._gift_overlay_shell = shell
                                shell.setPivotX(cw / 2.0); shell.setPivotY(ch / 2.0)
                                shell.setTranslationX(float(dx)); shell.setTranslationY(float(dy))
                                shell.setScaleX(sx); shell.setScaleY(sy); shell.setAlpha(1.0)
                                card.setTranslationX(0.0); card.setTranslationY(float(AndroidUtilities.dp(6)))
                                card.setScaleX(1.0); card.setScaleY(1.0); card.setAlpha(0.0)
                                # MORPH/deform: the preview leads (the card scaled to the tile ≈
                                # the tile itself) and the «detail» parts (attributes + buttons)
                                # start hidden and UNFOLD (fade in) as it grows — so the tile
                                # visually DEFORMS into the full card, not just zooms.
                                preview_part = info = actions = None
                                try:
                                    top0 = card.getChildAt(0)        # [preview | info]
                                    preview_part = top0.getChildAt(0)
                                    info = top0.getChildAt(1)        # attributes column
                                    actions = card.getChildAt(1)     # buttons row
                                except Exception:
                                    preview_part = info = actions = None
                                # Move the ACTUAL tapped tile into the window overlay. This keeps
                                # its live Telegram image attached throughout the transition and
                                # avoids the blank/late-loading duplicate visible in prior builds.
                                # A placeholder keeps the grid from reflowing while it is detached.
                                try:
                                    ol = jarray(jint)([0, 0]); overlay.getLocationInWindow(ol)
                                    parent = src.getParent()
                                    index = int(parent.indexOfChild(src))
                                    original_lp = src.getLayoutParams()
                                    placeholder = View(ctx)
                                    reparent_state = (
                                        parent, index, original_lp, placeholder,
                                        float(src.getPivotX()), float(src.getPivotY()), float(src.getAlpha()),
                                        float(src.getScaleX()), float(src.getScaleY()),
                                        float(src.getTranslationX()), float(src.getTranslationY()),
                                        bool(src.isClickable()))
                                    self._gift_overlay_reparent = reparent_state
                                    parent.addView(placeholder, index, original_lp)
                                    parent.removeView(src)
                                    overlay.addView(src, FrameLayout.LayoutParams(tw, th, Gravity.LEFT | Gravity.TOP))
                                    ghost = src
                                    ghost.setClickable(False)
                                    ghost.setPivotX(0.0); ghost.setPivotY(0.0)
                                    ghost.setTranslationX(float(sl[0] - ol[0]))
                                    ghost.setTranslationY(float(sl[1] - ol[1]))
                                    self._gift_overlay_ghost_back = (float(sl[0] - ol[0]), float(sl[1] - ol[1]))
                                    ghost.setScaleX(1.0); ghost.setScaleY(1.0); ghost.setAlpha(1.0)
                                    if preview_part is not None:
                                        pl = jarray(jint)([0, 0]); preview_part.getLocationInWindow(pl)
                                        pw = int(preview_part.getWidth() or tw); ph = int(preview_part.getHeight() or th)
                                        ghost_scale = min(float(pw) / float(tw), float(ph) / float(th))
                                        ghost_tx = float(pl[0] - ol[0]) + (pw - tw * ghost_scale) / 2.0
                                        ghost_ty = float(pl[1] - ol[1]) + (ph - th * ghost_scale) / 2.0
                                    else:
                                        ghost_scale = min(1.0, float(AndroidUtilities.dp(116)) / float(tw))
                                        ghost_tx = float(cl[0] - ol[0] + AndroidUtilities.dp(12))
                                        ghost_ty = float(cl[1] - ol[1] + AndroidUtilities.dp(12))
                                    self._gift_overlay_ghost = ghost
                                except Exception:
                                    ghost = None
                                try:
                                    if info is not None:
                                        info.setAlpha(0.0); info.setTranslationX(float(AndroidUtilities.dp(10)))
                                    if actions is not None:
                                        actions.setAlpha(0.0); actions.setTranslationY(float(AndroidUtilities.dp(8)))
                                except Exception:
                                    pass
                                self._gift_overlay_back = (float(dx), float(dy), float(sx), float(sy))
                                it = self._morph_interp()
                                # Let Android DRAW one complete tile-shaped frame
                                # before starting the transition. Starting the
                                # animator in this same pre-draw callback can make
                                # the initial geometry get skipped on fast devices.
                                def _start_morph():
                                    try:
                                        if int(getattr(self, "_gift_overlay_token", 0) or 0) != morph_token \
                                                or getattr(self, "_gift_overlay", None) is None:
                                            return
                                        if src is not None and ghost is not src:
                                            src.animate().cancel()
                                            src.animate().alpha(0.0).setDuration(220).start()
                                        dim.animate().alpha(1.0).setDuration(320).start()
                                        anim = shell.animate().translationX(0.0).translationY(0.0) \
                                            .scaleX(1.0).scaleY(1.0).alpha(0.0).setDuration(360)
                                        if it is not None: anim.setInterpolator(it)
                                        try: anim.withLayer()
                                        except Exception: pass
                                        anim.start()
                                        if ghost is not None:
                                            ga = ghost.animate().translationX(ghost_tx).translationY(ghost_ty) \
                                                .scaleX(ghost_scale).scaleY(ghost_scale).alpha(1.0) \
                                                .setStartDelay(35).setDuration(330)
                                            if it is not None: ga.setInterpolator(it)
                                            try: ga.withLayer()
                                            except Exception: pass
                                            ga.start()
                                        # Schedule every phase now on native
                                        # ViewPropertyAnimators. No nested delayed
                                        # Python callbacks means no missing final
                                        # frame on this exteraGram build.
                                        ca = card.animate().alpha(1.0).translationY(0.0).setStartDelay(175).setDuration(185)
                                        if it is not None: ca.setInterpolator(it)
                                        try: ca.withLayer()
                                        except Exception: pass
                                        ca.start()
                                        if info is not None:
                                            info.animate().alpha(1.0).translationX(0.0).setStartDelay(195).setDuration(175).start()
                                        if actions is not None:
                                            actions.animate().alpha(1.0).translationY(0.0).setStartDelay(235).setDuration(145).start()
                                    except Exception:
                                        try:
                                            card.setTranslationX(0.0); card.setTranslationY(0.0)
                                            card.setScaleX(1.0); card.setScaleY(1.0)
                                            dim.setAlpha(1.0)
                                        except Exception:
                                            pass
                                try: shell.invalidate()
                                except Exception: pass
                                run_on_ui_thread(_start_morph, 18)
                                ok = True
                        except Exception:
                            ok = False
                    if not ok:                                   # fallback: centered zoom-in
                        dim.animate().alpha(1.0).setDuration(280).start()
                        card.setAlpha(0.0); card.setScaleX(0.88); card.setScaleY(0.88)
                        card.setTranslationY(float(AndroidUtilities.dp(24)))
                        fa = card.animate().alpha(1.0).translationY(0.0).scaleX(1.0).scaleY(1.0).setDuration(360)
                        it2 = self._smooth_interp()
                        if it2 is not None:
                            fa.setInterpolator(it2)
                        fa.start()
                except Exception:
                    try:
                        card.setAlpha(1.0); card.setScaleX(1.0); card.setScaleY(1.0)
                    except Exception:
                        pass
            # Trigger the expand EXACTLY when the card is first laid out — OnPreDrawListener
            # fires before the first draw, so the card is never shown at full size first
            # (that was the «blink»). Fall back to a short timer if the observer isn't there.
            started = False
            try:
                pd = self._on_predraw(card, _go)
                if pd is not None:
                    card.getViewTreeObserver().addOnPreDrawListener(pd)
                    started = True
            except Exception:
                started = False
            if not started:
                run_on_ui_thread(_go, 48)
        except Exception as e:
            self._toast("detail err: " + repr(e)[:90])

    def _smooth_interp(self):
        """Material «fast-out-slow-in» ease — gentle accelerate out of the tile + gentle settle,
        no abrupt lurch (the old easeOutExpo felt jerky when fast). Fallbacks: DecelerateInterpolator."""
        try:
            return jclass("android.view.animation.PathInterpolator")(0.4, 0.0, 0.2, 1.0)
        except Exception:
            pass
        try:
            return jclass("android.view.animation.DecelerateInterpolator")(1.6)
        except Exception:
            return None

    def _morph_interp(self):
        """Emphasized deceleration for a large container transform.
        Most distance is covered early, followed by a long stable settle."""
        try:
            return jclass("android.view.animation.PathInterpolator")(0.2, 0.0, 0.0, 1.0)
        except Exception:
            return self._smooth_interp()

    def _on_predraw(self, view, fn):
        """One-shot ViewTreeObserver.OnPreDrawListener: runs fn() right before the first draw
        (when sizes are known) and removes itself. Returns None if unavailable."""
        plugin = self
        try:
            L = jclass("android.view.ViewTreeObserver$OnPreDrawListener")
        except Exception:
            return None
        box = {}

        class _P(dynamic_proxy(L)):
            def onPreDraw(self2):
                try:
                    vto = view.getViewTreeObserver()
                    if vto is not None and box.get("p") is not None:
                        vto.removeOnPreDrawListener(box["p"])
                except Exception:
                    pass
                try:
                    fn()
                except Exception:
                    pass
                return True
        p = _P()
        box["p"] = p
        return p

    def _close_gift_detail(self, animated=True):
        overlay = getattr(self, "_gift_overlay", None)
        if overlay is None:
            return
        self._gift_overlay = None
        host = getattr(self, "_gift_overlay_host", None) or getattr(self, "_gifts_holder", None)
        card = getattr(self, "_gift_overlay_card", None)
        dim = getattr(self, "_gift_overlay_dim", None)
        back = getattr(self, "_gift_overlay_back", None)
        source = getattr(self, "_gift_overlay_source", None)
        shell = getattr(self, "_gift_overlay_shell", None)
        ghost = getattr(self, "_gift_overlay_ghost", None)
        ghost_back = getattr(self, "_gift_overlay_ghost_back", None)
        shell_bitmap = getattr(self, "_gift_overlay_bitmap", None)
        reparent = getattr(self, "_gift_overlay_reparent", None)
        self._gift_overlay_card = None
        self._gift_overlay_host = None
        self._gift_overlay_dim = None
        self._gift_overlay_back = None
        self._gift_overlay_source = None
        self._gift_overlay_shell = None
        self._gift_overlay_ghost = None
        self._gift_overlay_ghost_back = None
        self._gift_overlay_bitmap = None
        self._gift_overlay_reparent = None

        def _restore_source():
            if source is None or reparent is None:
                return
            try:
                parent, index, original_lp, placeholder, px, py, alpha0, sx0, sy0, tx0, ty0, clickable0 = reparent
                try:
                    current_parent = source.getParent()
                    if current_parent is not None and current_parent is not parent:
                        current_parent.removeView(source)
                except Exception:
                    pass
                try: parent.removeView(placeholder)
                except Exception: pass
                source.animate().cancel()
                source.setPivotX(px); source.setPivotY(py)
                source.setAlpha(alpha0); source.setScaleX(sx0); source.setScaleY(sy0)
                source.setTranslationX(tx0); source.setTranslationY(ty0)
                source.setClickable(clickable0)
                try:
                    count = int(parent.getChildCount())
                    parent.addView(source, min(max(0, int(index)), count), original_lp)
                except Exception:
                    parent.addView(source, original_lp)
            except Exception:
                pass

        def _remove():
            _restore_source()
            try:
                if host is not None:
                    host.removeView(overlay)
            except Exception:
                pass
            try:
                if shell_bitmap is not None and not shell_bitmap.isRecycled():
                    shell_bitmap.recycle()
            except Exception:
                pass
        if not animated:
            try:
                if source is not None:
                    source.setAlpha(1.0); source.setScaleX(1.0); source.setScaleY(1.0)
            except Exception:
                pass
            _remove(); return
        try:
            dur = 150
            if dim is not None:
                try:
                    dim.animate().alpha(0.0).setDuration(240).start()
                except Exception:
                    pass
            if card is not None:
                if back is not None and shell is not None:
                    # Fade the heavy content quickly, then collapse only the
                    # compositor-friendly shell back into the source tile.
                    if len(back) >= 4:
                        dx, dy, sx, sy = back
                    else:
                        dx, dy, sx = back; sy = sx
                    dur = 330
                    it = self._smooth_interp()
                    try:
                        card.animate().alpha(0.0).setDuration(105).start()
                        shell.animate().cancel()
                        shell.setTranslationX(0.0); shell.setTranslationY(0.0)
                        shell.setScaleX(1.0); shell.setScaleY(1.0); shell.setAlpha(1.0)
                    except Exception:
                        pass
                    if ghost is not None and ghost_back is not None:
                        try:
                            gx, gy = ghost_back
                            ghost.animate().cancel(); ghost.setAlpha(1.0)
                            ga = ghost.animate().translationX(gx).translationY(gy) \
                                .scaleX(1.0).scaleY(1.0).alpha(1.0).setDuration(dur)
                            if it is not None: ga.setInterpolator(it)
                            try: ga.withLayer()
                            except Exception: pass
                            ga.start()
                        except Exception:
                            pass
                    a = shell.animate().translationX(dx).translationY(dy) \
                        .scaleX(sx).scaleY(sy).alpha(1.0).setDuration(dur)
                    if it is not None:
                        a.setInterpolator(it)
                    try: a.withLayer()
                    except Exception: pass
                    a.start()
                elif back is not None:
                    if len(back) >= 4:
                        dx, dy, sx, sy = back
                    else:
                        dx, dy, sx = back; sy = sx
                    dur = 330
                    card.animate().translationX(dx).translationY(dy).scaleX(sx).scaleY(sy).alpha(0.0).setDuration(dur).start()
                else:
                    card.animate().alpha(0.0).scaleX(0.9).scaleY(0.9).setDuration(dur).start()
            if source is not None and ghost is not source:
                try:
                    source.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setStartDelay(max(0, dur - 150)).setDuration(150).start()
                except Exception:
                    pass
            run_on_ui_thread(_remove, dur + 20)
        except Exception:
            _remove()

    def _close_gifts_sheet(self):
        try:
            self._close_gift_detail(animated=False)
        except Exception:
            pass
        try:
            s = getattr(self, "_gifts_sheet", None)
            if s is not None:
                s.dismiss()
                self._gifts_sheet = None
        except Exception:
            pass

    def _drop_gifts_sheet_refs(self):
        """Clear every Activity/View reference the gifts sheet pinned. Without this the
        plugin instance kept the dismissed sheet's Activity, grid and overlay views alive
        until the NEXT sheet open — a leak that grows the heap across screen rotations
        and account switches."""
        self._gifts_sheet = None
        self._gifts_grid = None
        self._gifts_ctx = None
        self._gifts_holder = None
        self._gifts_header_title = None
        self._gifts_select_btn = None
        self._gifts_plus_btn = None
        self._gifts_close_btn = None
        self._gifts_count_badge = None
        self._gifts_total_count = 0
        self._gift_select_mode = False
        self._selected_gift_ids = set()
        self._gift_checkbox_views = {}
        self._gift_tile_views = {}
        self._gift_overlay = None
        self._gift_overlay_host = None
        self._gift_overlay_card = None
        self._gift_overlay_dim = None
        self._gift_overlay_back = None
        self._gift_overlay_source = None
        self._gift_overlay_shell = None
        self._gift_overlay_ghost = None
        self._gift_overlay_ghost_back = None
        self._gift_overlay_bitmap = None
        self._gift_overlay_reparent = None

    def _refresh_gifts_sheet(self, delay=0):
        """Refresh «Мои подарки» after a gift changed. If the sheet is already showing,
        repopulate the grid IN PLACE — the old dismiss→reopen rebuilt the whole
        BottomSheet (window + every tile) and flashed close/open, which was the visible
        lag on every edit. Falls back to a fresh open when no sheet is up."""
        def _do():
            try:
                self._close_gift_detail(animated=False)
            except Exception:
                pass
            s = getattr(self, "_gifts_sheet", None)
            showing = False
            try:
                showing = s is not None and bool(s.isShowing())
            except Exception:
                showing = s is not None
            if showing and getattr(self, "_gifts_grid", None) is not None:
                try:
                    self._populate_gift_grid()
                    return
                except Exception:
                    pass
            try:
                if s is not None:
                    s.dismiss()
            except Exception:
                pass
            self._gifts_sheet = None
            try:
                frag = get_last_fragment()
                ctx = frag.getParentActivity() if frag else None
                if ctx:
                    self._show_gifts_sheet(ctx)
            except Exception:
                pass
        try:
            run_on_ui_thread(_do, int(delay))
        except Exception:
            _do()

    def _animate_in(self, view, delay=0, dy_dp=12, duration=260, start_scale=0.96):
        """Small Material entrance used by settings cards and sheet sections."""
        if view is None:
            return
        try:
            view.animate().cancel()
            view.setAlpha(0.0)
            view.setTranslationY(float(AndroidUtilities.dp(dy_dp)))
            view.setScaleX(float(start_scale))
            view.setScaleY(float(start_scale))
            anim = view.animate().alpha(1.0).translationY(0.0).scaleX(1.0).scaleY(1.0) \
                .setStartDelay(int(delay)).setDuration(int(duration))
            it = self._smooth_interp()
            if it is not None:
                anim.setInterpolator(it)
            anim.start()
        except Exception:
            try:
                view.setAlpha(1.0); view.setTranslationY(0.0)
                view.setScaleX(1.0); view.setScaleY(1.0)
            except Exception:
                pass

    def _stagger_children(self, container, base_delay=35, step=42, dy_dp=10):
        if container is None:
            return
        try:
            count = min(int(container.getChildCount() or 0), 18)
        except Exception:
            count = 0
        for i in range(count):
            try:
                self._animate_in(container.getChildAt(i), base_delay + i * step, dy_dp, 250, 0.975)
            except Exception:
                pass

    def _ripple_bg(self, content, color=None):
        """Wrap a rounded drawable in the native Android ripple, with a safe fallback."""
        try:
            RippleDrawable = jclass("android.graphics.drawable.RippleDrawable")
            ColorStateList = jclass("android.content.res.ColorStateList")
            ripple_color = int(color if color is not None else Theme.getColor(Theme.key_featuredStickers_addButton))
            ripple_color = self._col(0x33000000 | (ripple_color & 0x00FFFFFF))
            return RippleDrawable(ColorStateList.valueOf(ripple_color), content, None)
        except Exception:
            return content

    def _show_sheet_animated(self, sheet, root=None):
        def _show():
            try:
                if root is not None:
                    root.setAlpha(0.0)
                    root.setTranslationY(float(AndroidUtilities.dp(18)))
                    root.setScaleX(0.985); root.setScaleY(0.985)
                sheet.show()
                if root is not None:
                    anim = root.animate().alpha(1.0).translationY(0.0).scaleX(1.0).scaleY(1.0).setDuration(280)
                    it = self._smooth_interp()
                    if it is not None: anim.setInterpolator(it)
                    anim.start()
                    run_on_ui_thread(lambda: self._stagger_children(root, 15, 35, 8), 45)
            except Exception:
                try: sheet.show()
                except Exception: pass
        try:
            run_on_ui_thread(_show)
        except Exception:
            _show()

    def _tap_feedback(self, view):
        if view is None:
            return
        try:
            view.animate().cancel()
            view.animate().alpha(0.68).setDuration(55).start()
            run_on_ui_thread(lambda: view.animate().alpha(1.0).setDuration(130).start(), 60)
        except Exception:
            pass

    def _click(self, fn, feedback=True):
        plugin = self

        class _C(dynamic_proxy(View.OnClickListener)):
            def onClick(self2, v):
                try:
                    if feedback:
                        plugin._tap_feedback(v)
                    fn(v)
                except Exception as e:
                    plugin._toast("click err: " + repr(e))
        return _C()

    def _argb(self, c):
        try:
            return (0xFF000000 | (int(c) & 0xFFFFFF))
        except Exception:
            return Theme.getColor(Theme.key_windowBackgroundGray)

    def _gift_card(self, ctx, g):
        card = LinearLayout(ctx)
        card.setOrientation(LinearLayout.VERTICAL)
        bg = GradientDrawable()
        bg.setColor(Theme.getColor(Theme.key_dialogBackground))
        bg.setCornerRadius(AndroidUtilities.dp(18))
        card.setBackground(bg)
        try: card.setElevation(float(AndroidUtilities.dp(10)))
        except Exception: pass
        pad = AndroidUtilities.dp(12)
        card.setPadding(pad, pad, pad, pad)
        clp = LinearLayout.LayoutParams(-1, -2)
        clp.bottomMargin = AndroidUtilities.dp(12)
        card.setLayoutParams(clp)

        # top: preview + info
        top = LinearLayout(ctx)
        top.setOrientation(LinearLayout.HORIZONTAL)

        # native preview (same cell as the grid tiles), ribbon stripped (the title shows #num);
        # fall back to our custom preview if the native cell can't be built. Sized like a grid
        # tile (~116dp) so the sticker has the same breathing room — at 96dp it looked cramped.
        prev = self._native_gift_cell(ctx, g, strip_number=True) or self._gift_preview(ctx, g)
        psz = AndroidUtilities.dp(116)
        lp_prev = LinearLayout.LayoutParams(psz, psz)
        top.addView(prev, lp_prev)

        info = LinearLayout(ctx)
        info.setOrientation(LinearLayout.VERTICAL)
        lp_info = LinearLayout.LayoutParams(0, -2, 1.0)
        lp_info.leftMargin = AndroidUtilities.dp(12)

        gid = int(g.get("unique_id") or 0) or int(g.get("saved_id") or 0)
        kind = str(g.get("kind") or g.get("gift_kind") or "")
        is_regular = (kind == "regular") or not (g.get("model") or g.get("symbol") or g.get("backdrop"))

        title = TextView(ctx)
        # only NFT collectible number («#134»); regular gifts (num=0) → no «#…»
        num = g.get("num") or 0
        title.setText(str(g.get("title", "Gift")) + (f" #{num}" if num else ""))
        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 17)
        title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        try:
            title.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        # title row: [title | sale chip | TON chip]. The sale chip drives the ВИЗУАЛЬНУЮ
        # «продажу» (звёзды / GRAM), the TON chip — «хранение в блокчейне TON»
        # (both NFT/unique-only; regular gifts have neither row on the native sheet).
        title_row = LinearLayout(ctx)
        title_row.setOrientation(LinearLayout.HORIZONTAL)
        title_row.setGravity(Gravity.CENTER_VERTICAL)
        title_row.addView(title, LinearLayout.LayoutParams(0, -2, 1.0))
        if not is_regular:
            try:
                slp = LinearLayout.LayoutParams(-2, -2)
                slp.leftMargin = AndroidUtilities.dp(6)
                title_row.addView(self._sale_chip(ctx, g, gid), slp)
            except Exception:
                pass
            try:
                tlp = LinearLayout.LayoutParams(-2, -2)
                tlp.leftMargin = AndroidUtilities.dp(6)
                title_row.addView(self._ton_chip(ctx, g, gid), tlp)
            except Exception:
                pass
        info.addView(title_row, LinearLayout.LayoutParams(-1, -2))

        # sub-table: NFT attributes OR editable «От/Дата/Комментарий» rows (regular)
        tbl = LinearLayout(ctx)
        tbl.setOrientation(LinearLayout.VERTICAL)
        tb = GradientDrawable()
        tb.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
        tb.setCornerRadius(AndroidUtilities.dp(10))
        tbl.setBackground(tb)
        tp = AndroidUtilities.dp(8)
        tbl.setPadding(tp, AndroidUtilities.dp(6), tp, AndroidUtilities.dp(6))
        any_attr = False
        if is_regular:
            rows = (("От", "custom_from", "не указано", "От кого (user id)", True),
                    ("Дата", "custom_date", "не указана", "Дата и время (например 23.03.2026 14:30)", False),
                    ("Комментарий", "custom_comment", "не указан", "Комментарий", False))
            for label, field, placeholder, dlg_title, numeric in rows:
                any_attr = True
                cur = str(g.get(field) or "").strip()
                r = self._meta_row(ctx, label, cur if cur else "Добавить", bool(cur),
                                   lambda v, f=field, c=cur, t=dlg_title, nm=numeric, k=gid:
                                       self._edit_regular_field(k, f, c, t, nm))
                rlp = LinearLayout.LayoutParams(-1, -2)
                rlp.topMargin = AndroidUtilities.dp(3)
                tbl.addView(r, rlp)
        else:
            for label, key in (("Model", "model"), ("Symbol", "symbol"), ("Backdrop", "backdrop")):
                val = g.get(key)
                if not val:
                    continue
                any_attr = True
                r = LinearLayout(ctx)
                r.setOrientation(LinearLayout.HORIZONTAL)
                lbl = TextView(ctx)
                lbl.setText(label)
                lbl.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                lbl.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
                r.addView(lbl, LinearLayout.LayoutParams(0, -2, 1.0))
                vv = TextView(ctx)
                vv.setText(str(val))
                vv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                vv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                r.addView(vv, LinearLayout.LayoutParams(-2, -2))
                rlp = LinearLayout.LayoutParams(-1, -2)
                rlp.topMargin = AndroidUtilities.dp(3)
                tbl.addView(r, rlp)
        if any_attr:
            mlp = LinearLayout.LayoutParams(-1, -2)
            mlp.topMargin = AndroidUtilities.dp(8)
            info.addView(tbl, mlp)

        top.addView(info, lp_info)
        card.addView(top, LinearLayout.LayoutParams(-1, -2))

        # actions: regular → only «Удалить»; NFT → «Изменить» + «Удалить»
        actions = LinearLayout(ctx)
        actions.setOrientation(LinearLayout.HORIZONTAL)
        alp = LinearLayout.LayoutParams(-1, -2)
        alp.topMargin = AndroidUtilities.dp(12)

        if not is_regular:
            edit = self._pill(ctx, "Изменить", Theme.getColor(Theme.key_featuredStickers_addButton),
                              lambda v, gg=g: self._open_constructor(gg))
            ep = LinearLayout.LayoutParams(0, AndroidUtilities.dp(44), 1.0)
            ep.rightMargin = AndroidUtilities.dp(8)
            actions.addView(edit, ep)

        gname = str(g.get("title", "Подарок")) + (f" #{num}" if num else "")
        dele = self._pill(ctx, "Удалить", Theme.getColor(Theme.key_text_RedRegular),
                          lambda v, k=gid, nm=gname: self._confirm_delete_gift(k, nm))
        actions.addView(dele, LinearLayout.LayoutParams(0, AndroidUtilities.dp(44), 1.0))

        card.addView(actions, alp)
        return card

    def _ton_drawable_id(self):
        try:
            return int(getattr(jclass("org.telegram.messenger.R$drawable"), "msg_ton"))
        except Exception:
            return 0

    _TON_BLUE = 0xFF0098EA

    def _ton_chip(self, ctx, g, gid):
        """Pretty TON pill on a gift card → opens «хранение в блокчейне TON» config. Filled
        TON-blue when an address is set, outlined when off."""
        enabled = bool(str(g.get("ton_address") or "").strip())
        chip = LinearLayout(ctx)
        chip.setOrientation(LinearLayout.HORIZONTAL)
        chip.setGravity(Gravity.CENTER_VERTICAL)
        chip.setPadding(AndroidUtilities.dp(9), AndroidUtilities.dp(5), AndroidUtilities.dp(11), AndroidUtilities.dp(5))
        bg = GradientDrawable()
        bg.setCornerRadius(float(AndroidUtilities.dp(14)))
        if enabled:
            bg.setColor(self._col(self._TON_BLUE))
        else:
            bg.setColor(self._col(0x1F0098EA))                       # faint blue fill
            bg.setStroke(AndroidUtilities.dp(1), self._col(0x800098EA))
        chip.setBackground(bg)
        fg = self._col(0xFFFFFFFF) if enabled else self._col(self._TON_BLUE)
        # TON diamond icon (bundled R.drawable.msg_ton)
        try:
            rid = self._ton_drawable_id()
            if rid and ImageView is not None:
                iv = ImageView(ctx)
                iv.setImageResource(rid)
                try: iv.setColorFilter(fg)
                except Exception: pass
                ilp = LinearLayout.LayoutParams(AndroidUtilities.dp(15), AndroidUtilities.dp(15))
                ilp.rightMargin = AndroidUtilities.dp(5)
                chip.addView(iv, ilp)
        except Exception:
            pass
        t = TextView(ctx)
        t.setText("TON")
        t.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        t.setTextColor(fg)
        try:
            t.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        chip.addView(t, LinearLayout.LayoutParams(-2, -2))
        chip.setOnClickListener(self._click(lambda v, k=gid, a=str(g.get("ton_address") or ""): self._open_ton_config(k, a)))
        return chip

    def _open_ton_config(self, gid, current):
        """Configure «хранение подарка в блокчейне TON»: set the owner wallet (a ник.ton or a
        raw address). The Java enrich() then stamps owner_address/gift_address so the native
        gift sheet shows «Подарок хранится в блокчейне TON. Посмотреть → / Владелец: <addr>».
        Empty input disables it."""
        cur = str(current or "").strip()
        def _submit(text):
            addr = str(text or "").strip()
            try:
                res = self._jvoid("updateGift", ("long", "str"), (int(gid), json.dumps({"ton_address": addr})))
                self.log("[ton] set gid=%s addr=%r -> %s" % (gid, addr, res))
            except Exception as e:
                self._toast("TON: " + repr(e)[:120]); return
            # re-enrich so owner_address/gift_address get (re)stamped, then refresh the sheet
            try:
                self._jvoid("reloadAll")
            except Exception:
                pass
            self._refresh_gifts_sheet(80)
            self._toast("Подарок хранится в блокчейне TON ✓" if addr else "Хранение в TON отключено")
        self._input("Хранение в блокчейне TON\nник.ton или адрес кошелька (пусто — отключить):",
                    cur, _submit, numeric=False)

    _SALE_GREEN = 0xFF31B545

    def _sale_chip(self, ctx, g, gid):
        """«Продажа» pill on a gift card → visual resale config (звёзды или GRAM/TON).
        Filled green with the current price when listed, outlined when off. The Java
        enrich() stamps gift.resell_amount, so the NATIVE profile grid ribbon and the
        «Продаётся за …» sheet state render themselves — nothing leaves the device."""
        rc = g.get("resale_config") or {}
        try:
            stars = int(rc.get("stars") or 0)
        except Exception:
            stars = 0
        try:
            nano = int(rc.get("nanoton") or 0)
        except Exception:
            nano = 0
        ton_only = bool(rc.get("ton_only"))
        on_sale = stars > 0 or nano > 0
        chip = LinearLayout(ctx)
        chip.setOrientation(LinearLayout.HORIZONTAL)
        chip.setGravity(Gravity.CENTER_VERTICAL)
        chip.setPadding(AndroidUtilities.dp(9), AndroidUtilities.dp(5), AndroidUtilities.dp(11), AndroidUtilities.dp(5))
        bg = GradientDrawable()
        bg.setCornerRadius(float(AndroidUtilities.dp(14)))
        if on_sale:
            bg.setColor(self._col(self._SALE_GREEN))
        else:
            bg.setColor(self._col(0x1F31B545))                       # faint green fill
            bg.setStroke(AndroidUtilities.dp(1), self._col(0x8031B545))
        chip.setBackground(bg)
        fg = self._col(0xFFFFFFFF) if on_sale else self._col(self._SALE_GREEN)
        t = TextView(ctx)
        if on_sale and ton_only and nano > 0:
            gram = nano / 1e9
            t.setText(("%s GRAM" % (("%.2f" % gram).rstrip("0").rstrip("."))))
        elif on_sale:
            t.setText("⭐ " + "{:,}".format(stars).replace(",", " "))
        else:
            t.setText("Продажа")
        t.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        t.setTextColor(fg)
        try:
            t.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        chip.addView(t, LinearLayout.LayoutParams(-2, -2))
        chip.setOnClickListener(self._click(lambda v, k=gid, r=dict(rc): self._open_sale_config(k, r)))
        return chip

    def _open_sale_config(self, gid, rc):
        """Configure the ВИЗУАЛЬНУЮ продажу: pick the currency (звёзды / GRAM), enter the
        price, or unlist. Persists resale_config on the entry; Java enrich() then builds
        resell_amount (+ resale_ton_only for GRAM), so the profile grid shows the native
        price ribbon and the gift sheet — «Продаётся за …». Никакого выставления на
        продажу на самом деле не происходит — это видно только на этом устройстве."""
        stars = 0
        nano = 0
        try:
            stars = int(rc.get("stars") or 0)
            nano = int(rc.get("nanoton") or 0)
        except Exception:
            pass
        on_sale = stars > 0 or nano > 0

        def _apply(patch, msg):
            try:
                res = self._jvoid("updateGift", ("long", "str"), (int(gid), json.dumps({"resale_config": patch})))
                self.log("[sale] gid=%s cfg=%r -> %s" % (gid, patch, res))
            except Exception as e:
                self._toast("Продажа: " + repr(e)[:120]); return
            try:
                self._jvoid("reloadAll")   # re-enrich → resell_amount (re)stamped + grid invalidated
            except Exception:
                pass
            self._refresh_gifts_sheet(80)
            self._toast(msg)

        def _ask_stars():
            def _submit(text):
                try:
                    n = int(str(text or "0").strip().replace(" ", ""))
                except Exception:
                    self._toast("Введите целое число звёзд"); return
                if n <= 0:
                    self._toast("Цена должна быть больше 0"); return
                _apply({"stars": n}, "Выставлено на продажу за ⭐ %s" % "{:,}".format(n).replace(",", " "))
            self._input("Продажа за звёзды\nЦена в ⭐ (мин. 125):",
                        str(stars) if stars > 0 else "", _submit, numeric=True)

        def _ask_gram():
            def _submit(text):
                try:
                    v = float(str(text or "0").strip().replace(",", ".").replace(" ", ""))
                except Exception:
                    self._toast("Введите цену в GRAM, например 12.5"); return
                if v <= 0:
                    self._toast("Цена должна быть больше 0"); return
                _apply({"nanoton": int(round(v * 1e9)), "ton_only": True},
                       "Выставлено на продажу за %s GRAM" % (("%.2f" % v).rstrip("0").rstrip(".")))
            self._input("Продажа за GRAM (TON)\nЦена в GRAM:",
                        (("%.2f" % (nano / 1e9)).rstrip("0").rstrip(".")) if nano > 0 else "",
                        _submit, numeric=False)

        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None or AlertDialogBuilder is None:
                _ask_stars(); return
            b = AlertDialogBuilder(ctx)
            b.set_title("Продажа подарка (визуально)")
            items = ["Продать за звёзды ⭐", "Продать за GRAM 💎"]
            if on_sale:
                items.append("Снять с продажи")

            def _pick(dlg, idx):
                try:
                    dlg.dismiss()
                except Exception:
                    pass
                if idx == 0:
                    _ask_stars()
                elif idx == 1:
                    _ask_gram()
                else:
                    _apply({}, "Подарок снят с продажи")
            b.set_items(items, _pick)
            b.set_negative_button("Отмена", None)
            run_on_ui_thread(b.show)
        except Exception:
            _ask_stars()

    def _meta_row(self, ctx, label, value, has_val, on_click):
        """A tappable «label … value ✎» row for editable regular-gift overrides."""
        r = LinearLayout(ctx)
        r.setOrientation(LinearLayout.HORIZONTAL)
        r.setGravity(Gravity.CENTER_VERTICAL)
        r.setOnClickListener(self._click(on_click))
        try:
            r.setPadding(AndroidUtilities.dp(2), AndroidUtilities.dp(4), AndroidUtilities.dp(2), AndroidUtilities.dp(4))
        except Exception:
            pass
        lbl = TextView(ctx)
        lbl.setText(label)
        lbl.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        lbl.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
        r.addView(lbl, LinearLayout.LayoutParams(0, -2, 1.0))
        vv = TextView(ctx)
        vv.setText(str(value))
        vv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        # filled → normal text; empty («Добавить») → accent colour as a hint
        vv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack if has_val
                                       else Theme.key_featuredStickers_addButton))
        r.addView(vv, LinearLayout.LayoutParams(-2, -2))
        return r

    def _edit_regular_field(self, gid, field, current, dlg_title, numeric):
        def _submit(text):
            self._set_regular_field(gid, field, str(text or ""))
        self._input(dlg_title, current, _submit, numeric=numeric)

    def _set_regular_field(self, gid, field, value):
        """Persist a regular-gift override + route it like production:
        custom_from → identity_config.from_user_id, custom_date → custom_date_ts."""
        try:
            raw = str(value or "").strip()
            patch = {field: raw}
            if field == "custom_from":
                uid = self._parse_from_uid(raw)
                if uid > 0:
                    # a uid → resolve the display name so OTHER viewers (who don't know
                    # this user) still see it; fall back to the raw uid string
                    name = self._resolve_user_name(uid) or raw
                else:
                    # a plain name → synthesize a stable id so from_id can reference the
                    # injected fake user that carries the name
                    name = raw
                    if raw:
                        import hashlib as _hl
                        uid = 7000000000000 + (int(_hl.md5(raw.encode("utf-8")).hexdigest()[:12], 16) % 1000000000)
                patch["identity_config"] = {"from_user_id": int(uid)} if uid > 0 else {}
                patch["custom_from_name"] = name if uid > 0 else ""
            elif field == "custom_date":
                ts = self._parse_date_ts(raw)
                patch["custom_date_ts"] = int(ts)   # 0 clears the override
            res = self._jvoid("updateGift", ("long", "str"), (int(gid), json.dumps(patch)))
            try:
                self.log("[gift] updateGift %s=%r -> %s" % (field, raw, res))
            except Exception:
                pass
            # refresh the sheet so the row shows the new value
            self._refresh_gifts_sheet(80)
        except Exception as e:
            self._toast("сохранение: " + repr(e)[:140])

    def _resolve_user_name(self, uid):
        """Display name of a user id from the local cache (for the «От» sender), or ''."""
        try:
            mc = jclass("org.telegram.messenger.MessagesController").getInstance(_selected_account())
            u = mc.getUser(JLong(int(uid)))
            if u is None:
                return ""
            first = str(getattr(u, "first_name", "") or "").strip()
            last = str(getattr(u, "last_name", "") or "").strip()
            return (first + " " + last).strip()
        except Exception:
            return ""

    def _parse_from_uid(self, raw):
        s = str(raw or "").strip()
        if s.startswith("@"):
            s = s[1:]
        try:
            return int(s) if s.isdigit() else 0
        except Exception:
            return 0

    def _parse_date_ts(self, raw):
        s = str(raw or "").strip()
        if not s:
            return 0
        import datetime as _dt
        # date+time first (so "23.03.2026 14:30" keeps the time), then date-only
        for fmt in ("%d.%m.%Y %H:%M:%S", "%d.%m.%Y %H:%M", "%d.%m.%y %H:%M",
                    "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M",
                    "%d/%m/%Y %H:%M", "%d-%m-%Y %H:%M",
                    "%d.%m.%Y", "%d.%m.%y", "%Y-%m-%d", "%d/%m/%Y", "%d/%m/%y", "%d-%m-%Y"):
            try:
                return int(_dt.datetime.strptime(s, fmt).timestamp())
            except Exception:
                continue
        return 0

    # ---- visual UPGRADE: regular gift → roll random attrs → save as NFT ----
    def _entry_upgradable(self, g):
        """True if this is a regular gift that has an upgrade available (upgrade_stars>0
        and not already unique) — i.e. it can be turned into an NFT."""
        try:
            if str(g.get("kind") or g.get("gift_kind") or "") != "regular":
                return False
            gift = self._deserialize_gift(g.get("b64"))
            if gift is None:
                return False
            if "unique" in str(gift.getClass().getSimpleName()).lower():
                return False
            return int(getattr(gift, "upgrade_stars", 0) or 0) > 0
        except Exception:
            return False

    def _upgrade_regular(self, uid, g):
        base_id = 0
        try:
            base_id = int(g.get("base_gift_id") or 0)
        except Exception:
            base_id = 0
        if base_id <= 0:
            try:
                gift = self._deserialize_gift(g.get("b64"))
                base_id = int(getattr(gift, "id", 0) or 0) if gift is not None else 0
            except Exception:
                base_id = 0
        if base_id <= 0:
            self._toast("нет base_gift_id для улучшения")
            return
        title = str(g.get("title") or "NFT") or "NFT"
        self._toast("улучшаю…")

        def _on(models, patterns, backdrops, raw):
            if raw is not None and int(getattr(raw, "size", lambda: 0)()) > 0:
                self._show_upgrade_roll(uid, title, raw, base_id, models, patterns, backdrops)
            elif models or patterns or backdrops:
                self._finalize_upgrade(uid, title, base_id, None, None, None,
                                       None, models, patterns, backdrops)
            else:
                self._toast("Атрибуты улучшения недоступны")
        self._fetch_upgrade_attrs(base_id, _on)

    def _show_upgrade_roll(self, uid, title, attr_list, base_id, models, patterns, backdrops):
        """Open the native StarGiftPreviewSheet (RANDOM/rolling mode) as the upgrade
        animation, let it roll, then land on the previewed random combo + save."""
        try:
            self._install_ctor_hooks()
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if act is None:
                self._toast("нет контекста")
                return
            Sheet = jclass("org.telegram.ui.Stars.StarGiftPreviewSheet")
            rp = None
            try:
                rp = frag.getResourceProvider()
            except Exception:
                rp = None
            sheet = Sheet(act, rp, _selected_account(), str(title), attr_list, False)
            self._nat_sheet = sheet
            sheet.show()
            self._kill_sheet_anim(sheet)
            # NOTE: do NOT seed → the sheet stays in RANDOM mode (cycling preview =
            # the «прокрутка» animation). Land + save after the roll.
            run_on_ui_thread(
                lambda: self._finalize_upgrade_from_sheet(sheet, uid, title, base_id,
                                                          models, patterns, backdrops), 2600)
        except Exception as e:
            self._toast("улучшение: " + repr(e)[:140])
            self.log("[upg] roll: " + _cause(e))

    def _finalize_upgrade_from_sheet(self, sheet, uid, title, base_id, models, patterns, backdrops):
        model = pattern = backdrop = None
        try:
            tv = self._jfield(sheet, "topView")
            if tv is not None:
                try: model = tv.getUpgradeImageViewAttribute()
                except Exception: pass
                try: pattern = tv.getUpgradePatternAttribute()
                except Exception: pass
                try: backdrop = tv.getUpgradeBackdropAttribute()
                except Exception: pass
        except Exception:
            pass
        self._finalize_upgrade(uid, title, base_id, model, pattern, backdrop,
                               sheet, models, patterns, backdrops)

    def _finalize_upgrade(self, uid, title, base_id, model, pattern, backdrop,
                          sheet, models, patterns, backdrops):
        import random as _r
        # fall back to a random pick if the sheet didn't expose the landed attr
        if model is None and models:
            model = _r.choice(models)
        if pattern is None and patterns:
            pattern = _r.choice(patterns)
        if backdrop is None and backdrops:
            backdrop = _r.choice(backdrops)
        base_gift = self._find_base_gift(base_id)
        cap = 0
        try:
            cap = int(getattr(base_gift, "availability_total", 0) or 0) if base_gift is not None else 0
        except Exception:
            cap = 0
        if cap <= 0:
            cap = 99999
        num = _r.randint(1, max(1, min(cap, 999999)))
        ok = self._build_and_save(model, pattern, backdrop, title, num,
                                  base_gift_id=base_id, base_gift=base_gift)
        try:
            if sheet is not None:
                sheet.dismiss()
        except Exception:
            pass
        if ok:
            # replace the regular gift with the freshly-minted NFT
            try:
                self._jvoid("removeGift", ("long",), (int(uid),))
            except Exception:
                pass
            self._toast("Улучшено → NFT #%d ✓" % num)
            self._refresh_gifts_sheet(120)

    # ---- NATIVE upgrade: hook StarGiftSheet, replace the bottom button with
    # «Улучшить», drive the real TG reveal animation (topView.rotateAttributes +
    # page switch) on the live sheet, then save the rolled result as an NFT ----
    def _install_gift_sheet_hooks(self):
        if getattr(self, "_gs_hooks_done", False):
            return
        if MethodHook is None or getattr(self, "hook_method", None) is None or _DoUpgradeHook is None:
            return
        self._gs_hooks_done = True
        try:
            Cls = JavaClass.forName("org.telegram.ui.Stars.StarGiftSheet")
        except Exception as e:
            self.log("[upg] no StarGiftSheet: " + _cause(e))
            return
        refs = []
        try:
            for m in Cls.getDeclaredMethods():
                try:
                    name = str(m.getName())
                    m.setAccessible(True)
                    if name == "doUpgrade":
                        refs.append(self.hook_method(m, _DoUpgradeHook(self)))
                    elif name in ("showCraft", "canCraft") and _CraftGateHook is not None:
                        refs.append(self.hook_method(m, _CraftGateHook(self)))
                    elif name == "openCrafting" and _OpenCraftHook is not None:
                        refs.append(self.hook_method(m, _OpenCraftHook(self)))
                    elif name == "set" and _CraftSetHook is not None:
                        refs.append(self.hook_method(m, _CraftSetHook(self)))
                except Exception:
                    continue
        except Exception as e:
            self.log("[upg] gs hook err: " + _cause(e))
        self._gs_hook_refs = refs
        self.log("[gift-sheet] upgrade/craft hooks: " + str(len(refs)))

    def _match_craft_entry(self, sheet):
        """Return the local, not-yet-crafted NFT shown by a native gift sheet."""
        if sheet is None:
            return None
        try:
            gift = None
            try: gift = sheet.getUniqueGift()
            except Exception: pass
            if gift is None:
                saved = self._jfield(sheet, "savedStarGift")
                gift = _gv(saved, "gift", None)
            if gift is None or bool(_gv(gift, "crafted", False)):
                return None
            gid = int(_gv(gift, "id", 0) or 0)
            slug = str(_gv(gift, "slug", "") or "")
            for entry in self._gifts():
                try:
                    kind = str(entry.get("kind") or entry.get("gift_kind") or "")
                    if kind == "regular" or bool(entry.get("crafted")):
                        continue
                    eid = self._gift_display_id(entry)
                    same = gid > 0 and eid == gid
                    if not same and slug:
                        same = str(entry.get("slug") or "") == slug
                    if same and self._craft_base_id(entry) > 0:
                        return entry
                except Exception:
                    continue
        except Exception:
            pass
        return None

    def _show_native_craft_button(self, sheet):
        """Reveal AyuGram's built-in filled_forge shortcut beside the three dots."""
        entry = self._match_craft_entry(sheet)
        if entry is None or not self._craft_entry_eligible(entry, sheet, resolve=True):
            return False
        try:
            top = self._jfield(sheet, "topView")
            craft_view = self._jfield(top, "craftView") if top is not None else None
            if craft_view is None:
                return False
            craft_view.setVisibility(0)
            craft_view.setAlpha(1.0)
            craft_view.setEnabled(True)
            craft_view.setClickable(True)
            try: craft_view.bringToFront()
            except Exception: pass
            try:
                craft_view.setScaleX(0.86); craft_view.setScaleY(0.86)
                craft_view.animate().scaleX(1.0).scaleY(1.0).alpha(1.0).setDuration(180).start()
            except Exception:
                pass
            return True
        except Exception as e:
            self.log("[craft] show button: " + _cause(e))
            return False

    def _craft_entry_eligible(self, entry, sheet=None, resolve=True):
        """A collection is craftable only when Telegram returns crafted model attrs."""
        base_id = self._craft_base_id(entry)
        resale = entry.get("resale_config") or {}
        try: on_sale = int(resale.get("stars") or 0) > 0 or int(resale.get("nanoton") or 0) > 0
        except Exception: on_sale = False
        if (base_id <= 0 or bool(entry.get("crafted")) or on_sale
                or bool(str(entry.get("ton_address") or "").strip())):
            return False
        cache = getattr(self, "_craft_eligible_cache", None)
        if cache is None:
            cache = self._craft_eligible_cache = {}
        if base_id in cache:
            return bool(cache[base_id])
        if not resolve:
            return False
        pending = getattr(self, "_craft_eligible_pending", None)
        if pending is None:
            pending = self._craft_eligible_pending = set()
        if base_id in pending:
            return False
        pending.add(base_id)
        plugin = self

        def _resolved(models, patterns, backdrops, raw=None):
            eligible = False
            try:
                eligible = (bool(patterns) and bool(backdrops)
                            and any(bool(_gv(m, "crafted", False)) for m in models))
            except Exception:
                eligible = False
            cache[base_id] = bool(eligible)
            pending.discard(base_id)
            if eligible and sheet is not None:
                try:
                    plugin._show_native_craft_button(sheet)
                    if run_on_ui_thread is not None:
                        run_on_ui_thread(lambda: plugin._show_native_craft_button(sheet), 180)
                except Exception: pass
        self._fetch_upgrade_attrs(base_id, _resolved)
        return False

    def _on_do_upgrade(self, sheet):
        """Called from the doUpgrade() hook. If this sheet shows OUR upgradable gift,
        block the real RPC and play the native reveal with a random local NFT.
        Returns True to consume the call, False to let the native upgrade proceed."""
        if sheet is None:
            return False
        if getattr(self, "_upg_busy", False):
            return True   # already upgrading this one — swallow re-taps
        # Find the opened gift wrapper: savedStarGift wrapper has an inner .gift. Try a few field
        # names (a newer TG may rename it). No getClass() here — keep this exception-free so the
        # diagnostic below is ALWAYS reached.
        saved = None
        for _fn in ("savedStarGift", "savedGift", "starGift"):
            try:
                v = self._jfield(sheet, _fn)
            except Exception:
                v = None
            if v is not None and _gv(v, "gift", None) is not None:
                saved = v
                break
        entry = self._match_upgrade_entry(saved)
        if entry is None:
            # ALWAYS surface WHY the fake-upgrade interception missed (temporary diag; the toast
            # tells us: was the wrapper found, the inner gift class/id, and our regular base ids).
            try:
                inner = _gv(saved, "gift", None) if saved is not None else None
                iid = 0
                icls = "NONE"
                if inner is not None:
                    try: iid = int(_gv(inner, "id", 0) or 0)
                    except Exception: iid = -1
                    try: icls = str(inner.getClass().getSimpleName())[:18]
                    except Exception: icls = "?"
                regs = []
                for g in self._gifts():
                    if str(g.get("kind") or g.get("gift_kind") or "") == "regular":
                        try: regs.append(int(g.get("base_gift_id") or 0))
                        except Exception: pass
                self._toast("upg no-match: saved=%s inner=%s id=%d base=%s" % (saved is not None, icls, iid, regs[:4]))
            except Exception as e:
                try: self._toast("upg diag EXC: " + repr(e)[:90])
                except Exception: pass
            return False   # not ours → real gift, let TG upgrade normally
        self._upg_busy = True
        try:
            base_id = int(entry.get("base_gift_id") or 0)
            reg_uid = int(entry.get("unique_id") or 0) or int(entry.get("saved_id") or 0)
            title = str(entry.get("title") or "NFT") or "NFT"
            # the preview pool openUpgrade() already fetched (correct format for the roll)
            sa = self._jfield(sheet, "sample_attributes")
            models, patterns, backdrops = self._split_attrs(sa) if sa is not None else ([], [], [])
            import random as _r
            model = _r.choice(models) if models else None
            pattern = _r.choice(patterns) if patterns else None
            backdrop = _r.choice(backdrops) if backdrops else None
            base_gift = self._find_base_gift(base_id)
            cap = 0
            try:
                cap = int(getattr(base_gift, "availability_total", 0) or 0) if base_gift is not None else 0
            except Exception:
                cap = 0
            num = _r.randint(1, max(1, min(cap if cap > 0 else 99999, 999999)))
            # «С именем отправителя» checked → keep original details (sender/date/comment)
            # as the native bottom row on the upgraded NFT
            keep = False
            try:
                cb = self._jfield(sheet, "checkbox")
                keep = bool(cb.isChecked()) if cb is not None else False
            except Exception:
                keep = False
            od = None
            if keep:
                suid = self._parse_from_uid(str(entry.get("custom_from") or ""))
                dts = self._parse_date_ts(str(entry.get("custom_date") or ""))
                cc = str(entry.get("custom_comment") or "").strip()
                if suid > 0 or dts > 0 or cc:
                    od = {"sender_uid": suid, "recipient_uid": _real_uid(),
                          "date_ts": dts, "comment": cc}
            # Build the unique gift OFF the UI thread: the reflective TL construction +
            # serialization froze the «Улучшить» tap for its full duration on weak
            # devices. The hook returns immediately; the reveal starts as soon as the
            # build lands (tens of ms — imperceptible vs a frozen frame).
            def _bg_build(model=model, pattern=pattern, backdrop=backdrop, od=od, num=num):
                try:
                    gift, saved2, b64, name, slug, new_uid = self._build_unique_gift(
                        model, pattern, backdrop, title, num, base_id, base_gift, original_details=od)
                    if not b64:
                        self._upg_busy = False
                        self._toast_ui("сборка не удалась")
                        return

                    def _reveal():
                        played = self._play_native_reveal(sheet, gift)
                        self.log("[upg] reveal=%s num=%d keep=%s" % (played, num, keep))
                        run_on_ui_thread(
                            lambda: self._finish_native_upgrade(reg_uid, b64, name, slug, num, base_id,
                                                                None, None, new_uid=new_uid), 2700)
                    run_on_ui_thread(_reveal)
                except Exception as e:
                    self._upg_busy = False
                    self.log("[upg] build: " + _cause(e))
            import threading
            threading.Thread(target=_bg_build, name="eblannft-upg-build", daemon=True).start()
        except Exception as e:
            self._upg_busy = False
            self.log("[upg] do_upgrade: " + _cause(e))
        return True

    def _match_upgrade_entry(self, saved):
        """Return our upgradable regular entry that this opened gift corresponds to."""
        try:
            inner = _gv(saved, "gift", None)
            if inner is None:
                return None
            if "unique" in str(inner.getClass().getSimpleName()).lower():
                return None
            inner_id = int(_gv(inner, "id", 0) or 0)
            if inner_id <= 0:
                return None
            cache = getattr(self, "_upg_match_cache", None)
            if cache is None:
                cache = self._upg_match_cache = {}
            if inner_id in cache:
                cached = cache[inner_id]
                return cached if cached is not False else None
            for g in self._gifts():
                try:
                    if str(g.get("kind") or g.get("gift_kind") or "") != "regular":
                        continue
                    if int(g.get("base_gift_id") or 0) != inner_id:
                        continue
                    if self._entry_upgradable(g):
                        cache[inner_id] = g
                        return g
                except Exception:
                    continue
            cache[inner_id] = False
        except Exception:
            pass
        return None

    def _play_native_reveal(self, sheet, gift):
        """Replicate StarGiftSheet.applyNewGiftFromUpdates() success path so TG plays
        its OWN upgrade roller animation: rolling=true + savedStarGift.gift→our unique
        + set(saved,list) → roller spins (over the sample_attributes openUpgrade set)
        → switchPage(0). No network — the preview state is already up."""
        try:
            saved = self._jfield(sheet, "savedStarGift")
            if saved is None:
                return "no savedStarGift"
            glist = self._jfield(sheet, "giftsList")
            self._jset(sheet, "rolling", True)
            # swap the gift to our freshly-minted unique + mark it upgraded
            self._jset(saved, "gift", gift)
            try:
                flags = int(_gv(saved, "flags", 0) or 0)
                self._jset(saved, "flags", (flags | 8) & ~2048)
            except Exception:
                pass
            self._jset(saved, "saved_id", 0)
            self._jset(saved, "can_upgrade", False)
            try:
                sheet.set(saved, glist)   # re-render → roller reveal (rolling=true)
            except Exception as e:
                self.log("[upg] set(saved): " + _cause(e))
            self._jset(sheet, "sample_attributes", None)
            self._jset(sheet, "rolling", False)
            try:
                sheet.switchPage(0, True)
            except Exception:
                pass
            return "ok"
        except Exception as e:
            return "err: " + _cause(e)

    def _finish_native_upgrade(self, reg_uid, b64, name, slug, num, base_id, sheet, src=None, new_uid=0):
        try:
            try:
                new_uid = int(new_uid or 0)
            except Exception:
                new_uid = 0
            if new_uid <= 0:
                # fallback only — the upgrade path passes new_uid through, so the freshly
                # built b64 is NOT re-deserialized on the UI thread mid-animation
                try:
                    g2 = self._deserialize_gift(b64)
                    new_uid = int(getattr(g2, "id", 0) or 0)
                except Exception:
                    new_uid = 0
            entry = {"b64": b64, "inject": True, "title": name, "slug": slug,
                     "num": int(num or 1), "unique_id": int(new_uid),
                     "base_gift_id": int(base_id or 0), "gift_kind": "local_upgraded"}
            # carry over От/Дата/Комментарий from the source regular gift so the
            # upgraded NFT keeps the «X отправил(а) Вам этот подарок DD.MM.YY» banner
            if isinstance(src, dict):
                cf = str(src.get("custom_from") or "").strip()
                cd = str(src.get("custom_date") or "").strip()
                cc = str(src.get("custom_comment") or "").strip()
                if cf:
                    entry["custom_from"] = cf
                    uid = self._parse_from_uid(cf)
                    if uid > 0:
                        entry["identity_config"] = {"from_user_id": int(uid)}
                if cd:
                    entry["custom_date"] = cd
                    ts = self._parse_date_ts(cd)
                    if ts > 0:
                        entry["custom_date_ts"] = int(ts)
                if cc:
                    entry["custom_comment"] = cc
            # ONE bridge call: drop the source regular gift + add the NFT in a single
            # atomic write and a single re-inject (the old addGift→removeGift pair did
            # two of each right as the reveal animation settled — the end-of-upgrade hitch)
            self._jvoid("replaceGift", ("long", "str"), (int(reg_uid or 0), json.dumps(entry)))
            self._toast("Улучшено → NFT #%d ✓" % num)
            try:
                if sheet is not None:
                    sheet.dismiss()
            except Exception:
                pass
        except Exception as e:
            self.log("[upg] finish: " + _cause(e))
        finally:
            self._upg_busy = False

    def _deserialize_saved(self, b64):
        """Decode the gift b64 → the full TL_savedStarGift WRAPPER (cached per-b64). BULK
        byte[] conversion — the old per-byte JArr.setByte loop was thousands of JNI calls per
        gift on the UI thread for every render → the «Мои подарки» lag. The wrapper feeds both
        our custom preview AND the native GiftCell.setStarsGift()."""
        try:
            if not b64 or jclass is None:
                return None
            cache = getattr(self, "_gift_saved_cache", None)
            if cache is None:
                cache = {}
                self._gift_saved_cache = cache
            if b64 in cache:
                return cache[b64]
            # the TL classes are looked up once, not per cache miss (a fresh sheet with
            # N never-seen gifts used to do 2·N jclass lookups)
            tl = getattr(self, "_tl_classes", None)
            if tl is None:
                tl = (jclass("org.telegram.tgnet.SerializedData"),
                      jclass("org.telegram.tgnet.tl.TL_stars$TL_savedStarGift"))
                self._tl_classes = tl
            SD = tl[0]
            raw = base64.b64decode(b64)

            def _mk():
                try:
                    return SD(raw)                  # Chaquopy bulk-converts bytes → byte[]
                except Exception:
                    pass
                try:
                    return SD(jarray(jbyte)(raw))   # explicit bulk byte[] (still no per-byte loop)
                except Exception:
                    pass
                # last-resort (slow per-byte) — runs at most once per b64 thanks to the cache
                JByte = jclass("java.lang.Byte").TYPE
                JArr = jclass("java.lang.reflect.Array")
                arr = JArr.newInstance(JByte, len(raw))
                for i, b in enumerate(raw):
                    JArr.setByte(arr, i, b - 256 if b > 127 else b)
                return SD(arr)

            data = _mk()
            Saved = tl[1]
            try:
                ctor = data.readInt32(False)
            except Exception:
                ctor = 0
            obj = None
            try:
                obj = Saved.TLdeserialize(data, ctor, False)
            except Exception:
                obj = None
            if obj is None:
                data = _mk()
                try:
                    data.readInt32(False)
                except Exception:
                    pass
                obj = Saved()
                obj.readParams(data, False)
            if obj is not None:
                # every edit produces a NEW b64 key, so stale wrappers accumulate —
                # bound the cache (dicts are insertion-ordered → drop the oldest)
                while len(cache) >= 256:
                    try:
                        cache.pop(next(iter(cache)))
                    except Exception:
                        cache.clear()
                cache[b64] = obj
            return obj
        except Exception:
            return None

    def _deserialize_gift(self, b64):
        """Inner gift (TL_starGiftUnique) from the cached saved-gift wrapper."""
        obj = self._deserialize_saved(b64)
        if obj is None:
            return None
        try:
            return getattr(obj, "gift", None)
        except Exception:
            return None

    def _argb_signed(self, c):
        v = (0xFF000000 | (int(c) & 0xFFFFFF))
        if v >= 0x80000000:
            v -= 0x100000000
        return int(v)

    def _gift_preview(self, ctx, g):
        wrap = FrameLayout(ctx)
        gd = GradientDrawable()
        gd.setCornerRadius(AndroidUtilities.dp(14))
        gd.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
        wrap.setBackground(gd)

        gift = None
        try:
            gift = self._deserialize_gift(g.get("b64"))
        except Exception:
            gift = None
        if gift is None:
            return wrap

        center = edge = patc = None
        pattern_doc = model_doc = None
        try:
            attrs = getattr(gift, "attributes", None)
            n = int(attrs.size()) if attrs is not None else 0
            for i in range(n):
                a = attrs.get(i)
                if a is None:
                    continue
                cls = str(a.getClass().getSimpleName()).lower()
                if "backdrop" in cls:
                    try: center = self._argb_signed(getattr(a, "center_color", 0) or 0)
                    except Exception: pass
                    try: edge = self._argb_signed(getattr(a, "edge_color", 0) or 0)
                    except Exception: pass
                    try: patc = self._argb_signed(getattr(a, "pattern_color", 0) or 0)
                    except Exception: pass
                elif "model" in cls:
                    model_doc = getattr(a, "document", None)
                elif "pattern" in cls or "symbol" in cls:
                    pattern_doc = getattr(a, "document", None)
        except Exception:
            pass
        if model_doc is None:
            model_doc = getattr(gift, "sticker", None)
        # regular gifts have no backdrop/pattern → render the sticker bigger so it
        # fills the square evenly (matches the look of NFT previews)
        has_backdrop = center is not None and edge is not None

        # 1) backdrop radial gradient
        if center is not None and edge is not None and jarray is not None:
            try:
                grad = GradientDrawable()
                grad.setShape(GradientDrawable.RECTANGLE)
                grad.setCornerRadius(AndroidUtilities.dp(14))
                grad.setGradientType(GradientDrawable.RADIAL_GRADIENT)
                try: grad.setGradientCenter(0.5, 0.5)
                except Exception: pass
                grad.setGradientRadius(AndroidUtilities.dp(64))
                grad.setColors(jarray(jint)([center, edge]))
                wrap.setBackground(grad)
            except Exception:
                pass

        # 2) scattered pattern symbols
        if pattern_doc is not None and BackupImageView is not None and ImageLocation is not None:
            pc = patc if patc is not None else self._argb_signed(0x66FFFFFF)
            positions = (
                (Gravity.LEFT | Gravity.TOP, 4, 4, 14),
                (Gravity.RIGHT | Gravity.TOP, 4, 4, 14),
                (Gravity.LEFT | Gravity.BOTTOM, 4, 4, 14),
                (Gravity.RIGHT | Gravity.BOTTOM, 4, 4, 14),
                (Gravity.CENTER_HORIZONTAL | Gravity.TOP, 0, 2, 12),
                (Gravity.CENTER_HORIZONTAL | Gravity.BOTTOM, 0, 2, 12),
                (Gravity.LEFT | Gravity.CENTER_VERTICAL, 2, 0, 12),
                (Gravity.RIGHT | Gravity.CENTER_VERTICAL, 2, 0, 12),
            )
            for grav, mx, my, sz in positions:
                try:
                    piv = BackupImageView(ctx)
                    loc = ImageLocation.getForDocument(pattern_doc)
                    if loc is None:
                        continue
                    piv.setImage(loc, f"{sz}_{sz}", None, 0, pattern_doc)
                    try: piv.setColorFilter(pc)
                    except Exception: pass
                    try: piv.setAlpha(0.5)
                    except Exception: pass
                    lp = FrameLayout.LayoutParams(AndroidUtilities.dp(sz), AndroidUtilities.dp(sz), grav)
                    lp.leftMargin = lp.rightMargin = AndroidUtilities.dp(mx)
                    lp.topMargin = lp.bottomMargin = AndroidUtilities.dp(my)
                    wrap.addView(piv, lp)
                except Exception:
                    continue

        # 3) centered model sticker
        if model_doc is not None and BackupImageView is not None and ImageLocation is not None:
            try:
                img = BackupImageView(ctx)
                try: img.setRoundRadius(AndroidUtilities.dp(30))
                except Exception: pass
                loc = ImageLocation.getForDocument(model_doc)
                if loc is not None:
                    img.setImage(loc, "64_64", None, 0, model_doc)
                try: img.startAnimation()
                except Exception: pass
                sz = AndroidUtilities.dp(64 if has_backdrop else 84)
                wrap.addView(img, FrameLayout.LayoutParams(sz, sz, Gravity.CENTER))
            except Exception:
                pass
        return wrap

    def _pill(self, ctx, text, color, on_click):
        tv = TextView(ctx)
        tv.setText(text)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        tv.setTextColor(color)
        tv.setGravity(Gravity.CENTER)
        bg = GradientDrawable()
        bg.setCornerRadius(AndroidUtilities.dp(22))
        try:
            base = color & 0xFFFFFF
            bg.setColor(0x22000000 | base)
        except Exception:
            bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
        tv.setBackground(self._ripple_bg(bg, color))
        try: tv.setElevation(float(AndroidUtilities.dp(1)))
        except Exception: pass
        tv.setOnClickListener(self._click(on_click))
        return tv

    # ---- Local gift crafting, rendered by Telegram's native CraftTopView ----
    def _craft_entry_id(self, entry):
        try:
            return int(entry.get("unique_id") or entry.get("saved_id") or 0)
        except Exception:
            return 0

    def _craft_base_id(self, entry):
        try:
            base_id = int(entry.get("base_gift_id") or 0)
        except Exception:
            base_id = 0
        if base_id <= 0:
            try:
                gift = self._deserialize_gift(entry.get("b64"))
                base_id = int(getattr(gift, "gift_id", 0) or 0)
            except Exception:
                base_id = 0
        return base_id

    def _craft_candidates(self, seed):
        """All locally owned collectibles from the seed's underlying collection."""
        base_id = self._craft_base_id(seed)
        if base_id <= 0:
            return []
        seed_id = self._craft_entry_id(seed)
        rows = []
        seen = set()
        ordered = [seed] + [x for x in self._gifts() if self._craft_entry_id(x) != seed_id]
        for entry in ordered:
            eid = self._craft_entry_id(entry)
            if eid <= 0 or eid in seen or self._craft_base_id(entry) != base_id:
                continue
            resale = entry.get("resale_config") or {}
            try: on_sale = int(resale.get("stars") or 0) > 0 or int(resale.get("nanoton") or 0) > 0
            except Exception: on_sale = False
            if bool(entry.get("crafted")) or str(entry.get("ton_address") or "").strip() or on_sale:
                continue
            gift = self._deserialize_gift(entry.get("b64"))
            if gift is None:
                continue
            try:
                import time as _time
                if bool(_gv(gift, "crafted", False)) or bool(_gv(gift, "burned", False)):
                    continue
                if str(_gv(gift, "gift_address", "") or "").strip():
                    continue
                if int(_gv(gift, "locked_until_date", 0) or 0) > int(_time.time()):
                    continue
            except Exception:
                continue
            chance = self._local_craft_chance(gift)
            self._jset(gift, "craft_chance_permille", chance)
            seen.add(eid)
            rows.append((entry, gift))
        return rows

    def _local_craft_chance(self, gift):
        """Telegram uses permille (250 = 25%, 1000 = 100%), never 10000."""
        try:
            chance = int(_gv(gift, "craft_chance_permille", 0) or 0)
        except Exception:
            chance = 0
        # Preserve a real server-provided chance. Locally constructed gifts have
        # no server value, so use Telegram's common 25% ingredient contribution.
        if 1 <= chance <= 1000:
            return chance
        return 250

    def _craft_selected_ids(self, craft_view):
        out = set()
        try:
            slots = self._jfield(craft_view, "gifts")
            for i in range(len(slots)):
                try:
                    gift = slots[i].getGift()
                    gid = int(getattr(gift, "id", 0) or 0) if gift is not None else 0
                    if gid > 0:
                        out.add(gid)
                except Exception:
                    pass
        except Exception:
            pass
        return out

    def _open_local_craft_picker(self, callback, candidates, craft_view):
        """Open a local-only ingredient picker without starting Telegram loaders."""
        try:
            selected = self._craft_selected_ids(craft_view)
            live_ids = set(self._craft_entry_id(e) for e in self._gifts())
            available = [(e, g) for e, g in candidates
                         if self._craft_entry_id(e) in live_ids and self._craft_entry_id(e) not in selected]
            if not available:
                self._toast("Все подходящие подарки уже выбраны")
                return
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None:
                return
            scroll = ScrollView(ctx)
            col = LinearLayout(ctx)
            col.setOrientation(LinearLayout.VERTICAL)
            pad = AndroidUtilities.dp(14)
            col.setPadding(pad, pad, pad, AndroidUtilities.dp(24))

            heading = TextView(ctx)
            heading.setText("Выберите подарок для крафта")
            heading.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            heading.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            try: heading.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            col.addView(heading, LinearLayout.LayoutParams(-1, -2))

            subtitle = TextView(ctx)
            subtitle.setText("Доступно: %d · локальный список" % len(available))
            subtitle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            subtitle.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            slp = LinearLayout.LayoutParams(-1, -2)
            slp.topMargin = AndroidUtilities.dp(3)
            slp.bottomMargin = AndroidUtilities.dp(10)
            col.addView(subtitle, slp)

            builder = BottomSheet.Builder(ctx)
            picker_ref = [None]
            click_refs = []
            plugin = self

            def _choose(entry, gift):
                try:
                    eid = plugin._craft_entry_id(entry)
                    current = set(plugin._craft_entry_id(x) for x in plugin._gifts())
                    if eid not in current:
                        plugin._toast("Подарок уже недоступен")
                        return
                    callback.run(gift)
                    if picker_ref[0] is not None:
                        picker_ref[0].dismiss()
                except Exception as e:
                    plugin.log("[craft] local select: " + _cause(e))
                    plugin._toast("Не удалось выбрать подарок")

            for entry, gift in available:
                row = LinearLayout(ctx)
                row.setOrientation(LinearLayout.HORIZONTAL)
                row.setGravity(Gravity.CENTER_VERTICAL)
                row.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(8),
                               AndroidUtilities.dp(10), AndroidUtilities.dp(8))
                bg = GradientDrawable()
                bg.setCornerRadius(float(AndroidUtilities.dp(14)))
                bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                row.setBackground(self._ripple_bg(
                    bg, Theme.getColor(Theme.key_featuredStickers_addButton)))

                preview = self._gift_preview(ctx, entry)
                row.addView(preview, LinearLayout.LayoutParams(
                    AndroidUtilities.dp(58), AndroidUtilities.dp(58)))

                texts = LinearLayout(ctx)
                texts.setOrientation(LinearLayout.VERTICAL)
                title = TextView(ctx)
                name = str(entry.get("title") or _gv(gift, "title", None) or "Подарок")
                try: num = int(entry.get("num") or _gv(gift, "num", 0) or 0)
                except Exception: num = 0
                title.setText(name + ((" #%d" % num) if num > 0 else ""))
                title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                try: title.setTypeface(AndroidUtilities.bold())
                except Exception: pass
                texts.addView(title, LinearLayout.LayoutParams(-1, -2))
                chance = TextView(ctx)
                chance.setText("Шанс ингредиента: %d%%" %
                               (self._local_craft_chance(gift) // 10))
                chance.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                chance.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
                texts.addView(chance, LinearLayout.LayoutParams(-1, -2))
                tlp = LinearLayout.LayoutParams(0, -2, 1.0)
                tlp.leftMargin = AndroidUtilities.dp(12)
                row.addView(texts, tlp)

                listener = self._click(lambda v, e=entry, g=gift: _choose(e, g))
                click_refs.append(listener)
                row.setOnClickListener(listener)
                rlp = LinearLayout.LayoutParams(-1, -2)
                rlp.topMargin = AndroidUtilities.dp(7)
                col.addView(row, rlp)

            scroll.addView(col)
            builder.setCustomView(scroll)
            picker = builder.create()
            picker_ref[0] = picker
            self._craft_refs.extend([picker, picker_ref, click_refs, available])
            self._show_sheet_animated(picker, scroll)
        except Exception as e:
            self.log("[craft] picker: " + _cause(e))
            self._toast("Не удалось открыть выбор подарков")

    def _open_local_crafting(self, seed, origin_sheet=None):
        try:
            self._close_gift_detail(animated=True)
            if not self._craft_entry_eligible(seed, origin_sheet, resolve=False):
                self._toast("Эта коллекция не поддерживает крафт")
                return
            candidates = self._craft_candidates(seed)
            if not candidates:
                self._toast("Для этого подарка крафт недоступен")
                return
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None:
                self._toast("Нет контекста для крафта")
                return
            rp = None
            try: rp = frag.getResourceProvider()
            except Exception: pass
            CraftTopView = jclass("org.telegram.ui.Stars.StarGiftSheet$CraftTopView")
            craft = CraftTopView(ctx, rp)
            base_id = self._craft_base_id(seed)
            first_gift = candidates[0][1]
            document = None
            try: document = first_gift.getDocument()
            except Exception: pass
            if document is None:
                try: document = getattr(first_gift, "document", None) or getattr(first_gift, "sticker", None)
                except Exception: pass
            title = str(seed.get("title") or getattr(first_gift, "title", "NFT") or "NFT")
            craft.setup(_selected_account(), int(base_id), document, title)
            self._jset(first_gift, "craft_chance_permille", self._local_craft_chance(first_gift))
            craft.selectGift(first_gift)

            sheet = BottomSheet(ctx, False, rp)
            sheet.setCustomView(craft)
            try: sheet.setCanDismissWithSwipe(False)
            except Exception: pass
            plugin = self
            Callback3 = jclass("org.telegram.messenger.Utilities$Callback3")
            Callback2 = jclass("org.telegram.messenger.Utilities$Callback2")
            Runnable = jclass("java.lang.Runnable")

            class _OnCraft(dynamic_proxy(Callback3)):
                def run(self2, selected, success, failure):
                    plugin._perform_local_craft(base_id, candidates, selected, success, failure, sheet, origin_sheet)

            class _OnAdd(dynamic_proxy(Callback2)):
                def run(self2, callback, will_be_first):
                    plugin._open_local_craft_picker(callback, candidates, craft)

            class _OnClose(dynamic_proxy(Runnable)):
                def run(self2):
                    try: sheet.dismiss()
                    except Exception: pass

            on_craft, on_add, on_close = _OnCraft(), _OnAdd(), _OnClose()
            craft.setOnCraft(on_craft)
            craft.setOnAddGift(on_add)
            craft.setOnClose(on_close)
            self._craft_sheet = sheet
            self._craft_view = craft
            self._craft_refs = [candidates, on_craft, on_add, on_close]
            sheet.show()
        except Exception as e:
            self._toast("Крафт: " + repr(e)[:140])
            self.log("[craft] open: " + _cause(e))

    def _perform_local_craft(self, base_id, candidates, selected, success_cb, failure_cb, sheet, origin_sheet=None):
        """Build first, then atomically burn 1..4 inputs and insert the result."""
        try:
            by_id = {self._craft_entry_id(e): (e, g) for e, g in candidates}
            picked = []
            used = set()
            n = int(selected.size()) if selected is not None else 0
            for i in range(min(n, 4)):
                gift = selected.get(i)
                gid = int(getattr(gift, "id", 0) or 0)
                if gid in by_id and gid not in used:
                    used.add(gid)
                    picked.append((gid, by_id[gid][0], gift))
            if not picked:
                raise ValueError("не выбраны подарки")
            ingredient_ids = [x[0] for x in picked]
            first_id = ingredient_ids[0]
            plugin = self

            # Telegram sums craft_chance_permille from all selected gifts. 1000
            # permille is 100%; a failed attempt burns every selected ingredient.
            import random as _craft_random
            total_chance = min(1000, sum(self._local_craft_chance(x[2]) for x in picked))
            if _craft_random.randrange(1000) >= total_chance:
                result = self._jvoid("removeGifts", ("str",), (json.dumps(ingredient_ids),))
                if result is None or "FAIL" in str(result):
                    raise ValueError(str(result or "ошибка списания подарков"))
                # A null result is Telegram's native unsuccessful-craft path:
                # the cube animation finishes on the failure state.
                success_cb.run(None, None)
                if origin_sheet is None:
                    self._refresh_gifts_sheet(delay=5200)
                return

            def _attrs(models, patterns, backdrops, raw=None):
                try:
                    import random as _random
                    crafted_models = [m for m in models if bool(getattr(m, "crafted", False))]
                    if not crafted_models or not patterns or not backdrops:
                        raise ValueError("атрибуты крафта недоступны")
                    model = _random.choice(crafted_models)
                    pattern = _random.choice(list(patterns))
                    backdrop = _random.choice(list(backdrops))
                    try: plugin._jset(model, "crafted", True)
                    except Exception: pass
                    base_gift = plugin._find_base_gift(base_id)
                    title = str(picked[0][1].get("title") or getattr(picked[0][2], "title", "NFT") or "NFT")
                    num = _random.randint(1, 999999)
                    gift, saved, b64, name, slug, uid = plugin._build_unique_gift(
                        model, pattern, backdrop, title, num, base_id, base_gift,
                        forced_uid=first_id, crafted=True)
                    if not b64 or gift is None:
                        raise ValueError("не удалось собрать результат")
                    import time as _time
                    entry = {"b64": b64, "inject": True, "title": name, "slug": slug,
                             "num": int(num), "unique_id": int(first_id), "saved_id": int(first_id),
                             "base_gift_id": int(base_id), "gift_kind": "local_crafted",
                             "crafted": True, "created_at": int(_time.time())}
                    result = plugin._jvoid("craftGifts", ("str", "str"),
                                           (json.dumps(ingredient_ids), json.dumps(entry)))
                    if result is None or "FAIL" in str(result) or "not found" in str(result):
                        raise ValueError(str(result or "ошибка сохранения"))

                    class _OpenResult(dynamic_proxy(jclass("java.lang.Runnable"))):
                        def run(self2):
                            try: sheet.dismiss()
                            except Exception: pass
                            if origin_sheet is not None:
                                try: origin_sheet.dismiss()
                                except Exception: pass
                                plugin._open_my_gifts()
                            else:
                                plugin._refresh_gifts_sheet(delay=120)
                            plugin._toast("Крафт завершён ✓")
                    open_result = _OpenResult()
                    plugin._craft_refs.append(open_result)
                    success_cb.run(gift, open_result)
                    # The native reveal runs for several seconds; refresh the inventory
                    # underneath it without closing or interrupting the animation.
                    if origin_sheet is None:
                        plugin._refresh_gifts_sheet(delay=5200)
                except Exception as e:
                    plugin.log("[craft] finish: " + _cause(e))
                    try: failure_cb.run()
                    except Exception: pass
                    plugin._toast("Крафт не выполнен: " + str(e)[:100])

            self._fetch_upgrade_attrs(base_id, _attrs)
        except Exception as e:
            self.log("[craft] start: " + _cause(e))
            try: failure_cb.run()
            except Exception: pass
            self._toast("Крафт: " + str(e)[:100])

    def _on_add_gift(self):
        # let the user pick which catalog to open
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None or AlertDialogBuilder is None:
                self._open_catalog(True)
                return
            b = AlertDialogBuilder(ctx)
            b.set_title("Добавить подарок")
            items = ["NFT подарок (конструктор)", "Обычный подарок"]

            def _pick(dlg, idx):
                try: dlg.dismiss()
                except Exception: pass
                self._open_catalog(idx == 0)
            b.set_items(items, _pick)
            b.set_negative_button("Отмена", None)
            run_on_ui_thread(b.show)
        except Exception:
            self._open_catalog(True)

    # ---- Каталог NFT (114 базовых подарков из StarsController) ----
    def _stars_ctrl(self):
        try:
            acc = _selected_account()
            return jclass("org.telegram.ui.Stars.StarsController").getInstance(acc)
        except Exception:
            return None

    def _catalog_list(self):
        try:
            ctrl = self._stars_ctrl()
            if ctrl is None:
                return []
            for f in ctrl.getClass().getDeclaredFields():
                try:
                    f.setAccessible(True)
                    val = f.get(ctrl)
                except Exception:
                    continue
                if val is None:
                    continue
                try:
                    if "ArrayList" not in str(val.getClass().getName()):
                        continue
                    n = int(val.size())
                    if n <= 0:
                        continue
                    first = val.get(0)
                    fn = str(first.getClass().getName()).lower()
                    if "stargift" in fn and "saved" not in fn:
                        return [val.get(i) for i in range(n)]
                except Exception:
                    continue
        except Exception:
            pass
        return []

    def _is_upgradable(self, g):
        """NFT-able gift: has available upgrades (upgrade_stars > 0) or is already unique."""
        try:
            upg = int(getattr(g, "upgrade_stars", 0) or 0)
            if upg > 0:
                return True
        except Exception:
            pass
        try:
            if "unique" in str(g.getClass().getName()).lower():
                return True
        except Exception:
            pass
        return False

    def _catalog_items(self, nft_only):
        """Regular catalog = every gift; NFT catalog = only upgradable ones.
        Both are sorted by FLOOR (min-resale) price DESC so the priciest sit on top
        — owner wants «вверху самые дорогие по флору» (not by the base buy price)."""
        gifts = self._catalog_list()
        out = gifts if not nft_only else [g for g in gifts if self._is_upgradable(g)]
        try:
            out = sorted(out, key=lambda g: -int(self._get_gift_floor_stars(g) or 0))
        except Exception:
            try:
                out = sorted(out, key=lambda g: -int(_gv(g, "stars", 0) or 0))
            except Exception:
                pass
        return out

    def _to_int(self, v, default=0):
        try:
            if v is None:
                return default
            return int(v)
        except Exception:
            try:
                return int(float(str(v)))
            except Exception:
                return default

    def _get_gift_floor_stars(self, gift):
        """Resolve the current floor / min-resale price (in stars) for a catalog gift,
        for the priciest-first sort. Mirrors eblannft2.plugin._get_gift_floor_stars."""
        if gift is None:
            return 0
        for name in ("resell_min_stars", "min_resell_stars", "floor_stars",
                     "floor_price_stars", "min_floor_stars", "min_resale_stars",
                     "resellMinStars", "floorStars", "floorPriceStars"):
            n = self._to_int(_gv(gift, name, None), 0)
            if n > 0:
                return n
        # scan numeric fields whose name smells like a floor / resell-min price
        try:
            for f in gift.getClass().getFields():
                try:
                    tn = f.getType().getName()
                    if tn not in ("int", "long"):
                        continue
                    nm = f.getName().lower()
                    if ("floor" not in nm) and ("resell" not in nm):
                        continue
                    if ("min" not in nm) and ("floor" not in nm):
                        continue
                    try:
                        val = f.getLong(gift) if tn == "long" else f.getInt(gift)
                    except Exception:
                        val = self._to_int(f.get(gift), 0)
                    if int(val) > 0:
                        return int(val)
                except Exception:
                    continue
        except Exception:
            pass
        # ask StarsController for a floor (cached per gift id)
        try:
            gid = self._to_int(_gv(gift, "id", 0), 0)
            if gid > 0:
                cache = getattr(self, "_market_floor_cache", None)
                if cache is None:
                    cache = {}
                    self._market_floor_cache = cache
                cached = cache.get(gid)
                if cached and int(cached) > 0:
                    return int(cached)
                floor2 = self._get_floor_from_stars_controller(gid)
                if floor2 > 0:
                    cache[gid] = int(floor2)
                    return int(floor2)
        except Exception:
            pass
        # last resort: the base buy price, so the sort is at least stable
        return self._to_int(_gv(gift, "stars", 0), 0)

    def _get_floor_from_stars_controller(self, gift_id):
        """Best-effort: call a StarsController method that returns floor/min-resale
        stars for a gift id (method name resolved once by reflection + cached)."""
        gid = self._to_int(gift_id, 0)
        if gid <= 0:
            return 0
        ctrl = self._stars_ctrl()
        if ctrl is None:
            return 0
        if not getattr(self, "_market_floor_method_checked", False):
            self._market_floor_method_checked = True
            best, best_score = None, -1
            try:
                for m in ctrl.getClass().getDeclaredMethods():
                    try:
                        if m.getReturnType().getName() not in ("int", "long"):
                            continue
                        params = m.getParameterTypes()
                        if len(params) != 1:
                            continue
                        if params[0].getName() not in ("int", "long",
                                                       "java.lang.Integer", "java.lang.Long"):
                            continue
                        nm = m.getName().lower()
                        if ("floor" not in nm) and ("resell" not in nm) and ("resale" not in nm):
                            continue
                        score = 0
                        if "floor" in nm:
                            score += 3
                        if "resell" in nm or "resale" in nm:
                            score += 2
                        if "min" in nm:
                            score += 2
                        if "stars" in nm:
                            score += 1
                        if score > best_score:
                            best_score, best = score, m
                    except Exception:
                        continue
            except Exception:
                best = None
            if best is not None:
                try:
                    best.setAccessible(True)
                except Exception:
                    pass
                try:
                    self.log("[cat] floor method: " + best.getName())
                except Exception:
                    pass
            self._market_floor_method = best
        m = getattr(self, "_market_floor_method", None)
        if m is None:
            return 0
        try:
            p0 = m.getParameterTypes()[0].getName()
            if p0 in ("long", "java.lang.Long"):
                res = m.invoke(ctrl, JLong(gid))
            else:
                res = m.invoke(ctrl, JInteger(gid))
            return self._to_int(res, 0)
        except Exception:
            return 0

    def _unsell(self, g):
        """Hide the «продан»/sold-out ribbon on a catalog cell (data-driven)."""
        try:
            self._jset(g, "sold_out", False)
        except Exception:
            pass
        try:
            total = int(getattr(g, "availability_total", 0) or 0)
        except Exception:
            total = 0
        try:
            remains = int(getattr(g, "availability_remains", 0) or 0)
        except Exception:
            remains = 0
        if remains <= 0:
            self._jset(g, "availability_remains", total if total > 0 else 1)

    def _star_balance(self):
        try:
            ctrl = self._stars_ctrl()
            bal = getattr(ctrl, "balance", None)
            if bal is None:
                return ""
            amt = getattr(bal, "amount", None)
            if amt is None:
                amt = bal
            return str(int(amt))
        except Exception:
            return ""

    def _install_catalog_hooks(self):
        """Lazily hook ResaleGiftsFragment.updateList/fillItems/onItemClick (cold path:
        these only fire while the catalog fragment is open — the profile is untouched)."""
        if getattr(self, "_cat_hooks_done", False):
            return True
        if MethodHook is None or getattr(self, "hook_method", None) is None:
            return False
        try:
            Frag = JavaClass.forName("org.telegram.ui.Gifts.ResaleGiftsFragment")
        except Exception as e:
            self.log("[cat] no ResaleGiftsFragment: " + _cause(e))
            return False
        refs = []
        try:
            for m in Frag.getDeclaredMethods():
                try:
                    nm = m.getName()
                except Exception:
                    continue
                try:
                    m.setAccessible(True)
                except Exception:
                    pass
                if nm == "updateList":
                    refs.append(self.hook_method(m, _CatUpdateHook(self)))
                elif nm == "fillItems":
                    refs.append(self.hook_method(m, _CatFillHook(self)))
                elif nm == "onItemClick":
                    refs.append(self.hook_method(m, _CatClickHook(self)))
        except Exception as e:
            self.log("[cat] hook err: " + _cause(e))
            return False
        self._cat_hook_refs = refs
        self._cat_hooks_done = True
        self.log("[cat] native hooks installed: " + str(len(refs)))
        return True

    def _open_catalog(self, nft_only=True):
        if jclass is None:
            return
        # kill any live auto-price loop from a previous constructor so it can't tick on a
        # dismissed sheet's views while the catalog is open
        try:
            self._ctor_value_loop_gen = getattr(self, "_ctor_value_loop_gen", 0) + 1
            self._nat_sheet = None
        except Exception:
            pass
        # close the «Мои подарки» sheet so the catalog fragment is on top
        for _attr in ("_gifts_sheet", "_catalog_sheet", "_nat_sheet"):
            try:
                s = getattr(self, _attr, None)
                if s is not None:
                    s.dismiss()
                    setattr(self, _attr, None)
            except Exception:
                pass
        # preload base gifts so the first frame isn't empty
        try:
            if not self._catalog_list():
                c = self._stars_ctrl()
                if c is not None:
                    c.loadStarGifts()
        except Exception:
            pass
        if self._install_catalog_hooks():
            try:
                self._cat_ctrl = None
                _NativeCatalog(self, nft_only=nft_only).show()
                return
            except Exception as e:
                self.log("[cat] native open failed, fallback: " + _cause(e))
        # fallback: homemade BottomSheet grid
        frag = get_last_fragment()
        ctx = frag.getParentActivity() if frag else None
        if not ctx:
            return
        gifts = self._catalog_list()
        if not gifts:
            self._toast("загружаю каталог…")
            run_on_ui_thread(lambda: self._open_catalog2(ctx), 1800)
            return
        run_on_ui_thread(lambda: self._show_catalog(ctx, gifts))

    def _open_catalog2(self, ctx):
        gifts = self._catalog_list()
        if not gifts:
            self._toast("Каталог пуст — открой профиль с подарками и попробуй снова")
            return
        self._show_catalog(ctx, gifts)

    def _show_catalog(self, ctx, gifts):
        try:
            scroll = ScrollView(ctx)
            col = LinearLayout(ctx)
            col.setOrientation(LinearLayout.VERTICAL)
            p = AndroidUtilities.dp(12)
            col.setPadding(p, p, p, AndroidUtilities.dp(20))

            head = LinearLayout(ctx)
            head.setOrientation(LinearLayout.HORIZONTAL)
            head.setGravity(Gravity.CENTER_VERTICAL)
            ttl = TextView(ctx)
            ttl.setText("Каталог NFT  ·  " + str(len(gifts)))
            ttl.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            ttl.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            try: ttl.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            head.addView(ttl, LinearLayout.LayoutParams(0, -2, 1.0))
            bal = TextView(ctx)
            bal.setText("★ " + (self._star_balance() or "—"))
            bal.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            head.addView(bal, LinearLayout.LayoutParams(-2, -2))
            hlp = LinearLayout.LayoutParams(-1, -2)
            hlp.bottomMargin = AndroidUtilities.dp(10)
            col.addView(head, hlp)

            rowv = None
            for i, g in enumerate(gifts):
                if i % 3 == 0:
                    rowv = LinearLayout(ctx)
                    rowv.setOrientation(LinearLayout.HORIZONTAL)
                    glp = LinearLayout.LayoutParams(-1, -2)
                    glp.topMargin = AndroidUtilities.dp(8)
                    col.addView(rowv, glp)
                cell = self._catalog_cell(ctx, g)
                clp = LinearLayout.LayoutParams(0, -2, 1.0)
                clp.rightMargin = AndroidUtilities.dp(6) if (i % 3 != 2) else 0
                rowv.addView(cell, clp)

            scroll.addView(col)
            b = BottomSheet.Builder(ctx)
            b.setCustomView(scroll)
            self._catalog_sheet = b.create()
            self._show_sheet_animated(self._catalog_sheet, scroll)
        except Exception as e:
            self._toast("каталог: " + repr(e)[:140])

    def _catalog_cell(self, ctx, g):
        card = LinearLayout(ctx)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setGravity(Gravity.CENTER_HORIZONTAL)
        bg = GradientDrawable()
        bg.setCornerRadius(AndroidUtilities.dp(12))
        bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
        card.setBackground(self._ripple_bg(bg, Theme.getColor(Theme.key_featuredStickers_addButton)))
        try: card.setElevation(float(AndroidUtilities.dp(1)))
        except Exception: pass
        card.setPadding(AndroidUtilities.dp(6), AndroidUtilities.dp(10), AndroidUtilities.dp(6), AndroidUtilities.dp(8))

        # sticker
        thumb = FrameLayout(ctx)
        try:
            doc = getattr(g, "sticker", None)
            if doc is not None and BackupImageView is not None and ImageLocation is not None:
                img = BackupImageView(ctx)
                loc = ImageLocation.getForDocument(doc)
                if loc is not None:
                    img.setImage(loc, "72_72", None, 0, doc)
                try: img.startAnimation()
                except Exception: pass
                thumb.addView(img, FrameLayout.LayoutParams(AndroidUtilities.dp(64), AndroidUtilities.dp(64), Gravity.CENTER))
        except Exception:
            pass
        card.addView(thumb, LinearLayout.LayoutParams(AndroidUtilities.dp(64), AndroidUtilities.dp(64)))

        # price chip
        price = 0
        try:
            price = int(getattr(g, "stars", 0) or 0)
        except Exception:
            price = 0
        pchip = TextView(ctx)
        pchip.setText("★ " + (str(price) if price else "—"))
        pchip.setGravity(Gravity.CENTER)
        pchip.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
        pchip.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        pbg = GradientDrawable()
        pbg.setCornerRadius(AndroidUtilities.dp(12))
        pbg.setColor(Theme.getColor(Theme.key_dialogBackground))
        pchip.setBackground(pbg)
        pchip.setPadding(AndroidUtilities.dp(10), AndroidUtilities.dp(5), AndroidUtilities.dp(10), AndroidUtilities.dp(5))
        plp = LinearLayout.LayoutParams(-2, -2)
        plp.topMargin = AndroidUtilities.dp(8)
        card.addView(pchip, plp)

        gid = 0
        try:
            gid = int(getattr(g, "id", 0) or 0)
        except Exception:
            gid = 0
        card.setOnClickListener(self._click(lambda v, x=gid: self._catalog_pick(x)))

        # «продан» corner ribbon overlay
        wrap = FrameLayout(ctx)
        wrap.addView(card, FrameLayout.LayoutParams(-1, -2))
        rib = TextView(ctx)
        rib.setText("продан")
        rib.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 9)
        rib.setTextColor(self._argb_signed(0xFFFFFF))
        rib.setPadding(AndroidUtilities.dp(9), AndroidUtilities.dp(2), AndroidUtilities.dp(9), AndroidUtilities.dp(2))
        rbg = GradientDrawable()
        rbg.setColor(self._argb_signed(0xB8860B))
        rbg.setCornerRadius(AndroidUtilities.dp(6))
        rib.setBackground(rbg)
        rlp = FrameLayout.LayoutParams(-2, -2, Gravity.RIGHT | Gravity.TOP)
        rlp.rightMargin = AndroidUtilities.dp(4)
        rlp.topMargin = AndroidUtilities.dp(4)
        wrap.addView(rib, rlp)
        return wrap

    def _catalog_pick(self, gift_id, base_gift=None, base_title=""):
        if gift_id <= 0:
            self._toast("нет id подарка")
            return
        self._ctor_edit_id = 0   # adding a NEW gift from the catalog
        try:
            if getattr(self, "_catalog_sheet", None) is not None:
                self._catalog_sheet.dismiss()
        except Exception:
            pass
        if base_gift is None:
            base_gift = self._find_base_gift(gift_id)
        title = str(base_title or "").strip()
        if not title and base_gift is not None:
            try:
                title = str(getattr(base_gift, "title", "") or "").strip()
            except Exception:
                title = ""
        title = title or "NFT"
        self._toast("загружаю атрибуты…")

        def _on(models, patterns, backdrops, raw):
            if raw is not None and int(getattr(raw, "size", lambda: 0)()) > 0:
                self._show_native_constructor(gift_id, title, 1, raw, base_gift=base_gift)
            elif (models or patterns or backdrops):
                self._show_constructor_grid(None, models, patterns, backdrops, base_gift_id=gift_id)
            else:
                self._toast("Атрибуты не пришли")
        self._fetch_upgrade_attrs(gift_id, _on)

    # ---- NFT constructor (pick Model/Symbol/Backdrop, build + serialize, save) ----
    def _attr_pools(self):
        """Collect unique model/pattern/backdrop attribute objects from the library."""
        models, patterns, backdrops = {}, {}, {}
        for g in self._gifts():
            try:
                gift = self._deserialize_gift(g.get("b64"))
                if gift is None:
                    continue
                attrs = getattr(gift, "attributes", None)
                if attrs is None:
                    continue
                for i in range(int(attrs.size())):
                    a = attrs.get(i)
                    if a is None:
                        continue
                    cls = str(a.getClass().getSimpleName()).lower()
                    name = str(getattr(a, "name", "") or "")
                    if not name:
                        continue
                    if "model" in cls:
                        models[name] = a
                    elif "backdrop" in cls:
                        backdrops[name] = a
                    elif "pattern" in cls or "symbol" in cls:
                        patterns[name] = a
            except Exception:
                continue
        return models, patterns, backdrops

    def _make_original_details(self, od):
        """Build a TL_starGiftAttributeOriginalDetails so the upgraded NFT shows the
        native «Подарок от X для Y, отправлен DATE с комментарием Z» row."""
        try:
            OD = None
            for cn in ("org.telegram.tgnet.tl.TL_stars$TL_starGiftAttributeOriginalDetails",
                       "org.telegram.tgnet.tl.TL_stars$starGiftAttributeOriginalDetails"):
                try:
                    OD = jclass(cn); break
                except Exception:
                    continue
            if OD is None:
                return None
            attr = OD()
            PeerUser = jclass("org.telegram.tgnet.TLRPC$TL_peerUser")
            flags = 0
            suid = int(od.get("sender_uid") or 0)
            if suid > 0:
                sp = PeerUser(); sp.user_id = suid
                self._jset(attr, "sender_id", sp)
                flags |= 1
            ruid = int(od.get("recipient_uid") or 0)
            if ruid > 0:
                rp = PeerUser(); rp.user_id = ruid
                self._jset(attr, "recipient_id", rp)
            self._jset(attr, "date", int(od.get("date_ts") or 0))
            cc = str(od.get("comment") or "").strip()
            if cc:
                TwE = jclass("org.telegram.tgnet.TLRPC$TL_textWithEntities")
                twe = TwE()
                self._jset(twe, "text", cc)
                try:
                    twe.entities = jclass("java.util.ArrayList")()
                except Exception:
                    pass
                self._jset(attr, "message", twe)
                flags |= 2
            self._jset(attr, "flags", flags)
            return attr
        except Exception as e:
            try: self.log("[upg] origDetails: " + _cause(e))
            except Exception: pass
            return None

    def _build_unique_gift(self, model_a, pattern_a, backdrop_a, title, num, base_gift_id=0, base_gift=None,
                           original_details=None, forced_uid=0, crafted=False):
        """Build a TL_starGiftUnique + TL_savedStarGift wrapper from chosen attrs.
        Returns (gift, saved, b64, name, slug, uid); b64 is '' on failure."""
        try:
            ArrayList = jclass("java.util.ArrayList")
            J = jclass("org.telegram.tgnet.tl.TL_stars$TL_starGiftUnique")
            gift = J()
            import random as _r
            uid = int(forced_uid or 0) or _r.randint(100000000, 999999999)
            try: gift.id = uid
            except Exception: pass
            try:
                if int(base_gift_id or 0) > 0:
                    gift.gift_id = int(base_gift_id)
            except Exception: pass
            try: gift.num = int(num or 1)
            except Exception: pass
            # name: explicit title → base gift title → model attribute name → "NFT"
            name = str(title or "").strip()
            if (not name or name == "NFT") and base_gift is not None:
                try:
                    name = str(getattr(base_gift, "title", "") or "").strip() or name
                except Exception:
                    pass
            if not name or name == "NFT":
                try:
                    nm = str(getattr(model_a, "name", "") or "").strip()
                    if nm:
                        name = nm
                except Exception:
                    pass
            if not name:
                name = "NFT"
            slug = name.replace(" ", "") + "-" + str(num)
            try: gift.title = name
            except Exception: pass
            try: gift.slug = slug
            except Exception: pass
            if crafted:
                try: self._jset(gift, "crafted", True)
                except Exception: pass
                try: self._jset(model_a, "crafted", True)
                except Exception: pass
            gift.attributes = ArrayList()
            if model_a is not None: gift.attributes.add(model_a)
            if pattern_a is not None: gift.attributes.add(pattern_a)
            if backdrop_a is not None: gift.attributes.add(backdrop_a)
            # original-details row («Подарок от X для Y … с комментарием») on upgrade
            if original_details:
                od = self._make_original_details(original_details)
                if od is not None:
                    gift.attributes.add(od)

            # copy the model sticker/document so the collectible renders, + availability
            try:
                doc = None
                if model_a is not None:
                    doc = getattr(model_a, "document", None) or getattr(model_a, "sticker", None)
                if doc is None and base_gift is not None:
                    doc = getattr(base_gift, "sticker", None) or getattr(base_gift, "document", None)
                if doc is not None:
                    self._jset(gift, "document", doc)
                    self._jset(gift, "sticker", doc)
            except Exception:
                pass
            if base_gift is None and int(base_gift_id or 0) > 0:
                base_gift = self._find_base_gift(base_gift_id)
            try:
                self._copy_availability(gift, base_gift, num)
            except Exception as e:
                self.log("[ctor] avail: " + _cause(e))

            Saved = jclass("org.telegram.tgnet.tl.TL_stars$TL_savedStarGift")
            saved = Saved()
            saved.gift = gift
            try: self._jset(saved, "saved_id", int(uid))
            except Exception: pass

            SD = jclass("org.telegram.tgnet.SerializedData")
            try:
                size = int(saved.getObjectSize())
            except Exception:
                size = 8192
            sd = SD(max(size, 256))
            saved.serializeToStream(sd)
            data = sd.toByteArray()
            raw = bytes((int(b) & 0xFF) for b in data)
            b64 = base64.b64encode(raw).decode("ascii")
            return gift, saved, b64, name, slug, uid
        except Exception as e:
            try: self.log("[ctor] build_unique err: " + repr(e))
            except Exception: pass
            return None, None, "", "", "", 0

    def _build_and_save(self, model_a, pattern_a, backdrop_a, title, num, base_gift_id=0, base_gift=None, value_config=None, edit_id=0):
        try:
            gift, saved, b64, name, slug, uid = self._build_unique_gift(
                model_a, pattern_a, backdrop_a, title, num, base_gift_id, base_gift)
            if not b64:
                self._toast("сборка не удалась")
                return False

            entry = {"b64": b64, "inject": True, "title": name,
                     "slug": slug, "num": int(num or 1), "unique_id": int(uid),
                     "base_gift_id": int(base_gift_id or 0), "gift_kind": "local_upgraded"}
            if value_config and str(value_config.get("amount", "") or "").strip():
                entry["value_config"] = {
                    "amount": str(value_config.get("amount", "")).strip(),
                    "currency": str(value_config.get("currency", "USD") or "USD").upper()}
            # EDIT mode: drop the ORIGINAL entry FIRST so the result is a modify, not a
            # duplicate (remove-first is robust even if ids collide). edit_id = the gift's
            # unique_id/saved_id captured when «Изменить» opened the constructor.
            try:
                eid = int(edit_id or 0)
            except Exception:
                eid = 0
            # remove-old + add-new in ONE atomic write and ONE re-inject; eid=0 → plain add
            res = self._jvoid("replaceGift", ("long", "str"), (eid, json.dumps(entry)))
            if eid > 0:
                self._ctor_edit_id = 0
            try: self.log("[edit] save edit_id=%s new_uid=%s -> %s" % (eid, uid, str(res)[:70]))
            except Exception: pass
            self._toast("NFT обновлён ✓" if eid > 0 else "NFT сохранён ✓")
            return True
        except Exception as e:
            self._toast("сборка: " + repr(e)[:140])
            try: self.log("[ctor] build err: " + repr(e))
            except Exception: pass
            return False

    def _regular_entry_template(self, gift, title=""):
        """Serialize a base star gift once → a reusable regular-entry template
        (b64 + name + base_gift_id + upgrade info), WITHOUT the per-copy
        unique_id/slug. Returns None on failure."""
        if gift is None or jclass is None:
            return None
        try:
            Saved = jclass("org.telegram.tgnet.tl.TL_stars$TL_savedStarGift")
            saved = Saved()
            saved.gift = gift
            # detect upgradability (base gift has upgrade_stars) — applied to the live
            # wrapper by Java enrich so TG shows the native «Улучшить» button
            try:
                ups = int(getattr(gift, "upgrade_stars", 0) or 0)
            except Exception:
                ups = 0
            SD = jclass("org.telegram.tgnet.SerializedData")
            try:
                size = int(saved.getObjectSize())
            except Exception:
                size = 8192
            sd = SD(max(size, 256))
            saved.serializeToStream(sd)
            data = sd.toByteArray()
            raw = bytes((int(b) & 0xFF) for b in data)
            b64 = base64.b64encode(raw).decode("ascii")
            gid = 0
            try: gid = int(getattr(gift, "id", 0) or 0)
            except Exception: gid = 0
            name = str(title or "").strip() or str(getattr(gift, "title", "") or "").strip() or "Подарок"
            tpl = {"b64": b64, "title": name, "base_gift_id": int(gid), "upgrade_stars": ups}
            return tpl
        except Exception as e:
            try: self.log("[cat] serialize regular: " + _cause(e))
            except Exception: pass
            return None

    def _entry_from_template(self, tpl):
        """Stamp a fresh unique_id/slug onto a template → one persistable entry."""
        import random as _r
        uid = _r.randint(100000000, 999999999)
        name = str(tpl.get("title") or "Подарок")
        entry = {"b64": tpl["b64"], "inject": True, "title": name,
                 "slug": name.replace(" ", "") + "-" + str(uid), "num": 0,
                 "unique_id": int(uid), "base_gift_id": int(tpl.get("base_gift_id") or 0),
                 "gift_kind": "regular"}
        ups = int(tpl.get("upgrade_stars") or 0)
        if ups > 0:
            entry["upgradable"] = True
            entry["upgrade_stars"] = ups
        return entry

    def _add_regular_gifts(self, gift, title="", n=1):
        """Add `n` identical regular gifts in ONE bridge call (single atomic write +
        single reload) — backs the catalog «N×» quantity selector. Returns count added."""
        try:
            try:
                n = int(n or 1)
            except Exception:
                n = 1
            n = max(1, min(n, 99))
            if gift is None or jclass is None:
                self._toast("нет подарка")
                return 0
            tpl = self._regular_entry_template(gift, title)
            if tpl is None:
                self._toast("не удалось сериализовать подарок")
                return 0
            entries = [self._entry_from_template(tpl) for _ in range(n)]
            self._jvoid("addGifts", ("str",), (json.dumps(entries),))
            nm = str(title or "").strip() or str(tpl.get("title") or "подарок")
            if n == 1:
                self._toast("Подарок добавлен ✓")
            else:
                self._toast("Добавлено %d × %s ✓" % (n, nm))
            return n
        except Exception as e:
            self._toast("добавление: " + repr(e)[:140])
            try: self.log("[cat] add regulars: " + _cause(e))
            except Exception: pass
            return 0

    def _add_regular_gift(self, gift, title=""):
        """Add a single plain star gift to the library (thin wrapper over the batch path)."""
        return self._add_regular_gifts(gift, title, 1) > 0

    def _fetch_upgrade_attrs(self, gift_id, on_attrs):
        """Send getStarGiftUpgradeAttributes(gift_id) → split TL attributes into
        models / patterns / backdrops, deliver on the UI thread."""
        try:
            if RequestDelegate is None or get_connections_manager is None or jclass is None:
                on_attrs([], [], [])
                return
            req = jclass("org.telegram.tgnet.tl.TL_stars$getStarGiftUpgradeAttributes")()
            try:
                req.gift_id = int(gift_id)
            except Exception:
                pass
            plugin = self

            class _D(dynamic_proxy(RequestDelegate)):
                def run(self2, response, error):
                    models, patterns, backdrops = [], [], []
                    try:
                        attrs = getattr(response, "attributes", None) if response is not None else None
                        if attrs is not None:
                            for i in range(int(attrs.size())):
                                a = attrs.get(i)
                                cls = str(a.getClass().getSimpleName()).lower()
                                if "model" in cls:
                                    models.append(a)
                                elif "backdrop" in cls:
                                    backdrops.append(a)
                                elif "pattern" in cls or "symbol" in cls:
                                    patterns.append(a)
                    except Exception:
                        pass
                    raw = None
                    try:
                        raw = getattr(response, "attributes", None) if response is not None else None
                    except Exception:
                        raw = None
                    try:
                        run_on_ui_thread(lambda: on_attrs(models, patterns, backdrops, raw))
                    except Exception:
                        on_attrs(models, patterns, backdrops, raw)
            get_connections_manager().sendRequest(req, _D())
        except Exception as e:
            self._toast("attrs: " + repr(e)[:120])
            on_attrs([], [], [], None)

    def _jfield(self, obj, name):
        try:
            c = obj.getClass()
            while c is not None:
                try:
                    f = c.getDeclaredField(name)
                    f.setAccessible(True)
                    return f.get(obj)
                except Exception:
                    c = c.getSuperclass()
            return None
        except Exception:
            return None

    def _jset(self, obj, name, val):
        """Reflective field write (walk superclass chain). Returns True on success."""
        if obj is None:
            return False
        try:
            obj.__setattr__(name, val)
            return True
        except Exception:
            pass
        try:
            c = obj.getClass()
            while c is not None:
                try:
                    f = c.getDeclaredField(name)
                    f.setAccessible(True)
                    f.set(obj, val)
                    return True
                except Exception:
                    c = c.getSuperclass()
        except Exception:
            pass
        return False

    def _split_attrs(self, attr_list):
        """Split a raw upgrade-attribute list into (models, patterns, backdrops)."""
        models, patterns, backdrops = [], [], []
        try:
            n = int(attr_list.size()) if attr_list is not None else 0
            for i in range(n):
                a = attr_list.get(i)
                if a is None:
                    continue
                cls = str(a.getClass().getSimpleName()).lower()
                if "model" in cls:
                    models.append(a)
                elif "backdrop" in cls:
                    backdrops.append(a)
                elif "pattern" in cls or "symbol" in cls:
                    patterns.append(a)
        except Exception:
            pass
        return models, patterns, backdrops

    def _saved_attr_objects(self, edit_gift):
        """Extract the (model, pattern, backdrop) attribute objects already stored on a saved gift."""
        model = pattern = backdrop = None
        try:
            gift = self._deserialize_gift(edit_gift.get("b64")) if edit_gift else None
            attrs = getattr(gift, "attributes", None) if gift is not None else None
            n = int(attrs.size()) if attrs is not None else 0
            for i in range(n):
                a = attrs.get(i)
                if a is None:
                    continue
                cls = str(a.getClass().getSimpleName()).lower()
                if "model" in cls and model is None:
                    model = a
                elif "backdrop" in cls and backdrop is None:
                    backdrop = a
                elif ("pattern" in cls or "symbol" in cls) and pattern is None:
                    pattern = a
        except Exception:
            pass
        return model, pattern, backdrop

    def _find_base_gift(self, gid):
        """Locate the base catalog TL_starGift by its id (for availability/name/document)."""
        try:
            gid = int(gid or 0)
            if gid <= 0:
                return None
            for g in self._catalog_list():
                try:
                    if int(getattr(g, "id", 0) or 0) == gid:
                        return g
                except Exception:
                    continue
        except Exception:
            pass
        return None

    def _copy_availability(self, gift, base_gift, num):
        """Fill availability_total / availability_issued so the «Количество» row isn't 0/0."""
        def _rdi(obj, names):
            for nm in names:
                try:
                    v = int(getattr(obj, nm, 0) or 0)
                    if v > 0:
                        return v
                except Exception:
                    pass
            return 0
        total = issued = 0
        if base_gift is not None:
            total = _rdi(base_gift, ["availability_total", "total", "limited_count"])
            issued = _rdi(base_gift, ["availability_issued", "issued"])
        if total <= 0:
            total = 10000  # sane non-zero so the ribbon/row renders
        if issued <= 0:
            issued = min(int(num or 1), int(total))
        for nm in ("availability_total", "total"):
            if self._jset(gift, nm, int(total)):
                break
        for nm in ("availability_issued", "issued"):
            if self._jset(gift, nm, int(issued)):
                break
        self._jset(gift, "availability_remains", max(int(total) - int(issued), 0))
        self._jset(gift, "limited", True)

    def _seed_sheet(self, sheet, seed):
        """Pre-select (model, pattern, backdrop) on the native sheet so it shows the
        saved/base combo instead of a random one — and drops the «Случайные» subtitle."""
        if sheet is None:
            return
        model, pattern, backdrop = seed if seed else (None, None, None)
        if model is None and pattern is None and backdrop is None:
            return
        try:
            PreviewAttrs = jclass("org.telegram.ui.Stars.StarGiftPreviewSheet$Attributes")
            attrs_obj = PreviewAttrs(backdrop, pattern, model)
        except Exception as e:
            self.log("[ctor] seed attrs cls: " + _cause(e))
            return
        self._jset(sheet, "selectedAttributes", attrs_obj)
        try:
            tv = self._jfield(sheet, "topView")
            if tv is not None:
                try: tv.setPreviewAttributes(attrs_obj)
                except Exception: pass
                try:
                    AL = jclass("java.util.ArrayList")
                    lst = AL()
                    for o in (model, pattern, backdrop):
                        if o is not None:
                            lst.add(o)
                    tv.setPreviewingAttributes(lst)
                except Exception:
                    pass
        except Exception:
            pass
        try:
            ModeCls = jclass("org.telegram.ui.Stars.StarGiftPreviewSheet$Mode")
            mode = None
            try:
                mode = getattr(ModeCls, "SELECTED")
            except Exception:
                try: mode = ModeCls.valueOf("SELECTED")
                except Exception: mode = None
            if mode is not None:
                sheet.setMode(mode)
        except Exception:
            pass
        try:
            sheet.updateHeaderAttributes(False)
        except Exception:
            pass

    def _open_constructor(self, edit_gift):
        if BottomSheet is None or jclass is None:
            self._toast("UI недоступен")
            return
        # remember which saved gift we're EDITING so the save REPLACES it (not duplicate)
        try:
            self._ctor_edit_id = int((edit_gift or {}).get("unique_id") or (edit_gift or {}).get("saved_id") or 0)
        except Exception:
            self._ctor_edit_id = 0
        try:
            self.log("[edit] open edit_id=%s (uid=%s saved=%s kind=%s)" % (
                self._ctor_edit_id, (edit_gift or {}).get("unique_id"),
                (edit_gift or {}).get("saved_id"), (edit_gift or {}).get("kind")))
        except Exception:
            pass
        gid = 0
        if edit_gift:
            try:
                gid = int(edit_gift.get("base_gift_id") or 0) or int(edit_gift.get("unique_id") or 0)
            except Exception:
                gid = 0
        if gid <= 0:
            # new gift with no base id → derive a base from the first library gift
            for g in self._gifts():
                gid = int(g.get("base_gift_id") or 0) or int(g.get("unique_id") or 0)
                if gid > 0:
                    break
        if gid <= 0:
            self._toast("Нет base_gift_id — добавь NFT из каталога")
            return
        title = (edit_gift.get("title") if edit_gift else "NFT") or "NFT"
        num = (edit_gift.get("num") if edit_gift else 1) or 1
        # issued/total cap for the «random collectible number» button (≤ выпущено).
        # Prefer the saved avail_*; base_gift refines it later in _show_native_constructor.
        self._ctor_issued = 0
        try:
            for k in ("avail_issued", "availability_issued", "avail_total", "availability_total", "limit_total"):
                v = int((edit_gift or {}).get(k) or 0)
                if v > 0:
                    self._ctor_issued = v; break
        except Exception:
            self._ctor_issued = 0
        # pre-select the attributes already saved on this gift (so edit ≠ random)
        seed = self._saved_attr_objects(edit_gift) if edit_gift else None
        self._toast("загружаю атрибуты…")

        def _on(models, patterns, backdrops, raw):
            # NEVER let this async UI-thread callback raise — an escaped exception here
            # force-closes Telegram («вылетает»).
            try:
                if raw is None or int(getattr(raw, "size", lambda: 0)()) <= 0:
                    if not (models or patterns or backdrops):
                        self._toast("Атрибуты не пришли")
                        return
                    self._show_constructor_grid(edit_gift, models, patterns, backdrops, base_gift_id=gid)
                    return
                # EDIT: map the saved gift's attrs to the LIVE objects (the ones in `raw`).
                # Passing the b64-deserialized objects to the native sheet crashes it.
                live_seed = self._match_seed_to_live(seed, models, patterns, backdrops) if seed else None
                vcfg = edit_gift.get("value_config") if edit_gift else None
                self._show_native_constructor(gid, title, num, raw, seed=live_seed,
                                              base_gift=self._find_base_gift(gid), value_cfg=vcfg)
            except Exception as e:
                self._toast("конструктор: " + repr(e)[:120])
                try: self.log("[ctor] _on: " + _cause(e))
                except Exception: pass
        self._fetch_upgrade_attrs(gid, _on)

    def _attr_id(self, a):
        for nm in ("document_id", "documentId", "backdrop_id", "backdropId", "id"):
            try:
                v = int(getattr(a, nm, 0) or 0)
                if v:
                    return v
            except Exception:
                pass
        # backdrops have no doc id → fall back to the name
        try:
            return ("n:" + str(getattr(a, "name", "") or "")).strip()
        except Exception:
            return 0

    def _match_seed_to_live(self, seed, models, patterns, backdrops):
        """Return (model,pattern,backdrop) using the LIVE attr instances (from the fetched
        list) that match the saved gift's attrs by id — so the native sheet never sees a
        foreign object. Falls back to None per-slot (no seed) rather than a wrong object."""
        try:
            sm, sp, sb = seed
        except Exception:
            return None

        def _pick(saved, live_list):
            try:
                if saved is None or not live_list:
                    return None
                sid = self._attr_id(saved)
                if sid:
                    for a in live_list:
                        try:
                            if self._attr_id(a) == sid:
                                return a
                        except Exception:
                            continue
            except Exception:
                pass
            return None
        return (_pick(sm, models), _pick(sp, patterns), _pick(sb, backdrops))

    def _install_ctor_hooks(self):
        """Lazily disable the attribute-cell selection-ring animation (cold path: the
        cell only exists while the constructor sheet is open). The previous model's
        ring used to fade out with an overshoot («появляется 2 раза») — forcing the
        `animated` arg of GiftAttributeCell.setSelected(boolean[,boolean]) to false
        makes the ring snap instantly. Robust: tries several class names + signatures
        and logs exactly what it found so we can diagnose a miss."""
        if getattr(self, "_ctor_hooks_done", False):
            return
        if MethodHook is None or getattr(self, "hook_method", None) is None or _NoAnimSelectHook is None:
            return
        self._ctor_hooks_done = True  # one-shot; don't retry on every open
        Cell = None
        for cn in ("org.telegram.ui.Stars.GiftAttributeCell",
                   "org.telegram.ui.Gifts.GiftAttributeCell",
                   "org.telegram.ui.Stars.StarGiftSheet$GiftAttributeCell"):
            try:
                Cell = JavaClass.forName(cn)
                self.log("[ctor] GiftAttributeCell = " + cn)
                break
            except Exception:
                continue
        if Cell is None:
            self.log("[ctor] GiftAttributeCell NOT FOUND (tried Stars/Gifts/nested)")
            return
        refs = []
        seen = []
        try:
            for m in Cell.getDeclaredMethods():
                try:
                    if m.getName() != "setSelected":
                        continue
                    pts = m.getParameterTypes()
                    sig = ",".join(p.getName() for p in pts)
                    seen.append(sig or "(void)")
                    # the 2-arg setSelected(selected, animated) — force animated=false
                    if len(pts) == 2 and pts[0].getName() == "boolean" and pts[1].getName() == "boolean":
                        m.setAccessible(True)
                        refs.append(self.hook_method(m, _NoAnimSelectHook()))
                except Exception:
                    continue
        except Exception as e:
            self.log("[ctor] setSelected hook err: " + _cause(e))
        self._ctor_hook_refs = refs
        self.log("[ctor] setSelected sigs=%s hooked=%d" % (seen, len(refs)))

    def _kill_sheet_anim(self, sheet):
        """Null out the RecyclerView item-animator (and zero its durations as a
        fallback) on the constructor sheet. When you switch a model the native
        DefaultItemAnimator cross-fades the rebound cells → the previously-selected
        outline blinks with a delay. With no animator the selection ring snaps."""
        try:
            rv = self._jfield(sheet, "recyclerListView")
            if rv is None:
                self.log("[ctor] no recyclerListView for anim-kill")
                return
            anim = None
            try:
                anim = rv.getItemAnimator()
            except Exception:
                anim = None
            # zero the durations first (covers code paths that re-set the animator)
            if anim is not None:
                for setter, val in (("setAddDuration", 0), ("setRemoveDuration", 0),
                                    ("setMoveDuration", 0), ("setChangeDuration", 0)):
                    try:
                        getattr(anim, setter)(val)
                    except Exception:
                        pass
                try:
                    anim.setSupportsChangeAnimations(False)
                except Exception:
                    pass
            try:
                rv.setItemAnimator(None)
                self.log("[ctor] itemAnimator killed (had=%s)" % (anim is not None))
            except Exception as e:
                self.log("[ctor] setItemAnimator(None): " + _cause(e))
        except Exception as e:
            self.log("[ctor] anim-kill: " + _cause(e))

    # ---- constructor header pills: «#номер» (collectible num) + «$ценность» (value+currency) ----
    def _col(self, argb):
        """Coerce an 0xAARRGGBB literal into a signed 32-bit Java int (Chaquopy-safe)."""
        argb &= 0xFFFFFFFF
        return argb - 0x100000000 if argb >= 0x80000000 else argb

    def _curr_symbol(self, c):
        return {"USD": "$", "EUR": "€", "RUB": "₽"}.get(str(c or "USD").upper(), "$")

    def _ctor_num_label(self):
        try:
            return "#" + str(int(getattr(self, "_ctor_num", 1) or 1))
        except Exception:
            return "#1"

    def _ctor_value_label(self):
        v = str(getattr(self, "_ctor_value", "") or "").strip()
        sym = self._curr_symbol(getattr(self, "_ctor_currency", "USD"))
        if not v:
            return sym
        # «≈» prefix while the price is auto-derived from attributes (an estimate the
        # owner can still override); plain symbol once they type their own value
        auto = getattr(self, "_ctor_value_auto", False)
        return (("≈ " if auto else "") + sym + " " + v)

    def _ctor_pill(self, ctx, text):
        tv = TextView(ctx)
        tv.setText(text)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        tv.setTextColor(self._col(0xFFFFFFFF))
        tv.setGravity(Gravity.CENTER)
        tv.setPadding(AndroidUtilities.dp(11), AndroidUtilities.dp(5),
                      AndroidUtilities.dp(11), AndroidUtilities.dp(5))
        bg = GradientDrawable()
        bg.setCornerRadius(AndroidUtilities.dp(13))
        bg.setColor(self._col(0x55000000))
        tv.setBackground(bg)
        return tv

    def _qty_pill_view(self, ctx, text):
        """Accent FAB-style pill for the catalog quantity selector («N×»)."""
        tv = TextView(ctx)
        tv.setText(text)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
        tv.setTextColor(self._col(0xFFFFFFFF))
        tv.setGravity(Gravity.CENTER)
        tv.setPadding(AndroidUtilities.dp(22), AndroidUtilities.dp(12),
                      AndroidUtilities.dp(22), AndroidUtilities.dp(12))
        bg = GradientDrawable()
        bg.setCornerRadius(AndroidUtilities.dp(26))
        try:
            bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
        except Exception:
            bg.setColor(self._col(0xFF3390EC))
        tv.setBackground(bg)
        try:
            tv.setElevation(float(AndroidUtilities.dp(4)))
        except Exception:
            pass
        return tv

    def _inject_ctor_pills(self, sheet):
        """Add the «#num» (left) and «$value» (right) pills into the native sheet
        header, next to the back / play buttons (matches the production look)."""
        if PopupWindow is None:
            return
        try:
            header = self._jfield(sheet, "headerView")
            if header is None:
                self.log("[ctor] no headerView for pills")
                return
            ctx = header.getContext()
            # left: collectible number
            np = self._ctor_pill(ctx, self._ctor_num_label())
            self._ctor_num_pill = np
            lp1 = FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.LEFT)
            lp1.leftMargin = AndroidUtilities.dp(52)
            lp1.topMargin = AndroidUtilities.dp(15)
            np.setOnClickListener(self._click(lambda v: self._open_num_pad(np)))
            header.addView(np, lp1)
            # right: value + currency
            vp = self._ctor_pill(ctx, self._ctor_value_label())
            self._ctor_value_pill = vp
            lp2 = FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.RIGHT)
            lp2.rightMargin = AndroidUtilities.dp(52)
            lp2.topMargin = AndroidUtilities.dp(15)
            vp.setOnClickListener(self._click(lambda v: self._open_value_pad(vp)))
            header.addView(vp, lp2)
            self.log("[ctor] pills injected")
        except Exception as e:
            self.log("[ctor] pills: " + _cause(e))

    def _np_btn(self, ctx, label, on_tap):
        b = TextView(ctx)
        b.setText(label)
        b.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        b.setTextColor(self._col(0xFFFFFFFF))
        b.setGravity(Gravity.CENTER)
        bg = GradientDrawable()
        bg.setCornerRadius(AndroidUtilities.dp(10))
        bg.setColor(self._col(0x18FFFFFF))
        b.setBackground(bg)
        b.setOnClickListener(self._click(lambda v: on_tap()))
        return b

    def _show_numpad(self, anchor, kind, on_done):
        """Generic keypad popup anchored to a pill. kind = 'num' | 'value'.
        on_done(text, currency) is called on OK."""
        try:
            ctx = anchor.getContext()
        except Exception:
            return
        is_val = (kind == "value")
        if is_val:
            buf = {"s": str(getattr(self, "_ctor_value", "") or "").strip()}
            cur = {"c": str(getattr(self, "_ctor_currency", "USD") or "USD").upper()}
        else:
            buf = {"s": str(int(getattr(self, "_ctor_num", 1) or 1))}
            cur = {"c": "USD"}

        root = LinearLayout(ctx)
        root.setOrientation(LinearLayout.VERTICAL)
        rbg = GradientDrawable()
        rbg.setCornerRadius(AndroidUtilities.dp(16))
        rbg.setColor(self._col(0xF21D1D27))
        root.setBackground(rbg)
        pad = AndroidUtilities.dp(6)
        root.setPadding(pad, pad, pad, pad)

        title = TextView(ctx)
        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        title.setTextColor(self._col(0xFFFFFFFF))
        title.setGravity(Gravity.CENTER)
        title.setPadding(0, AndroidUtilities.dp(2), 0, AndroidUtilities.dp(6))

        def _title_text():
            if is_val:
                s = buf["s"]
                return (self._curr_symbol(cur["c"]) + " " + s) if s else self._curr_symbol(cur["c"])
            return "#" + buf["s"]

        def _refresh():
            try:
                title.setText(_title_text())
            except Exception:
                pass
        _refresh()
        root.addView(title, LinearLayout.LayoutParams(-1, -2))

        pop = {"w": None}
        fresh = {"v": True}   # first keypress replaces the prefilled value

        def _digit(d):
            if fresh["v"]:
                fresh["v"] = False
                buf["s"] = "" if d != "." else "0"
            s = buf["s"]
            if d == "." :
                if "." in s or not is_val:
                    return
                if not s:
                    s = "0"
                buf["s"] = s + "."
            else:
                # cap length (num: 6 digits; value: 9 chars)
                limit = 9 if is_val else 6
                if len(s) >= limit:
                    return
                if s == "0" and d != ".":
                    s = ""
                buf["s"] = s + d
            _refresh()

        def _del():
            fresh["v"] = False
            buf["s"] = buf["s"][:-1]
            _refresh()

        def _clr():
            fresh["v"] = False
            buf["s"] = ""
            _refresh()

        def _rand():
            # random collectible number that doesn't exceed the issued/total supply
            import random as _r
            fresh["v"] = False
            cap = int(getattr(self, "_ctor_issued", 0) or 0)
            if cap <= 0:
                cap = 99999
            cap = min(cap, 999999)            # the «#num» field caps at 6 digits
            buf["s"] = str(_r.randint(1, max(1, cap)))
            _refresh()

        def _cycle():
            order = ["USD", "EUR", "RUB"]
            try:
                i = order.index(cur["c"])
            except Exception:
                i = 0
            cur["c"] = order[(i + 1) % 3]
            _refresh()

        def _ok():
            try:
                if pop["w"] is not None:
                    pop["w"].dismiss()
            except Exception:
                pass
            try:
                on_done(buf["s"], cur["c"])
            except Exception as e:
                self.log("[ctor] numpad ok: " + _cause(e))

        def _row(cells):
            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            for label, fn in cells:
                lp = LinearLayout.LayoutParams(0, AndroidUtilities.dp(38), 1.0)
                m = AndroidUtilities.dp(2)
                lp.setMargins(m, m, m, m)
                row.addView(self._np_btn(ctx, label, fn), lp)
            root.addView(row, LinearLayout.LayoutParams(-1, -2))

        for a, b, c in (("1", "2", "3"), ("4", "5", "6"), ("7", "8", "9")):
            _row([(a, lambda d=a: _digit(d)), (b, lambda d=b: _digit(d)), (c, lambda d=c: _digit(d))])
        if is_val:
            _row([(".", lambda: _digit(".")), ("0", lambda: _digit("0")), ("Del", _del)])
            _row([(cur["c"], _cycle), ("Clr", _clr), ("OK", _ok)])
        else:
            _row([("Del", _del), ("0", lambda: _digit("0")), ("OK", _ok)])
            _row([("🎲 Случайный №", _rand)])   # random # ≤ выпущено

        w = PopupWindow(root, AndroidUtilities.dp(188), -2, True)
        pop["w"] = w
        try:
            w.setOutsideTouchable(True)
            w.setBackgroundDrawable(GradientDrawable())
        except Exception:
            pass
        try:
            w.showAsDropDown(anchor, 0, AndroidUtilities.dp(4))
            root.setAlpha(0.0); root.setScaleX(0.90); root.setScaleY(0.90)
            root.setTranslationY(float(-AndroidUtilities.dp(8)))
            na = root.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).translationY(0.0).setDuration(210)
            it = self._smooth_interp()
            if it is not None: na.setInterpolator(it)
            na.start()
            self._stagger_children(root, 15, 24, 4)
        except Exception as e:
            self.log("[ctor] numpad show: " + _cause(e))

    def _open_num_pad(self, pill):
        def _done(text, _cur):
            try:
                n = int(text or "1")
            except Exception:
                n = 1
            self._ctor_num = max(n, 1)
            try:
                pill.setText(self._ctor_num_label())
            except Exception:
                pass
            # collectible number affects the auto price (low # = pricier) → re-fill now
            self._refresh_auto_value()
        self._show_numpad(pill, "num", _done)

    def _open_value_pad(self, pill):
        def _done(text, curncy):
            t = str(text or "").strip()
            self._ctor_value = t
            self._ctor_currency = str(curncy or "USD").upper()
            if t:
                # owner typed a price → manual override, stop auto-deriving
                self._ctor_value_auto = False
            else:
                # cleared the field → re-enable auto and re-fill from current attributes
                self._ctor_value_auto = True
                self._refresh_auto_value()
                self._start_autovalue_loop()
            try:
                pill.setText(self._ctor_value_label())
            except Exception:
                pass
        self._show_numpad(pill, "value", _done)

    def _show_native_constructor(self, gid, title, num, attr_list, seed=None, base_gift=None, value_cfg=None):
        try:
            self._install_ctor_hooks()
            # constructor pill state (collectible number + value/currency)
            try:
                self._ctor_num = int(num or 1) or 1
            except Exception:
                self._ctor_num = 1
            # refine the «random number» cap from the base catalog gift (issued/total supply)
            try:
                if base_gift is not None:
                    c = int(getattr(base_gift, "availability_issued", 0) or 0) or \
                        int(getattr(base_gift, "availability_total", 0) or 0)
                    if c > 0:
                        self._ctor_issued = c
            except Exception:
                pass
            self._ctor_value = ""
            self._ctor_currency = "USD"
            if value_cfg:
                try:
                    self._ctor_value = str(value_cfg.get("amount", "") or "").strip()
                    self._ctor_currency = str(value_cfg.get("currency", "USD") or "USD").upper()
                except Exception:
                    pass
            # AUTO price unless the gift already has a saved (manual) value — then respect it.
            # In auto mode the value is derived live from the selected attributes' rarity.
            self._ctor_value_auto = not bool(str(self._ctor_value).strip())
            # match the owner's TG locale: default the currency to the gift's own
            # value_currency (so the estimate reads «≈ €8 116» like the native sheet)
            if self._ctor_value_auto and base_gift is not None:
                try:
                    gc = str(getattr(base_gift, "value_currency", "") or "").upper()
                    if gc in ("USD", "EUR", "RUB"):
                        self._ctor_currency = gc
                except Exception:
                    pass
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if act is None:
                self._toast("нет контекста")
                return
            # remember the base gift so the save step can copy name / availability / document
            self._pending_base_gift = base_gift
            self._ctor_anchor_usd = None                 # force re-resolve the value anchor
            # if no explicit seed, default to the FIRST option of each kind (stable, never random)
            if seed is None:
                ms, ps, bs = self._split_attrs(attr_list)
                seed = (ms[0] if ms else None, ps[0] if ps else None, bs[0] if bs else None)
            Sheet = jclass("org.telegram.ui.Stars.StarGiftPreviewSheet")
            rp = None
            try:
                rp = frag.getResourceProvider()
            except Exception:
                rp = None
            sheet = Sheet(act, rp, _selected_account(), str(title), attr_list, False)
            self._nat_sheet = sheet
            sheet.show()
            # kill the list item-animator so switching a model doesn't fade the
            # previously-selected cell's outline («обводка мерцает на прошлых моделях»)
            self._kill_sheet_anim(sheet)
            # repurpose the native headerPlay button as «save NFT to library»
            try:
                btn = self._jfield(sheet, "headerPlay")
                if btn is not None:
                    try:
                        from org.telegram.messenger import R as _R
                        ic = int(getattr(_R.drawable, "msg_send", 0) or 0) or int(getattr(_R.drawable, "ic_ab_done", 0) or 0)
                        if ic:
                            btn.setImageResource(ic)
                    except Exception:
                        pass
                    btn.setOnClickListener(self._click(lambda v: self._save_from_native(sheet, gid, title, num)))
            except Exception as e:
                self.log("[ctor] hook btn: " + repr(e))
            # seed the selected combo AFTER the sheet built its views (slight delay)
            run_on_ui_thread(lambda: self._seed_sheet(sheet, seed), 60)
            # inject the «#num» / «$value» pills into the header
            run_on_ui_thread(lambda: self._inject_ctor_pills(sheet), 80)
            # start the live auto-price loop (fills «$value» from the selected attributes,
            # refreshing as the owner switches model / backdrop / symbol)
            self._start_autovalue_loop()
        except Exception as e:
            self._toast("конструктор: " + repr(e)[:140])
            self.log("[ctor] native: " + _cause(e))

    def _read_sheet_attrs(self, sheet):
        """Current model / pattern / backdrop selected in the native StarGiftPreviewSheet —
        from `selectedAttributes`, falling back to the topView getters."""
        model = pattern = backdrop = None
        try:
            attrs = self._jfield(sheet, "selectedAttributes")
            if attrs is not None:
                model = getattr(attrs, "model", None)
                pattern = getattr(attrs, "pattern", None)
                backdrop = getattr(attrs, "backdrop", None)
        except Exception:
            pass
        if model is None and pattern is None and backdrop is None:
            try:
                tv = self._jfield(sheet, "topView")
                if tv is not None:
                    try: model = tv.getUpgradeImageViewAttribute()
                    except Exception: pass
                    try: pattern = tv.getUpgradePatternAttribute()
                    except Exception: pass
                    try: backdrop = tv.getUpgradeBackdropAttribute()
                    except Exception: pass
            except Exception:
                pass
        return model, pattern, backdrop

    def _save_from_native(self, sheet, gid, title, num):
        try:
            model, pattern, backdrop = self._read_sheet_attrs(sheet)
            base_gift = getattr(self, "_pending_base_gift", None)
            edit_id = int(getattr(self, "_ctor_edit_id", 0) or 0)
            # num + value/currency come from the header pills
            try:
                num = int(getattr(self, "_ctor_num", num) or num or 1)
            except Exception:
                num = num or 1
            value_cfg = None
            val = str(getattr(self, "_ctor_value", "") or "").strip()
            if val:
                value_cfg = {"amount": val,
                             "currency": str(getattr(self, "_ctor_currency", "USD") or "USD").upper()}
            ok = self._build_and_save(model, pattern, backdrop, title, num,
                                      base_gift_id=gid, base_gift=base_gift, value_config=value_cfg,
                                      edit_id=edit_id)
            if ok:
                self._nat_sheet = None          # stop the live auto-price loop
                try: sheet.dismiss()
                except Exception: pass
                try:
                    if getattr(self, "_catalog_sheet", None) is not None:
                        self._catalog_sheet.dismiss()
                    if getattr(self, "_gifts_sheet", None) is not None:
                        self._gifts_sheet.dismiss()
                except Exception:
                    pass
        except Exception as e:
            self._toast("сохранение: " + repr(e)[:140])

    def _attr_name(self, a):
        try:
            return str(getattr(a, "name", "") or "")
        except Exception:
            return ""

    def _attr_rarity(self, a):
        try:
            v = int(getattr(a, "rarity_permille", 0) or 0)
            return (v / 10.0)
        except Exception:
            return 0.0

    # ---- automatic collectible value (anchored on the gift's REAL market price, like TG) ----
    # Telegram fills «Ценность» from the gift's own value_amount/value_currency (and the
    # resale floor resell_min_stars). A Plush Pepe is worth thousands NOT because of a
    # formula but because that's its market floor — so we ANCHOR on that real number and let
    # rarity / collectible-number only nudge it, instead of inventing a price from scratch.
    _STAR_USD = 0.013                                    # ≈ USD per Telegram Star (floor→USD)
    _FX = {"USD": 1.0, "EUR": 1.09, "RUB": 0.0111, "TON": 3.0}   # → USD per 1 unit

    def _to_usd(self, amount, currency):
        return float(amount) * self._FX.get(str(currency or "USD").upper(), 1.0)

    def _from_usd(self, usd, currency):
        r = self._FX.get(str(currency or "USD").upper(), 1.0)
        return (float(usd) / r) if r else float(usd)

    def _gift_value_anchor_usd(self, bg):
        """The gift's REAL value in USD, taken from its own economics (the same data TG uses
        for «Ценность»). Priority: shown value → resale floor → controller floor → mint price.
        Returns (usd, source-tag); (0.0, '') when nothing is known."""
        if bg is None:
            return 0.0, ""
        # 1) the displayed value: value_amount (minor units, exp=2 for USD/EUR/RUB) + value_currency
        try:
            va = int(getattr(bg, "value_amount", 0) or 0)
            if va > 0:
                cur = str(getattr(bg, "value_currency", "") or "USD").upper()
                return self._to_usd(va / 100.0, cur), "value"
        except Exception:
            pass
        # 2) resale floor in stars (what «Resale from X» shows). DIRECT field reads only —
        # do NOT call _get_gift_floor_stars here: it resolves+invokes a StarsController method
        # by reflection, and this runs on the UI thread (the live loop), which can ANR/crash.
        for nm in ("resell_min_stars", "min_resell_stars", "resellMinStars",
                   "floor_stars", "floorStars"):
            try:
                rms = int(getattr(bg, nm, 0) or 0)
            except Exception:
                rms = 0
            if rms > 0:
                return rms * self._STAR_USD, "floor"
        # 3) mint price × a collectible markup (weak fallback)
        try:
            st = int(getattr(bg, "stars", 0) or 0)
            if st > 0:
                return st * self._STAR_USD * 3.0, "mint"
        except Exception:
            pass
        return 0.0, ""

    def _auto_value_for(self, model, pattern, backdrop):
        """Auto collectible value in the selected currency, anchored on the gift's real market
        value with a gentle rarity / low-number nudge. '' when no market data + no override."""
        try:
            # the anchor is gift-level (doesn't change as the owner switches attributes) →
            # resolve it ONCE per constructor and cache, so the live loop stays cheap
            anchor_usd = getattr(self, "_ctor_anchor_usd", None)
            src = getattr(self, "_ctor_anchor_src", "")
            if anchor_usd is None:
                bg = getattr(self, "_pending_base_gift", None)
                anchor_usd, src = self._gift_value_anchor_usd(bg)
                self._ctor_anchor_usd = anchor_usd
                self._ctor_anchor_src = src
            if anchor_usd <= 0:
                return ""                                # unknown → leave blank, owner sets it
            # per-attribute weight: rarer → bigger. `neutral` is the rarity at which weight=1.
            def h(attr, neutral):
                if attr is None:
                    return 1.0
                p = self._attr_rarity(attr)
                if p <= 0:
                    p = neutral
                return (float(neutral) / max(min(p, 80.0), 0.15)) ** 0.25
            try:
                num = int(getattr(self, "_ctor_num", 1) or 1)
            except Exception:
                num = 1
            num = max(num, 1)
            if src == "value":
                # anchor = the gift's real shown «Ценность» (its rarity is already mostly baked
                # in). Normalize around a TYPICAL NFT attribute (~1%) so a typical copy ≈ the
                # real value, and let the chosen attributes swing it moderately — so the price
                # DOES change live as the owner picks model / backdrop / symbol, around the
                # realistic anchor instead of being pinned to it.
                prod = h(model, 1.0) * h(backdrop, 1.0) * h(pattern, 1.0)
                rar = max(0.8, min(prod ** 0.30, 1.6))
                nf = min(1.0 + 0.12 / (num ** 0.5), 1.15)
            else:
                # anchor = the FLOOR (cheapest, ~common copy) → full premium above it
                prod = h(model, 8.0) * h(backdrop, 8.0) * h(pattern, 8.0)
                rar = max(0.85, min(prod ** 0.55, 6.0))
                nf = min(1.0 + 0.30 / (num ** 0.5), 1.4)
            usd = anchor_usd * rar * nf
            cur = str(getattr(self, "_ctor_currency", "USD") or "USD").upper()
            try:
                self.log("[autoval] src=%s anchor$=%.0f rar=%.2f nf=%.2f -> $%.0f %s" % (
                    src, anchor_usd, rar, nf, usd, cur))
            except Exception:
                pass
            return self._round_value(self._from_usd(usd, cur), cur)
        except Exception:
            return ""

    def _round_value(self, v, cur):
        """Round a raw value to a clean, human-looking number per currency."""
        try:
            v = float(v)
        except Exception:
            return ""
        if v <= 0:
            return ""
        if cur == "RUB":
            step = 50 if v < 1000 else 100 if v < 10000 else 500 if v < 100000 else 1000
            return str(int(max(round(v / step) * step, step)))
        # USD / EUR
        if v < 20:
            r = round(v * 2) / 2.0                       # nearest 0.5
            return ("%.1f" % r).rstrip("0").rstrip(".")
        if v < 100:
            return str(int(round(v)))
        if v < 500:
            return str(int(round(v / 5) * 5))
        if v < 2000:
            return str(int(round(v / 10) * 10))
        return str(int(round(v / 50) * 50))

    def _refresh_auto_value(self):
        """One-shot: recompute + show the auto value from the sheet's current attributes,
        but only while in auto mode."""
        if not getattr(self, "_ctor_value_auto", False):
            return
        sheet = getattr(self, "_nat_sheet", None)
        if sheet is None:
            return
        try:
            m, p, b = self._read_sheet_attrs(sheet)
        except Exception:
            m = p = b = None
        amt = self._auto_value_for(m, p, b)
        if not amt:
            return
        self._ctor_value = amt
        pill = getattr(self, "_ctor_value_pill", None)
        if pill is not None:
            try:
                pill.setText(self._ctor_value_label())
            except Exception:
                pass

    def _start_autovalue_loop(self):
        """(Re)start the live auto-price loop. A generation token kills any prior loop so
        only one runs at a time (and so a stale loop can't outlive its sheet)."""
        try:
            self._ctor_value_loop_gen = getattr(self, "_ctor_value_loop_gen", 0) + 1
            gen = self._ctor_value_loop_gen
            run_on_ui_thread(lambda: self._ctor_autovalue_loop(gen, 0), 200)
        except Exception:
            pass

    def _ctor_autovalue_loop(self, gen, tick):
        try:
            # superseded by a newer loop / constructor, sheet gone, or manual override → stop
            if gen != getattr(self, "_ctor_value_loop_gen", 0):
                return
            if getattr(self, "_nat_sheet", None) is None or not getattr(self, "_ctor_value_auto", False):
                return
            if tick > 900:                               # ~5min backstop, never run forever
                return
            # the value pill detaching means the sheet was dismissed → stop cleanly. (Don't
            # stop before it's injected: pill is None for the first few ticks.)
            pill = getattr(self, "_ctor_value_pill", None)
            try:
                if pill is not None and hasattr(pill, "isAttachedToWindow") and not pill.isAttachedToWindow():
                    self._nat_sheet = None
                    return
            except Exception:
                pass
            self._refresh_auto_value()
        except Exception:
            pass
        # reschedule (snappy enough to feel live as the owner switches attributes)
        try:
            run_on_ui_thread(lambda: self._ctor_autovalue_loop(gen, tick + 1), 350)
        except Exception:
            pass

    def _show_constructor_grid(self, edit_gift, models, patterns, backdrops, base_gift_id=None):
        frag = get_last_fragment()
        ctx = frag.getParentActivity() if frag else None
        if not ctx:
            return
        bgid = base_gift_id or (int(edit_gift.get("base_gift_id") or 0) if edit_gift else 0)
        st = {"model": models[0] if models else None,
              "pattern": patterns[0] if patterns else None,
              "backdrop": backdrops[0] if backdrops else None,
              "tab": "model",
              "base_gift_id": bgid,
              "title": (edit_gift.get("title") if edit_gift else "Custom NFT"),
              "num": (edit_gift.get("num") if edit_gift else 1)}
        if edit_gift:
            for lst, key, ek in ((models, "model", "model"), (patterns, "pattern", "symbol"), (backdrops, "backdrop", "backdrop")):
                want = edit_gift.get(ek)
                for a in lst:
                    if self._attr_name(a) == want:
                        st[key] = a
                        break
        try:
            scroll = ScrollView(ctx)
            col = LinearLayout(ctx)
            col.setOrientation(LinearLayout.VERTICAL)
            p = AndroidUtilities.dp(12)
            col.setPadding(p, p, p, AndroidUtilities.dp(20))

            prev_wrap = FrameLayout(ctx)
            plp = LinearLayout.LayoutParams(AndroidUtilities.dp(140), AndroidUtilities.dp(140))
            plp.gravity = Gravity.CENTER_HORIZONTAL
            col.addView(prev_wrap, plp)

            ttl = TextView(ctx)
            ttl.setGravity(Gravity.CENTER)
            ttl.setText(str(st.get("title") or "Custom NFT"))
            ttl.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
            ttl.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            try: ttl.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            tllp = LinearLayout.LayoutParams(-1, -2)
            tllp.topMargin = AndroidUtilities.dp(8)
            col.addView(ttl, tllp)

            sub = TextView(ctx)
            sub.setGravity(Gravity.CENTER)
            sub.setText("Случайные характеристики")
            sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            col.addView(sub, LinearLayout.LayoutParams(-1, -2))

            # current-attribute chips row (model / backdrop / pattern)
            chips_row = LinearLayout(ctx)
            chips_row.setOrientation(LinearLayout.HORIZONTAL)
            crlp = LinearLayout.LayoutParams(-1, -2)
            crlp.topMargin = AndroidUtilities.dp(12)
            col.addView(chips_row, crlp)

            def refresh_preview():
                try:
                    prev_wrap.removeAllViews()
                    self._render_attrs_into(ctx, prev_wrap, st["model"], st["pattern"], st["backdrop"])
                    chips_row.removeAllViews()
                    for a, lbl in ((st["model"], "модель"), (st["backdrop"], "фон"), (st["pattern"], "узор")):
                        chip = self._cur_chip(ctx, a, lbl)
                        chlp = LinearLayout.LayoutParams(0, -2, 1.0)
                        chlp.rightMargin = AndroidUtilities.dp(6)
                        chips_row.addView(chip, chlp)
                    prev_wrap.setAlpha(0.0); prev_wrap.setScaleX(0.90); prev_wrap.setScaleY(0.90)
                    pa = prev_wrap.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(240)
                    it = self._smooth_interp()
                    if it is not None: pa.setInterpolator(it)
                    pa.start()
                    self._stagger_children(chips_row, 20, 35, 5)
                except Exception:
                    pass

            # tabs
            tabs_row = LinearLayout(ctx)
            tabs_row.setOrientation(LinearLayout.HORIZONTAL)
            tlp = LinearLayout.LayoutParams(-1, -2)
            tlp.topMargin = AndroidUtilities.dp(12)
            tab_btns = {}

            grid_host = LinearLayout(ctx)
            grid_host.setOrientation(LinearLayout.VERTICAL)

            def build_grid():
                grid_host.removeAllViews()
                pool = {"model": models, "pattern": patterns, "backdrop": backdrops}[st["tab"]]
                rowv = None
                for i, a in enumerate(pool):
                    if i % 3 == 0:
                        rowv = LinearLayout(ctx)
                        rowv.setOrientation(LinearLayout.HORIZONTAL)
                        glp = LinearLayout.LayoutParams(-1, -2)
                        glp.topMargin = AndroidUtilities.dp(8)
                        grid_host.addView(rowv, glp)
                    cell = self._option_cell(ctx, st, a, lambda: (refresh_preview(), build_grid()))
                    celllp = LinearLayout.LayoutParams(0, -2, 1.0)
                    celllp.rightMargin = AndroidUtilities.dp(6) if (i % 3 != 2) else 0
                    rowv.addView(cell, celllp)

            def set_tab(t):
                if st.get("tab") == t:
                    return
                try:
                    grid_host.animate().cancel()
                    grid_host.animate().alpha(0.0).translationX(float(AndroidUtilities.dp(-8))).setDuration(90).start()
                except Exception:
                    pass
                def _swap_tab():
                    st["tab"] = t
                    for k, b in tab_btns.items():
                        b.setBackground(self._ripple_bg(self._chip_bg(k == t), Theme.getColor(Theme.key_featuredStickers_addButton)))
                        try:
                            b.animate().scaleX(1.04 if k == t else 1.0).scaleY(1.04 if k == t else 1.0).setDuration(170).start()
                        except Exception:
                            pass
                    build_grid()
                    try:
                        grid_host.setTranslationX(float(AndroidUtilities.dp(8)))
                        grid_host.animate().alpha(1.0).translationX(0.0).setDuration(190).start()
                    except Exception:
                        pass
                    self._stagger_children(grid_host, 10, 28, 8)
                run_on_ui_thread(_swap_tab, 95)

            for key, label in (("model", "Модели"), ("backdrop", "Фоны"), ("pattern", "Узоры")):
                tb = TextView(ctx)
                tb.setText(label)
                tb.setGravity(Gravity.CENTER)
                tb.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                tb.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                tb.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(8))
                tb.setBackground(self._ripple_bg(self._chip_bg(key == st["tab"]), Theme.getColor(Theme.key_featuredStickers_addButton)))
                tb.setOnClickListener(self._click(lambda v, k=key: set_tab(k)))
                blp = LinearLayout.LayoutParams(0, -2, 1.0)
                blp.rightMargin = AndroidUtilities.dp(6)
                tabs_row.addView(tb, blp)
                tab_btns[key] = tb
            ghlp = LinearLayout.LayoutParams(-1, -2)
            ghlp.topMargin = AndroidUtilities.dp(8)
            col.addView(grid_host, ghlp)
            # tabs at the BOTTOM (like the production gift constructor)
            col.addView(tabs_row, tlp)

            save = self._pill(ctx, "Сохранить NFT", Theme.getColor(Theme.key_featuredStickers_addButton),
                              lambda v: self._ctor_save(st))
            svlp = LinearLayout.LayoutParams(-1, AndroidUtilities.dp(48))
            svlp.topMargin = AndroidUtilities.dp(16)
            col.addView(save, svlp)

            refresh_preview()
            build_grid()

            scroll.addView(col)
            b = BottomSheet.Builder(ctx)
            b.setCustomView(scroll)
            self._ctor_sheet = b.create()
            self._show_sheet_animated(self._ctor_sheet, scroll)
        except Exception as e:
            self._toast("конструктор: " + repr(e)[:140])

    def _option_cell(self, ctx, st, a, on_pick):
        cls = str(a.getClass().getSimpleName()).lower()
        kind = "model" if "model" in cls else ("backdrop" if "backdrop" in cls else "pattern")
        card = LinearLayout(ctx)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setGravity(Gravity.CENTER_HORIZONTAL)
        sel = (a is st.get(kind))
        bg = GradientDrawable()
        bg.setCornerRadius(AndroidUtilities.dp(12))
        bg.setColor(self._cell_bg_color(sel))
        card.setBackground(self._ripple_bg(bg, Theme.getColor(Theme.key_featuredStickers_addButton)))
        try: card.setElevation(float(AndroidUtilities.dp(2 if sel else 0)))
        except Exception: pass
        card.setPadding(AndroidUtilities.dp(6), AndroidUtilities.dp(8), AndroidUtilities.dp(6), AndroidUtilities.dp(8))

        SZ = AndroidUtilities.dp(58)
        thumb = FrameLayout(ctx)
        # rounded tile background: for a model option show the FULL gift in that model
        # on the current backdrop (like the production «cat variants»); backdrop
        # option shows the color, pattern shows the symbol.
        bd = st.get("backdrop")
        if kind == "backdrop":
            self._fill_backdrop_oval(thumb, a)
        else:
            self._fill_backdrop_rect(thumb, bd)
        if kind == "model":
            self._add_doc(ctx, thumb, getattr(a, "document", None), AndroidUtilities.dp(50))
        elif kind == "pattern":
            self._add_doc(ctx, thumb, getattr(a, "document", None), AndroidUtilities.dp(40))

        # rarity badge top-right
        rb = TextView(ctx)
        rb.setText("%.1f%%" % self._attr_rarity(a))
        rb.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 9)
        rb.setTextColor(self._argb_signed(0xFFFFFF))
        rb.setPadding(AndroidUtilities.dp(5), AndroidUtilities.dp(1), AndroidUtilities.dp(5), AndroidUtilities.dp(1))
        rbg = GradientDrawable()
        rbg.setCornerRadius(AndroidUtilities.dp(8))
        rbg.setColor(0x66000000)  # semi-transparent black (positive 32-bit int)
        rb.setBackground(rbg)
        rblp = FrameLayout.LayoutParams(-2, -2, Gravity.RIGHT | Gravity.TOP)
        thumb.addView(rb, rblp)
        card.addView(thumb, LinearLayout.LayoutParams(SZ, SZ, Gravity.CENTER_HORIZONTAL))

        nm = TextView(ctx)
        nm.setText(self._attr_name(a))
        nm.setGravity(Gravity.CENTER)
        nm.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
        nm.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        nm.setMaxLines(1)
        nlp = LinearLayout.LayoutParams(-1, -2)
        nlp.topMargin = AndroidUtilities.dp(5)
        card.addView(nm, nlp)

        def pick(v):
            st[kind] = a
            on_pick()
        card.setOnClickListener(self._click(pick))
        return card

    def _fill_backdrop_rect(self, wrap, backdrop_a):
        try:
            gd = GradientDrawable()
            gd.setCornerRadius(AndroidUtilities.dp(10))
            if backdrop_a is not None and jarray is not None:
                c = self._argb_signed(getattr(backdrop_a, "center_color", 0) or 0)
                e = self._argb_signed(getattr(backdrop_a, "edge_color", 0) or 0)
                gd.setGradientType(GradientDrawable.RADIAL_GRADIENT)
                gd.setGradientRadius(AndroidUtilities.dp(30))
                gd.setColors(jarray(jint)([c, e]))
            else:
                gd.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
            wrap.setBackground(gd)
        except Exception:
            pass

    def _fill_backdrop_oval(self, wrap, backdrop_a):
        try:
            gd = GradientDrawable()
            gd.setShape(GradientDrawable.OVAL)
            if backdrop_a is not None and jarray is not None:
                c = self._argb_signed(getattr(backdrop_a, "center_color", 0) or 0)
                e = self._argb_signed(getattr(backdrop_a, "edge_color", 0) or 0)
                gd.setGradientType(GradientDrawable.RADIAL_GRADIENT)
                gd.setGradientRadius(AndroidUtilities.dp(28))
                gd.setColors(jarray(jint)([c, e]))
            else:
                gd.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
            wrap.setBackground(gd)
        except Exception:
            pass

    def _add_doc(self, ctx, wrap, doc, size):
        try:
            if doc is None or BackupImageView is None or ImageLocation is None:
                return
            img = BackupImageView(ctx)
            loc = ImageLocation.getForDocument(doc)
            if loc is not None:
                img.setImage(loc, "%d_%d" % (size, size), None, 0, doc)
            try: img.startAnimation()
            except Exception: pass
            wrap.addView(img, FrameLayout.LayoutParams(size, size, Gravity.CENTER))
        except Exception:
            pass

    def _cell_bg_color(self, selected):
        if selected:
            base = Theme.getColor(Theme.key_featuredStickers_addButton) & 0xFFFFFF
            return 0x55000000 | base
        return Theme.getColor(Theme.key_windowBackgroundGray)

    def _cur_chip(self, ctx, a, label):
        chip = LinearLayout(ctx)
        chip.setOrientation(LinearLayout.VERTICAL)
        chip.setGravity(Gravity.CENTER)
        bg = GradientDrawable()
        bg.setCornerRadius(AndroidUtilities.dp(14))
        bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
        chip.setBackground(bg)
        chip.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(8), AndroidUtilities.dp(8), AndroidUtilities.dp(8))
        nm = TextView(ctx)
        nm.setText(self._attr_name(a) or "—")
        nm.setGravity(Gravity.CENTER)
        nm.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        nm.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        try: nm.setTypeface(AndroidUtilities.bold())
        except Exception: pass
        chip.addView(nm, LinearLayout.LayoutParams(-1, -2))
        lb = TextView(ctx)
        lb.setText("%s · %.1f%%" % (label, self._attr_rarity(a)))
        lb.setGravity(Gravity.CENTER)
        lb.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 10)
        lb.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
        chip.addView(lb, LinearLayout.LayoutParams(-1, -2))
        return chip

    def _ctor_save(self, st):
        ok = self._build_and_save(st.get("model"), st.get("pattern"), st.get("backdrop"),
                                  st.get("title") or "Custom NFT", st.get("num") or 1,
                                  base_gift_id=st.get("base_gift_id") or 0,
                                  edit_id=getattr(self, "_ctor_edit_id", 0))
        if ok:
            try:
                if getattr(self, "_ctor_sheet", None) is not None:
                    self._ctor_sheet.dismiss()
            except Exception:
                pass
            try:
                if getattr(self, "_gifts_sheet", None) is not None:
                    self._gifts_sheet.dismiss()
            except Exception:
                pass

    def _chip_bg(self, selected):
        bg = GradientDrawable()
        bg.setCornerRadius(AndroidUtilities.dp(18))
        if selected:
            base = Theme.getColor(Theme.key_featuredStickers_addButton) & 0xFFFFFF
            bg.setColor(0x55000000 | base)
        else:
            bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
        return bg

    def _render_attrs_into(self, ctx, wrap, model_a, pattern_a, backdrop_a):
        gd = GradientDrawable()
        gd.setCornerRadius(AndroidUtilities.dp(16))
        gd.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
        wrap.setBackground(gd)
        # backdrop
        try:
            if backdrop_a is not None and jarray is not None:
                c = self._argb_signed(getattr(backdrop_a, "center_color", 0) or 0)
                e = self._argb_signed(getattr(backdrop_a, "edge_color", 0) or 0)
                grad = GradientDrawable()
                grad.setShape(GradientDrawable.RECTANGLE)
                grad.setCornerRadius(AndroidUtilities.dp(16))
                grad.setGradientType(GradientDrawable.RADIAL_GRADIENT)
                try: grad.setGradientCenter(0.5, 0.5)
                except Exception: pass
                grad.setGradientRadius(AndroidUtilities.dp(72))
                grad.setColors(jarray(jint)([c, e]))
                wrap.setBackground(grad)
        except Exception:
            pass
        # model sticker
        try:
            doc = getattr(model_a, "document", None) if model_a is not None else None
            if doc is not None and BackupImageView is not None and ImageLocation is not None:
                img = BackupImageView(ctx)
                try: img.setRoundRadius(AndroidUtilities.dp(36))
                except Exception: pass
                loc = ImageLocation.getForDocument(doc)
                if loc is not None:
                    img.setImage(loc, "80_80", None, 0, doc)
                try: img.startAnimation()
                except Exception: pass
                sz = AndroidUtilities.dp(80)
                wrap.addView(img, FrameLayout.LayoutParams(sz, sz, Gravity.CENTER))
        except Exception:
            pass

    def _confirm_delete_gift(self, gid, name=""):
        """Ask before deleting a gift (so a good NFT isn't lost by a mis-tap)."""
        try:
            if gid <= 0:
                self._toast("нет id"); return
            if AlertDialogBuilder is None:
                self._delete_gift(gid); return
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None:
                self._delete_gift(gid); return
            b = AlertDialogBuilder(ctx)
            b.set_title("Удалить подарок?")
            b.set_message(((name or "Подарок") + " будет удалён безвозвратно.").strip())
            b.set_positive_button("Удалить", lambda d, w: self._delete_gift(gid))
            b.set_negative_button("Отмена", None)
            run_on_ui_thread(b.show)
        except Exception as e:
            self.log("[gift] confirm del: " + _cause(e))
            self._delete_gift(gid)

    def _delete_gift(self, gid):
        try:
            if gid <= 0:
                self._toast("нет id")
                return
            self._jvoid("removeGift", ("long",), (gid,))
            self._toast("Удалено")
            # refresh the grid in place (no dismiss→reopen flash)
            self._refresh_gifts_sheet(150)
        except Exception as e:
            self._toast("del err: " + repr(e))

    # ---- display helpers ----
    def _gifts_subtext(self, st):
        n = int(st.get("gift_count", 0) or 0)
        return f"{n} NFT" if n else "пусто"

    def _uname_status(self, st):
        toks = st.get("username_tokens") or []
        return ("@" + toks[0]) if (st.get("username_enabled") and toks) else "выкл"

    def _num_status(self, st):
        toks = st.get("number_tokens") or []
        return ("+" + toks[0]) if (st.get("number_enabled") and toks) else "выкл"

    def _rating_label(self, st):
        try:
            if st.get("rating_enabled") and int(st.get("rating_value", 0)) > 0:
                return f"ур. {st.get('rating_level', 1)} • {st.get('rating_value', 0)}"
        except Exception:
            pass
        return "выкл"

    def _verif_label(self, st):
        return {0: "выкл", 1: "Hold", 2: "Major"}.get(int(st.get("verification_mode", 0)), "выкл")

    # ---- bridge-wired actions ----
    def _set_username(self, enabled, toks):
        self._jvoid("setUsername", ("int", "str"), (1 if enabled else 0, ",".join(toks or [])))

    def _set_number(self, enabled, toks):
        self._jvoid("setNumber", ("int", "str"), (1 if enabled else 0, ",".join(toks or [])))

    def _add_username(self, text):
        t = (text or "").strip().lstrip("@")
        if not t:
            return
        st = self._settings()
        toks = list(st.get("username_tokens") or [])
        if t.lower() not in [x.lower() for x in toks]:
            toks.insert(0, t)
        self._set_username(True, toks)
        self._toast("Username сохранён: @" + t)

    def _add_number(self, text):
        t = "".join(ch for ch in (text or "") if ch.isdigit())
        if not t:
            return
        st = self._settings()
        toks = list(st.get("number_tokens") or [])
        if t not in toks:
            toks.insert(0, t)
        self._set_number(True, toks)
        self._toast("Number сохранён: +" + t)

    def _set_rating(self, enabled, value, level, goal):
        # Java setRating gates on (enabled && value>0), so toggling on with 0 points stays off.
        self._jvoid("setRating", ("int", "int", "int", "int"),
                    (1 if enabled else 0, int(value or 0), int(level or 1), int(goal or 0)))

    def _edit_rating_field(self, field):
        st = self._settings()
        val = int(st.get("rating_value", 0) or 0)
        lvl = int(st.get("rating_level", 1) or 1)
        goal = int(st.get("rating_next_goal", 0) or 0)
        was_enabled = bool(st.get("rating_enabled", False))
        titles = {"value": "Количество очков", "level": "Уровень профиля", "goal": "Следующая цель (очки)"}
        current = {"value": val, "level": lvl, "goal": goal}[field]

        def _done(text):
            n = int("".join(ch for ch in (text or "") if ch.isdigit()) or "0")
            v, l, g = val, lvl, goal
            if field == "value":
                v = n
            elif field == "level":
                l = max(1, n)
            else:
                g = n
            # keep it shown once there are points; setting points>0 implicitly enables it
            enable = was_enabled or (field == "value" and v > 0)
            self._set_rating(enable, v, l, g)
            self._toast("Рейтинг: ур. %d • %d" % (l, v) if v > 0 else "Рейтинг обновлён")
        self._input(titles[field], str(current), _done, numeric=True)

    def _open_verif_dialog(self):
        st = self._settings()
        nxt = (int(st.get("verification_mode", 0)) + 1) % 3
        self._jvoid("setVerificationMode", ("int",), (nxt,))
        self._toast("Верификация: " + {0: "выкл", 1: "Hold", 2: "Major"}[nxt])

    def _poll_state(self):
        self._toast("state: " + str(self._jvoid("getSettingsJson")))

    def _show_order_diag(self):
        try:
            s = str(self._jvoid("giftOrderDiag") or "").strip()
        except Exception as e:
            s = "err: " + repr(e)
        if not s:
            s = "(пусто — сперва открой свой профиль с подарками, потом сюда)"
        try:
            self.log("[order]\n" + s)
        except Exception:
            pass
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None or AlertDialogBuilder is None:
                self._toast(s[:200])
                return
            tv = TextView(ctx)
            tv.setText(s)
            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            mm = AndroidUtilities.dp(16)
            tv.setPadding(mm, mm, mm, mm)
            sc = ScrollView(ctx)
            sc.addView(tv)
            b = AlertDialogBuilder(ctx)
            b.set_title("Порядок подарков (date/pin/hid)")
            b.set_view(sc)
            b.set_positive_button("OK", None)
            run_on_ui_thread(b.show)
        except Exception as e:
            self._toast("диаг: " + repr(e))

    def _show_text_dialog(self, title, text):
        try:
            self.log("[diag]\n" + str(text))
        except Exception:
            pass
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None or AlertDialogBuilder is None:
                self._toast(str(text)[:200])
                return
            tv = TextView(ctx)
            tv.setText(str(text))
            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
            tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            mm = AndroidUtilities.dp(14)
            tv.setPadding(mm, mm, mm, mm)
            sc = ScrollView(ctx)
            sc.addView(tv)
            b = AlertDialogBuilder(ctx)
            b.set_title(str(title))
            b.set_view(sc)
            b.set_positive_button("OK", None)
            run_on_ui_thread(b.show)
        except Exception as e:
            self._toast("диаг: " + repr(e))

    def _dump_class(self, cn, name_filter=None):
        """Reflectively list a Java class's declared methods + fields (optionally
        filtered by name substrings). For RE'ing the native upgrade/reveal API."""
        try:
            c = JavaClass.forName(cn)
        except Exception as e:
            return cn.split(".")[-1] + " — НЕ НАЙДЕН: " + repr(e)[:80]
        lines = ["== " + cn.split(".")[-1] + " =="]
        try:
            ms = set()
            for m in c.getDeclaredMethods():
                try:
                    nm = m.getName()
                    if nm.startswith("lambda$") or nm.startswith("$") or "$Nest" in nm or "Nest$" in nm:
                        continue
                    if name_filter and not any(k in nm.lower() for k in name_filter):
                        continue
                    ps = ",".join(p.getSimpleName() for p in m.getParameterTypes())
                    ms.add("m " + nm + "(" + ps + "):" + m.getReturnType().getSimpleName())
                except Exception:
                    continue
            lines += sorted(ms)
        except Exception:
            pass
        try:
            fs = set()
            for f in c.getDeclaredFields():
                try:
                    nm = f.getName()
                    if nm.startswith("$") or "Nest" in nm:
                        continue
                    if name_filter and not any(k in nm.lower() for k in name_filter):
                        continue
                    fs.add("f " + nm + ":" + f.getType().getSimpleName())
                except Exception:
                    continue
            lines += sorted(fs)
        except Exception:
            pass
        return "\n".join(lines)

    def _show_sheet_dump(self):
        flt = ("upgrade", "reveal", "anim", "play", "transition", "switch",
               "attr", "unique", "button", "pay", "result", "convert", "wear",
               "set", "show", "top", "star")
        parts = []
        for cn in ("org.telegram.ui.Stars.StarGiftSheet",
                   "org.telegram.ui.Stars.StarGiftSheet$TopView",
                   "org.telegram.ui.Stars.StarGiftSheet$Page"):
            parts.append(self._dump_class(cn, name_filter=flt))
        self._show_text_dialog("StarGiftSheet (upgrade API)", "\n\n".join(parts))

    # ---- UI primitives (ported from the production menu) ----
    def _toast(self, msg):
        try:
            if BulletinHelper is not None:
                BulletinHelper.show_info(str(msg))
            else:
                self.log("eblanNFT: " + str(msg))
        except Exception:
            self.log("eblanNFT: " + str(msg))

    def _input(self, title, prefill, on_submit, numeric=False):
        try:
            if get_last_fragment is None or AlertDialogBuilder is None:
                return
            fragment = get_last_fragment()
            ctx = fragment.getParentActivity() if fragment else None
            if not ctx:
                return
            container = FrameLayout(ctx)
            et = EditText(ctx)
            et.setText(str(prefill or ""))
            # theme-aware text color (was always black → invisible on dark themes):
            # key_dialogTextBlack is remapped per-theme (white on dark, black on light).
            try:
                et.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            except Exception:
                pass
            try:
                et.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint))
            except Exception:
                pass
            if numeric:
                et.setInputType(2)
            params = FrameLayout.LayoutParams(-1, -2)
            m = AndroidUtilities.dp(20)
            params.leftMargin = m
            params.rightMargin = m
            et.setLayoutParams(params)
            container.addView(et)
            builder = AlertDialogBuilder(ctx)
            builder.set_title(title)
            builder.set_view(container)

            def _ok(dialog, which):
                try:
                    on_submit(str(et.getText()))
                except Exception as e:
                    self._toast("Ошибка ввода: " + repr(e))

            builder.set_positive_button("Сохранить", _ok)
            builder.set_negative_button("Отмена", None)
            run_on_ui_thread(builder.show)
        except Exception as e:
            self._toast("Dialog Err: " + repr(e))
