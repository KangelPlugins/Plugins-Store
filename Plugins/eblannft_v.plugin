"""eblanNFT — thin Python bootstrap over the Java/DEX core (Phase 6).

This is the NEW unified plugin: it loads the Java core (classes.dex) which owns
ALL runtime hooks + state + cache writes, and exposes a card-based settings menu
(visually identical to the legacy plugin) whose handlers call the Java bridge.

Bridge rule: every Java call is a STATIC method taking primitives/Strings and
returning a primitive/String. The DEX instance is never marshalled across.
"""

try:
    from base_plugin import BasePlugin
except ImportError:
    class BasePlugin(object):
        pass

try:
    from base_plugin import MethodHook
except Exception:
    MethodHook = None

import base64
import json

from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader, UserConfig
from java.lang import Class as JavaClass
from java.lang import Integer as JInteger
from java.lang import Long as JLong

try:
    from file_utils import get_plugins_dir
except Exception:
    get_plugins_dir = None

try:
    from file_utils import write_file, read_file, ensure_dir_exists
except Exception:
    write_file = read_file = ensure_dir_exists = None

try:
    from ui.settings import Header, Text, Divider, Switch
except Exception:
    Header = Text = Divider = Switch = None

try:
    from android_utils import run_on_ui_thread
    from client_utils import get_last_fragment
    from ui.bulletin import BulletinHelper
    from ui.alert import AlertDialogBuilder
    from android.widget import FrameLayout, EditText, LinearLayout, ScrollView, TextView, HorizontalScrollView, PopupWindow, ImageView
    from android.graphics.drawable import GradientDrawable
    from android.view import Gravity, View
    from android.util import TypedValue
    from org.telegram.messenger import AndroidUtilities, ImageLocation
    from org.telegram.ui.ActionBar import BottomSheet, Theme
    from org.telegram.ui.Components import BackupImageView
    try:
        from org.telegram.ui.Components import UItem
    except Exception:
        UItem = None
    from org.telegram.tgnet import RequestDelegate
    from client_utils import get_connections_manager
    from java import dynamic_proxy, jarray, jint, jbyte, jclass
except Exception:
    run_on_ui_thread = get_last_fragment = BulletinHelper = None
    AlertDialogBuilder = FrameLayout = EditText = AndroidUtilities = None
    LinearLayout = ScrollView = TextView = GradientDrawable = HorizontalScrollView = None
    Gravity = View = TypedValue = BottomSheet = Theme = dynamic_proxy = None
    PopupWindow = None
    jarray = jint = jbyte = jclass = ImageLocation = BackupImageView = ImageView = None
    RequestDelegate = get_connections_manager = None
    UItem = None

# optional extras for the production-style settings header / cards / about sheet
try:
    from org.telegram.messenger import MediaDataController
except Exception:
    MediaDataController = None
try:
    from org.telegram.ui.Components import LayoutHelper
except Exception:
    LayoutHelper = None
try:
    from org.telegram.messenger.browser import Browser
except Exception:
    Browser = None
try:
    from org.telegram.ui.Components import AvatarDrawable
except Exception:
    AvatarDrawable = None

EBLANNFT_WELCOME_STICKER_SET = "HappyHappyPepe"
EBLANNFT_ABOUT_USERNAME = "xarmaq"
EBLANNFT_SUPPORT_URL = "https://t.me/xarmaq"
EBLANNFT_UPDATE_URL = "https://t.me/eblannftlogs"
# auto-update: the loader polls a tiny JSON manifest on the VPS over HTTP (reliable,
# no hanging TL reads) and self-installs the full .plugin (dex embedded inside).
#   manifest: {base}/updates/files/eblannft_dex.json   -> {version, notes}
#   plugin:   {base}/updates/files/eblannft_bootstrap.plugin
EBLANNFT_UPDATE_BASE = "http://128.140.65.15"

__id__ = "eblannft_dex"
__name__ = "eblanNFT"
__description__ = "eblanNFT — NFT-подарки, юзернеймы, номера, рейтинг и верификация (Java/DEX-ядро)."
__author__ = "@xarmaq"
__version__ = "1.1.5"
# the loader's OWN version (= the .plugin). Updates ship as a full .plugin (dex embedded),
# so this is THE version the auto-updater compares against the VPS manifest.
_LOADER_VERSION = "1.1.8"
# AUTO-UPDATE KILL SWITCH. The background update loop was silently overwriting locally
# installed test builds with the VPS build (whenever the server advertised a newer version) —
# so hand-built fixes never actually ran. With this False, the plugin NEVER auto-checks or
# auto-replaces itself; the «Обновления» card still lets you update manually on demand.
_AUTO_UPDATE = False
__min_version__ = "11.9.0"
__icon__ = "HappyHappyPepe/0"

