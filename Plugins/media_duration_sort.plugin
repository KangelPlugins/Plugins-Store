import base64
import hashlib
import json
import os
from typing import Any, Optional

from android.os import Build
from base_plugin import BasePlugin
from java import jclass
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader


__id__ = "media_duration_sort"
__name__ = "Media Duration"
__description__ = "добавляет в меню общих медиа сортировку видео по длительности"
__author__ = "@mishabotov & @itskotovski"
__version__ = "2.0 [dex]"
__icon__ = "Icon1_by_TgEmojis_bot/163"


DEX_CLASS_NAME = "com.codex.exteragram.mediaduration.MediaDurationCore"
DEX_FILE_NAME = "media_duration.dex"
DEX_CACHE_DIR = "media_duration_dex"
EXPECTED_DEX_SHA256 = "4083abc565c80bbecde59a5dd8455662c5d651725b39cf373af400030fd4e7cf"
EXPECTED_BRIDGE_API = 1
EXPECTED_VERSION_CODE = 1
MAX_DEX_BYTES = 1024 * 1024

LABEL_LONG_FIRST = "Сначала длинные"
LABEL_SHORT_FIRST = "Сначала короткие"

dex_bridge = None
dex_loader = None


class MediaDurationSortPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._dex_class = None
        self._dex_loader = None

    def on_plugin_load(self) -> None:
        global dex_bridge, dex_loader

        self._unload_global_bridge()
        try:
            dex_bytes = self._decode_and_validate_dex()
            self._dex_loader = self._create_loader(dex_bytes)
            self._dex_class = self._dex_loader.loadClass(DEX_CLASS_NAME)
            self._validate_bridge(self._dex_class)
            self._invoke("startBridge")
            self._push_settings()

            dex_bridge = self._dex_class
            dex_loader = self._dex_loader
            self.log(
                f"Media Duration DEX {self._static_string('VERSION_NAME')} загружен"
            )
        except Exception as error:
            self._unload_dex()
            self.log(f"Ошибка загрузки Media Duration DEX: {error}")

    def on_plugin_unload(self) -> None:
        self._unload_dex()
        self.log("Media Duration DEX выгружен")

    def _decode_and_validate_dex(self) -> bytes:
        dex_bytes = base64.b64decode(DEX_BASE64, validate=True)
        if not dex_bytes.startswith(b"dex\n"):
            raise RuntimeError("неверный DEX magic")
        if not dex_bytes or len(dex_bytes) > MAX_DEX_BYTES:
            raise RuntimeError(f"неверный размер DEX: {len(dex_bytes)}")

        digest = hashlib.sha256(dex_bytes).hexdigest().lower()
        if digest != EXPECTED_DEX_SHA256:
            raise RuntimeError(f"SHA-256 DEX не совпадает: {digest}")
        return dex_bytes

    def _create_loader(self, dex_bytes: bytes) -> Any:
        context = ApplicationLoader.applicationContext
        parent = context.getClassLoader()
        if int(Build.VERSION.SDK_INT) >= 26:
            loader_class = jclass("dalvik.system.InMemoryDexClassLoader")
            return loader_class(ByteBuffer.wrap(dex_bytes), parent)

        cache_root = str(context.getCodeCacheDir().getAbsolutePath())
        cache_dir = os.path.join(cache_root, DEX_CACHE_DIR)
        os.makedirs(cache_dir, exist_ok=True)
        dex_path = os.path.join(cache_dir, DEX_FILE_NAME)
        temp_path = dex_path + ".tmp"
        with open(temp_path, "wb") as output:
            output.write(dex_bytes)
        os.replace(temp_path, dex_path)

        loader_class = jclass("dalvik.system.DexClassLoader")
        return loader_class(dex_path, cache_dir, None, parent)

    def _validate_bridge(self, dex_class: Any) -> None:
        string_class = jclass("java.lang.String")
        dex_class.getMethod("startBridge")
        dex_class.getMethod("updateSettingsBridge", string_class)
        dex_class.getMethod("getStateBridge")
        dex_class.getMethod("onUnloadBridge")
        dex_class.getDeclaredField("VERSION_NAME")

        bridge_api = self._static_int(dex_class, "BRIDGE_API")
        version_code = self._static_int(dex_class, "VERSION_CODE")
        if bridge_api != EXPECTED_BRIDGE_API:
            raise RuntimeError(
                f"bridge API {bridge_api}, ожидался {EXPECTED_BRIDGE_API}"
            )
        if version_code != EXPECTED_VERSION_CODE:
            raise RuntimeError(
                f"DEX version code {version_code}, ожидался {EXPECTED_VERSION_CODE}"
            )

    def _push_settings(self) -> None:
        payload = json.dumps(
            {"long_label": LABEL_LONG_FIRST, "short_label": LABEL_SHORT_FIRST},
            ensure_ascii=False,
        )
        string_class = jclass("java.lang.String")
        self._dex_class.getMethod("updateSettingsBridge", string_class).invoke(None, payload)

    @staticmethod
    def _static_int(dex_class: Any, name: str) -> int:
        field = dex_class.getDeclaredField(name)
        field.setAccessible(True)
        return int(field.get(None))

    def _static_string(self, name: str) -> str:
        if self._dex_class is None:
            raise RuntimeError("DEX-класс не загружен")
        field = self._dex_class.getDeclaredField(name)
        field.setAccessible(True)
        return str(field.get(None))

    def _invoke(self, method_name: str) -> Optional[Any]:
        if self._dex_class is None:
            raise RuntimeError("DEX-класс не загружен")
        return self._dex_class.getMethod(method_name).invoke(None)

    def _unload_dex(self) -> None:
        global dex_bridge, dex_loader

        if self._dex_class is not None:
            try:
                self._dex_class.getMethod("onUnloadBridge").invoke(None)
            except Exception:
                pass
        if dex_bridge is self._dex_class:
            dex_bridge = None
            dex_loader = None
        self._dex_class = None
        self._dex_loader = None

    @staticmethod
    def _unload_global_bridge() -> None:
        global dex_bridge, dex_loader

        if dex_bridge is not None:
            try:
                dex_bridge.getMethod("onUnloadBridge").invoke(None)
            except Exception:
                pass
        dex_bridge = None
        dex_loader = None


DEX_BASE64 = ""