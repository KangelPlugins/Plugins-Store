def is_ru():
    try:
        LocaleController = find_class("org.telegram.messenger.LocaleController")
        lang = str(LocaleController.getInstance().getCurrentLocaleInfo().getLangCode()).lower()
        return lang.startswith("ru")
    except Exception:
        try:
            Locale = find_class("java.util.Locale")
            return str(Locale.getDefault().getLanguage()).lower().startswith("ru")
        except Exception:
            return False


def _tr(ru, en):
    return ru if is_ru() else en


