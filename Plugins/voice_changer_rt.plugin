WATCHDOG_LOAD = 0.45
WATCHDOG_SECONDS = 2.0

AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
Theme = find_class("org.telegram.ui.ActionBar.Theme")


def _dp(value):
    try:
        return int(AndroidUtilities.dp(int(value)))
    except Exception:
        return int(value * 3)


def _signed_color(value):
    color = int(value) & 0xFFFFFFFF
    if color >= 0x80000000:
        color -= 0x100000000
    return color


def _color(key, fallback=0xFF1F2329):
    try:
        return _signed_color(Theme.getColor(key))
    except Exception:
        return _signed_color(fallback)


def _alpha(color, alpha):
    value = max(0, min(255, int(float(alpha) * 255)))
    return _signed_color((value << 24) | (int(color) & 0x00FFFFFF))


def _tap_bg(radius_dp=20):
    GradientDrawable = jclass("android.graphics.drawable.GradientDrawable")
    RippleDrawable = jclass("android.graphics.drawable.RippleDrawable")
    ColorStateList = jclass("android.content.res.ColorStateList")
    Color = jclass("android.graphics.Color")
    base = GradientDrawable()
    base.setCornerRadius(float(_dp(radius_dp)))
    base.setColor(Color.TRANSPARENT)
    try:
        return RippleDrawable(
            ColorStateList.valueOf(_alpha(_color(Theme.key_listSelector, 0x33000000), 0.18)),
            base,
            None,
        )
    except Exception:
        return base


def is_emoji_only(text):
    if not text:
        return False
    count = 0
    for char in text:
        code = ord(char)
        if code in (0x200D, 0xFE0F) or (0x1F3FB <= code <= 0x1F3FF):
            continue
        allowed = (
            (0x1F300 <= code <= 0x1FADF) or (0x1F600 <= code <= 0x1F64F) or
            (0x2600 <= code <= 0x27BF) or (0x1F680 <= code <= 0x1F6FF) or
            (0x1F900 <= code <= 0x1F9FF) or (0x1FA70 <= code <= 0x1FAFF) or
            (0x1F1E6 <= code <= 0x1F1FF) or (0x1F000 <= code <= 0x1F0FF) or
            (0x2300 <= code <= 0x23FF) or (0x25A0 <= code <= 0x25FF) or
            (0x2190 <= code <= 0x21FF) or (0x2B00 <= code <= 0x2BFF)
        )
        if not allowed:
            return False
        count += 1
    return 1 <= count <= 3


class VcParams(ctypes.Structure):
    _fields_ = [
        ("pitch", ctypes.c_float),
        ("formant", ctypes.c_float),
        ("ring_hz", ctypes.c_float),
        ("ring_depth", ctypes.c_float),
        ("drive", ctypes.c_float),
        ("chorus", ctypes.c_float),
        ("delay_ms", ctypes.c_float),
        ("feedback", ctypes.c_float),
        ("echo_mix", ctypes.c_float),
        ("reverb", ctypes.c_float),
        ("gate_db", ctypes.c_float),
        ("output_gain", ctypes.c_float),
        ("bypass", ctypes.c_int),
    ]


class NativeCore:

    def __init__(self, cache_dir):
        import platform

        arch = platform.machine().lower()
        if "arm64" in arch or "aarch64" in arch:
            blob, abi = SO_ARM64, "arm64"
        elif "arm" in arch:
            blob, abi = SO_ARMV7, "armv7"
        else:
            raise RuntimeError(f"unsupported architecture: {arch}")

        data = zlib.decompress(base64.b64decode(blob))
        stamp = f"{zlib.crc32(data) & 0xFFFFFFFF:08x}"
        prefix = f"libvoice_rt_{abi}_"
        name = f"{prefix}{stamp}.so"
        path = os.path.join(cache_dir, name)

        if not os.path.exists(path) or os.path.getsize(path) != len(data):
            with open(path, "wb") as handle:
                handle.write(data)

        for stale in os.listdir(cache_dir):
            if stale.startswith(prefix) and stale != name:
                try:
                    os.remove(os.path.join(cache_dir, stale))
                except OSError:
                    pass

        self.lib = ctypes.CDLL(path)
        self.lib.vc_abi_version.restype = ctypes.c_int
        abi_version = int(self.lib.vc_abi_version())
        if abi_version != ABI_VERSION:
            raise RuntimeError(f"ABI mismatch: library {abi_version}, plugin {ABI_VERSION}")

        self.lib.vc_create_ex.argtypes = [ctypes.c_int, ctypes.c_float]
        self.lib.vc_create_ex.restype = ctypes.c_void_p
        self.lib.vc_destroy.argtypes = [ctypes.c_void_p]
        self.lib.vc_destroy.restype = None
        self.lib.vc_set_params.argtypes = [ctypes.c_void_p, ctypes.POINTER(VcParams)]
        self.lib.vc_set_params.restype = None
        self.lib.vc_process_i16.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_short), ctypes.c_int]
        self.lib.vc_process_i16.restype = ctypes.c_int
        self.lib.vc_latency_frames.argtypes = [ctypes.c_void_p]
        self.lib.vc_latency_frames.restype = ctypes.c_int
        self.lib.vc_underruns.argtypes = [ctypes.c_void_p]
        self.lib.vc_underruns.restype = ctypes.c_int
        self.lib.vc_max_step_permille.argtypes = [ctypes.c_void_p]
        self.lib.vc_max_step_permille.restype = ctypes.c_int
        self.lib.vc_reset.argtypes = [ctypes.c_void_p]
        self.lib.vc_reset.restype = None

        log(f"{TAG} native core loaded (abi {abi_version})")


class Stream:

    def __init__(self, core, sample_rate, source):
        self.core = core
        self.sample_rate = sample_rate
        self.source = source
        self.handle = core.lib.vc_create_ex(int(sample_rate), LATENCY_MS.get(source, 30.0))
        if not self.handle:
            raise RuntimeError("vc_create_ex returned null")

        self.kind = "?"
        self.scratch = None
        self.view = None
        self.scratch_size = 0

        self.frames = 0
        self.total_ms = 0.0
        self.worst_ms = 0.0
        self.window_ms = 0.0
        self.window_audio_ms = 0.0
        self.window_frames = 0
        self.tripped = False

    def buffer(self, size):
        if self.scratch_size != size:
            self.scratch = bytearray(size)
            self.view = (ctypes.c_short * (size // 2)).from_buffer(self.scratch)
            self.scratch_size = size
        return self.scratch

    def process_in_place(self):
        count = self.scratch_size // 2
        if count:
            self.core.lib.vc_process_i16(self.handle, self.view, count)

    def note_timing(self, elapsed_ms, frame_ms, plugin):
        self.frames += 1
        self.total_ms += elapsed_ms
        self.window_ms += elapsed_ms
        self.window_audio_ms += frame_ms
        self.window_frames += 1
        if elapsed_ms > self.worst_ms:
            self.worst_ms = elapsed_ms
        if self.window_audio_ms < WATCHDOG_SECONDS * 1000.0:
            return

        load = self.window_ms / self.window_audio_ms
        log(f"{TAG} [{SRC_NAMES[self.source]}/{self.kind}] "
            f"avg={self.window_ms / self.window_frames:.3f}ms worst={self.worst_ms:.3f}ms "
            f"load={load * 100:.1f}%")
        self.window_ms = 0.0
        self.window_audio_ms = 0.0
        self.window_frames = 0
        self.worst_ms = 0.0

        if load > WATCHDOG_LOAD and not self.tripped:
            self.tripped = True
            log(f"{TAG} watchdog tripped on {SRC_NAMES[self.source]}, bypassing")
            plugin.bypass_stream(self)

    def close(self):
        if self.handle:
            self.core.lib.vc_destroy(self.handle)
            self.handle = None


class ReadHook(MethodHook):

    def __init__(self, plugin, kind):
        super().__init__()
        self.plugin = plugin
        self.kind = kind

    def after_hooked_method(self, param):
        try:
            self.plugin.on_frame(param, self.kind)
        except Exception as exc:
            self.plugin.on_fatal(exc)


class BatchHook(MethodHook):

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.on_audio_batch(param.thisObject, param.args[0])
        except Exception as exc:
            self.plugin.on_fatal(exc)


class CaptureFinishedHook(MethodHook):

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.drop_owner_stream(param.thisObject)
        except Exception as exc:
            log(f"{TAG} capture finished hook error: {exc}")


class ReleaseHook(MethodHook):

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.drop_stream(param.thisObject)
        except Exception as exc:
            log(f"{TAG} release hook error: {exc}")


class ListTouchListener(dynamic_proxy(find_class("android.view.View$OnTouchListener"))):

    def __init__(self, wrapper):
        super().__init__()
        self.wrapper = wrapper

    def onTouch(self, view, event):
        if not self.wrapper.sheet:
            return False
        action = event.getAction()
        try:
            if action in (0, 2):
                at_top = True
                if self.wrapper.scroll:
                    at_top = self.wrapper.scroll.getScrollY() <= 0
                self.wrapper.sheet.setCanDismissWithSwipe(at_top)
            elif action in (1, 3):
                self.wrapper.sheet.setCanDismissWithSwipe(True)
        except Exception:
            pass
        return False


class VoiceChangerSheet:

    def __init__(self, plugin, activity, fragment):
        self.plugin = plugin
        self.activity = activity
        self.fragment = fragment
        self.sheet = None
        self.scroll = None
        self._rows = {}

    def _build(self):
        LinearLayout = jclass("android.widget.LinearLayout")
        TextView = jclass("android.widget.TextView")
        ScrollView = jclass("android.widget.ScrollView")
        View = jclass("android.view.View")
        Gravity = jclass("android.view.Gravity")
        Typeface = jclass("android.graphics.Typeface")
        GradientDrawable = jclass("android.graphics.drawable.GradientDrawable")
        LayoutHelper = find_class("org.telegram.ui.Components.LayoutHelper")

        accent = _color(Theme.key_featuredStickers_addButton, 0xFF3390EC)
        text_primary = _color(Theme.key_dialogTextBlack, 0xFFFFFFFF)
        text_hint = _color(Theme.key_dialogTextHint, 0xFF888888)

        root = LinearLayout(self.activity)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setBackgroundColor(_color(Theme.key_dialogBackground, 0xFF101318))

        header = LinearLayout(self.activity)
        header.setOrientation(LinearLayout.VERTICAL)
        header.setGravity(Gravity.CENTER_HORIZONTAL)
        header.setPadding(_dp(20), _dp(16), _dp(20), _dp(8))

        icon = TextView(self.activity)
        icon.setText("\U0001F5E3️")
        icon.setTextSize(1, 32.0)
        header.addView(icon, LayoutHelper.createLinear(-2, -2, 0.0, 0, 0, 0, 6))

        title = TextView(self.activity)
        title.setText("Voice Changer RT")
        title.setTextColor(text_primary)
        title.setTextSize(1, 16.0)
        title.setTypeface(Typeface.DEFAULT_BOLD)
        header.addView(title, LayoutHelper.createLinear(-2, -2, 0.0, 0, 0, 0, 3))

        subtitle = TextView(self.activity)
        subtitle.setText(_tr("Применяется в реальном времени к звонкам, кружочкам и голосовым",
                             "Applied live to calls, round videos and voice messages"))
        subtitle.setTextColor(text_hint)
        subtitle.setTextSize(1, 12.0)
        subtitle.setGravity(Gravity.CENTER_HORIZONTAL)
        header.addView(subtitle, LayoutHelper.createLinear(-2, -2))

        root.addView(header, LayoutHelper.createLinear(-1, -2))

        scroll = ScrollView(self.activity)
        scroll.setFillViewport(True)
        scroll.setVerticalScrollBarEnabled(False)
        try:
            scroll.setOnTouchListener(ListTouchListener(self))
        except Exception:
            pass
        self.scroll = scroll

        content = LinearLayout(self.activity)
        content.setOrientation(LinearLayout.VERTICAL)
        content.setPadding(_dp(16), _dp(4), _dp(16), _dp(16))

        current = self.plugin.current_effect_id()
        self._rows = {}

        def circle_outline(color):
            drawable = GradientDrawable()
            drawable.setShape(GradientDrawable.OVAL)
            drawable.setStroke(_dp(2), color)
            drawable.setColor(0)
            return drawable

        def circle_solid(color):
            drawable = GradientDrawable()
            drawable.setShape(GradientDrawable.OVAL)
            drawable.setColor(color)
            return drawable

        def card_bg(color):
            drawable = GradientDrawable()
            drawable.setCornerRadius(float(_dp(20)))
            drawable.setColor(color)
            return drawable

        def add_section(section_title, entries):
            if not entries:
                return
            label = TextView(self.activity)
            label.setText(str(section_title))
            label.setTextColor(_alpha(text_primary, 0.55))
            label.setTextSize(1, 12.0)
            label.setTypeface(Typeface.DEFAULT_BOLD)
            label.setPadding(_dp(4), _dp(8), _dp(4), _dp(6))
            content.addView(label, LayoutHelper.createLinear(-1, -2))

            card = LinearLayout(self.activity)
            card.setOrientation(LinearLayout.VERTICAL)
            card.setBackground(card_bg(_alpha(text_primary, 0.04)))
            try:
                card.setClipToOutline(True)
            except Exception:
                pass

            for index, (effect_id, emoji, name, subtext) in enumerate(entries):
                if index > 0:
                    separator = View(self.activity)
                    separator.setBackgroundColor(_alpha(text_primary, 0.06))
                    card.addView(separator, LayoutHelper.createLinear(-1, 1, 0.0, 40, 0, 0, 0))

                row = LinearLayout(self.activity)
                row.setOrientation(LinearLayout.HORIZONTAL)
                row.setGravity(Gravity.CENTER_VERTICAL)
                row.setPadding(_dp(12), _dp(8), _dp(12), _dp(8))
                row.setBackground(_tap_bg())

                emoji_view = TextView(self.activity)
                emoji_view.setText(emoji)
                emoji_view.setTextSize(1, 20.0)
                emoji_view.setPadding(0, 0, _dp(10), 0)
                row.addView(emoji_view, LayoutHelper.createLinear(-2, -2))

                texts = LinearLayout(self.activity)
                texts.setOrientation(LinearLayout.VERTICAL)

                name_view = TextView(self.activity)
                name_view.setText(name)
                name_view.setTextSize(1, 14.0)
                name_view.setTypeface(Typeface.DEFAULT_BOLD if effect_id == current else Typeface.DEFAULT)
                name_view.setTextColor(accent if effect_id == current else text_primary)
                texts.addView(name_view, LayoutHelper.createLinear(-1, -2))

                if subtext:
                    sub_view = TextView(self.activity)
                    sub_view.setText(subtext)
                    sub_view.setTextSize(1, 11.0)
                    sub_view.setTextColor(text_hint)
                    texts.addView(sub_view, LayoutHelper.createLinear(-1, -2))

                row.addView(texts, LayoutHelper.createLinear(0, -2, 1.0))

                mark = View(self.activity)
                mark.setBackground(circle_solid(accent) if effect_id == current
                                   else circle_outline(_alpha(text_primary, 0.25)))
                row.addView(mark, LayoutHelper.createLinear(18, 18))

                row.setOnClickListener(OnClickListener(lambda v, chosen=effect_id: self._pick(chosen)))
                self._rows[effect_id] = (row, name_view, mark)
                card.addView(row, LayoutHelper.createLinear(-1, -2))

            content.addView(card, LayoutHelper.createLinear(-1, -2, 0.0, 0, 0, 0, 10))

        presets = get_presets()
        subtexts = get_preset_subtexts()
        builtins = [(index, presets[index][1], presets[index][0], subtexts.get(index, ""))
                    for index in range(len(presets))]
        add_section(_tr("Пресеты", "Presets"), builtins)

        customs = []
        for effect in self.plugin.get_setting("custom_effects", []):
            customs.append((effect.get("id"), effect.get("emoji", "\U0001F39B"),
                            effect.get("name", _tr("Кастомный", "Custom")), _tr("Свой эффект", "Custom effect")))
        add_section(_tr("Мои эффекты", "My effects"), customs)

        scroll.addView(content, LayoutHelper.createFrame(-1, -2))
        root.addView(scroll, LayoutHelper.createLinear(-1, 360))
        return root

    def _pick(self, effect_id):
        self.plugin.set_effect(effect_id)
        run_on_ui_thread(self.dismiss)

    def show(self):
        BottomSheet = find_class("org.telegram.ui.ActionBar.BottomSheet")
        try:
            self.sheet = BottomSheet(self.activity, False)
            self.sheet.setCustomView(self._build())
            plugin = self.plugin
            wrapper = self
            dismiss_class = find_class("android.content.DialogInterface$OnDismissListener")
            if dismiss_class:
                class _Dismiss(dynamic_proxy(dismiss_class)):
                    def onDismiss(self, dialog):
                        if plugin.active_sheet is wrapper:
                            plugin.active_sheet = None
                self.sheet.setOnDismissListener(_Dismiss())
            self.sheet.show()
        except Exception as exc:
            log(f"{TAG} sheet show error: {exc}\n{traceback.format_exc()}")

    def dismiss(self):
        try:
            if self.sheet:
                self.sheet.dismiss()
        except Exception:
            pass
        self.sheet = None


class VoiceChangerRTPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.core = None
        self.hooks = []
        self.streams = {}
        self.ignored = set()
        self.local = threading.local()
        self.fatal = False
        self.batch_hooked = False
        self.menu_id = None
        self.active_sheet = None

    def on_plugin_load(self):
        log(f"{TAG} loading v{__version__}")
        self.streams = {}
        self.ignored = set()
        self.fatal = False
        try:
            self.core = NativeCore(self._cache_dir())
        except Exception as exc:
            self.core = None
            log(f"{TAG} FATAL: cannot load native core: {exc}\n{traceback.format_exc()}")
            return
        self._install_hooks()
        self._register_menu()

    def on_plugin_unload(self):
        if self.menu_id:
            try:
                self.remove_menu_item(self.menu_id)
            except Exception:
                pass
            self.menu_id = None
        for hook in self.hooks:
            try:
                self.unhook_method(hook)
            except Exception:
                pass
        self.hooks = []
        for stream in list(self.streams.values()):
            stream.close()
        self.streams = {}
        log(f"{TAG} unloaded")

    def _cache_dir(self):
        try:
            context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            return str(context.getCacheDir().getAbsolutePath())
        except Exception as exc:
            log(f"{TAG} cache dir unavailable: {exc}")
            return "."

    @staticmethod
    def _ref(clazz):
        if clazz is None:
            return None
        try:
            getattr(clazz, "getDeclaredMethod")
            return clazz
        except Exception:
            pass
        try:
            return clazz.getClass()
        except Exception:
            return clazz

    def _java_class(self, name):
        resolved = self._ref(find_class(name))
        try:
            getattr(resolved, "getDeclaredMethod")
            return resolved
        except Exception:
            pass
        try:
            return jclass("java.lang.Class").forName(name)
        except Exception:
            return None

    def _install_hooks(self):
        audio_record = self._java_class("android.media.AudioRecord")
        if audio_record is None:
            log(f"{TAG} FATAL: android.media.AudioRecord not found")
            return

        kinds = {"java.nio.ByteBuffer": "bb", "[B": "byte", "[S": "short"}
        try:
            for method in audio_record.getDeclaredMethods():
                name = str(method.getName())
                if name == "read":
                    types = [str(p.getName()) for p in method.getParameterTypes()]
                    kind = kinds.get(types[0] if types else "")
                    if kind is None or len(types) != (2 if kind == "bb" else 3):
                        continue
                    method.setAccessible(True)
                    hook = self.hook_method(method, ReadHook(self, kind))
                    if hook:
                        self.hooks.append(hook)
                elif name in ("release", "stop"):
                    method.setAccessible(True)
                    hook = self.hook_method(method, ReleaseHook(self))
                    if hook:
                        self.hooks.append(hook)
        except Exception as exc:
            log(f"{TAG} hook installation failed: {exc}\n{traceback.format_exc()}")

        self._hook_round_batch()

        if not self.hooks:
            log(f"{TAG} FATAL: no hooks installed")

    def _hook_round_batch(self):
        cls = self._java_class("com.exteragram.messenger.camera.RoundVideoEncoder")
        if cls is None:
            return
        try:
            for method in cls.getDeclaredMethods():
                name = str(method.getName())
                if name == "handleAudioBatch" and len(method.getParameterTypes()) == 1:
                    method.setAccessible(True)
                    hook = self.hook_method(method, BatchHook(self))
                    if hook:
                        self.hooks.append(hook)
                        self.batch_hooked = True
                elif name == "handleAudioCaptureFinished":
                    method.setAccessible(True)
                    hook = self.hook_method(method, CaptureFinishedHook(self))
                    if hook:
                        self.hooks.append(hook)
        except Exception as exc:
            log(f"{TAG} batch hook failed: {exc}")

    def _register_menu(self):
        try:
            self.menu_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="Voice Changer",
                    on_click=self._on_menu_click,
                    icon="msg_filled_data_voice",
                    priority=50,
                )
            )
        except Exception as exc:
            log(f"{TAG} menu register error: {exc}")

    def _on_menu_click(self, context):
        fragment = context.get("fragment")
        if fragment:
            run_on_ui_thread(lambda: self._show_sheet(fragment))

    def _show_sheet(self, fragment):
        try:
            activity = fragment.getParentActivity()
            if not activity:
                return
            sheet = VoiceChangerSheet(self, activity, fragment)
            sheet.show()
            self.active_sheet = sheet
        except Exception as exc:
            log(f"{TAG} sheet error: {exc}\n{traceback.format_exc()}")

    def on_fatal(self, exc):
        if not self.fatal:
            self.fatal = True
            log(f"{TAG} FATAL in hot path: {exc}\n{traceback.format_exc()}")

    def _detect_source(self):
        try:
            trace = jclass("java.lang.Thread").currentThread().getStackTrace()
            for element in trace:
                name = str(element.getClassName())
                if "WebRtcAudioRecord" in name:
                    return SRC_CALL
                if "RoundVideoEncoder" in name or "InstantCameraView" in name:
                    return SRC_ROUND
                if "MediaController" in name:
                    return SRC_VOICE
        except Exception:
            pass
        return SRC_UNKNOWN

    def _stream_for(self, recorder):
        key = int(recorder.hashCode())
        stream = self.streams.get(key)
        if stream is not None:
            return stream
        if key in self.ignored:
            return None

        source = self._detect_source()
        if source == SRC_UNKNOWN:
            self.ignored.add(key)
            return None
        try:
            rate = int(recorder.getSampleRate())
        except Exception:
            rate = 48000

        stream = Stream(self.core, rate, source)
        self.streams[key] = stream
        self._push_params(stream)
        log(f"{TAG} stream {SRC_NAMES[source]} sr={rate}")
        return stream

    def drop_stream(self, recorder):
        if recorder is None:
            return
        key = int(recorder.hashCode())
        self.ignored.discard(key)
        stream = self.streams.pop(key, None)
        if stream is not None:
            stream.close()

    def drop_owner_stream(self, encoder):
        if encoder is None:
            return
        key = int(encoder.hashCode())
        stream = self.streams.pop(key, None)
        if stream is not None:
            stream.close()

    def bypass_stream(self, stream):
        params = self._build_params()
        params.bypass = 1
        self.core.lib.vc_set_params(stream.handle, ctypes.byref(params))

    def current_effect_id(self):
        return self.get_setting("effect", PRESET_OFF)

    def set_effect(self, effect_id):
        self.set_setting("effect", effect_id, reload_settings=False)
        self.set_setting("effect_index", self._effect_index(), reload_settings=False)
        self._on_settings_changed()
        name, emoji = self.effect_label(effect_id)
        try:
            BulletinHelper.show_info(f"{emoji} {name}", get_last_fragment())
        except Exception:
            pass

    def effect_label(self, effect_id):
        if effect_id >= CUSTOM_ID_BASE:
            for effect in self.get_setting("custom_effects", []):
                if effect.get("id") == effect_id:
                    return effect.get("name", _tr("Кастомный", "Custom")), effect.get("emoji", "\U0001F39B")
            return _tr("Кастомный", "Custom"), "\U0001F39B"
        presets = get_presets()
        if 0 <= effect_id < len(presets):
            return presets[effect_id][0], presets[effect_id][1]
        return _tr("Выкл", "Off"), presets[0][1]

    def _custom_params(self, effect):
        params = VcParams()
        params.pitch = PITCH_VALUES[effect.get("pitch", 5)]
        params.formant = FORMANT_VALUES[effect.get("formant", 3)]
        params.ring_hz = RING_VALUES[effect.get("ring", 0)]
        params.ring_depth = 0.7 if params.ring_hz > 0 else 0.0
        params.drive = MIX_VALUES[effect.get("drive", 0)]
        params.chorus = MIX_VALUES[effect.get("chorus", 0)]
        params.delay_ms = DELAY_VALUES[effect.get("delay", 0)]
        params.feedback = MIX_VALUES[effect.get("feedback", 0)]
        params.echo_mix = 0.35 if params.delay_ms > 0 else 0.0
        params.reverb = MIX_VALUES[effect.get("reverb", 0)]
        params.gate_db = GATE_VALUES[self.get_setting("gate", 0)]
        params.output_gain = 1.0
        params.bypass = 0
        return params

    def _build_params(self):
        effect_id = self.current_effect_id()

        if effect_id >= CUSTOM_ID_BASE:
            for effect in self.get_setting("custom_effects", []):
                if effect.get("id") == effect_id:
                    return self._custom_params(effect)

        params = VcParams()
        params.pitch = 1.0
        params.formant = 1.0
        params.gate_db = GATE_VALUES[self.get_setting("gate", 0)]
        params.output_gain = 1.0
        params.bypass = 0

        preset = PRESETS[effect_id][2] if 0 <= effect_id < len(PRESETS) else None
        if not isinstance(preset, dict):
            params.bypass = 1
            return params
        for field, value in preset.items():
            setattr(params, field, float(value))
        return params

    def _push_params(self, stream):
        params = self._build_params()
        if stream.tripped:
            params.bypass = 1
        self.core.lib.vc_set_params(stream.handle, ctypes.byref(params))

    def _on_settings_changed(self, *args):
        for stream in self.streams.values():
            if stream is not None:
                try:
                    self._push_params(stream)
                except Exception as exc:
                    log(f"{TAG} pushing params failed: {exc}")

    def on_frame(self, param, kind):
        if self.fatal or self.core is None:
            return
        if not self.get_setting("enabled", True):
            return
        if self.current_effect_id() == PRESET_OFF:
            return

        count = param.getResult()
        if count is None:
            return
        count = int(count)
        if count <= 0:
            return

        recorder = param.thisObject
        if recorder is None:
            return
        target = param.args[0]

        stream = self._stream_for(recorder)
        if stream is None or not self.get_setting(SRC_SETTING[stream.source], True):
            return

        try:
            identity = int(jclass("java.lang.System").identityHashCode(target))
        except Exception:
            identity = 0
        now = time.perf_counter()
        seen = getattr(self.local, "seen", None)
        if seen is not None and seen[0] == identity and seen[1] == count and now - seen[2] < 0.0005:
            return
        self.local.seen = (identity, count, now)

        if stream.source == SRC_ROUND and self.batch_hooked:
            return
        if stream.kind == "?":
            stream.kind = kind

        if kind == "bb":
            n_bytes = count
            if n_bytes > int(target.capacity()):
                return
            position = int(target.position())
            limit = int(target.limit())

            scratch = stream.buffer(n_bytes)
            target.limit(n_bytes)
            target.position(0)
            target.get(scratch)

            stream.process_in_place()

            target.position(0)
            target.put(scratch)
            target.limit(limit)
            target.position(min(position, limit))
        else:
            try:
                offset = int(param.args[1])
            except Exception:
                offset = 0
            segment = target[offset:offset + count]
            if kind == "byte":
                n_bytes = count
                scratch = stream.buffer(n_bytes)
                scratch[:] = bytes(segment)
                stream.process_in_place()
                target[offset:offset + count] = bytes(scratch)
            else:
                n_bytes = count * 2
                scratch = stream.buffer(n_bytes)
                scratch[:] = struct.pack(f"<{count}h", *segment)
                stream.process_in_place()
                target[offset:offset + count] = struct.unpack(f"<{count}h", bytes(scratch))

        elapsed_ms = (time.perf_counter() - now) * 1000.0
        frame_ms = (n_bytes / 2.0) * 1000.0 / stream.sample_rate
        stream.note_timing(elapsed_ms, frame_ms, self)

    def on_audio_batch(self, encoder, batch):
        if self.fatal or self.core is None or encoder is None or batch is None:
            return
        if not self.get_setting("enabled", True):
            return
        if self.current_effect_id() == PRESET_OFF:
            return
        if not self.get_setting("enable_round", True):
            return

        results = get_private_field(batch, "results")
        buffers = get_private_field(batch, "buffer")
        if results is None or buffers is None:
            return
        results = int(results)
        if results <= 0:
            return

        key = int(encoder.hashCode())
        stream = self.streams.get(key)
        if stream is None:
            stream = Stream(self.core, self._capture_rate(encoder), SRC_ROUND)
            stream.kind = "batch"
            self.streams[key] = stream
            self._push_params(stream)
            log(f"{TAG} stream round batch sr={stream.sample_rate}")

        started = time.perf_counter()
        total_bytes = 0

        for index in range(results):
            buf = buffers[index]
            if buf is None:
                continue
            limit = int(buf.limit())
            position = int(buf.position())
            length = limit - position
            if length <= 1:
                continue

            scratch = stream.buffer(length)
            buf.position(position)
            buf.get(scratch)

            stream.process_in_place()

            buf.position(position)
            buf.put(scratch)
            buf.position(position)
            buf.limit(limit)
            total_bytes += length

        if total_bytes:
            elapsed_ms = (time.perf_counter() - started) * 1000.0
            frame_ms = (total_bytes / 2.0) * 1000.0 / stream.sample_rate
            stream.note_timing(elapsed_ms, frame_ms, self)

    def _capture_rate(self, encoder):
        try:
            session = get_private_field(encoder, "activeAudioCapture")
            recorder = get_private_field(session, "audioRecorder")
            return int(recorder.getSampleRate())
        except Exception:
            return 48000

    def _effect_items(self):
        presets = get_presets()
        items = [f"{emoji} {name}" for name, emoji, _ in presets]
        for effect in self.get_setting("custom_effects", []):
            items.append(f"{effect.get('emoji', '')} {effect.get('name', _tr('Кастомный', 'Custom'))}")
        return items

    def _effect_index(self):
        effect_id = self.current_effect_id()
        presets = get_presets()
        if effect_id < CUSTOM_ID_BASE:
            return effect_id if 0 <= effect_id < len(presets) else 0
        for index, effect in enumerate(self.get_setting("custom_effects", [])):
            if effect.get("id") == effect_id:
                return len(presets) + index
        return 0

    def _on_effect_index_change(self, index):
        presets = get_presets()
        if index < len(presets):
            self.set_setting("effect", index, reload_settings=False)
        else:
            customs = self.get_setting("custom_effects", [])
            position = index - len(presets)
            if position < len(customs):
                self.set_setting("effect", customs[position]["id"], reload_settings=False)
        self._on_settings_changed()

    def create_settings(self) -> List[Any]:
        settings = [
            Header(text="Voice Changer RT"),
            Switch(
                key="enabled",
                text=_tr("Включить", "Enable"),
                default=True,
                subtext=_tr("Обработка микрофона «на лету» до кодирования Telegram", "Processes the microphone live, before Telegram encodes it"),
                icon="msg_filled_data_voice",
            ),
            Selector(
                key="effect_index",
                text=_tr("Эффект", "Effect"),
                default=0,
                items=self._effect_items(),
                icon="msg_photo_settings",
                on_change=self._on_effect_index_change,
            ),
            Selector(
                key="gate",
                text=_tr("Шумоподавитель", "Noise gate"),
                default=0,
                items=get_gate_items(),
                icon="msg_mute",
                on_change=self._on_settings_changed,
            ),
            Divider(text=_tr("Скорость и реверс недоступны в реальном времени: каждый кадр должен возвращать ровно столько сэмплов, сколько получил.",
                             "Speed and reverse are not available live: every frame must return exactly as many samples as it received.")),
            Header(text=_tr("Где применять", "Where it applies")),
            Switch(
                key="enable_calls",
                text=_tr("Звонки и видеочаты", "Calls and video chats"),
                default=True,
                subtext=_tr("Добавляет около 30 мс задержки. Используйте наушники, если на устройстве нет эхоподавления",
                            "Adds about 30 ms of delay. Use headphones if your device has no hardware echo canceller"),
                icon="msg_calls",
            ),
            Switch(
                key="enable_round",
                text=_tr("Видеосообщения", "Round videos"),
                default=True,
                icon="msg_videocall",
            ),
            Switch(
                key="enable_voice",
                text=_tr("Голосовые сообщения", "Voice messages"),
                default=True,
                icon="msg_voice_unmuted",
            ),
            Divider(),
            Header(text=_tr("Мои эффекты", "My effects")),
        ]

        for effect in self.get_setting("custom_effects", []):
            effect_id = effect["id"]
            page_name = f"_edit_page_{effect_id}"
            setattr(self, page_name,
                    lambda *args, effect_id=effect_id, **kwargs: self._create_edit_page(effect_id))
            settings.append(Text(
                text=f"{effect.get('emoji', '')} {effect.get('name', _tr('Кастомный', 'Custom'))}",
                icon="msg_settings",
                on_click=lambda view, effect_id=effect_id: self._prepare_edit(effect_id),
                create_sub_fragment=getattr(self, page_name),
            ))

        settings.append(Text(
            text=_tr("Добавить свой эффект", "Add custom effect"),
            icon="msg_add",
            accent=True,
            on_click=self._prepare_add,
            create_sub_fragment=self._create_add_page,
        ))

        settings.extend([
            Divider(),
            Text(
                text="@mraniv & @anivplugins",
                subtext=_tr("автор, нажмите чтобы подписаться", "author, click to subscribe"),
                icon="msg_info",
                on_click=self._open_author_channel,
            ),
        ])
        return settings

    def _open_author_channel(self, view=None):
        try:
            Browser = find_class("org.telegram.messenger.browser.Browser")
            context = view.getContext() if view and hasattr(view, "getContext") else jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            Browser.openUrl(context, "https://anivplugins.t.me")
        except Exception as e:
            self.log(f"open channel error: {e}")

    def _editor_rows(self):
        return [
            Input(key="tmp_name", text=_tr("Название", "Name"), default=_tr("Мой эффект", "My effect"), icon="menu_tag_rename"),
            Input(key="tmp_emoji", text=_tr("Эмодзи", "Emoji"), default="\U0001F39B", icon="files_gallery"),
            Selector(key="tmp_pitch", text=_tr("Pitch (высота)", "Pitch"), default=5, items=PITCH_ITEMS, icon="msg_settings"),
            Selector(key="tmp_formant", text=_tr("Форманта", "Formant"), default=3, items=FORMANT_ITEMS, icon="msg_settings"),
            Selector(key="tmp_ring", text=_tr("Робот", "Robot"), default=0, items=get_ring_items(), icon="msg_settings"),
            Selector(key="tmp_drive", text=_tr("Дистошн", "Distortion"), default=0, items=get_mix_items(), icon="msg_settings"),
            Selector(key="tmp_chorus", text=_tr("Хорус", "Chorus"), default=0, items=get_mix_items(), icon="msg_settings"),
            Selector(key="tmp_delay", text=_tr("Задержка эхо", "Echo delay"), default=0, items=get_delay_items(), icon="msg_settings"),
            Selector(key="tmp_feedback", text=_tr("Обратная связь эхо", "Echo feedback"), default=0, items=get_mix_items(), icon="msg_settings"),
            Selector(key="tmp_reverb", text=_tr("Реверберация", "Reverb"), default=0, items=get_mix_items(), icon="msg_settings"),
        ]

    def _prepare_add(self, view=None):
        for key, value in (("tmp_name", _tr("Мой эффект", "My effect")), ("tmp_emoji", "\U0001F39B"),
                           ("tmp_pitch", 5), ("tmp_formant", 3), ("tmp_ring", 0),
                           ("tmp_drive", 0), ("tmp_chorus", 0), ("tmp_delay", 0),
                           ("tmp_feedback", 0), ("tmp_reverb", 0), ("tmp_edit_id", -1)):
            self.set_setting(key, value, reload_settings=False)

    def _create_add_page(self, *args, **kwargs) -> List[Any]:
        return [Header(text=_tr("Новый эффект", "New effect"))] + self._editor_rows() + [
            Divider(),
            Text(text=_tr("Сохранить", "Save"), icon="msg_done", accent=True, on_click=self._on_save_new),
        ]

    def _prepare_edit(self, effect_id):
        for effect in self.get_setting("custom_effects", []):
            if effect.get("id") != effect_id:
                continue
            self.set_setting("tmp_edit_id", effect_id, reload_settings=False)
            self.set_setting("tmp_name", effect.get("name", ""), reload_settings=False)
            self.set_setting("tmp_emoji", effect.get("emoji", "\U0001F39B"), reload_settings=False)
            for key in ("pitch", "formant", "ring", "drive", "chorus", "delay", "feedback", "reverb"):
                self.set_setting(f"tmp_{key}", effect.get(key, 0), reload_settings=False)
            return

    def _create_edit_page(self, effect_id, *args, **kwargs) -> List[Any]:
        self._prepare_edit(effect_id)
        return [Header(text=_tr("Редактирование эффекта", "Edit effect"))] + self._editor_rows() + [
            Divider(),
            Text(text=_tr("Сохранить", "Save"), icon="msg_done", accent=True,
                 on_click=lambda view, effect_id=effect_id: self._on_save_edited(effect_id)),
            Text(text=_tr("Удалить", "Delete"), icon="msg_delete", red=True,
                 on_click=lambda view, effect_id=effect_id: self._on_delete(effect_id)),
        ]

    def _store_customs(self, customs):
        try:
            self.set_setting("custom_effects", customs, reload_settings=True)
        except Exception as exc:
            log(f"{TAG} settings reload failed: {exc}")
            self.set_setting("custom_effects", customs, reload_settings=False)
        try:
            self.set_setting("effect_index", self._effect_index(), reload_settings=False)
        except Exception:
            pass

    def _collect_editor(self):
        name = str(self.get_setting("tmp_name", "")).strip()
        emoji = str(self.get_setting("tmp_emoji", "\U0001F39B")).strip()
        if not name:
            BulletinHelper.show_error(_tr("Введите название", "Enter a name"), get_last_fragment())
            return None
        if not is_emoji_only(emoji):
            BulletinHelper.show_error(_tr("Только эмодзи (до 3 символов)", "Emoji only, up to three"), get_last_fragment())
            return None
        return {
            "name": name,
            "emoji": emoji,
            "pitch": self.get_setting("tmp_pitch", 5),
            "formant": self.get_setting("tmp_formant", 3),
            "ring": self.get_setting("tmp_ring", 0),
            "drive": self.get_setting("tmp_drive", 0),
            "chorus": self.get_setting("tmp_chorus", 0),
            "delay": self.get_setting("tmp_delay", 0),
            "feedback": self.get_setting("tmp_feedback", 0),
            "reverb": self.get_setting("tmp_reverb", 0),
        }

    def _on_save_new(self, view=None):
        data = self._collect_editor()
        if data is None:
            return
        customs = list(self.get_setting("custom_effects", []))
        next_id = CUSTOM_ID_BASE
        for effect in customs:
            next_id = max(next_id, int(effect.get("id", CUSTOM_ID_BASE)) + 1)
        data["id"] = next_id
        customs.append(data)
        self._store_customs(customs)
        BulletinHelper.show_success(_tr(f"{data['emoji']} {data['name']} сохранён", f"{data['emoji']} {data['name']} saved"), get_last_fragment())

    def _on_save_edited(self, effect_id, view=None):
        data = self._collect_editor()
        if data is None:
            return
        customs = list(self.get_setting("custom_effects", []))
        for index, effect in enumerate(customs):
            if effect.get("id") == effect_id:
                data["id"] = effect_id
                customs[index] = data
                break
        self._store_customs(customs)
        self._on_settings_changed()
        BulletinHelper.show_success(_tr("Сохранено", "Saved"), get_last_fragment())

    def _on_delete(self, effect_id, view=None):
        customs = [e for e in self.get_setting("custom_effects", []) if e.get("id") != effect_id]
        if self.current_effect_id() == effect_id:
            self.set_setting("effect", PRESET_OFF, reload_settings=False)
        self._store_customs(customs)
        self._on_settings_changed()
        BulletinHelper.show_info(_tr("Удалено", "Deleted"), get_last_fragment())
