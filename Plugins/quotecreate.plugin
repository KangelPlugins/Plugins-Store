    def _on_bg_type_change(self, *args):
        self.set_setting("bg_type", self.get_setting("bg_type", 0), reload_settings=True)

    def _on_output_format_change(self, *args):
        self.set_setting("output_format", self.get_setting("output_format", 0), reload_settings=True)

    def _on_watermark_tile_change(self, *args):
        self._invalidate_watermark_preview()

    def _on_fake_name_change(self, *args):
        self.set_setting("anonymize_fake_name", self.get_setting("anonymize_fake_name", False), reload_settings=True)

    def _output_format_name(self):
        return "JPEG" if int(self.get_setting("output_format", 0) or 0) == 1 else "PNG"

    def _output_format_hint(self):
        if int(self.get_setting("output_format", 0) or 0) == 1:
            return f"JPEG {self._setting_int_clamped('jpeg_quality', 92, 40, 100)}%"
        return "PNG без сжатия"

    def _output_extension(self):
        return "jpg" if self._output_format_name() == "JPEG" else "png"

    def _output_mime(self):
        return "image/jpeg" if self._output_format_name() == "JPEG" else "image/png"

    def _render_scale_factor(self):
        index = int(self.get_setting("render_scale", 0) or 0)
        return {0: 1.0, 1: 1.5, 2: 2.0}.get(index, 1.0)

    def _pick_chat_and_send(self, data):
        DialogsActivityDelegate = find_class("org.telegram.ui.DialogsActivity$DialogsActivityDelegate")
        if DialogsActivityDelegate is None:
            return BulletinHelper.show_error("Выбор чата недоступен")

        plugin = self

        class _QuotePickerDelegate(dynamic_proxy(DialogsActivityDelegate)):
            def __init__(self):
                super().__init__()

            def didSelectDialogs(self, fragment, dids, *args):
                try:
                    plugin._on_chat_picked(fragment, dids, data)
                except Exception as e:
                    log(f"[QuoteCreate] Chat pick failed: {e}")
                    BulletinHelper.show_error("Не удалось отправить цитату")
                return True

            def canSelectStories(self):
                return False

            def didSelectStories(self, fragment):
                return False

        def open_now():
            try:
                from org.telegram.ui import DialogsActivity

                fragment = get_last_fragment()
                if fragment is None:
                    return BulletinHelper.show_error("Нет активного экрана")

                args = Bundle()
                args.putBoolean("onlySelect", True)
                args.putInt("dialogsType", DIALOGS_TYPE_FORWARD)
                args.putBoolean("resetDelegate", False)
                args.putBoolean("closeFragment", True)
                args.putBoolean("canSelectTopics", True)
                args.putBoolean("checkCanWrite", True)
                args.putBoolean("allowGlobalSearch", True)
                args.putBoolean("allowUsers", True)
                args.putBoolean("allowBots", True)
                args.putBoolean("allowGroups", True)
                args.putBoolean("allowMegagroups", True)
                args.putBoolean("allowLegacyGroups", True)
                args.putBoolean("allowChannels", True)

                picker = DialogsActivity(args)
                delegate = _QuotePickerDelegate()
                self._picker_delegates.append(delegate)
                picker.setDelegate(delegate)
                fragment.presentFragment(picker)
            except Exception as e:
                log(f"[QuoteCreate] Chat picker open failed: {e}")
                BulletinHelper.show_error("Не удалось открыть выбор чата")

        run_on_ui_thread(open_now)

    def _on_chat_picked(self, fragment, dids, data):
        dialog_id, topic_id = self._picked_dialog(dids)
        if dialog_id == 0:
            return BulletinHelper.show_error("Чат не выбран")
        reply_to_top_msg = _make_top_reply(topic_id, dialog_id) if topic_id > 0 else None
        self._picker_delegates.clear()
        try:
            if fragment is not None:
                fragment.finishFragment()
        except Exception:
            pass
        self._send(data, dialog_id, reply_to_top_msg, send_mode="photo")

    def _picked_dialog(self, dids):
        if dids is None:
            return 0, 0
        entry = None
        try:
            if dids.size() <= 0:
                return 0, 0
            entry = dids.get(0)
        except Exception:
            try:
                entry = dids[0]
            except Exception:
                return 0, 0
        dialog_id = 0
        topic_id = 0
        for name in ("dialogId", "dialog_id"):
            try:
                value = int(getattr(entry, name, 0) or 0)
                if value != 0:
                    dialog_id = value
                    break
            except Exception:
                pass
        for name in ("topicId", "topic_id"):
            try:
                value = int(getattr(entry, name, 0) or 0)
                if value > 0:
                    topic_id = value
                    break
            except Exception:
                pass
        if dialog_id == 0:
            for getter in (lambda: int(entry), lambda: int(entry.longValue())):
                try:
                    dialog_id = getter()
                    if dialog_id != 0:
                        break
                except Exception:
                    pass
        return dialog_id, max(0, topic_id)

    def _keep_settings_factory(self, factory):
        try:
            self._watermark_settings_factories.append(factory)
        except Exception:
            self._watermark_settings_factories = [factory]
        return factory.instance.java

    def _settings_theme_color(self, key, resources_provider=None, fallback=0xFF000000):
        try:
            if resources_provider is not None:
                return as_java_color(Theme.getColor(key, resources_provider))
        except Exception:
            pass
        try:
            return as_java_color(Theme.getColor(key))
        except Exception:
            return as_java_color(fallback)

    def _settings_text(self, context, text, size_dp, color, bold=False):
        from android.graphics import Typeface
        from android.util import TypedValue
        from android.widget import TextView

        view = TextView(context)
        view.setText(text)
        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, float(size_dp))
        call_int_color(view, "setTextColor", color)
        view.setSingleLine(True)
        if bold:
            try:
                view.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            except Exception:
                view.setTypeface(Typeface.DEFAULT_BOLD)
        return view

    def _invalidate_watermark_preview(self):
        try:
            views = list(self._watermark_preview_views or [])
        except Exception:
            views = []
        for view in views:
            try:
                view.invalidate()
            except Exception:
                pass

    def _watermark_preview_factory(self):
        from ui.settings import SimpleSettingFactory

        plugin = self

        def create_view(context, list_view, current_account, class_guid, resources_provider):
            from android.view import Gravity, View
            from android.widget import LinearLayout
            from org.telegram.ui.Components import LayoutHelper

            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(21), AndroidUtilities.dp(10), AndroidUtilities.dp(21), AndroidUtilities.dp(12))

            title_view = plugin._settings_text(
                context,
                "Предпросмотр",
                16,
                plugin._settings_theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider, 0xFF111111),
                True,
            )
            root.addView(title_view, LayoutHelper.createLinear(-1, -2))

            UniversalView = find_class("com.exteragram.messenger.plugins.ui.components.templates.UniversalView")
            Delegate = find_class("com.exteragram.messenger.plugins.ui.components.templates.UniversalView$UniversalViewDelegate")
            if not UniversalView or not Delegate:
                unavailable = plugin._settings_text(
                    context,
                    "Предпросмотр недоступен",
                    13,
                    plugin._settings_theme_color(Theme.key_windowBackgroundWhiteGrayText2, resources_provider, 0xFF7D7D7D),
                )
                root.addView(unavailable, LayoutHelper.createLinear(-1, -2, 0, 8, 0, 0, 0))
                return root

            class _PreviewDelegate(dynamic_proxy(Delegate)):
                def __init__(self):
                    super().__init__()

                def onDraw(self, canvas, callback):
                    try:
                        callback.run(canvas)
                    except Exception:
                        pass
                    plugin._draw_watermark_settings_preview(canvas, resources_provider)

                def onMeasure(self, width_spec, height_spec, callback):
                    try:
                        callback.run(Integer(width_spec), Integer(height_spec))
                    except Exception:
                        pass

                def onAttachedToWindow(self):
                    return None

                def onDetachedFromWindow(self):
                    return None

                def onTouchEvent(self, motion_event, callback):
                    try:
                        return bool(callback.run(motion_event))
                    except Exception:
                        return False

                def onInitializeAccessibilityNodeInfo(self, info, callback):
                    try:
                        callback.run(info)
                    except Exception:
                        pass

            delegate = _PreviewDelegate()
            preview = UniversalView(context, delegate)
            try:
                preview.setWillNotDraw(False)
            except Exception:
                pass
            try:
                preview.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
            except Exception:
                pass

            try:
                plugin._watermark_preview_delegates.append(delegate)
                plugin._watermark_preview_views.append(preview)
            except Exception:
                plugin._watermark_preview_delegates = [delegate]
                plugin._watermark_preview_views = [preview]

            root.addView(preview, LayoutHelper.createLinear(-1, 150, 0, 8, 0, 0, 0))
            root.setGravity(Gravity.CENTER_VERTICAL)
            return root

        def bind_view(view, item, divider, adapter, list_view):
            try:
                view.getChildAt(1).invalidate()
            except Exception:
                pass

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def _watermark_logo_path(self):
        try:
            path = str(self.get_setting("watermark_logo_path", "") or "").strip()
        except Exception:
            return ""
        if path and os.path.exists(path):
            return path
        return ""

    def _watermark_logo_state(self):
        path = self._watermark_logo_path()
        if not path:
            return "не выбран"
        return os.path.basename(path)

    def _watermark_text_resolved(self, chat=None, count=None):
        try:
            text = str(self.get_setting("watermark_text", "@username") or "").strip()
        except Exception:
            text = "@username"
        if not text:
            text = "@username"
        if "{" not in text:
            return text
        try:
            date_value = time.strftime("%d.%m.%Y")
        except Exception:
            date_value = ""
        chat_value = ""
        try:
            if chat is not None:
                current_chat = get_private_field(chat, "currentChat")
                current_user = get_private_field(chat, "currentUser")
                if current_chat is not None:
                    chat_value = str(getattr(current_chat, "title", "") or "")
                elif current_user is not None:
                    chat_value = str(UserObject.getUserName(current_user) or "")
        except Exception:
            chat_value = ""
        count_value = str(int(count)) if count is not None else ""
        return (
            text.replace("{date}", date_value)
                .replace("{chat}", chat_value)
                .replace("{count}", count_value)
        )

    def _watermark_layout(self, paint, text, width, height, scale=1.0):
        size_dp = max(1, int(round(self._setting_int_clamped("watermark_size", 13, 8, 48) * scale)))
        opacity = self._setting_int_clamped("watermark_opacity", 72, 5, 100)
        edge_pad = int(round(AndroidUtilities.dp(self._setting_int_clamped("watermark_padding", 12, 0, 64)) * scale))
        bg_opacity = self._setting_int_clamped("watermark_bg_opacity", 36, 0, 100)
        radius = int(round(AndroidUtilities.dp(self._setting_int_clamped("watermark_bg_radius", 12, 0, 32)) * scale))
        angle = self._setting_int_clamped("watermark_angle", 0, -45, 45)
        text_color = self._argb_with_opacity(self._watermark_color_int(), opacity)

        paint.setTextSize(float(AndroidUtilities.dp(size_dp)))
        set_paint_color(paint, text_color)

        draw_text = text
        max_text_w = max(1, width - edge_pad * 2 - int(AndroidUtilities.dp(16) * scale))
        while size_dp > 8 and int(paint.measureText(draw_text) + 0.999) > max_text_w:
            size_dp -= 1
            paint.setTextSize(float(AndroidUtilities.dp(size_dp)))
        if int(paint.measureText(draw_text) + 0.999) > max_text_w:
            candidate = draw_text
            while candidate:
                shortened = candidate.rstrip() + "..."
                if int(paint.measureText(shortened) + 0.999) <= max_text_w:
                    draw_text = shortened
                    break
                candidate = candidate[:-1]
            else:
                draw_text = "..."

        text_w = int(paint.measureText(draw_text) + 0.999)
        metrics = paint.getFontMetrics()
        text_h = int((float(metrics.descent) - float(metrics.ascent)) + 0.999)
        inner_x = int(AndroidUtilities.dp(8) * scale)
        inner_y = int(AndroidUtilities.dp(5) * scale)
        box_w = max(1, text_w + inner_x * 2)
        box_h = max(1, text_h + inner_y * 2)

        position = self._setting_int_clamped("watermark_position", 0, 0, 4)
        if position == 1:
            left, top = edge_pad, height - edge_pad - box_h
        elif position == 2:
            left, top = width - edge_pad - box_w, edge_pad
        elif position == 3:
            left, top = edge_pad, edge_pad
        elif position == 4:
            left, top = int((width - box_w) / 2), int((height - box_h) / 2)
        else:
            left, top = width - edge_pad - box_w, height - edge_pad - box_h

        left = max(0, min(max(0, width - box_w), left))
        top = max(0, min(max(0, height - box_h), top))

        return {
            "text": draw_text,
            "left": left,
            "top": top,
            "box_w": box_w,
            "box_h": box_h,
            "inner_x": inner_x,
            "inner_y": inner_y,
            "ascent": float(metrics.ascent),
            "radius": radius,
            "bg_opacity": bg_opacity,
            "text_color": text_color,
            "angle": angle,
            "size_dp": size_dp,
        }

    def _draw_watermark_tiles(self, canvas, paint, layout, width, height):
        angle = layout["angle"] or -30
        step_x = max(int(layout["box_w"] * 1.6), AndroidUtilities.dp(60))
        step_y = max(int(layout["box_h"] * 3.0), AndroidUtilities.dp(52))
        span = int((width + height) * 0.75)
        canvas.save()
        try:
            canvas.rotate(float(angle), float(width) / 2.0, float(height) / 2.0)
            y = -span
            row = 0
            while y < height + span:
                offset = 0 if row % 2 == 0 else int(step_x / 2)
                x = -span + offset
                while x < width + span:
                    canvas.drawText(layout["text"], float(x), float(y), paint)
                    x += step_x
                y += step_y
                row += 1
        finally:
            canvas.restore()

    def _draw_watermark_logo(self, canvas, width, height, scale=1.0, bitmap_cache=None):
        path = self._watermark_logo_path()
        if not path:
            return
        logo = None
        try:
            logo = bitmap_cache if bitmap_cache is not None else J['BmpF'].decodeFile(path)
            if logo is None:
                return
            size = int(round(AndroidUtilities.dp(self._setting_int_clamped("watermark_logo_size", 28, 12, 96)) * scale))
            opacity = self._setting_int_clamped("watermark_logo_opacity", 80, 5, 100)
            src_w = max(1, int(logo.getWidth()))
            src_h = max(1, int(logo.getHeight()))
            ratio = float(src_h) / float(src_w)
            dst_w = max(1, size)
            dst_h = max(1, int(round(size * ratio)))

            edge_pad = int(round(AndroidUtilities.dp(self._setting_int_clamped("watermark_padding", 12, 0, 64)) * scale))
            position = self._setting_int_clamped("watermark_position", 0, 0, 4)
            if position == 1:
                left, top = edge_pad, height - edge_pad - dst_h
            elif position == 2:
                left, top = width - edge_pad - dst_w, edge_pad
            elif position == 3:
                left, top = edge_pad, edge_pad
            elif position == 4:
                left, top = int((width - dst_w) / 2), int((height - dst_h) / 2)
            else:
                left, top = width - edge_pad - dst_w, height - edge_pad - dst_h

            left = max(0, min(max(0, width - dst_w), left))
            top = max(0, min(max(0, height - dst_h), top))

            paint = J['Paint'](J['Paint'].ANTI_ALIAS_FLAG)
            try:
                paint.setFilterBitmap(True)
                paint.setAlpha(int(255 * opacity / 100))
            except Exception:
                pass
            src = J['Rect'](0, 0, src_w, src_h)
            dst = J['Rect'](left, top, left + dst_w, top + dst_h)
            canvas.drawBitmap(logo, src, dst, paint)
        except Exception as e:
            log(f"[QuoteCreate] Watermark logo draw failed: {e}")
        finally:
            if bitmap_cache is None and logo is not None:
                try:
                    logo.recycle()
                except Exception:
                    pass

    def _draw_watermark_settings_preview(self, canvas, resources_provider=None):
        try:
            from android.graphics import Paint, RectF

            width = int(canvas.getWidth())
            height = int(canvas.getHeight())
            if width <= 0 or height <= 0:
                return

            pad = AndroidUtilities.dp(8)
            area = RectF(float(pad), 0.0, float(width - pad), float(height))

            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            surface = self._settings_theme_color(Theme.key_windowBackgroundWhite, resources_provider, 0xFFF4F7FB)
            set_paint_color(paint, surface)
            canvas.drawRoundRect(area, float(AndroidUtilities.dp(14)), float(AndroidUtilities.dp(14)), paint)

            chat_bg = self._settings_theme_color(Theme.key_chat_wallpaper, resources_provider, 0xFFE7EEF6)
            set_paint_color(paint, chat_bg)
            inset = AndroidUtilities.dp(8)
            chat_rect = RectF(float(pad + inset), float(inset), float(width - pad - inset), float(height - inset))
            canvas.drawRoundRect(chat_rect, float(AndroidUtilities.dp(12)), float(AndroidUtilities.dp(12)), paint)

            in_bubble = self._settings_theme_color(getattr(Theme, "key_chat_inBubble", Theme.key_windowBackgroundWhite), resources_provider, 0xFFFFFFFF)
            out_bubble = self._settings_theme_color(getattr(Theme, "key_chat_outBubble", Theme.key_windowBackgroundWhite), resources_provider, 0xFFE1FFC7)
            text_color = self._settings_theme_color(getattr(Theme, "key_chat_messageTextIn", Theme.key_windowBackgroundWhiteBlackText), resources_provider, 0xFF222222)
            muted = self._settings_theme_color(Theme.key_windowBackgroundWhiteGrayText2, resources_provider, 0xFF7D7D7D)

            left = pad + AndroidUtilities.dp(22)
            top = AndroidUtilities.dp(24)
            bubble_w = min(AndroidUtilities.dp(188), width - AndroidUtilities.dp(92))
            bubble_h = AndroidUtilities.dp(44)
            bubble = RectF(float(left), float(top), float(left + bubble_w), float(top + bubble_h))
            set_paint_color(paint, in_bubble)
            canvas.drawRoundRect(bubble, float(AndroidUtilities.dp(13)), float(AndroidUtilities.dp(13)), paint)

            text_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            text_paint.setTextSize(float(AndroidUtilities.dp(13)))
            set_paint_color(text_paint, text_color)
            canvas.drawText("Пример сообщения", float(left + AndroidUtilities.dp(12)), float(top + AndroidUtilities.dp(27)), text_paint)

            out_w = min(AndroidUtilities.dp(178), width - AndroidUtilities.dp(100))
            out_left = width - pad - AndroidUtilities.dp(22) - out_w
            out_top = top + AndroidUtilities.dp(56)
            out_rect = RectF(float(out_left), float(out_top), float(out_left + out_w), float(out_top + AndroidUtilities.dp(46)))
            set_paint_color(paint, out_bubble)
            canvas.drawRoundRect(out_rect, float(AndroidUtilities.dp(13)), float(AndroidUtilities.dp(13)), paint)
            canvas.drawText("Так будет в цитате", float(out_left + AndroidUtilities.dp(12)), float(out_top + AndroidUtilities.dp(28)), text_paint)

            if not bool(self.get_setting("watermark_enabled", False)):
                text_paint.setTextSize(float(AndroidUtilities.dp(12)))
                set_paint_color(text_paint, self._argb_with_opacity(muted, 75))
                canvas.drawText("Водяной знак выключен", float(left), float(height - AndroidUtilities.dp(16)), text_paint)
                return

            content_left = int(chat_rect.left)
            content_top = int(chat_rect.top)
            content_w = int(chat_rect.width())
            content_h = int(chat_rect.height())

            wm_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            wm_paint.setFakeBoldText(True)
            layout = self._watermark_layout(
                wm_paint,
                self._watermark_text_resolved(count=3),
                content_w,
                content_h,
            )

            canvas.save()
            try:
                canvas.clipRect(chat_rect)
                canvas.translate(float(content_left), float(content_top))

                if bool(self.get_setting("watermark_tile", False)):
                    self._draw_watermark_tiles(canvas, wm_paint, layout, content_w, content_h)
                else:
                    wm_rect = RectF(
                        float(layout["left"]),
                        float(layout["top"]),
                        float(layout["left"] + layout["box_w"]),
                        float(layout["top"] + layout["box_h"]),
                    )
                    blur_on = bool(self.get_setting("watermark_blur_bg", True))
                    if blur_on or layout["bg_opacity"] > 0:
                        bg_base = 0xFF000000 if self._color_is_light(layout["text_color"]) else 0xFFFFFFFF
                        bg_color = self._argb_with_opacity(bg_base, max(layout["bg_opacity"], 18 if blur_on else 0))
                        set_paint_color(paint, bg_color)
                        canvas.drawRoundRect(wm_rect, float(layout["radius"]), float(layout["radius"]), paint)

                    baseline = float(layout["top"] + layout["inner_y"]) - layout["ascent"]
                    canvas.save()
                    try:
                        if layout["angle"]:
                            canvas.rotate(
                                float(layout["angle"]),
                                float(layout["left"] + layout["box_w"] / 2.0),
                                float(layout["top"] + layout["box_h"] / 2.0),
                            )
                        canvas.drawText(layout["text"], float(layout["left"] + layout["inner_x"]), baseline, wm_paint)
                    finally:
                        canvas.restore()

                self._draw_watermark_logo(canvas, content_w, content_h)
            finally:
                canvas.restore()
        except Exception as e:
            log(f"[QuoteCreate] Watermark settings preview draw failed: {e}")

    def _watermark_slider_factory(self, key, title, default, min_value, max_value, suffix):
        from ui.settings import SimpleSettingFactory

        plugin = self
        refs = []

        def current_value():
            return plugin._setting_int_clamped(key, default, min_value, max_value)

        def format_value(value):
            if not suffix:
                return str(int(value))
            if suffix in ("%", "°"):
                return f"{int(value)}{suffix}"
            return f"{int(value)} {suffix}"

        def create_view(context, list_view, current_account, class_guid, resources_provider):
            from android.view import Gravity
            from android.widget import LinearLayout
            from org.telegram.ui.Components import LayoutHelper, SeekBarView

            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(21), AndroidUtilities.dp(10), AndroidUtilities.dp(21), AndroidUtilities.dp(12))

            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)

            title_view = plugin._settings_text(
                context,
                title,
                16,
                plugin._settings_theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider, 0xFF111111),
            )
            row.addView(title_view, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0))

            value_view = plugin._settings_text(
                context,
                format_value(current_value()),
                14,
                plugin._settings_theme_color(Theme.key_windowBackgroundWhiteBlueText, resources_provider, 0xFF3390EC),
                True,
            )
            row.addView(value_view, LayoutHelper.createLinear(-2, -2))
            root.addView(row, LayoutHelper.createLinear(-1, -2))

            seek = SeekBarView(context, resources_provider)
            seek.setReportChanges(True)
            try:
                seek.setColors(
                    plugin._settings_theme_color(Theme.key_switchTrack, resources_provider, 0x33000000),
                    plugin._settings_theme_color(Theme.key_windowBackgroundWhiteBlueText, resources_provider, 0xFF3390EC),
                )
            except Exception:
                pass
            root.addView(seek, LayoutHelper.createLinear(-1, 38, 0, 2, 0, 0, 0))

            delegate_cls = find_class("org.telegram.ui.Components.SeekBarView$SeekBarViewDelegate")

            class _SliderDelegate(dynamic_proxy(delegate_cls)):
                def onSeekBarDrag(self, stop, progress):
                    try:
                        value = int(round(min_value + (max_value - min_value) * float(progress)))
                    except Exception:
                        value = default
                    value = max(min_value, min(max_value, value))
                    try:
                        value_view.setText(format_value(value))
                    except Exception:
                        pass
                    plugin.set_setting(key, str(value))
                    plugin._invalidate_watermark_preview()

                def onSeekBarPressed(self, pressed):
                    return None

                def getContentDescription(self):
                    return f"{title}: {format_value(current_value())}"

                def getStepsCount(self):
                    return int(max_value - min_value)

                def needVisuallyDivideSteps(self):
                    return False

            delegate = _SliderDelegate()
            refs.append(delegate)
            seek.setDelegate(delegate)
            return root

        def bind_view(view, item, divider, adapter, list_view):
            value = current_value()
            progress = 0.0 if max_value == min_value else float(value - min_value) / float(max_value - min_value)
            try:
                view.getChildAt(0).getChildAt(1).setText(format_value(value))
                view.getChildAt(1).setProgress(progress)
            except Exception:
                pass

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def _watermark_color_factory(self):
        from ui.settings import SimpleSettingFactory

        plugin = self
        provider_ref = [None]
        swatches = [
            ("#FFFFFFFF", 0xFFFFFFFF),
            ("#FF000000", 0xFF000000),
            ("#FF3390EC", 0xFF3390EC),
            ("#FF31B545", 0xFF31B545),
            ("#FFFFC107", 0xFFFFC107),
            ("#FFE53935", 0xFFE53935),
        ]

        def create_view(context, list_view, current_account, class_guid, resources_provider):
            from android.graphics.drawable import GradientDrawable
            from android.view import Gravity
            from android.widget import FrameLayout, ImageView, LinearLayout
            from org.telegram.ui.Components import LayoutHelper

            provider_ref[0] = resources_provider
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(21), AndroidUtilities.dp(10), AndroidUtilities.dp(21), AndroidUtilities.dp(12))

            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            title_view = plugin._settings_text(
                context,
                "Цвет текста",
                16,
                plugin._settings_theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider, 0xFF111111),
            )
            row.addView(title_view, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0))

            value_view = plugin._settings_text(
                context,
                plugin._watermark_color_text(),
                13,
                plugin._settings_theme_color(Theme.key_windowBackgroundWhiteGrayText2, resources_provider, 0xFF7D7D7D),
            )
            row.addView(value_view, LayoutHelper.createLinear(-2, -2))
            root.addView(row, LayoutHelper.createLinear(-1, -2))

            swatch_row = LinearLayout(context)
            swatch_row.setOrientation(LinearLayout.HORIZONTAL)
            swatch_row.setGravity(Gravity.CENTER_VERTICAL)

            def apply_swatch_bg(box, color, selected):
                bg = GradientDrawable()
                bg.setShape(GradientDrawable.OVAL)
                set_drawable_color(bg, color)
                stroke_color = plugin._settings_theme_color(
                    Theme.key_windowBackgroundWhiteBlueText if selected else Theme.key_divider,
                    resources_provider,
                    0xFF3390EC if selected else 0x33000000,
                )
                call_two_ints(bg, "setStroke", AndroidUtilities.dp(2 if selected else 1), stroke_color)
                box.setBackground(bg)

            def is_custom_color(hex_value):
                current = (hex_value or "").upper()
                for swatch_hex, _swatch_color in swatches:
                    if swatch_hex.upper() == current:
                        return False
                return True

            def apply_picker_bg(box, hex_value=None):
                current = (hex_value or plugin._watermark_color_text()).upper()
                selected = is_custom_color(current)
                bg = GradientDrawable()
                bg.setShape(GradientDrawable.OVAL)
                if selected:
                    try:
                        color_value = plugin._setting_color_int("watermark_color", current)
                    except Exception:
                        color_value = 0xFFFFFFFF
                    set_drawable_color(bg, color_value)
                else:
                    set_drawable_color(bg, 0x00000000)
                stroke_color = plugin._settings_theme_color(
                    Theme.key_windowBackgroundWhiteBlueText if selected else Theme.key_divider,
                    resources_provider,
                    0xFF3390EC if selected else 0x33000000,
                )
                call_two_ints(bg, "setStroke", AndroidUtilities.dp(2 if selected else 1), stroke_color)
                box.setBackground(bg)
                try:
                    icon = box.getChildAt(0)
                    icon.setVisibility(8 if selected else 0)
                    call_int_color(icon, "setColorFilter", plugin._settings_theme_color(
                        Theme.key_windowBackgroundWhiteGrayText2,
                        resources_provider,
                        0xFF7D7D7D,
                    ))
                except Exception:
                    pass

            def refresh_colors():
                current = plugin._watermark_color_text()
                try:
                    value_view.setText(current)
                except Exception:
                    pass
                for index, (box_hex, box_color) in enumerate(swatches):
                    try:
                        apply_swatch_bg(swatch_row.getChildAt(index), box_color, box_hex.upper() == current.upper())
                    except Exception:
                        pass
                try:
                    apply_picker_bg(swatch_row.getChildAt(len(swatches)), current)
                except Exception:
                    pass
                plugin._invalidate_watermark_preview()

            def select_color(hex_value, color_value):
                plugin.set_setting("watermark_color", hex_value)
                refresh_colors()

            def pick_custom_color(_v=None):
                return plugin._pick_watermark_color(lambda _color: refresh_colors())

            def icon_res(*names):
                for name in names:
                    try:
                        res = getattr(R.drawable, name, 0)
                        if res:
                            return res
                    except Exception:
                        pass
                return 0

            for hex_value, color_value in swatches:
                box = FrameLayout(context)
                box.setClickable(True)
                box.setFocusable(True)
                box.setOnClickListener(OnClickListener(lambda _v, h=hex_value, c=color_value: select_color(h, c)))
                lp = LinearLayout.LayoutParams(AndroidUtilities.dp(32), AndroidUtilities.dp(32))
                lp.rightMargin = AndroidUtilities.dp(10)
                swatch_row.addView(box, lp)

            picker_box = FrameLayout(context)
            picker_box.setClickable(True)
            picker_box.setFocusable(True)
            picker_icon = ImageView(context)
            picker_icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            picker_icon.setImageResource(icon_res("msg_palette", "msg_customize", "photo_paint"))
            picker_box.addView(picker_icon, LayoutHelper.createFrame(18, 18, Gravity.CENTER))
            picker_box.setOnClickListener(OnClickListener(pick_custom_color))
            picker_lp = LinearLayout.LayoutParams(AndroidUtilities.dp(32), AndroidUtilities.dp(32))
            picker_lp.rightMargin = AndroidUtilities.dp(10)
            swatch_row.addView(picker_box, picker_lp)

            root.addView(swatch_row, LayoutHelper.createLinear(-1, -2, 0, 9, 0, 0, 0))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            from android.graphics.drawable import GradientDrawable

            current = plugin._watermark_color_text()
            try:
                view.getChildAt(0).getChildAt(1).setText(current)
                swatch_row = view.getChildAt(1)
                for index, (hex_value, color_value) in enumerate(swatches):
                    box = swatch_row.getChildAt(index)
                    bg = GradientDrawable()
                    bg.setShape(GradientDrawable.OVAL)
                    set_drawable_color(bg, color_value)
                    selected = hex_value.upper() == current.upper()
                    stroke_color = plugin._settings_theme_color(
                        Theme.key_windowBackgroundWhiteBlueText if selected else Theme.key_divider,
                        provider_ref[0],
                        0xFF3390EC if selected else 0x33000000,
                    )
                    call_two_ints(bg, "setStroke", AndroidUtilities.dp(2 if selected else 1), stroke_color)
                    box.setBackground(bg)
                picker_box = swatch_row.getChildAt(len(swatches))
                custom_selected = True
                for hex_value, _color_value in swatches:
                    if hex_value.upper() == current.upper():
                        custom_selected = False
                        break
                picker_bg = GradientDrawable()
                picker_bg.setShape(GradientDrawable.OVAL)
                if custom_selected:
                    custom_color = plugin._setting_color_int("watermark_color", current)
                    set_drawable_color(picker_bg, custom_color)
                else:
                    set_drawable_color(picker_bg, 0x00000000)
                picker_stroke = plugin._settings_theme_color(
                    Theme.key_windowBackgroundWhiteBlueText if custom_selected else Theme.key_divider,
                    provider_ref[0],
                    0xFF3390EC if custom_selected else 0x33000000,
                )
                call_two_ints(picker_bg, "setStroke", AndroidUtilities.dp(2 if custom_selected else 1), picker_stroke)
                picker_box.setBackground(picker_bg)
                try:
                    picker_icon = picker_box.getChildAt(0)
                    picker_icon.setVisibility(8 if custom_selected else 0)
                    call_int_color(picker_icon, "setColorFilter", plugin._settings_theme_color(
                        Theme.key_windowBackgroundWhiteGrayText2,
                        provider_ref[0],
                        0xFF7D7D7D,
                    ))
                except Exception:
                    pass
            except Exception:
                pass

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def _setting_int_clamped(self, key, default, min_value, max_value):
        try:
            value = int(float(str(self.get_setting(key, str(default))).strip()))
        except Exception:
            value = int(default)
        return max(int(min_value), min(int(max_value), value))

    def _setting_color_text(self, key, default) -> str:
        val = self.get_setting(key, default)
        try:
            val = (val or "").strip()
        except Exception:
            val = str(val)
            val = (val or "").strip()

        if not val:
            val = default
        if not val.startswith("#"):
            val = "#" + val
        if len(val) == 7:
            val = "#FF" + val[1:]

        try:
            from android.graphics import Color
            Color.parseColor(val)
            return val.upper()
        except Exception:
            return default

    def _bg_color_text(self) -> str:
        return self._setting_color_text("bg_color", "#FF000000")

    def _watermark_color_text(self) -> str:
        return self._setting_color_text("watermark_color", "#FFFFFFFF")

    def _bg_color_int(self) -> int:
        return self._setting_color_int("bg_color", "#FF000000")

    def _watermark_color_int(self) -> int:
        return self._setting_color_int("watermark_color", "#FFFFFFFF")

    def _setting_color_int(self, key, default) -> int:
        try:
            from android.graphics import Color
            return int(Color.parseColor(self._setting_color_text(key, default)))
        except Exception:
            try:
                return int(str(default).replace("#", "0x"), 16)
            except Exception:
                return int(0xFFFFFFFF)

    def _hex_color(self, color: int) -> str:
        return "#{:08X}".format(int(color) & 0xFFFFFFFF)

    def _pick_bg_color(self, _=None):
        return self._pick_setting_color(
            "bg_color",
            "#FF000000",
            "Цвет фона",
            "Цвет фона выбран",
            "_bg_color_picker",
            force_bg_type=True,
        )

    def _pick_watermark_color(self, _=None):
        on_selected = _ if callable(_) else None
        return self._pick_setting_color(
            "watermark_color",
            "#FFFFFFFF",
            "Цвет водяного знака",
            "Цвет водяного знака выбран",
            "_watermark_color_picker",
            force_bg_type=False,
            on_selected=on_selected,
        )

    def _pick_setting_color(self, setting_key, default_color, title, success_text, holder_prefix, force_bg_type=False, on_selected=None):
        try:
            from client_utils import get_last_fragment

            frag = get_last_fragment()
            if not frag:
                return BulletinHelper.show_error("Не удалось открыть палитру: нет активного экрана")

            act = frag.getParentActivity()
            if not act:
                return BulletinHelper.show_error("Не удалось открыть палитру: нет Activity")

            try:
                resources_provider = frag.getResourceProvider()
            except Exception:
                resources_provider = None

            initial_color = self._setting_color_int(setting_key, default_color)

            try:
                from org.telegram.ui.Components.Paint import ColorPickerBottomSheet
                from androidx.core.util import Consumer

                PipetteDelegate = find_class("org.telegram.ui.Components.Paint.ColorPickerBottomSheet$PipetteDelegate")
                PipetteDelegateProxy = dynamic_proxy(PipetteDelegate)
                class _PipetteDelegate(PipetteDelegateProxy):
                    def __init__(self):
                        super().__init__()
                    def onStartColorPipette(self): return None
                    def onStopColorPipette(self): return None
                    def getContainerView(self): return None
                    def getSnapshotDrawingView(self): return None
                    def onDrawImageOverCanvas(self, bitmap, canvas): return None
                    def isPipetteVisible(self): return False
                    def isPipetteAvailable(self): return False
                    def onColorSelected(self, color): return None

                ConsumerProxy = dynamic_proxy(Consumer)
                class _ColorConsumer(ConsumerProxy):
                    def __init__(self, plugin, key, ok_text, set_bg_type):
                        super().__init__()
                        self._plugin = plugin
                        self._key = key
                        self._ok_text = ok_text
                        self._set_bg_type = set_bg_type
                    def accept(self, color):
                        try:
                            color_int = int(color)
                        except Exception:
                            return
                        self._plugin.set_setting(self._key, self._plugin._hex_color(color_int))
                        if self._set_bg_type:
                            self._plugin.set_setting("bg_type", 2)
                        if callable(on_selected):
                            try:
                                on_selected(color_int)
                            except Exception:
                                pass
                        self._plugin._invalidate_watermark_preview()
                        show_custom_success(self._ok_text, "tab_colors")

                pipette_delegate = _PipetteDelegate()
                color_consumer = _ColorConsumer(self, setting_key, success_text, force_bg_type)

                setattr(self, holder_prefix + "_pipette_delegate", pipette_delegate)
                setattr(self, holder_prefix + "_consumer", color_consumer)
                sheet = ColorPickerBottomSheet(act, resources_provider)
                setattr(self, holder_prefix + "_sheet", sheet)
                sheet.setPipetteDelegate(pipette_delegate)
                call_int_color(sheet, "setColor", initial_color)
                sheet.setColorListener(color_consumer)
                return run_on_ui_thread(sheet.show)
            except Exception:
                pass

            from org.telegram.ui.Components import ColorPicker
            ColorPickerDelegate = find_class("org.telegram.ui.Components.ColorPicker$ColorPickerDelegate")

            selected = {"color": initial_color}

            ColorPickerDelegateProxy = dynamic_proxy(ColorPickerDelegate)
            class _PickerDelegate(ColorPickerDelegateProxy):
                def __init__(self):
                    super().__init__()
                def setColor(self, color, num, applyNow):
                    try:
                        selected["color"] = int(color)
                    except Exception:
                        pass

            picker_delegate = _PickerDelegate()
            setattr(self, holder_prefix + "_delegate", picker_delegate)

            picker = ColorPicker(act, False, picker_delegate)
            try:
                call_color_and_int(picker, "setColor", initial_color, 0)
            except Exception:
                pass

            def _save_and_close(b, w):
                try:
                    b.dismiss()
                except Exception:
                    pass
                self.set_setting(setting_key, self._hex_color(selected["color"]))
                if force_bg_type:
                    self.set_setting("bg_type", 2)
                if callable(on_selected):
                    try:
                        on_selected(selected["color"])
                    except Exception:
                        pass
                self._invalidate_watermark_preview()
                show_custom_success(success_text, "tab_colors")

            builder = AlertDialogBuilder(act) \
                .set_title(title) \
                .set_view(picker, AndroidUtilities.dp(360)) \
                .set_positive_button("Сохранить", _save_and_close) \
                .set_negative_button("Отмена", lambda b, w: b.dismiss())
            run_on_ui_thread(builder.show)
        except Exception as e:
            log(f"[QuoteCreate] Color picker open failed: {e}")
            BulletinHelper.show_error("Не удалось открыть палитру")

    def _pick_watermark_logo(self, _=None):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return BulletinHelper.show_error("Не удалось открыть выбор файла")
            intent = Intent("android.intent.action.OPEN_DOCUMENT")
            intent.addCategory("android.intent.category.OPENABLE")
            intent.setType("image/*")
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            self._ensure_logo_result_hook()
            run_on_ui_thread(lambda: fragment.startActivityForResult(intent, LOGO_REQUEST_CODE))
        except Exception as e:
            log(f"[QuoteCreate] Logo picker failed: {e}")
            BulletinHelper.show_error("Не удалось открыть выбор файла")

    def _ensure_logo_result_hook(self):
        if self._logo_result_hook is not None:
            return
        try:
            cls = find_class("org.telegram.ui.LaunchActivity")
            if cls is None:
                return
            for method in list(cls.getClass().getDeclaredMethods()):
                if str(method.getName()) != "onActivityResult":
                    continue
                if len(method.getParameterTypes()) != 3:
                    continue
                method.setAccessible(True)
                plugin = self
                hook_cls = type("LogoResultHook", (MethodHook,), {
                    "after_hooked_method": lambda s, p: plugin._on_logo_result(p)
                })
                self._logo_result_hook = self.hook_method(method, hook_cls())
                return
        except Exception as e:
            log(f"[QuoteCreate] Logo result hook unavailable: {e}")

    def _on_logo_result(self, param):
        try:
            args = getattr(param, "args", None)
            if args is None or len(args) < 3:
                return
            if int(args[0]) != LOGO_REQUEST_CODE or int(args[1]) != -1:
                return
            data = args[2]
            if data is None:
                return
            uri = data.getData()
            if uri is None:
                return
            run_on_queue(lambda: self._import_logo(uri), PLUGINS_QUEUE)
        except Exception as e:
            log(f"[QuoteCreate] Logo result error: {e}")

    def _import_logo(self, uri):
        stream = None
        try:
            ctx = ApplicationLoader.applicationContext
            stream = ctx.getContentResolver().openInputStream(uri)
            if stream is None:
                raise Exception("нет доступа к файлу")
            sink = J['BAO']()
            buffer = jarray(jbyte)(64 * 1024)
            total = 0
            while True:
                read = int(stream.read(buffer))
                if read <= 0:
                    break
                sink.write(buffer, 0, read)
                total += read
                if total > 8 * 1024 * 1024:
                    raise Exception("файл больше 8 МБ")
            if total <= 0:
                raise Exception("пустой файл")
            target = self._tmp_path("watermark_logo.png")
            target.write_bytes(bytes(sink.toByteArray()))
            probe = J['BmpF'].decodeFile(str(target))
            if probe is None:
                try:
                    os.remove(str(target))
                except Exception:
                    pass
                raise Exception("не изображение")
            probe.recycle()
            self.set_setting("watermark_logo_path", str(target))
            run_on_ui_thread(lambda: (
                self._invalidate_watermark_preview(),
                show_custom_success("Логотип добавлен", "tab_colors"),
            ))
        except Exception as e:
            err = str(e)
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"Не удалось добавить логотип: {err[:60]}"))
        finally:
            if stream is not None:
                try:
                    stream.close()
                except Exception:
                    pass

    def _clear_watermark_logo(self, _=None):
        path = self._watermark_logo_path()
        if path:
            try:
                os.remove(path)
            except Exception:
                pass
        self.set_setting("watermark_logo_path", "", reload_settings=True)
        self._invalidate_watermark_preview()
        show_custom_success("Логотип убран", "tab_colors")

    def _blink_flash(self):
        def task():
            if self.get_setting("load_vib", True):
                try:
                    vib = ApplicationLoader.applicationContext.getSystemService(J['Ctx'].VIBRATOR_SERVICE)
                    if vib:
                        try:
                            VibrationEffect = find_class("android.os.VibrationEffect")
                            vib.vibrate(VibrationEffect.createOneShot(1300, 255))
                        except:
                            vib.vibrate(1300)
                except Exception: pass
            if self.get_setting("load_flash", True):
                try:
                    cm = ApplicationLoader.applicationContext.getSystemService(J['Ctx'].CAMERA_SERVICE)
                    CameraCharacteristics = find_class("android.hardware.camera2.CameraCharacteristics")
                    key = CameraCharacteristics.FLASH_INFO_AVAILABLE
                    target = None
                    for id in cm.getCameraIdList():
                        if cm.getCameraCharacteristics(id).get(key):
                            target = id
                            break
                    if target:
                        for _ in range(5):
                            cm.setTorchMode(target, True); time.sleep(0.1)
                            cm.setTorchMode(target, False); time.sleep(0.1)
                except Exception: pass
        run_on_queue(task, PLUGINS_QUEUE)

    def _tmp_dir(self):
        ctx = ApplicationLoader.applicationContext
        base = None
        try:
            base = ctx.getExternalCacheDir()
        except Exception:
            base = None
        if base is None:
            base = ctx.getCacheDir()
        d = Path(base.getAbsolutePath()) / __id__
        d.mkdir(parents=True, exist_ok=True)
        return str(d)

    def _tmp_path(self, name):
        try:
            d = Path(self.tmp) if self.tmp else Path(self._tmp_dir())
            d.mkdir(parents=True, exist_ok=True)
        except Exception:
            self.tmp = self._tmp_dir()
            d = Path(self.tmp)
        return d / name

    def _show_bulletin(self, kind, text):
        def show():
            try:
                method = getattr(BulletinHelper, f"show_{kind}", None)
                if callable(method):
                    method(text)
                else:
                    BulletinHelper.show_info(text)
            except Exception as e:
                log(f"[QuoteCreate] Bulletin show error: {e}")
        run_on_ui_thread(show)

    def _feedback_ctx(self, view=None, act=None):
        context = None
        if view is not None:
            try:
                context = view.getContext()
            except Exception:
                context = None
        if context is None:
            context = act if act else ApplicationLoader.applicationContext
        try:
            while context and not hasattr(context, "getSystemService"):
                if hasattr(context, "getBaseContext"):
                    context = context.getBaseContext()
                else:
                    break
        except Exception:
            pass
        return context

    def _click_feedback(self, view=None, act=None):
        def do_feedback():
            context = self._feedback_ctx(view, act)
            try:
                if view is not None and hasattr(view, "performHapticFeedback"):
                    haptic = find_class("android.view.HapticFeedbackConstants")
                    feedback_constant = getattr(haptic, "KEYBOARD_TAP", getattr(haptic, "VIRTUAL_KEY", 1))
                    if view.performHapticFeedback(feedback_constant):
                        return
            except Exception:
                pass
            try:
                if context is None:
                    return
                vibrator = context.getSystemService("vibrator")
                if vibrator:
                    try:
                        vibration_effect = find_class("android.os.VibrationEffect")
                        vibrator.vibrate(vibration_effect.createOneShot(20, 120))
                    except Exception:
                        vibrator.vibrate(20)
            except Exception as e:
                log(f"[QuoteCreate] Click feedback error: {e}")
        run_on_ui_thread(do_feedback)

    def _upd(self, chat):
        try:
            if not (chat.getActionBar() and chat.getActionBar().isActionModeShowed()): return self._rm()
            cont = get_private_field(chat, "actionsButtonsLayout")
            if not cont:
                cont = get_private_field(chat, "bottomMessagesActionContainer")
            if cont and not cont.findViewWithTag(TAG):
                try:
                    BlurredRoundBtn = find_class("org.telegram.ui.Components.chat.buttons.ChatActivityBlurredRoundButton")
                    factory = get_private_field(chat, "glassBackgroundDrawableFactory")
                    colorProvider = get_private_field(chat, "blurredBackgroundColorProvider")
                    resourceProvider = get_private_field(chat, "themeDelegate")
                    if BlurredRoundBtn and factory and colorProvider:
                        icon_size = 48
                        self.btn = None
                        try:
                            self.btn = BlurredRoundBtn.create(
                                chat.getParentActivity(),
                                factory,
                                colorProvider,
                                resourceProvider,
                                R.drawable.input_video_pressed_solar,
                                icon_size
                            )
                        except Exception:
                            try:
                                self.btn = BlurredRoundBtn.create(
                                    chat.getParentActivity(),
                                    factory,
                                    colorProvider,
                                    resourceProvider
                                )
                                self.btn.setIcon(R.drawable.input_video_pressed_solar, icon_size)
                                call_int_color(self.btn, "setIconColor", Theme.getColor(Theme.key_glass_defaultIcon, resourceProvider))
                            except Exception:
                                self.btn = None
                        if not self.btn:
                            raise Exception("BlurredRoundButton not available")
                        self.btn.setTag(TAG)
                        self.btn.setOnClickListener(OnClickListener(lambda v: self._click(chat)))
                        from android.widget import LinearLayout
                        lp = LinearLayout.LayoutParams(AndroidUtilities.dp(56), AndroidUtilities.dp(56))
                        lp.weight = 0
                        lp.setMargins(AndroidUtilities.dp(8), 0, AndroidUtilities.dp(8), 0)
                        cont.addView(self.btn, 1, lp)
                    else:
                        raise Exception("BlurredRoundButton not available")
                except:
                    resourceProvider = None
                    try: resourceProvider = get_private_field(chat, "themeDelegate")
                    except Exception: pass
                    
                    self.btn = J['IV'](chat.getParentActivity())
                    self.btn.setTag(TAG)
                    self.btn.setImageResource(R.drawable.input_video_pressed_solar)
                    try:
                        call_int_color(self.btn, "setColorFilter", Theme.getColor(Theme.key_glass_defaultIcon, resourceProvider))
                        self.btn.setBackground(Theme.createSelectorDrawable(as_java_color(Theme.getColor(Theme.key_listSelector, resourceProvider)), 1))
                    except Exception:
                        call_int_color(self.btn, "setColorFilter", Theme.getColor(Theme.key_glass_defaultIcon))
                        self.btn.setBackground(Theme.createSelectorDrawable(as_java_color(Theme.getColor(Theme.key_listSelector)), 1))
                    self.btn.setScaleType(J['IV'].ScaleType.FIT_CENTER)
                    self.btn.setOnClickListener(OnClickListener(lambda v: self._click(chat)))
                    pad = AndroidUtilities.dp(14)
                    self.btn.setPadding(pad, pad, pad, pad)
                    from android.widget import LinearLayout
                    lp = LinearLayout.LayoutParams(AndroidUtilities.dp(56), AndroidUtilities.dp(56))
                    lp.weight = 0
                    lp.setMargins(AndroidUtilities.dp(8), 0, AndroidUtilities.dp(8), 0)
                    cont.addView(self.btn, 1, lp)
        except Exception as e:
            log(f"[QuoteCreate] Action mode button failed: {e}")

    def _rm(self):
        if self.btn and (p := self.btn.getParent()): p.removeView(self.btn)
        self.btn = None

    def _wallpaper(self, chat=None):
        try:
            wallpaper_drawable = None
            theme_delegate = None
            if chat:
                try:
                    content_view = chat.getContentView()
                except Exception:
                    content_view = None
                if content_view:
                    try:
                        bg_view = get_private_field(content_view, "backgroundView")
                    except Exception:
                        bg_view = None
                    if not bg_view:
                        try:
                            bg_view = getattr(content_view, "backgroundView")
                        except Exception:
                            bg_view = None
                    if bg_view:
                        try:
                            w = bg_view.getWidth()
                            h = bg_view.getHeight()
                            if w > 0 and h > 0:
                                bmp = J['Bmp'].createBitmap(w, h, J['Bmp'].Config.ARGB_8888)
                                canvas = J['Canvas'](bmp)
                                draw_evt = threading.Event()
                                def _draw_bg_safe():
                                    try:
                                        bg_view.draw(canvas)
                                    except Exception:
                                        pass
                                    finally:
                                        draw_evt.set()
                                try:
                                    run_on_ui_thread(_draw_bg_safe)
                                    draw_evt.wait(timeout=2.0)
                                except Exception:
                                    pass
                                return bmp
                        except Exception:
                            pass
                try:
                    theme_delegate = get_private_field(chat, "themeDelegate")
                except Exception:
                    theme_delegate = None
                if content_view:
                    try:
                        wallpaper_drawable = content_view.getBackgroundImage()
                    except Exception:
                        pass
                if not wallpaper_drawable and theme_delegate:
                    try:
                        wallpaper_drawable = theme_delegate.getWallpaperDrawable()
                    except Exception:
                        pass
            if not wallpaper_drawable:
                wallpaper_drawable = get_private_field(Theme, "wallpaper")
            if not wallpaper_drawable:
                wallpaper_drawable = Theme.getCachedWallpaper()
            if wallpaper_drawable:
                w, h = AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y
                bmp = J['Bmp'].createBitmap(w, h, J['Bmp'].Config.ARGB_8888)
                canvas = J['Canvas'](bmp)
                is_pattern = False
                try:
                    is_pattern = Theme.isPatternWallpaper()
                except Exception:
                    try:
                        is_pattern = bool(get_private_field(Theme, "isPatternWallpaper"))
                    except Exception:
                        is_pattern = False
                if is_pattern:
                    bg_color = None
                    if theme_delegate:
                        try:
                            bg_color = theme_delegate.getColor(Theme.key_chat_wallpaper)
                        except Exception:
                            bg_color = None
                    if bg_color is None:
                        bg_color = Theme.getColor(Theme.key_chat_wallpaper)
                    paint = J['Paint']()
                    set_paint_color(paint, bg_color)
                    canvas.drawRect(0.0, 0.0, float(w), float(h), paint)
                wallpaper_drawable.setBounds(0, 0, w, h)
                wallpaper_drawable.draw(canvas)
                return bmp
        except Exception: pass
        return None

    def _argb_with_opacity(self, color, opacity_percent):
        value = int(color) & 0xFFFFFFFF
        alpha = (value >> 24) & 0xFF
        alpha = int(alpha * max(0, min(100, int(opacity_percent))) / 100)
        return ((alpha & 0xFF) << 24) | (value & 0x00FFFFFF)

    def _color_is_light(self, color):
        value = int(color) & 0xFFFFFFFF
        r = (value >> 16) & 0xFF
        g = (value >> 8) & 0xFF
        b = value & 0xFF
        return ((r * 299) + (g * 587) + (b * 114)) >= 186000

    def _draw_watermark_blur(self, canvas, bitmap, rect_f, radius):
        region = None
        small = None
        blurred = None
        try:
            left = max(0, int(rect_f.left))
            top = max(0, int(rect_f.top))
            right = min(int(bitmap.getWidth()), int(rect_f.right + 0.999))
            bottom = min(int(bitmap.getHeight()), int(rect_f.bottom + 0.999))
            width = max(1, right - left)
            height = max(1, bottom - top)
            region = J['Bmp'].createBitmap(bitmap, left, top, width, height)
            blurred = region
            try:
                Utilities.stackBlurBitmap(blurred, max(6, min(18, int(max(width, height) / 18))))
            except Exception:
                small_w = max(1, int(width / 3))
                small_h = max(1, int(height / 3))
                small = J['Bmp'].createScaledBitmap(region, small_w, small_h, True)
                blurred = J['Bmp'].createScaledBitmap(small, width, height, True)

            path = J['Path']()
            path.addRoundRect(rect_f, float(radius), float(radius), J['Path'].Direction.CW)
            paint = J['Paint'](J['Paint'].ANTI_ALIAS_FLAG)
            try:
                paint.setFilterBitmap(True)
            except Exception:
                pass
            canvas.save()
            try:
                canvas.clipPath(path)
                canvas.drawBitmap(blurred, float(left), float(top), paint)
            finally:
                canvas.restore()
        except Exception as e:
            log(f"[QuoteCreate] Watermark blur failed: {e}")
        finally:
            for bmp in (region, small, blurred):
                try:
                    if bmp and bmp is not region and not bmp.isRecycled():
                        bmp.recycle()
                except Exception:
                    pass
            try:
                if region and not region.isRecycled():
                    region.recycle()
            except Exception:
                pass

    def _draw_watermark(self, canvas, bitmap, chat=None, count=None, scale=1.0):
        if not bool(self.get_setting("watermark_enabled", False)):
            return
        text = self._watermark_text_resolved(chat=chat, count=count)
        has_logo = bool(self._watermark_logo_path())
        if not text and not has_logo:
            return

        try:
            width = int(bitmap.getWidth())
            height = int(bitmap.getHeight())
            if width <= 0 or height <= 0:
                return

            if text:
                paint = J['Paint'](J['Paint'].ANTI_ALIAS_FLAG)
                try:
                    paint.setDither(True)
                except Exception:
                    pass
                try:
                    paint.setFakeBoldText(True)
                except Exception:
                    pass

                layout = self._watermark_layout(paint, text, width, height, scale=scale)
                opacity = self._setting_int_clamped("watermark_opacity", 72, 5, 100)
                shadow_alpha = max(32, min(145, int(opacity * 1.35)))
                shadow_color = (shadow_alpha << 24) | (0x000000 if self._color_is_light(layout["text_color"]) else 0xFFFFFF)
                try:
                    paint.setShadowLayer(float(AndroidUtilities.dp(1)), 0.0, float(AndroidUtilities.dp(1)), as_java_color(shadow_color))
                except Exception:
                    pass

                if bool(self.get_setting("watermark_tile", False)):
                    self._draw_watermark_tiles(canvas, paint, layout, width, height)
                else:
                    rect = J['RectF'](
                        float(layout["left"]),
                        float(layout["top"]),
                        float(layout["left"] + layout["box_w"]),
                        float(layout["top"] + layout["box_h"]),
                    )
                    if bool(self.get_setting("watermark_blur_bg", True)):
                        self._draw_watermark_blur(canvas, bitmap, rect, layout["radius"])

                    if layout["bg_opacity"] > 0:
                        bg_base = 0xFF000000 if self._color_is_light(layout["text_color"]) else 0xFFFFFFFF
                        bg_color = self._argb_with_opacity(bg_base, layout["bg_opacity"])
                        bg_paint = J['Paint'](J['Paint'].ANTI_ALIAS_FLAG)
                        set_paint_color(bg_paint, bg_color)
                        canvas.drawRoundRect(rect, float(layout["radius"]), float(layout["radius"]), bg_paint)

                    baseline = float(layout["top"] + layout["inner_y"]) - layout["ascent"]
                    canvas.save()
                    try:
                        if layout["angle"]:
                            canvas.rotate(
                                float(layout["angle"]),
                                float(layout["left"] + layout["box_w"] / 2.0),
                                float(layout["top"] + layout["box_h"] / 2.0),
                            )
                        canvas.drawText(layout["text"], float(layout["left"] + layout["inner_x"]), baseline, paint)
                    finally:
                        canvas.restore()

            if has_logo:
                self._draw_watermark_logo(canvas, width, height, scale=scale)
        except Exception as e:
            log(f"[QuoteCreate] Watermark draw failed: {e}")

    def _has_items(self, value):
        if not value:
            return False
        try:
            return value.size() > 0
        except Exception:
            try:
                return len(value) > 0
            except Exception:
                return True

    def _media_local(self, file_loader, owner, document=None, photo_size=None):
        try:
            path = file_loader.getPathToMessage(owner)
            if path and path.exists():
                return True
        except Exception:
            pass
        if document is not None:
            try:
                path = file_loader.getPathToAttach(document)
                if path and path.exists():
                    return True
            except Exception:
                pass
        if photo_size is not None:
            try:
                path = file_loader.getPathToAttach(photo_size)
                if path and path.exists():
                    return True
            except Exception:
                pass
        return False

    def _file_loading(self, file_loader, file_name):
        try:
            if not file_name:
                return False
            return bool(file_loader.isLoadingFile(file_name))
        except Exception:
            return False

    def _media_ready(self, file_loader, msg, owner, document=None, photo_size=None, file_name=None):
        try:
            try:
                msg.checkMediaExistance(False)
            except Exception:
                pass

            media_ready = False
            try:
                media_exists_attr = getattr(msg, "mediaExists", None)
                if callable(media_exists_attr):
                    media_ready = bool(media_exists_attr())
                elif media_exists_attr is not None:
                    media_ready = bool(media_exists_attr)
            except Exception:
                media_ready = False

            if not media_ready:
                media_ready = self._media_local(file_loader, owner, document=document, photo_size=photo_size)

            if self._file_loading(file_loader, file_name):
                return False
            return bool(media_ready)
        except Exception:
            return self._media_local(file_loader, owner, document=document, photo_size=photo_size)

    def _preload_media(self, file_loader, msg, priority):
        try:
            owner = getattr(msg, "messageOwner", None)
            if owner is None:
                return None

            document = None
            try:
                document = msg.getDocument()
            except Exception:
                document = None

            if document is not None and self._media_local(file_loader, owner, document=document):
                return None

            if document is not None:
                try:
                    should_load_doc = (
                        MessageObject.isVideoDocument(document)
                        or MessageObject.isGifDocument(document)
                        or MessageObject.isRoundVideoDocument(document)
                        or MessageObject.isStickerDocument(document)
                        or MessageObject.isAnimatedStickerDocument(document, True)
                    )
                except Exception:
                    should_load_doc = False
                if should_load_doc:
                    try:
                        file_loader.loadFile(document, msg, priority, 0)
                        file_name = None
                        try:
                            file_name = FileLoader.getAttachFileName(document)
                        except Exception:
                            file_name = None
                        return lambda: self._media_ready(
                            file_loader,
                            msg,
                            owner,
                            document=document,
                            file_name=file_name
                        )
                    except Exception as e:
                        log(f"[QuoteCreate] document preload failed: {e}")

            photo_size = None
            photo_object = None
            try:
                thumbs = getattr(msg, "photoThumbs", None)
                if self._has_items(thumbs):
                    photo_size = FileLoader.getClosestPhotoSizeWithSize(thumbs, AndroidUtilities.getPhotoSize())
                    photo_object = getattr(msg, "photoThumbsObject", None)
                    if photo_object is None:
                        media = MessageObject.getMedia(owner)
                        if media is not None:
                            photo_object = getattr(media, "photo", None) or getattr(media, "document", None)
            except Exception:
                photo_size = None
                photo_object = None

            if photo_size is not None and photo_object is not None:
                try:
                    image_location = ImageLocation.getForObject(photo_size, photo_object)
                    if image_location is not None:
                        file_loader.loadFile(image_location, msg, None, priority, 1)
                        file_name = None
                        try:
                            file_name = FileLoader.getAttachFileName(photo_size)
                        except Exception:
                            file_name = None
                        return lambda: self._media_ready(
                            file_loader,
                            msg,
                            owner,
                            photo_size=photo_size,
                            file_name=file_name
                        )
                except Exception as e:
                    log(f"[QuoteCreate] thumb preload failed: {e}")
            return None
        except Exception as e:
            log(f"[QuoteCreate] preload request error: {e}")
            return None

    def _preload_msgs(self, msgs):
        try:
            if not msgs:
                return
            account = getattr(get_user_config(), "selectedAccount", 0)
            file_loader = FileLoader.getInstance(account)
            priority = getattr(FileLoader, "PRIORITY_NORMAL_UP", getattr(FileLoader, "PRIORITY_HIGH", 3))
            checks = []
            for msg in msgs:
                check = self._preload_media(file_loader, msg, priority)
                if check:
                    checks.append(check)
            if not checks:
                return
            deadline = time.time() + 6.0
            while checks and time.time() < deadline:
                pending = []
                for check in checks:
                    try:
                        if not check():
                            pending.append(check)
                    except Exception:
                        pass
                checks = pending
                if checks:
                    time.sleep(0.06)
        except Exception as e:
            log(f"[QuoteCreate] preload stage failed: {e}")

    def _render_bg(self, chat, transparent=False):
        if transparent or self.get_setting("bg_type", 0) != 0:
            return None
        try:
            did = chat.getDialogId() if chat else 0
        except Exception:
            did = 0
        try:
            key = (did, int(AndroidUtilities.displaySize.x), int(AndroidUtilities.displaySize.y))
        except Exception:
            key = (did, 0, 0)
        now = time.time()
        try:
            cached = self._bg_cache
            if cached:
                cached_key, cached_at, cached_bmp = cached
                if cached_key == key and now - cached_at < 4.0 and cached_bmp and not cached_bmp.isRecycled():
                    return cached_bmp.copy(cached_bmp.getConfig(), False)
        except Exception:
            pass
        bmp = self._wallpaper(chat)
        if bmp:
            try:
                old = self._bg_cache[2] if self._bg_cache else None
                if old and old is not bmp and not old.isRecycled():
                    old.recycle()
            except Exception:
                pass
            self._bg_cache = (key, now, bmp)
            try:
                return bmp.copy(bmp.getConfig(), False)
            except Exception:
                return bmp
        return None

    def _render_bytes(self, msgs, chat, bg_bmp=None, transparent=False, anonymize_enabled=None, sticker=False):
        self._preload_msgs(msgs)
        return Renderer(msgs, self, chat, anonymize_enabled=anonymize_enabled, sticker=sticker).render(bg_bmp, transparent=transparent)

    def _click(self, chat):
        sel = get_private_field(chat, "selectedMessagesIds")
        msgs = [arr.valueAt(j) for arr in (sel or []) if arr for j in range(arr.size())]
        if not msgs: return BulletinHelper.show_error("Нет сообщений")
        msgs.sort(key=lambda m: m.getId())
        try: chat.getClass().getDeclaredMethod("clearSelectionMode").invoke(chat)
        except: pass
        self._start_render(msgs, chat)

    def _start_render(self, msgs, chat):
        if not msgs:
            return BulletinHelper.show_error("Нет сообщений")
        if len(msgs) > MAX_QUOTE_MESSAGES:
            total = len(msgs)
            word = plural_ru(total, "сообщение", "сообщения", "сообщений")

            def proceed(builder, which):
                try:
                    builder.dismiss()
                except Exception:
                    pass
                self._render_now(msgs[:MAX_QUOTE_MESSAGES], chat)

            try:
                AlertDialogBuilder(chat.getParentActivity()) \
                    .set_title("Слишком много сообщений") \
                    .set_message(
                        f"Выбрано {total} {word}. В одну цитату поместятся первые "
                        f"{MAX_QUOTE_MESSAGES} — иначе не хватит памяти на рендер."
                    ) \
                    .set_positive_button(f"Взять первые {MAX_QUOTE_MESSAGES}", proceed) \
                    .set_negative_button("Отмена", lambda b, w: b.dismiss()) \
                    .show()
            except Exception as e:
                log(f"[QuoteCreate] Limit dialog failed: {e}")
                self._render_now(msgs[:MAX_QUOTE_MESSAGES], chat)
            return
        self._render_now(msgs, chat)

    def _render_now(self, msgs, chat):
        first_msg = msgs[0]
        dlg = AlertDialogBuilder(chat.getParentActivity(), AlertDialogBuilder.ALERT_TYPE_SPINNER).set_title("Рендер...").show()
        run_on_queue(lambda: self._render(msgs, chat, dlg, None, first_msg), PLUGINS_QUEUE)

    def _on_menu_quote(self, context):
        try:
            msg = self._context_value(context, "message")
            fragment = self._context_value(context, "fragment")
            if msg is None:
                return BulletinHelper.show_error("Не удалось получить сообщение")
            if fragment is None or not hasattr(fragment, "getDialogId"):
                return BulletinHelper.show_error("Цитату можно создать только из чата")
            group = self._context_value(context, "groupedMessages")
            msgs = [msg]
            try:
                if group is not None:
                    items = getattr(group, "messages", None)
                    collected = []
                    if items is not None:
                        for index in range(items.size()):
                            collected.append(items.get(index))
                    if collected:
                        msgs = collected
            except Exception:
                msgs = [msg]
            msgs.sort(key=lambda m: m.getId())
            self._start_render(msgs, fragment)
        except Exception as e:
            log(f"[QuoteCreate] Menu quote failed: {e}")
            BulletinHelper.show_error("Не удалось создать цитату")

    def _context_value(self, context, key):
        if context is None:
            return None
        try:
            value = context.get(key)
            if value is not None:
                return value
        except Exception:
            pass
        try:
            return getattr(context, key, None)
        except Exception:
            return None

    def _render(self, msgs, chat, dlg, bg_bmp, first_msg):
        try:
            if bg_bmp is None:
                bg_bmp = self._render_bg(chat)
            data = self._render_bytes(msgs, chat, bg_bmp=bg_bmp)
            if data:
                run_on_ui_thread(lambda: self._preview(chat.getParentActivity(), data, chat, dlg, first_msg, msgs))
            else: raise Exception("рендер вернул пустой результат")
        except Exception as e:
            err = str(e)
            run_on_ui_thread(lambda: (dlg.dismiss(), BulletinHelper.show_error(err)))
        finally:
            if bg_bmp: bg_bmp.recycle()

    def _preview(self, act, data, chat, dlg, first_msg, msgs):
        dlg.dismiss()
        did = chat.getDialogId()
        reply_to_top_msg = None
        try: reply_to_top_msg = chat.getThreadMessage()
        except: pass
        if not reply_to_top_msg:
            try:
                topic_id = chat.getTopicId()
                if topic_id and topic_id > 0:
                    reply_to_top_msg = _make_top_reply(topic_id, did)
            except: pass
        if not reply_to_top_msg and first_msg:
            topic_id = _msg_topic_id(first_msg, did)
            if topic_id > 0:
                reply_to_top_msg = _make_top_reply(topic_id, did)
        try:
            QuotePreviewSheet(self, act, chat, data, msgs, reply_to_top_msg).show()
            return
        except Exception as e:
            log(f"[QuoteCreate] Preview sheet failed: {e}")
            BulletinHelper.show_error("Не удалось открыть предпросмотр")
            return

    def _send_sticker(self, msgs, chat, did, reply_to_top_msg, anonymize_enabled=None):
        dlg = AlertDialogBuilder(chat.getParentActivity(), AlertDialogBuilder.ALERT_TYPE_SPINNER).set_title("Рендер стикера...").show()
        def render_and_send():
            bg_bmp_sticker = None
            try:
                transparent = self.get_setting("transparent_sticker", True)
                bg_bmp_sticker = self._render_bg(chat, transparent=transparent)
                data = self._render_bytes(
                    msgs,
                    chat,
                    bg_bmp=bg_bmp_sticker,
                    transparent=transparent,
                    anonymize_enabled=anonymize_enabled,
                    sticker=True,
                )
                if data:
                    run_on_ui_thread(lambda: (dlg.dismiss(), self._send(data, did, reply_to_top_msg, send_mode="sticker")))
                else:
                    raise Exception("не удалось отрендерить цитату")
            except Exception as e:
                err = str(e)
                run_on_ui_thread(lambda: (dlg.dismiss(), BulletinHelper.show_error(err)))
            finally:
                if bg_bmp_sticker:
                    bg_bmp_sticker.recycle()
        run_on_queue(render_and_send, PLUGINS_QUEUE)

    def _opaque_bounds(self, bmp):
        try:
            w = int(bmp.getWidth())
            h = int(bmp.getHeight())
            if w <= 0 or h <= 0:
                return None
            try:
                if not bmp.hasAlpha():
                    return None
            except Exception:
                pass

            row = jarray(jint)(w)
            top = None
            bottom = None
            left = w
            right = -1

            for y in range(h):
                bmp.getPixels(row, 0, w, 0, y, w, 1)
                pixels = row[:]
                row_left = -1
                row_right = -1
                for x in range(w):
                    if pixels[x] & 0xFF000000:
                        row_left = x
                        break
                if row_left < 0:
                    continue
                for x in range(w - 1, row_left - 1, -1):
                    if pixels[x] & 0xFF000000:
                        row_right = x
                        break
                if top is None:
                    top = y
                bottom = y
                if row_left < left:
                    left = row_left
                if row_right > right:
                    right = row_right

            if top is None or right < 0:
                return None
            if left <= 0 and top <= 0 and right >= w - 1 and bottom >= h - 1:
                return None
            return (left, top, right + 1, bottom + 1)
        except Exception as e:
            log(f"[QuoteCreate] Sticker bounds detect failed: {e}")
            return None

    def _sticker_bitmap(self, bmp, target_size=512):
        if not bmp:
            raise Exception("не удалось декодировать картинку стикера")
        working = bmp
        cropped = False
        bounds = self._opaque_bounds(working)
        if bounds:
            left, top, right, bottom = bounds
            crop_w = max(1, right - left)
            crop_h = max(1, bottom - top)
            if crop_w != int(working.getWidth()) or crop_h != int(working.getHeight()):
                cropped_bmp = J['Bmp'].createBitmap(working, left, top, crop_w, crop_h)
                working.recycle()
                working = cropped_bmp
                cropped = True
        w = int(working.getWidth())
        h = int(working.getHeight())
        if w <= 0 or h <= 0:
            working.recycle()
            raise Exception("некорректный размер стикера")
        edge_pad = 8 if cropped else 0
        usable_side = max(1, int(target_size) - edge_pad * 2)
        scale = float(usable_side) / float(max(w, h))
        new_w = max(1, min(int(target_size), int(round(w * scale))))
        new_h = max(1, min(int(target_size), int(round(h * scale))))
        if new_w == w and new_h == h and edge_pad == 0:
            return working
        prepared = J['Bmp'].createBitmap(new_w + edge_pad * 2, new_h + edge_pad * 2, J['Bmp'].Config.ARGB_8888)
        canvas = J['Canvas'](prepared)
        paint = J['Paint'](J['Paint'].ANTI_ALIAS_FLAG)
        try:
            paint.setFilterBitmap(True)
        except Exception:
            pass
        try:
            paint.setDither(True)
        except Exception:
            pass
        src = J['Rect'](0, 0, w, h)
        dst = J['Rect'](edge_pad, edge_pad, edge_pad + new_w, edge_pad + new_h)
        canvas.drawBitmap(working, src, dst, paint)
        working.recycle()
        return prepared

    def _write_sticker_webp(self, prepared_bmp, webp_path):
        from java.io import FileOutputStream

        def compress(fmt, quality):
            fos = FileOutputStream(str(webp_path))
            try:
                prepared_bmp.compress(fmt, quality, fos)
            finally:
                fos.close()
            try:
                return int(os.path.getsize(str(webp_path)))
            except Exception:
                return 0

        size = 0
        webp_lossless = getattr(J['Bmp'].CompressFormat, 'WEBP_LOSSLESS', None)
        webp_lossy = getattr(J['Bmp'].CompressFormat, 'WEBP_LOSSY', None) or J['Bmp'].CompressFormat.WEBP

        if webp_lossless is not None:
            size = compress(webp_lossless, 100)
            if 0 < size <= STICKER_MAX_BYTES:
                return size

        for quality in STICKER_QUALITY_STEPS:
            size = compress(webp_lossy, quality)
            if 0 < size <= STICKER_MAX_BYTES:
                return size

        raise Exception(f"стикер не влезает в 512 КБ ({format_bytes(size)})")

    def _send(self, data, did, reply_to_top_msg, send_mode="photo"):
        def go():
            try:
                ts = int(time.time())
                if send_mode == "sticker":
                    webp_path = self._tmp_path(f"q_{ts}.webp")
                    bmp = J['BmpF'].decodeByteArray(data, 0, len(data))
                    if bmp:
                        prepared_bmp = self._sticker_bitmap(bmp)
                        try:
                            self._write_sticker_webp(prepared_bmp, webp_path)
                        finally:
                            prepared_bmp.recycle()
                        path_str = str(webp_path)
                    else:
                        raise Exception("не удалось декодировать изображение")
                else:
                    p = self._tmp_path(f"q_{ts}.{self._output_extension()}")
                    p.write_bytes(data)
                    path_str = str(p)
                def send_on_ui():
                    try:
                        if send_mode == "file":
                            SendMessagesHelper.prepareSendingDocument(
                                get_account_instance(), path_str, path_str, None,
                                None, self._output_mime(), did,
                                reply_to_top_msg, reply_to_top_msg, None, None, None,
                                True, 0, None, None, 0, False
                            )
                            show_custom_success("Отправлено", "forward")
                        elif send_mode == "sticker":
                            self._send_webp(path_str, did, reply_to_top_msg)
                        else:
                            SendMessagesHelper.prepareSendingPhoto(
                                get_account_instance(), path_str, None, did,
                                reply_to_top_msg, reply_to_top_msg, None, None, None,
                                None, None, 0, None, True, 0,
                                0, None, 0
                            )
                            show_custom_success("Отправлено", "forward")
                    except Exception as ex:
                        BulletinHelper.show_error(f"Ошибка: {str(ex)[:50]}")
                run_on_ui_thread(send_on_ui)
            except Exception as ex:
                err = str(ex)
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка: {err[:50]}"))
        run_on_queue(go, PLUGINS_QUEUE)

    def _send_webp(self, webp_path, did, reply_to_top_msg):
        try:
            from java.io import File as JFile
            from java.util import HashMap
            f = JFile(webp_path)
            if not f.exists():
                raise Exception("файл стикера не найден")
            opts = J['BmpF'].Options()
            opts.inJustDecodeBounds = True
            J['BmpF'].decodeFile(webp_path, opts)
            img_w, img_h = opts.outWidth, opts.outHeight
            if img_w == 0 or img_h == 0:
                raise Exception("не удалось прочитать размеры стикера")
            if img_w > 512 or img_h > 512:
                raise Exception(f"стикер слишком большой: {img_w}×{img_h}")
            document = TLRPC.TL_document()
            document.id = 0
            document.access_hash = 0
            document.file_reference = bytearray()
            document.date = int(time.time())
            document.mime_type = "image/webp"
            document.size = f.length()
            document.dc_id = 0
            file_name = TLRPC.TL_documentAttributeFilename()
            file_name.file_name = f.getName()
            document.attributes.add(file_name)
            sticker_attr = TLRPC.TL_documentAttributeSticker()
            sticker_attr.alt = ""
            sticker_attr.stickerset = TLRPC.TL_inputStickerSetEmpty()
            document.attributes.add(sticker_attr)
            size_attr = TLRPC.TL_documentAttributeImageSize()
            size_attr.w = img_w
            size_attr.h = img_h
            document.attributes.add(size_attr)
            bmp = ImageLoader.loadBitmap(webp_path, None, 90, 90, True)
            if bmp:
                thumb = ImageLoader.scaleAndSaveImage(bmp, 90.0, 90.0, 55, False)
                if thumb:
                    document.thumbs.add(thumb)
                    document.flags = document.flags | 1
                bmp.recycle()
            account = UserConfig.selectedAccount
            params = HashMap()
            params.put("originalPath", webp_path)
            send_helper = SendMessagesHelper.getInstance(account)
            SendMessageParams = find_class("org.telegram.messenger.SendMessagesHelper$SendMessageParams")
            send_params = SendMessageParams.of(
                document,
                None,
                webp_path,
                did,
                reply_to_top_msg,
                reply_to_top_msg,
                None,
                None,
                None,
                params,
                True,
                0,
                0,
                0,
                None,
                None,
                False
            )
            send_helper.sendMessage(send_params)
            show_custom_success("Стикер отправлен", "smile_to_sticker")
        except Exception as ex:
            log(f"[QuoteCreate] Sticker send error: {ex}")
            traceback.print_exc()
            BulletinHelper.show_error(f"Ошибка: {str(ex)[:50]}")

    def _save_gallery(self, data, act, view=None):
        self._click_feedback(view, act)
        def go():
            try:
                ts = int(time.time())
                p = self._tmp_path(f"q_{ts}.{self._output_extension()}")
                p.write_bytes(data)
                path_str = str(p)
                ctx = act if act else ApplicationLoader.applicationContext
                class SaveCallback(dynamic_proxy(Utilities.Callback)):
                    def __init__(self, fn):
                        super().__init__()
                        self._fn = fn
                    def run(self, arg):
                        try:
                            self._fn(arg)
                        except Exception as e:
                            log(f"[QuoteCreate] Save callback error: {e}")
                def on_saved(_uri):
                    show_custom_success("Сохранено в галерею", "ic_save_to_gallery")
                MediaController.saveFile(path_str, ctx, 0, None, None, SaveCallback(on_saved))
            except Exception as ex:
                err = str(ex)
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка сохранения: {err[:50]}"))
        run_on_queue(go, PLUGINS_QUEUE)

    def _share(self, data, act, view=None):
        self._click_feedback(view, act)
        self._show_bulletin("info", "Открываю меню отправки")
        def go():
            try:
                ts = int(time.time())
                p = self._tmp_path(f"share_{ts}.{self._output_extension()}")
                p.write_bytes(data)
                path_str = str(p)
                def share_on_ui():
                    try:
                        ctx = act if act else ApplicationLoader.applicationContext
                        uri = J['FP'].getUriForFile(ctx, f"{ctx.getPackageName()}.provider", J['File'](path_str))
                        intent = Intent(Intent.ACTION_SEND)
                        intent.setType(self._output_mime())
                        intent.putExtra(Intent.EXTRA_STREAM, uri)
                        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                        if not act:
                            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                        chooser = Intent.createChooser(intent, "Поделиться")
                        if act:
                            act.startActivity(chooser)
                        else:
                            ctx.startActivity(chooser)
                    except Exception as e:
                        BulletinHelper.show_error(f"Ошибка отправки: {str(e)[:50]}")
                run_on_ui_thread(share_on_ui)
            except Exception as ex:
                err = str(ex)
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка отправки: {err[:50]}"))
        run_on_queue(go, PLUGINS_QUEUE)

    def _copy(self, data, act, view=None):
        self._click_feedback(view, act)
        try:
            (p := self._tmp_path(f"c_{int(time.time())}.{self._output_extension()}")).write_bytes(data)
            a = ApplicationLoader.applicationContext
            u = J['FP'].getUriForFile(a, f"{a.getPackageName()}.provider", J['File'](str(p)))
            a.getSystemService(J['Ctx'].CLIPBOARD_SERVICE).setPrimaryClip(J['Clip'].newUri(a.getContentResolver(), "Image", u))
            show_custom_success("Скопировано", "copy")
        except Exception as e: BulletinHelper.show_error(f"Ошибка: {e}")

class Renderer:
    def __init__(self, msgs, pl, chat, anonymize_enabled=None, sticker=False):
        self.msgs, self.pl, self.chat, self.ctx = msgs, pl, chat, chat.getParentActivity()
        self._spoiler_color = 0x52FFFFFF
        self._anonymize_enabled_override = anonymize_enabled
        self._sticker = bool(sticker)

    def _surface_size(self):
        width = 0
        try:
            list_view = self.chat.getChatListView()
            if list_view:
                width = int(list_view.getMeasuredWidth())
                if width <= 0:
                    width = int(list_view.getWidth())
        except Exception:
            width = 0

        try:
            display_width = int(AndroidUtilities.displaySize.x)
        except Exception:
            display_width = 0

        if width <= 0:
            width = display_width
        elif display_width > 0:
            width = max(width, display_width)

        try:
            screen_height = int(AndroidUtilities.displaySize.y)
        except Exception:
            screen_height = 0

        return max(1, width), max(1, screen_height)

    def _group_id(self, msg):
        try:
            if not bool(msg.hasValidGroupId()):
                return 0
        except Exception:
            return 0
        try:
            return int(msg.getGroupId() or 0)
        except Exception:
            return 0

    def _make_group(self, msgs):
        cls = J.get('Grouped')
        if cls is None or len(msgs) < 2:
            return None
        try:
            group = cls()
            group.groupId = msgs[0].getGroupId()
            items = group.messages
            for msg in msgs:
                items.add(msg)
            group.calculate()
            if int(group.posArray.size()) != len(msgs):
                return None
            for msg in msgs:
                if group.getPosition(msg) is None:
                    return None
            return group
        except Exception as e:
            log(f"[QuoteCreate] Album group build failed: {e}")
            return None

    def _album_geometry(self, group, width):
        result = []
        try:
            count = int(group.posArray.size())
        except Exception:
            return result
        span = 0
        row_index = 0
        for i in range(count):
            try:
                pos = group.posArray.get(i)
                size = int(getattr(pos, "spanSize", 0) or 0)
            except Exception:
                return []
            if size <= 0:
                size = 1000
            if span > 0 and span + size > 1000:
                row_index += 1
                span = 0
            end = min(1000, span + size)
            left = ceil_int(span * width / 1000.0)
            right = ceil_int(end * width / 1000.0)
            result.append((row_index, left, max(1, right - left)))
            span += size
        return result

    def _draw_group_extras(self, canvas, cell, position):
        try:
            flags = int(getattr(position, "flags", 0) or 0)
        except Exception:
            return
        selection_only = (flags & 1) == 0
        try:
            if bool(getattr(position, "last", False)):
                cell.drawTime(canvas, 1.0, True)
        except Exception as e:
            log(f"[QuoteCreate] Album time draw failed: {e}")
        try:
            if int(position.minX) == 0 and int(position.minY) == 0 and bool(cell.hasNameLayout()):
                cell.drawNamesLayout(canvas, 1.0)
        except Exception as e:
            log(f"[QuoteCreate] Album name draw failed: {e}")
        try:
            if flags & int(cell.captionFlag()):
                cell.drawCaptionLayout(canvas, selection_only, 1.0)
        except Exception as e:
            log(f"[QuoteCreate] Album caption draw failed: {e}")
        try:
            if (flags & 8) and (flags & 1):
                cell.drawCommentLayout(canvas, 1.0)
                if not selection_only:
                    cell.drawReactionsLayout(canvas, 1.0, None)
        except Exception as e:
            log(f"[QuoteCreate] Album reactions draw failed: {e}")

    def _album_decor_bottom(self, cell, group, position):
        try:
            siblings = getattr(position, "siblingHeights", None)
            if siblings is None:
                return 0
            length = len(siblings)
            if length <= 0:
                return 0
            max_height = max(int(AndroidUtilities.displaySize.x), int(AndroidUtilities.displaySize.y)) * 0.5
            extra = int(cell.getExtraInsetHeight())
            for a in range(length):
                extra += ceil_int(max_height * float(siblings[a]))
            extra += (int(position.maxY) - int(position.minY)) * int(round(7 * AndroidUtilities.density))
            for a in range(int(group.posArray.size())):
                pos = group.posArray.get(a)
                if int(pos.minY) != int(position.minY):
                    continue
                if (int(pos.minX) == int(position.minX) and int(pos.maxX) == int(position.maxX)
                        and int(pos.minY) == int(position.minY) and int(pos.maxY) == int(position.maxY)):
                    continue
                extra -= ceil_int(max_height * float(pos.ph)) - int(AndroidUtilities.dp(4))
                break
            return -extra
        except Exception as e:
            log(f"[QuoteCreate] Album sibling inset failed: {e}")
            return 0

    def _safe_pixel(self, bmp, x, y):
        try:
            bw = int(bmp.getWidth())
            bh = int(bmp.getHeight())
            if bw <= 0 or bh <= 0:
                return None
            px = max(0, min(bw - 1, int(x)))
            py = max(0, min(bh - 1, int(y)))
            return int(bmp.getPixel(px, py)) & 0xFFFFFFFF
        except Exception:
            return None

    def _mask_color(self, bmp, left, top, right, bottom):
        samples = []
        cx = (left + right) // 2
        cy = (top + bottom) // 2
        points = [
            (left - 2, top - 2), (right + 2, top - 2), (left - 2, bottom + 2), (right + 2, bottom + 2),
            (cx, top - 2), (cx, bottom + 2), (left - 2, cy), (right + 2, cy),
        ]
        for px, py in points:
            c = self._safe_pixel(bmp, px, py)
            if c is None:
                continue
            if ((c >> 24) & 0xFF) < 0x10:
                continue
            samples.append(c)

        if not samples:
            return 0xFF2B2B2B

        r = sum((c >> 16) & 0xFF for c in samples) // len(samples)
        g = sum((c >> 8) & 0xFF for c in samples) // len(samples)
        b = sum(c & 0xFF for c in samples) // len(samples)
        return (0xFF << 24) | (r << 16) | (g << 8) | b

    def _draw_spoiler(self, canvas, bmp, left, top, right, bottom, clip_circle=False, clip_radius=None, style=0, text_color=None):
        if right <= left or bottom <= top:
            return

        saved = False
        try:
            canvas.save()
            saved = True
            if clip_radius is None and not clip_circle:
                clip_radius = AndroidUtilities.dp(4)
            if clip_radius is not None and float(clip_radius) > 0 and J.get('Path') and J.get('RectF'):
                path = J['Path']()
                path.addRoundRect(
                    J['RectF'](float(left), float(top), float(right), float(bottom)),
                    float(clip_radius),
                    float(clip_radius),
                    J['Path'].Direction.CW
                )
                canvas.clipPath(path)
            elif clip_circle and J.get('Path'):
                path = J['Path']()
                cx = (left + right) / 2.0
                cy = (top + bottom) / 2.0
                radius = max(1.0, min((right - left), (bottom - top)) / 2.0)
                path.addCircle(float(cx), float(cy), float(radius), J['Path'].Direction.CW)
                canvas.clipPath(path)
            
            if style == 0 or style == 1:
                w = int(right - left)
                h = int(bottom - top)
                if w > 0 and h > 0:
                    scale = 0.05 if style == 0 else 0.1
                    sw = max(1, int(w * scale))
                    sh = max(1, int(h * scale))
                    small_bmp = J['Bmp'].createBitmap(sw, sh, J['Bmp'].Config.ARGB_8888)
                    small_canvas = J['Canvas'](small_bmp)
                    src_rect = J['Rect'](int(left), int(top), int(right), int(bottom))
                    dst_rect = J['Rect'](0, 0, sw, sh)
                    small_canvas.drawBitmap(bmp, src_rect, dst_rect, None)
                    
                    blur_paint = J['Paint']()
                    blur_paint.setFilterBitmap(style == 0)
                    canvas.drawBitmap(small_bmp, dst_rect, src_rect, blur_paint)
                    try:
                        small_bmp.recycle()
                    except Exception:
                        pass
            else:
                mask = J['Paint']()
                mask_color = int(self._mask_color(bmp, left, top, right, bottom)) & 0xFFFFFFFF
                a = (mask_color >> 24) & 0xFF
                r = (mask_color >> 16) & 0xFF
                g = (mask_color >> 8) & 0xFF
                b = mask_color & 0xFF
                mask.setARGB(int(a), int(r), int(g), int(b))
                canvas.drawRect(float(left), float(top), float(right), float(bottom), mask)

                if style == 4:
                    return
                
                effect_color = text_color if text_color is not None else self._spoiler_color
                if style == 2 and J.get('Spoiler'):
                    effect = J['Spoiler']()
                    call_int_color(effect, "setColor", effect_color)
                    effect.setBounds(int(left), int(top), int(right), int(bottom))
                    effect.draw(canvas)
                else:
                    pattern = J['Paint']()
                    set_paint_color(pattern, effect_color)
                    try:
                        pattern.setStrokeWidth(float(max(1, AndroidUtilities.dp(1))))
                        pattern.setStyle(J['Paint'].Style.STROKE)
                    except Exception:
                        pass
                    step = max(1, int(AndroidUtilities.dp(6)))
                    span = int(bottom - top)
                    x = int(left - span)
                    end_x = int(right + span)
                    while x < end_x:
                        canvas.drawLine(float(x), float(top), float(x + span), float(bottom), pattern)
                        x += step
        except Exception as e:
            log(f"[QuoteCreate] Anonymize overlay error: {e}")
        finally:
            if saved:
                try:
                    canvas.restore()
                except Exception:
                    pass

    def _round_radius(self, receiver, bounds=None):
        radius = 0
        try:
            if receiver is not None:
                radii = receiver.getRoundRadius()
                if radii is not None:
                    try:
                        radius = max(int(value or 0) for value in radii)
                    except Exception:
                        radius = int(radii[0] or 0)
        except Exception:
            radius = 0

        try:
            if bounds:
                max_radius = max(1, min(int(bounds[2] - bounds[0]), int(bounds[3] - bounds[1])) // 2)
                if radius <= 0:
                    radius = max_radius
                else:
                    radius = min(int(radius), max_radius)
        except Exception:
            pass

        return int(radius) if radius > 0 else None

    def _name_spoiler(self, cell):
        try:
            draw_name_layout = bool(getattr(cell, "drawNameLayout", False))
            name_layout = getattr(cell, "nameLayout", None)
            if name_layout is None:
                name_layout = get_private_field(cell, "nameLayout")
            if not draw_name_layout or not name_layout:
                return None
            selector_bounds = self._drawable_bounds(getattr(cell, "nameLayoutSelector", None), pad=AndroidUtilities.dp(1))
            if not selector_bounds:
                try:
                    selector_bounds = self._drawable_bounds(get_private_field(cell, "nameLayoutSelector"), pad=AndroidUtilities.dp(1))
                except Exception:
                    selector_bounds = None
            if selector_bounds:
                return selector_bounds

            name_x = float(getattr(cell, "nameX", 0) or 0)
            name_y = float(getattr(cell, "nameY", 0) or 0)
            name_offset_x = float(getattr(cell, "nameOffsetX", 0) or 0)
            
            width = 0
            if name_layout.getLineCount() > 0:
                width = int(max(1, name_layout.getLineWidth(0)))
            if width <= 0:
                width = int(getattr(cell, "nameLayoutWidth", 0) or 0)
            if width <= 0:
                return None
                
            height = int(max(1, name_layout.getHeight()))
            left = int(name_x + name_offset_x - AndroidUtilities.dp(2))
            top = int(name_y - AndroidUtilities.dp(1))
            right = int(left + width + AndroidUtilities.dp(4))
            bottom = int(top + height + AndroidUtilities.dp(2))
            if right > left and bottom > top:
                return left, top, right, bottom
        except Exception:
            pass
        return None

    def _name_avatar(self, cell):
        try:
            if not bool(getattr(cell, "drawNameAvatar", False)):
                return None
            name_x = float(getattr(cell, "nameX", 0) or 0)
            name_y = float(getattr(cell, "nameY", 0) or 0)
            if int(getattr(cell, "currentNameBotVerificationId", 0) or 0) != 0:
                name_x -= AndroidUtilities.dp(20)
            size = AndroidUtilities.dp(26)
            left = int(name_x)
            top = int(name_y)
            right = int(name_x + size)
            bottom = int(name_y + size)
            if right > left and bottom > top:
                return left, top, right, bottom
        except Exception:
            pass
        return None

    def _receiver_bounds(self, receiver):
        try:
            if receiver is None:
                return None
            left = int(receiver.getImageX())
            top = int(receiver.getImageY())
            right = int(receiver.getImageX2())
            bottom = int(receiver.getImageY2())
            if right <= left:
                right = int(left + receiver.getImageWidth())
            if bottom <= top:
                bottom = int(top + receiver.getImageHeight())
            if right > left and bottom > top:
                return left, top, right, bottom
        except Exception:
            pass
        return None

    def _offset_bounds(self, bounds, dx=0, dy=0):
        try:
            if not bounds:
                return None
            left, top, right, bottom = bounds
            return (
                int(left + dx),
                int(top + dy),
                int(right + dx),
                int(bottom + dy)
            )
        except Exception:
            return None

    def _rect_bounds(self, rect, pad_x=0, pad_y=0):
        try:
            if rect is None:
                return None
            left = int(float(getattr(rect, "left", 0) or 0))
            top = int(float(getattr(rect, "top", 0) or 0))
            right = int(float(getattr(rect, "right", 0) or 0))
            bottom = int(float(getattr(rect, "bottom", 0) or 0))
            left -= int(pad_x)
            top -= int(pad_y)
            right += int(pad_x)
            bottom += int(pad_y)
            if right > left and bottom > top:
                return left, top, right, bottom
        except Exception:
            pass
        return None

    def _drawable_bounds(self, drawable, pad=0):
        try:
            if drawable is None:
                return None
            try:
                if bool(drawable.isEmpty()):
                    return None
            except Exception:
                pass
            rect = drawable.getBounds()
            return self._rect_bounds(rect, pad_x=pad, pad_y=pad)
        except Exception:
            return None

    def _merge_bounds(self, *bounds_list):
        valid = [b for b in bounds_list if b]
        if not valid:
            return None
        try:
            left = min(int(b[0]) for b in valid)
            top = min(int(b[1]) for b in valid)
            right = max(int(b[2]) for b in valid)
            bottom = max(int(b[3]) for b in valid)
            if right > left and bottom > top:
                return left, top, right, bottom
        except Exception:
            pass
        return None

    def _name_status(self, cell):
        try:
            drawable = getattr(cell, "currentNameStatusDrawable", None)
            bounds = self._drawable_bounds(drawable, pad=AndroidUtilities.dp(2))
            if bounds:
                return bounds
        except Exception:
            pass
        return None

    def _name_verify(self, cell):
        try:
            drawable = getattr(cell, "currentNameEmojiStatusDrawable", None)
            bounds = self._drawable_bounds(drawable, pad=AndroidUtilities.dp(2))
            if bounds:
                return bounds
        except Exception:
            pass
        return None

    def _get_admin_bounds(self, cell):
        admin_bounds = None
        boost_bounds = None
        try:
            admin_rect = get_private_field(cell, "adminLayoutRect")
            admin_bounds = self._rect_bounds(admin_rect, pad_x=AndroidUtilities.dp(2), pad_y=AndroidUtilities.dp(2))
        except Exception:
            admin_bounds = None
        try:
            boost_rect = get_private_field(cell, "boostCounterBounds")
            boost_bounds = self._rect_bounds(boost_rect, pad_x=AndroidUtilities.dp(2), pad_y=AndroidUtilities.dp(2))
        except Exception:
            boost_bounds = None
        return self._merge_bounds(admin_bounds, boost_bounds)

    def _sign_bounds(self, cell):
        try:
            sign_width = int(getattr(cell, "signWidth", 0) or 0)
            if sign_width <= 0:
                return None

            time_layout = getattr(cell, "timeLayout", None)
            if time_layout is None or time_layout.getLineCount() <= 0:
                return None

            draw_time_x = float(get_private_field(cell, "drawTimeX") or 0)
            draw_time_y = float(get_private_field(cell, "drawTimeY") or 0)
            line_left = float(time_layout.getLineLeft(0))
            line_width = float(time_layout.getLineWidth(0))
            height = int(max(1, time_layout.getHeight()))

            text_left = draw_time_x + line_left
            text_right = text_left + line_width

            current_msg = getattr(cell, "currentMessageObject", None)
            if current_msg is None:
                current_msg = get_private_field(cell, "currentMessageObject")
            sign_after_time = False
            if current_msg is not None:
                try:
                    sign_after_time = int(getattr(current_msg.messageOwner, "via_business_bot_id", 0) or 0) != 0
                except Exception:
                    sign_after_time = False

            if sign_after_time:
                left = text_right - sign_width
                right = text_right
            else:
                left = text_left
                right = text_left + sign_width

            return (
                int(left - AndroidUtilities.dp(2)),
                int(draw_time_y - AndroidUtilities.dp(1)),
                int(right + AndroidUtilities.dp(4)),
                int(draw_time_y + height + AndroidUtilities.dp(1))
            )
        except Exception:
            return None

    def _reply_name(self, cell):
        try:
            reply_name_layout = getattr(cell, "replyNameLayout", None)
            if not reply_name_layout:
                reply_name_layout = get_private_field(cell, "replyNameLayout")
            if not reply_name_layout:
                return None

            reply_start_x = float(getattr(cell, "replyStartX", 0) or 0)
            reply_start_y = float(getattr(cell, "replyStartY", 0) or 0)
            reply_name_offset = int(getattr(cell, "replyNameOffset", 0) or 0)
            need_reply_image = bool(getattr(cell, "needReplyImage", False))

            offset = AndroidUtilities.dp(10)
            msg_obj = getattr(cell, "currentMessageObject", None)
            if msg_obj is None:
                msg_obj = get_private_field(cell, "currentMessageObject")
            should_draw_without_bg = False
            if msg_obj:
                try:
                    should_draw_without_bg = bool(msg_obj.shouldDrawWithoutBackground())
                except Exception:
                    should_draw_without_bg = False
            offset_x = -AndroidUtilities.dp(6) if should_draw_without_bg else -AndroidUtilities.dp(1)
            offset_y = AndroidUtilities.dp(1) if should_draw_without_bg else AndroidUtilities.dp(3)

            x = reply_start_x + offset_x - reply_name_offset + offset
            if need_reply_image:
                try:
                    reply_img = getattr(cell, "replyImageReceiver", None)
                    if reply_img:
                        x += float(reply_img.getImageWidth()) + AndroidUtilities.dp(3)
                    else:
                        x += AndroidUtilities.dp(28)
                except Exception:
                    x += AndroidUtilities.dp(28)

            width = 0
            try:
                if reply_name_layout.getLineCount() > 0:
                    width = int(max(1, reply_name_layout.getLineWidth(0)))
            except Exception:
                width = 0
            if width <= 0:
                try:
                    width = int(max(1, reply_name_layout.getWidth()))
                except Exception:
                    width = 0
            if width <= 0:
                return None

            height = int(max(1, reply_name_layout.getHeight()))
            left = int(x - AndroidUtilities.dp(2))
            top = int(reply_start_y + offset_y - AndroidUtilities.dp(1))
            right = int(x + width + AndroidUtilities.dp(4))
            bottom = int(top + height + AndroidUtilities.dp(1))
            if right > left and bottom > top:
                return left, top, right, bottom
        except Exception:
            pass
        return None

    def _fwd_name(self, cell):
        try:
            draw_forwarded = getattr(cell, "drawForwardedName", None)
            if draw_forwarded is None:
                draw_forwarded = get_private_field(cell, "drawForwardedName")
            if not bool(draw_forwarded):
                return None

            forwarded_layout = getattr(cell, "forwardedNameLayout", None)
            if forwarded_layout is None:
                forwarded_layout = get_private_field(cell, "forwardedNameLayout")
            if not forwarded_layout:
                return None
            try:
                if forwarded_layout[0] is None:
                    return None
            except Exception:
                pass

            fx = float(getattr(cell, "forwardNameX", 0) or 0)
            fy = float(getattr(cell, "forwardNameY", 0) or 0)
            
            fw = 0
            fh = 0
            try:
                if forwarded_layout.getLineCount() > 0:
                    fw = float(max(1, forwarded_layout.getLineWidth(0)))
                    fh = float(max(1, forwarded_layout.getHeight()))
            except Exception:
                pass
                
            if fw <= 0 or fh <= 0:
                fw = float(getattr(cell, "forwardedNameWidth", 0) or 0)
                fh = float(getattr(cell, "forwardHeight", 0) or 0)
                if fw <= 0 or fh <= 0:
                    try:
                        fx = float(get_private_field(cell, "forwardNameX") or fx)
                        fy = float(get_private_field(cell, "forwardNameY") or fy)
                        fw = float(get_private_field(cell, "forwardedNameWidth") or fw)
                        fh = float(get_private_field(cell, "forwardHeight") or fh)
                    except Exception:
                        pass

            left = int(fx - AndroidUtilities.dp(2))
            top = int(fy - AndroidUtilities.dp(1))
            right = int(fx + fw + AndroidUtilities.dp(4))
            bottom = int(fy + fh + AndroidUtilities.dp(1))
            if right > left and bottom > top:
                return left, top, right, bottom
        except Exception:
            pass
        return None

    def _via_name(self, cell):
        try:
            via_width = getattr(cell, "viaWidth", 0) or 0
            if not via_width:
                try:
                    via_width = get_private_field(cell, "viaWidth") or 0
                except Exception:
                    via_width = 0
            via_width = float(via_width)
            if via_width <= 0:
                return None

            name_x = float(getattr(cell, "nameX", 0) or 0)
            name_y = float(getattr(cell, "nameY", 0) or 0)
            via_name_width = float(getattr(cell, "viaNameWidth", 0) or 0)
            if via_name_width <= 0:
                try:
                    via_name_width = float(get_private_field(cell, "viaNameWidth") or 0)
                except Exception:
                    via_name_width = 0

            left = int(name_x + via_name_width - AndroidUtilities.dp(2))
            top = int(name_y - AndroidUtilities.dp(4) - AndroidUtilities.dp(1))
            right = int(name_x + via_name_width + via_width + AndroidUtilities.dp(2))
            bottom = int(name_y + AndroidUtilities.dp(20) + AndroidUtilities.dp(1))
            if right > left and bottom > top:
                return left, top, right, bottom
        except Exception:
            pass
        return None

    def _username_bounds(self, cell, msg):
        result = []
        try:
            try:
                text = str(getattr(msg, "messageText", None) or "")
            except Exception:
                text = ""
            if not text:
                return result

            matches = [(m.start(), m.end()) for m in USERNAME_RE.finditer(text)]
            if not matches:
                return result

            blocks = getattr(msg, "textLayoutBlocks", None)
            if blocks is None:
                return result
            try:
                block_count = int(blocks.size())
            except Exception:
                return result
            if block_count <= 0:
                return result

            text_x = int(getattr(cell, "textX", 0) or 0)
            text_y = int(getattr(cell, "textY", 0) or 0)
            pad = AndroidUtilities.dp(1)

            for index in range(block_count):
                block = blocks.get(index)
                layout = getattr(block, "textLayout", None)
                if layout is None:
                    continue
                try:
                    char_start = int(getattr(block, "charactersOffset", 0) or 0)
                    char_end = int(getattr(block, "charactersEnd", 0) or 0)
                except Exception:
                    continue
                block_y = 0.0
                for getter in (
                    lambda: block.textYOffset(blocks, cell.transitionParams),
                    lambda: block.textYOffset(blocks),
                    lambda: getattr(block, "textYOffset"),
                ):
                    try:
                        block_y = float(getter())
                        break
                    except Exception:
                        continue

                length = int(layout.getText().length())
                for start, end in matches:
                    local_start = start - char_start
                    local_end = end - char_start
                    if local_end <= 0 or local_start >= length:
                        continue
                    local_start = max(0, local_start)
                    local_end = min(length, local_end)
                    if local_end <= local_start:
                        continue
                    try:
                        line = int(layout.getLineForOffset(local_start))
                        end_line = int(layout.getLineForOffset(max(local_start, local_end - 1)))
                    except Exception:
                        continue
                    for current_line in range(line, end_line + 1):
                        try:
                            line_start = max(local_start, int(layout.getLineStart(current_line)))
                            line_end = min(local_end, int(layout.getLineEnd(current_line)))
                            if line_end <= line_start:
                                continue
                            x1 = float(layout.getPrimaryHorizontal(line_start))
                            x2 = float(layout.getPrimaryHorizontal(line_end))
                            if x2 < x1:
                                x1, x2 = x2, x1
                            top = float(layout.getLineTop(current_line))
                            bottom = float(layout.getLineBottom(current_line))
                        except Exception:
                            continue
                        left = int(text_x + x1) - pad
                        right = int(text_x + x2) + pad
                        top_px = int(text_y + block_y + top) - pad
                        bottom_px = int(text_y + block_y + bottom) + pad
                        if right > left and bottom_px > top_px:
                            result.append((left, top_px, right, bottom_px))
        except Exception as e:
            log(f"[QuoteCreate] Username bounds failed: {e}")
        return result

    def _is_action_msg(self, msg):
        try:
            if msg is None:
                return False
            if bool(getattr(msg, "isDateObject", False)):
                return True
            return int(getattr(msg, "contentType", 0) or 0) == 1
        except Exception:
            return False

    def _render_action(self, msg, theme, width, screen_height, action_cell, anonymize_avatar=False, style=0):
        if not action_cell:
            return None
        try:
            try:
                action_cell.setMessageObject(msg, True)
            except Exception:
                action_cell.setMessageObject(msg)

            try:
                photo_receiver = action_cell.getPhotoImage()
                if photo_receiver:
                    photo_receiver.setAllowLoadingOnAttachedOnly(False)
                    ImageLoader.getInstance().loadImageForImageReceiver(photo_receiver)
            except Exception:
                pass

            w = max(1, int(width))
            sh = max(1, int(screen_height))
            action_cell.measure(J['View'].MeasureSpec.makeMeasureSpec(w, 1073741824), J['View'].MeasureSpec.makeMeasureSpec(0, 0))
            h = action_cell.getMeasuredHeight()
            if h <= 0:
                return None
            action_cell.layout(0, 0, w, h)
            try:
                action_cell.setVisiblePart(0.0, sh)
            except Exception:
                try:
                    action_cell.setVisiblePart(0.0, 0.0, sh, 0.0)
                except Exception:
                    pass

            bmp = J['Bmp'].createBitmap(w, h, J['Bmp'].Config.ARGB_8888)
            canvas = J['Canvas'](bmp)
            action_cell.draw(canvas)

            content_left, content_right = 0, w
            try:
                bg_left = int(get_private_field(action_cell, "backgroundLeft"))
                bg_right = int(get_private_field(action_cell, "backgroundRight"))
                if bg_right > bg_left:
                    pad = int(AndroidUtilities.dp(8))
                    content_left = max(0, bg_left - pad)
                    content_right = min(w, max(content_left + 1, bg_right + pad))
            except Exception:
                pass
            if anonymize_avatar and not bool(getattr(msg, "isDateObject", False)):
                text_color = None
                try:
                    if theme:
                        text_color = Theme.getColor(Theme.key_chat_serviceText, theme)
                    else:
                        text_color = Theme.getColor(Theme.key_chat_serviceText)
                except Exception:
                    text_color = None
                photo_receiver = action_cell.getPhotoImage()
                photo_bounds = self._receiver_bounds(photo_receiver)
                if photo_bounds:
                    self._draw_spoiler(
                        canvas,
                        bmp,
                        *photo_bounds,
                        clip_circle=True,
                        clip_radius=self._round_radius(photo_receiver, photo_bounds),
                        style=style,
                        text_color=text_color
                    )
            return bmp, content_left, content_right, h, 0
        except Exception as e:
            log(f"[QuoteCreate] Action cell render failed: {e}")
            return None

    def render(self, bg_bmp, transparent=False):
        bitmaps = []
        try:
            anonymize_nickname = bool(self.pl.get_setting("anonymize_nickname", False))
            anonymize_avatar = bool(self.pl.get_setting("anonymize_avatar", False))
            anonymize_style = int(self.pl.get_setting("anonymize_style", 0) or 0)
            anonymize_usernames = bool(self.pl.get_setting("anonymize_usernames", False))
            fake_name_enabled = bool(self.pl.get_setting("anonymize_fake_name", False))
            hide_time = bool(self.pl.get_setting("hide_time", False))
            hide_status = bool(self.pl.get_setting("hide_status", False))
            hide_reactions = bool(self.pl.get_setting("hide_reactions", False))
            hide_media = bool(self.pl.get_setting("hide_media", False))
            if self._anonymize_enabled_override is False:
                anonymize_nickname = False
                anonymize_avatar = False
            fake_name = ""
            if anonymize_nickname and fake_name_enabled:
                try:
                    fake_name = str(self.pl.get_setting("anonymize_fake_text", "Аноним") or "").strip() or "Аноним"
                except Exception:
                    fake_name = "Аноним"
            enable_anonymize = anonymize_nickname or anonymize_avatar or anonymize_usernames
            prepared = []
            def is_same(m1, m2):
                if self._is_action_msg(m1) or self._is_action_msg(m2):
                    return False
                return m1.getSenderId() == m2.getSenderId() and abs(m1.messageOwner.date - m2.messageOwner.date) < 300
            for i, orig in enumerate(self.msgs):
                try:
                    bn = i < len(self.msgs)-1 and is_same(self.msgs[i+1], orig)
                    tn = i > 0 and is_same(orig, self.msgs[i-1])
                    prepared.append((orig, bn, tn))
                except: pass
            if not prepared: return None
            evt = threading.Event()
            def ui_task():
                try:
                    delegate = Delegate(self.chat)
                    res, theme = get_private_field(self.chat, "sharedResources"), get_private_field(self.chat, "themeDelegate")
                    acc = get_private_field(self.chat, "currentAccount")
                    cur_chat = None
                    cur_user = None
                    try: cur_chat = get_private_field(self.chat, "currentChat")
                    except: pass
                    try: cur_user = get_private_field(self.chat, "currentUser")
                    except: pass
                    if not all([delegate, res, theme]): return
                    render_width, screen_height = self._surface_size()

                    plan = []
                    unit_counter = 0
                    idx = 0
                    total_prepared = len(prepared)
                    try:
                        album_width = int(AndroidUtilities.displaySize.x) or render_width
                    except Exception:
                        album_width = render_width
                    album_width = max(1, min(render_width, album_width))
                    while idx < total_prepared:
                        gid = 0 if hide_media else self._group_id(prepared[idx][0])
                        run_end = idx + 1
                        if gid:
                            while run_end < total_prepared and self._group_id(prepared[run_end][0]) == gid:
                                run_end += 1
                        group = None
                        geom = None
                        if gid and run_end - idx > 1:
                            group = self._make_group([prepared[k][0] for k in range(idx, run_end)])
                            if group is not None:
                                geom = self._album_geometry(group, album_width)
                                if len(geom) != run_end - idx:
                                    group, geom = None, None
                        if group is None:
                            for k in range(idx, run_end):
                                msg_k, bn_k, tn_k = prepared[k]
                                plan.append((msg_k, bn_k, tn_k, None, None, None, 0, render_width, unit_counter))
                                unit_counter += 1
                        else:
                            group_tn = prepared[idx][2]
                            group_bn = prepared[run_end - 1][1]
                            for j in range(run_end - idx):
                                msg_k = prepared[idx + j][0]
                                pos = group.posArray.get(j)
                                flags = int(getattr(pos, "flags", 0) or 0)
                                tn_k = group_tn if (flags & 4) else True
                                bn_k = group_bn if (flags & 8) else True
                                row_index, cell_x, cell_w = geom[j]
                                plan.append((msg_k, bn_k, tn_k, group, pos, row_index, cell_x, cell_w, unit_counter))
                            unit_counter += 1
                        idx = run_end

                    unit_items = []
                    current_unit = [-1]

                    def flush_unit():
                        items = list(unit_items)
                        del unit_items[:]
                        if not items:
                            return
                        if len(items) == 1 and items[0][6] is None:
                            bmp_s, left_s, right_s, h_s, inset_s = items[0][0], items[0][1], items[0][2], items[0][3], items[0][4]
                            bitmaps.append((bmp_s, left_s, right_s, h_s, inset_s))
                            return
                        try:
                            row_heights = {}
                            for it in items:
                                row = int(it[6] or 0)
                                row_heights[row] = max(row_heights.get(row, 0), int(it[3]) + int(it[7]))
                            row_tops = {}
                            acc = 0
                            for row in sorted(row_heights.keys()):
                                row_tops[row] = acc
                                acc += max(0, row_heights[row])
                            logical_h = max(1, acc)
                            group_inset = 0
                            for it in items:
                                draw_top = row_tops.get(int(it[6] or 0), 0) - int(it[4])
                                if draw_top < -group_inset:
                                    group_inset = -draw_top
                            height = group_inset + logical_h
                            for it in items:
                                bottom = group_inset + row_tops.get(int(it[6] or 0), 0) - int(it[4]) + int(it[0].getHeight())
                                if bottom > height:
                                    height = bottom
                            album = J['Bmp'].createBitmap(max(1, render_width), max(1, height), J['Bmp'].Config.ARGB_8888)
                            album_canvas = J['Canvas'](album)
                            album_left = None
                            album_right = 0
                            for it in items:
                                x = int(it[5])
                                y = group_inset + row_tops.get(int(it[6] or 0), 0) - int(it[4])
                                album_canvas.drawBitmap(it[0], float(x), float(y), None)
                                left = max(0, min(render_width, int(it[1]) + x))
                                right = max(0, min(render_width, int(it[2]) + x))
                                if album_left is None or left < album_left:
                                    album_left = left
                                if right > album_right:
                                    album_right = right
                            if album_left is None or album_right <= album_left:
                                album_left, album_right = 0, render_width
                            bitmaps.append((album, album_left, album_right, logical_h, group_inset))
                        except Exception as e:
                            log(f"[QuoteCreate] Album compose failed: {e}")
                        finally:
                            for it in items:
                                try:
                                    it[0].recycle()
                                except Exception:
                                    pass

                    cell_normal = None
                    action_cell = None
                    for msg, bn, tn, group, position, row_index, cell_x, cell_w, unit_index in plan:
                        if unit_index != current_unit[0]:
                            flush_unit()
                            current_unit[0] = unit_index
                        cell = None
                        spoiler_state = None
                        orig_reactions = None
                        orig_type = None
                        orig_custom_name = None
                        custom_name_set = False
                        try:
                            msg.messageOwner.pinned = delegate.isPinnedMessage(msg)

                            if fake_name:
                                try:
                                    orig_custom_name = getattr(msg, "customName", None)
                                    msg.customName = fake_name
                                    custom_name_set = True
                                except Exception:
                                    custom_name_set = False
                            try:
                                if msg.hasMediaSpoilers() and not msg.needDrawBluredPreview():
                                    spoiler_state = (
                                        bool(getattr(msg, "isMediaSpoilersRevealed", False)),
                                        bool(getattr(msg, "isMediaSpoilersRevealedInSharedMedia", False)),
                                        bool(getattr(msg, "revealingMediaSpoilers", False))
                                    )
                                    msg.isMediaSpoilersRevealed = True
                                    msg.isMediaSpoilersRevealedInSharedMedia = True
                                    msg.revealingMediaSpoilers = False
                            except Exception:
                                    spoiler_state = None

                            if hide_reactions:
                                try:
                                    orig_reactions = getattr(msg.messageOwner, "reactions", None)
                                    if orig_reactions is not None:
                                        msg.messageOwner.reactions = None
                                except Exception:
                                    pass

                            if hide_media:
                                try:
                                    orig_type = msg.type
                                    msg.type = 0
                                except Exception:
                                    pass

                            if self._is_action_msg(msg):
                                if not action_cell:
                                    action_cls = J.get('ActionCell')
                                    if action_cls:
                                        try: action_cell = action_cls(self.ctx, False, theme)
                                        except Exception: action_cell = action_cls(self.ctx)
                                        if action_cell:
                                            action_cell.onAttachedToWindow()
                                            try: action_cell.isForum = bool(cur_chat and ChatObject.isForum(cur_chat))
                                            except: pass
                                            try: action_cell.isMonoForum = bool(cur_chat and ChatObject.isMonoForum(cur_chat))
                                            except: pass
                                            try: action_cell.setShowTopic(True)
                                            except: pass
                                action_bitmap = self._render_action(
                                    msg,
                                    theme,
                                    render_width,
                                    screen_height,
                                    action_cell,
                                    anonymize_avatar=anonymize_avatar,
                                    style=anonymize_style,
                                )
                                if action_bitmap:
                                    bitmaps.append(action_bitmap)
                                continue

                            if not cell_normal:
                                cell_normal = J['Cell'](self.ctx, acc, True, res, theme)
                                cell_normal.onAttachedToWindow()
                                cell_normal.setDelegate(delegate)
                                try: cell_normal.isChat = cur_chat is not None
                                except: pass
                                try: cell_normal.isBot = bool(cur_user and getattr(cur_user, "bot", False))
                                except: pass
                                try: cell_normal.isMegagroup = bool(cur_chat and ChatObject.isChannel(cur_chat) and getattr(cur_chat, "megagroup", False))
                                except: pass
                                cell_normal.drawingToBitmap = True
                                try: cell_normal.setFullyDraw(True)
                                except: pass

                            cell = cell_normal
                            image_receivers = []
                            for img_field in ["avatarImage", "photoImage", "blurredPhotoImage",
                                              "replyImageReceiver", "locationImageReceiver"]:
                                img = get_private_field(cell, img_field)
                                if img:
                                    img.setAllowLoadingOnAttachedOnly(False)
                                    image_receivers.append(img)
                            is_outgoing = msg.isOutOwner()
                            w = int(cell_w) if cell_w else render_width
                            cell.setParentViewSize(render_width, screen_height)
                            cell.setMessageObject(msg, group, bn, tn, False)

                            cell.measure(J['View'].MeasureSpec.makeMeasureSpec(w, 1073741824), J['View'].MeasureSpec.makeMeasureSpec(0, 0))
                            h = cell.getMeasuredHeight()
                            if h <= 0: continue
                            cell.layout(0, 0, w, h)
                            decor_bottom = 0
                            if position is not None:
                                decor_bottom = self._album_decor_bottom(cell, group, position)

                            if hide_time:
                                set_private_field(cell, "timeLayout", None)

                            if hide_status:
                                set_private_field(cell, "animateToStatusDrawableParams", Integer(0))
                                set_private_field(cell, "statusDrawableAnimationInProgress", True)
                                set_private_field(cell, "viewsLayout", None)
                                set_private_field(cell, "repliesLayout", None)


                            cell.setParentViewSize(render_width, screen_height)
                            try:
                                cell.setVisiblePart(0, h, screen_height, 0.0, 0.0, render_width, screen_height, 0, 0, 0)
                            except:
                                pass
                            try:
                                loader = ImageLoader.getInstance()
                                for img in image_receivers:
                                    loader.loadImageForImageReceiver(img)
                            except Exception:
                                pass
                            try:
                                if msg.type == MessageObject.TYPE_POLL:
                                    poll_buttons = cell.getPollButtons()
                                    if poll_buttons and poll_buttons.size() > 0:
                                        cell.firstVisiblePollButton = 0
                                        cell.lastVisiblePollButton = poll_buttons.size() - 1
                            except: pass
                            content_left, content_right = 0, w
                            try:
                                bl = int(cell.getBoundsLeft())
                                br = int(cell.getBoundsRight())
                                if br > bl:
                                    content_left = max(0, bl)
                                    content_right = min(w, max(content_left + 1, br))
                            except:
                                pass
                            if content_right <= content_left:
                                content_left, content_right = 0, w
                            base_left_pad = int(AndroidUtilities.dp(14))
                            base_right_pad = int(AndroidUtilities.dp(64 if is_outgoing else 0))
                            extra_right_pad = 0
                            has_reply = False
                            try:
                                has_reply = bool(msg.getReplyMsgId() != 0 or msg.getReplyTopMsgId() != 0)
                            except Exception:
                                has_reply = False
                            if not has_reply:
                                try:
                                    has_reply = bool(getattr(msg.messageOwner, "reply_to", None))
                                except Exception:
                                    has_reply = False
                            draw_forwarded = False
                            try:
                                draw_forwarded = bool(getattr(cell, "drawForwardedName", False))
                            except Exception:
                                draw_forwarded = False
                            if has_reply and is_outgoing:
                                extra_right_pad += int(AndroidUtilities.dp(170))
                            if draw_forwarded:
                                extra_right_pad += int(AndroidUtilities.dp(70))
                            content_left = max(0, content_left - base_left_pad)
                            content_right = min(w, max(content_left + 1, content_right + base_right_pad + extra_right_pad))
                            force_avatar = False
                            try:
                                force_avatar = bool(getattr(msg, "forceAvatar", False) or getattr(msg, "customAvatarDrawable", None) is not None)
                            except Exception:
                                force_avatar = False
                            quote_avatar_slot = bool(not is_outgoing and (not bn or force_avatar))
                            if position is not None and not bool(getattr(cell, "isAvatarVisible", False)):
                                quote_avatar_slot = False
                            should_draw_quote_avatar = bool(cell.isAvatarVisible and quote_avatar_slot)
                            top_inset = 0
                            try:
                                if should_draw_quote_avatar:
                                    avatar_size = int(AndroidUtilities.dp(42))
                                    avatar_top = h - avatar_size - int(AndroidUtilities.dp(4))
                                    if avatar_top < 0:
                                        top_inset = -avatar_top
                            except Exception:
                                top_inset = 0

                            bmp_w = max(1, render_width - int(cell_x)) if position is not None else w
                            bmp = J['Bmp'].createBitmap(max(1, bmp_w), h + top_inset, J['Bmp'].Config.ARGB_8888)
                            canvas = J['Canvas'](bmp)
                            try:
                                if bool(cell.drawBackgroundInParent()):
                                    canvas.save()
                                    try:
                                        canvas.translate(0.0, float(top_inset + cell.getPaddingTop()))
                                        cell.drawBackgroundInternal(canvas, True)
                                    finally:
                                        canvas.restore()
                            except Exception:
                                pass
                            canvas.save()
                            try:
                                if top_inset:
                                    canvas.translate(0.0, float(top_inset))
                                cell.draw(canvas)
                            finally:
                                canvas.restore()
                            if position is not None:
                                canvas.save()
                                try:
                                    canvas.translate(0.0, float(top_inset + cell.getPaddingTop()))
                                    self._draw_group_extras(canvas, cell, position)
                                finally:
                                    canvas.restore()
                            avatar_bounds_before_manual = None
                            avatar_receiver = None
                            avatar_round_radius = None
                            try:
                                if should_draw_quote_avatar:
                                    avatar_before = cell.getAvatarImage()
                                    if avatar_before:
                                        avatar_receiver = avatar_before
                                        bx1 = int(avatar_before.getImageX())
                                        by1 = int(avatar_before.getImageY())
                                        bx2 = int(avatar_before.getImageX2())
                                        by2 = int(avatar_before.getImageY2())
                                        if bx2 > bx1 and by2 > by1:
                                            avatar_bounds_before_manual = self._offset_bounds((bx1, by1, bx2, by2), dy=top_inset)
                            except Exception:
                                pass
                            manual_avatar_bounds = None
                            if quote_avatar_slot and not bn:
                                avatarImage = cell.getAvatarImage()
                                if avatarImage:
                                    avatar_receiver = avatarImage
                                    avatarSize = AndroidUtilities.dp(42)
                                    avatarX = AndroidUtilities.dp(6)
                                    avatarY = h - avatarSize - AndroidUtilities.dp(4)
                                    if not anonymize_avatar:
                                        canvas.save()
                                        try:
                                            if top_inset:
                                                canvas.translate(0.0, float(top_inset))
                                            avatarImage.setImageCoords(avatarX, avatarY, avatarSize, avatarSize)
                                            avatarImage.setVisible(True, False)
                                            avatarImage.draw(canvas)
                                        finally:
                                            canvas.restore()
                                    manual_avatar_bounds = self._offset_bounds((avatarX, avatarY, avatarX + avatarSize, avatarY + avatarSize), dy=top_inset)
                                elif anonymize_avatar:
                                    avatarSize = AndroidUtilities.dp(42)
                                    avatarX = AndroidUtilities.dp(6)
                                    avatarY = h - avatarSize - AndroidUtilities.dp(4)
                                    manual_avatar_bounds = self._offset_bounds((avatarX, avatarY, avatarX + avatarSize, avatarY + avatarSize), dy=top_inset)
                            primary_avatar_bounds = manual_avatar_bounds or avatar_bounds_before_manual
                            avatar_round_radius = self._round_radius(
                                avatar_receiver,
                                primary_avatar_bounds
                            )
                            for bounds in (avatar_bounds_before_manual, manual_avatar_bounds):
                                if bounds:
                                    content_left = max(0, min(content_left, bounds[0] - int(AndroidUtilities.dp(6))))

                            if enable_anonymize:
                                try:
                                    text_color = None
                                    try:
                                        if is_outgoing:
                                            text_color = Theme.getColor(Theme.key_chat_messageTextOut, theme) if theme else Theme.getColor(Theme.key_chat_messageTextOut)
                                        else:
                                            text_color = Theme.getColor(Theme.key_chat_messageTextIn, theme) if theme else Theme.getColor(Theme.key_chat_messageTextIn)
                                    except Exception:
                                        pass
                                    if anonymize_usernames:
                                        for username_bounds in self._username_bounds(cell, msg):
                                            shifted = self._offset_bounds(username_bounds, dy=top_inset)
                                            if shifted:
                                                self._draw_spoiler(canvas, bmp, *shifted, clip_circle=False, style=anonymize_style, text_color=text_color)
                                    if anonymize_nickname:
                                        if not fake_name:
                                            name_bounds = self._offset_bounds(self._name_spoiler(cell), dy=top_inset)
                                            if name_bounds:
                                                self._draw_spoiler(canvas, bmp, *name_bounds, clip_circle=False, style=anonymize_style, text_color=text_color)
                                        reply_name_bounds = self._offset_bounds(self._reply_name(cell), dy=top_inset)
                                        if reply_name_bounds:
                                            self._draw_spoiler(canvas, bmp, *reply_name_bounds, clip_circle=False, style=anonymize_style, text_color=text_color)
                                        forwarded_bounds = self._offset_bounds(self._fwd_name(cell), dy=top_inset)
                                        if forwarded_bounds:
                                            self._draw_spoiler(canvas, bmp, *forwarded_bounds, clip_circle=False, style=anonymize_style, text_color=text_color)
                                        via_bounds = self._offset_bounds(self._via_name(cell), dy=top_inset)
                                        if via_bounds:
                                            self._draw_spoiler(canvas, bmp, *via_bounds, clip_circle=False, style=anonymize_style, text_color=text_color)
                                    if anonymize_avatar:
                                        if primary_avatar_bounds:
                                            self._draw_spoiler(
                                                canvas,
                                                bmp,
                                                *primary_avatar_bounds,
                                                clip_circle=True,
                                                clip_radius=avatar_round_radius,
                                                style=anonymize_style,
                                                text_color=text_color
                                            )
                                        name_avatar_bounds = self._offset_bounds(self._name_avatar(cell), dy=top_inset)
                                        if name_avatar_bounds:
                                            self._draw_spoiler(
                                                canvas,
                                                bmp,
                                                *name_avatar_bounds,
                                                clip_circle=True,
                                                clip_radius=avatar_round_radius,
                                                style=anonymize_style,
                                                text_color=text_color
                                            )
                                except Exception as e:
                                    log(f"[QuoteCreate] Anonymize draw error: {e}")
                            unit_items.append((bmp, content_left, content_right, h, top_inset, cell_x, row_index, decor_bottom))
                        except Exception as e:
                            try:
                                mid = msg.getId() if msg else "unknown"
                            except Exception:
                                mid = "unknown"
                            log(f"[QuoteCreate] Message render skipped ({mid}): {e}")
                        finally:
                            if orig_reactions is not None:
                                try: msg.messageOwner.reactions = orig_reactions
                                except: pass
                            if orig_type is not None:
                                try: msg.type = orig_type
                                except: pass
                            if custom_name_set:
                                try: msg.customName = orig_custom_name
                                except: pass
                            if spoiler_state is not None:
                                try:
                                    msg.isMediaSpoilersRevealed = spoiler_state[0]
                                    msg.isMediaSpoilersRevealedInSharedMedia = spoiler_state[1]
                                    msg.revealingMediaSpoilers = spoiler_state[2]
                                except Exception:
                                    pass
                    flush_unit()
                    if cell_normal:
                        try: cell_normal.onDetachedFromWindow()
                        except: pass
                    if action_cell:
                        try: action_cell.onDetachedFromWindow()
                        except: pass
                except: traceback.print_exc()
                finally: evt.set()
            run_on_ui_thread(ui_task)
            wait_limit = RENDER_WAIT_BASE_SEC + RENDER_WAIT_PER_MSG_SEC * len(prepared)
            if not evt.wait(timeout=wait_limit):
                raise Exception(f"рендер не завершился за {wait_limit:.1f}с")
            if not bitmaps: return None
            total_h, global_left, global_right = 0, None, 0
            layout_items = []
            min_draw_y, max_draw_y = 0, 0
            y_cursor = 0
            gap = AndroidUtilities.dp(2)
            for i, item in enumerate(bitmaps):
                b, l, r, logical_h, top_inset = item
                if global_left is None or l < global_left:
                    global_left = l
                if r > global_right:
                    global_right = r
                draw_top = y_cursor - top_inset
                draw_bottom = draw_top + b.getHeight()
                if draw_top < min_draw_y:
                    min_draw_y = draw_top
                if draw_bottom > max_draw_y:
                    max_draw_y = draw_bottom
                layout_items.append((b, y_cursor, top_inset))
                y_cursor += logical_h + (gap if i < len(bitmaps)-1 else 0)
            if global_left is None or global_right <= global_left:
                global_left = 0
                global_right = max(b.getWidth() for b, _, _, _, _ in bitmaps)
            content_w = max(1, global_right - global_left)
            total_h = max(1, max_draw_y - min_draw_y)
            if transparent:
                pad = AndroidUtilities.dp(8)
            else:
                pad = AndroidUtilities.dp(self.pl._setting_int_clamped("image_padding", 16, 0, 48))
            final = J['Bmp'].createBitmap(content_w + pad*2, total_h + pad*2, J['Bmp'].Config.ARGB_8888)
            canvas = J['Canvas'](final)
            if not transparent:
                bg_type = self.pl.get_setting("bg_type", 0)
                if bg_bmp and bg_type == 0:
                    src = J['Rect'](0, 0, bg_bmp.getWidth(), bg_bmp.getHeight())
                    dst = J['Rect'](0, 0, final.getWidth(), final.getHeight())
                    dwidth, dheight = final.getWidth(), final.getHeight()
                    vwidth, vheight = bg_bmp.getWidth(), bg_bmp.getHeight()
                    scale = max(dwidth / vwidth, dheight / vheight)
                    dx = (vwidth * scale - dwidth) / 2
                    dy = (vheight * scale - dheight) / 2
                    src.left = int(dx / scale)
                    src.top = int(dy / scale)
                    src.right = int(src.left + dwidth / scale)
                    src.bottom = int(src.top + dheight / scale)
                    canvas.drawBitmap(bg_bmp, src, dst, None)
                elif bg_type == 2:
                    c_str = self.pl.get_setting("bg_color", "#FF000000")
                    if not c_str.startswith("#"): c_str = "#" + c_str
                    try: col = J['Color'].parseColor(c_str)
                    except: col = 0xFF000000
                    if col != 0:
                        paint = J['Paint']()
                        a, r, g, b = (col >> 24) & 0xFF, (col >> 16) & 0xFF, (col >> 8) & 0xFF, col & 0xFF
                        paint.setARGB(a, r, g, b)
                        canvas.drawRect(0.0, 0.0, float(final.getWidth()), float(final.getHeight()), paint)
                elif bg_type == 0 and not bg_bmp:
                    paint = J['Paint']()
                    paint.setARGB(255, 0, 0, 0)
                    canvas.drawRect(0.0, 0.0, float(final.getWidth()), float(final.getHeight()), paint)
            draw_x = pad - global_left
            for b, logical_y, top_inset in layout_items:
                draw_y = pad + logical_y - top_inset - min_draw_y
                canvas.drawBitmap(b, float(draw_x), float(draw_y), None)
                b.recycle()

            scale_factor = 1.0 if (transparent or self._sticker) else self.pl._render_scale_factor()
            if scale_factor != 1.0:
                scaled = self._scale_bitmap(final, scale_factor)
                if scaled is not None and scaled is not final:
                    final.recycle()
                    final = scaled
                    canvas = J['Canvas'](final)

            self.pl._draw_watermark(
                canvas,
                final,
                chat=self.chat,
                count=len(layout_items),
                scale=scale_factor,
            )

            use_jpeg = (not transparent) and (not self._sticker) and self.pl._output_format_name() == "JPEG"
            if not use_jpeg and not self._sticker:
                radius = AndroidUtilities.dp(self.pl._setting_int_clamped("corner_radius", 0, 0, 48))
                if radius > 0:
                    rounded = self._round_corners(final, int(radius * scale_factor))
                    if rounded is not None and rounded is not final:
                        final.recycle()
                        final = rounded

            out = J['BAO']()
            if use_jpeg:
                quality = self.pl._setting_int_clamped("jpeg_quality", 92, 40, 100)
                flattened = self._flatten_alpha(final)
                if flattened is not None and flattened is not final:
                    final.recycle()
                    final = flattened
                final.compress(J['Bmp'].CompressFormat.JPEG, quality, out)
            else:
                final.compress(J['Bmp'].CompressFormat.PNG, 100, out)
            final.recycle()
            return out.toByteArray()
        except Exception:
            traceback.print_exc()
            return None

    def _scale_bitmap(self, bitmap, factor):
        try:
            width = max(1, int(round(bitmap.getWidth() * factor)))
            height = max(1, int(round(bitmap.getHeight() * factor)))
            if width == bitmap.getWidth() and height == bitmap.getHeight():
                return bitmap
            return J['Bmp'].createScaledBitmap(bitmap, width, height, True)
        except Exception as e:
            log(f"[QuoteCreate] Scale failed: {e}")
            return bitmap

    def _round_corners(self, bitmap, radius):
        try:
            width = int(bitmap.getWidth())
            height = int(bitmap.getHeight())
            radius = max(0, min(int(radius), min(width, height) // 2))
            if radius <= 0:
                return bitmap
            result = J['Bmp'].createBitmap(width, height, J['Bmp'].Config.ARGB_8888)
            canvas = J['Canvas'](result)
            paint = J['Paint'](J['Paint'].ANTI_ALIAS_FLAG)
            rect = J['RectF'](0.0, 0.0, float(width), float(height))
            set_paint_color(paint, 0xFFFFFFFF)
            canvas.drawRoundRect(rect, float(radius), float(radius), paint)
            from android.graphics import PorterDuff, PorterDuffXfermode
            paint.setXfermode(PorterDuffXfermode(PorterDuff.Mode.SRC_IN))
            canvas.drawBitmap(bitmap, 0.0, 0.0, paint)
            paint.setXfermode(None)
            return result
        except Exception as e:
            log(f"[QuoteCreate] Corner rounding failed: {e}")
            return bitmap

    def _flatten_alpha(self, bitmap):
        try:
            if not bitmap.hasAlpha():
                return bitmap
            width = int(bitmap.getWidth())
            height = int(bitmap.getHeight())
            result = J['Bmp'].createBitmap(width, height, J['Bmp'].Config.ARGB_8888)
            canvas = J['Canvas'](result)
            paint = J['Paint']()
            paint.setARGB(255, 255, 255, 255)
            canvas.drawRect(0.0, 0.0, float(width), float(height), paint)
            canvas.drawBitmap(bitmap, 0.0, 0.0, None)
            return result
        except Exception as e:
            log(f"[QuoteCreate] Alpha flatten failed: {e}")
            return bitmap
