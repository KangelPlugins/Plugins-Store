def set_private_field(target, name, value):
    cls = None
    try:
        cls = target.getClass()
    except Exception:
        cls = None
    while cls is not None:
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            field.set(target, value)
            return True
        except Exception:
            try:
                cls = cls.getSuperclass()
            except Exception:
                break
    try:
        setattr(target, name, value)
        return True
    except Exception:
        return False

def plural_ru(count, one, few, many):
    count = abs(int(count))
    if count % 100 in (11, 12, 13, 14):
        return many
    last = count % 10
    if last == 1:
        return one
    if last in (2, 3, 4):
        return few
    return many

def ceil_int(value):
    try:
        base = int(value)
    except Exception:
        return 0
    return base + 1 if value > base else base

def format_bytes(size):
    try:
        size = int(size)
    except Exception:
        return "—"
    if size < 1024:
        return f"{size} Б"
    if size < 1024 * 1024:
        return f"{size / 1024:.0f} КБ"
    return f"{size / (1024 * 1024):.1f} МБ"

def as_java_color(color: int) -> int:
    return int(color) if int(color) < 0x80000000 else int(int(color) - 0x100000000)

def call_int_color(target, method_name: str, color: int):
    color_int = Integer(as_java_color(color))
    try:
        method = target.getClass().getMethod(method_name, Integer.TYPE)
        return method.invoke(target, color_int)
    except Exception:
        return getattr(target, method_name)(as_java_color(color))

def call_two_ints(target, method_name: str, first: int, second: int):
    first_int = Integer(int(first))
    second_int = Integer(as_java_color(second))
    try:
        method = target.getClass().getMethod(method_name, Integer.TYPE, Integer.TYPE)
        return method.invoke(target, first_int, second_int)
    except Exception:
        return getattr(target, method_name)(int(first), as_java_color(second))

def call_color_and_int(target, method_name: str, color: int, value: int):
    color_int = Integer(as_java_color(color))
    value_int = Integer(int(value))
    try:
        method = target.getClass().getMethod(method_name, Integer.TYPE, Integer.TYPE)
        return method.invoke(target, color_int, value_int)
    except Exception:
        return getattr(target, method_name)(as_java_color(color), int(value))

def set_drawable_color(drawable, color: int, color_state_list=None):
    try:
        return call_int_color(drawable, "setColor", color)
    except Exception:
        if color_state_list is not None:
            return drawable.setColor(color_state_list.valueOf(Integer(as_java_color(color))))
        return drawable.setColor(as_java_color(color))

def set_paint_color(paint, color: int):
    color = int(color) & 0xFFFFFFFF
    paint.setARGB(
        int((color >> 24) & 0xFF),
        int((color >> 16) & 0xFF),
        int((color >> 8) & 0xFF),
        int(color & 0xFF)
    )

def show_custom_success(text, icon_name):
    try:
        from org.telegram.messenger import R
        icon_res = getattr(R.raw, icon_name, 0)
        if icon_res != 0:
            BulletinHelper.show_simple(text, icon_res)
            return
    except Exception:
        pass
    BulletinHelper.show_success(text)

