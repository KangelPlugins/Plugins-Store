TAG, J = "quote_btn", {}

def _reply_topic_id(reply_to):
    if reply_to is None:
        return 0
    for attr_name in ("reply_to_top_id", "reply_to_msg_id"):
        try:
            value = int(getattr(reply_to, attr_name, 0) or 0)
        except Exception:
            value = 0
        if value != 0:
            return value
    return 0

def _msg_topic_id(message_obj, peer_id):
    try:
        if peer_id > 0:
            return 0
        chat_id = abs(int(peer_id or 0))
        chat = get_messages_controller().getChat(chat_id)
        if not chat or not ChatObject.isForum(chat):
            return 0
        msg_owner = getattr(message_obj, "messageOwner", None)
        topic_id = _reply_topic_id(getattr(msg_owner, "reply_to", None))
        if topic_id:
            return topic_id
        try:
            account = get_user_config().selectedAccount
            topic_source = msg_owner or message_obj
            topic_id = MessageObject.getTopicId(account, topic_source, True)
            return topic_id if topic_id != 0 else 0
        except Exception as e:
            log(f"[QuoteCreate] Error getting topic ID: {e}")
            return 0
    except Exception as e:
        log(f"[QuoteCreate] Error in _msg_topic_id: {e}")
        return 0

def _make_top_reply(topic_id, peer_id):
    try:
        if topic_id <= 0:
            return None
        reply_message = TLRPC.TL_message()
        reply_message.message = ""
        reply_message.id = topic_id
        reply_message.peer_id = get_messages_controller().getPeer(peer_id)
        account = get_user_config().selectedAccount
        reply_to_top_msg = MessageObject(account, reply_message, False, False)
        return reply_to_top_msg
    except Exception as e:
        log(f"[QuoteCreate] Error creating replyToTopMsg: {e}")
        return None

def init_java():
    if J: return True
    try:
        cls = {'CA':"org.telegram.ui.ChatActivity", 'Cell':"org.telegram.ui.Cells.ChatMessageCell",
               'MO':"org.telegram.messenger.MessageObject",
               'MC':"org.telegram.messenger.MessagesController",
               'Bool':"java.lang.Boolean",
               'Float':"java.lang.Float", 'Double':"java.lang.Double"}
        for k,v in cls.items(): J[k] = find_class(v)
        from android.widget import ImageView
        from android.graphics import Bitmap, BitmapFactory, Canvas, Color, Paint, Rect, RectF, Path
        from android.view import View
        from android.content import Context, ClipData
        from java.io import File, ByteArrayOutputStream
        from androidx.core.content import FileProvider
        J.update({'IV':ImageView, 'Bmp':Bitmap, 'BmpF':BitmapFactory, 'Canvas':Canvas,
                  'Color':Color, 'Paint':Paint, 'Rect':Rect, 'RectF':RectF, 'View':View, 'Ctx':Context,
                  'Clip':ClipData, 'File':File, 'BAO':ByteArrayOutputStream, 'FP':FileProvider, 'Path': Path})
        action_cell_cls = find_class("org.telegram.ui.Cells.ChatActionCell")
        if action_cell_cls:
            J['ActionCell'] = action_cell_cls
        spoiler_cls = find_class("org.telegram.ui.Components.spoilers.SpoilerEffect")
        if spoiler_cls:
            J['Spoiler'] = spoiler_cls
        grouped_cls = find_class("org.telegram.messenger.MessageObject$GroupedMessages")
        if grouped_cls:
            J['Grouped'] = grouped_cls
        return all(J.values())
    except Exception: return False

class Delegate(dynamic_proxy(find_class("org.telegram.ui.Cells.ChatMessageCell$ChatMessageCellDelegate"))):
    def __init__(self, chat):
        super().__init__()
        self.chat, self.did = chat, chat.getDialogId()
        self.acc, self.sel = get_private_field(chat, "currentAccount"), get_private_field(chat, "selectedMessagesIds")
        self.mode = get_private_field(chat, "chatMode") or 0
        self.res, self.theme = get_private_field(chat, "sharedResources"), get_private_field(chat, "themeDelegate")
        self.mc = J['MC'].getInstance(self.acc)
        self.chat_obj = self.mc.getChat(-self.did) if self.did < 0 else None
        try: self.current_chat = get_private_field(chat, "currentChat")
        except: self.current_chat = None
        try: self.current_user = get_private_field(chat, "currentUser")
        except: self.current_user = None
        try: self.forum_topic = get_private_field(chat, "forumTopic")
        except: self.forum_topic = None
        self.is_ch = bool(self.chat_obj and getattr(self.chat_obj, 'broadcast', False))
        try: self.pin = chat.getPinnedMessageId()
        except: self.pin = 0

    def getDialogId(self): return self.did
    def getSelectedMessages(self): return self.sel
    def getChatMode(self): return self.mode
    def canDrawOutboundsContent(self): return True
    def getTopPinnedMessageId(self): return self.pin
    def getBottomPinnedMessageId(self): return self.pin
    def isLandscape(self): return AndroidUtilities.displaySize.x > AndroidUtilities.displaySize.y
    def isPinnedMessage(self, m): return self.pin > 0 and m and m.messageOwner and m.getId() == self.pin
    def getResourcesProvider(self): return self.theme
    def getSharedResources(self): return self.res
    def getChatActivity(self): return self.chat
    def isChannel(self): return self.is_ch
    def isGroup(self): return not self.is_ch and self.did < 0
    def isSupergroup(self): return getattr(self.chat_obj, 'megagroup', False)
    def isAdmin(self, uid):
        try:
            return bool(self.current_chat and not ChatObject.isChannelAndNotMegaGroup(self.current_chat) and self.mc.isAdmin(self.current_chat.id, uid))
        except Exception:
            return False
    def isOwner(self, uid):
        try:
            return bool(self.current_chat and not ChatObject.isChannelAndNotMegaGroup(self.current_chat) and self.mc.isOwner(self.current_chat.id, uid))
        except Exception:
            return False
    def getAdminRank(self, uid):
        try:
            if self.current_user and UserObject.isBotForum(self.current_user):
                return None
        except Exception:
            pass
        try:
            if self.current_chat and not ChatObject.isChannelAndNotMegaGroup(self.current_chat):
                rank = self.mc.getAdminRank(self.current_chat.id, uid)
                if rank is not None:
                    return rank
        except Exception:
            pass
        try:
            from_id = getattr(self.forum_topic, "from_id", None)
            if from_id and (getattr(from_id, "user_id", 0) == uid or getattr(from_id, "channel_id", 0) == uid or getattr(from_id, "chat_id", 0) == uid):
                return LocaleController.getString(R.string.TopicCreator)
        except Exception:
            pass
        return None
    def shouldRepeatSticker(self, m): return True
    def doNotShowLoadingReply(self, m): return m and m.getDialogId() == UserObject.REPLY_BOT
    def getTopicId(self): return 0

    for m in "getThreadMessage getTopPinnedMessage getBottomPinnedMessage getChatStyle getInstantVideoPlayer getPinchToZoomHelper getPhotoPreviewPinchToZoomHelper getFlickerLoadingView getChatListView getPatternProvider getTextSelectionHelper getProgressLoadingBotButtonUrl getProgressLoadingLink didPressExtendedMediaPreview didPressUserStatus didPressUserAvatar didPressHiddenForward didPressViaBotNotInline didPressViaBot didPressBoostCounter didPressChannelAvatar didPressCancelSendButton didLongPress didPressReplyMessage didPressUrl didPressCodeCopy didPressChannelRecommendation didPressMoreChannelRecommendations didPressChannelRecommendationsClose needOpenWebView didPressWebPage didPressImage didPressGroupImage didPressSideButton didQuickShareStart didQuickShareMove didQuickShareEnd didPressOther didPressSponsoredClose didPressSummarize didPressSponsoredInfo didPressTime didPressBotButton didLongPressBotButton didPressCustomBotButton didLongPressCustomBotButton didPressReaction didPressVoteButtons didPressInstantButton didPressGiveawayChatButton didPressCommentButton didPressHint needShowPremiumFeatures needShowPremiumBulletin videoTimerReached didStartVideoStream setShouldNotRepeatSticker needReloadPolls onDiceFinished invalidateBlur didPressTopicButton didPressDialogButton didPressEmojiStatus didPressAboutRevenueSharingAds didPressRevealSensitiveContent didPressEffect didPressFactCheckWhat didPressFactCheck forceUpdate forceUpdateNoAnimation didPressAdmin".split():
        locals()[m] = lambda self,*a: None

    for m in "canPerformActions isTopPinnedMessageVisible isBottomPinnedMessageVisible isFirstMessage isLastMessage didLongPressUserAvatar didLongPressChannelAvatar isProgressLoading didPressToDoButton didLongPressToDoButton needPlayMessage drawingVideoPlayerContainer canPerformReply onAccessibilityAction hasSelectedMessages keyboardIsOpened didPressAnimatedEmoji shouldShowTopicButton shouldShowDialogButton shouldDrawThreadProgress isReplyOrSelf".split():
        locals()[m] = lambda self,*a: False

    for m in "getProgressToNext getProgressToPrev".split():
        locals()[m] = lambda self,*a: 1.0

class QuotePreviewSheet:
    def __init__(self, plugin, activity, chat, data, msgs, reply_to_top_msg):
        self.plugin = plugin
        self.activity = activity
        self.chat = chat
        self.data = data
        self.msgs = list(msgs or [])
        self.reply_to_top_msg = reply_to_top_msg
        self.dialog_id = chat.getDialogId() if chat else 0
        self.resources_provider = self._get_provider()
        self.sheet = None
        self.preview_bitmap = None
        self.preview_view = None
        self._dismiss_listener = None
        self._rendering = False
        self._render_gen = 0
        self.anonymize_enabled = False
        self._display_toggle_buttons = {}
        self._progress_view = None
        self._meta_view = None

        from org.telegram.ui.ActionBar import BottomSheet
        from org.telegram.ui.Components import LayoutHelper
        from android.widget import LinearLayout, TextView, ImageView, FrameLayout, ScrollView
        from android.view import Gravity, View
        from android.util import TypedValue
        from android.graphics import Color, Typeface
        from android.graphics.drawable import GradientDrawable, RippleDrawable
        from android.content.res import ColorStateList

        self.BottomSheet = BottomSheet
        self.LayoutHelper = LayoutHelper
        self.LinearLayout = LinearLayout
        self.TextView = TextView
        self.ImageView = ImageView
        self.FrameLayout = FrameLayout
        self.ScrollView = ScrollView
        self.Gravity = Gravity
        self.View = View
        self.TypedValue = TypedValue
        self.Color = Color
        self.Typeface = Typeface
        self.GradientDrawable = GradientDrawable
        self.RippleDrawable = RippleDrawable
        self.ColorStateList = ColorStateList

        try:
            ViewOnTouchListener = find_class("android.view.View$OnTouchListener")
            if ViewOnTouchListener:
                class TouchBounceListener(dynamic_proxy(ViewOnTouchListener)):
                    def onTouch(self, v, event):
                        from android.view import MotionEvent
                        action = event.getAction()
                        if action == MotionEvent.ACTION_DOWN:
                            try: v.animate().scaleX(0.92).scaleY(0.92).setDuration(150).start()
                            except: pass
                        elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                            try: v.animate().scaleX(1.0).scaleY(1.0).setDuration(150).start()
                            except: pass
                        return False
                self.bounce_listener = TouchBounceListener()
            else:
                self.bounce_listener = None
        except Exception:
            self.bounce_listener = None

    def _get_provider(self):
        provider = None
        if self.chat is not None:
            try:
                provider = get_private_field(self.chat, "themeDelegate")
            except Exception:
                provider = None
            if provider is None:
                try:
                    provider = self.chat.getResourceProvider()
                except Exception:
                    provider = None
        return provider

    def _signed_color(self, value):
        color = int(value) & 0xFFFFFFFF
        if color >= 0x80000000:
            color -= 0x100000000
        return color

    def _color(self, key, fallback=None):
        try:
            if self.resources_provider is not None:
                return self._signed_color(Theme.getColor(key, self.resources_provider))
        except Exception:
            pass
        try:
            return self._signed_color(Theme.getColor(key))
        except Exception:
            return self._signed_color(fallback if fallback is not None else 0xFF1F2329)

    def _alpha(self, color, alpha):
        alpha_value = max(0, min(255, int(float(alpha) * 255)))
        return self._signed_color((alpha_value << 24) | (int(color) & 0x00FFFFFF))

    def _dp(self, value):
        return AndroidUtilities.dp(int(value))

    def _accent_color(self):
        return self._color(Theme.key_featuredStickers_addButton, 0xFF3390EC)

    def _accent_text(self):
        return self._color(
            Theme.key_featuredStickers_buttonText,
            self._fill_text(self._accent_color()),
        )

    def _subtle_fill(self):
        return self._color(Theme.key_buttonNeutral, 0xFFE4E4E4)

    def _subtle_text(self):
        return self._color(
            Theme.key_buttonNeutralText,
            self._fill_text(self._subtle_fill()),
        )

    def _subtle_stroke(self):
        return self._color(Theme.key_listSelector, 0x33000000)

    def _soft_surface_color(self):
        text_color = self._color(Theme.key_dialogTextBlack, 0xFFFFFFFF)
        return self._alpha(text_color, 0.05)

    def _is_light(self, color):
        value = int(color) & 0xFFFFFFFF
        r = (value >> 16) & 0xFF
        g = (value >> 8) & 0xFF
        b = value & 0xFF
        return ((r * 299) + (g * 587) + (b * 114)) >= 186000

    def _fill_text(self, fill_color):
        return self._signed_color(0xFF101318 if self._is_light(fill_color) else 0xFFFFFFFF)

    def _has_anonymize_targets(self):
        return bool(
            self.plugin.get_setting("anonymize_nickname", False)
            or self.plugin.get_setting("anonymize_avatar", False)
        )

    def _swap_preview(self, data):
        new_bitmap = J['BmpF'].decodeByteArray(data, 0, len(data))
        if new_bitmap is None:
            raise Exception("не удалось декодировать превью")

        if self.sheet is None:
            try:
                new_bitmap.recycle()
            except Exception:
                pass
            return False

        old_bitmap = self.preview_bitmap
        self.preview_bitmap = new_bitmap
        self.data = data

        if self.preview_view is not None:
            try:
                self.preview_view.setImageBitmap(new_bitmap)
            except Exception:
                pass

        if old_bitmap is not None and old_bitmap is not new_bitmap:
            try:
                old_bitmap.recycle()
            except Exception:
                pass
        self._sync_meta()
        return True

    def _decode_preview(self):
        if self.preview_bitmap is None:
            self.preview_bitmap = J['BmpF'].decodeByteArray(self.data, 0, len(self.data))
        if self.preview_bitmap is None:
            raise Exception("не удалось декодировать превью")
        self.anonymize_enabled = self._has_anonymize_targets()
        return self.preview_bitmap

    def _meta_text(self):
        width = height = 0
        try:
            if self.preview_bitmap is not None:
                width = int(self.preview_bitmap.getWidth())
                height = int(self.preview_bitmap.getHeight())
        except Exception:
            width = height = 0
        size = 0
        try:
            size = len(self.data)
        except Exception:
            size = 0
        fmt = self.plugin._output_format_name()
        parts = []
        if width > 0 and height > 0:
            parts.append(f"{width}×{height}")
        parts.append(fmt)
        parts.append(format_bytes(size))
        text = " · ".join(parts)
        if size > STICKER_MAX_BYTES:
            text += " · для стикера будет сжато"
        return text

    def _sync_meta(self):
        if self._meta_view is None:
            return
        try:
            self._meta_view.setText(self._meta_text())
        except Exception:
            pass

    def _card_bg(self, radius_dp=24):
        drawable = self.GradientDrawable()
        drawable.setCornerRadius(float(self._dp(radius_dp)))
        set_drawable_color(drawable, self._soft_surface_color(), self.ColorStateList)
        return drawable

    def _tap_bg(self, fill_color=None, radius_dp=18, ripple_alpha=0.18, stroke_color=None, stroke_width_dp=1):
        base = self.GradientDrawable()
        base.setCornerRadius(float(self._dp(radius_dp)))
        color_to_set = fill_color if fill_color is not None else self.Color.TRANSPARENT
        set_drawable_color(base, color_to_set, self.ColorStateList)
        if stroke_color is not None:
            try:
                call_two_ints(base, "setStroke", self._dp(stroke_width_dp), stroke_color)
            except Exception:
                pass
        try:
            return self.RippleDrawable(
                self.ColorStateList.valueOf(Integer(as_java_color(self._alpha(self._color(Theme.key_listSelector, 0x33000000), ripple_alpha)))),
                base,
                None,
            )
        except Exception:
            return base

    def _set_tap_bg(self, view, fill_color=None, radius_dp=18, ripple_alpha=0.18, stroke_color=None, stroke_width_dp=1):
        try:
            view.setBackground(self._tap_bg(fill_color, radius_dp, ripple_alpha, stroke_color, stroke_width_dp))
        except Exception:
            pass

    def _icon(self, *names):
        resources = None
        package_name = None
        try:
            resources = self.activity.getResources()
            package_name = self.activity.getPackageName()
        except Exception:
            pass
        for name in names:
            if not name:
                continue
            try:
                res_id = int(getattr(R.drawable, name))
                if res_id:
                    return res_id
            except Exception:
                pass
            if resources is not None and package_name:
                try:
                    res_id = int(resources.getIdentifier(name, "drawable", package_name) or 0)
                    if res_id:
                        return res_id
                except Exception:
                    pass
        return 0

    def _make_sheet(self):
        try:
            sheet = self.BottomSheet(self.activity, False, self.resources_provider)
        except Exception:
            sheet = self.BottomSheet(self.activity, False)
        bg_color = as_java_color(self._color(Theme.key_dialogBackground, 0xFF101318))
        try:
            call_int_color(sheet, "setBackgroundColor", bg_color)
        except Exception:
            pass
        try:
            call_int_color(sheet, "fixNavigationBar", bg_color)
        except Exception:
            pass
        return sheet

    def _bind_dismiss(self):
        dismiss_listener_cls = find_class("android.content.DialogInterface$OnDismissListener")
        if dismiss_listener_cls is None or self.sheet is None:
            return
        owner = self

        class _DismissListener(dynamic_proxy(dismiss_listener_cls)):
            def __init__(self):
                super().__init__()

            def onDismiss(self, _dialog):
                owner._free_preview()
                owner.sheet = None

        self._dismiss_listener = _DismissListener()
        try:
            self.sheet.setOnHideListener(self._dismiss_listener)
        except Exception:
            try:
                self.sheet.setOnDismissListener(self._dismiss_listener)
            except Exception:
                pass

    def _free_preview(self):
        try:
            if self.preview_view is not None:
                try:
                    self.preview_view.setImageBitmap(None)
                except Exception:
                    try:
                        self.preview_view.setImageDrawable(None)
                    except Exception:
                        pass
        finally:
            self.preview_view = None
        if self.preview_bitmap is not None:
            try:
                self.preview_bitmap.recycle()
            except Exception:
                pass
            self.preview_bitmap = None

    def dismiss(self):
        if self.sheet is not None:
            try:
                self.sheet.dismiss()
            except Exception:
                pass

    def show(self):
        try:
            self._decode_preview()
            self.sheet = self._make_sheet()
            self._bind_dismiss()
            self.sheet.setCustomView(self._build())
            self.sheet.show()
        except Exception:
            self._free_preview()
            raise

    def _build(self):
        root = self.LinearLayout(self.activity)
        root.setOrientation(self.LinearLayout.VERTICAL)
        try:
            call_int_color(root, "setBackgroundColor", self.Color.TRANSPARENT)
        except Exception:
            pass

        scroll = self.ScrollView(self.activity)
        scroll.setFillViewport(True)
        scroll.setVerticalScrollBarEnabled(False)
        try:
            scroll.setClipToPadding(False)
        except Exception:
            pass

        content = self.LinearLayout(self.activity)
        content.setOrientation(self.LinearLayout.VERTICAL)
        content.setPadding(self._dp(12), self._dp(12), self._dp(12), self._dp(12))
        try:
            call_int_color(content, "setBackgroundColor", self.Color.TRANSPARENT)
        except Exception:
            pass

        content.addView(self._header(), self.LayoutHelper.createLinear(-1, -2))
        content.addView(self._toggle_row(), self.LayoutHelper.createLinear(-1, -2, 0, 10, 0, 0))
        content.addView(self._preview_card(), self.LayoutHelper.createLinear(-1, -2, 0, 0, 8, 0, 0))
        content.addView(self._anon_toggle(), self.LayoutHelper.createLinear(-1, -2, 0, 0, 8, 0, 0))
        content.addView(self._primary_btn(), self.LayoutHelper.createLinear(-1, -2, 0, 0, 8, 0, 6))
        content.addView(self._secondary_row(), self.LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 6))
        content.addView(self._format_row(), self.LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 6))
        content.addView(self._utility_row(), self.LayoutHelper.createLinear(-1, -2))

        scroll.addView(content, self.LayoutHelper.createFrame(-1, -2))
        root.addView(scroll, self.LayoutHelper.createLinear(-1, -1))
        return root

    def _header_toggle_button(self, setting_key, icon_res, title):
        button = self.LinearLayout(self.activity)
        button.setOrientation(self.LinearLayout.HORIZONTAL)
        button.setGravity(self.Gravity.CENTER)
        button.setClickable(True)
        button.setFocusable(True)
        button.setPadding(self._dp(10), self._dp(7), self._dp(12), self._dp(7))
        try:
            button.setContentDescription(title)
        except Exception:
            pass

        icon = self.ImageView(self.activity)
        icon.setScaleType(self.ImageView.ScaleType.CENTER_INSIDE)
        icon.setImageResource(icon_res)
        icon_lp = self.LinearLayout.LayoutParams(self._dp(17), self._dp(17))
        icon_lp.rightMargin = self._dp(6)
        button.addView(icon, icon_lp)

        label = self.TextView(self.activity)
        label.setText(title)
        label.setTextSize(self.TypedValue.COMPLEX_UNIT_DIP, 13)
        label.setSingleLine(True)
        try:
            label.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            label.setTypeface(self.Typeface.DEFAULT_BOLD)
        button.addView(label, self.LinearLayout.LayoutParams(-2, -2))

        self._display_toggle_buttons[setting_key] = (button, icon, label)

        def on_click(_view=None):
            if self._rendering:
                return
            self.plugin.set_setting(setting_key, not bool(self.plugin.get_setting(setting_key, False)))
            self._sync_controls()
            self._rerender_preview()

        button.setOnClickListener(OnClickListener(lambda *_: on_click(button)))
        if self.bounce_listener:
            try: button.setOnTouchListener(self.bounce_listener)
            except: pass
        return button

    def _header(self):
        row = self.LinearLayout(self.activity)
        row.setOrientation(self.LinearLayout.HORIZONTAL)
        row.setGravity(self.Gravity.CENTER_VERTICAL)

        count = len(self.msgs)
        word = plural_ru(count, "сообщение", "сообщения", "сообщений")

        title_view = self.TextView(self.activity)
        title_view.setText(f"Цитата · {count} {word}")
        call_int_color(title_view, "setTextColor", self._color(Theme.key_dialogTextBlack, 0xFFFFFFFF))
        title_view.setTextSize(self.TypedValue.COMPLEX_UNIT_DIP, 20)
        try:
            title_view.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            title_view.setTypeface(self.Typeface.DEFAULT_BOLD)
        title_view.setSingleLine(True)
        row.addView(title_view, self.LinearLayout.LayoutParams(0, self.LinearLayout.LayoutParams.WRAP_CONTENT, 1.0))
        return row

    def _toggle_row(self):
        scroll = find_class("android.widget.HorizontalScrollView")
        container = None
        if scroll is not None:
            try:
                container = scroll(self.activity)
                container.setHorizontalScrollBarEnabled(False)
                container.setClipToPadding(False)
            except Exception:
                container = None

        row = self.LinearLayout(self.activity)
        row.setOrientation(self.LinearLayout.HORIZONTAL)
        row.setGravity(self.Gravity.CENTER_VERTICAL)

        toggles = (
            ("hide_media", self._icon("media_live_off", "msg_photo_blur", "msg_photo"), "Без медиа"),
            ("hide_reactions", self._icon("msg_reactions", "reactionchats", "msg_like"), "Без реакций"),
            ("hide_time", self._icon("msg_contacts_time", "msg_recent", "msg_schedule"), "Без времени"),
            ("hide_status", self._icon("msg_views", "msg_calls_read", "msg_check"), "Без галочек"),
        )
        first = True
        for setting_key, icon_res, title in toggles:
            if not icon_res:
                continue
            toggle = self._header_toggle_button(setting_key, icon_res, title)
            toggle_lp = self.LinearLayout.LayoutParams(-2, self._dp(34))
            if not first:
                toggle_lp.leftMargin = self._dp(6)
            first = False
            row.addView(toggle, toggle_lp)
        self._sync_controls()

        if container is not None:
            container.addView(row, self.LayoutHelper.createFrame(-2, -2))
            return container
        return row

    def _preview_card(self):
        card = self.LinearLayout(self.activity)
        card.setOrientation(self.LinearLayout.VERTICAL)
        card.setPadding(self._dp(10), self._dp(10), self._dp(10), self._dp(10))
        card.setBackground(self._card_bg(radius_dp=20))

        preview_shell = self.FrameLayout(self.activity)
        preview_shell.setPadding(self._dp(8), self._dp(8), self._dp(8), self._dp(8))
        preview_bg = self.GradientDrawable()
        preview_bg.setCornerRadius(float(self._dp(16)))
        set_drawable_color(preview_bg, self._soft_surface_color(), self.ColorStateList)
        preview_shell.setBackground(preview_bg)

        preview_view = self.ImageView(self.activity)
        preview_view.setAdjustViewBounds(True)
        preview_view.setScaleType(self.ImageView.ScaleType.FIT_CENTER)
        preview_view.setImageBitmap(self.preview_bitmap)
        preview_view.setClickable(True)
        preview_view.setFocusable(True)
        try:
            preview_view.setContentDescription("Открыть превью на весь экран")
        except Exception:
            pass
        preview_view.setOnClickListener(OnClickListener(lambda *_: self._open_zoom()))
        self.preview_view = preview_view
        preview_shell.addView(preview_view, self.LayoutHelper.createFrame(-1, -2, self.Gravity.CENTER))

        progress = self._build_progress()
        if progress is not None:
            self._progress_view = progress
            progress.setVisibility(self.View.GONE)
            preview_shell.addView(progress, self.LayoutHelper.createFrame(-1, -1, self.Gravity.CENTER))

        card.addView(preview_shell, self.LayoutHelper.createLinear(-1, -2))

        meta_row = self.LinearLayout(self.activity)
        meta_row.setOrientation(self.LinearLayout.HORIZONTAL)
        meta_row.setGravity(self.Gravity.CENTER_VERTICAL)

        meta = self.TextView(self.activity)
        meta.setText(self._meta_text())
        meta.setTextSize(self.TypedValue.COMPLEX_UNIT_DIP, 12)
        call_int_color(meta, "setTextColor", self._alpha(self._color(Theme.key_dialogTextBlack, 0xFFFFFFFF), 0.55))
        meta.setSingleLine(True)
        self._meta_view = meta
        meta_row.addView(meta, self.LinearLayout.LayoutParams(0, -2, 1.0))

        hint = self.TextView(self.activity)
        hint.setText("нажмите, чтобы увеличить")
        hint.setTextSize(self.TypedValue.COMPLEX_UNIT_DIP, 12)
        call_int_color(hint, "setTextColor", self._alpha(self._color(Theme.key_dialogTextBlack, 0xFFFFFFFF), 0.4))
        hint.setSingleLine(True)
        meta_row.addView(hint, self.LinearLayout.LayoutParams(-2, -2))

        card.addView(meta_row, self.LayoutHelper.createLinear(-1, -2, 4, 8, 4, 0))
        return card

    def _build_progress(self):
        try:
            overlay = self.FrameLayout(self.activity)
            shade = self.GradientDrawable()
            shade.setCornerRadius(float(self._dp(16)))
            set_drawable_color(shade, self._alpha(self._color(Theme.key_dialogBackground, 0xFF101318), 0.6), self.ColorStateList)
            overlay.setBackground(shade)
            overlay.setClickable(True)

            RadialProgressView = find_class("org.telegram.ui.Components.RadialProgressView")
            spinner = None
            if RadialProgressView is not None:
                try:
                    spinner = RadialProgressView(self.activity, self.resources_provider)
                except Exception:
                    try:
                        spinner = RadialProgressView(self.activity)
                    except Exception:
                        spinner = None
            if spinner is not None:
                try:
                    spinner.setSize(self._dp(28))
                except Exception:
                    pass
                try:
                    call_int_color(spinner, "setProgressColor", self._accent_color())
                except Exception:
                    pass
                overlay.addView(spinner, self.LayoutHelper.createFrame(40, 40, self.Gravity.CENTER))
            else:
                label = self.TextView(self.activity)
                label.setText("Обновляю…")
                label.setTextSize(self.TypedValue.COMPLEX_UNIT_DIP, 14)
                call_int_color(label, "setTextColor", self._color(Theme.key_dialogTextBlack, 0xFFFFFFFF))
                overlay.addView(label, self.LayoutHelper.createFrame(-2, -2, self.Gravity.CENTER))
            return overlay
        except Exception:
            return None

    def _open_zoom(self):
        if self._rendering or self.preview_bitmap is None:
            return
        try:
            ZoomPreviewDialog(self).show()
        except Exception as e:
            log(f"[QuoteCreate] Zoom preview failed: {e}")

    def _sync_controls(self):
        disabled = self._rendering
        alpha = 0.5 if disabled else 1.0
        for row in (getattr(self, "_nick_row", None), getattr(self, "_ava_row", None)):
            if row is None:
                continue
            try:
                row.setAlpha(alpha)
                row.setClickable(not disabled)
            except Exception:
                pass
        for key, parts in list(self._display_toggle_buttons.items()):
            try:
                button, icon, label = parts
                enabled = bool(self.plugin.get_setting(key, False))
                fill = self._accent_color() if enabled else self._subtle_fill()
                text = self._accent_text() if enabled else self._subtle_text()
                self._set_tap_bg(button, fill, radius_dp=17)
                try:
                    call_int_color(icon, "setColorFilter", text)
                except Exception:
                    pass
                try:
                    call_int_color(label, "setTextColor", text)
                except Exception:
                    pass
                button.setAlpha(alpha)
                button.setClickable(not disabled)
            except Exception:
                pass
        if self._progress_view is not None:
            try:
                self._progress_view.setVisibility(self.View.VISIBLE if disabled else self.View.GONE)
            except Exception:
                pass
        if self.preview_view is not None:
            try:
                self.preview_view.setClickable(not disabled)
            except Exception:
                pass

    def _rerender_preview(self):
        self._render_gen += 1
        generation = self._render_gen
        self._rendering = True
        self._sync_controls()
        run_on_queue(lambda: self._render_preview_task(generation), PLUGINS_QUEUE, PREVIEW_DEBOUNCE_MS)

    def _render_preview_task(self, generation):
        if generation != self._render_gen or self.sheet is None:
            return
        bg_bmp = None
        try:
            bg_bmp = self.plugin._render_bg(self.chat)
            target_state = self._has_anonymize_targets()
            data = self.plugin._render_bytes(
                self.msgs,
                self.chat,
                bg_bmp=bg_bmp,
                anonymize_enabled=target_state,
            )
            if not data:
                raise Exception("пустой результат рендера")

            def apply_preview():
                if generation != self._render_gen:
                    return
                try:
                    self._swap_preview(data)
                    self.anonymize_enabled = target_state
                except Exception as e:
                    BulletinHelper.show_error(f"Не удалось обновить превью: {str(e)[:80]}")
                finally:
                    self._finish_render(generation)

            run_on_ui_thread(apply_preview)
        except Exception as e:
            err = str(e)

            def show_error():
                if generation != self._render_gen:
                    return
                self._finish_render(generation)
                BulletinHelper.show_error(f"Не удалось обновить превью: {err[:80]}")

            run_on_ui_thread(show_error)
        finally:
            if bg_bmp is not None:
                try:
                    bg_bmp.recycle()
                except Exception:
                    pass

    def _finish_render(self, generation):
        if generation != self._render_gen:
            return
        self._rendering = False
        self._sync_controls()

    def _build_anon_row(self, title, setting_key, is_last=False):
        TextCheckCell = find_class("org.telegram.ui.Cells.TextCheckCell")
        row = None
        if TextCheckCell:
            try:
                row = TextCheckCell(self.activity, self.resources_provider)
            except:
                try:
                    row = TextCheckCell(self.activity)
                except:
                    pass

        if row is not None:
            val = bool(self.plugin.get_setting(setting_key, False))
            try:
                row.setTextAndCheck(title, val, not is_last)
            except: pass
            
            self._set_tap_bg(row, self.Color.TRANSPARENT, radius_dp=0, ripple_alpha=0.15)
            
            def on_click(v):
                if self._rendering:
                    return
                current_val = bool(self.plugin.get_setting(setting_key, False))
                new_val = not current_val
                self.plugin.set_setting(setting_key, new_val)
                try:
                    row.setChecked(new_val)
                except: pass
                self._rerender_preview()

            row.setOnClickListener(OnClickListener(lambda *_: on_click(None)))
            return row
        else:
            return self._build_custom_row(title, setting_key, is_last)

    def _build_custom_row(self, title, setting_key, is_last=False):
        row = self.FrameLayout(self.activity)
        row.setMinimumHeight(self._dp(50))
        self._set_tap_bg(row, self.Color.TRANSPARENT, radius_dp=0, ripple_alpha=0.15)
        
        tv = self.TextView(self.activity)
        tv.setText(title)
        call_int_color(tv, "setTextColor", self._color(Theme.key_windowBackgroundWhiteBlackText, 0xFFFFFFFF))
        tv.setTextSize(self.TypedValue.COMPLEX_UNIT_DIP, 16)
        tv.setGravity(self.Gravity.CENTER_VERTICAL | self.Gravity.LEFT)
        row.addView(tv, self.LayoutHelper.createFrame(-1, -1, self.Gravity.CENTER_VERTICAL | self.Gravity.LEFT, 21, 0, 60, 0))
        
        Switch = find_class("org.telegram.ui.Components.Switch")
        val = bool(self.plugin.get_setting(setting_key, False))
        
        sw = None
        if Switch:
            try: sw = Switch(self.activity, self.resources_provider)
            except:
                try: sw = Switch(self.activity)
                except: pass

        if sw is not None:
            try: sw.setChecked(val, False)
            except: pass
            row.addView(sw, self.LayoutHelper.createFrame(40, 40, self.Gravity.CENTER_VERTICAL | self.Gravity.RIGHT, 0, 0, 21, 0))
        else:
            sw = self.ImageView(self.activity)
            self._sync_checkbox_custom(sw, val)
            sw.setScaleType(self.ImageView.ScaleType.FIT_CENTER)
            row.addView(sw, self.LayoutHelper.createFrame(22, 22, self.Gravity.CENTER_VERTICAL | self.Gravity.RIGHT, 0, 0, 21, 0))
            
        if not is_last:
            divider = self.View(self.activity)
            try: call_int_color(divider, "setBackgroundColor", self._color(Theme.key_divider, 0x1F000000))
            except: call_int_color(divider, "setBackgroundColor", self._subtle_stroke())
            row.addView(divider, self.LayoutHelper.createFrame(-1, 1, self.Gravity.BOTTOM, 21, 0, 0, 0))
            
        def on_click(v):
            if self._rendering:
                return
            current_val = bool(self.plugin.get_setting(setting_key, False))
            new_val = not current_val
            self.plugin.set_setting(setting_key, new_val)

            if hasattr(sw, 'setChecked'):
                try: sw.setChecked(new_val, True)
                except: pass
            else:
                self._sync_checkbox_custom(sw, new_val)

            self._rerender_preview()

        row.setOnClickListener(OnClickListener(lambda *_: on_click(None)))
        return row
        
    def _sync_checkbox_custom(self, view, checked):
        bg = self.GradientDrawable()
        bg.setShape(self.GradientDrawable.OVAL)
        if checked:
            set_drawable_color(bg, self._accent_color(), self.ColorStateList)
        else:
            set_drawable_color(bg, self.Color.TRANSPARENT, self.ColorStateList)
            call_two_ints(bg, "setStroke", self._dp(2), self._alpha(self._subtle_text(), 0.5))
            
        view.setBackground(bg)
        if checked:
            view.setImageResource(self._icon("ic_ab_done", "msg_check", "msg_selected"))
            try: call_int_color(view, "setColorFilter", self._fill_text(self._accent_color()))
            except: pass
            view.setPadding(self._dp(4), self._dp(4), self._dp(4), self._dp(4))
        else:
            view.setImageDrawable(None)

    def _anon_toggle(self):
        card = self.LinearLayout(self.activity)
        card.setOrientation(self.LinearLayout.VERTICAL)
        card.setBackground(self._card_bg(radius_dp=14))
        try:
            card.setClipToOutline(True)
        except: pass

        self._nick_row = self._build_anon_row("Скрыть имя", "anonymize_nickname", is_last=False)
        self._ava_row = self._build_anon_row("Скрыть аватар", "anonymize_avatar", is_last=True)

        card.addView(self._nick_row, self.LayoutHelper.createLinear(-1, -2))
        card.addView(self._ava_row, self.LayoutHelper.createLinear(-1, -2))

        self._sync_controls()
        return card

    def _action_btn(self, title, on_click, *, fill_color, text_color, subtitle=None, radius_dp=16, min_height_dp=46, icon_res=None, icon_size_dp=20, stroke_color=None, stroke_width_dp=1):
        button = self.FrameLayout(self.activity)
        button.setClickable(True)
        button.setFocusable(True)
        button.setMinimumHeight(self._dp(min_height_dp))
        if title:
            try:
                button.setContentDescription(title)
            except Exception:
                pass
        self._set_tap_bg(
            button,
            fill_color,
            radius_dp=radius_dp,
            ripple_alpha=0.22,
            stroke_color=stroke_color,
            stroke_width_dp=stroke_width_dp,
        )

        content = self.LinearLayout(self.activity)
        content.setOrientation(self.LinearLayout.VERTICAL)
        content.setGravity(self.Gravity.CENTER)
        has_icon = bool(icon_res)
        show_title = bool(title) and not has_icon
        vertical_padding = 7 if has_icon and not show_title and not subtitle else 9
        content.setPadding(self._dp(12), self._dp(vertical_padding), self._dp(12), self._dp(vertical_padding))

        if has_icon:
            icon_view = self.ImageView(self.activity)
            icon_view.setScaleType(self.ImageView.ScaleType.CENTER_INSIDE)
            icon_view.setImageResource(icon_res)
            try:
                call_int_color(icon_view, "setColorFilter", text_color)
            except Exception:
                pass
            icon_params = self.LinearLayout.LayoutParams(self._dp(icon_size_dp), self._dp(icon_size_dp))
            content.addView(icon_view, icon_params)

        if show_title:
            title_view = self.TextView(self.activity)
            title_view.setText(title)
            title_view.setGravity(self.Gravity.CENTER)
            call_int_color(title_view, "setTextColor", text_color)
            title_view.setTextSize(self.TypedValue.COMPLEX_UNIT_DIP, 14)
            title_view.setTypeface(self.Typeface.DEFAULT_BOLD)
            title_view.setSingleLine(True)
            content.addView(title_view)

        if subtitle:
            subtitle_view = self.TextView(self.activity)
            subtitle_view.setText(subtitle)
            subtitle_view.setGravity(self.Gravity.CENTER)
            call_int_color(subtitle_view, "setTextColor", self._alpha(text_color, 0.72))
            subtitle_view.setTextSize(self.TypedValue.COMPLEX_UNIT_DIP, 11.5)
            content.addView(subtitle_view, self.LayoutHelper.createLinear(-1, -2, 0, 0, 3, 0, 0))

        button.addView(content, self.LayoutHelper.createFrame(-1, -2, self.Gravity.CENTER))
        button.setOnClickListener(OnClickListener(lambda *args: on_click(args[0] if args else button)))
        if self.bounce_listener:
            try: button.setOnTouchListener(self.bounce_listener)
            except: pass
        return button

    def _primary_btn(self):
        ButtonWithCounterView = find_class("org.telegram.ui.Stories.recorder.ButtonWithCounterView")
        if ButtonWithCounterView:
            try:
                btn = ButtonWithCounterView(self.activity, True, self.resources_provider)
                btn.setText("Отправить сюда", False)
                btn.setOnClickListener(OnClickListener(lambda *_: self._send_photo(btn)))
                if self.bounce_listener:
                    try: btn.setOnTouchListener(self.bounce_listener)
                    except: pass

                wrapper = self.FrameLayout(self.activity)
                wrapper.addView(btn, self.LayoutHelper.createFrame(-1, 52))
                return wrapper
            except Exception as e:
                log(f"[QuoteCreate] Failed to use ButtonWithCounterView: {e}")

        fill_color = self._accent_color()
        return self._action_btn(
            "Отправить сюда",
            self._send_photo,
            fill_color=fill_color,
            text_color=self._accent_text(),
            radius_dp=18,
            min_height_dp=52,
        )

    def _secondary_row(self):
        row = self.LinearLayout(self.activity)
        row.setOrientation(self.LinearLayout.HORIZONTAL)
        row.setGravity(self.Gravity.CENTER_VERTICAL)

        subtle_fill = self._subtle_fill()
        button_text = self._subtle_text()

        chat_button = self._action_btn(
            "В другой чат",
            self._send_to_chat,
            fill_color=subtle_fill,
            text_color=button_text,
            subtitle="выбрать получателя",
        )
        row.addView(chat_button, self.LayoutHelper.createLinear(-1, -2))
        return row

    def _format_row(self):
        row = self.LinearLayout(self.activity)
        row.setOrientation(self.LinearLayout.HORIZONTAL)
        row.setGravity(self.Gravity.CENTER_VERTICAL)

        subtle_fill = self._subtle_fill()
        button_text = self._subtle_text()

        file_button = self._action_btn(
            "Файл",
            self._send_file,
            fill_color=subtle_fill,
            text_color=button_text,
            subtitle=self.plugin._output_format_hint(),
        )
        sticker_button = self._action_btn(
            "Стикер",
            self._send_sticker,
            fill_color=subtle_fill,
            text_color=button_text,
            subtitle="webp до 512 КБ",
        )

        row.addView(file_button, self.LayoutHelper.createLinear(0, -2, 1.0, 0, 0, 4, 0))
        row.addView(sticker_button, self.LayoutHelper.createLinear(0, -2, 1.0, 4, 0, 0, 0))
        return row

    def _utility_row(self):
        row = self.LinearLayout(self.activity)
        row.setOrientation(self.LinearLayout.HORIZONTAL)
        row.setGravity(self.Gravity.CENTER_VERTICAL)

        subtle_fill = self._subtle_fill()
        subtle_text = self._subtle_text()

        copy_button = self._action_btn(
            "Копировать",
            self._copy_out,
            fill_color=subtle_fill,
            text_color=subtle_text,
            radius_dp=14,
            min_height_dp=40,
            icon_res=self._icon("msg_copy_solar", "msg_copy", "menu_copy_s"),
            icon_size_dp=18,
        )
        save_button = self._action_btn(
            "В галерею",
            self._save_out,
            fill_color=subtle_fill,
            text_color=subtle_text,
            radius_dp=14,
            min_height_dp=40,
            icon_res=R.drawable.msg_gallery_solar,
            icon_size_dp=18,
        )
        share_button = self._action_btn(
            "Поделиться",
            self._share_out,
            fill_color=subtle_fill,
            text_color=subtle_text,
            radius_dp=14,
            min_height_dp=40,
            icon_res=self._icon("msg_share_solar", "msg_share", "share"),
            icon_size_dp=18,
        )

        row.addView(copy_button, self.LayoutHelper.createLinear(0, -2, 1.0, 0, 0, 4, 0))
        row.addView(save_button, self.LayoutHelper.createLinear(0, -2, 1.0, 4, 0, 4, 0))
        row.addView(share_button, self.LayoutHelper.createLinear(0, -2, 1.0, 4, 0, 0, 0))
        return row

    def _send_photo(self, view=None):
        if self._rendering:
            return
        self.dismiss()
        self.plugin._send(self.data, self.dialog_id, self.reply_to_top_msg, send_mode="photo")

    def _send_file(self, view=None):
        if self._rendering:
            return
        self.dismiss()
        self.plugin._send(self.data, self.dialog_id, self.reply_to_top_msg, send_mode="file")

    def _send_sticker(self, view=None):
        if self._rendering:
            return
        self.dismiss()
        self.plugin._send_sticker(
            self.msgs,
            self.chat,
            self.dialog_id,
            self.reply_to_top_msg,
            anonymize_enabled=self.anonymize_enabled,
        )

    def _send_to_chat(self, view=None):
        if self._rendering:
            return
        self.dismiss()
        self.plugin._pick_chat_and_send(self.data)

    def _copy_out(self, view=None):
        if self._rendering:
            return
        self.plugin._copy(self.data, self.activity, view)

    def _save_out(self, view=None):
        if self._rendering:
            return
        self.plugin._save_gallery(self.data, self.activity, view)

    def _share_out(self, view=None):
        if self._rendering:
            return
        self.plugin._share(self.data, self.activity, view)

class ZoomPreviewDialog:
    def __init__(self, sheet):
        self.sheet = sheet
        self.activity = sheet.activity
        self.dialog = None
        self._scale = 1.0
        self._tx = 0.0
        self._ty = 0.0
        self._image = None
        self._touch_listener = None
        self._scale_listener = None
        self._scale_detector = None

    def show(self):
        from android.app import Dialog
        from android.graphics import Color
        from android.widget import FrameLayout, ImageView, TextView
        from android.view import Gravity, MotionEvent, ViewGroup
        from android.util import TypedValue
        from org.telegram.ui.Components import LayoutHelper

        owner = self

        root = FrameLayout(self.activity)
        call_int_color(root, "setBackgroundColor", 0xF00E0E0E)

        image = ImageView(self.activity)
        image.setScaleType(ImageView.ScaleType.FIT_CENTER)
        image.setImageBitmap(self.sheet.preview_bitmap)
        self._image = image
        root.addView(image, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))

        hint = TextView(self.activity)
        hint.setText("Двойной тап — увеличить, тап вне картинки — закрыть")
        hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
        call_int_color(hint, "setTextColor", 0x99FFFFFF)
        hint.setGravity(Gravity.CENTER)
        root.addView(hint, LayoutHelper.createFrame(-1, -2, Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL, 16, 0, 16, 24))

        ScaleGestureDetector = find_class("android.view.ScaleGestureDetector")
        SimpleOnScaleGestureListener = find_class("android.view.ScaleGestureDetector$SimpleOnScaleGestureListener")
        if ScaleGestureDetector is not None and SimpleOnScaleGestureListener is not None:
            try:
                class _ScaleListener(dynamic_proxy(SimpleOnScaleGestureListener)):
                    def __init__(self):
                        super().__init__()

                    def onScale(self, detector):
                        try:
                            owner._apply_scale(owner._scale * float(detector.getScaleFactor()))
                        except Exception:
                            pass
                        return True

                self._scale_listener = _ScaleListener()
                self._scale_detector = ScaleGestureDetector(self.activity, self._scale_listener)
            except Exception:
                self._scale_detector = None

        ViewOnTouchListener = find_class("android.view.View$OnTouchListener")
        if ViewOnTouchListener is not None:
            class _TouchListener(dynamic_proxy(ViewOnTouchListener)):
                def __init__(self):
                    super().__init__()
                    self.last_x = 0.0
                    self.last_y = 0.0
                    self.last_tap = 0.0

                def onTouch(self, view, event):
                    try:
                        if owner._scale_detector is not None:
                            owner._scale_detector.onTouchEvent(event)
                        action = event.getActionMasked()
                        if action == MotionEvent.ACTION_DOWN:
                            self.last_x = float(event.getRawX())
                            self.last_y = float(event.getRawY())
                            now = time.time()
                            if now - self.last_tap < 0.3:
                                owner._toggle_zoom()
                                self.last_tap = 0.0
                            else:
                                self.last_tap = now
                        elif action == MotionEvent.ACTION_MOVE and event.getPointerCount() == 1 and owner._scale > 1.01:
                            dx = float(event.getRawX()) - self.last_x
                            dy = float(event.getRawY()) - self.last_y
                            self.last_x = float(event.getRawX())
                            self.last_y = float(event.getRawY())
                            owner._pan(dx, dy)
                    except Exception:
                        pass
                    return True

            self._touch_listener = _TouchListener()
            try:
                root.setOnTouchListener(self._touch_listener)
            except Exception:
                pass

        close = TextView(self.activity)
        close.setText("Закрыть")
        close.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        call_int_color(close, "setTextColor", 0xFFFFFFFF)
        close.setPadding(AndroidUtilities.dp(18), AndroidUtilities.dp(12), AndroidUtilities.dp(18), AndroidUtilities.dp(12))
        close.setOnClickListener(OnClickListener(lambda *_: self.dismiss()))
        root.addView(close, LayoutHelper.createFrame(-2, -2, Gravity.TOP | Gravity.RIGHT, 0, 8, 8, 0))

        dialog = None
        try:
            from android import R as AndroidR
            dialog = Dialog(self.activity, AndroidR.style.Theme_Translucent_NoTitleBar_Fullscreen)
        except Exception:
            dialog = None
        if dialog is None:
            try:
                dialog = Dialog(self.activity, R.style.TransparentDialog)
            except Exception:
                dialog = Dialog(self.activity)
        dialog.setContentView(root, ViewGroup.LayoutParams(-1, -1))
        try:
            window = dialog.getWindow()
            window.setBackgroundDrawableResource(17170445)
            window.setLayout(-1, -1)
        except Exception:
            pass
        self.dialog = dialog
        dialog.show()

    def _apply_scale(self, value):
        self._scale = max(1.0, min(5.0, float(value)))
        if self._scale <= 1.01:
            self._tx = 0.0
            self._ty = 0.0
        self._sync()

    def _toggle_zoom(self):
        self._apply_scale(1.0 if self._scale > 1.01 else 2.5)

    def _pan(self, dx, dy):
        self._tx += float(dx)
        self._ty += float(dy)
        self._sync()

    def _sync(self):
        if self._image is None:
            return
        try:
            self._image.setScaleX(float(self._scale))
            self._image.setScaleY(float(self._scale))
            self._image.setTranslationX(float(self._tx))
            self._image.setTranslationY(float(self._ty))
        except Exception:
            pass

    def dismiss(self):
        if self.dialog is not None:
            try:
                self.dialog.dismiss()
            except Exception:
                pass
            self.dialog = None

class ExteraShotPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.btn, self.tmp = None, None
        self._bg_cache = None
        self._bg_color_picker_sheet = None
        self._bg_color_picker_consumer = None
        self._bg_color_picker_pipette_delegate = None
        self._bg_color_picker_delegate = None
        self._watermark_color_picker_sheet = None
        self._watermark_color_picker_consumer = None
        self._watermark_color_picker_pipette_delegate = None
        self._watermark_color_picker_delegate = None
        self._action_selected_fill_paint = None
        self._watermark_preview_views = []
        self._watermark_preview_delegates = []
        self._logo_result_hook = None
        self._picker_delegates = []
        self._menu_item_id = None
        self._action_sel_ids = set()
        self._action_fill_argb = None

    def _action_bar(self, chat):
        try:
            return chat.getActionBar() if chat else None
        except Exception:
            return None

    def _action_mode_on(self, chat):
        action_bar = self._action_bar(chat)
        try:
            return bool(action_bar and action_bar.isActionModeShowed())
        except Exception:
            return False

    def _is_action_cell(self, view):
        action_cls = J.get('ActionCell')
        if action_cls is None or view is None:
            return False
        try:
            return bool(action_cls.isInstance(view))
        except Exception:
            return False

    def _view_msg(self, view):
        try:
            return view.getMessageObject() if view is not None else None
        except Exception:
            return None

    def _call_chat(self, chat, method_name, arg_types=(), args=(), required=False):
        try:
            method = chat.getClass().getDeclaredMethod(method_name, *arg_types)
            method.setAccessible(True)
            return method.invoke(chat, *args)
        except Exception:
            if required:
                raise
            return None

    def _action_cells(self, chat):
        try:
            list_view = chat.getChatListView() if chat else None
        except Exception:
            list_view = None
        if not list_view:
            return

        try:
            total = int(list_view.getChildCount())
        except Exception:
            return

        for index in range(total):
            child = list_view.getChildAt(index)
            if self._is_action_cell(child):
                yield child

    def _clear_hook(self, param):
        try:
            param.setResult(None)
            return
        except Exception:
            pass
        try:
            param.result = None
        except Exception:
            pass

    def _is_service_msg(self, msg):
        try:
            if not msg:
                return False
            owner = getattr(msg, "messageOwner", None)
            if owner is None:
                return False
            return getattr(owner, "action", None) is not None
        except Exception:
            return False

    def _on_action_row(self, param):
        try:
            chat = getattr(param, "thisObject", None)
            if not chat:
                return
            if not self._action_mode_on(chat):
                return

            view = param.args[0] if param.args and len(param.args) > 0 else None
            if view is None:
                return

            action_cls = J.get('ActionCell')
            if action_cls is not None and not self._is_action_cell(view):
                return

            msg = self._view_msg(view)
            if not self._is_service_msg(msg):
                return

            outside = False
            try:
                outside = bool(param.args[1])
            except Exception:
                outside = False

            self._call_chat(
                chat,
                "addToSelectedMessages",
                (J['MO'], J['Bool'].TYPE),
                (msg, outside),
                required=True,
            )
            self._call_chat(chat, "updateActionModeTitle")
            self._call_chat(chat, "updateVisibleRows")

            self._sync_action_cells(chat)
            self._clear_hook(param)
        except Exception as e:
            log(f"[QuoteCreate] processRowSelect hook error: {e}")

    def _is_sel_msg(self, chat, msg):
        try:
            if chat is None or msg is None:
                return False
            sel = get_private_field(chat, "selectedMessagesIds")
            if not sel:
                return False
            idx = 0
            try:
                idx = 0 if msg.getDialogId() == chat.getDialogId() else 1
            except Exception:
                idx = 0
            arr = sel[idx]
            return arr is not None and arr.indexOfKey(msg.getId()) >= 0
        except Exception:
            return False

    def _refresh_action_selection(self, chat):
        selected_ids = set()
        try:
            if chat is not None and self._action_mode_on(chat):
                sel = get_private_field(chat, "selectedMessagesIds")
                for arr in (sel or []):
                    if not arr:
                        continue
                    for index in range(arr.size()):
                        msg = arr.valueAt(index)
                        if self._is_service_msg(msg):
                            selected_ids.add(int(msg.getId()))
        except Exception as e:
            log(f"[QuoteCreate] action selection refresh error: {e}")
        self._action_sel_ids = selected_ids

        if not selected_ids:
            self._action_fill_argb = None
            return
        try:
            provider = get_private_field(chat, "themeDelegate")
        except Exception:
            provider = None
        try:
            fill_color = Theme.getColor(Theme.key_chat_serviceBackgroundSelected, provider) if provider else Theme.getColor(Theme.key_chat_serviceBackgroundSelected)
        except Exception:
            try:
                fill_color = Theme.getColor(Theme.key_chat_serviceBackgroundSelected)
            except Exception:
                fill_color = 0xFF2B2B2B
        value = as_java_color(fill_color)
        self._action_fill_argb = (
            (value >> 16) & 0xFF,
            (value >> 8) & 0xFF,
            value & 0xFF,
        )

    def _sync_action_cells(self, chat):
        try:
            if chat is None:
                return
            self._refresh_action_selection(chat)
            action_mode = self._action_mode_on(chat)
            for child in self._action_cells(chat):
                msg = self._view_msg(child)
                selected = action_mode and self._is_service_msg(msg) and self._is_sel_msg(chat, msg)
                try:
                    if not action_mode:
                        child.setOverrideColor(-1, -1)
                    elif selected:
                        child.setOverrideColor(Theme.key_chat_serviceBackgroundSelected, Theme.key_chat_serviceText)
                    else:
                        child.setOverrideColor(Theme.key_chat_serviceBackground, Theme.key_chat_serviceText)
                    child.invalidate()
                except Exception:
                    pass
        except Exception as e:
            log(f"[QuoteCreate] action cell visual update error: {e}")

    def _on_action_sel(self, chat):
        self._upd(chat)
        self._sync_action_cells(chat)

    def _on_action_hide(self, chat):
        self._rm()
        self._action_sel_ids = set()
        self._action_fill_argb = None
        self._sync_action_cells(chat)

    def _draw_cell_sel(self, param):
        if not self._action_sel_ids or self._action_fill_argb is None:
            return
        try:
            cell = param.thisObject
            if cell is None:
                return
            msg = cell.getMessageObject()
            if msg is None or int(msg.getId()) not in self._action_sel_ids:
                return
            canvas = param.args[0] if param.args and len(param.args) > 0 else None
            if canvas is None:
                return

            paint = self._action_selected_fill_paint
            if paint is None:
                paint = J['Paint'](J['Paint'].ANTI_ALIAS_FLAG)
                paint.setStyle(J['Paint'].Style.FILL)
                self._action_selected_fill_paint = paint

            fr, fg, fb = self._action_fill_argb
            paint.setARGB(118, int(fr), int(fg), int(fb))

            right = int(cell.getWidth())
            bottom = int(cell.getHeight())
            if right <= 0 or bottom <= 0:
                return

            canvas.drawRect(0.0, 0.0, float(right), float(bottom), paint)
        except Exception:
            pass

    def on_plugin_load(self):
        if not init_java(): return BulletinHelper.show_error("Quote: не удалось загрузить Java-классы")
        self.tmp = self._tmp_dir()
        cl = J['CA'].getClass()
        self.hook_method(cl.getDeclaredMethod("addToSelectedMessages", J['MO'], J['Bool'].TYPE, J['Bool'].TYPE),
                         type("H", (MethodHook,), {"after_hooked_method": lambda s,p: run_on_ui_thread(lambda: self._on_action_sel(p.thisObject))})())
        try:
            row_select_method = None
            for num_cls in (J.get('Float'), J.get('Double')):
                try:
                    if num_cls:
                        row_select_method = cl.getDeclaredMethod("processRowSelect", J['View'], J['Bool'].TYPE, num_cls.TYPE, num_cls.TYPE)
                        break
                except Exception:
                    pass
            if row_select_method:
                self.hook_method(
                    row_select_method,
                    type("H2", (MethodHook,), {"before_hooked_method": lambda s,p: self._on_action_row(p)})()
                )
            else:
                raise Exception("processRowSelect signature not found")
        except Exception as e:
            log(f"[QuoteCreate] processRowSelect hook skipped: {e}")
        try:
            action_cls = J.get('ActionCell')
            if action_cls:
                on_draw_method = None
                candidates = []
                try:
                    candidates.append(action_cls)
                except Exception:
                    pass
                try:
                    candidates.append(action_cls.getClass())
                except Exception:
                    pass
                for c in candidates:
                    if not c:
                        continue
                    try:
                        on_draw_method = c.getDeclaredMethod("onDraw", J['Canvas'])
                        break
                    except Exception:
                        try:
                            on_draw_method = c.getMethod("onDraw", J['Canvas'])
                            break
                        except Exception:
                            pass
                if on_draw_method:
                    try:
                        on_draw_method.setAccessible(True)
                    except Exception:
                        pass
                    self.hook_method(
                        on_draw_method,
                        type("H3", (MethodHook,), {"after_hooked_method": lambda s,p: self._draw_cell_sel(p)})()
                    )
                else:
                    raise Exception("onDraw method not found")
        except Exception as e:
            log(f"[QuoteCreate] onDraw action hook skipped: {e}")
        self.hook_method(cl.getDeclaredMethod("hideActionMode"),
                         type("H", (MethodHook,), {"after_hooked_method": lambda s,p: run_on_ui_thread(lambda: self._on_action_hide(p.thisObject))})())

        try:
            self._menu_item_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    item_id="quotecreate_make_quote",
                    text="Сделать цитату",
                    icon="msg_screencast",
                    condition="message != null",
                    on_click=self._on_menu_quote,
                    priority=8,
                )
            )
        except Exception as e:
            log(f"[QuoteCreate] Menu item registration failed: {e}")

        run_on_queue(self._cleanup_tmp, PLUGINS_QUEUE)

        if not self.get_setting("_first_run_done", False):
            self._blink_flash()
            self.set_setting("_first_run_done", True)

    def _cleanup_tmp(self):
        keep = os.path.basename(self._watermark_logo_path() or "")
        try:
            base = self.tmp or self._tmp_dir()
            if not base or not os.path.isdir(base):
                return
            now = time.time()
            for name in os.listdir(base):
                if keep and name == keep:
                    continue
                path = os.path.join(base, name)
                try:
                    if not os.path.isfile(path):
                        continue
                    if now - os.path.getmtime(path) < TMP_MAX_AGE_SEC:
                        continue
                    os.remove(path)
                except Exception:
                    pass
        except Exception as e:
            log(f"[QuoteCreate] Temp cleanup failed: {e}")

    def on_plugin_unload(self):
        self._rm()
        self._action_sel_ids = set()
        self._action_fill_argb = None
        self._picker_delegates = []
        if self._menu_item_id:
            try:
                self.remove_menu_item(self._menu_item_id)
            except Exception:
                pass
            self._menu_item_id = None
        if self._logo_result_hook is not None:
            try:
                self.unhook_method(self._logo_result_hook)
            except Exception:
                pass
            self._logo_result_hook = None
        try:
            cached = self._bg_cache[2] if self._bg_cache else None
            if cached and not cached.isRecycled():
                cached.recycle()
        except Exception:
            pass
        self._bg_cache = None
        logo = self._watermark_logo_path()
        if self.tmp and os.path.exists(self.tmp):
            if logo:
                self._cleanup_tmp_except(logo)
            else:
                shutil.rmtree(self.tmp, ignore_errors=True)

    def _cleanup_tmp_except(self, keep_path):
        try:
            for name in os.listdir(self.tmp):
                path = os.path.join(self.tmp, name)
                if os.path.abspath(path) == os.path.abspath(keep_path):
                    continue
                try:
                    if os.path.isfile(path):
                        os.remove(path)
                except Exception:
                    pass
        except Exception:
            pass

    def create_settings(self):
        from ui.settings import Header, Selector, Divider, Switch, Text, Input, Custom
        bg_type = self.get_setting("bg_type", 0)
        self._watermark_settings_factories = []
        settings = [
            Header("Настройки фона"),
            Selector("bg_type", "Тип фона", 0, ["Тема чата", "Прозрачный", "Свой цвет"], icon="msg_customize", on_change=self._on_bg_type_change),
            Switch("transparent_sticker", "Прозрачный фон для стикера", True, icon="media_sticker_stroke"),
            Divider("если выключено — стикер рендерится с фоном чата или своим цветом"),
        ]
        if bg_type == 2:
            settings[2:2] = [
                Text(f"Цвет фона: {self._bg_color_text()}", icon="msg_palette", on_click=self._pick_bg_color),
