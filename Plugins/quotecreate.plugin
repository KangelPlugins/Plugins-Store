            )
        settings.extend([
            Selector("render_scale", "Масштаб", 0, ["1x", "1.5x", "2x"], icon="msg_photo_settings"),
            Custom(factory=self._keep_settings_factory(self._watermark_slider_factory("image_padding", "Поля вокруг цитаты", 16, 0, 48, "dp"))),
            Custom(factory=self._keep_settings_factory(self._watermark_slider_factory("corner_radius", "Скругление углов", 0, 0, 48, "dp"))),
            Divider("скругление применяется только к PNG — у JPEG нет прозрачности"),
            Header("Водяной знак"),
            Switch("watermark_enabled", "Включить водяной знак", False, icon="msg_customize"),
            Input("watermark_text", "Текст", "@username", subtext="Доступны подстановки {date}, {chat}, {count}", icon="msg_edit"),
            Selector("watermark_position", "Позиция", 0, ["Низ справа", "Низ слева", "Верх справа", "Верх слева", "Центр"], icon="msg_openprofile"),
            Custom(factory=self._keep_settings_factory(self._watermark_preview_factory())),
            Custom(factory=self._keep_settings_factory(self._watermark_slider_factory("watermark_size", "Размер текста", 13, 8, 48, "dp"))),
            Custom(factory=self._keep_settings_factory(self._watermark_slider_factory("watermark_opacity", "Прозрачность текста", 72, 5, 100, "%"))),
            Custom(factory=self._keep_settings_factory(self._watermark_slider_factory("watermark_padding", "Отступ от края", 12, 0, 64, "dp"))),
            Custom(factory=self._keep_settings_factory(self._watermark_slider_factory("watermark_angle", "Наклон текста", 0, -45, 45, "°"))),
            Custom(factory=self._keep_settings_factory(self._watermark_color_factory())),
            Switch("watermark_blur_bg", "Размытый фон под текстом", True, icon="menu_feature_transparent"),
            Custom(factory=self._keep_settings_factory(self._watermark_slider_factory("watermark_bg_opacity", "Прозрачность плашки", 36, 0, 100, "%"))),
            Custom(factory=self._keep_settings_factory(self._watermark_slider_factory("watermark_bg_radius", "Скругление плашки", 12, 0, 32, "dp"))),
            Switch("watermark_tile", "Замостить по диагонали", False, icon="msg_media", on_change=self._on_watermark_tile_change),
            Divider("текст повторяется сеткой по всей картинке — плашка и размытие при этом не рисуются"),
            Text(
                f"Логотип: {self._watermark_logo_state()}",
                subtext="PNG или JPEG из файлов устройства",
