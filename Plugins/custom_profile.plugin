from typing import Any, List

from base_plugin import BasePlugin
from client_utils import get_last_fragment
from android_utils import run_on_ui_thread
import ui.settings as _uisettings

def _ui_optional(_name):
    try:
        return getattr(_uisettings, _name)
    except Exception:
        return None

Custom = _ui_optional("Custom")
SimpleSettingFactory = _ui_optional("SimpleSettingFactory")
Header = _ui_optional("Header")
Text = _ui_optional("Text")

__id__ = "custom_profile"
__name__ = "Custom Profile"
__description__ = (
    "Раскрасьте свой профиль используя этот плагин!\n\n"
    " ↑ Настройки на разных версиях: \n"
    " |  ExteraGram 12.5.1> - Профиль -> ⋮ -> Оформить профиль\n"
    " |  ExteraGram 12.8.1 - Настройки плагина"
)
__author__ = "@RoflPlugins"
__version__ = "1.6.1"
__icon__ = "RoflPlugins/18"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.0"

_LEGACY_KEYS = [
    "enabled", "show_emoji", "banner_mode", "banner_path", "banner_color",
    "grad_type", "grad_dir", "grad_angle", "grad_c1", "grad_c2", "grad_c3",
    "grad_use3", "grad_radius", "grad_count", "banner_alpha", "banner_fade",
    "banner_fade_angle", "banner_fade_radius", "bg_alpha", "bg_fade",
    "bg_fade_angle", "bg_fade_radius", "grad_cx", "grad_cy", "banner_fade_cx",
    "banner_fade_cy", "bg_fade_cx", "bg_fade_cy", "bg_enabled", "bg_mode",
    "bg_color", "bg_path", "share_enabled", "last_pub_sig", "avatar_shape",
    "avatar_radius", "avatar_round", "avatar_custom", "avatar_alpha",
    "blocks_color_enabled", "blocks_color", "blocks_alpha", "blocks_blur",
    "blocks_depth", "publish_consent", "remote_enabled", "remote_prompted",
    "name_grad_angle", "name_size", "name_font", "banner_dim", "bg_dim",
    "avatar_dim", "name_font_path", "thought_text", "thought_text_color",
    "thought_bg_color", "thought_font", "thought_font_copy",
    "thought_font_path", "name_color_enabled", "name_color",
    "name_glow_enabled", "name_glow_color", "name_glow_radius",
    "name_glow_strength", "name_fx", "name_fx_speed", "name_grad_c1",
    "name_grad_c2", "avatar_fade", "avatar_fade_radius",
    "profile_text_color_enabled", "profile_text_color",
    "profile_hint_color_enabled", "profile_hint_color",
    "profile_action_color_enabled", "profile_action_color",
    "banner_sound", "banner_sound_volume", "bg_sound", "bg_sound_volume",
]

_LEGACY_ACCT_KEYS = ["device_key", "cpb_likes"]

_DEX_B64 = ""
_DEX_SHA = "02dd01f7d789a254dcbfb18d0d7e643d7f7c333420abcdf4b9cb2f13cef2bbca"
_BUILD_SHA = "3e3f26e9b6564e2736b72024d6fac382c01e55a256c9c29c515adbe05f9bf515"

class CustomProfileBannerPlugin(BasePlugin):

    def on_plugin_load(self):
        self._core = None
        try:
            self._core = self._load_core()
        except Exception as e:
            self.log("[cpb] dex core load failed: %s" % e)
            self._core = None
        if self._core is None:
            self.log("[cpb] плагин не активен: ядро не загрузилось")

    def on_plugin_unload(self):
        core = getattr(self, "_core", None)
        if core is None:
            return
        try:
            core.unload()
        except Exception as e:
            self.log("[cpb] unload failed: %s" % e)
        self._core = None

    def _load_core(self):
        import base64
        import os

        from java import jclass
        from org.telegram.messenger import ApplicationLoader

        ctx = ApplicationLoader.applicationContext
        if ctx is None:
            raise RuntimeError("нет контекста приложения")

        base = ctx.getFilesDir().getAbsolutePath()
        dex_dir = os.path.join(base, "cpb_native")
        os.makedirs(dex_dir, exist_ok=True)
        dex_path = os.path.join(dex_dir, "cpb_%s.dex" % _DEX_SHA[:16])

        if not os.path.exists(dex_path) or os.path.getsize(dex_path) == 0:
            data = base64.b64decode(_DEX_B64)
            tmp = dex_path + ".part"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, dex_path)
            for old in os.listdir(dex_dir):
                if old.endswith(".dex") and old != os.path.basename(dex_path):
                    try:
                        os.chmod(os.path.join(dex_dir, old), 0o600)
                        os.remove(os.path.join(dex_dir, old))
                    except Exception:
                        pass
        try:
            os.chmod(dex_path, 0o400)
        except Exception:
            pass

        opt_dir = os.path.join(dex_dir, "opt")
        os.makedirs(opt_dir, exist_ok=True)

        DexClassLoader = jclass("dalvik.system.DexClassLoader")
        parent = ctx.getClassLoader()
        loader = DexClassLoader(dex_path, opt_dir, None, parent)
        core = loader.loadClass("cpb.CpbNative")

        legacy = self._collect_legacy()
        load = None
        for m in core.getDeclaredMethods():
            if m.getName() == "load":
                load = m
                break
        if load is None:
            raise RuntimeError("в ядре нет метода load")
        try:
            from java import jclass
            jclass("android.util.Log").i(
                "CpbNative", "plugin build " + _DEX_SHA[:12])
        except Exception:
            pass
        load.invoke(None, _args(ctx, legacy))
        self.log("[cpb] ядро загружено, перенесено настроек: %d" % legacy.size())
        return _Core(core)

    def _collect_legacy(self):
        from java import jclass

        HashMap = jclass("java.util.HashMap")
        out = HashMap()
        out.put("__cpb_build_sha", _BUILD_SHA)
        tag = self._acct_tag()
        missing = object()
        for key in _LEGACY_KEYS:
            for full in (tag + "_" + key, key):
                try:
                    value = self.get_setting(full, missing)
                except Exception:
                    value = missing
                if value is not missing and value is not None:
                    out.put(tag + "_" + key, self._as_java(value))
                    break
        for key in _LEGACY_ACCT_KEYS:
            try:
                value = self.get_setting(tag + "_" + key, missing)
            except Exception:
                value = missing
            if value is not missing and value is not None:
                out.put(tag + "_" + key, self._as_java(value))
        return out

    @staticmethod
    def _as_java(value):
        from java import jclass
        if isinstance(value, bool):
            return jclass("java.lang.Boolean")(bool(value))
        if isinstance(value, int):
            return jclass("java.lang.Integer")(int(value))
        if isinstance(value, float):
            return jclass("java.lang.Float")(float(value))
        return str(value)

    def _acct_tag(self):
        try:
            from hook_utils import find_class
            uc = find_class("org.telegram.messenger.UserConfig")
            acc = int(uc.selectedAccount)
            uid = int(uc.getInstance(acc).getClientUserId())
            return str(uid) if uid > 0 else ("slot%d" % acc)
        except Exception:
            return "0"

    def create_settings(self) -> List[Any]:
        core = getattr(self, "_core", None)
        if core is None:
            if Header is not None and Text is not None:
                return [
                    Header(text="Custom Profile"),
                    Text(text="Ядро плагина не загрузилось — переустановите плагин."),
                ]
            return []
        if SimpleSettingFactory is None or Custom is None:
            items = []
            if Header is not None:
                items.append(Header(text="Custom Profile"))
            if Text is not None:
                items.append(Text(
                    text="Настройки этого плагина — в вашем профиле. "
                         "Откройте свой профиль → меню «⋮» → «Оформить профиль»."))
            return items

        plugin = self

        def _fallback(context, message):
            from android.widget import TextView
            tv = TextView(context)
            tv.setText(message)
            return tv

        def _create_preview(context, list_view, current_account, class_guid, resources_provider):
            try:
                return plugin._core.build_preview_view(context)
            except Exception as e:
                plugin.log("[cpb] profile preview failed: %s" % e)
                return _fallback(context, "Предпросмотр недоступен")

        def _create_editor(context, list_view, current_account, class_guid, resources_provider):
            try:
                return plugin._core.build_settings_view(context)
            except Exception as e:
                plugin.log("[cpb] inline settings failed: %s" % e)
                return _fallback(context, "Не удалось загрузить редактор")

        def _bind(view, item, divider, adapter, list_view):
            return None

        self._preview_factory = SimpleSettingFactory(
            _create_preview, _bind, is_clickable=False, is_shadow=False
        )
        self._web_factory = SimpleSettingFactory(
            _create_editor, _bind, is_clickable=False, is_shadow=False
        )
        return [
            Header(text="Custom Profile Banner"),
            Custom(factory=self._preview_factory.instance.java),
            Custom(factory=self._web_factory.instance.java),
        ]

def _args(*values):
    from java import jarray, jclass
    arr = jarray(jclass("java.lang.Object"))(len(values))
    for i, v in enumerate(values):
        arr[i] = v
    return arr

class _Core:

    def __init__(self, cls):
        self._cls = cls
        self._methods = {}
        for m in cls.getDeclaredMethods():
            self._methods.setdefault(m.getName(), m)

    def unload(self):
        m = self._methods.get("unload")
        if m is not None:
            m.invoke(None, _args())

    def build_settings_view(self, context):
        m = self._methods.get("buildSettingsView")
        if m is None:
            raise RuntimeError("в ядре нет buildSettingsView")
        return m.invoke(None, _args(context))

    def build_preview_view(self, context):
        m = self._methods.get("buildPreviewView")
        if m is None:
            raise RuntimeError("в ядре нет buildPreviewView")
        return m.invoke(None, _args(context))
