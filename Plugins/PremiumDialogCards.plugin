        self._paint_muted_fill = None
        self._paint_muted_stroke = None
        self._paint_online_fill = None
        self._paint_online_stroke = None

        self._field_cache = {}
        self._field_lookup = {}
        self._class_profiles = {}

        self._user_expires_cache = {}
        self._cached_server_time = 0
        self._last_server_time_update = 0.0

        self._blur_radius_cached = DEFAULT_BLUR
        self._darken_percent_cached = 55
        self._tint_color = None
        self._tint_tag = "d55"
        self._theme_signature = None
        self._last_theme_check = 0.0
        self._stroke_width_cached = DEFAULT_STROKE_WIDTH_DP
        self._stroke_alpha_cached = DEFAULT_STROKE_ALPHA
        self._settled_min_w = 48
        self._enabled_cached = True
        self._mute_stroke_cached = False
        self._mute_dim_cached = False
        self._mute_opacity_cached = 30
        self._online_border_cached = True

        self._palette_status = "ещё не применялась"
        self._palette_slots = {}
        self._learned_colors = {}
        self._night_colors = {}
        self._theme_jclass = None
        self._static_cache = {}
        self._key_cache = {}
        self._in_theme_refresh = False
        self._palette_active = False
        self._palette_key_entries = None
        self._palette_paint_entries = None
        self._resolved_keys = None
        self._resolved_paints = None
        self._color_table = None
        self._color_saved = {}
        self._defaults_array = None
        self._defaults_owner = 0
        self._defaults_saved = {}
        self._array_class = None
        self._defaults_len = -1

        self._dialog_cell_hooked = False
        self._dialog_update_hooked = False
        self._theme_hooks_done = False

        self.UserConfigClass = None
        self.MessagesControllerClass = None
        self.ThemeClass = None
        self.AvatarDrawableClass = None
        self._messages_controller = None
        self._connections_manager = None
        self._self_user_id = None
        self._mask_cache = {}
        self._mc_mute_mode = 0
        self._mc_user_mode = 0
        self._bitmap_mode = 0
        self._imagekey_mode = 0
        self._dialogid_mode = 0
        self._invalidate_mode = 0
        self._account = -2

    def on_plugin_load(self):
        try:
            log_msg("=== load ===")
            self._teardown()
            self._lifecycle_generation += 1
            self.cache_classes()
            self.init_metrics()
            self.update_cached_settings()
            self._theme_signature = None
            self.force_theme_check()
            self._executor = ThreadPoolExecutor(max_workers=2)
            self.hook_dialogs_activity()
            self.hook_theme_rebuild()
            self.install_hooks()
            log_msg("=== load complete ===")
        except:
            log_exception("on_plugin_load")

    def on_plugin_unload(self):
        try:
            log_msg("=== unload ===")
            self._teardown()
            self._lifecycle_generation += 1
            self.UserConfigClass = None
            self.MessagesControllerClass = None
            self.ThemeClass = None
            self.AvatarDrawableClass = None
            self._messages_controller = None
            self._connections_manager = None
            log_msg("=== unload complete ===")
        except:
            log_exception("on_plugin_unload")

    def _teardown(self):
        self.restore_palette()
        for ref in self._hooks:
            try:
                self.unhook_method(ref)
            except:
                pass
        self._hooks = []
        self._feature_hooks = {}

        if self._executor is not None:
            try:
                self._executor.shutdown(wait=False, cancel_futures=True)
            except TypeError:
                try:
                    self._executor.shutdown(wait=False)
                except:
                    pass
            except:
                pass
            self._executor = None

        self.restore_all_cells()
        self._cell_states = {}
        self._state_order = []
        self._current_state = None
        self._is_drawing_dialog_cell = False

        with self._lock:
            self._blur_inflight.clear()
            self._blur_cache.clear()
            del self._blur_order[:]

        self._shader_cache = {}
        self._shader_order = []
        self._solid_paints = {}
        self._solid_order = []
        self._placeholder_color_cache = {}
        self._geometry_cache = {}
        self._geo_order = []
        self._geo_last = None

        self._field_cache = {}
        self._field_lookup = {}
        self._class_profiles = {}
        self._dp_cache = {}
        self._user_expires_cache = {}
        self._cached_server_time = 0
        self._last_server_time_update = 0.0
        self._mask_cache = {}

        self._paint_fade = None
        self._paint_muted_fill = None
        self._paint_muted_stroke = None
        self._paint_online_fill = None
        self._paint_online_stroke = None

        self._dialog_cell_hooked = False
        self._dialog_update_hooked = False
        self._theme_hooks_done = False
        self._self_user_id = None
        self._mc_mute_mode = 0
        self._mc_user_mode = 0
        self._bitmap_mode = 0
        self._imagekey_mode = 0
        self._dialogid_mode = 0
        self._invalidate_mode = 0
        self._account = -2
        self._theme_signature = None
        self._last_theme_check = 0.0
        self._theme_jclass = None
        self._key_cache = {}
        self._night_colors = {}
        self._in_theme_refresh = False
        self.reset_palette_cache()

    def cache_classes(self):
        try:
            self.UserConfigClass = find_class("org.telegram.messenger.UserConfig")
        except:
            self.UserConfigClass = None
        try:
            self.MessagesControllerClass = find_class("org.telegram.messenger.MessagesController")
        except:
            self.MessagesControllerClass = None
        try:
            self.ThemeClass = find_class("org.telegram.ui.ActionBar.Theme")
        except:
            self.ThemeClass = None
        try:
            self.AvatarDrawableClass = find_class("org.telegram.ui.Components.AvatarDrawable")
        except:
            self.AvatarDrawableClass = None

    def theme_class(self):
        if self.ThemeClass is None:
            try:
                self.ThemeClass = find_class("org.telegram.ui.ActionBar.Theme")
            except:
                self.ThemeClass = None
        return self.ThemeClass

    def theme_java_class(self):
        if self._theme_jclass is None:
            self._theme_jclass = get_java_class("org.telegram.ui.ActionBar.Theme")
        return self._theme_jclass

    def theme_field(self, name):
        cached = self._static_cache.get(name, _MISSING)
        if cached is not _MISSING:
            return cached
        value = None
        proxy = self.theme_class()
        if proxy is not None:
            try:
                value = getattr(proxy, name)
            except:
                value = None
        if value is None:
            cls = self.theme_java_class()
            if cls is not None:
                try:
                    f = cls.getDeclaredField(name)
                    f.setAccessible(True)
                    value = f.get(None)
                except:
                    value = None
        self._static_cache[name] = value
        return value

    def theme_key(self, name):
        cached = self._key_cache.get(name, _MISSING)
        if cached is not _MISSING:
            return cached
        key = None
        proxy = self.theme_class()
        if proxy is not None:
            try:
                raw = getattr(proxy, name)
                if isinstance(raw, int):
                    key = int(raw)
                elif raw is not None:
                    key = str(raw)
            except:
                key = None
        if key is None:
            cls = self.theme_java_class()
            if cls is not None:
                try:
                    f = cls.getDeclaredField(name)
                    f.setAccessible(True)
                    try:
                        key = int(f.getInt(None))
                    except:
                        raw = f.get(None)
                        key = None if raw is None else str(raw)
                except:
                    key = None
        self._key_cache[name] = key
        return key

    def dp(self, val):
        key = float(val)
        cached = self._dp_cache.get(key)
        if cached is None:
            cached = float(AndroidUtilities.dp(key))
            self._dp_cache[key] = cached
        return cached

    def init_metrics(self):
        self._dp_cache = {}
        self._settled_min_w = max(32, int(self.dp(36.0)))

    def bump_style_epoch(self):
        self._style_epoch += 1
        with self._lock:
            self._blur_cache.clear()
            del self._blur_order[:]
            self._blur_inflight.clear()
        self._geometry_cache = {}
        self._geo_order = []
        self._geo_last = None
        self._shader_cache = {}
        self._shader_order = []
        self._solid_paints = {}
        self._solid_order = []
        self._placeholder_color_cache = {}
        self.rebuild_paints()

    def rebuild_paints(self):
        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_FILL)
        self._paint_fade = p

        opacity = self._mute_opacity_cached
        muted_fill = argb_to_signed(int((100 - opacity) * 2.3), 0x22, 0x24, 0x2B)
        muted_border = argb_to_signed(int((100 - opacity) * 1.91), 0x43, 0x47, 0x53)
        status_w = float(self.dp(max(0.1, self._stroke_width_cached * STATUS_STROKE_RATIO)))

        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_FILL)
        p.setColor(to_jint(muted_fill))
        self._paint_muted_fill = p

        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_STROKE)
        p.setStrokeWidth(status_w)
        p.setColor(to_jint(muted_border))
        self._paint_muted_stroke = p

        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_FILL)
        p.setColor(to_jint(COLOR_ONLINE_FILL))
        self._paint_online_fill = p

        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_STROKE)
        p.setStrokeWidth(status_w)
        p.setColor(to_jint(COLOR_ONLINE_BORDER))
        self._paint_online_stroke = p

    def read_theme_signature(self):
        try:
            theme = self.theme_class()
            key = self.theme_key("key_windowBackgroundWhite")
            if key is None:
                return None
            return to_signed32(theme.getColor(key))
        except:
            return None

    def theme_is_dark(self):
        theme = self.theme_class()
        if theme is not None:
            try:
                return bool(theme.isCurrentThemeDark())
            except:
                pass
        signature = self._theme_signature
        if signature is None:
            signature = self.read_theme_signature()
        if signature is None:
            return False
        return not self.is_light_signature(signature)

    def is_light_signature(self, signature):
        if signature is None:
            return False
        value = signature & 0xFFFFFFFF
        r = (value >> 16) & 0xFF
        g = (value >> 8) & 0xFF
        b = value & 0xFF
        return (r * 299 + g * 587 + b * 114) > 128000

    def force_theme_check(self):
        self._last_theme_check = 0.0
        self.check_theme()

    def on_theme_rebuilt(self):
        self._theme_signature = None
        self._last_theme_check = 0.0
        self.check_theme()

    def check_theme(self):
        signature = self.read_theme_signature()
        if signature != self._theme_signature:
            self._theme_signature = signature
            self.restore_palette(True)
            self.reset_palette_cache()
            self.refresh_learned_sources()
            self.apply_palette()
            self.invalidate_all_cells()
        elif self._palette_active and not self.palette_is_ours():
            self.reset_palette_cache()
            self.apply_palette()
            self.invalidate_all_cells()


    def get_array_class(self):
        if self._array_class is None:
            self._array_class = find_class("java.lang.reflect.Array")
        return self._array_class


    def palette_slot_color(self, group, slot):
        if isinstance(slot, int):
            return to_signed32(slot)
        return self._palette_slots.get((group["id"], slot), -16777216)

    def palette_color_for(self, group, slot, source_key):
        manual = self.palette_slot_color(group, slot)
        if source_key is None:
            return manual
        learned = self._learned_colors.get(source_key)
        if learned is not None:
            return learned
        learned = self._night_colors.get(source_key)
        if learned is not None:
            return learned
        return manual

    def rebuild_palette_entries(self):
        keys = []
        paints = []
        for group in PALETTE_GROUPS:
            for name, slot in group["keys"]:
                keys.append((name, self.palette_color_for(group, slot, name)))
            for entry in group["paints"]:
                name, slot = entry[0], entry[1]
                source = entry[2] if len(entry) > 2 else None
                paints.append((name, self.palette_color_for(group, slot, source)))
        self._palette_key_entries = tuple(keys)
        self._palette_paint_entries = tuple(paints)
        self._resolved_keys = None
        self._resolved_paints = None

    def decode_learned(self, blob):
        result = {}
        try:
            for chunk in str(blob or "").split(";"):
                if "=" not in chunk:
                    continue
                name, value = chunk.split("=", 1)
                name = name.strip()
                if not name:
                    continue
                result[name] = parse_hex_color(value, 0xFF000000)
        except:
            pass
        return result

    def encode_learned(self, mapping):
        parts = []
        for name in sorted(mapping.keys()):
            parts.append(name + "=" + ("%08X" % (int(mapping[name]) & 0xFFFFFFFF)))
        return ";".join(parts)

    def snapshot_dark_palette(self):
        theme = self.theme_class()
        if theme is None:
            return False
        snapshot = {}
        for name in LEARNABLE_KEYS:
            key = self.theme_key(name)
            if key is None:
                continue
            try:
                snapshot[name] = to_signed32(theme.getColor(key))
            except:
                pass
        if not snapshot:
            return False
        if snapshot == self._learned_colors:
            return False
        self._learned_colors = snapshot
        try:
            self.set_setting("rcards.pal.learned", self.encode_learned(snapshot))
        except:
            pass
        log_msg("снимок тёмной темы: " + str(len(snapshot)) + " ключей")
        return True

    def read_night_theme_colors(self):
        theme = self.theme_class()
        if theme is None:
            return {}
        info = None
        for getter in ("getCurrentNightTheme", "getCurrentTheme"):
            try:
                info = getattr(theme, getter)()
                if info is not None:
                    break
            except:
                info = None
        if info is None:
            return {}

        asset = None
        path = None
        try:
            asset = info.assetName
        except:
            asset = None
        try:
            path = info.pathToFile
        except:
            path = None

        table = None
        try:
            if asset:
                table = theme.getThemeFileValues(None, str(asset), None)
            elif path:
                FileClass = find_class("java.io.File")
                table = theme.getThemeFileValues(FileClass(str(path)), None, None)
        except:
            table = None
        if table is None:
            return {}

        result = {}
        for name in LEARNABLE_KEYS:
            key = self.theme_key(name)
            if not isinstance(key, int):
                continue
            try:
                if int(table.indexOfKey(key)) < 0:
                    continue
                result[name] = to_signed32(table.get(key))
            except:
                pass
        if result:
            log_msg("файл ночной темы: " + str(len(result)) + " ключей")
        return result

    def refresh_learned_sources(self):
        changed = False
        if self.theme_is_dark():
            changed = self.snapshot_dark_palette()
        if not self._night_colors:
            night = self.read_night_theme_colors()
            if night:
                self._night_colors = night
                changed = True
        if changed:
            self.rebuild_palette_entries()
        return changed

    def palette_wanted(self):
        return self._enabled_cached and not self.theme_is_dark()

    def reset_palette_cache(self):
        self._palette_active = False
        self._color_table = None
        self._color_saved = {}
        self._resolved_keys = None
        self._resolved_paints = None
        self._defaults_array = None
        self._defaults_len = -1
        self._static_cache = {}

    def resolve_palette_keys(self):
        if self._resolved_keys is not None:
            return self._resolved_keys
        result = []
        for name, color in (self._palette_key_entries or ()):
            key = self.theme_key(name)
            if key is None:
                continue
            result.append((key, color))
        self._resolved_keys = tuple(result)
        return self._resolved_keys

    def resolve_palette_paints(self):
        if self._resolved_paints is not None:
            return self._resolved_paints
        result = []
        arr = self.get_array_class()
        for name, color in (self._palette_paint_entries or ()):
            value = self.theme_field(name)
            if value is None:
                continue
            try:
                is_array = bool(value.getClass().isArray())
            except:
                is_array = False
            try:
                if is_array:
                    for i in range(int(arr.getLength(value))):
                        item = arr.get(value, i)
                        if item is not None:
                            result.append([item, color, None])
                else:
                    result.append([value, color, None])
            except:
                pass
        self._resolved_paints = result
        return result

    def resolve_defaults_array(self):
        if self._defaults_array is not None:
            return self._defaults_array
        arr = None
        proxy = self.theme_class()
        if proxy is not None:
            try:
                arr = proxy.getDefaultColors()
            except:
                arr = None
        if arr is None:
            arr = self.theme_field("defaultColors")
        if arr is None:
            return None
        try:
            owner = int(System.identityHashCode(arr))
        except:
            owner = 0
        if owner != self._defaults_owner:
            self._defaults_owner = owner
            self._defaults_saved = {}
        try:
            self._defaults_len = int(self.get_array_class().getLength(arr))
        except:
            self._defaults_len = -1
        self._defaults_array = arr
        return arr

    def patch_defaults(self, restore=False):
        arr = self.resolve_defaults_array()
        if arr is None or self._defaults_len <= 0:
            return 0
        array_cls = self.get_array_class()
        if restore:
            for index, saved in tuple(self._defaults_saved.items()):
                try:
                    array_cls.setInt(arr, int(index), int(saved))
                    continue
                except:
                    pass
                try:
                    arr[int(index)] = int(saved)
                except:
                    pass
            self._defaults_saved = {}
            return 0
        written = 0
        for key, color in self.resolve_palette_keys():
            if not isinstance(key, int):
                continue
            if key < 0 or key >= self._defaults_len:
                continue
            try:
                if key not in self._defaults_saved:
                    self._defaults_saved[key] = int(array_cls.getInt(arr, key))
                array_cls.setInt(arr, key, int(color))
                written += 1
                continue
            except:
                pass
            try:
                if key not in self._defaults_saved:
                    self._defaults_saved[key] = int(arr[key])
                arr[key] = int(color)
                written += 1
            except:
                pass
        return written

    def resolve_color_table(self):
        if self._color_table is not None:
            return self._color_table
        result = (None, None)
        for name in ("currentColors", "currentColorsNoAccent"):
            table = self.theme_field(name)
            if table is None:
                continue
            try:
                cls_name = str(table.getClass().getName())
            except:
                continue
            if "SparseIntArray" in cls_name:
                result = (table, "sparse")
            elif cls_name == "[I":
                result = (table, "array")
            elif "Map" in cls_name:
                result = (table, "map")
            else:
                continue
            break
        self._color_table = result
        return result

    def read_table_color(self, table, kind, key):
        if kind == "sparse":
            if int(table.indexOfKey(key)) < 0:
                return None
            return to_signed32(table.get(key))
        if kind == "map":
            value = table.get(key)
            return None if value is None else to_signed32(value)
        arr = self.get_array_class()
        index = int(key)
        if index < 0 or index >= int(arr.getLength(table)):
            return None
        value = to_signed32(arr.getInt(table, index))
        return None if value == 0 else value

    def write_table_color(self, table, kind, key, color):
        if kind == "sparse":
            if color is None:
                table.delete(key)
            else:
                table.put(key, to_jint(color))
            return
        if kind == "map":
            if color is None:
                table.remove(key)
            else:
                table.put(key, to_jint(color))
            return
        arr = self.get_array_class()
        arr.setInt(table, int(key), int(0 if color is None else color))

    def apply_palette(self):
        if not self.palette_wanted():
            self._palette_status = "не нужна: активна тёмная тема"
            return

        keys = self.resolve_palette_keys()
        defaults_written = self.patch_defaults(restore=False)

        table, kind = self.resolve_color_table()
        table_written = 0
        if table is not None:
            for key, color in keys:
                try:
                    if key not in self._color_saved:
                        self._color_saved[key] = self.read_table_color(table, kind, key)
                    self.write_table_color(table, kind, key, color)
                    table_written += 1
                except:
                    pass

        paints = self.resolve_palette_paints()
        for entry in paints:
            try:
                if entry[2] is None:
                    entry[2] = to_signed32(entry[0].getColor())
                entry[0].setColor(to_jint(entry[1]))
            except:
                pass
        self._palette_active = True
        self.verify_palette(keys, defaults_written, table_written, len(paints))

    def verify_palette(self, keys, defaults_written, table_written, paint_count):
        ok = None
        theme = self.theme_class()
        if theme is not None and keys:
            key, color = keys[0]
            try:
                ok = to_signed32(theme.getColor(key)) == int(color)
            except:
                ok = None
        if self._learned_colors:
            source = "снимок тёмной темы"
        elif self._night_colors:
            source = "файл ночной темы"
        else:
            source = "значения по умолчанию"
        status = ("ключей %d, defaultColors %d, currentColors %d, красок %d, "
                  "источник — %s") % (len(keys), defaults_written, table_written,
                                      paint_count, source)
        if ok is True:
            status = "применена: " + status
        elif ok is False:
            status = "НЕ ПРИМЕНИЛАСЬ: " + status
        else:
            status = "состояние неизвестно: " + status
        if status != self._palette_status:
            self._palette_status = status
            log_msg("палитра — " + status)

    def refresh_dialog_paints(self):
        if self._in_theme_refresh:
            return
        theme = self.theme_class()
        if theme is None:
            return
        self._in_theme_refresh = True
        try:
            theme.applyDialogsTheme()
        except:
            pass
        finally:
            self._in_theme_refresh = False

    def restore_palette(self, client_rebuilt=False):
        if not self._palette_active:
            return
        self._palette_active = False
        self.patch_defaults(restore=True)

        if client_rebuilt:
            self._color_saved = {}
            for entry in (self._resolved_paints or ()):
                entry[2] = None
            self.refresh_dialog_paints()
            return

        table, kind = self._color_table or (None, None)
        if table is not None:
            for key, saved in tuple(self._color_saved.items()):
                try:
                    self.write_table_color(table, kind, key, saved)
                except:
                    pass
        self._color_saved = {}

        for entry in (self._resolved_paints or ()):
            if entry[2] is None:
                continue
            try:
                entry[0].setColor(to_jint(entry[2]))
            except:
                pass
            entry[2] = None

    def palette_is_ours(self):
        keys = self._resolved_keys
        if not keys:
            return True
        key, color = keys[0]
        theme = self.theme_class()
        if theme is None:
            return True
        try:
            return to_signed32(theme.getColor(key)) == int(color)
        except:
            return True

    def build_geometry(self, w, h):
        geo = _Geo()
        self._geo_counter += 1
        geo.gid = self._geo_counter
        geo.w = w
        geo.h = h
        geo.epoch = self._style_epoch

        mx = self.dp(CARD_MARGIN_X_DP)
        my = self.dp(CARD_MARGIN_Y_DP)
        geo.left = float(mx)
        geo.top = float(my)
        geo.right = float(w - mx)
        geo.bottom = float(h - my)
        geo.card_w = max(1.0, geo.right - geo.left)
        geo.card_h = max(1.0, geo.bottom - geo.top)
        geo.radius = float(self.dp(CARD_ROUNDING_DP))

        width = self._stroke_width_cached
        stroke_alpha = int(round(255.0 * self._stroke_alpha_cached / 100.0))
        geo.draw_stroke = width > 0.0 and stroke_alpha > 0
        csw = float(self.dp(width)) if geo.draw_stroke else 0.0
        half = csw / 2.0
        geo.cs_l = geo.left + half
        geo.cs_t = geo.top + half
        geo.cs_r = geo.right - half
        geo.cs_b = geo.bottom - half

        ssw = float(self.dp(max(0.1, width * STATUS_STROKE_RATIO)))
        half = ssw / 2.0
        geo.ss_l = geo.left + half
        geo.ss_t = geo.top + half
        geo.ss_r = geo.right - half
        geo.ss_b = geo.bottom - half

        stroke = Paint()
        stroke.setAntiAlias(True)
        stroke.setStyle(STYLE_STROKE)
        stroke.setStrokeWidth(csw if csw > 0.0 else 1.0)
        colors = create_int_array([argb_to_signed(stroke_alpha, 255, 255, 255),
                                   argb_to_signed(0, 255, 255, 255)])
        stroke.setShader(LinearGradient(0.0, geo.top, 0.0, geo.bottom, colors, None, TILE_CLAMP))
        geo.stroke_paint = stroke
        return geo

    def get_geometry(self, w, h):
        geo = self._geo_last
        if geo is not None and geo.w == w and geo.h == h and geo.epoch == self._style_epoch:
            return geo
        key = (w, h)
        geo = self._geometry_cache.get(key)
        if geo is None or geo.epoch != self._style_epoch:
            geo = self.build_geometry(w, h)
            if key not in self._geometry_cache:
                self._geo_order.append(key)
            self._geometry_cache[key] = geo
            while len(self._geo_order) > GEOMETRY_CACHE_LIMIT:
                old = self._geo_order.pop(0)
                if old != key:
                    self._geometry_cache.pop(old, None)
        self._geo_last = geo
        return geo

    def _get_bool(self, key, default=False):
        try:
            v = self.get_setting(key, default)
            if v is default:
                return default
            if isinstance(v, bool):
                return v
            if isinstance(v, int):
                return v != 0
            if isinstance(v, str):
                return v.strip().lower() in ("1", "true", "yes", "on", "y")
            return bool(v)
        except:
            return default

    def _get_int(self, key, default=0):
        try:
            v = self.get_setting(key, default)
            if v is default:
                return default
            return int(v)
        except:
            return default

    def _get_float(self, key, default=0.0):
        try:
            v = self.get_setting(key, default)
            if v is default:
                return default
            return float(str(v).strip().replace(",", "."))
        except:
            return default

    def _get_str(self, key, default=""):
        try:
            v = self.get_setting(key, default)
            return default if v is None else str(v)
        except:
            return default

    def create_settings(self):
        try:
            return [
                Header(text="Дизайн карточек чатов"),
                Switch(
                    key="rcards.enable",
                    text="Включить дизайн карточек",
                    default=self._get_bool("rcards.enable", True),
                    on_change=lambda v: self._on_setting_changed("rcards.enable", bool(v))
                ),
                Switch(
                    key="rcards.online_border",
                    text="Обводка карточки вместо точки онлайна",
                    subtext="Гасит штатный зелёный индикатор и подсвечивает карточку "
                            "собеседника целиком.",
                    default=self._get_bool("rcards.online_border", True),
                    on_change=lambda v: self._on_setting_changed("rcards.online_border", bool(v))
                ),
                Input(
                    key="rcards.blur",
                    text="Сила размытия фона",
                    subtext="Число от 1 до 25. Одинаково для всех чатов. По умолчанию: 7.",
                    default=str(self._get_int("rcards.blur", DEFAULT_BLUR)),
                    on_change=lambda v: self._on_setting_changed_int("rcards.blur", v)
                ),
                Input(
                    key="rcards.darken",
                    text="Сила затемнения (%)",
                    subtext="Число от 0 до 100. По умолчанию: 55.",
                    default=str(self._get_int("rcards.darken", 55)),
                    on_change=lambda v: self._on_setting_changed_int("rcards.darken", v)
                ),
                Input(
                    key="rcards.stroke_width",
                    text="Толщина обводки карточки (dp)",
                    subtext="Дробное число от 0 до 6, например 0.5 или 1.5. "
                            "0 отключает обводку. По умолчанию: 0.5.",
                    default=str(self._get_float("rcards.stroke_width", DEFAULT_STROKE_WIDTH_DP)),
                    on_change=lambda v: self._on_setting_changed_float("rcards.stroke_width", v)
                ),
                Input(
                    key="rcards.stroke_alpha",
                    text="Непрозрачность обводки (0-100%)",
                    subtext="0 — обводка не видна, 100 — сплошной белый блик. Книзу она "
                            "в любом случае плавно исчезает. По умолчанию: 24.",
                    default=str(self._get_int("rcards.stroke_alpha", DEFAULT_STROKE_ALPHA)),
                    on_change=lambda v: self._on_setting_changed_int("rcards.stroke_alpha", v)
                ),

                Header(text="Замьюченные чаты"),
                Switch(
                    key="rcards.mute_dim",
                    text="Затемнять замьюченные чаты",
                    subtext="По умолчанию замьюченные чаты выглядят как обычные. "
                            "Включите, чтобы приглушать их карточки.",
                    default=self._get_bool("rcards.mute_dim", False),
                    on_change=lambda v: self._on_setting_changed("rcards.mute_dim", bool(v))
                ),
                Input(
                    key="rcards.mute_opacity",
                    text="Яркость замьюченных чатов (0-100%)",
                    subtext="Работает только при включённом затемнении. По умолчанию: 30.",
                    default=str(self._get_int("rcards.mute_opacity", 30)),
                    on_change=lambda v: self._on_setting_changed_int("rcards.mute_opacity", v)
                ),
                Switch(
                    key="rcards.mute_stroke",
                    text="Обводка для замьюченных чатов",
                    subtext="Работает только при включённом затемнении.",
                    default=self._get_bool("rcards.mute_stroke", False),
                    on_change=lambda v: self._on_setting_changed("rcards.mute_stroke", bool(v))
                ),
            ]
        except:
            log_exception("create_settings")
            return [Header(text="Premium Dialog Cards: ошибка настроек")]

    def update_cached_settings(self):
        self._blur_radius_cached = max(1, min(25, self._get_int("rcards.blur", DEFAULT_BLUR)))
        self._darken_percent_cached = max(0, min(100, self._get_int("rcards.darken", 55)))
        self._enabled_cached = self._get_bool("rcards.enable", True)
        self._mute_stroke_cached = self._get_bool("rcards.mute_stroke", False)
        self._mute_dim_cached = self._get_bool("rcards.mute_dim", False)
        self._mute_opacity_cached = max(0, min(100, self._get_int("rcards.mute_opacity", 30)))
        self._stroke_width_cached = max(0.0, min(6.0, self._get_float("rcards.stroke_width",
                                                                     DEFAULT_STROKE_WIDTH_DP)))
        self._stroke_alpha_cached = max(0, min(100, self._get_int("rcards.stroke_alpha",
                                                                  DEFAULT_STROKE_ALPHA)))
        self._online_border_cached = self._get_bool("rcards.online_border", True)

        if not self._learned_colors:
            self._learned_colors = self.decode_learned(
                self._get_str("rcards.pal.learned", ""))
        self._palette_slots = {}
        for group in PALETTE_GROUPS:
            for slot_id, _label, default_hex in group["slots"]:
                self._palette_slots[(group["id"], slot_id)] = parse_hex_color(
                    default_hex, int(default_hex, 16) | 0xFF000000)
        self.rebuild_palette_entries()

        percent = self._darken_percent_cached
        alpha = int(255.0 * (percent / 100.0))
        self._tint_color = argb_to_signed(alpha, 0, 0, 0) if alpha > 0 else None
        self._tint_tag = "d" + str(percent)
        self.bump_style_epoch()

    def _apply_settings_change(self, hard):
        was_enabled = self._enabled_cached
        self.restore_palette()
        self.update_cached_settings()
        if hard and was_enabled != self._enabled_cached:
            self.restore_all_cells()
            self._cell_states = {}
            self._state_order = []
        else:
            for state in tuple(self._cell_states.values()):
                self.clear_visual_cache(state)
        self.reset_palette_cache()
        self.refresh_learned_sources()
        self.apply_palette()
        self.install_hooks()
        self.invalidate_all_cells()

    def _on_setting_changed(self, key, value):
        try:
            self.set_setting(key, value)
            self._apply_settings_change(key == "rcards.enable")
        except:
            log_exception("setting_changed")

    def _on_setting_changed_int(self, key, value):
        try:
            cleaned = str(value or "").strip()
            if cleaned:
                val = int(cleaned)
            elif key == "rcards.blur":
                val = DEFAULT_BLUR
            elif key == "rcards.darken":
                val = 55
            elif key == "rcards.mute_opacity":
                val = 30
            else:
                val = 0
            self.set_setting(key, val)
            self._apply_settings_change(False)
        except:
            log_exception("setting_changed_int")

    def _on_setting_changed_float(self, key, value):
        try:
            cleaned = str(value or "").strip().replace(",", ".")
            val = float(cleaned) if cleaned else DEFAULT_STROKE_WIDTH_DP
            self.set_setting(key, str(val))
            self._apply_settings_change(False)
        except:
            log_exception("setting_changed_float")

    def get_reflected_field(self, cls, field_name):
        cache_key = (cls, field_name)
        field = self._field_cache.get(cache_key, _MISSING)
        if field is not _MISSING:
            return field

        current = cls
        for _ in range(6):
            if current is None:
                break
            try:
                f = current.getDeclaredField(field_name)
                f.setAccessible(True)
                self._field_cache[cache_key] = f
                return f
            except:
                try:
                    current = current.getSuperclass()
                except:
                    break
        try:
            f = cls.getField(field_name)
            f.setAccessible(True)
            self._field_cache[cache_key] = f
            return f
        except:
            self._field_cache[cache_key] = None
            return None

    def find_first_field(self, cls, names, bool_only=False):
        cache_key = (cls, names, bool_only)
        if cache_key in self._field_lookup:
            return self._field_lookup[cache_key]
        result = None
        for name in names:
            f = self.get_reflected_field(cls, name)
            if f is None:
                continue
            if bool_only:
                try:
                    if str(f.getType().getName()) != "boolean":
                        continue
                except:
                    continue
            result = f
            break
        self._field_lookup[cache_key] = result
        return result

    def collect_bool_fields(self, cls, names):
        found = []
        for name in names:
            f = self.get_reflected_field(cls, name)
            if f is None:
                continue
            try:
                if str(f.getType().getName()) != "boolean":
                    continue
            except:
                continue
            found.append(f)
        return tuple(found)

    def get_class_profile(self, cls):
        prof = self._class_profiles.get(cls)
        if prof is None:
            prof = (self.collect_bool_fields(cls, SUPPRESS_FIELD_NAMES),
                    self.collect_bool_fields(cls, SEPARATOR_FIELD_NAMES))
            self._class_profiles[cls] = prof
        return prof

    def get_object_field(self, obj, name):
        if obj is None:
            return None
        f = self.get_reflected_field(obj.getClass(), name)
        if f is None:
            return None
        try:
            return f.get(obj)
        except:
            return None

    def get_bool_field(self, obj, name):
        if obj is None:
            return False
        f = self.get_reflected_field(obj.getClass(), name)
        if f is None:
            return False
        try:
            return bool(f.getBoolean(obj))
        except:
            try:
                return bool(f.get(obj))
            except:
                return False

    def get_int_field(self, obj, name):
        if obj is None:
            return None
        f = self.get_reflected_field(obj.getClass(), name)
        if f is None:
            return None
        try:
            return int(f.getInt(obj))
        except:
            try:
                return int(f.get(obj))
            except:
                return None

    def get_named_mask(self, name, default):
        val = self._mask_cache.get(name)
        if val is not None:
            return val
        val = default
        try:
            mc_class = self.MessagesControllerClass or find_class(
                "org.telegram.messenger.MessagesController")
            if mc_class is not None:
                f = mc_class.getDeclaredField(name)
                f.setAccessible(True)
                val = int(f.get(None))
        except:
            pass
        self._mask_cache[name] = val
        return val

    def _register(self, ref, feature=None):
        if not ref:
            return False
        self._hooks.append(ref)
        if feature is not None:
            self._feature_hooks.setdefault(feature, []).append(ref)
        return True

    def _drop_feature(self, feature):
        for ref in self._feature_hooks.pop(feature, ()):
            try:
                self.unhook_method(ref)
            except:
                pass
            try:
                self._hooks.remove(ref)
            except ValueError:
                pass

    def hook_dialogs_activity(self):
        try:
            cls_obj = get_java_class("org.telegram.ui.DialogsActivity")
            if not cls_obj:
                return
            m = safe_get_method(cls_obj, "onResume")
            if m:
                self._register(self.hook_method(m, _DialogsActivityResumeHook(self)))
        except:
            log_exception("hook_dialogs_activity")

    def hook_theme_rebuild(self):
        if self._theme_hooks_done:
            return
        try:
            cls_obj = get_java_class("org.telegram.ui.ActionBar.Theme")
            if not cls_obj:
                return
            hook = _ThemeRebuiltHook(self)
            context_cls = get_java_class("android.content.Context")
            bool_type = find_class("java.lang.Boolean").TYPE

            m = safe_get_method(cls_obj, "createDialogsResources", context_cls)
            if m:
                self._register(self.hook_method(m, hook))
            m = safe_get_method(cls_obj, "refreshThemeColors", bool_type, bool_type)
            if m is None:
                m = safe_get_method(cls_obj, "refreshThemeColors")
            if m:
                self._register(self.hook_method(m, hook))
            m = safe_get_method(cls_obj, "applyDialogsTheme")
            if m:
                self._register(self.hook_method(m, hook))
            self._theme_hooks_done = True
        except:
            log_exception("hook_theme_rebuild")

    def install_hooks(self):
        self.hook_dialog_cell()
        if self._enabled_cached and self._online_border_cached:
            self.hook_is_online()
        else:
            self._drop_feature("online")

    def dialog_cell_class(self):
        cls_obj = get_java_class("org.telegram.ui.Cells.DialogCell")
        if not cls_obj:
            cls_obj = get_java_class("org.telegram.ui.cells.DialogCell")
        return cls_obj

    def hook_dialog_cell(self):
        try:
            cls_obj = self.dialog_cell_class()
            if not cls_obj:
                return
            canvas_cls = get_java_class("android.graphics.Canvas")

            if not self._dialog_cell_hooked:
                curr = cls_obj
                m = None
                for _ in range(5):
                    if curr is None:
                        break
                    m = safe_get_method(curr, "onDraw", canvas_cls)
                    if m is not None:
                        break
                    try:
                        curr = curr.getSuperclass()
                    except:
                        break
                if m is not None:
                    if self._register(self.hook_method(m, _DialogCellDrawHook(self))):
                        self._dialog_cell_hooked = True

            if not self._dialog_update_hooked:
                IntTYPE = find_class("java.lang.Integer").TYPE
                BoolTYPE = find_class("java.lang.Boolean").TYPE
                m_update = safe_get_method(cls_obj, "update", IntTYPE, BoolTYPE)
                if m_update is None:
                    m_update = safe_get_method(cls_obj, "update", IntTYPE)
                if m_update:
                    if self._register(self.hook_method(m_update, _DialogCellUpdateHook(self))):
                        self._dialog_update_hooked = True
        except:
            log_exception("hook_dialog_cell")

    def hook_is_online(self):
        if "online" in self._feature_hooks:
            return
        try:
            cls_obj = self.dialog_cell_class()
            if not cls_obj:
                return
            m = safe_get_method(cls_obj, "isOnline")
            if m is not None:
                self._register(self.hook_method(m, _DialogCellIsOnlineHook(self)), "online")
        except:
            log_exception("hook_is_online")

    def store_state(self, state):
        self._cell_states[state.hash] = state
        self._state_order.append(state.hash)
        while len(self._state_order) > CELL_STATE_LIMIT:
            old_hash = self._state_order.pop(0)
            old = self._cell_states.pop(old_hash, None)
            if old is not None and old is not state:
                self.restore_cell_configuration(old)
        return state

    def new_state(self, cell, cell_hash):
        return self.store_state(_CellState(cell, cell_hash))

    def clear_visual_cache(self, state):
        state.entry = None
        state.solid_paint = None
        state.fade_from = None
        state.fade_start = None
        state.fade_pending = False
        state.settled = False
        state.next_probe = 0.0
        state.pending_probes = 0
        state.small_since = 0.0
        state.bmp_id = 0
        state.image_key = None
        state.style_epoch = -1
        state.geo_gid = -1

    def configure_cell(self, cell, state):
        cls = cell.getClass()
        suppress_fields, separator_fields = self.get_class_profile(cls)

        if not state.bg_saved:
            try:
                state.orig_background = cell.getBackground()
            except:
                state.orig_background = None
            state.bg_saved = True
        try:
            cell.setBackground(None)
        except:
            pass

        for f in suppress_fields:
            try:
                f.setBoolean(cell, False)
            except:
                pass

        if state.separators is None:
            active = []
            for f in separator_fields:
                try:
                    if bool(f.getBoolean(cell)):
                        active.append(f)
                    f.setBoolean(cell, False)
                except:
                    pass
            state.separators = tuple(active)
        else:
            for f in separator_fields:
                try:
                    f.setBoolean(cell, False)
                except:
                    pass

        state.configured = True

    def restore_cell_configuration(self, state):
        cell = state.cell
        if cell is None:
            return
        orig = state.avatar_orig
        if orig is not None:
            receiver = state.receiver
            if receiver is not None:
                try:
                    receiver.setImageCoords(float(orig[0]), float(orig[1]),
                                            float(orig[2]), float(orig[3]))
                except:
                    pass
            state.avatar_orig = None
            state.avatar_target_w = None

        if state.separators:
            for f in state.separators:
                try:
                    f.setBoolean(cell, True)
                except:
                    pass
        state.separators = None

        if state.bg_saved:
            state.bg_saved = False
            try:
                cell.setBackground(state.orig_background)
            except:
                pass
            state.orig_background = None

        state.configured = False
        try:
            cell.postInvalidate()
        except:
            pass

    def prune_detached_cells(self):
        for cell_hash in tuple(self._cell_states.keys()):
            state = self._cell_states.get(cell_hash)
            if state is None or state.cell is None:
                continue
            try:
                if bool(state.cell.isAttachedToWindow()):
                    continue
            except:
                continue
            self._cell_states.pop(cell_hash, None)
            try:
                self._state_order.remove(cell_hash)
            except ValueError:
                pass
            state.cell = None
            state.receiver = None
            state.entry = None
            state.fade_from = None

    def restore_all_cells(self):
        for state in tuple(self._cell_states.values()):
            try:
                self.restore_cell_configuration(state)
            except:
                pass

    def invalidate_all_cells(self):
        for state in tuple(self._cell_states.values()):
            cell = state.cell
            if cell is not None:
                try:
                    cell.postInvalidate()
                except:
                    pass

    def apply_avatar_scale(self, cell, state):
        receiver = state.receiver
        if receiver is None:
            receiver = self.get_avatar_receiver(cell)
            state.receiver = receiver
            if receiver is None:
                return
        try:
            cur_w = float(receiver.getImageWidth())
        except:
            return
        if cur_w <= 0.0:
            return
        target = state.avatar_target_w
        if target is not None and abs(cur_w - target) < 0.5:
            return
        try:
            cur_h = float(receiver.getImageHeight())
            if cur_h <= 0.0:
                return
            x = float(receiver.getImageX())
            y = float(receiver.getImageY())
            new_w = cur_w * AVATAR_SCALE
            new_h = cur_h * AVATAR_SCALE
            receiver.setImageCoords(x + (cur_w - new_w) / 2.0,
                                    y + (cur_h - new_h) / 2.0,
                                    new_w, new_h)
            state.avatar_orig = (x, y, cur_w, cur_h)
            state.avatar_target_w = new_w
        except:
            pass

    def on_cell_updated(self, cell, args):
        if cell is None:
            return
        cell_hash = System.identityHashCode(cell)
        state = self._cell_states.get(cell_hash)
        if state is None:
            state = self.new_state(cell, cell_hash)

        dialog_id = self.get_dialog_id(cell)
        mask = 0
        try:
            if args is not None and len(args) > 0:
                mask = int(args[0])
        except:
            mask = 0

        if mask and (mask & self.get_named_mask("UPDATE_MASK_STATUS", 4)):
            self._user_expires_cache.pop(dialog_id, None)

        avatar_changed = bool(mask) and bool(mask & self.get_named_mask("UPDATE_MASK_AVATAR", 2))
        if state.dialog_id != dialog_id or avatar_changed:
            self.clear_visual_cache(state)
            state.receiver = None
            state.avatar_target_w = None

        state.cell = cell
        state.dialog_id = dialog_id
        state.configured = False
        state.next_probe = 0.0
        self.refresh_state_flags(state, cell, dialog_id)
        self.apply_avatar_scale(cell, state)

    def refresh_state_flags(self, state, cell, dialog_id):
        self_id = self.get_self_user_id()
        if self_id > 0 and dialog_id == self_id:
            special = "saved"
        elif dialog_id == 1 or dialog_id == 0x2000000000000000 or self.is_folder_dialog_id(dialog_id):
            special = "archive"
        elif dialog_id == 1271266957:
            special = "replies"
        else:
            special = None

        state.special = special
        state.is_muted = self.is_dialog_muted(cell, dialog_id)
        if special is not None or not self._online_border_cached:
            state.is_online = False
        else:
            state.is_online = self.is_user_online(dialog_id)

    def on_cell_before_draw(self, param):
        try:
            cell = param.thisObject
            canvas = param.args[0]
            if cell is None or canvas is None:
                return

            now = time.monotonic()
            if now - self._last_theme_check >= THEME_CHECK_INTERVAL:
                self._last_theme_check = now
                self.check_theme()

            cell_hash = System.identityHashCode(cell)
            state = self._cell_states.get(cell_hash)
            if state is None:
                state = self.new_state(cell, cell_hash)
                state.dialog_id = self.get_dialog_id(cell)
                self.refresh_state_flags(state, cell, state.dialog_id)
            state.cell = cell

            w = cell.getMeasuredWidth()
            h = cell.getMeasuredHeight()
            if w <= 0 or h <= 0:
                return

            geo = self.get_geometry(w, h)

            if not state.configured:
                self.configure_cell(cell, state)
            self.apply_avatar_scale(cell, state)
            self.draw_card_background(canvas, state, geo, now)

            state.geo = geo
            self._current_state = state
        except:
            log_exception("cell_before_draw")

    def on_cell_after_draw(self, param, state):
        geo = state.geo
        if geo is None:
            return

        muted = state.is_muted
        online = state.is_online
        if not self._mute_dim_cached:
            muted = False
        elif muted:
            online = False
        if not (muted or online):
            return

        canvas = param.args[0]
        if online:
            fill_paint = self._paint_online_fill
            stroke_paint = self._paint_online_stroke
            draw_stroke = True
        else:
            fill_paint = self._paint_muted_fill
            stroke_paint = self._paint_muted_stroke
            draw_stroke = self._mute_stroke_cached
        draw_stroke = draw_stroke and self._stroke_width_cached > 0.0

        canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                             geo.radius, geo.radius, fill_paint)
        if draw_stroke:
            canvas.drawRoundRect(geo.ss_l, geo.ss_t, geo.ss_r, geo.ss_b,
                                 geo.radius, geo.radius, stroke_paint)

    def draw_card_background(self, canvas, state, geo, now):
        epoch = self._style_epoch
        if state.style_epoch != epoch or state.geo_gid != geo.gid:
            self.clear_visual_cache(state)
            state.style_epoch = epoch
            state.geo_gid = geo.gid

        radius = geo.radius

        if state.special is not None:
            entry = state.entry
            if entry is None:
                entry = self.get_special_entry(state.special, geo)
                state.entry = entry
            if entry is not None:
                canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                     radius, radius, entry[1])
            if geo.draw_stroke:
                canvas.drawRoundRect(geo.cs_l, geo.cs_t, geo.cs_r, geo.cs_b,
                                     radius, radius, geo.stroke_paint)
            return

        if not state.settled and now >= state.next_probe:
            pending = self.probe_avatar(state, geo, now)
            if pending:
                state.pending_probes += 1
                if state.pending_probes > PENDING_PROBE_LIMIT:
                    pending = False
            else:
                state.pending_probes = 0
            state.next_probe = now + (PROBE_INTERVAL_PENDING if pending
                                      else PROBE_INTERVAL_IDLE)
            if pending:
                self.schedule_frame(state.cell)

        entry = state.entry
        if entry is None:
            self.draw_solid_background(canvas, state, geo)
            state.fade_pending = True
        else:
            fade_start = state.fade_start
            if fade_start is None:
                canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                     radius, radius, entry[1])
            else:
                progress = (now - fade_start) / FADE_DURATION
                if progress >= 1.0:
                    state.fade_start = None
                    state.fade_from = None
                    canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                         radius, radius, entry[1])
                else:
                    if progress < 0.0:
                        progress = 0.0
                    previous = state.fade_from
                    if previous is None:
                        self.draw_solid_background(canvas, state, geo)
                    else:
                        canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                             radius, radius, previous[1])
                    eased = progress * (2.0 - progress)
                    paint = self._paint_fade
                    paint.setShader(entry[0])
                    paint.setAlpha(int(255.0 * eased))
                    canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                         radius, radius, paint)
                    paint.setAlpha(255)
                    self.schedule_frame(state.cell)

        muted = state.is_muted
        online = state.is_online
        if not self._mute_dim_cached:
            muted = False
        elif muted:
            online = False
        if geo.draw_stroke and not (muted or online):
            canvas.drawRoundRect(geo.cs_l, geo.cs_t, geo.cs_r, geo.cs_b,
                                 radius, radius, geo.stroke_paint)

    def draw_solid_background(self, canvas, state, geo):
        paint = state.solid_paint
        if paint is None:
            paint = self.get_solid_paint(self.get_placeholder_color(state.dialog_id))
            state.solid_paint = paint
        canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                             geo.radius, geo.radius, paint)

    def get_solid_paint(self, color):
        paint = self._solid_paints.get(color)
        if paint is not None:
            return paint
        paint = Paint()
        paint.setAntiAlias(True)
        paint.setStyle(STYLE_FILL)
        paint.setColor(to_jint(color))
        self._solid_paints[color] = paint
        self._solid_order.append(color)
        while len(self._solid_order) > SOLID_PAINT_LIMIT:
            old = self._solid_order.pop(0)
            if old != color:
                self._solid_paints.pop(old, None)
        return paint

    def schedule_frame(self, cell):
        if cell is None:
            return
        if self._invalidate_mode != 2:
            try:
                cell.postInvalidateOnAnimation()
                self._invalidate_mode = 1
                return
            except:
                self._invalidate_mode = 2
        try:
            cell.postInvalidate()
        except:
            pass

    def make_shader(self, bmp, geo):
        shader = BitmapShader(bmp, TILE_MIRROR, TILE_MIRROR)
        matrix = Matrix()
        bw = bmp.getWidth()
        bh = bmp.getHeight()
        if bw <= 0 or bh <= 0:
            return None
        scale = max(geo.card_w / float(bw), geo.card_h / float(bh))
        dx = geo.left + (geo.card_w - bw * scale) / 2.0
        dy = geo.top + (geo.card_h - bh * scale) / 2.0
        matrix.postScale(float(scale), float(scale))
        matrix.postTranslate(float(dx), float(dy))
        shader.setLocalMatrix(matrix)
        return shader

    def store_entry(self, key, entry):
        self._shader_cache[key] = entry
        self._shader_order.append(key)
        while len(self._shader_order) > SHADER_CACHE_LIMIT:
            old = self._shader_order.pop(0)
            if old != key:
                self._shader_cache.pop(old, None)
        return entry

    def get_shader_entry(self, key, bmp, geo):
        ck = (key, geo.w, geo.h)
        entry = self._shader_cache.get(ck)
        if entry is not None:
            return entry
        try:
            shader = self.make_shader(bmp, geo)
        except:
            log_exception("make_shader")
            return None
        if shader is None:
            return None
        paint = Paint()
        paint.setAntiAlias(True)
        paint.setStyle(STYLE_FILL)
        paint.setShader(shader)
        return self.store_entry(ck, (shader, paint))

    def read_image_key(self, receiver):
        if self._imagekey_mode == 2:
            return None
        try:
            raw = receiver.getImageKey()
            self._imagekey_mode = 1
            return None if raw is None else str(raw)
        except:
            self._imagekey_mode = 2
            return None

    def probe_avatar(self, state, geo, now):
        receiver = state.receiver
        if receiver is None:
            receiver = self.get_avatar_receiver(state.cell)
            state.receiver = receiver
            if receiver is None:
                return False

        bmp = self.get_receiver_bitmap(receiver)
        if bmp is None:
            return False

        try:
            bmp_id = int(System.identityHashCode(bmp))
        except:
            bmp_id = 0

        if bmp_id and bmp_id == state.bmp_id and state.entry is not None:
            return False

        try:
            src_w = int(bmp.getWidth())
        except:
            src_w = 0

        if src_w < self._settled_min_w:
            if state.entry is not None:
                return False
            if state.small_since == 0.0:
                state.small_since = now
            if now - state.small_since < SMALL_SOURCE_GRACE:
                return True
        else:
            state.small_since = 0.0

        if bmp_id != state.bmp_id or state.image_key is None:
            state.image_key = self.read_image_key(receiver)
            state.bmp_id = bmp_id

        epoch = self._style_epoch
        image_key = state.image_key

        if image_key:
            key = ("i", epoch, image_key, src_w)
        else:
            key = ("d", epoch, int(state.dialog_id or 0), bmp_id, src_w)

        cached = self._blur_cache.get(key)
        if cached is None:
            self.request_blur(key, bmp, now, epoch)
            return True

        state.bmp_id = bmp_id
        entry = self.get_shader_entry(key, cached, geo)
        if entry is not None and entry is not state.entry:
            if state.entry is not None or state.fade_pending:
                state.fade_from = state.entry
                state.fade_start = now
            state.fade_pending = False
            state.entry = entry
        if entry is not None and src_w >= self._settled_min_w:
            state.settled = True
        return state.entry is None

    def snapshot_allowed(self, now):
        if now - self._snap_window >= SNAPSHOT_WINDOW:
            self._snap_window = now
            self._snap_count = 0
        if self._snap_count >= SNAPSHOTS_PER_FRAME:
            return False
        self._snap_count += 1
        return True

    def wake_pending_cells(self):
        for state in tuple(self._cell_states.values()):
            if state.entry is not None:
                continue
            cell = state.cell
            if cell is None:
                continue
            state.next_probe = 0.0
            state.pending_probes = 0
            try:
                cell.postInvalidate()
            except:
                pass

    def snapshot_bitmap(self, src):
        try:
            if src is None or src.isRecycled():
                return None
            src_w = int(src.getWidth())
            src_h = int(src.getHeight())
            if src_w <= 0 or src_h <= 0:
                return None
            out = Bitmap.createScaledBitmap(src, BLUR_SIZE, BLUR_SIZE, True)
            if out is None or out.isRecycled():
                return None
            same = False
            try:
                same = System.identityHashCode(out) == System.identityHashCode(src)
            except:
                pass
            mutable = True
            try:
                mutable = bool(out.isMutable())
            except:
                pass
            if same or not mutable:
                out = out.copy(CFG_ARGB, True)
                if out is None or out.isRecycled():
                    return None
            return out
        except:
            return None

    def request_blur(self, key, src_bmp, now, epoch):
        executor = self._executor
        if executor is None:
            return
        with self._lock:
            if key in self._blur_inflight or len(self._blur_inflight) >= BLUR_QUEUE_LIMIT:
                return

        if not self.snapshot_allowed(now):
            return

        snapshot = self.snapshot_bitmap(src_bmp)
        if snapshot is None:
            return

        with self._lock:
            if key in self._blur_inflight:
                return
            self._blur_inflight.add(key)

        try:
            executor.submit(self._blur_task, key, snapshot,
                            self._blur_radius_cached, self._tint_color,
                            self._lifecycle_generation, epoch)
        except:
            with self._lock:
                self._blur_inflight.discard(key)

    def _blur_task(self, key, bmp, radius, tint_color, generation, epoch):
        try:
            if generation != self._lifecycle_generation or epoch != self._style_epoch:
                return
            effective = max(1, min(25, int(radius)))
            Utilities.stackBlurBitmap(bmp, effective)
            if tint_color is not None:
                Canvas(bmp).drawColor(to_jint(tint_color))
            if generation != self._lifecycle_generation or epoch != self._style_epoch:
                return
            with self._lock:
                cache = self._blur_cache
                order = self._blur_order
                cache[key] = bmp
                order.append(key)
                while len(order) > BLUR_CACHE_LIMIT:
                    old = order.pop(0)
                    if old != key:
                        cache.pop(old, None)
        except:
            log_exception("blur_task")
        finally:
            with self._lock:
                self._blur_inflight.discard(key)
            self.wake_pending_cells()

    def get_placeholder_color(self, dialog_id):
        color = self._placeholder_color_cache.get(dialog_id)
        if color is not None:
            return color
        base = COLOR_BG_DARK
        try:
            if self.AvatarDrawableClass is None:
                self.cache_classes()
            if self.AvatarDrawableClass is not None:
                base = to_signed32(self.AvatarDrawableClass.getColorForId(dialog_id))
        except:
            base = COLOR_BG_DARK

        value = base & 0xFFFFFFFF
        keep = 0.18 * (1.0 - self._darken_percent_cached / 100.0)
        r = int(((value >> 16) & 0xFF) * keep)
        g = int(((value >> 8) & 0xFF) * keep)
        b = int((value & 0xFF) * keep)
        color = argb_to_signed(255, r, g, b)

        if len(self._placeholder_color_cache) > 256:
            self._placeholder_color_cache = {}
        self._placeholder_color_cache[dialog_id] = color
        return color

    def get_special_entry(self, kind, geo):
        colors = SPECIAL_COLORS.get(kind)
        if colors is None:
            return None
        key = ("special", kind, geo.w, geo.h)
        entry = self._shader_cache.get(key)
        if entry is not None:
            return entry
        span = max(geo.card_w, geo.card_h)
        x0 = geo.left + (geo.card_w - span) / 2.0
        y0 = geo.top + (geo.card_h - span) / 2.0
        try:
            shader = LinearGradient(float(x0), float(y0),
                                    float(x0 + span), float(y0 + span),
                                    create_int_array([colors[0], colors[1]]),
                                    None, TILE_CLAMP)
        except:
            log_exception("special_shader")
            return None
        paint = Paint()
        paint.setAntiAlias(True)
        paint.setStyle(STYLE_FILL)
        paint.setShader(shader)
        return self.store_entry(key, (shader, paint))

    def current_account(self):
        try:
            if self.UserConfigClass is None:
                self.cache_classes()
            if self.UserConfigClass is not None:
                return int(self.UserConfigClass.selectedAccount)
        except:
            pass
        return -1

    def sync_account(self):
        acc = self.current_account()
        if acc == self._account:
            return acc
        self._account = acc
        self._self_user_id = None
        self._messages_controller = None
        self._connections_manager = None
        self._user_expires_cache = {}
        self._cached_server_time = 0
        self._last_server_time_update = 0.0
        self._mc_mute_mode = 0
        self._mc_user_mode = 0
        for state in tuple(self._cell_states.values()):
            state.special = None
            state.is_muted = False
            state.is_online = False
            self.clear_visual_cache(state)
        log_msg("account -> " + str(acc))
        return acc

    def get_self_user_id(self):
        acc = self.sync_account()
        if self._self_user_id is not None:
            return self._self_user_id
        user_id = 0
        try:
            if acc >= 0 and self.UserConfigClass is not None:
                user_id = int(self.UserConfigClass.getInstance(acc).getClientUserId())
        except:
            user_id = 0
        self._self_user_id = user_id
        return user_id

    def is_folder_dialog_id(self, dialog_id):
        if dialog_id is None:
            return False
        if isinstance(dialog_id, (int, float)) and 0 < dialog_id < 100:
            return True
        try:
            val = int(dialog_id)
            if val <= 0:
                return False
            return (val & 0x2000000000000000) != 0 and (val & 0x8000000000000000) == 0
        except (ValueError, TypeError):
            return False

    def get_dialog_id(self, cell):
        if cell is None:
            return 0
        if self._dialogid_mode != 2:
            try:
                val = cell.getDialogId()
                self._dialogid_mode = 1
                if val is not None and val != 0:
                    return int(val) if isinstance(val, (int, float)) else int(val.longValue())
            except:
                self._dialogid_mode = 2
        f = self.find_first_field(cell.getClass(), DIALOG_ID_FIELD_NAMES)
        if f is not None:
            try:
                val = f.get(cell)
                if val is not None and val != 0:
                    return int(val) if isinstance(val, (int, float)) else int(val.longValue())
            except:
                pass
        return 0

    def get_avatar_receiver(self, cell):
        if cell is None:
            return None
        f = self.find_first_field(cell.getClass(), AVATAR_FIELD_NAMES)
        if f is not None:
            try:
                val = f.get(cell)
                if is_image_receiver_instance(val):
                    return val
            except:
                pass
        for name in AVATAR_FIELD_NAMES:
            try:
                val = getattr(cell, name, None)
                if is_image_receiver_instance(val):
                    return val
            except:
                pass
        return None

    def get_receiver_bitmap(self, receiver):
        if receiver is None:
            return None
        if self._bitmap_mode != 2:
            try:
                bmp = receiver.getBitmap()
                self._bitmap_mode = 1
                if bmp is not None and not bmp.isRecycled():
                    return bmp
                return None
            except:
                self._bitmap_mode = 2
        try:
            drawable = receiver.getDrawable()
            if isinstance(drawable, BitmapDrawable):
                bmp = drawable.getBitmap()
                if bmp is not None and not bmp.isRecycled():
                    return bmp
        except:
            pass
        return None

    def get_messages_controller(self):
        if self._messages_controller is not None:
            return self._messages_controller
        acc = self.sync_account()
        if acc < 0 or self.MessagesControllerClass is None:
            return None
        try:
            self._messages_controller = self.MessagesControllerClass.getInstance(acc)
            return self._messages_controller
        except:
            return None

    def mc_is_muted(self, dialog_id):
        if self._mc_mute_mode == 3:
            return False
        mc = self.get_messages_controller()
        if mc is None:
            return False
        if self._mc_mute_mode in (0, 1):
            try:
                result = bool(mc.isDialogMuted(dialog_id))
                self._mc_mute_mode = 1
                return result
            except:
                if self._mc_mute_mode == 1:
                    return False
                self._mc_mute_mode = 2
        try:
            result = bool(mc.isDialogMuted(dialog_id, 0))
            self._mc_mute_mode = 2
            return result
        except:
            self._mc_mute_mode = 3
            return False

    def mc_get_user(self, dialog_id):
        if self._mc_user_mode == 3:
            return None
        mc = self.get_messages_controller()
        if mc is None:
            return None
        if self._mc_user_mode in (0, 1):
            try:
                user = mc.getUser(dialog_id)
                self._mc_user_mode = 1
                return user
            except:
                if self._mc_user_mode == 1:
                    return None
                self._mc_user_mode = 2
        try:
            LongClass = find_class("java.lang.Long")
            user = mc.getUser(LongClass(dialog_id))
            self._mc_user_mode = 2
            return user
        except:
            self._mc_user_mode = 3
            return None

    def get_server_time(self):
        cm = self._connections_manager
        if cm is None:
            acc = self.sync_account()
            if acc >= 0:
                try:
                    CM = find_class("org.telegram.tgnet.ConnectionsManager")
                    cm = CM.getInstance(acc)
                    self._connections_manager = cm
                except:
                    cm = None
        if cm is not None:
            try:
                return int(cm.getCurrentTime())
            except:
                pass
        return int(time.time())

    def get_cached_server_time(self):
        now = time.time()
        if self._cached_server_time == 0 or (now - self._last_server_time_update) > 1.0:
            self._cached_server_time = self.get_server_time()
            self._last_server_time_update = now
        return self._cached_server_time

    def get_user_expires(self, dialog_id):
        if dialog_id is None or dialog_id <= 0:
            return 0
        now = time.time()
        cached = self._user_expires_cache.get(dialog_id)
        if cached is not None and (now - cached[1]) < 10.0:
            return cached[0]

        expires = 0
        try:
            user = self.mc_get_user(dialog_id)
            if user is not None and not self.get_bool_field(user, "bot"):
                status = self.get_object_field(user, "status")
                if status is not None:
                    name = str(status.getClass().getSimpleName())
                    if "StatusOnline" in name:
                        value = self.get_int_field(status, "expires")
                        expires = int(value) if value is not None else int(
                            self.get_cached_server_time() + 300)
        except:
            pass

        if len(self._user_expires_cache) > EXPIRES_CACHE_LIMIT:
            self._user_expires_cache = {}
        self._user_expires_cache[dialog_id] = (expires, now)
        return expires

    def is_user_online(self, dialog_id):
        self_id = self.get_self_user_id()
        if (self_id > 0 and dialog_id == self_id) or dialog_id in (777000, 1271266957, 1):
            return False
        expires = self.get_user_expires(dialog_id)
        if expires == 0:
            return False
        return expires > self.get_cached_server_time()

    def is_dialog_muted(self, cell, dialog_id):
        if dialog_id is None:
            return False
        if cell is not None:
            f = self.find_first_field(cell.getClass(), MUTED_FIELD_NAMES, True)
            if f is not None:
                try:
                    if bool(f.getBoolean(cell)):
                        return True
                except:
                    pass
        return self.mc_is_muted(dialog_id)


Plugin = PremiumDialogCardsPlugin