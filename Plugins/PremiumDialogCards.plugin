import time
import weakref
import traceback
import threading
from collections import OrderedDict
from concurrent.futures import ThreadPoolExecutor

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from android_utils import log

from android.graphics import (
    Bitmap, LinearGradient, Paint, Shader, Matrix, BitmapShader, Path, RectF, Canvas
)
from android.graphics.drawable import BitmapDrawable
from org.telegram.messenger import AndroidUtilities, Utilities
from ui.settings import Header, Switch, Input

try:
    from java.lang import System, Integer
except:
    System = find_class("java.lang.System")
    Integer = None

try:
    from java import jarray, jint
except:
    jarray = None
    jint = None

# константы
CARD_ROUNDING_DP = 15.0
CARD_MARGIN_X_DP = 6.0
CARD_MARGIN_Y_DP = 5.0
CARD_STROKE_WIDTH_CLASSIC_DP = 0.5
CARD_STROKE_WIDTH_STATUS_DP = 0.8
AVATAR_SCALE = 0.75
BLUR_CACHE_LIMIT = 128
BLUR_QUEUE_LIMIT = 32
CELL_STATE_CACHE_LIMIT = 256

# цвета
COLOR_BG_DARK = -13881276
COLOR_WHITE_TOP = 1023410175
COLOR_ONLINE_BORDER = -5184120
COLOR_ONLINE_FILL = 649127304
COLOR_MUTED_BORDER = -1086110389
COLOR_MUTED_FILL = -1188286397

_last_error_log = {}

def log_msg(msg):
    try:
        log("[PremiumCards] " + str(msg))
    except:
        pass

def log_exception(label):
    try:
        now = time.monotonic()
        if now - _last_error_log.get(label, 0.0) < 5.0:
            return
        _last_error_log[label] = now
        err_msg = traceback.format_exc()
        log_msg("EXCEPTION [" + str(label) + "]: " + str(err_msg))
    except:
        pass

def to_jint(val):
    if jint is not None:
        try: return jint(val)
        except: pass
    if Integer is not None:
        try: return Integer(int(val))
        except: pass
    try:
        IntegerClass = find_class("java.lang.Integer")
        if IntegerClass is not None:
            return IntegerClass(int(val))
    except:
        pass
    return int(val)

def argb_to_signed(a, r, g, b):
    val = ((a & 0xFF) << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF)
    if val >= 0x80000000:
        val -= 0x100000000
    return val

def get_java_class(class_name):
    try:
        ClassClass = find_class("java.lang.Class")
        if ClassClass is None:
            return None
        return ClassClass.forName(class_name)
    except:
        try:
            ClassClass = find_class("java.lang.Class")
            ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")
            loader = ApplicationLoader.applicationContext.getClassLoader()
            return ClassClass.forName(class_name, True, loader)
        except:
            return None

def safe_get_method(java_class_obj, name, *params):
    try:
        m = java_class_obj.getDeclaredMethod(name, *params)
        m.setAccessible(True)
        return m
    except:
        return None

def is_image_receiver_instance(obj):
    if obj is None: return False
    try:
        cls_name = obj.getClass().getName()
        if "ImageReceiver" in cls_name: return True
        if hasattr(obj, "setImageCoords") and hasattr(obj, "draw"): return True
    except: pass
    return False

def create_int_array(list_val):
    if jarray is not None and jint is not None:
        try:
            return jarray(jint)(list_val)
        except:
            pass
    try:
        IntTYPE = find_class("java.lang.Integer").TYPE
        ArrayClass = find_class("java.lang.reflect.Array")
        arr = ArrayClass.newInstance(IntTYPE, len(list_val))
        for i, val in enumerate(list_val):
            try:
                ArrayClass.setInt(arr, i, int(val))
            except:
                pass
        return arr
    except:
        pass
    return list_val

def pseudo_rand(seed, i):
    val = (int(seed) * 1103515245 + int(i) * 12345 + 12345) & 0x7FFFFFFF
    return float(val) / 2147483647.0

class _DialogsActivityResumeHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)
    def after_hooked_method(self, param):
        p = self.p()
        if p is None: return
        try:
            p.hook_dialog_cell()
            p.hook_checkmark_drawables()
        except:
            log_exception("DialogsActivityResumeHook")

class _DialogCellDrawHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)
    def before_hooked_method(self, param):
        p = self.p()
        if p is None: return
        try:
            cell = param.thisObject
            if cell is None or not p._enabled_cached: return
            p._is_drawing_dialog_cell = True
            p.on_cell_before_draw(param)
        except:
            log_exception("DialogCell before hook")

    def after_hooked_method(self, param):
        p = self.p()
        if p is None: return
        try:
            cell = param.thisObject
            if cell is None: return
            p.on_cell_after_draw(param)
        except:
            log_exception("DialogCell after hook")
        finally:
            p._is_drawing_dialog_cell = False

class _CheckmarkDrawHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def before_hooked_method(self, param):
        p = self.p()
        if p is None or not p._is_drawing_dialog_cell or not p._enabled_cached:
            return
        try:
            drawable = param.thisObject
            if drawable is not None and System.identityHashCode(drawable) in p._checkmark_drawable_ids:
                canvas = param.args[0]
                if canvas is not None:
                    bounds = drawable.getBounds()
                    cx = float(bounds.centerX())
                    cy = float(bounds.centerY())
                    shift_x = -float(p.dp(4.0))

                    save_count = int(canvas.save())
                    param.extra = (canvas, save_count)
                    canvas.translate(shift_x, 0.0)
                    canvas.scale(0.80, 0.80, cx, cy)
        except:
            pass

    def after_hooked_method(self, param):
        extra = getattr(param, "extra", None)
        if extra is not None:
            try:
                canvas, save_count = extra
                canvas.restoreToCount(int(save_count))
            except:
                try: extra[0].restore()
                except: pass

class _DialogCellIsOnlineHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)
    def before_hooked_method(self, param):
        p = self.p()
        if p is not None and p._enabled_cached and p._is_drawing_dialog_cell:
            cell = param.thisObject
            if cell is not None:
                dialog_id = p.get_dialog_id(cell)
                self_id = p.get_self_user_id()
                if (self_id > 0 and dialog_id == self_id) or dialog_id == 777000 or dialog_id == 1271266957 or dialog_id == 1 or dialog_id == 0x2000000000000000:
                    param.setResult(False)
                    return
            param.setResult(False)

class _DialogCellUpdateHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def after_hooked_method(self, param):
        p = self.p()
        if p is None: return
        try:
            cell = param.thisObject
            if cell is None: return
            cell_hash = System.identityHashCode(cell)

            dialog_id = p.get_dialog_id(cell)
            mask = int(param.args[0]) if param.args else 0
            if mask != 0 and (mask & p.get_status_update_mask()) != 0:
                p._user_expires_cache.pop(dialog_id, None)

            self_id = p.get_self_user_id()
            is_saved_messages = (self_id > 0 and dialog_id == self_id)
            is_replies = (dialog_id == 777000 or dialog_id == 1271266957)
            is_archive = (dialog_id == 1 or dialog_id == 0x2000000000000000 or p.is_folder_dialog_id(dialog_id))

            is_muted = p.is_dialog_muted(cell, dialog_id)
            is_online = p.is_dialog_cell_online(cell, dialog_id)
            if is_saved_messages or is_replies or is_archive:
                is_online = False

            is_pinned = p.is_dialog_pinned(cell, dialog_id)
            avatar_receiver = p.get_avatar_receiver(cell)

            state = p._cell_states.get(cell_hash)
            if state is None:
                state = {}
                p.store_cell_state(cell_hash, state)

            if state.get("dialog_id") != dialog_id:
                p.clear_cell_visual_cache(state)

            state["cell"] = cell
            state["dialog_id"] = dialog_id
            state["is_muted"] = is_muted
            state["is_online"] = is_online
            state["is_pinned"] = is_pinned
            state["is_saved_messages"] = is_saved_messages
            state["is_replies"] = is_replies
            state["is_archive"] = is_archive
            state["avatar_receiver"] = avatar_receiver
            state["configured"] = False
            state["last_online_check"] = time.time()
            p.scale_cell_avatar(cell, state)
        except:
            pass

class PremiumDialogCardsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hooks = []
        self._blur_cache = OrderedDict()
        self._cache_lock = threading.Lock()

        self._cell_states = OrderedDict()
        self._user_expires_cache = {}
        self._cached_server_time = 0
        self._last_server_time_update = 0.0

        self._bg_paint = None
        self._overlay_paint = None
        self._stroke_paint = None
        self._clip_path = None
        self._rect_f = None
        self._gradient_cache = {}
        self._dp_cache = {}
        self._classic_bg_color = None

        self._blur_radius_cached = 15
        self._darken_percent_cached = 55
        self._enabled_cached = True
        self._mute_stroke_cached = True
        self._mute_style_normal_cached = False
        self._mute_opacity_cached = 30
        self._hooked_checkmark_classes = set()
        self._checkmark_drawable_ids = set()

        self._placeholder_color_cache = {}
        self._fields_cache = {}
        self._field_type_cache = {}
        self._blurring_ids = set()
        self._blur_waiters = {}
        self._lifecycle_generation = 0
        self._executor = None
        self._dialog_cell_hooked = False
        self._dialog_online_hooked = False
        self._dialog_update_hooked = False
        self._dialog_is_online_method = None
        self._is_drawing_dialog_cell = False

        self.UserConfigClass = None
        self.MessagesControllerClass = None
        self.ThemeClass = None
        self.AvatarDrawableClass = None
        self._messages_controller = None
        self._status_update_mask = None
        self._self_user_id = None

        self._canvas_save_counts = {}
        self._separator_fields = {}

    def get_self_user_id(self) -> int:
        if self._self_user_id is not None:
            return self._self_user_id
        try:
            if self.UserConfigClass is None:
                self.cache_classes()
            if self.UserConfigClass is not None:
                acc = self.UserConfigClass.selectedAccount
                instance = self.UserConfigClass.getInstance(acc)
                self._self_user_id = int(instance.getClientUserId())
                return self._self_user_id
        except:
            pass
        return 0

    def is_folder_dialog_id(self, dialog_id) -> bool:
        if dialog_id is None:
            return False
        if isinstance(dialog_id, (int, float)) and 0 < dialog_id < 100:
            return True
        try:
            val = int(dialog_id)
            if val <= 0:
                return False
            return (val & 0x2000000000000000) != 0 and (val & 0x8000000000000000) == 0
        except (ValueError, TypeError):
            return False

    def store_cell_state(self, cell_hash, state):
        self._cell_states[cell_hash] = state
        while len(self._cell_states) > CELL_STATE_CACHE_LIMIT:
            _, old_state = self._cell_states.popitem(last=False)
            self.restore_cell_configuration(old_state)
        return state

    def clear_cell_visual_cache(self, state):
        for key in (
            "cached_shader", "cached_blurred_bmp", "cached_blur_key",
            "cached_gen_id", "cached_blur_radius", "cached_card_w", "cached_card_h"
        ):
            state.pop(key, None)

    def scale_cell_avatar(self, cell, state):
        if state.get("avatar_scaled", False):
            return
        receiver = state.get("avatar_receiver")
        if receiver is None:
            receiver = self.get_avatar_receiver(cell)
            state["avatar_receiver"] = receiver
        if receiver is not None:
            try:
                old_w = float(receiver.getImageWidth())
                old_h = float(receiver.getImageHeight())
                if old_w > 0.0 and old_h > 0.0:
                    old_x = float(receiver.getImageX())
                    old_y = float(receiver.getImageY())
                    new_w = old_w * AVATAR_SCALE
                    new_h = old_h * AVATAR_SCALE
                    new_x = old_x + (old_w - new_w) / 2.0
                    new_y = old_y + (old_h - new_h) / 2.0
                    state["avatar_coords_orig"] = (old_x, old_y, old_w, old_h)
                    receiver.setImageCoords(float(new_x), float(new_y), float(new_w), float(new_h))
                    state["avatar_scaled"] = True
            except:
                pass

    def restore_cell_avatar(self, cell, state):
        if not state.pop("avatar_scaled", False):
            return
        orig = state.pop("avatar_coords_orig", None)
        receiver = state.get("avatar_receiver")
        if orig is not None and receiver is not None:
            try:
                receiver.setImageCoords(float(orig[0]), float(orig[1]), float(orig[2]), float(orig[3]))
            except:
                pass

    def configure_cell(self, cell, state):
        state["cell"] = cell
        if not state.get("background_suppressed", False):
            try: state["original_background"] = cell.getBackground()
            except: state["original_background"] = None
            state["background_suppressed"] = True
        try: cell.setBackground(None)
        except: pass

        cls = cell.getClass()
        for fn in ("drawBackground", "needBackground", "drawPinBackground", "drawClockBackground", "drawTimeBackground"):
            if self.get_reflected_field(cls, fn) is not None:
                self.set_cell_field_value(cell, fn, False)

        if "separator_restore" not in state:
            field_names = self._separator_fields.get(cls)
            if field_names is None:
                names = []
                for field_name in ("useSeparator", "useDivider", "needDivider", "drawSeparator"):
                    if self.get_reflected_field(cls, field_name) is not None:
                        names.append(field_name)
                field_names = tuple(names)
                self._separator_fields[cls] = field_names

            restore_values = []
            for field_name in field_names:
                value = self.get_cell_field_value(cell, field_name)
                if value is not None:
                    restore_values.append((field_name, value))
                    self.set_cell_field_value(cell, field_name, False)
            if restore_values:
                state["separator_restore"] = restore_values

        state["configured"] = True

    def restore_cell_background(self, state):
        if not state.pop("background_suppressed", False):
            return False
        cell = state.get("cell")
        if cell is None:
            state.pop("original_background", None)
            return False
        background = state.pop("original_background", None)
        try: cell.setBackground(background)
        except: pass
        return True

    def restore_cell_separators(self, cell, state):
        for field_name, value in state.pop("separator_restore", ()):
            self.set_cell_field_value(cell, field_name, value)

    def restore_cell_configuration(self, state):
        cell = state.get("cell")
        if cell is None:
            return
        self.restore_cell_avatar(cell, state)
        self.restore_cell_separators(cell, state)
        self.restore_cell_background(state)
        state["configured"] = False
        try: cell.postInvalidate()
        except: pass

    def restore_all_cells(self):
        for state in tuple(self._cell_states.values()):
            self.restore_cell_configuration(state)

    def invalidate_all_cells(self):
        for state in tuple(self._cell_states.values()):
            cell = state.get("cell")
            if cell is not None:
                try: cell.postInvalidate()
                except: pass

    def get_status_update_mask(self):
        if self._status_update_mask is not None:
            return self._status_update_mask
        self._status_update_mask = 1
        try:
            mc_class = self.MessagesControllerClass or find_class("org.telegram.messenger.MessagesController")
            if mc_class is not None:
                field = mc_class.getDeclaredField("UPDATE_MASK_STATUS")
                field.setAccessible(True)
                self._status_update_mask = int(field.get(None))
        except:
            pass
        return self._status_update_mask

    def is_dialog_cell_online(self, cell, dialog_id):
        self_id = self.get_self_user_id()
        if (self_id > 0 and dialog_id == self_id) or dialog_id == 777000 or dialog_id == 1271266957 or dialog_id == 1 or dialog_id == 0x2000000000000000:
            return False

        if cell is not None:
            try:
                value = cell.isOnline()
                try: return bool(value.booleanValue())
                except: return bool(value)
            except:
                pass
            try:
                if self._dialog_is_online_method is not None:
                    value = self._dialog_is_online_method.invoke(cell)
                    try: return bool(value.booleanValue())
                    except: return bool(value)
            except:
                pass
        return self.is_user_online(dialog_id)

    def on_plugin_load(self):
        try:
            log_msg("=== Premium Dialog Cards Load Triggered ===")
            self._lifecycle_generation += 1
            self.restore_all_cells()
            for ref in self._hooks:
                try: self.unhook_method(ref)
                except: pass
            self._hooks.clear()
            if self._executor is not None:
                try: self._executor.shutdown(wait=False, cancel_futures=True)
                except TypeError:
                    try: self._executor.shutdown(wait=False)
                    except: pass
                except: pass
                self._executor = None

            with self._cache_lock:
                self._blur_cache.clear()
                self._blurring_ids.clear()
                self._blur_waiters.clear()
            self._placeholder_color_cache.clear()
            self._fields_cache.clear()
            self._field_type_cache.clear()
            self._canvas_save_counts.clear()
            self._cell_states.clear()
            self._dialog_cell_hooked = False
            self._dialog_online_hooked = False
            self._dialog_update_hooked = False
            self._dialog_is_online_method = None
            self._is_drawing_dialog_cell = False
            self._messages_controller = None
            self._status_update_mask = None
            self._self_user_id = None

            self._user_expires_cache.clear()
            self._cached_server_time = 0
            self._last_server_time_update = 0.0
            self._hooked_checkmark_classes.clear()
            self._checkmark_drawable_ids.clear()
            self._separator_fields.clear()

            self._bg_paint = None
            self._overlay_paint = None
            self._stroke_paint = None
            self._clip_path = None
            self._rect_f = None
            self._gradient_cache.clear()
            self._dp_cache.clear()
            self._classic_bg_color = None

            self.cache_classes()
            self.update_cached_settings()

            self._executor = ThreadPoolExecutor(max_workers=2)

            self.hook_dialogs_activity()
            self.hook_dialog_cell()
            self.hook_checkmark_drawables()
            log_msg("=== Premium Dialog Cards Load Complete ===")
        except:
            log_exception("on_plugin_load")

    def on_plugin_unload(self):
        try:
            log_msg("=== Premium Dialog Cards Unload Triggered ===")
            self._lifecycle_generation += 1
            for ref in self._hooks:
                try: self.unhook_method(ref)
                except: pass
            self._hooks.clear()
            if self._executor is not None:
                try: self._executor.shutdown(wait=False, cancel_futures=True)
                except TypeError:
                    try: self._executor.shutdown(wait=False)
                    except: pass
                except: pass
                self._executor = None

            self.restore_all_cells()
            with self._cache_lock:
                self._blur_cache.clear()
                self._blurring_ids.clear()
                self._blur_waiters.clear()
            self._placeholder_color_cache.clear()
            self._fields_cache.clear()
            self._field_type_cache.clear()
            self._canvas_save_counts.clear()
            self._cell_states.clear()
            self._dialog_cell_hooked = False
            self._dialog_online_hooked = False
            self._dialog_update_hooked = False
            self._dialog_is_online_method = None
            self._is_drawing_dialog_cell = False
            self._status_update_mask = None

            self._user_expires_cache.clear()
            self._cached_server_time = 0
            self._last_server_time_update = 0.0
            self._hooked_checkmark_classes.clear()
            self._checkmark_drawable_ids.clear()
            self._separator_fields.clear()

            self._bg_paint = None
            self._overlay_paint = None
            self._stroke_paint = None
            self._clip_path = None
            self._rect_f = None
            self._gradient_cache.clear()
            self._dp_cache.clear()
            self._classic_bg_color = None

            self.UserConfigClass = None
            self.MessagesControllerClass = None
            self.ThemeClass = None
            self.AvatarDrawableClass = None
            self._messages_controller = None

            log_msg("=== Premium Dialog Cards Unload Complete ===")
        except:
            log_exception("on_plugin_unload")

    def cache_classes(self):
        try: self.UserConfigClass = find_class("org.telegram.messenger.UserConfig")
        except: self.UserConfigClass = None
        try: self.MessagesControllerClass = find_class("org.telegram.messenger.MessagesController")
        except: self.MessagesControllerClass = None
        try: self.ThemeClass = find_class("org.telegram.ui.ActionBar.Theme")
        except: self.ThemeClass = None
        try: self.AvatarDrawableClass = find_class("org.telegram.ui.Components.AvatarDrawable")
        except: self.AvatarDrawableClass = None

    def get_paint_bg(self):
        if self._bg_paint is None:
            self._bg_paint = Paint()
            self._bg_paint.setAntiAlias(True)
            self._bg_paint.setStyle(Paint.Style.FILL)
        self._bg_paint.setShader(None)
        return self._bg_paint

    def get_paint_overlay(self):
        if self._overlay_paint is None:
            self._overlay_paint = Paint()
            self._overlay_paint.setAntiAlias(True)
        self._overlay_paint.setShader(None)
        return self._overlay_paint

    def get_paint_stroke(self):
        if self._stroke_paint is None:
            self._stroke_paint = Paint()
            self._stroke_paint.setAntiAlias(True)
            self._stroke_paint.setStyle(Paint.Style.STROKE)
        self._stroke_paint.setShader(None)
        return self._stroke_paint

    def get_reusable_clip_path(self):
        if self._clip_path is None:
            self._clip_path = Path()
        self._clip_path.reset()
        return self._clip_path

    def get_reusable_rect_f(self, left, top, right, bottom):
        if self._rect_f is None:
            self._rect_f = RectF(float(left), float(top), float(right), float(bottom))
        else:
            self._rect_f.set(float(left), float(top), float(right), float(bottom))
        return self._rect_f

    def get_cached_gradient(self, top, bottom, bg_color):
        cache_key = (float(top), float(bottom), int(bg_color))
        gradient = self._gradient_cache.get(cache_key)
        if gradient is None:
            colors_arr = create_int_array([COLOR_WHITE_TOP, bg_color])
            gradient = LinearGradient(0.0, float(top), 0.0, float(bottom), colors_arr, None, Shader.TileMode.CLAMP)
            self._gradient_cache[cache_key] = gradient
        return gradient

    def get_working_field_name(self, cls, possible_names):
        cache_key = (cls, tuple(possible_names))
        working_name = self._fields_cache.get(cache_key)
        if working_name is None:
            for name in possible_names:
                if self.get_reflected_field(cls, name) is not None:
                    self._fields_cache[cache_key] = name
                    return name
            self._fields_cache[cache_key] = False
            return None
        return working_name if working_name is not False else None

    def get_reflected_field(self, cls, field_name):
        cache_key = (cls, field_name)
        field = self._fields_cache.get(cache_key)
        if field is False:
            return None
        if field is not None:
            return field

        current = cls
        for _ in range(6):
            if current is None:
                break
            try:
                field = current.getDeclaredField(field_name)
                field.setAccessible(True)
                self._fields_cache[cache_key] = field
                return field
            except:
                try: current = current.getSuperclass()
                except: break

        try:
            field = cls.getField(field_name)
            field.setAccessible(True)
            self._fields_cache[cache_key] = field
            return field
        except:
            self._fields_cache[cache_key] = False
            return None

    def _get_bool(self, key, default=False):
        try:
            v = self.get_setting(key, default)
            if v is default: return default
            if isinstance(v, bool): return v
            if isinstance(v, int): return v != 0
            if isinstance(v, str): return v.strip().lower() in ("1", "true", "yes", "on", "y")
            return bool(v)
        except: return default

    def _get_int(self, key, default=0):
        try:
            v = self.get_setting(key, default)
            if v is default: return default
            return int(v)
        except: return default

    def create_settings(self):
        try:
            blur_val = self._get_int("rcards.blur", 15)
            darken_val = self._get_int("rcards.darken", 55)
            mute_opacity_val = self._get_int("rcards.mute_opacity", 30)
            return [
                Header(text="Дизайн карточек чатов (только для темной темы)"),
                Switch(
                    key="rcards.enable",
                    text="Включить дизайн карточек",
                    default=self._get_bool("rcards.enable", True),
                    on_change=lambda v: self._on_setting_changed("rcards.enable", bool(v))
                ),
                Switch(
                    key="rcards.mute_style_normal",
                    text="Обычный вид замьюченных чатов",
                    subtext="Отображать замьюченные чаты без затемнения (как обычные).",
                    default=self._get_bool("rcards.mute_style_normal", False),
                    on_change=lambda v: self._on_setting_changed("rcards.mute_style_normal", bool(v))
                ),
                Switch(
                    key="rcards.mute_stroke",
                    text="Обводка для замьюченных чатов",
                    default=self._get_bool("rcards.mute_stroke", True),
                    on_change=lambda v: self._on_setting_changed("rcards.mute_stroke", bool(v))
                ),
                Input(
                    key="rcards.mute_opacity",
                    text="Яркость замьюченных чатов (0-100%)",
                    subtext="Управляет заметностью при выключенном пункте выше. По умолчанию: 30.",
                    default=str(mute_opacity_val),
                    on_change=lambda v: self._on_setting_changed_int("rcards.mute_opacity", v)
                ),
                Input(
                    key="rcards.blur",
                    text="Сила размытия фона",
                    subtext="Число от 1 до 25. По умолчанию: 15.",
                    default=str(blur_val),
                    on_change=lambda v: self._on_setting_changed_int("rcards.blur", v)
                ),
                Input(
                    key="rcards.darken",
                    text="Сила затемнения (%)",
                    subtext="Число от 0 до 100. По умолчанию: 55.",
                    default=str(darken_val),
                    on_change=lambda v: self._on_setting_changed_int("rcards.darken", v)
                )
            ]
        except:
            log_exception("create_settings")
            return [Header(text="Premium Dialog Cards: ошибка настроек")]

    def update_cached_settings(self):
        self._blur_radius_cached = max(1, min(25, self._get_int("rcards.blur", 15)))
        self._darken_percent_cached = max(0, min(100, self._get_int("rcards.darken", 55)))
        self._enabled_cached = self._get_bool("rcards.enable", True)
        self._mute_stroke_cached = self._get_bool("rcards.mute_stroke", True)
        self._mute_style_normal_cached = self._get_bool("rcards.mute_style_normal", False)
        self._mute_opacity_cached = max(0, min(100, self._get_int("rcards.mute_opacity", 30)))

    def _on_setting_changed(self, key, value):
        try:
            was_enabled = self._enabled_cached
            self.set_setting(key, value)
            self.update_cached_settings()
            with self._cache_lock:
                self._blur_cache.clear()
            if key == "rcards.enable":
                if not self._enabled_cached:
                    self.restore_all_cells()
                elif not was_enabled:
                    for state in self._cell_states.values():
                        state["configured"] = False
            self.invalidate_all_cells()
        except:
            pass

    def _on_setting_changed_int(self, key, value):
        try:
            cleaned = str(value or "").strip()
            if cleaned:
                val = int(cleaned)
            else:
                if key == "rcards.blur": val = 15
                elif key == "rcards.darken": val = 55
                elif key == "rcards.mute_opacity": val = 30
                else: val = 0
            self.set_setting(key, val)
            self.update_cached_settings()
            with self._cache_lock:
                self._blur_cache.clear()
            self.invalidate_all_cells()
        except:
            pass

    def get_cell_field_value(self, obj, field_name):
        if obj is None: return None
        cls = obj.getClass()
        f = self.get_reflected_field(cls, field_name)
        if f is None: return None
        try:
            return f.get(obj)
        except:
            return None

    def set_cell_field_value(self, obj, field_name, value):
        if obj is None: return
        cls = obj.getClass()
        cache_key = (cls, field_name)
        f = self.get_reflected_field(cls, field_name)
        was_set = False
        if f is not None:
            try:
                field_type = self._field_type_cache.get(cache_key)
                if field_type is None:
                    field_type = str(f.getType().getName())
                    self._field_type_cache[cache_key] = field_type
                if field_type == "int":
                    f.setInt(obj, int(round(float(value))))
                elif field_type == "long":
                    f.setLong(obj, int(value))
                elif field_type == "float":
                    f.setFloat(obj, float(value))
                elif field_type == "double":
                    f.setDouble(obj, float(value))
                elif field_type == "boolean":
                    try: bool_value = bool(value.booleanValue())
                    except: bool_value = bool(value)
                    f.setBoolean(obj, bool_value)
                else:
                    f.set(obj, value)
                was_set = True
            except:
                pass
        if not was_set and hasattr(obj, field_name):
            try: setattr(obj, field_name, value)
            except: pass

    def hook_dialogs_activity(self):
        try:
            cls_obj = get_java_class("org.telegram.ui.DialogsActivity")
            if not cls_obj: return
            m = safe_get_method(cls_obj, "onResume")
            if m:
                ref = self.hook_method(m, _DialogsActivityResumeHook(self))
                if ref: self._hooks.append(ref)
        except:
            log_exception("hook_dialogs_activity")

    def hook_checkmark_drawables(self):
        try:
            ThemeClassObj = self.ThemeClass or get_java_class("org.telegram.ui.ActionBar.Theme")
            if not ThemeClassObj: return

            drawables_to_hook = []
            for name in ("dialogs_checkDrawable", "dialogs_halfCheckDrawable", "dialogs_clockDrawable",
                         "dialogs_checkReadDrawable", "dialogs_halfCheckReadDrawable",
                         "dialogs_sentDrawable", "dialogs_receivedDrawable"):
                try:
                    f = ThemeClassObj.getDeclaredField(name)
                    f.setAccessible(True)
                    drawable = f.get(None)
                    if drawable is not None:
                        drawables_to_hook.append(drawable)
                        self._checkmark_drawable_ids.add(System.identityHashCode(drawable))
                except:
                    pass

            for drawable in drawables_to_hook:
                cls = drawable.getClass()
                cls_name = cls.getName()
                if cls_name in self._hooked_checkmark_classes:
                    continue

                canvas_cls = get_java_class("android.graphics.Canvas")
                m = safe_get_method(cls, "draw", canvas_cls)
                if m:
                    ref = self.hook_method(m, _CheckmarkDrawHook(self))
                    if ref:
                        self._hooks.append(ref)
                        self._hooked_checkmark_classes.add(cls_name)
        except:
            log_exception("hook_checkmark_drawables")

    def hook_dialog_cell(self):
        try:
            cls_obj = get_java_class("org.telegram.ui.Cells.DialogCell")
            if not cls_obj: cls_obj = get_java_class("org.telegram.ui.cells.DialogCell")
            if not cls_obj: return

            canvas_cls_obj = get_java_class("android.graphics.Canvas")

            curr = cls_obj
            m = None
            depth = 0
            while curr is not None and depth < 5:
                m = safe_get_method(curr, "onDraw", canvas_cls_obj)
                if m is not None: break
                try:
                    curr = curr.getSuperclass()
                    depth += 1
                except:
                    break

            if m is not None and not self._dialog_cell_hooked:
                ref = self.hook_method(m, _DialogCellDrawHook(self))
                if ref:
                    self._hooks.append(ref)
                    self._dialog_cell_hooked = True

            if self._dialog_is_online_method is None:
                self._dialog_is_online_method = safe_get_method(cls_obj, "isOnline")
            if self._dialog_is_online_method is not None and not self._dialog_online_hooked:
                ref = self.hook_method(self._dialog_is_online_method, _DialogCellIsOnlineHook(self))
                if ref:
                    self._hooks.append(ref)
                    self._dialog_online_hooked = True

            if not self._dialog_update_hooked:
                IntTYPE = find_class("java.lang.Integer").TYPE
                BoolTYPE = find_class("java.lang.Boolean").TYPE
                m_update = safe_get_method(cls_obj, "update", IntTYPE, BoolTYPE)
                if m_update:
                    ref = self.hook_method(m_update, _DialogCellUpdateHook(self))
                    if ref:
                        self._hooks.append(ref)
                        self._dialog_update_hooked = True
        except:
            log_exception("hook_dialog_cell")

    def on_cell_before_draw(self, param):
        try:
            cell = param.thisObject
            canvas = param.args[0]
            if not cell or not canvas: return

            cell_hash = System.identityHashCode(cell)
            if cell_hash in self._canvas_save_counts:
                return

            w = cell.getMeasuredWidth()
            h = cell.getMeasuredHeight()
            if w <= 0 or h <= 0: return

            state = self._cell_states.get(cell_hash)
            if state is None or state.get("dialog_id") is None:
                dialog_id = self.get_dialog_id(cell)
                self_id = self.get_self_user_id()
                state = {
                    "dialog_id": dialog_id,
                    "is_muted": self.is_dialog_muted(cell, dialog_id),
                    "is_online": self.is_dialog_cell_online(cell, dialog_id),
                    "is_pinned": self.is_dialog_pinned(cell, dialog_id),
                    "is_saved_messages": (self_id > 0 and dialog_id == self_id),
                    "is_replies": (dialog_id == 777000 or dialog_id == 1271266957),
                    "is_archive": (dialog_id == 1 or dialog_id == 0x2000000000000000 or self.is_folder_dialog_id(dialog_id)),
                    "avatar_receiver": self.get_avatar_receiver(cell),
                    "configured": False
                }
                self.store_cell_state(cell_hash, state)

            if not state.get("configured"):
                self.configure_cell(cell, state)

            self.scale_cell_avatar(cell, state)
            self.draw_custom_background(cell, canvas, w, h, state)

            try:
                save_val = canvas.save()
                self._canvas_save_counts[cell_hash] = int(save_val)

                margin_x = self.dp(CARD_MARGIN_X_DP)
                margin_y = self.dp(CARD_MARGIN_Y_DP)
                radius = self.dp(CARD_ROUNDING_DP)
                clip_path = self.get_reusable_clip_path()

                rect_f = self.get_reusable_rect_f(margin_x, margin_y, w - margin_x, h - margin_y)
                clip_path.addRoundRect(rect_f, radius, radius, Path.Direction.CW)
                canvas.clipPath(clip_path)
            except:
                pass
        except:
            log_exception("on_cell_before_draw")

    def on_cell_after_draw(self, param):
        try:
            cell = param.thisObject
            canvas = param.args[0]
            if not cell or not canvas: return

            cell_hash = System.identityHashCode(cell)
            state = self._cell_states.get(cell_hash)

            save_val = self._canvas_save_counts.pop(cell_hash, None)
            if save_val is not None:
                try:
                    canvas.restoreToCount(int(save_val))
                except:
                    try: canvas.restore()
                    except: pass

            if not self._enabled_cached: return
            if state is None: return

            is_saved_messages = state.get("is_saved_messages", False)
            is_replies = state.get("is_replies", False)
            is_archive = state.get("is_archive", False)

            is_muted = state.get("is_muted", False)
            is_online = state.get("is_online", False)

            if is_saved_messages or is_replies or is_archive:
                is_online = False

            if self._mute_style_normal_cached:
                is_muted = False
            elif is_muted:
                is_online = False

            w = cell.getMeasuredWidth()
            h = cell.getMeasuredHeight()
            if w <= 0 or h <= 0: return

            margin_x = self.dp(CARD_MARGIN_X_DP)
            margin_y = self.dp(CARD_MARGIN_Y_DP)
            radius = self.dp(CARD_ROUNDING_DP)
            stroke_width = self.dp(CARD_STROKE_WIDTH_STATUS_DP)

            card_left = margin_x
            card_top = margin_y
            card_right = w - margin_x
            card_bottom = h - margin_y

            if is_muted or is_online:
                draw_stroke = True
                if is_muted and not is_online:
                    draw_stroke = self._mute_stroke_cached

                stroke_left = card_left + stroke_width / 2.0
                stroke_top = card_top + stroke_width / 2.0
                stroke_right = card_right - stroke_width / 2.0
                stroke_bottom = card_bottom - stroke_width / 2.0

                overlay_paint = self.get_paint_overlay()

                if is_muted:
                    opacity = self._mute_opacity_cached
                    alpha = int((100 - opacity) * 2.3)
                    fill_color = argb_to_signed(alpha, 0x22, 0x24, 0x2B)

                    border_alpha = int((100 - opacity) * 1.91)
                    border_color = argb_to_signed(border_alpha, 0x43, 0x47, 0x53)
                else:
                    border_color = COLOR_ONLINE_BORDER
                    fill_color = COLOR_ONLINE_FILL

                overlay_paint.setStyle(Paint.Style.FILL)
                overlay_paint.setColor(to_jint(fill_color))
                canvas.drawRoundRect(float(card_left), float(card_top), float(card_right), float(card_bottom), float(radius), float(radius), overlay_paint)

                if not is_muted or draw_stroke:
                    overlay_paint.setStyle(Paint.Style.STROKE)
                    overlay_paint.setStrokeWidth(float(stroke_width))
                    overlay_paint.setColor(to_jint(border_color))
                    canvas.drawRoundRect(float(stroke_left), float(stroke_top), float(stroke_right), float(stroke_bottom), float(radius), float(radius), overlay_paint)
        except:
            log_exception("on_cell_after_draw")

    def generate_procedural_pattern_bitmap(self, dialog_id, pattern_type, rad_val):
        bmp_w = 90
        bmp_h = 90
        bmp = Bitmap.createBitmap(bmp_w, bmp_h, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)

        bg_paint = Paint()
        bg_paint.setAntiAlias(True)
        bg_paint.setStyle(Paint.Style.FILL)

        if pattern_type == "saved":
            c1 = argb_to_signed(255, 0x28, 0x18, 0x4F)
            c2 = argb_to_signed(255, 0x12, 0x2D, 0x5B)
        elif pattern_type == "archive":
            c1 = argb_to_signed(255, 0x4A, 0x1B, 0x17)
            c2 = argb_to_signed(255, 0x2D, 0x0D, 0x0B)
        else:
            c1 = argb_to_signed(255, 0x0D, 0x3E, 0x44)
            c2 = argb_to_signed(255, 0x1A, 0x25, 0x3B)

        grad = LinearGradient(0.0, 0.0, float(bmp_w), float(bmp_h), create_int_array([c1, c2]), None, Shader.TileMode.CLAMP)
        bg_paint.setShader(grad)
        canvas.drawRect(0.0, 0.0, float(bmp_w), float(bmp_h), bg_paint)

        icon_paint = Paint()
        icon_paint.setAntiAlias(True)
        icon_paint.setStyle(Paint.Style.FILL)
        icon_paint.setColor(to_jint(argb_to_signed(140, 255, 255, 255)))

        seed = abs(int(dialog_id)) if dialog_id else 12345
        num_icons = 24

        for i in range(num_icons):
            cx = (pseudo_rand(seed, i * 4) * 80.0) + 5.0
            cy = (pseudo_rand(seed, i * 4 + 1) * 80.0) + 5.0
            icon_sz = (pseudo_rand(seed, i * 4 + 2) * 6.0) + 5.0
            half_s = icon_sz / 2.0
            shape_type = int(pseudo_rand(seed, i * 4 + 3) * 4.0)

            path = Path()
            if pattern_type == "saved":
                if shape_type == 0:
                    path.moveTo(float(cx - half_s * 0.7), float(cy - half_s))
                    path.lineTo(float(cx + half_s * 0.7), float(cy - half_s))
                    path.lineTo(float(cx + half_s * 0.7), float(cy + half_s))
                    path.lineTo(float(cx), float(cy + half_s * 0.3))
                    path.lineTo(float(cx - half_s * 0.7), float(cy + half_s))
                    path.close()
                elif shape_type == 1:
                    path.moveTo(float(cx), float(cy - half_s))
                    path.lineTo(float(cx + half_s * 0.3), float(cy - half_s * 0.3))
                    path.lineTo(float(cx + half_s), float(cy - half_s * 0.3))
                    path.lineTo(float(cx + half_s * 0.4), float(cy + half_s * 0.1))
                    path.lineTo(float(cx + half_s * 0.6), float(cy + half_s))
                    path.lineTo(float(cx), float(cy + half_s * 0.4))
                    path.lineTo(float(cx - half_s * 0.6), float(cy + half_s))
                    path.lineTo(float(cx - half_s * 0.4), float(cy + half_s * 0.1))
                    path.lineTo(float(cx - half_s), float(cy - half_s * 0.3))
                    path.lineTo(float(cx - half_s * 0.3), float(cy - half_s * 0.3))
                    path.close()
                elif shape_type == 2:
                    path.moveTo(float(cx), float(cy - half_s))
                    path.lineTo(float(cx + half_s * 0.2), float(cy - half_s * 0.2))
                    path.lineTo(float(cx + half_s), float(cy))
                    path.lineTo(float(cx + half_s * 0.2), float(cy + half_s * 0.2))
                    path.lineTo(float(cx), float(cy + half_s))
                    path.lineTo(float(cx - half_s * 0.2), float(cy + half_s * 0.2))
                    path.lineTo(float(cx - half_s), float(cy))
                    path.lineTo(float(cx - half_s * 0.2), float(cy - half_s * 0.2))
                    path.close()
                else:
                    path.addCircle(float(cx), float(cy - half_s * 0.3), float(half_s * 0.5), Path.Direction.CW)
                    path.addRect(self.get_reusable_rect_f(cx - half_s * 0.5, cy, cx + half_s * 0.5, cy + half_s), Path.Direction.CW)
            elif pattern_type == "archive":
                if shape_type == 0:
                    path.addRoundRect(self.get_reusable_rect_f(cx - half_s, cy - half_s * 0.6, cx + half_s, cy + half_s * 0.6), half_s * 0.2, half_s * 0.2, Path.Direction.CW)
                    path.addRect(self.get_reusable_rect_f(cx - half_s * 0.4, cy - half_s * 0.3, cx + half_s * 0.4, cy - half_s * 0.1), Path.Direction.CW)
                elif shape_type == 1:
                    path.moveTo(float(cx - half_s), float(cy - half_s * 0.5))
                    path.lineTo(float(cx - half_s * 0.2), float(cy - half_s * 0.5))
                    path.lineTo(float(cx), float(cy - half_s * 0.2))
                    path.lineTo(float(cx + half_s), float(cy - half_s * 0.2))
                    path.lineTo(float(cx + half_s), float(cy + half_s * 0.6))
                    path.lineTo(float(cx - half_s), float(cy + half_s * 0.6))
                    path.close()
                elif shape_type == 2:
                    path.addRoundRect(self.get_reusable_rect_f(cx - half_s * 0.7, cy - half_s * 0.4, cx + half_s * 0.7, cy + half_s * 0.5), half_s * 0.3, half_s * 0.3, Path.Direction.CW)
                else:
                    path.moveTo(float(cx), float(cy - half_s))
                    path.lineTo(float(cx + half_s * 0.3), float(cy - half_s * 0.3))
                    path.lineTo(float(cx + half_s), float(cy - half_s * 0.3))
                    path.lineTo(float(cx + half_s * 0.4), float(cy + half_s * 0.1))
                    path.lineTo(float(cx + half_s * 0.6), float(cy + half_s))
                    path.lineTo(float(cx), float(cy + half_s * 0.4))
                    path.lineTo(float(cx - half_s * 0.6), float(cy + half_s))
                    path.lineTo(float(cx - half_s * 0.4), float(cy + half_s * 0.1))
                    path.lineTo(float(cx - half_s), float(cy - half_s * 0.3))
                    path.lineTo(float(cx - half_s * 0.3), float(cy - half_s * 0.3))
                    path.close()
            else:
                if shape_type == 0:
                    path.moveTo(float(cx + half_s * 0.6), float(cy - half_s * 0.6))
                    path.lineTo(float(cx - half_s * 0.4), float(cy))
                    path.lineTo(float(cx + half_s * 0.6), float(cy + half_s * 0.6))
                    path.lineTo(float(cx + half_s * 0.2), float(cy))
                    path.close()
                elif shape_type == 1:
                    path.moveTo(float(cx - half_s), float(cy))
                    path.lineTo(float(cx - half_s * 0.3), float(cy + half_s * 0.5))
                    path.lineTo(float(cx + half_s * 0.5), float(cy - half_s * 0.5))
                    path.lineTo(float(cx - half_s * 0.3), float(cy + half_s * 0.2))
                    path.close()
                elif shape_type == 2:
                    path.addRoundRect(self.get_reusable_rect_f(cx - half_s, cy - half_s * 0.6, cx + half_s, cy + half_s * 0.4), half_s * 0.3, half_s * 0.3, Path.Direction.CW)
                    path.moveTo(float(cx - half_s * 0.5), float(cy + half_s * 0.4))
                    path.lineTo(float(cx - half_s * 0.8), float(cy + half_s * 0.8))
                    path.lineTo(float(cx - half_s * 0.2), float(cy + half_s * 0.4))
                    path.close()
                else:
                    path.moveTo(float(cx), float(cy - half_s))
                    path.lineTo(float(cx + half_s * 0.6), float(cy + half_s * 0.3))
                    path.lineTo(float(cx - half_s * 0.6), float(cy + half_s * 0.3))
                    path.close()
                    path.addCircle(float(cx), float(cy + half_s * 0.6), float(half_s * 0.3), Path.Direction.CW)

            canvas.drawPath(path, icon_paint)

        effective_rad = max(1, min(25, int(round(float(rad_val) * (90.0 / 160.0)))))
        Utilities.stackBlurBitmap(bmp, effective_rad)
        return bmp

    def draw_custom_background(self, cell, canvas, w, h, state):
        try:
            dialog_id = state.get("dialog_id", 0)

            margin_x = self.dp(CARD_MARGIN_X_DP)
            margin_y = self.dp(CARD_MARGIN_Y_DP)
            radius = self.dp(CARD_ROUNDING_DP)
            card_left = margin_x
            card_top = margin_y
            card_right = w - margin_x
            card_bottom = h - margin_y
            card_w = max(1.0, card_right - card_left)
            card_h = max(1.0, card_bottom - card_top)

            is_saved_messages = state.get("is_saved_messages", False)
            is_replies = state.get("is_replies", False)
            is_archive = state.get("is_archive", False)

            blur_radius = self._blur_radius_cached
            darken_alpha = int(255.0 * (self._darken_percent_cached / 100.0))

            # 1. SPECIAL PROCEDURAL BLURRED PATTERN CARDS (Saved Messages / Replies / Archive)
            if is_saved_messages or is_replies or is_archive:
                pattern_type = "saved" if is_saved_messages else ("archive" if is_archive else "replies")
                pattern_key = ("system_pattern", pattern_type, int(dialog_id), blur_radius)
                cached_shader = state.get("cached_shader")
                if (cached_shader is None or state.get("cached_blur_key") != pattern_key or
                        state.get("cached_card_w") != card_w or state.get("cached_card_h") != card_h):
                    pattern_bmp = self.generate_procedural_pattern_bitmap(dialog_id, pattern_type, blur_radius)
                    shader = BitmapShader(pattern_bmp, Shader.TileMode.MIRROR, Shader.TileMode.MIRROR)
                    matrix = Matrix()
                    bmp_w = pattern_bmp.getWidth()
                    bmp_h = pattern_bmp.getHeight()
                    scale = max(card_w / float(bmp_w), card_h / float(bmp_h))
                    dx = card_left + (card_w - bmp_w * scale) / 2.0
                    dy = card_top + (card_h - bmp_h * scale) / 2.0
                    matrix.postScale(float(scale), float(scale))
                    matrix.postTranslate(float(dx), float(dy))
                    shader.setLocalMatrix(matrix)

                    state["cached_shader"] = shader
                    state["cached_blurred_bmp"] = pattern_bmp
                    state["cached_blur_key"] = pattern_key
                    state["cached_card_w"] = card_w
                    state["cached_card_h"] = card_h

                cached_shader = state.get("cached_shader")
                if cached_shader is not None:
                    bg_paint = self.get_paint_bg()
                    bg_paint.setShader(cached_shader)
                    canvas.drawRoundRect(float(card_left), float(card_top), float(card_right), float(card_bottom), float(radius), float(radius), bg_paint)

                stroke_paint = self.get_paint_stroke()
                stroke_width = self.dp(CARD_STROKE_WIDTH_CLASSIC_DP)
                stroke_paint.setStrokeWidth(float(stroke_width))
                stroke_paint.setShader(self.get_cached_gradient(card_top, card_bottom, self.get_classic_background_color()))
                stroke_left = card_left + stroke_width / 2.0
                stroke_top = card_top + stroke_width / 2.0
                stroke_right = card_right - stroke_width / 2.0
                stroke_bottom = card_bottom - stroke_width / 2.0
                canvas.drawRoundRect(float(stroke_left), float(stroke_top), float(stroke_right), float(stroke_bottom), float(radius), float(radius), stroke_paint)
                return

            # 2. ULTRA FAST PATH: Pre-cached Shader ready in cell state!
            cached_shader = state.get("cached_shader")
            cached_bmp = state.get("cached_blurred_bmp")
            if (cached_shader is not None and cached_bmp is not None and
                    not cached_bmp.isRecycled() and
                    state.get("cached_card_w") == card_w and
                    state.get("cached_card_h") == card_h and
                    state.get("cached_blur_radius") == self._blur_radius_cached):
                bg_paint = self.get_paint_bg()
                bg_paint.setShader(cached_shader)
                canvas.drawRoundRect(float(card_left), float(card_top), float(card_right), float(card_bottom), float(radius), float(radius), bg_paint)

                if darken_alpha > 0:
                    overlay_paint = self.get_paint_overlay()
                    overlay_paint.setStyle(Paint.Style.FILL)
                    overlay_paint.setColor(to_jint(argb_to_signed(darken_alpha, 0, 0, 0)))
                    canvas.drawRoundRect(float(card_left), float(card_top), float(card_right), float(card_bottom), float(radius), float(radius), overlay_paint)

                is_muted = state.get("is_muted", False)
                is_online = state.get("is_online", False)
                if self._mute_style_normal_cached:
                    is_muted = False
                elif is_muted:
                    is_online = False

                if not (is_muted or is_online):
                    stroke_paint = self.get_paint_stroke()
                    stroke_width = self.dp(CARD_STROKE_WIDTH_CLASSIC_DP)
                    stroke_paint.setStrokeWidth(float(stroke_width))
                    stroke_paint.setShader(self.get_cached_gradient(
                        card_top, card_bottom, self.get_classic_background_color()
                    ))

                    stroke_left = card_left + stroke_width / 2.0
                    stroke_top = card_top + stroke_width / 2.0
                    stroke_right = card_right - stroke_width / 2.0
                    stroke_bottom = card_bottom - stroke_width / 2.0
                    canvas.drawRoundRect(float(stroke_left), float(stroke_top), float(stroke_right), float(stroke_bottom), float(radius), float(radius), stroke_paint)
                return

            avatar_receiver = state.get("avatar_receiver")
            if avatar_receiver is None:
                avatar_receiver = self.get_avatar_receiver(cell)
                state["avatar_receiver"] = avatar_receiver

            current_avatar_bmp = self.get_receiver_bitmap(avatar_receiver)
            bg_paint = self.get_paint_bg()
            image_key = ""
            try:
                if avatar_receiver is not None:
                    image_key = str(avatar_receiver.getImageKey() or "")
            except:
                pass

            gen_id = 0
            try:
                if current_avatar_bmp is not None:
                    gen_id = int(System.identityHashCode(current_avatar_bmp))
            except:
                pass

            has_image = False
            blurred_bmp = None
            shader = None
            cache_key = ("image", image_key) if image_key else ("dialog", int(dialog_id))
            result_key = (cache_key, gen_id, blur_radius)

            if current_avatar_bmp is not None and not current_avatar_bmp.isRecycled():
                with self._cache_lock:
                    cached = self._blur_cache.get(result_key)
                    if (cached is not None and cached[1] == gen_id and cached[2] == blur_radius and
                            cached[0] is not None and not cached[0].isRecycled()):
                        blurred_bmp = cached[0]
                        has_image = True
                        self._blur_cache.move_to_end(result_key)

                if not has_image:
                    lifecycle_generation = self._lifecycle_generation
                    task_key = (lifecycle_generation, result_key)
                    with self._cache_lock:
                        already_pending = task_key in self._blurring_ids
                        queue_full = not already_pending and len(self._blurring_ids) >= BLUR_QUEUE_LIMIT
                        should_schedule = not already_pending and not queue_full
                        if not queue_full:
                            waiters = self._blur_waiters.setdefault(task_key, {})
                            waiters[System.identityHashCode(cell)] = cell
                        if should_schedule:
                            self._blurring_ids.add(task_key)

                    if should_schedule:
                        def blur_worker(result_cache_key, pending_key, generation, g_id, src_bitmap, rad_val):
                            completed = False
                            waiting_cells = []
                            scaled_bmp = None
                            try:
                                if generation != self._lifecycle_generation:
                                    return
                                if src_bitmap is None or src_bitmap.isRecycled():
                                    return

                                src_w = src_bitmap.getWidth()
                                src_h = src_bitmap.getHeight()
                                if src_w <= 0 or src_h <= 0:
                                    return

                                target_w = 90
                                target_h = 90
                                scaled_bmp = Bitmap.createScaledBitmap(src_bitmap, target_w, target_h, True)
                                if scaled_bmp is None or scaled_bmp.isRecycled():
                                    return
                                if System.identityHashCode(scaled_bmp) == System.identityHashCode(src_bitmap):
                                    scaled_copy = scaled_bmp.copy(Bitmap.Config.ARGB_8888, True)
                                    if scaled_copy is not None and not scaled_copy.isRecycled():
                                        scaled_bmp = scaled_copy

                                scale_ratio = float(target_w) / float(max(1, src_w))
                                effective_rad = max(1, min(25, int(round(float(rad_val) * scale_ratio))))

                                Utilities.stackBlurBitmap(scaled_bmp, effective_rad)
                                with self._cache_lock:
                                    if generation != self._lifecycle_generation:
                                        return
                                    self._blur_cache[result_cache_key] = (scaled_bmp, g_id, rad_val)
                                    self._blur_cache.move_to_end(result_cache_key)
                                    while len(self._blur_cache) > BLUR_CACHE_LIMIT:
                                        self._blur_cache.popitem(last=False)
                                    waiting_cells = list(self._blur_waiters.pop(pending_key, {}).values())
                                    completed = True

                                for waiting_cell in waiting_cells:
                                    try: waiting_cell.postInvalidate()
                                    except: pass
                            except:
                                pass
                            finally:
                                with self._cache_lock:
                                    self._blurring_ids.discard(pending_key)
                                    if not waiting_cells:
                                        self._blur_waiters.pop(pending_key, None)

                        try:
                            self._executor.submit(
                                blur_worker, result_key, task_key, lifecycle_generation,
                                gen_id, current_avatar_bmp, blur_radius
                            )
                        except:
                            with self._cache_lock:
                                self._blurring_ids.discard(task_key)
                                self._blur_waiters.pop(task_key, None)

            if has_image and blurred_bmp is not None and not blurred_bmp.isRecycled():
                shader = BitmapShader(blurred_bmp, Shader.TileMode.MIRROR, Shader.TileMode.MIRROR)
                matrix = Matrix()
                bmp_w = blurred_bmp.getWidth()
                bmp_h = blurred_bmp.getHeight()
                scale = max(card_w / float(bmp_w), card_h / float(bmp_h))
                dx = card_left + (card_w - bmp_w * scale) / 2.0
                dy = card_top + (card_h - bmp_h * scale) / 2.0
                matrix.postScale(float(scale), float(scale))
                matrix.postTranslate(float(dx), float(dy))
                shader.setLocalMatrix(matrix)

                state["cached_shader"] = shader
                state["cached_blurred_bmp"] = blurred_bmp
                state["cached_blur_key"] = result_key
                state["cached_gen_id"] = gen_id
                state["cached_blur_radius"] = blur_radius
                state["cached_card_w"] = card_w
                state["cached_card_h"] = card_h

                bg_paint.setShader(shader)
                canvas.drawRoundRect(float(card_left), float(card_top), float(card_right), float(card_bottom), float(radius), float(radius), bg_paint)
            else:
                dark_color = self._placeholder_color_cache.get(dialog_id)
                if dark_color is None:
                    placeholder_color = COLOR_BG_DARK
                    try:
                        if self.AvatarDrawableClass is None:
                            self.cache_classes()
                        if self.AvatarDrawableClass is not None:
                            placeholder_color = int(self.AvatarDrawableClass.getColorForId(dialog_id))
                    except:
                        placeholder_color = self.get_classic_background_color()

                    color_value = placeholder_color & 0xFFFFFFFF
                    dark_r = int(((color_value >> 16) & 0xFF) * 0.18)
                    dark_g = int(((color_value >> 8) & 0xFF) * 0.18)
                    dark_b = int((color_value & 0xFF) * 0.18)
                    dark_color = (255 << 24) | (dark_r << 16) | (dark_g << 8) | dark_b
                    if dark_color & 0x80000000:
                        dark_color -= 0x100000000
                    self._placeholder_color_cache[dialog_id] = dark_color

                bg_paint.setColor(to_jint(dark_color))
                canvas.drawRoundRect(float(card_left), float(card_top), float(card_right), float(card_bottom), float(radius), float(radius), bg_paint)

            if darken_alpha > 0:
                overlay_paint = self.get_paint_overlay()
                overlay_paint.setStyle(Paint.Style.FILL)
                overlay_paint.setColor(to_jint(argb_to_signed(darken_alpha, 0, 0, 0)))
                canvas.drawRoundRect(float(card_left), float(card_top), float(card_right), float(card_bottom), float(radius), float(radius), overlay_paint)

            is_muted = state.get("is_muted", False)
            is_online = state.get("is_online", False)
            if self._mute_style_normal_cached:
                is_muted = False
            elif is_muted:
                is_online = False

            if not (is_muted or is_online):
                stroke_paint = self.get_paint_stroke()
                stroke_width = self.dp(CARD_STROKE_WIDTH_CLASSIC_DP)
                stroke_paint.setStrokeWidth(float(stroke_width))
                stroke_paint.setShader(self.get_cached_gradient(
                    card_top, card_bottom, self.get_classic_background_color()
                ))

                stroke_left = card_left + stroke_width / 2.0
                stroke_top = card_top + stroke_width / 2.0
                stroke_right = card_right - stroke_width / 2.0
                stroke_bottom = card_bottom - stroke_width / 2.0
                canvas.drawRoundRect(float(stroke_left), float(stroke_top), float(stroke_right), float(stroke_bottom), float(radius), float(radius), stroke_paint)
        except:
            log_exception("draw_custom_background")

    def dp(self, val):
        key = float(val)
        cached = self._dp_cache.get(key)
        if cached is None:
            cached = float(AndroidUtilities.dp(key))
            self._dp_cache[key] = cached
        return cached

    def get_classic_background_color(self):
        if self._classic_bg_color is not None:
            return self._classic_bg_color
        color = COLOR_BG_DARK
        try:
            theme = self.ThemeClass or find_class("org.telegram.ui.ActionBar.Theme")
            color = int(theme.getColor(theme.key_windowBackgroundGray))
            if color & 0x80000000:
                color -= 0x100000000
        except:
            pass
        self._classic_bg_color = color
        return color

    def get_dialog_id(self, cell) -> int:
        if cell is None: return System.identityHashCode(cell)
        try:
            val = cell.getDialogId()
            if val is not None and val != 0:
                return int(val) if isinstance(val, (int, float)) else int(val.longValue())
        except:
            pass

        for attr in ("currentDialogId", "dialogId", "dialog_id", "id", "user_id", "chat_id"):
            try:
                if hasattr(cell, attr):
                    val = getattr(cell, attr)
                    if val is not None and val != 0:
                        return int(val) if isinstance(val, (int, float)) else int(val.longValue())
            except:
                pass

        cls = cell.getClass()
        fn = self.get_working_field_name(cls, ("currentDialogId", "dialogId", "dialog_id", "id", "user_id", "chat_id"))
        if fn is not None:
            val = self.get_cell_field_value(cell, fn)
            if val is not None and val != 0:
                return int(val) if isinstance(val, (int, float)) else int(val.longValue())

        return System.identityHashCode(cell)

    def get_avatar_receiver(self, cell):
        if cell is None: return None
        for name in ("avatarImageReceiver", "avatarReceiver", "avatarImage", "avatar"):
            try:
                if hasattr(cell, name):
                    val = getattr(cell, name)
                    if is_image_receiver_instance(val): return val
            except:
                pass

        cls = cell.getClass()
        fn = self.get_working_field_name(cls, ("avatarImageReceiver", "avatarReceiver", "avatarImage", "avatar"))
        if fn is not None:
            val = self.get_cell_field_value(cell, fn)
            if is_image_receiver_instance(val): return val
        return None

    def get_receiver_bitmap(self, receiver):
        if receiver is None: return None
        try:
            bmp = receiver.getBitmap()
            if bmp is not None and not bmp.isRecycled(): return bmp
        except: pass
        try:
            d = receiver.getDrawable()
            if isinstance(d, BitmapDrawable):
                bmp = d.getBitmap()
                if bmp is not None and not bmp.isRecycled(): return bmp
        except: pass
        try:
            m = receiver.getClass().getMethod("getBitmapSafe")
            bmp = m.invoke(receiver)
            if bmp is not None and not bmp.isRecycled(): return bmp
        except: pass
        return None

    def get_messages_controller(self):
        if self._messages_controller is not None:
            return self._messages_controller
        try:
            if self.UserConfigClass is None or self.MessagesControllerClass is None:
                self.cache_classes()
            acc = self.UserConfigClass.selectedAccount
            self._messages_controller = self.MessagesControllerClass.getInstance(acc)
            return self._messages_controller
        except:
            return None

    def get_server_time(self) -> int:
        try:
            from org.telegram.tgnet import ConnectionsManager
            acc = self.UserConfigClass.selectedAccount
            return int(ConnectionsManager.getInstance(acc).getCurrentTime())
        except:
            try:
                ConnectionsManagerClass = find_class("org.telegram.tgnet.ConnectionsManager")
                acc = self.UserConfigClass.selectedAccount
                instance = ConnectionsManagerClass.getInstance(to_jint(acc))
                return int(instance.getCurrentTime())
            except:
                try:
                    ConnectionsManagerClass = find_class("org.telegram.tgnet.ConnectionsManager")
                    return int(ConnectionsManagerClass.getCurrentTime())
                except:
                    return int(time.time())

    def get_cached_server_time(self) -> int:
        now = time.time()
        if (now - self._last_server_time_update) > 1.0 or self._cached_server_time == 0:
            self._cached_server_time = self.get_server_time()
            self._last_server_time_update = now
        return self._cached_server_time

    def get_user_expires(self, dialog_id) -> int:
        if dialog_id is None or dialog_id <= 0:
            return 0

        now = time.time()
        cached = self._user_expires_cache.get(dialog_id)
        if cached is not None and (now - cached[1]) < 10.0:
            return cached[0]

        expires = 0
        try:
            mc = self.get_messages_controller()
            if mc is not None:
                user = None
                try:
                    user = mc.getUser(dialog_id)
                except:
                    try:
                        LongClass = find_class("java.lang.Long")
                        user = mc.getUser(LongClass(dialog_id))
                    except:
                        pass
                if user is not None:
                    status = getattr(user, "status", None)
                    if status is None:
                        status = self.get_cell_field_value(user, "status")
                    if status is not None:
                        status_name = status.getClass().getSimpleName()
                        if "TL_userStatusOnline" in status_name or "StatusOnline" in status_name:
                            expires_val = self.get_cell_field_value(status, "expires")
                            if expires_val is not None:
                                expires = int(expires_val)
                            else:
                                expires = int(self.get_cached_server_time() + 300)
        except:
            pass

        self._user_expires_cache[dialog_id] = (expires, now)
        return expires

    def is_user_online(self, dialog_id) -> bool:
        self_id = self.get_self_user_id()
        if (self_id > 0 and dialog_id == self_id) or dialog_id == 777000 or dialog_id == 1271266957 or dialog_id == 1 or dialog_id == 0x2000000000000000:
            return False
        expires = self.get_user_expires(dialog_id)
        if expires == 0:
            return False
        return expires > self.get_cached_server_time()

    def is_dialog_muted(self, cell, dialog_id) -> bool:
        if dialog_id is None:
            return False

        is_muted = None
        if cell is not None:
            try:
                val = cell.getIsMuted()
                if val is not None:
                    is_muted = bool(val)
            except:
                pass

            if is_muted is None:
                for fn in ("isMuted", "drawMute", "mute"):
                    try:
                        if hasattr(cell, fn):
                            val = getattr(cell, fn)
                            if val is not None:
                                is_muted = bool(val)
                                break
                    except:
                        pass

            if is_muted is None:
                for fn in ("isMuted", "drawMute", "mute"):
                    val = self.get_cell_field_value(cell, fn)
                    if val is not None:
                        is_muted = bool(val)
                        break

        if is_muted is None:
            is_muted = False

        if not is_muted:
            try:
                mc = self.get_messages_controller()
                if mc is not None:
                    try:
                        is_muted = bool(mc.isDialogMuted(dialog_id))
                    except:
                        try:
                            is_muted = bool(mc.isDialogMuted(dialog_id, 0))
                        except:
                            pass
            except:
                pass

        return is_muted

    def is_dialog_pinned(self, cell, dialog_id) -> bool:
        if dialog_id is None:
            return False

        is_pinned = None
        if cell is not None:
            try:
                val = cell.getIsPinned()
                if val is not None:
                    is_pinned = bool(val)
            except:
                pass

            if is_pinned is None:
                for fn in ("isPinned", "drawPin", "pinned"):
                    try:
                        if hasattr(cell, fn):
                            val = getattr(cell, fn)
                            if val is not None:
                                is_pinned = bool(val)
                                break
                    except:
                        pass

            if is_pinned is None:
                for fn in ("isPinned", "drawPin", "pinned"):
                    val = self.get_cell_field_value(cell, fn)
                    if val is not None:
                        is_pinned = bool(val)
                        break

        if is_pinned is None:
            is_pinned = False

        if not is_pinned:
            try:
                mc = self.get_messages_controller()
                if mc is not None:
                    try:
                        is_pinned = bool(mc.isDialogPinned(dialog_id))
                    except:
                        try:
                            is_pinned = bool(mc.isDialogPinned(dialog_id, 0))
                        except:
                            pass
            except:
                pass

        return is_pinned

Plugin = PremiumDialogCardsPlugin
