    __slots__ = ("cell", "hash", "dialog_id", "special", "is_muted", "is_online",
                 "configured", "bg_saved", "orig_background", "separators",
                 "receiver", "avatar_target_w", "avatar_orig",
                 "entry", "solid_paint", "fade_from", "fade_start",
                 "fade_pending", "settled", "next_probe", "pending_probes",
                 "small_since", "bmp_id", "image_key", "style_epoch", "geo_gid",
                 "geo")

    def __init__(self, cell, cell_hash):
        self.cell = cell
        self.hash = cell_hash
        self.dialog_id = None
        self.special = None
        self.is_muted = False
        self.is_online = False
        self.configured = False
        self.bg_saved = False
        self.orig_background = None
        self.separators = None
        self.receiver = None
        self.avatar_target_w = None
        self.avatar_orig = None
        self.entry = None
        self.solid_paint = None
        self.fade_from = None
        self.fade_start = None
        self.fade_pending = False
        self.settled = False
        self.next_probe = 0.0
        self.pending_probes = 0
        self.small_since = 0.0
        self.bmp_id = 0
        self.image_key = None
        self.style_epoch = -1
        self.geo_gid = -1
        self.geo = None


class _DialogsActivityResumeHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def after_hooked_method(self, param):
        p = self.p()
        if p is None:
            return
        try:
            p.force_theme_check()
            p.prune_detached_cells()
            p.install_hooks()
        except:
            log_exception("resume_hook")


class _ThemeRebuiltHook(MethodHook):

    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def after_hooked_method(self, param):
        p = self.p()
        if p is None or p._in_theme_refresh:
            return
        try:
            p.on_theme_rebuilt()
        except:
            log_exception("theme_rebuilt")


class _DialogCellDrawHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def before_hooked_method(self, param):
        p = self.p()
        if p is None:
            return
        p._current_state = None
        if not p._enabled_cached:
            return
        p._is_drawing_dialog_cell = True
        p.on_cell_before_draw(param)

    def after_hooked_method(self, param):
        p = self.p()
        if p is None:
            return
        try:
            state = p._current_state
            if state is not None:
                p.on_cell_after_draw(param, state)
        except:
            log_exception("cell_after_draw")
        finally:
            p._current_state = None
            p._is_drawing_dialog_cell = False


class _DialogCellIsOnlineHook(MethodHook):

    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def before_hooked_method(self, param):
        p = self.p()
        if p is not None and p._enabled_cached and p._is_drawing_dialog_cell:
            param.setResult(False)


class _DialogCellUpdateHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def after_hooked_method(self, param):
        p = self.p()
        if p is None or not p._enabled_cached:
            return
        try:
            p.on_cell_updated(param.thisObject, param.args)
        except:
            log_exception("cell_update")


