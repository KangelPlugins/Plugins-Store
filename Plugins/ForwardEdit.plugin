from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from android_utils import OnClickListener
from extera_utils.classes import Base, java_subclass, joverride
from client_utils import get_last_fragment
from org.telegram.ui import PhotoViewer

__id__ = "exereal_forward_edit"
__name__ = "ForwardEdit"
__description__ = "Добавляет кнопку «Редактировать» в панель пересылки фото/видео, чтобы отредактировать их перед отправкой."
__author__ = "@Exorned, @ExerealPlugins"
__version__ = "0.0.1 BETA"
__icon__ = "ExerealPlugins/7"
__min_version__ = "12.5.1"

SUB_ITEM_CLASS = "org.telegram.ui.ActionBar.ActionBarMenuSubItem"
GAP_VIEW_CLASS = "org.telegram.ui.ActionBar.ActionBarPopupWindow$GapView"
MESSAGE_PREVIEW_VIEW_CLASS = "org.telegram.ui.Components.MessagePreviewView"

_last_preview_params_holder = {"value": None}
_edit_session_holder = {
    "plugin": None, "photo_entries": None, "dialog_id": None, "current_account": None,
    "dont_forward_item": None, "last_button": None, "last_gap": None, "last_container": None,
    "entry_captions": None, "standalone_texts": None, "other_media_messages": None,
}


def _type_of(name, JClass, JInteger, JLong, JBoolean):
    if name == "int":
        return JInteger.TYPE
    if name == "long":
        return JLong.TYPE
    if name == "boolean":
        return JBoolean.TYPE
    return JClass.forName(name)


def get_item_text(ch):
    try:
        text_view = get_private_field(ch, "textView")
        if text_view is None:
            return None
        return str(text_view.getText())
    except Exception:
        return None


def find_ctor_by_param_names(real_class, wanted_names):
    ctors = real_class.getDeclaredConstructors()
    for c in ctors:
        try:
            param_types = c.getParameterTypes()
            names = [p.getName() for p in param_types]
            if names == wanted_names:
                return c
        except Exception:
            continue
    return None


def clone_simple_view(plugin, template, context, resources_provider):
    try:
        real_class = template.getClass()
        ctors = real_class.getDeclaredConstructors()
    except Exception as e:
        plugin.log(f"[edit-btn] could not list gap constructors: {e}")
        return None

    for c in ctors:
        try:
            param_types = c.getParameterTypes()
            names = [p.getName() for p in param_types]
            args = []
            supported = True
            for n in names:
                if n == "android.content.Context":
                    args.append(context)
                elif n == "org.telegram.ui.ActionBar.Theme$ResourcesProvider":
                    args.append(resources_provider)
                elif n == "boolean":
                    args.append(False)
                elif n == "int":
                    args.append(0)
                else:
                    supported = False
                    break
            if not supported:
                continue
            c.setAccessible(True)
            return c.newInstance(*args)
        except Exception:
            continue
    plugin.log("[edit-btn] no supported constructor found for gap template.")
    return None


def forward_other_media_asis(plugin, other_media_messages, dialog_id):
    try:
        from client_utils import get_send_messages_helper
        from java.lang import Long as JLong

        helper = get_send_messages_helper()
        helper_class = helper.getClass()
        methods = helper_class.getMethods()

        candidate_method = None
        candidate_param_names = None
        for m in methods:
            try:
                if m.getName() != "sendMessage":
                    continue
                param_types = m.getParameterTypes()
                if len(param_types) < 2:
                    continue
                names = [p.getName() for p in param_types]
                if names[0] != "java.util.ArrayList":
                    continue
                if candidate_method is None:
                    candidate_method = m
                    candidate_param_names = names
            except Exception:
                continue

        if candidate_method is None:
            plugin.log("[edit-btn] no matching sendMessage overload found, other media not forwarded.")
            return

        args = [other_media_messages, JLong(dialog_id)]
        for extra_type in candidate_param_names[2:]:
            if extra_type == "boolean":
                from java.lang import Boolean as JBoolean
                args.append(JBoolean(False))
            elif extra_type == "int":
                from java.lang import Integer as JInteger
                args.append(JInteger(0))
            elif extra_type == "long":
                args.append(JLong(0))
            else:
                args.append(None)

        candidate_method.invoke(helper, *args)
    except Exception as e:
        plugin.log(f"[edit-btn] forwarding other media failed: {e}")


def build_photo_entry_for_path(plugin, path_str, file_length, is_video):
    width = 0
    height = 0
    if not is_video:
        try:
            from android.graphics import BitmapFactory
            opts = BitmapFactory.Options()
            opts.inJustDecodeBounds = True
            BitmapFactory.decodeFile(path_str, opts)
            width = opts.outWidth if opts.outWidth > 0 else 0
            height = opts.outHeight if opts.outHeight > 0 else 0
        except Exception:
            pass

    from java.lang import Class as JClass
    from java.lang import Integer as JInteger, Long as JLong, Boolean as JBoolean
    try:
        PhotoEntryClass = JClass.forName("org.telegram.messenger.MediaController$PhotoEntry")
    except Exception as e:
        plugin.log(f"[edit-btn] Class.forName for PhotoEntry failed: {e}")
        return None

    def box(type_name, value):
        if type_name == "int":
            return JInteger(value)
        if type_name == "long":
            return JLong(value)
        if type_name == "boolean":
            return JBoolean(value)
        return value

    candidates = [
        (["int", "int", "long", "java.lang.String", "int", "boolean", "int", "int", "long"],
         (0, 0, 0, path_str, 0, is_video, width, height, file_length)),
        (["int", "int", "long", "java.lang.String", "int", "int", "boolean", "int", "int", "long"],
         (0, 0, 0, path_str, 0, 0, is_video, width, height, file_length)),
    ]
    for type_names, args in candidates:
        try:
            type_classes = [_type_of(t, JClass, JInteger, JLong, JBoolean) for t in type_names]
            boxed_args = [box(t, a) for t, a in zip(type_names, args)]
            ctor = PhotoEntryClass.getDeclaredConstructor(*type_classes)
            ctor.setAccessible(True)
            return ctor.newInstance(*boxed_args)
        except Exception:
            continue
    plugin.log("[edit-btn] could not construct PhotoEntry with any known signature.")
    return None


def build_edit_button(plugin, parent, template):
    try:
        context = parent.getContext()
        resources_provider = get_private_field(template, "resourcesProvider")
        real_class = template.getClass()

        ctor = find_ctor_by_param_names(
            real_class,
            ["android.content.Context", "boolean", "boolean",
             "org.telegram.ui.ActionBar.Theme$ResourcesProvider"],
        )
        if ctor is None:
            plugin.log("[edit-btn] could not find matching ActionBarMenuSubItem constructor.")
            return None

        ctor.setAccessible(True)
        new_button = ctor.newInstance(context, False, False, resources_provider)

        try:
            from org.telegram.messenger import R as TgR
            new_button.setTextAndIcon("Редактировать", TgR.drawable.msg_edit)
        except Exception:
            text_view = get_private_field(new_button, "textView")
            if text_view is not None:
                text_view.setText("Редактировать")

        def on_click(view):
            preview_params = _last_preview_params_holder["value"]
            if preview_params is None:
                return

            try:
                forward_messages = get_private_field(preview_params, "forwardMessages")
                messages_list = get_private_field(forward_messages, "messages")
                if messages_list is None or messages_list.size() == 0:
                    return
                dialog_id = get_private_field(forward_messages, "dialogId")
                _edit_session_holder["dialog_id"] = dialog_id
            except Exception as e:
                plugin.log(f"[edit-btn] could not resolve messages list: {e}")
                return

            from java.util import ArrayList
            entries = ArrayList()
            entry_captions = []
            standalone_texts = []
            other_media_messages = ArrayList()
            entry_count = messages_list.size()

            for i in range(entry_count):
                message_object = messages_list.get(i)
                try:
                    message_owner = get_private_field(message_object, "messageOwner")
                    current_account = get_private_field(message_object, "currentAccount")
                    _edit_session_holder["current_account"] = current_account

                    is_photo = False
                    is_video = False
                    try:
                        is_photo = bool(message_object.isPhoto())
                    except Exception:
                        pass
                    try:
                        is_video = bool(message_object.isVideo())
                    except Exception:
                        pass

                    if not (is_photo or is_video):
                        has_other_media = False
                        try:
                            media = message_owner.media
                            if media is not None and media.getClass().getSimpleName() != "TL_messageMediaEmpty":
                                has_other_media = True
                        except Exception:
                            has_other_media = False

                        if has_other_media:
                            other_media_messages.add(message_object)
                        else:
                            try:
                                text_value = message_owner.message
                            except Exception:
                                text_value = None
                            if text_value:
                                standalone_texts.append(str(text_value))
                        continue

                    from org.telegram.messenger import FileLoader
                    file_loader = FileLoader.getInstance(current_account)
                    local_file = file_loader.getPathToMessage(message_owner)
                    if local_file is None or not local_file.exists():
                        continue

                    path_str = local_file.getAbsolutePath()
                    entry = build_photo_entry_for_path(plugin, path_str, local_file.length(), is_video)
                    if entry is not None:
                        entries.add(entry)
                        try:
                            caption_value = message_owner.message
                        except Exception:
                            caption_value = None
                        entry_captions.append(str(caption_value) if caption_value else None)
                except Exception as e:
                    plugin.log(f"[edit-btn] failed to process message {i}: {e}")
                    continue

            _edit_session_holder["other_media_messages"] = other_media_messages

            if entries.size() == 0:
                dialog_id = _edit_session_holder.get("dialog_id")
                if standalone_texts and dialog_id is not None:
                    try:
                        from client_utils import send_text
                        for t in standalone_texts:
                            send_text(dialog_id, t)
                    except Exception as e:
                        plugin.log(f"[edit-btn] sending standalone text failed: {e}")
                if other_media_messages.size() > 0 and dialog_id is not None:
                    forward_other_media_asis(plugin, other_media_messages, dialog_id)
                return

            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if activity is None:
                plugin.log("[edit-btn] no parent activity available.")
                return

            _edit_session_holder["plugin"] = plugin
            _edit_session_holder["photo_entries"] = entries
            _edit_session_holder["entry_captions"] = entry_captions
            _edit_session_holder["standalone_texts"] = standalone_texts

            provider = EditForwardPhotoProvider.new_instance()
            pv = PhotoViewer.getInstance()
            pv.setParentActivity(activity)
            pv.openPhotoForSelect(entries, 0, 2, False, provider.java, fragment)

        new_button.setOnClickListener(OnClickListener(on_click))
        return new_button
    except Exception as e:
        plugin.log(f"[edit-btn] failed to build edit button: {e}")
        return None


@java_subclass(PhotoViewer.EmptyPhotoViewerProvider)
class EditForwardPhotoProvider(Base):
    @joverride()
    def sendButtonPressed(self, index, video_edited_info, notify, schedule_date, ttl, force_document):
        plugin = _edit_session_holder["plugin"]
        photo_entries = _edit_session_holder.get("photo_entries")
        if plugin is None or photo_entries is None or photo_entries.size() == 0:
            return

        try:
            from java.lang import Class as JClass
            from java.lang import Integer as JInteger, Long as JLong, Boolean as JBoolean
            from java.util import ArrayList

            info_class = JClass.forName("org.telegram.messenger.SendMessagesHelper$SendingMediaInfo")
            path_field = info_class.getDeclaredField("path")
            path_field.setAccessible(True)
            is_video_field = info_class.getDeclaredField("isVideo")
            is_video_field.setAccessible(True)
            thumb_path_field = info_class.getDeclaredField("thumbPath")
            thumb_path_field.setAccessible(True)
            caption_field = info_class.getDeclaredField("caption")
            caption_field.setAccessible(True)

            entry_captions = _edit_session_holder.get("entry_captions") or []

            media_list = ArrayList()
            entry_count = photo_entries.size()
            for i in range(entry_count):
                entry = photo_entries.get(i)
                edited_path = None
                for field_name in ("imagePath", "path"):
                    try:
                        value = get_private_field(entry, field_name)
                        if value:
                            edited_path = value
                            break
                    except Exception:
                        continue
                if edited_path is None:
                    continue

                is_video = False
                try:
                    is_video = bool(get_private_field(entry, "isVideo"))
                except Exception:
                    is_video = False

                info_ctor = info_class.getDeclaredConstructor()
                info_ctor.setAccessible(True)
                info = info_ctor.newInstance()
                path_field.set(info, edited_path)
                is_video_field.set(info, JBoolean(is_video))
                if i < len(entry_captions) and entry_captions[i]:
                    caption_field.set(info, entry_captions[i])
                if is_video:
                    try:
                        thumb_path = get_private_field(entry, "thumbPath")
                        if thumb_path:
                            thumb_path_field.set(info, thumb_path)
                    except Exception:
                        pass
                media_list.add(info)

            if media_list.size() == 0:
                return

            dialog_id = _edit_session_holder.get("dialog_id")
            current_account = _edit_session_holder.get("current_account")
            if dialog_id is None or current_account is None:
                return

            from client_utils import get_send_messages_helper
            helper = get_send_messages_helper()
            helper_class = helper.getClass()

            from org.telegram.messenger import AccountInstance
            account_instance = AccountInstance.getInstance(current_account)

            param_type_names = [
                "org.telegram.messenger.AccountInstance", "java.util.ArrayList", "long",
                "org.telegram.messenger.MessageObject", "org.telegram.messenger.MessageObject",
                "org.telegram.tgnet.tl.TL_stories$StoryItem", "org.telegram.ui.ChatActivity$ReplyQuote",
                "boolean", "boolean", "org.telegram.messenger.MessageObject", "boolean",
                "int", "int", "int", "boolean",
                "androidx.core.view.inputmethod.InputContentInfoCompat", "java.lang.String",
                "int", "long", "boolean", "long", "long",
                "org.telegram.messenger.MessageSuggestionParams",
            ]
            type_classes = [_type_of(n, JClass, JInteger, JLong, JBoolean) for n in param_type_names]
            method = helper_class.getDeclaredMethod("prepareSendingMedia", *type_classes)
            method.setAccessible(True)

            silent_send = False
            group_album = True
            try:
                silent_send = bool(plugin.get_setting("silent_send", False))
                group_album = bool(plugin.get_setting("group_album", True))
            except Exception:
                pass

            args = [
                account_instance, media_list, JLong(dialog_id),
                None, None,
                None, None,
                JBoolean(False), JBoolean(group_album), None, JBoolean(not silent_send),
                JInteger(0), JInteger(0), JInteger(0), JBoolean(False),
                None, None,
                JInteger(0), JLong(0), JBoolean(False), JLong(0), JLong(0),
                None,
            ]
            method.invoke(helper, *args)

            try:
                standalone_texts = _edit_session_holder.get("standalone_texts") or []
                if standalone_texts:
                    from client_utils import send_text
                    for t in standalone_texts:
                        send_text(dialog_id, t)
            except Exception as e:
                plugin.log(f"[edit-btn] sending standalone text(s) failed: {e}")

            try:
                other_media_messages = _edit_session_holder.get("other_media_messages")
                if other_media_messages and other_media_messages.size() > 0:
                    forward_other_media_asis(plugin, other_media_messages, dialog_id)
            except Exception as e:
                plugin.log(f"[edit-btn] forwarding other media failed: {e}")

            try:
                dont_forward_item = _edit_session_holder.get("dont_forward_item")
                if dont_forward_item is not None:
                    dont_forward_item.performClick()
            except Exception as e:
                plugin.log(f"[edit-btn] closing forward screen failed: {e}")

            try:
                from java.util import ArrayList as JArrayList
                fragment = get_last_fragment()
                if fragment is not None:
                    fragment.showFieldPanelForForward(False, JArrayList())
            except Exception as e:
                plugin.log(f"[edit-btn] dismissing forward panel failed: {e}")
        except Exception as e:
            plugin.log(f"[edit-btn] sending edited media failed: {e}")


class PreviewViewConstructorHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        obj = param.thisObject
        try:
            preview_params = get_private_field(obj, "val$previewParams")
            if preview_params is None:
                preview_params = get_private_field(obj, "messagePreviewParams")
        except Exception as e:
            self.plugin.log(f"[edit-btn] could not read previewParams: {e}")
            return
        if preview_params is not None:
            _last_preview_params_holder["value"] = preview_params
            self._maybe_remove_button_if_no_media(preview_params)

    def _maybe_remove_button_if_no_media(self, preview_params):
        button = _edit_session_holder.get("last_button")
        gap = _edit_session_holder.get("last_gap")
        container = _edit_session_holder.get("last_container")
        if button is None or container is None:
            return

        has_media = False
        try:
            forward_messages = get_private_field(preview_params, "forwardMessages")
            messages_list = get_private_field(forward_messages, "messages")
            if messages_list is not None:
                for i in range(messages_list.size()):
                    msg = messages_list.get(i)
                    try:
                        if bool(msg.isPhoto()) or bool(msg.isVideo()):
                            has_media = True
                            break
                    except Exception:
                        continue
        except Exception as e:
            self.plugin.log(f"[edit-btn] media check failed: {e}")
            return

        if not has_media:
            try:
                container.removeView(button)
                if gap is not None:
                    container.removeView(gap)
            except Exception as e:
                self.plugin.log(f"[edit-btn] failed to remove button: {e}")

        _edit_session_holder["last_button"] = None
        _edit_session_holder["last_gap"] = None
        _edit_session_holder["last_container"] = None


class AddViewHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin
        self.target_parent = None
        self.injected = False

    def after_hooked_method(self, param):
        if self.injected:
            return
        try:
            args = param.args
            if not args:
                return
            child = args[0]
            if child is None:
                return
            child_class_name = child.getClass().getName()
        except Exception:
            return

        parent = param.thisObject

        if self.target_parent is None:
            is_candidate = child_class_name == SUB_ITEM_CLASS and get_item_text(child) == "Изменить получателя"
            if not is_candidate:
                return
            self.target_parent = parent
            return

        try:
            is_same = (parent == self.target_parent)
        except Exception:
            is_same = False
        if not is_same:
            return

        if child_class_name != SUB_ITEM_CLASS:
            return

        if get_item_text(child) != "Не пересылать":
            return

        try:
            count = parent.getChildCount()
        except Exception:
            count = -1

        recipient_index = None
        sub_item_template = None
        gap_template = None
        dont_forward_item = None
        for i in range(count):
            try:
                ch = parent.getChildAt(i)
                cls_name = ch.getClass().getName()
                if cls_name == SUB_ITEM_CLASS:
                    if sub_item_template is None:
                        sub_item_template = ch
                    item_text = get_item_text(ch)
                    if recipient_index is None and item_text == "Изменить получателя":
                        recipient_index = i
                    if item_text == "Не пересылать":
                        dont_forward_item = ch
                elif cls_name == GAP_VIEW_CLASS and gap_template is None:
                    gap_template = ch
            except Exception:
                continue

        _edit_session_holder["dont_forward_item"] = dont_forward_item

        if sub_item_template is None:
            self.target_parent = None
            self.injected = False
            return

        new_button = build_edit_button(self.plugin, parent, sub_item_template)
        if new_button is None:
            self.target_parent = None
            self.injected = False
            return

        new_gap = None
        if gap_template is not None:
            try:
                context = parent.getContext()
                resources_provider = get_private_field(sub_item_template, "resourcesProvider")
                new_gap = clone_simple_view(self.plugin, gap_template, context, resources_provider)
                if new_gap is not None:
                    for field_name in ("dividerVisible", "shadowDrawable"):
                        try:
                            value = get_private_field(gap_template, field_name)
                            gap_real_class = new_gap.getClass()
                            f = gap_real_class.getDeclaredField(field_name)
                            f.setAccessible(True)
                            f.set(new_gap, value)
                        except Exception:
                            pass
                    try:
                        bg = gap_template.getBackground()
                        if bg is not None:
                            new_gap.setBackground(bg)
                    except Exception:
                        pass
            except Exception as e:
                self.plugin.log(f"[edit-btn] could not clone gap: {e}")

        self.injected = True

        try:
            insert_index = (recipient_index + 1) if recipient_index is not None else 0
            if new_gap is not None:
                gap_layout_params = None
                try:
                    gap_layout_params = gap_template.getLayoutParams()
                except Exception:
                    pass

                if gap_layout_params is not None:
                    parent.addView(new_gap, insert_index, gap_layout_params)
                else:
                    parent.addView(new_gap, insert_index)
                insert_index += 1
            parent.addView(new_button, insert_index)
            _edit_session_holder["last_button"] = new_button
            _edit_session_holder["last_gap"] = new_gap
            _edit_session_holder["last_container"] = parent
        except Exception as e:
            self.plugin.log(f"[edit-btn] inserting button/gap failed: {e}")

        self.target_parent = None
        self.injected = False


class ForwardEditProbePlugin(BasePlugin):
    def _show_info_dialog(self, view=None):
        try:
            from ui.alert import AlertDialogBuilder
            fragment = get_last_fragment()
            if not fragment:
                return
            activity = fragment.getParentActivity()
            if not activity:
                return

            builder = AlertDialogBuilder(activity)
            builder.set_title("Как это работает")
            builder.set_message(
                "Кнопка «Редактировать» появляется в панели пересылки, если "
                "среди пересылаемых сообщений есть фото или видео.\n\n"
                "После правок в редакторе отредактированное фото/видео "
                "отправляется как новое сообщение (или альбом) вместо "
                "исходной пересылки."
            )
            builder.set_positive_button("Закрыть", lambda bld, which: bld.dismiss())
            builder.show()
        except Exception as e:
            self.log(f"[edit-btn] error showing info dialog: {e}")

    def _contact_dev(self, view=None):
        try:
            from client_utils import get_messages_controller
            fragment = get_last_fragment()
            if not fragment:
                return
            get_messages_controller().openByUserName("Exorned", fragment, 1)
        except Exception as e:
            self.log(f"[edit-btn] error opening dev chat: {e}")

    def create_settings(self):
        from ui.settings import Header, Switch, Divider, Text
        return [
            Header(text="Редактирование пересылаемых фото"),
            Switch(
                key="silent_send",
                text="Отправлять беззвучно",
                default=False,
                subtext="Без звука уведомления у получателя.",
                icon="msg_mute",
            ),
            Switch(
                key="group_album",
                text="Группировать в альбом",
                default=True,
                subtext="Несколько фото уйдут одним альбомом, а не по одному.",
                icon="msg_media",
            ),
            Divider(),
            Text(
                text="Как это работает",
                icon="msg_info",
                on_click=self._show_info_dialog,
            ),
            Header(text="Связь с разработчиком"),
            Text(
                text="Написать @Exorned",
                icon="msg_info",
                on_click=self._contact_dev,
            ),
        ]

    def on_plugin_load(self):
        try:
            MessagePreviewViewClass = find_class(MESSAGE_PREVIEW_VIEW_CLASS)
            if MessagePreviewViewClass:
                self.hook_all_constructors(MessagePreviewViewClass, PreviewViewConstructorHook(self))
        except Exception as e:
            self.log(f"[edit-btn] failed to hook MessagePreviewView: {e}")

        try:
            ViewGroupClass = find_class("android.view.ViewGroup")
            if ViewGroupClass:
                self.hook_all_methods(ViewGroupClass, "addView", AddViewHook(self))
        except Exception as e:
            self.log(f"[edit-btn] failed to hook ViewGroup.addView: {e}")