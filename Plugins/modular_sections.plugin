__id__ = "modular_sections"
__name__ = "Modular Sections"
__description__ = """Преобразует элементы интерфейса в модульные секции (Material 3).
Styles user interface elements into modular Material 3 sections."""
__author__ = "@RnPlugins"
__version__ = "1.0.0"
__icon__ = "RnDev/14"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"
import base64
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader, LocaleController
from ui.settings import Switch

DEX_B64 = """"""

def get_localized_strings():
    lang = LocaleController.getInstance().getCurrentLocale().getLanguage()
    strings = {
        "ru": {
            "apply_drawer": "Применять в боковом меню",
        },
        "en": {
            "apply_drawer": "Apply in navigation drawer",
        }
    }
    return strings.get(lang, strings["en"])

class ModularSectionsPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            self.log("Loading Java ModularSections module...")
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.modularsections.ModularSections")
            
            self.dex_class.getMethod("syncSettings").invoke(None)
            
            start_method = self.dex_class.getMethod("start")
            start_method.invoke(None)
            self.log("Java ModularSections module loaded and started successfully.")
        except Exception as e:
            self.log(f"Failed to load Java ModularSections module: {e}")

    def on_plugin_unload(self):
        try:
            self.log("Unloading Java ModularSections module...")
            if hasattr(self, "dex_class") and self.dex_class is not None:
                stop_method = self.dex_class.getMethod("stop")
                stop_method.invoke(None)
                self.log("Java ModularSections module stopped successfully.")
            self.dex_class = None
            self.dex_loader = None
        except Exception as e:
            self.log(f"Failed to unload Java ModularSections module: {e}")

    def on_setting_changed(self, key, value):
        val = value.lower() == "true" if isinstance(value, str) else bool(value)
        self.set_setting(key, val)
        if hasattr(self, "dex_class") and self.dex_class is not None:
            try:
                self.dex_class.getMethod("syncSettings").invoke(None)
            except Exception as e:
                self.log(f"Failed to sync settings on change: {e}")

    def create_settings(self):
        s = get_localized_strings()
        
        apply_drawer_raw = self.get_setting("apply_drawer", True)
        if isinstance(apply_drawer_raw, str):
            apply_drawer = apply_drawer_raw.lower() == "true"
        else:
            apply_drawer = bool(apply_drawer_raw)

        return [
            Switch(
                "apply_drawer",
                s["apply_drawer"],
                apply_drawer,
                icon="menu_photo",
                on_change=lambda v: self.on_setting_changed("apply_drawer", v)
            )
        ]
