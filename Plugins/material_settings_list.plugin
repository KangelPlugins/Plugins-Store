__id__ = "material_settings_list"
__name__ = "MaterialSettingsList"
__icon__ = "zwyPluginsIcons/8"
__description__ = (
    "Redesigns main settings list to match material concepts.\n\n"
    "> Requires **[ZwyLib](https://t.me/zwyPlugins/48)** v2.0.6 or greater!"
)
__author__ = "@zwylair"
__version__ = "1.0.0"
__min_version__ = "12.4.0"

REQUIRED_ZWYLIB_VERSION = "2.0.6"

try:
    import zwylib

    if (
            not hasattr(zwylib, "is_zwylib_version_sufficient")
            or not zwylib.is_zwylib_version_sufficient(__name__, REQUIRED_ZWYLIB_VERSION, notify=False)
    ):
        raise Exception("!!!")

    from zwylib import SettingEntry, ExpandableSwitchManager, ExpandableOption, HookUtils
except Exception as _e:
    class RecursiveMock:
        def __call__(self, *args, **kwargs): return self
        def __getattr__(self, _): return self
        def __getitem__(self, _): return self
        def __iter__(self): return iter([])
        def __str__(self): return ""
        def __repr__(self): return ""
        def __bool__(self): return False
        def __mro_entries__(self, bases): return ()

    zwylib = RecursiveMock()

    l = {
        "en": {
            "exc_text": "ZwyLib plugin required for this plugin is not found!",
            "not_sufficient_zwylib": f"{__name__} requires {REQUIRED_ZWYLIB_VERSION}+ version of ZwyLib!",
            "download": "Install",
        },
        "ru": {
            "exc_text": "Для корректной работы требуется плагин ZwyLib!",
            "not_sufficient_zwylib": f"Для работы {__name__} требуется {REQUIRED_ZWYLIB_VERSION}+ версия ZwyLib!",
            "download": "Установить",
        },
        "uk": {
            "exc_text": "Для коректної роботи потрібен плагін ZwyLib!",
            "not_sufficient_zwylib": f"Для роботи {__name__} потрібна {REQUIRED_ZWYLIB_VERSION}+ версія ZwyLib!",
            "download": "Встановити",
        },
    }
    l_dict = l.get(
        jclass("org.telegram.messenger.LocaleController").getInstance().getCurrentLocaleInfo().pluralLangCode,
        l.get("en")
    )
    err_text = f"{__name__}: " + l_dict["not_sufficient_zwylib" if "!!!" in str(_e) else "exc_text"]

    def force_stop():
        BulletinHelper.show_with_button(
            err_text, jclass("org.telegram.messenger.R").raw.error, l_dict["download"],
            on_click=lambda: get_last_fragment().presentFragment(
                jclass("org.telegram.ui.ChatActivity").of(-2521243181, 48)
            )
        )

        p = jclass("com.exteragram.messenger.plugins.PluginsController").getInstance().plugins.get(__id__)
        p.setError(jclass("java.lang.Exception")(err_text))
        p.setEnabled(False)

    class EmptyPlugin(BasePlugin):
        pass

    run_on_queue(force_stop, delay=50)


class S:
    reorder_settings_list = SettingEntry("reorder_settings_list", False)
    debloat_tg_prem = SettingEntry("debloat_tg_prem", False)
    debloat_tg_stars = SettingEntry("debloat_tg_stars", False)
    debloat_my_ton = SettingEntry("debloat_my_ton", False)
    debloat_wallet = SettingEntry("debloat_wallet", False)
    debloat_tg_business = SettingEntry("debloat_tg_business", False)
    debloat_send_gift = SettingEntry("debloat_send_gift", False)
    debloat_help_section = SettingEntry("help_section", False)


class DexLoader:
    def __init__(self):
        self.java_class = None
        self.class_loader = None

    def inject(self) -> bool:
        if Build.VERSION.SDK_INT < Build.VERSION_CODES.O:
            logger.error("InMemoryDexClassLoader requires Android 8.0 or greater.")
            bulletin.show_error(L.dex_not_supported)
            return False

        ctx = ApplicationLoader.applicationContext
        compressed_dex_bytes = base64.b64decode(DEX_BASE64.strip())

        try:
            dex_bytes = lzma.decompress(compressed_dex_bytes)
        except Exception:
            logger.error("Failed to decompress DEX with LZMA:", exc_info=True)
            return False

        try:
            buffer = ByteBuffer.wrap(dex_bytes)
            self.class_loader = InMemoryDexClassLoader(buffer, ctx.getClassLoader())

            self.java_class = self.class_loader.loadClass("org.zwylair.msldex.PluginCore")
            self.java_class.getDeclaredMethod("init", jclass("android.content.Context")).invoke(None, ctx)

            logger.info("DEX loaded successfully.")
            return True
        except Exception:
            logger.warning("InMemoryDexClassLoader load failed:", exc_info=True)
            return False

    def unload(self):
        if not self.java_class:
            return
        try:
            self.java_class.getDeclaredMethod("unload").invoke(None)
        except Exception:
            logger.error("Dex unload error:", exc_info=True)
        finally:
            self.java_class = None
            self.class_loader = None


class DexSettingsSync:
    def __init__(self, dex_loader: DexLoader):
        self.dex_loader = dex_loader
        self._sync_manager_class = None
        self._method_cache = {}

    def _get_sync_manager_class(self):
        if not self.dex_loader.class_loader:
            return None

        if self._sync_manager_class is None:
            try:
                self._sync_manager_class = self.dex_loader.class_loader.loadClass(
                    "org.zwylair.msldex.SettingsSyncManager"
                )
            except Exception:
                logger.error("Failed to load SettingsSyncManager class:", exc_info=True)
                return None
        return self._sync_manager_class

    def _find_static_method(self, name: str) -> Optional[object]:
        if name in self._method_cache:
            return self._method_cache[name]

        clazz = self._get_sync_manager_class()
        if not clazz:
            return None

        try:
            for method in clazz.getDeclaredMethods():
                if method.getName() == name and Modifier.isStatic(method.getModifiers()):
                    method.setAccessible(True)
                    self._method_cache[name] = method
                    return method
        except Exception:
            logger.error(f"Failed to resolve dex method '{name}':", exc_info=True)
        return None

    def _invoke(self, name: str, *args):
        method = self._find_static_method(name)
        if not method:
            return

        try:
            method.invoke(None, *args)
        except Exception:
            logger.error(f"Failed to invoke dex method '{name}':", exc_info=True)

    def sync_initial_state(self):
        self._invoke(
            "syncInitialState",
            S.reorder_settings_list.get(),
            S.debloat_tg_prem.get(),
            S.debloat_tg_stars.get(),
            S.debloat_my_ton.get(),
            S.debloat_wallet.get(),
            S.debloat_tg_business.get(),
            S.debloat_send_gift.get(),
            S.debloat_help_section.get(),
        )

    def set_reorder_settings_list(self, value: bool):
        self._invoke("setReorderSettingsList", value)

    def set_debloat_tg_prem(self, value: bool):
        self._invoke("setDebloatTgPrem", value)

    def set_debloat_tg_stars(self, value: bool):
        self._invoke("setDebloatTgStars", value)

    def set_debloat_my_ton(self, value: bool):
        self._invoke("setDebloatMyTon", value)

    def set_debloat_wallet(self, value: bool):
        self._invoke("setDebloatWallet", value)

    def set_debloat_tg_business(self, value: bool):
        self._invoke("setDebloatTgBusiness", value)

    def set_debloat_send_gift(self, value: bool):
        self._invoke("setDebloatSendGift", value)

    def set_debloat_help_section(self, value: bool):
        self._invoke("setDebloatHelpSection", value)


DEX_BASE64 = ""
L = zwylib.locales_controller.generate_locale_class({
    "en": {
        "prefs_reorder_settings": "Reorder Options",
        "prefs_debloat": "Remove Clutter",
        "prefs_help_section": "\"Help\" Section",
        "dex_not_supported": "Android 8.0+ is required! Main plugin's features are disabled.",
    },
    "ru": {
        "prefs_reorder_settings": "Перегруппировать настройки",
        "prefs_debloat": "Убрать мусор",
        "prefs_help_section": "Секция \"Помощь\"",
        "dex_not_supported": "Требуется Android 8.0+! Основные функции плагина отключены.",
    },
    "uk": {
        "prefs_reorder_settings": "Перегрупувати налаштування",
        "prefs_debloat": "Сховати сміття",
        "prefs_help_section": "Секція \"Допомога\"",
        "dex_not_supported": "Потрібен Android 8.0+! Основні функції плагіна вимкнено.",
    },
})

logger = zwylib.build_log(__name__, level=logging.INFO)
bulletin = zwylib.build_bulletin_helper()
dex_loader = DexLoader()
dex_settings_sync = DexSettingsSync(dex_loader)


class MaterialSettingsIcons(BasePlugin):
    def create_settings(self):
        try:
            EO = ExpandableOption
            tg_string = LocaleController.getString

            return [
                S.reorder_settings_list.as_switch(
                    text=L.prefs_reorder_settings,
                    on_change=lambda _: dex_settings_sync.set_reorder_settings_list(
                        S.reorder_settings_list.get()
                    ),
                    link_alias="reorder",
                ),
                *ExpandableSwitchManager.generate(
                    L.prefs_debloat,
                    [
                        EO(
                            tg_string(Res.string.TelegramPremium), S.debloat_tg_prem,
                            dex_settings_sync.set_debloat_tg_prem,
                        ),
                        EO(
                            tg_string(Res.string.TelegramStars), S.debloat_tg_stars,
                            dex_settings_sync.set_debloat_tg_stars,
                        ),
                        EO(
                            tg_string(Res.string.MyTON), S.debloat_my_ton,
                            dex_settings_sync.set_debloat_my_ton,
                        ),
                        EO(
                            "Wallet", S.debloat_wallet,
                            dex_settings_sync.set_debloat_wallet,
                        ),
                        EO(
                            tg_string(Res.string.TelegramBusiness), S.debloat_tg_business,
                            dex_settings_sync.set_debloat_tg_business,
                        ),
                        EO(
                            tg_string(Res.string.SendAGift), S.debloat_send_gift,
                            dex_settings_sync.set_debloat_send_gift,
                        ),
                        EO(
                            L.prefs_help_section, S.debloat_help_section,
                            dex_settings_sync.set_debloat_help_section,
                        ),
                    ]
                )
            ]
        except Exception:
            logger.error("An error occurred:", exc_info=True)

    def on_plugin_load(self):
        if not dex_loader.inject():
            raise Exception("Failed to load dex module.")

        dex_settings_sync.sync_initial_state()
        logger.info("Loaded.")

    def on_plugin_unload(self):
        dex_loader.unload()
        logger.info("Unloaded.")
