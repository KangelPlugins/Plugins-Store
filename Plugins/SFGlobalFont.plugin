__id__ = "mnd_global_sf_font"
__name__ = "Global Fonts"
__description__ = """Применяет выбранный шрифт ко всему интерфейсу Telegram. Включает магазин шрифтов Google Fonts.
Требования: exteraGram/AyuGram 12.1.1 или выше

Applies the selected font to the entire Telegram interface. Includes the Google Fonts store.
Requirements: exteraGram/AyuGram 12.1.1 or higher
"""
__author__ = "@swagnonher & @KangelPlugins"
__version__ = "1.2"
__min_version__ = "12.1.1"
__icon__ = "LostChocolateFlamingo_by_fStikBot/51"

import os
import threading
import traceback

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from android_utils import log, run_on_ui_thread, OnClickListener
from java import jclass, dynamic_proxy
from java.util import Locale
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader
from ui.settings import Header, Switch, Selector, Input, Divider, Text
from ui.bulletin import BulletinHelper
from client_utils import get_last_fragment

FONT_ENGINE_CLASS = "com.sfglobalfont.engine.FontEngine"

_DEX_B64 = ""

_dex_cache = None

def _get_dex_bytes():
    global _dex_cache
    if _dex_cache is not None:
        return _dex_cache
    try:
        _dex_cache = __import__("base64").b64decode(_DEX_B64)
        return _dex_cache
    except Exception as e:
        log(f"[mnd_global_sf_font] DEX decode failed: {e}")
        return None

_plugin_instance = None

def _locale():
    try:
        return Locale.getDefault().getLanguage()
    except Exception:
        return "en"

def t(key, default=None):
    strings = {
        "enable": {"en": "Enable plugin", "ru": "Включить плагин"},
        "source": {"en": "Font source", "ru": "Источник шрифта"},
        "source_items": {
            "en": ["Built-in", "Custom URL", "System default"],
            "ru": ["Встроенный", "Ссылка", "Системный"],
        },
        "custom_url": {"en": "Font URL (.ttf/.otf)", "ru": "Ссылка на шрифт"},
        "custom_url_sub": {"en": "Direct link to a font file", "ru": "Прямая ссылка на .ttf/.otf"},
        "downloading": {"en": "Downloading font...", "ru": "Загрузка шрифта..."},
        "ready": {"en": "Font applied!", "ru": "Шрифт применён!"},
        "failed": {"en": "Font error", "ru": "Ошибка шрифта"},
        "font_store": {"en": "Font store", "ru": "Магазин шрифтов"},
        "search_hint": {"en": "Search by name...", "ru": "Поиск..."},
        "reset": {"en": "Reset font", "ru": "Сбросить шрифт"},
        "reset_hint": {"en": "Fonts apply instantly, no restart needed.", "ru": "Применяется сразу."},
        "font_active": {"en": "Font active", "ru": "Шрифт активен"},
        "no_font": {"en": "No font selected", "ru": "Шрифт не выбран"},
        "pick_file": {"en": "Pick font file", "ru": "Выбрать файл шрифта"},
        "pick_file_sub": {"en": "Import .ttf/.otf from device", "ru": "Импорт .ttf/.otf с устройства"},
        "imported": {"en": "Font imported!", "ru": "Шрифт импортирован!"},
        "import_error": {"en": "Import error", "ru": "Ошибка импорта"},
        "file_missing": {"en": "File not found", "ru": "Файл не найден"},
        "url_invalid": {"en": "Invalid URL", "ru": "Неверная ссылка"},
        "requests_missing": {"en": "requests library not available", "ru": "Библиотека requests недоступна"},
        "gfonts_pick_variant": {"en": "Choose style", "ru": "Выберите начертание"},
        "gfonts_only_ttf": {"en": "Only .ttf/.otf variants available", "ru": "Доступны только варианты .ttf/.otf"},
        "gfonts_api_error": {"en": "Google Fonts API error", "ru": "Ошибка API Google Fonts"},
    }
    lang = _locale()
    entry = strings.get(key, {})
    return entry.get(lang, entry.get("en", default or key))


class FontEngineLoader:
    def __init__(self, plugin):
        self.plugin = plugin
        self.engine = None
        self._dex_loader = None
        self._method_cache = {}

    def load(self):
        dex_bytes = _get_dex_bytes()
        if dex_bytes is None:
            self.plugin.log("DEX decode failed")
            return False
        try:
            buf = ByteBuffer.wrap(dex_bytes)
            self._dex_loader = InMemoryDexClassLoader(
                buf, ApplicationLoader.applicationContext.getClassLoader())
            clazz = self._dex_loader.loadClass(FONT_ENGINE_CLASS)
            self.engine = clazz
            self._method_cache.clear()
            self.plugin.log("DEX loaded OK")
            return True
        except Exception as e:
            self.plugin.log(f"DEX load error: {e}")
            return False

    def _find_method(self, name, argc):
        key = (name, argc)
        m = self._method_cache.get(key)
        if m is not None:
            return m
        for candidate in self.engine.getDeclaredMethods():
            if candidate.getName() == name and len(candidate.getParameterTypes()) == argc:
                candidate.setAccessible(True)
                self._method_cache[key] = candidate
                return candidate
        return None

    def call(self, method_name, *args):
        if self.engine is None:
            return None
        try:
            m = self._find_method(method_name, len(args))
            if m is None:
                return None
            if len(args) == 0:
                return m.invoke(None)
            return m.invoke(None, *args)
        except Exception:
            return None


class SFGlobalFontPlugin(BasePlugin):
    FONT_URL = "https://github.com/Ar4ikTrirtyFour/windose20/raw/refs/heads/main/fonts/zpix.ttf"
    FONT_FILENAME = "global_font.ttf"

    def __init__(self):
        global _plugin_instance
        super().__init__()
        _plugin_instance = self
        self._loader = None
        self._store_overlay = None
        self._store_items = []
        self._store_filtered_items = []
        self._store_grid_container = None
        self._store_is_loading = False
        self._store_last_append_time = 0.0
        self._store_search_query = ""
        self._store_search_seq = 0
        self._store_loaded_index = 0

    def on_plugin_load(self):
        try:
            self._loader = FontEngineLoader(self)
            if not self._loader.load():
                self.log("DEX failed")
                return
            self._ensure_typeface_downloaded()
            self._loader.call("installHooks")
            self._loader.call("installGlobal")
            self._loader.call("runFullPipelineDelayed", 600)
            self._register_activity_result_hook()
            self.log("Loaded OK")
        except Exception:
            self.log(f"Load failed: {traceback.format_exc()}")

    def _register_activity_result_hook(self):
        try:
            launch_cls = find_class("org.telegram.ui.LaunchActivity")
            if launch_cls is None:
                return
            plugin_ref = self
            class ActivityResultHook(MethodHook):
                def after_hooked_method(self, param):
                    try:
                        req = int(param.args[0])
                        res = int(param.args[1])
                        data = param.args[2]
                        if req == 51000 and res == -1 and data is not None:
                            uri = data.getData()
                            if uri is not None:
                                run_on_ui_thread(lambda: _import_font_from_uri(uri, plugin_ref))
                    except Exception:
                        pass
            unhooks = self.hook_all_methods(launch_cls, "onActivityResult", ActivityResultHook())
            self._activity_result_hook = unhooks
        except Exception:
            pass

    def on_plugin_unload(self):
        try:
            if self._loader:
                self._loader.call("uninstallHooks")
                self._loader.call("restoreGlobal")
            if hasattr(self, '_activity_result_hook') and self._activity_result_hook:
                try:
                    for h in self._activity_result_hook:
                        self.unhook_method(h)
                except Exception:
                    pass
            self.log("Unloaded")
        except Exception:
            pass

    def _get_persistent_font_path(self):
        try:
            files_dir = ApplicationLoader.applicationContext.getFilesDir()
            d = jclass("java.io.File")(files_dir, "plugins/mnd_global_sf_font")
            if not d.exists():
                d.mkdirs()
            return jclass("java.io.File")(d, self.FONT_FILENAME).getAbsolutePath()
        except Exception:
            return os.path.join(os.getcwd(), self.FONT_FILENAME)

    def _ensure_typeface_downloaded(self):
        path = self._get_persistent_font_path()
        try:
            if os.path.exists(path) and os.path.getsize(path) > 0:
                self._apply_font(path)
                return
        except Exception:
            pass
        custom_url = (self.get_setting("custom_url", "") or "").strip()
        url = custom_url if (custom_url.startswith("http://") or custom_url.startswith("https://")) else self.FONT_URL
        run_on_ui_thread(lambda: BulletinHelper.show_info(t("downloading")))

        def _task():
            ok = False
            try:
                import requests as _rq
                resp = _rq.get(url, timeout=30, stream=True)
                if resp.status_code == 200:
                    with open(path, "wb") as f:
                        for chunk in resp.iter_content(8192):
                            if chunk:
                                f.write(chunk)
                    ok = True
            except Exception:
                pass
            if ok and os.path.exists(path) and os.path.getsize(path) > 0:
                self._apply_font(path)
                run_on_ui_thread(lambda: BulletinHelper.show_success(t("ready")))
            else:
                run_on_ui_thread(lambda: BulletinHelper.show_error(t("failed")))

        threading.Thread(target=_task, daemon=True).start()

    def _apply_font(self, path):
        if self._loader:
            try:
                self._loader.call("clearFont")
                self._loader.call("saveFontPath", path)
                self._loader.call("init")
                self._loader.call("installHooks")
                self._loader.call("installGlobal")
                self._loader.call("runFullPipelineDelayed", 300)
            except Exception:
                pass

    def _on_settings_changed(self):
        try:
            self._ensure_typeface_downloaded()
        except Exception:
            self.log(f"Settings error: {traceback.format_exc()}")

    def create_settings(self):
        font_status = t("no_font")
        try:
            if self._loader:
                has = self._loader.call("hasFont")
                if has:
                    font_status = t("font_active")
        except Exception:
            pass

        return [
            Header(text="Global Fonts"),
            Text(
                text=t("pick_file"),
                icon="file_download",
                accent=True,
                on_click=lambda v: self._pick_font(),
            ),
            Text(
                text=font_status,
                icon="msg_photo_text_font",
            ),
            Input(
                key="custom_url",
                text=t("custom_url"),
                default=self.get_setting("custom_url", ""),
                icon="input_attach",
                subtext=t("custom_url_sub"),
                on_change=lambda v: self._on_url_changed(),
            ),
            Divider(),
            Text(
                text=t("font_store"),
                icon="menu_shop_solar",
                accent=True,
                on_click=lambda v: self._open_google_fonts_store(),
            ),
            Divider(),
            Text(
                text=t("reset"),
                icon="msg_delete",
                red=True,
                on_click=lambda v: self._reset_font(),
            ),
            Divider(),
        ]

    def _on_url_changed(self):
        url = (self.get_setting("custom_url", "") or "").strip()
        if not url:
            return
        if not (url.startswith("http://") or url.startswith("https://")):
            BulletinHelper.show_error(t("url_invalid"))
            return
        self._ensure_typeface_downloaded()

    def _pick_font(self):
        try:
            from android.content import Intent
            intent = Intent(Intent.ACTION_GET_CONTENT)
            intent.setType("font/*")
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            frag = get_last_fragment()
            activity = frag.getParentActivity() if frag else None
            if activity:
                activity.startActivityForResult(
                    Intent.createChooser(intent, t("pick_file")), 51000)
            else:
                BulletinHelper.show_error(t("failed"))
        except Exception as e:
            self.log(f"Picker error: {e}")

    def _reset_font(self):
        if self._loader:
            try:
                self._loader.call("clearFont")
                self._loader.call("restoreGlobal")
                self._loader.call("runFullPipelineDelayed", 300)
            except Exception:
                pass
        BulletinHelper.show_success(t("ready"))

    def _open_google_fonts_store(self):
        try:
            import requests as _rq
        except Exception:
            BulletinHelper.show_error("requests not available")
            return

        def build_overlay():
            try:
                frag = get_last_fragment()
                activity = frag.getParentActivity() if frag else None
                if not activity:
                    return
                FrameLayout = find_class("android.widget.FrameLayout")
                Theme = find_class("org.telegram.ui.ActionBar.Theme")
                overlay = FrameLayout(activity)
                overlay.setClickable(True)
                overlay.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
                activity.getWindow().getDecorView().addView(
                    overlay, jclass("android.widget.FrameLayout$LayoutParams")(-1, -1))
                self._store_overlay = overlay
            except Exception:
                pass

        run_on_ui_thread(build_overlay)

        def fetch():
            items = []
            try:
                api_key = "AIzaSyAd9o97_3qbY-94qpwrkEKtILpjofoseME"
                url = f"https://www.googleapis.com/webfonts/v1/webfonts?key={api_key}&sort=popularity"
                resp = _rq.get(url, timeout=10)
                if resp.status_code == 200:
                    data = resp.json()
                    items = data.get("items", []) if isinstance(data, dict) else []
            except Exception:
                pass
            run_on_ui_thread(lambda: self._show_store(items))

        threading.Thread(target=fetch, daemon=True).start()

    def _remove_store(self):
        try:
            if self._store_overlay is not None:
                parent = self._store_overlay.getParent()
                if parent is not None:
                    parent.removeView(self._store_overlay)
            self._store_overlay = None
        except Exception:
            self._store_overlay = None

    def _show_store(self, items):
        try:
            frag = get_last_fragment()
            activity = frag.getParentActivity() if frag else None
            if not activity:
                return
            FrameLayout = find_class("android.widget.FrameLayout")
            LinearLayout = find_class("android.widget.LinearLayout")
            ScrollView = find_class("android.widget.ScrollView")
            Theme = find_class("org.telegram.ui.ActionBar.Theme")
            AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")

            overlay = self._store_overlay or FrameLayout(activity)
            overlay.removeAllViews()
            overlay.setClickable(True)
            overlay.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))

            pad = AndroidUtilities.dp(12)
            root = LinearLayout(activity)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(pad, pad, pad, pad)
            overlay.addView(root, jclass("android.widget.FrameLayout$LayoutParams")(-1, -1))

            header = LinearLayout(activity)
            header.setOrientation(LinearLayout.HORIZONTAL)
            title = jclass("android.widget.TextView")(activity)
            title.setText(t("font_store"))
            title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            title.setTextSize(20)
            header.addView(title, jclass("android.widget.LinearLayout$LayoutParams")(0, -2, 1.0))
            close = jclass("android.widget.TextView")(activity)
            close.setText("✕")
            close.setTextSize(18)
            close.setPadding(pad, 0, pad, 0)
            close.setOnClickListener(OnClickListener(lambda v: self._remove_store()))
            header.addView(close, jclass("android.widget.LinearLayout$LayoutParams")(-2, -2))
            root.addView(header, jclass("android.widget.LinearLayout$LayoutParams")(-1, -2))

            try:
                EditTextBoldCursor = find_class("org.telegram.ui.Components.EditTextBoldCursor")
                search = EditTextBoldCursor(activity)
                search.setHint(t("search_hint"))
                search.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
                search.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint))
                root.addView(search, jclass("android.widget.LinearLayout$LayoutParams")(-1, -2))
                try:
                    from java import dynamic_proxy
                    TextWatcher = find_class("android.text.TextWatcher")
                    plugin_ref = self

                    class _Watcher(dynamic_proxy(TextWatcher)):
                        def afterTextChanged(self_, s):
                            try:
                                q = str(s.toString())
                                plugin_ref._store_search_query = q
                                seq = getattr(plugin_ref, '_store_search_seq', 0) + 1
                                plugin_ref._store_search_seq = seq
                                def delayed():
                                    import time
                                    time.sleep(0.18)
                                    if getattr(plugin_ref, '_store_search_seq', 0) == seq:
                                        run_on_ui_thread(lambda: plugin_ref._filter_store(q))
                                threading.Thread(target=delayed, daemon=True).start()
                            except Exception:
                                pass
                        def beforeTextChanged(self_, s, start, count, after):
                            return None
                        def onTextChanged(self_, s, start, before, count):
                            return None

                    search.addTextChangedListener(_Watcher())
                except Exception:
                    pass
            except Exception:
                pass

            scroll = ScrollView(activity)
            grid = LinearLayout(activity)
            grid.setOrientation(LinearLayout.VERTICAL)
            scroll.addView(grid, jclass("android.widget.LinearLayout$LayoutParams")(-1, -1))
            root.addView(scroll, jclass("android.widget.LinearLayout$LayoutParams")(-1, -1))

            self._store_grid_container = grid
            self._store_items = items or []
            self._store_filtered_items = list(self._store_items)
            self._store_loaded_index = 0
            self._append_batch(activity, Theme, AndroidUtilities, FrameLayout, LinearLayout, 16)

            if self._store_overlay is None:
                activity.getWindow().getDecorView().addView(
                    overlay, jclass("android.widget.FrameLayout$LayoutParams")(-1, -1))
                self._store_overlay = overlay
        except Exception:
            BulletinHelper.show_error("UI error")

    def _render_grid(self, activity, Theme, AndroidUtilities, FrameLayout, LinearLayout, items):
        try:
            if not self._store_grid_container:
                return
            pad = AndroidUtilities.dp(12)
            sample = "Hello, world! 12345"
            i = 0
            while i < len(items):
                row = LinearLayout(activity)
                row.setOrientation(LinearLayout.HORIZONTAL)
                for c in range(2):
                    idx = i + c
                    card = FrameLayout(activity)
                    lp = jclass("android.widget.LinearLayout$LayoutParams")(0, -2, 1.0)
                    if c == 0:
                        lp.setMargins(0, pad // 2, pad // 2, pad // 2)
                    else:
                        lp.setMargins(pad // 2, pad // 2, 0, pad // 2)
                    if idx < len(items):
                        it = items[idx]
                        fam = it.get("family", "?")
                        variants = it.get("variants", [])
                        files = it.get("files", {})
                        cat = it.get("category", "")

                        card_bg = LinearLayout(activity)
                        card_bg.setOrientation(LinearLayout.VERTICAL)
                        card_bg.setPadding(pad, pad, pad, pad)
                        card.addView(card_bg, jclass("android.widget.FrameLayout$LayoutParams")(-1, -2))
                        try:
                            gd = find_class("android.graphics.drawable.GradientDrawable")()
                            gd.setColor(find_class("android.graphics.Color").rgb(245, 245, 245))
                            gd.setCornerRadius(AndroidUtilities.dp(10))
                            gd.setStroke(AndroidUtilities.dp(2), Theme.getColor(Theme.key_divider))
                            card.setBackground(gd)
                        except Exception:
                            pass

                        name_tv = jclass("android.widget.TextView")(activity)
                        name_tv.setText(fam)
                        name_tv.setTextSize(16)
                        name_tv.setTextColor(find_class("android.graphics.Color").BLACK)
                        card_bg.addView(name_tv, jclass("android.widget.LinearLayout$LayoutParams")(-1, -2))

                        meta = jclass("android.widget.TextView")(activity)
                        meta.setText(f"{len(variants)} variants • {cat}")
                        meta.setTextSize(12)
                        meta.setTextColor(Theme.getColor(Theme.key_dialogTextHint))
                        card_bg.addView(meta, jclass("android.widget.LinearLayout$LayoutParams")(-1, -2))

                        preview = jclass("android.widget.TextView")(activity)
                        preview.setText(sample)
                        preview.setTextSize(14)
                        preview.setTextColor(find_class("android.graphics.Color").BLACK)
                        card_bg.addView(preview, jclass("android.widget.LinearLayout$LayoutParams")(-1, -2))

                        preview_url = None
                        try:
                            if isinstance(files, dict):
                                url_reg = files.get("regular")
                                if isinstance(url_reg, str) and (url_reg.endswith('.ttf') or url_reg.endswith('.otf')):
                                    preview_url = url_reg
                                else:
                                    for (_v, u) in files.items():
                                        if isinstance(u, str) and (u.endswith('.ttf') or u.endswith('.otf')):
                                            preview_url = u
                                            break
                        except Exception:
                            pass
                        if preview_url and (preview_url.startswith("http://") or preview_url.startswith("https://")):
                            def _load_preview(url=preview_url, tv=preview, family=fam):
                                try:
                                    import requests as _rq2
                                    resp = _rq2.get(url, timeout=6, stream=True)
                                    if resp.status_code == 200:
                                        p = os.path.join(
                                            os.path.dirname(self._get_persistent_font_path()),
                                            f"preview_{family}.ttf")
                                        with open(p, "wb") as f:
                                            for chunk in resp.iter_content(8192):
                                                if chunk:
                                                    f.write(chunk)
                                        def apply():
                                            try:
                                                tp = jclass("android.graphics.Typeface").createFromFile(p)
                                                if tp:
                                                    tv.setTypeface(tp)
                                            except Exception:
                                                pass
                                        run_on_ui_thread(apply)
                                except Exception:
                                    pass
                            threading.Thread(target=_load_preview, daemon=True).start()

                        def on_card_click(view=None, urls=files):
                            target = urls.get("regular")
                            if not (isinstance(target, str) and (target.startswith("http://") or target.startswith("https://"))):
                                target = None
                                for v, u in urls.items():
                                    if isinstance(u, str) and (u.endswith('.ttf') or u.endswith('.otf')):
                                        target = u
                                        break
                            if target:
                                self.set_setting("custom_url", target)
                                self.set_setting("font_source", 1)
                                self._on_settings_changed()
                                self._remove_store()

                        card.setOnClickListener(OnClickListener(on_card_click))
                    row.addView(card, lp)
                self._store_grid_container.addView(row, jclass("android.widget.LinearLayout$LayoutParams")(-1, -2))
                i += 2
        except Exception:
            pass

    def _filter_store(self, query):
        try:
            q = (query or "").strip().lower()
            def worker():
                try:
                    filtered = list(self._store_items) if not q else [it for it in self._store_items if q in (it.get("family", "").lower())]
                    def apply():
                        try:
                            self._store_filtered_items = filtered
                            if self._store_grid_container:
                                self._store_grid_container.removeAllViews()
                                frag = get_last_fragment()
                                activity = frag.getParentActivity() if frag else None
                                if activity:
                                    Theme = find_class("org.telegram.ui.ActionBar.Theme")
                                    AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
                                    FrameLayout = find_class("android.widget.FrameLayout")
                                    LinearLayout = find_class("android.widget.LinearLayout")
                                    self._store_loaded_index = 0
                                    self._append_batch(activity, Theme, AndroidUtilities, FrameLayout, LinearLayout, 16)
                        except Exception:
                            pass
                    run_on_ui_thread(apply)
                except Exception:
                    pass
            threading.Thread(target=worker, daemon=True).start()
        except Exception:
            pass

    def _append_batch(self, activity, Theme, AndroidUtilities, FrameLayout, LinearLayout, count):
        try:
            if not self._store_filtered_items or self._store_is_loading:
                return
            import time
            now = time.time()
            if (now - getattr(self, '_store_last_append_time', 0.0)) < 0.2:
                return
            self._store_is_loading = True
            start = self._store_loaded_index
            end = min(start + count, len(self._store_filtered_items))
            if end <= start:
                self._store_is_loading = False
                return
            batch = self._store_filtered_items[start:end]
            self._render_grid(activity, Theme, AndroidUtilities, FrameLayout, LinearLayout, batch)
            self._store_loaded_index = end
            self._store_last_append_time = time.time()
        except Exception:
            pass
        finally:
            self._store_is_loading = False


def _import_font_from_uri(uri, plugin_ref=None):
    global _plugin_instance
    try:
        if plugin_ref is None:
            plugin_ref = _plugin_instance
        content_resolver = ApplicationLoader.applicationContext.getContentResolver()
        BulletinHelper.show_info(t("downloading"))

        def _task():
            try:
                files_dir = ApplicationLoader.applicationContext.getFilesDir()
                d = jclass("java.io.File")(files_dir, "plugins/mnd_global_sf_font")
                if not d.exists():
                    d.mkdirs()
                dst = jclass("java.io.File")(d, "global_font.ttf")
                inp = content_resolver.openInputStream(uri)
                if inp is None:
                    log("[mnd_global_sf_font] openInputStream returned None")
                    run_on_ui_thread(lambda: BulletinHelper.show_error(t("import_error")))
                    return
                out = jclass("java.io.FileOutputStream")(dst)
                total = 0
                buf = bytearray(8192)
                try:
                    while True:
                        r = inp.read(buf)
                        if r == -1:
                            break
                        out.write(buf, 0, r)
                        total += r
                finally:
                    try: out.close()
                    except Exception: pass
                    try: inp.close()
                    except Exception: pass

                log(f"[mnd_global_sf_font] import wrote {total} bytes to {dst.getAbsolutePath()}")
                if total > 0:
                    run_on_ui_thread(lambda: _apply_import(dst.getAbsolutePath(), plugin_ref))
                else:
                    dst.delete()
                    run_on_ui_thread(lambda: BulletinHelper.show_error(t("import_error")))
            except Exception as e:
                log(f"[mnd_global_sf_font] import exception: {e}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(t("import_error")))

        threading.Thread(target=_task, daemon=True).start()
    except Exception as e:
        log(f"[mnd_global_sf_font] import outer exception: {e}")
        BulletinHelper.show_error(t("import_error"))


def _apply_import(path, plugin_ref=None):
    global _plugin_instance
    try:
        if plugin_ref is None:
            plugin_ref = _plugin_instance
        if plugin_ref is None:
            return
        plugin_ref._apply_font(path)
        BulletinHelper.show_success(t("imported"))
    except Exception:
        BulletinHelper.show_error(t("import_error"))


def _on_activity_result(requestCode, resultCode, data):
    if requestCode != 51000:
        return
    from android.app import Activity
    if resultCode != Activity.RESULT_OK or data is None:
        return
    uri = data.getData()
    if uri is None:
        return
    _import_font_from_uri(uri)
