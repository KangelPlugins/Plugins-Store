class SoundDelegate(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def didReceivedNotification(self, id, account, args):
        if id != NotificationCenter.didReceiveNewMessages:
            return
        self.plugin._on_new_messages(account, args)


class _OnComplete(dynamic_proxy(MediaPlayer.OnCompletionListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onCompletion(self, mp):
        try:
            mp.release()
        except Exception:
            pass
        if getattr(self.plugin, "_player", None) is mp:
            self.plugin._player = None


class InChatSoundPlugin(BasePlugin):
    def on_plugin_load(self):
        self._delegate = None
        self._tone = None
        self._player = None
        self._sound_path = None
        self._last_play_ts = 0.0
        self._ensure_sound_file()
        self._setup_observer()

    def on_plugin_unload(self):
        self._remove_observer()
        self._release_player()
        if self._tone:
            try:
                self._tone.release()
            except Exception:
                pass
            self._tone = None

    def create_settings(self) -> List[Any]:
        return [
            Header(text="In-Chat Sound"),
            Switch(
                key="enabled",
                text="Включить звук в чате",
                default=True,
                subtext="Воспроизводить звук при новых сообщениях внутри открытого чата",
            ),
            Selector(
                key="sound_type",
                text="Звук",
                default=0,
                items=SOUND_NAMES,
                subtext="Telegram — ваш кастомный звук сообщения",
            ),
            Selector(
                key="volume",
                text="Громкость",
                default=7,
                items=[str(i) for i in range(1, 11)],
                subtext="1 — тихо, 10 — максимум",
            ),
            Text(
                text="Как работает",
                subtext="Личные чаты, только входящие, без спама. Группы и каналы отключены.",
            ),
        ]

    def _ensure_sound_file(self):
        try:
            cache = get_cache_dir()
            if not cache:
                ctx = ApplicationLoader.applicationContext
                cache = str(ctx.getCacheDir().getAbsolutePath())
            plugin_cache = os.path.join(str(cache), "in_chat_sound")
            ensure_dir_exists(plugin_cache)
            path = os.path.join(plugin_cache, "tg_message.mp3")
            need_write = True
            if os.path.isfile(path) and os.path.getsize(path) > 1000:
                need_write = False
            if need_write:
                raw = base64.b64decode("".join(_SOUND_B64))
                with open(path, "wb") as f:
                    f.write(raw)
            self._sound_path = path
        except Exception as e:
            self.log(f"Ensure sound file error: {e}")
            self._sound_path = None

    def _setup_observer(self):
        self._delegate = SoundDelegate(self)
        nc = get_notification_center()
        if nc:
            nc.addObserver(self._delegate, NotificationCenter.didReceiveNewMessages)

    def _remove_observer(self):
        if self._delegate:
            nc = get_notification_center()
            if nc:
                try:
                    nc.removeObserver(self._delegate, NotificationCenter.didReceiveNewMessages)
                except Exception:
                    pass
            self._delegate = None

    def _on_new_messages(self, account, args):
        if not self.get_setting("enabled", True):
            return
        try:
            fragment = get_last_fragment()
            if not fragment or not isinstance(fragment, ChatActivity):
                return

            dialog_id = self._read_long(args[0] if args is not None and len(args) >= 1 else 0)
            current_dialog = self._read_dialog_id(fragment)

            # Группы / каналы / супергруппы
            if dialog_id < 0 or current_dialog < 0:
                return

            # Другой чат
            if dialog_id != 0 and current_dialog != 0 and dialog_id != current_dialog:
                return

            try:
                if args is not None and len(args) >= 3 and args[2] is True:
                    return
            except Exception:
                pass

            # Блокируем звук только если все сообщения точно исходящие
            if self._all_known_outgoing(args):
                return

            now = time.time()
            if now - float(getattr(self, "_last_play_ts", 0) or 0) < 0.8:
                return
            self._last_play_ts = now

            run_on_ui_thread(lambda: self._play_sound())
        except Exception as e:
            self.log(f"InChatSound error: {e}")

    def _read_long(self, value):
        if value is None:
            return 0
        try:
            return int(value)
        except Exception:
            try:
                return int(value.longValue())
            except Exception:
                return 0

    def _read_dialog_id(self, fragment):
        for attr in ("dialogId", "dialog_id"):
            try:
                v = getattr(fragment, attr, None)
                if v is not None:
                    n = self._read_long(v)
                    if n != 0:
                        return n
            except Exception:
                pass
        try:
            if hasattr(fragment, "getDialogId"):
                return self._read_long(fragment.getDialogId())
        except Exception:
            pass
        return 0

    def _my_user_id(self):
        try:
            cfg = get_user_config()
            if cfg is None:
                return 0
            user = cfg.getCurrentUser()
            if user is None:
                return 0
            return int(user.id)
        except Exception:
            return 0

    def _all_known_outgoing(self, args):
        try:
            if args is None or len(args) < 2 or args[1] is None:
                return False
            messages = args[1]
            try:
                size = int(messages.size())
            except Exception:
                try:
                    size = len(messages)
                except Exception:
                    return False
            if size <= 0:
                return False

            my_id = self._my_user_id()
            found = 0
            for i in range(size):
                try:
                    msg_obj = messages.get(i)
                except Exception:
                    try:
                        msg_obj = messages[i]
                    except Exception:
                        return False
                if msg_obj is None:
                    return False
                if not self._is_outgoing(msg_obj, my_id):
                    return False
                found += 1
            return found > 0
        except Exception as e:
            self.log(f"all_known_outgoing error: {e}")
            return False

    def _is_outgoing(self, msg_obj, my_id=0):
        for method in ("isOut", "isOutOwner"):
            try:
                if hasattr(msg_obj, method):
                    v = getattr(msg_obj, method)()
                    if v is True or v == 1:
                        return True
                    if v is False or v == 0:
                        return False
            except Exception:
                pass

        owner = None
        try:
            owner = msg_obj.messageOwner
        except Exception:
            owner = getattr(msg_obj, "messageOwner", None)

        if owner is not None:
            try:
                v = owner.out
                if v is True or v == 1:
                    return True
                if v is False or v == 0:
                    return False
            except Exception:
                pass

            if my_id:
                try:
                    from_id = owner.from_id
                    if from_id is not None:
                        try:
                            uid = int(from_id.user_id)
                        except Exception:
                            uid = int(getattr(from_id, "user_id", 0) or 0)
                        if uid and uid == my_id:
                            return True
                except Exception:
                    pass
        return False

    def _release_player(self):
        if self._player:
            try:
                if self._player.isPlaying():
                    self._player.stop()
                self._player.release()
            except Exception:
                pass
            self._player = None

    def _play_sound(self):
        try:
            sound_type = int(self.get_setting("sound_type", 0))
            volume_level = int(self.get_setting("volume", 7))
            vol = max(0.1, min(1.0, volume_level / 10.0))

            if sound_type == 0:
                self._play_custom(vol)
            elif sound_type == 1:
                self._play_ios_like(vol)
            elif sound_type == 2:
                self._play_tone(ToneGenerator.TONE_PROP_BEEP, vol)
            elif sound_type == 3:
                self._play_tone(ToneGenerator.TONE_PROP_ACK, vol)
            else:
                self._play_tone(ToneGenerator.TONE_PROP_NACK, vol)
        except Exception as e:
            self.log(f"Play sound error: {e}")

    def _play_custom(self, volume):
        try:
            if not self._sound_path or not os.path.isfile(self._sound_path):
                self._ensure_sound_file()
            if not self._sound_path or not os.path.isfile(self._sound_path):
                self.log("Custom sound file missing")
                return

            self._release_player()
            player = MediaPlayer()
            self._player = player
            player.setDataSource(self._sound_path)
            player.setAudioStreamType(AudioManager.STREAM_NOTIFICATION)
            player.setVolume(float(volume), float(volume))
            player.setOnCompletionListener(_OnComplete(self))
            player.prepare()
            player.start()
        except Exception as e:
            self.log(f"Custom sound error: {e}")

    def _play_ios_like(self, volume):
        try:
            ctx = ApplicationLoader.applicationContext
            uri = RingtoneManager.getDefaultUri(RingtoneManager.TYPE_NOTIFICATION)
            ringtone = RingtoneManager.getRingtone(ctx, uri)
            if ringtone:
                ringtone.setVolume(volume)
                ringtone.play()
        except Exception:
            self._play_tone(ToneGenerator.TONE_PROP_BEEP, volume)

    def _play_tone(self, tone_type, volume):
        try:
            if self._tone is None:
                self._tone = ToneGenerator(AudioManager.STREAM_NOTIFICATION, 100)
            stream_vol = int(volume * 100)
            self._tone.setVolume(stream_vol)
            self._tone.startTone(tone_type, 150)
        except Exception as e:
            self.log(f"Tone error: {e}")
