__id__ = "mooninfo"
__name__ = "MoonInfo"
__author__ = "@CodedOwner & @MLPlugins"
__version__ = "1.0.0"
__app_version__ = ">=12.5.1"
__description__ = (
    "RU: Информация об клиенте\nИнформация в настройках exteraGram -> Информация\n\n"
    "EN: Information about client\nInformation in exteraGram Settings -> Information"
)
__priority__ = 50

from org.telegram.messenger import BuildVars
from org.telegram.ui.Components import (UItem,
                                        UniversalAdapter)
from ui.alert import AlertDialogBuilder
from java.lang import (Class as JClass,
                        Integer as JInteger, Float as JFloat,
                        String as JString, Boolean as JBoolean)
from java.util import ArrayList
from android.view import View
from dataclasses import dataclass
from typing import Any
from client_utils import get_last_fragment
from base_plugin import BasePlugin
import random
import weakref
import traceback

MainPreferencesActivity = JClass.\
    forName("com.exteragram.messenger."\
        "preferences."\
        "MainPreferencesActivity")

@dataclass
class ClientInfo:
    version: JInteger.TYPE
    version_str: JString
    is_beta: JBoolean.TYPE
    is_lite: JBoolean.TYPE
    github_url: JString
    is_logs_enabled: JBoolean.TYPE
    is_supports_passkeys: JBoolean.TYPE

Integer = JInteger.TYPE
Boolean = JBoolean.TYPE
Float = JFloat.TYPE

def _build_client_info() -> ClientInfo:
    client = ClientInfo(
        version=BuildVars.BUILD_VERSION,
        version_str=BuildVars.BUILD_VERSION_STRING,
        is_beta=BuildVars.DEBUG_VERSION,
        is_lite=BuildVars.IS_LITE_VERSION,
        github_url=BuildVars.GITHUB_APP_URL,
        is_logs_enabled=BuildVars.LOGS_ENABLED,
        is_supports_passkeys=BuildVars.SUPPORTS_PASSKEYS
    )
    return client

STRINGS = [
    ("Плагин загружен", "Plugin is loaded"),
    ("Плагин выгружен", "Plugin is unloaded"),
    ("Сборка", "Build"),
    ("Версия", "Version"),
    ("Бета", "Beta"),
    ("Lite", "Is Lite"),
    ("GitHub URL", "GitHub URL"),
    ("Включены логи", "Logs enabled"),
    ("Поддерживает ключи доступа", "Supports a passkeys"),
    ("Информация", "Information")
]

RU = 0
EN = 1

def _get_lang() -> int:
    from java.util import Locale

    default = Locale.getDefault()
    lang = default.getLanguage()

    return RU if lang.startswith("ru") else EN

lang = _get_lang()

def _build_info_str() -> str:
    client = _build_client_info()

    info = f"""{STRINGS[2][lang]}: {str(client.version)}
{STRINGS[3][lang]}: {client.version_str}
{STRINGS[4][lang]}: {str(client.is_beta)}
{STRINGS[5][lang]}: {str(client.is_lite)}
{STRINGS[6][lang]}: {client.github_url}
{STRINGS[7][lang]}: {str(client.is_logs_enabled)}
{STRINGS[8][lang]}: {str(client.is_supports_passkeys)}"""
    return info

UItemButton = Any

button_id = random.randint(100000000, 999999999)

class FillHook:
    def __init__(self, plugin):
        self._plugin_ref = weakref.ref(plugin)

    def after_hooked_method(self, param):
        items = param.args[0]
        items.add(self._build_info_button())

    def _build_info_button(self) -> UItemButton:
        button = UItem.asButton(button_id, STRINGS[9][lang])
        return button

class OnClickHook:
    def __init__(self, plugin):
        self._plugin_ref = weakref.ref(plugin)

    def before_hooked_method(self, param):
        plugin = self._plugin_ref()
        item = param.args[0]

        if item.id == button_id:
            plugin._show_info_dialog()

            param.setResult(None)
            return None

class MoonInfo(BasePlugin):
    def __init__(self):
        super().__init__()

        self.hooks = []

    def log(self, msg: str):
        from android_utils import log as logcat
        logcat(f"[MoonInfo] {msg}")

    def on_plugin_load(self):
        self.log(STRINGS[0][lang])
        self._install_hooks()

    def on_plugin_unload(self):
        self.log(STRINGS[1][lang])
        self._remove_hooks()

    def _install_hooks(self):
        self._install_fill_hook()
        self._install_on_click_hook()

    def _remove_hooks(self):
        try:
            for obj in self.hooks:
                if obj:
                    self.unhook_method(obj)
        except Exception as ex:
            self.log(str(ex))
            self.log(traceback.format_exc())

    def _install_fill_hook(self):
        try:
            fill_items_method = MainPreferencesActivity.\
                                    getDeclaredMethod("fillItems",
                                        [ArrayList, UniversalAdapter])
            self.hooks.append(self.hook_method(fill_items_method, FillHook(self)))
        except Exception as ex:
            self.log(str(ex))
            self.log(traceback.format_exc())

    def _install_on_click_hook(self):
        try:
            on_click_method = MainPreferencesActivity.\
                                    getDeclaredMethod("onClick",
                                        [UItem, View,
                                            Integer, Float, Float])
            self.hooks.append(self.hook_method(on_click_method, OnClickHook(self)))
        except Exception as ex:
            self.log(str(ex))
            self.log(traceback.format_exc())

    def _show_info_dialog(self):
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity()

            builder = AlertDialogBuilder(activity)

            def on_positive_click(bld: AlertDialogBuilder, which: int):
                bld.dismiss()

            def on_negative_click(bld: AlertDialogBuilder, which: int):
                bld.dismiss()

            builder.set_title(STRINGS[9][lang])
            builder.set_message(_build_info_str())
            builder.set_positive_button("OK", on_positive_click)
            builder.set_negative_button("Cancel", on_negative_click)
            builder.create()
            builder.set_cancelable(True)
            builder.show()
        except Exception as ex:
            self.log(str(ex))
            self.log(traceback.format_exc())
