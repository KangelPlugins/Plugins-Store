_UNCACHED = object()
_NO_FIELD = object()
_USE_PRIVATE_FIELD = object()
_FIELD_CACHE = {}
_DECLARED_FIELDS_CACHE = {}
_CONSTRUCTOR_CACHE = {}
_ENTITY_LIST_FIELD_CACHE = {}
_CUSTOM_ID_FIELD_CACHE = {}


def dp(v):
    return AndroidUtilities.dp(v)


def _usage_spannable():
    parts = []
    heading_ranges = []
    cursor = 0
    for index, (heading, body) in enumerate(USAGE_SECTIONS):
        if index:
            parts.append("\n\n")
            cursor += 2
        start = cursor
        parts.append(heading)
        cursor += len(heading)
        heading_ranges.append((start, cursor))
        parts.append("\n")
        cursor += 1
        parts.append(body)
        cursor += len(body)

    value = SpannableString("".join(parts))
    blue = Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)
    for start, end in heading_ranges:
        value.setSpan(
            ForegroundColorSpan(blue),
            start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE,
        )
        value.setSpan(
            StyleSpan(Typeface.BOLD),
            start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE,
        )
    return value


def _create_usage_setting_view(context, list_view, current_account, class_guid, resources_provider):
    text_view = TextView(context)
    text_view.setTextSize(1, 14.0)
    text_view.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
    text_view.setGravity(Gravity.LEFT)
    text_view.setLineSpacing(dp(2), 1.0)
    text_view.setPadding(dp(21), dp(6), dp(21), dp(18))
    return text_view


def _bind_usage_setting_view(view, item, divider, adapter, list_view):
    view.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
    view.setText(_usage_spannable())


USAGE_SETTING_FACTORY = SimpleSettingFactory(
    _create_usage_setting_view,
    _bind_usage_setting_view,
    is_clickable=False,
    is_shadow=False,
)


def click_listener(fn):
    class _C(dynamic_proxy(View.OnClickListener)):
        def onClick(self, v):
            try:
                fn()
            except Exception:
                pass
    return _C()


def long_click_listener(fn):
    class _C(dynamic_proxy(View.OnLongClickListener)):
        def onLongClick(self, v):
            try:
                fn()
            except Exception:
                pass
            return True
    return _C()


def _java_class_name(obj):
    if obj is None:
        return ""
    try:
        return str(obj.getClass().getName() or "")
    except Exception:
        try:
            return str(type(obj).__name__ or "")
        except Exception:
            return ""


def _class_key(obj):
    return _java_class_name(obj) or str(type(obj))


def _java_field(obj, name, default=None):
    """Read a Java field and cache reflection metadata by runtime class."""
    if obj is None:
        return default
    try:
        value = getattr(obj, name)
        return default if value is None else value
    except Exception:
        pass

    key = (_class_key(obj), str(name))
    cached = _FIELD_CACHE.get(key, _UNCACHED)
    if cached is _NO_FIELD:
        return default
    if cached is _USE_PRIVATE_FIELD:
        if get_private_field is not None:
            try:
                value = get_private_field(obj, name)
                return default if value is None else value
            except Exception:
                return default
        return default
    if cached is not _UNCACHED:
        try:
            value = cached.get(obj)
            return default if value is None else value
        except Exception:
            _FIELD_CACHE.pop(key, None)

    try:
        clazz = obj.getClass()
        while clazz is not None:
            try:
                field = clazz.getDeclaredField(name)
                field.setAccessible(True)
                _FIELD_CACHE[key] = field
                value = field.get(obj)
                return default if value is None else value
            except Exception:
                try:
                    clazz = clazz.getSuperclass()
                except Exception:
                    clazz = None
    except Exception:
        pass

    if get_private_field is not None:
        try:
            value = get_private_field(obj, name)
            if value is not None:
                _FIELD_CACHE[key] = _USE_PRIVATE_FIELD
                return value
        except Exception:
            pass
    _FIELD_CACHE[key] = _NO_FIELD
    return default


def _to_int64(value, default=0):
    if value is None:
        return default
    for method_name in ("longValue", "intValue"):
        try:
            value = getattr(value, method_name)()
            break
        except Exception:
            pass
    try:
        return int(value)
    except Exception:
        try:
            return int(str(value))
        except Exception:
            return default


RECENT_OWNED_SET_TTL = 7 * 24 * 60 * 60
RECENT_OWNED_SET_LIMIT = 50


def _merge_owned_sets(api_owned, recent_owned):
    """Merge API-owned sets with locally created sets; recent data wins."""
    merged = {}
    order = []
    for source in (list(api_owned or []), list(recent_owned or [])):
        for raw in source:
            if not isinstance(raw, dict):
                continue
            item = dict(raw)
            set_id = _to_int64(item.get("id"), 0)
            short_name = str(item.get("short_name") or "").strip().lower()
            key = ("id", set_id) if set_id else (("short", short_name) if short_name else None)
            if key is None:
                continue
            if key not in merged:
                order.append(key)
                merged[key] = item
            else:
                combined = dict(merged[key])
                combined.update({k: v for k, v in item.items() if v not in (None, "")})
                merged[key] = combined
    result = [merged[key] for key in order]
    result.sort(key=lambda item: str(item.get("title") or "").lower())
    return result


def _decode_recent_owned_sets(raw_value):
    try:
        data = json.loads(str(raw_value or "[]"))
    except Exception:
        return []
    if not isinstance(data, list):
        return []
    now = int(time.time())
    result = []
    for item in data:
        if not isinstance(item, dict):
            continue
        saved_at = _to_int64(item.get("saved_at"), now)
        if saved_at and now - saved_at > RECENT_OWNED_SET_TTL:
            continue
        if _to_int64(item.get("id"), 0) or str(item.get("short_name") or "").strip():
            result.append(dict(item))
    return result[:RECENT_OWNED_SET_LIMIT]


def _should_request_next_owned_page(page_size, last_id, offset_id):
    """Continue getMyStickers pagination without relying on response.count."""
    try:
        return (
            int(page_size) >= 100
            and int(last_id) != 0
            and int(last_id) != int(offset_id)
        )
    except Exception:
        return False


def _declared_field_objects(obj):
    if obj is None:
        return []
    key = _class_key(obj)
    cached = _DECLARED_FIELDS_CACHE.get(key)
    if cached is not None:
        return cached

    result = []
    seen = set()
    try:
        clazz = obj.getClass()
        while clazz is not None:
            try:
                fields = clazz.getDeclaredFields()
                try:
                    count = len(fields)
                except Exception:
                    count = int(fields.length)
                for i in range(count):
                    try:
                        field = fields[i]
                        name = str(field.getName())
                        if name in seen:
                            continue
                        seen.add(name)
                        field.setAccessible(True)
                        result.append((name, str(field.getType().getName()), field))
                    except Exception:
                        pass
            except Exception:
                pass
            try:
                clazz = clazz.getSuperclass()
            except Exception:
                clazz = None
    except Exception:
        pass
    _DECLARED_FIELDS_CACHE[key] = result
    return result


def _java_declared_fields(obj):
    """Return cached runtime field metadata with values for this object."""
    result = []
    for name, type_name, field in _declared_field_objects(obj):
        try:
            result.append((name, type_name, field.get(obj)))
        except Exception:
            pass
    return result


def _tl_constructor(obj):
    if obj is None:
        return 0
    key = _class_key(obj)
    if key in _CONSTRUCTOR_CACHE:
        return _CONSTRUCTOR_CACHE[key]
    value = 0
    try:
        value = int(obj.getConstructor())
    except Exception:
        try:
            clazz = obj.getClass()
            field = clazz.getDeclaredField("constructor")
            field.setAccessible(True)
            value = int(field.get(None))
        except Exception:
            value = 0
    if value >= 2147483648:
        value -= 4294967296
    _CONSTRUCTOR_CACHE[key] = value
    return value


CUSTOM_EMOJI_ENTITY_CONSTRUCTOR = -925956616  # c8cf05f8


def _looks_like_message_entity(obj):
    if obj is None:
        return False
    if "messageentity" in _java_class_name(obj).lower():
        return True
    if _tl_constructor(obj) == CUSTOM_EMOJI_ENTITY_CONSTRUCTOR:
        return True
    try:
        return isinstance(obj, TLRPC.MessageEntity)
    except Exception:
        return False


def _java_values(value):
    """Convert Java ArrayList/Vector, Python sequences or iterables to list."""
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        return list(value)
    try:
        return [value.get(i) for i in range(int(value.size()))]
    except Exception:
        pass
    try:
        return list(value)
    except Exception:
        return []


def _message_entity_values(message):
    """Return entities while avoiding a full reflection scan for empty messages."""
    owner = _java_field(message, "messageOwner", None)
    if owner is not None:
        raw = _java_field(owner, "entities", _UNCACHED)
        if raw is not _UNCACHED:
            return _java_values(raw), "messageOwner.entities"

    raw = _java_field(message, "entities", _UNCACHED)
    if raw is not _UNCACHED:
        return _java_values(raw), "entities"

    key = _class_key(message)
    cached_name = _ENTITY_LIST_FIELD_CACHE.get(key)
    if cached_name:
        values = _java_values(_java_field(message, cached_name, None))
        if not values or any(_looks_like_message_entity(item) for item in values[:8]):
            return values, cached_name
        _ENTITY_LIST_FIELD_CACHE.pop(key, None)

    for name, type_name, value in _java_declared_fields(message):
        if "List" not in type_name and "ArrayList" not in type_name:
            continue
        values = _java_values(value)
        if values and any(_looks_like_message_entity(item) for item in values[:8]):
            _ENTITY_LIST_FIELD_CACHE[key] = name
            return values, name
    return [], ""


def _custom_emoji_id(entity):
    """Read document_id using known names, TL constructor, or cached long field."""
    if entity is None:
        return 0
    for field_name in ("document_id", "documentId", "documentID"):
        value = _to_int64(_java_field(entity, field_name, 0), 0)
        if value:
            return value

    normalized = "".join(ch for ch in _java_class_name(entity).lower() if ch.isalnum())
    is_custom = (
        "messageentitycustomemoji" in normalized
        or _tl_constructor(entity) == CUSTOM_EMOJI_ENTITY_CONSTRUCTOR
    )
    if not is_custom:
        return 0

    key = _class_key(entity)
    cached_name = _CUSTOM_ID_FIELD_CACHE.get(key)
    if cached_name:
        value = _to_int64(_java_field(entity, cached_name, 0), 0)
        if value:
            return value
        _CUSTOM_ID_FIELD_CACHE.pop(key, None)

    long_values = []
    for name, type_name, value in _java_declared_fields(entity):
        if type_name not in ("long", "java.lang.Long"):
            continue
        number = _to_int64(value, 0)
        if not number:
            continue
        if "document" in name.lower():
            _CUSTOM_ID_FIELD_CACHE[key] = name
            return number
        long_values.append((name, number))
    if len(long_values) == 1:
        _CUSTOM_ID_FIELD_CACHE[key] = long_values[0][0]
        return long_values[0][1]
    return 0


def _utf16_slice(text, offset, length):
    """Slice Telegram entity text using UTF-16 code-unit offsets."""
    try:
        raw = str(text or "").encode("utf-16-le")
        start = max(0, int(offset)) * 2
        end = start + max(0, int(length)) * 2
        return raw[start:end].decode("utf-16-le", errors="ignore")
    except Exception:
        return ""

class ChatEmojisFeature:
    def __init__(self, host):
        self._host = host

    def __getattr__(self, name):
        return getattr(self._host, name)

    MENU_ITEM_ID = "chat_emoji_working_18_open"

    def on_plugin_load(self):
        self._emoji_cache = {}
        self._emoji_generation = 0
        self._active_emoji_dialog = 0
        self._active_chat_token = None
        self._sender_name_cache = {}
        self._set_title_cache = {}
        self._pending_create_callbacks = {}
        self._recent_owned_sets = self._load_recent_owned_sets()
        self._lock = threading.Lock()
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="Emoji чата",
            on_click=self._on_emoji_menu_click,
            icon="input_smile",
            item_id=self.MENU_ITEM_ID,
        ))

    def on_plugin_unload(self):
        with self._lock:
            self._emoji_cache.clear()
        self._sender_name_cache.clear()
        self._set_title_cache.clear()
        self._pending_create_callbacks.clear()

    RECENT_OWNED_SETTING_KEY = "recent_owned_emoji_sets"

    def _load_recent_owned_sets(self):
        try:
            return _decode_recent_owned_sets(
                self.get_setting(self.RECENT_OWNED_SETTING_KEY, "[]")
            )
        except Exception:
            return []

    def _save_recent_owned_sets(self):
        try:
            value = json.dumps(
                list(getattr(self, "_recent_owned_sets", []) or [])[:RECENT_OWNED_SET_LIMIT],
                ensure_ascii=False,
                separators=(",", ":"),
            )
            self.set_setting(self.RECENT_OWNED_SETTING_KEY, value, reload_settings=False)
        except Exception as e:
            self.log(f"[ChatEmoji] save recent owned sets: {e}")

    def _remember_recent_owned_set(self, target):
        item = dict(target or {})
        if not _to_int64(item.get("id"), 0) and not str(item.get("short_name") or "").strip():
            return
        item["saved_at"] = int(time.time())
        current = list(getattr(self, "_recent_owned_sets", []) or [])
        self._recent_owned_sets = _merge_owned_sets(current, [item])[-RECENT_OWNED_SET_LIMIT:]
        self._save_recent_owned_sets()

    def _merge_recent_owned_sets(self, owned):
        current = list(getattr(self, "_recent_owned_sets", []) or [])
        merged = _merge_owned_sets(owned, current)
        api_ids = {_to_int64(item.get("id"), 0) for item in list(owned or [])}
        if api_ids:
            self._recent_owned_sets = [
                item for item in current
                if _to_int64(item.get("id"), 0) not in api_ids
            ]
            self._save_recent_owned_sets()
        return merged

    def _on_emoji_menu_click(self, context):
        try:
            dialog_id = self._dialog_id_from_context(context)
            activity = self._activity()
            if dialog_id == 0 or activity is None:
                BulletinHelper.show_error("Не удалось определить чат")
                return
            self._open_emoji_sheet(activity, dialog_id)
        except Exception as e:
            self.log(f"[ChatEmoji] menu click: {e}")

    def _dialog_id_from_context(self, context):
        for key in ("dialog_id", "dialogId"):
            try:
                val = context.get(key)
                if val is not None:
                    return int(val)
            except Exception:
                pass
        try:
            chat = context.get("chat")
            if chat is not None:
                return -int(chat.id)
        except Exception:
            pass
        try:
            user = context.get("user")
            if user is not None:
                return int(user.id)
        except Exception:
            pass
        fragment = get_last_fragment()
        if fragment and hasattr(fragment, "getDialogId"):
            try:
                return int(fragment.getDialogId())
            except Exception:
                pass
        return 0

    def _activity(self):
        f = get_last_fragment()
        return f.getParentActivity() if f is not None else None

    def _jfield(self, obj, name):
        # Ответы и элементы Vector могут быть видны Python как базовый TLObject.
        # Читаем поле из реального Java-класса и всей цепочки наследования.
        return _java_field(obj, name, None)

    def _empty_emoji_state(self, generation):
        return {
            "generation": generation,
            "items": {},
            "items_revision": 0,
            "sorted_cache": {},
            "pack_label_cache": (-1, {}),
            "offset_id": 0,
            "finished": False,
            "scanned": 0,
            "scanning": False,
            "scan_budget": 0,
            "resolving": False,
            "resolve_queue": [],
            "resume_scan": False,
            "request_error": "",
            "seen_occurrences": set(),
        }

    def _mark_items_changed(self, state):
        state["items_revision"] = int(state.get("items_revision", 0)) + 1
        state["sorted_cache"] = {}
        state["pack_label_cache"] = (-1, {})

    def _new_emoji_session(self, dialog_id):
        # Each new chat session starts at offset_id=0 and invalidates old callbacks.
        with self._lock:
            self._emoji_generation += 1
            generation = self._emoji_generation
            self._active_emoji_dialog = int(dialog_id)
            self._emoji_cache.clear()
            self._emoji_cache[int(dialog_id)] = self._empty_emoji_state(generation)
            return generation

    def _current_chat_token(self):
        fragment = get_last_fragment()
        if fragment is None:
            return "none"
        try:
            return f"{_java_class_name(fragment)}:{int(fragment.hashCode())}"
        except Exception:
            try:
                return f"{_java_class_name(fragment)}:{str(fragment)}"
            except Exception:
                return str(id(fragment))

    def _reusable_emoji_session(self, dialog_id, chat_token):
        """Reuse only completed/non-busy results from the same ChatActivity.

        The first search always enters the proven scan path. Reuse is
        applied only after that path has already produced visible results.
        """
        with self._lock:
            state = self._emoji_cache.get(int(dialog_id))
            if state is None:
                return None
            if int(dialog_id) != int(self._active_emoji_dialog):
                return None
            if chat_token != self._active_chat_token:
                return None
            if not state.get("items"):
                return None
            if state.get("scanning") or state.get("resolving"):
                return None
            return int(state.get("generation", self._emoji_generation))

    def _emoji_session_valid(self, dialog_id, ui):
        try:
            return (
                int(dialog_id) == int(self._active_emoji_dialog)
                and int(ui.get("generation", -1)) == int(self._emoji_generation)
            )
        except Exception:
            return False

    def _emoji_cache_for(self, dialog_id):
        with self._lock:
            entry = self._emoji_cache.get(int(dialog_id))
            if entry is None:
                entry = self._empty_emoji_state(self._emoji_generation)
                self._emoji_cache[int(dialog_id)] = entry
            return entry

    def _scan_depth(self):
        try:
            return max(PAGE_SIZE, int(self.get_setting("scan_depth", str(DEFAULT_SCAN_DEPTH))))
        except Exception:
            return DEFAULT_SCAN_DEPTH

    def _start_emoji_scan(self, dialog_id, ui):
        if not self._emoji_session_valid(dialog_id, ui):
            return
        state = self._emoji_cache_for(dialog_id)
        pending = [
            doc_id for doc_id, entry in state["items"].items()
            if entry.get("doc") is None
        ]
        if pending and not state["resolving"]:
            if not state["scanning"] and not state["finished"]:
                state["scanning"] = True
                state["scan_budget"] = self._scan_depth()
            self._queue_emoji_documents(
                dialog_id, ui, pending, bool(state["scanning"])
            )
            return
        if state["scanning"] or state["finished"] or state["resolving"]:
            self._refresh_emoji_ui(dialog_id, ui)
            return
        state["scanning"] = True
        state["scan_budget"] = self._scan_depth()
        self._request_emoji_page(dialog_id, ui)

    def _request_emoji_page(self, dialog_id, ui):
        if not self._emoji_session_valid(dialog_id, ui):
            return
        state = self._emoji_cache_for(dialog_id)
        state["request_error"] = ""
        try:
            def on_response(response, error):
                self._on_emoji_page(dialog_id, ui, response, error)

            self._request_history_page_shared(
                dialog_id,
                int(state["offset_id"]),
                on_response,
            )
        except Exception as e:
            state["scanning"] = False
            state["request_error"] = str(e)
            self.log(f"[ChatEmoji] shared history request: {e}")
            run_on_ui_thread(lambda: self._refresh_emoji_ui(dialog_id, ui))

    def _on_emoji_page(self, dialog_id, ui, response, error):
        if not self._emoji_session_valid(dialog_id, ui):
            return
        state = self._emoji_cache_for(dialog_id)
        try:
            if error is not None:
                state["scanning"] = False
                state["request_error"] = str(self._jfield(error, "text") or error)
                if "FLOOD_WAIT" in state["request_error"]:
                    BulletinHelper.show_error("Telegram просит подождать — попробуй позже")
                self._refresh_emoji_ui(dialog_id, ui)
                return

            direct_messages = _java_field(response, "messages", None)
            messages = _java_values(
                direct_messages if direct_messages is not None
                else self._jfield(response, "messages")
            )
            count = len(messages)
            min_id = None
            new_ids = []
            queued = set(state["resolve_queue"])
            changed = False
            for msg in messages:
                try:
                    mid = int(self._jfield(msg, "id") or 0)
                    if mid and (min_id is None or mid < min_id):
                        min_id = mid
                    if self._consume_emoji_message(state, msg, new_ids, queued):
                        changed = True
                except Exception as e:
                    self.log(f"[ChatEmoji] message parse: {e}")
            if changed:
                self._mark_items_changed(state)

            state["scanned"] += count
            state["scan_budget"] -= count
            if count < PAGE_SIZE or min_id is None or min_id <= 1:
                state["finished"] = True
                state["scanning"] = False
            else:
                state["offset_id"] = min_id
                if state["scan_budget"] <= 0:
                    state["scanning"] = False

            continue_scan = bool(state["scanning"])
            if new_ids:
                # Resolve custom Emoji documents independently while history scanning continues.
                self._queue_emoji_documents(dialog_id, ui, new_ids, False)
            self._refresh_emoji_ui(dialog_id, ui)
            if continue_scan:
                self._request_emoji_page(dialog_id, ui)
        except Exception as e:
            state["scanning"] = False
            state["request_error"] = str(e)
            self.log(f"[ChatEmoji] scan: {e}")
            self._refresh_emoji_ui(dialog_id, ui)

    def _consume_emoji_message(self, state, msg, new_ids, queued=None):
        entities, _ = _message_entity_values(msg)
        if not entities:
            return False

        msg_id = _to_int64(self._jfield(msg, "id"), 0)
        msg_date = _to_int64(self._jfield(msg, "date"), 0)
        message_text = str(self._jfield(msg, "message") or "")
        if queued is None:
            queued = set(state["resolve_queue"])
            queued.update(new_ids)

        changed = False
        for entity in entities:
            doc_id = _custom_emoji_id(entity)
            if not doc_id:
                continue
            offset = _to_int64(self._jfield(entity, "offset"), 0)
            length = _to_int64(self._jfield(entity, "length"), 0)
            occurrence = (msg_id, int(doc_id), offset)
            if occurrence in state["seen_occurrences"]:
                continue
            state["seen_occurrences"].add(occurrence)
            fallback = _utf16_slice(message_text, offset, length)

            entry = state["items"].get(doc_id)
            if entry is not None:
                entry["count"] += 1
                if not entry.get("emoji") and fallback:
                    entry["emoji"] = fallback
                if entry.get("doc") is None and doc_id not in queued:
                    new_ids.append(doc_id)
                    queued.add(doc_id)
                changed = True
                continue

            state["items"][doc_id] = {
                "doc": None,
                "doc_id": doc_id,
                "input_set": None,
                "set_id": 0,
                "set_hash": 0,
                "emoji": fallback,
                "sender_id": self._sender_id(msg),
                "date": msg_date,
                "msg_id": msg_id,
                "count": 1,
                "animated": True,
                "free": False,
                "text_color": False,
            }
            if doc_id not in queued:
                new_ids.append(doc_id)
                queued.add(doc_id)
            changed = True

        return changed

    def _queue_emoji_documents(self, dialog_id, ui, doc_ids, resume_scan):
        if not self._emoji_session_valid(dialog_id, ui):
            return
        state = self._emoji_cache_for(dialog_id)
        queued = set(state["resolve_queue"])
        for doc_id in doc_ids:
            doc_id = int(doc_id)
            entry = state["items"].get(doc_id)
            if entry is not None and entry.get("doc") is None and doc_id not in queued:
                state["resolve_queue"].append(doc_id)
                queued.add(doc_id)
        state["resume_scan"] = bool(state["resume_scan"] or resume_scan)
        if not state["resolving"]:
            self._request_emoji_documents(dialog_id, ui)

    def _request_emoji_documents(self, dialog_id, ui):
        if not self._emoji_session_valid(dialog_id, ui):
            return
        state = self._emoji_cache_for(dialog_id)
        if not state["resolve_queue"]:
            state["resolving"] = False
            should_resume = bool(state["resume_scan"] and state["scanning"])
            state["resume_scan"] = False
            self._refresh_emoji_ui(dialog_id, ui)
            if should_resume:
                self._request_emoji_page(dialog_id, ui)
            return

        batch = state["resolve_queue"][:100]
        del state["resolve_queue"][:len(batch)]
        was_resolving = bool(state["resolving"])
        state["resolving"] = True
        if not was_resolving:
            self._refresh_emoji_ui(dialog_id, ui)
        try:
            req = TLRPC.TL_messages_getCustomEmojiDocuments()
            ids = self._jfield(req, "document_id")
            if ids is None:
                ids = ArrayList()
                req.document_id = ids
            else:
                try:
                    ids.clear()
                except Exception:
                    ids = ArrayList()
                    req.document_id = ids
            for doc_id in batch:
                ids.add(Long.valueOf(int(doc_id)))
            state["request_error"] = ""

            def on_response(response, error):
                run_on_ui_thread(
                    lambda: self._on_emoji_documents(
                        dialog_id, ui, batch, response, error
                    )
                )

            send_request(req, on_response)
        except Exception as e:
            state["resolve_queue"] = batch + state["resolve_queue"]
            state["resolving"] = False
            state["scanning"] = False
            self.log(f"[ChatEmoji] document request: {e}")
            run_on_ui_thread(lambda: self._refresh_emoji_ui(dialog_id, ui))

    def _on_emoji_documents(self, dialog_id, ui, batch, response, error):
        if not self._emoji_session_valid(dialog_id, ui):
            return
        state = self._emoji_cache_for(dialog_id)
        if error is not None:
            state["resolving"] = False
            state["request_error"] = str(self._jfield(error, "text") or error)
            self.log(f"[ChatEmoji] getCustomEmojiDocuments: {state['request_error']}")
            BulletinHelper.show_error("Emoji найдены, но Telegram не отдал их документы")
            self._refresh_emoji_ui(dialog_id, ui)
            return
        changed = False
        try:
            documents = self._jfield(response, "objects")
            if documents is None:
                documents = response
            for doc in _java_values(documents):
                if self._apply_emoji_document(state, doc):
                    changed = True
            if changed:
                self._mark_items_changed(state)
        except Exception as e:
            self.log(f"[ChatEmoji] documents response: {e}")
        self._request_emoji_documents(dialog_id, ui)

    def _apply_emoji_document(self, state, doc):
        # Vector elements may be exposed as base TLObject, so fields are reflected.
        doc_id = int(self._jfield(doc, "id") or 0)
        entry = state["items"].get(doc_id)
        if entry is None:
            return False
        attr = None
        for candidate in _java_values(self._jfield(doc, "attributes")):
            normalized = "".join(
                ch for ch in _java_class_name(candidate).lower() if ch.isalnum()
            )
            if "documentattributecustomemoji" in normalized:
                attr = candidate
                break
            if (self._jfield(candidate, "stickerset") is not None
                    and self._jfield(candidate, "alt") is not None):
                attr = candidate
        sset = self._jfield(attr, "stickerset") if attr is not None else None
        mime = str(self._jfield(doc, "mime_type") or "")
        entry.update({
            "doc": doc,
            "input_set": sset,
            "set_id": int(self._jfield(sset, "id") or 0) if sset is not None else 0,
            "set_hash": int(self._jfield(sset, "access_hash") or 0) if sset is not None else 0,
            "emoji": str(self._jfield(attr, "alt") or "") if attr is not None else "",
            "animated": ("tgs" in mime) or ("webm" in mime) or ("video" in mime),
            "free": bool(self._jfield(attr, "free")) if attr is not None else False,
            "text_color": bool(self._jfield(attr, "text_color")) if attr is not None else False,
        })
        return True

    def _sender_id(self, msg):
        fid = self._jfield(msg, "from_id")
        if fid is not None:
            uid = _to_int64(self._jfield(fid, "user_id"), 0)
            if uid:
                return uid
            cid = _to_int64(self._jfield(fid, "channel_id"), 0)
            if cid:
                return -cid
        return 0

    def _sender_name(self, sender_id):
        if not sender_id:
            return "Аноним"
        cache = self._sender_name_cache
        if sender_id in cache:
            return cache[sender_id]
        result = str(sender_id)
        try:
            mc = get_messages_controller()
            if sender_id > 0:
                user = mc.getUser(sender_id)
                if user is not None:
                    name = f"{getattr(user, 'first_name', '') or ''} {getattr(user, 'last_name', '') or ''}".strip()
                    if name:
                        result = name
            else:
                chat = mc.getChat(-sender_id)
                if chat is not None and getattr(chat, "title", None):
                    result = str(chat.title)
        except Exception:
            pass
        cache[sender_id] = result
        return result

    def _set_title(self, set_id):
        set_id = int(set_id or 0)
        if not set_id:
            return None
        cache = self._set_title_cache
        if set_id in cache:
            return cache[set_id]
        title = None
        try:
            sset = MediaDataController.getInstance(
                UserConfig.selectedAccount
            ).getStickerSetById(set_id)
            if sset is not None and getattr(sset, "set", None) is not None:
                title = str(sset.set.title)
        except Exception:
            pass
        cache[set_id] = title
        return title

    def _open_emoji_sheet(self, activity, dialog_id):
        chat_token = self._current_chat_token()
        self._activate_history_session(dialog_id, chat_token)
        generation = self._reusable_emoji_session(dialog_id, chat_token)
        reused = generation is not None
        if not reused:
            # This is the exact session entry used by the working build:
            # clear state, generation++, offset_id=0, then run its scanner.
            generation = self._new_emoji_session(dialog_id)
            self._active_chat_token = chat_token
        else:
            self._active_emoji_dialog = int(dialog_id)

        ui = {
            "grid": bool(self.get_setting("default_grid", False)),
            "packs_only": False,
            "sort": str(self.get_setting("default_sort", "date")),
            "show_pack_numbers": bool(self.get_setting("pack_numbering", True)),
            "activity": activity,
            "dialog_id": dialog_id,
            "generation": generation,
        }
        if ui["sort"] not in SORT_MODES:
            ui["sort"] = "date"

        root = LinearLayout(activity)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setBackgroundColor(Theme.getColor(Theme.key_dialogBackground))
        root.setLayoutParams(FrameLayout.LayoutParams(-1, -1))
        root.addView(self._build_emoji_header(activity, ui))

        status_row = LinearLayout(activity)
        status_row.setOrientation(LinearLayout.HORIZONTAL)
        status_row.setGravity(Gravity.CENTER_VERTICAL)
        status_row.setPadding(dp(16), dp(2), dp(16), dp(2))
        progress = ProgressBar(activity)
        plp = LinearLayout.LayoutParams(dp(14), dp(14))
        plp.setMargins(0, 0, dp(8), 0)
        status_row.addView(progress, plp)
        status_tv = TextView(activity)
        status_tv.setTextSize(1, 12.0)
        status_tv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
        status_row.addView(status_tv)
        root.addView(status_row)
        ui["progress"] = progress
        ui["status"] = status_tv

        scroll = ScrollView(activity)

        class ScrollGuard(dynamic_proxy(View.OnTouchListener)):
            def onTouch(s, v, event):
                try:
                    action = event.getAction()
                    if action == MotionEvent.ACTION_DOWN:
                        v.getParent().requestDisallowInterceptTouchEvent(True)
                    elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        v.getParent().requestDisallowInterceptTouchEvent(False)
                except Exception:
                    pass
                return False
        scroll.setOnTouchListener(ScrollGuard())

        content = LinearLayout(activity)
        content.setOrientation(LinearLayout.VERTICAL)
        content.setPadding(dp(10), dp(6), dp(10), dp(16))
        scroll.addView(content)
        root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1.0))
        ui["content"] = content

        sheet = BottomSheet(activity, False)
        sheet.setCustomView(root)
        ui["sheet"] = sheet
        sheet.show()

        self._refresh_emoji_ui(dialog_id, ui)
        if not reused:
            self._start_emoji_scan(dialog_id, ui)
        else:
            state = self._emoji_cache_for(dialog_id)
            pending = [
                doc_id for doc_id, entry in state["items"].items()
                if entry.get("doc") is None
            ]
            if pending:
                self._queue_emoji_documents(dialog_id, ui, pending, False)

    def _build_emoji_header(self, activity, ui):
        wrap = LinearLayout(activity)
        wrap.setOrientation(LinearLayout.VERTICAL)

        handle = View(activity)
        handle.setBackgroundDrawable(Theme.createRoundRectDrawable(
            dp(2), Theme.getColor(Theme.key_sheet_scrollUp)))
        hlp = LinearLayout.LayoutParams(dp(34), dp(4))
        hlp.gravity = Gravity.CENTER_HORIZONTAL
        hlp.setMargins(0, dp(8), 0, 0)
        wrap.addView(handle, hlp)

        header = LinearLayout(activity)
        header.setOrientation(LinearLayout.HORIZONTAL)
        header.setGravity(Gravity.CENTER_VERTICAL)
        header.setPadding(dp(18), dp(8), dp(10), dp(6))

        title = TextView(activity)
        title.setText("Emoji чата")
        title.setTextSize(1, 19.0)
        title.setTypeface(Typeface.DEFAULT_BOLD)
        title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        header.addView(title, LinearLayout.LayoutParams(0, -2, 1.0))

        ui["btn_sort"] = self._header_button(
            activity, header, "⇅", lambda: self._cycle_emoji_sort(ui))
        ui["btn_packs"] = self._header_button(
            activity, header, "▤", lambda: self._toggle_emoji_packs(ui))
        ui["btn_mode"] = self._header_button(
            activity, header, "▦", lambda: self._toggle_emoji_mode(ui))
        self._header_button(activity, header, "✕", lambda: ui["sheet"].dismiss())
        self._sync_emoji_header_icons(ui)
        wrap.addView(header)
        return wrap

    def _header_button(self, activity, parent, symbol, fn):
        btn = TextView(activity)
        btn.setText(symbol)
        btn.setTextSize(1, 18.0)
        btn.setTypeface(Typeface.DEFAULT_BOLD)
        btn.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        btn.setGravity(Gravity.CENTER)
        btn.setClickable(True)
        lp = LinearLayout.LayoutParams(dp(40), dp(40))
        lp.setMargins(dp(2), 0, dp(2), 0)
        btn.setOnClickListener(click_listener(fn))
        self._touch_anim(btn)
        parent.addView(btn, lp)
        return btn

    def _touch_anim(self, view):
        class _T(dynamic_proxy(View.OnTouchListener)):
            def onTouch(s, v, event):
                try:
                    action = event.getAction()
                    if action == MotionEvent.ACTION_DOWN:
                        v.animate().scaleX(0.82).scaleY(0.82).setDuration(60).start()
                    elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        v.animate().scaleX(1.0).scaleY(1.0).setDuration(90).start()
                except Exception:
                    pass
                return False
        view.setOnTouchListener(_T())

    def _sync_emoji_header_icons(self, ui):
        ui["btn_mode"].setText("▦" if not ui["grid"] else "☰")
        accent = Theme.getColor(Theme.key_featuredStickers_addButton)
        plain = Theme.getColor(Theme.key_dialogTextBlack)
        ui["btn_packs"].setTextColor(accent if ui["packs_only"] else plain)
        ui["btn_sort"].setTextColor(accent if ui["sort"] != "date" else plain)

    def _toggle_emoji_mode(self, ui):
        ui["grid"] = not ui["grid"]
        self._sync_emoji_header_icons(ui)
        self._animate_emoji_refresh(ui)

    def _toggle_emoji_packs(self, ui):
        ui["packs_only"] = not ui["packs_only"]
        self._sync_emoji_header_icons(ui)
        self._animate_emoji_refresh(ui)

    def _cycle_emoji_sort(self, ui):
        ui["sort"] = SORT_MODES[(SORT_MODES.index(ui["sort"]) + 1) % len(SORT_MODES)]
        self._sync_emoji_header_icons(ui)
        self._animate_emoji_refresh(ui)

    def _animate_emoji_refresh(self, ui):
        if not self.get_setting("animations", True):
            self._refresh_emoji_ui(ui["dialog_id"], ui)
            return
        content = ui["content"]
        plugin = self

        class _After(dynamic_proxy(Runnable)):
            def run(s):
                try:
                    plugin._refresh_emoji_ui(ui["dialog_id"], ui)
                    content.setAlpha(0.0)
                    content.animate().alpha(1.0).setDuration(160).start()
                except Exception:
                    pass
        content.animate().alpha(0.0).setDuration(110).withEndAction(_After()).start()

    def _sorted_emoji_items(self, ui):
        state = self._emoji_cache_for(ui["dialog_id"])
        cache_key = (
            int(state.get("items_revision", 0)),
            str(ui["sort"]),
            bool(ui["packs_only"]),
        )
        cache = state["sorted_cache"]
        if cache_key in cache:
            return cache[cache_key]

        items = list(state["items"].values())
        sort = ui["sort"]
        if sort == "count":
            items.sort(key=lambda e: (-e["count"], -e["date"]))
        elif sort == "pack":
            items.sort(key=lambda e: (e["set_id"], -e["date"]))
        else:
            items.sort(key=lambda e: -e["date"])

        if not ui["packs_only"]:
            result = [(entry, []) for entry in items]
        else:
            groups = {}
            order = []
            for entry in items:
                key = entry["set_id"] or ("solo", entry["doc_id"])
                if key in groups:
                    groups[key].append(entry)
                else:
                    groups[key] = []
                    order.append((key, entry))
            result = [(head, groups[key][:3]) for key, head in order]

        state["sorted_cache"] = {cache_key: result}
        return result

    def _pack_label_map(self, state):
        revision = int(state.get("items_revision", 0))
        cached_revision, cached_labels = state.get("pack_label_cache", (-1, {}))
        if cached_revision == revision:
            return cached_labels

        counts = {}
        order = []
        for entry in state["items"].values():
            set_id = int(entry.get("set_id") or 0)
            if not set_id:
                continue
            if set_id not in counts:
                counts[set_id] = 0
                order.append(set_id)
            counts[set_id] += 1
        labels = {}
        number = 1
        for set_id in order:
            if counts.get(set_id, 0) > 1:
                labels[set_id] = f"Н{number}"
                number += 1
        state["pack_label_cache"] = (revision, labels)
        return labels

    def _pack_labels_for_ui(self, state, ui):
        if not bool(ui.get("show_pack_numbers", True)):
            return {}
        return self._pack_label_map(state)

    def _refresh_emoji_ui(self, dialog_id, ui):
        if not self._emoji_session_valid(dialog_id, ui):
            return
        try:
            state = self._emoji_cache_for(dialog_id)
            busy = bool(state["scanning"] or state["resolving"])
            status = SORT_TITLES[ui["sort"]]
            if ui["packs_only"]:
                status += " · только наборы"
            status += f" · {state['scanned']} сообщ. · {len(state['items'])} Emoji"
            if busy:
                status += " · поиск…"
            if state["request_error"]:
                status += " · ошибка загрузки"

            if ui.get("_last_status") != status:
                ui["status"].setText(status)
                ui["_last_status"] = status
            visibility = View.VISIBLE if busy else View.GONE
            if ui.get("_last_progress_visibility") != visibility:
                ui["progress"].setVisibility(visibility)
                ui["_last_progress_visibility"] = visibility

            content_key = (
                int(state.get("items_revision", 0)),
                bool(ui["grid"]),
                bool(ui["packs_only"]),
                str(ui["sort"]),
                bool(state["finished"]),
                busy,
            )
            if ui.get("_last_content_key") == content_key:
                return

            now = time.monotonic()
            last_render = float(ui.get("_last_content_render_at", 0.0) or 0.0)
            if busy and now - last_render < UI_RENDER_INTERVAL:
                if not ui.get("_refresh_scheduled"):
                    ui["_refresh_scheduled"] = True
                    delay = max(0.01, UI_RENDER_INTERVAL - (now - last_render))
                    timer = threading.Timer(
                        delay,
                        lambda: run_on_ui_thread(
                            lambda: self._deferred_emoji_refresh(dialog_id, ui)
                        ),
                    )
                    timer.daemon = True
                    timer.start()
                return

            ui["_refresh_scheduled"] = False
            ui["_last_content_render_at"] = now
            content = ui["content"]
            content.removeAllViews()
            activity = ui["activity"]
            rows = self._sorted_emoji_items(ui)
            ui["pack_labels"] = self._pack_labels_for_ui(state, ui)

            if not rows:
                empty = TextView(activity)
                text = (
                    "Кастомные Emoji пока не найдены"
                    if not state["finished"]
                    else "В этом чате нет кастомных Emoji"
                )
                empty.setText(text)
                empty.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
                empty.setGravity(Gravity.CENTER)
                empty.setPadding(dp(16), dp(40), dp(16), dp(20))
                content.addView(empty, LinearLayout.LayoutParams(-1, -2))
            elif ui["grid"]:
                self._render_emoji_grid(activity, content, ui, rows)
            else:
                self._render_emoji_rows(activity, content, ui, rows)

            if not state["finished"] and not busy:
                more = TextView(activity)
                more.setText("Сканировать дальше")
                more.setTextSize(1, 15.0)
                more.setTypeface(Typeface.DEFAULT_BOLD)
                more.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                more.setGravity(Gravity.CENTER)
                more.setPadding(0, dp(14), 0, dp(14))
                more.setOnClickListener(click_listener(
                    lambda: self._start_emoji_scan(dialog_id, ui)))
                content.addView(more, LinearLayout.LayoutParams(-1, -2))

            ui["_last_content_key"] = content_key
        except Exception as e:
            self.log(f"[ChatEmoji] refresh: {e}")

    def _deferred_emoji_refresh(self, dialog_id, ui):
        ui["_refresh_scheduled"] = False
        self._refresh_emoji_ui(dialog_id, ui)

    def _render_emoji_grid(self, activity, content, ui, rows):
        per_row = 4
        row_layout = None
        for idx, (entry, _tail) in enumerate(rows):
            if idx % per_row == 0:
                row_layout = LinearLayout(activity)
                row_layout.setOrientation(LinearLayout.HORIZONTAL)
                content.addView(row_layout, LinearLayout.LayoutParams(-1, -2))
            lp = LinearLayout.LayoutParams(0, dp(92), 1.0)
            lp.setMargins(dp(3), dp(3), dp(3), dp(3))
            row_layout.addView(self._emoji_cell(activity, ui, entry), lp)
        if rows and len(rows) % per_row != 0:
            for _ in range(per_row - len(rows) % per_row):
                lp = LinearLayout.LayoutParams(0, dp(92), 1.0)
                lp.setMargins(dp(3), dp(3), dp(3), dp(3))
                row_layout.addView(View(activity), lp)

    def _render_emoji_rows(self, activity, content, ui, rows):
        for idx, (entry, tail) in enumerate(rows):
            if idx:
                divider = View(activity)
                divider.setBackgroundColor(Theme.getColor(Theme.key_divider))
                dlp = LinearLayout.LayoutParams(-1, 1)
                dlp.setMargins(dp(80), 0, 0, 0)
                content.addView(divider, dlp)
            content.addView(
                self._emoji_row(activity, ui, entry, tail),
                LinearLayout.LayoutParams(-1, -2),
            )

    def _emoji_cell(self, activity, ui, entry):
        frame = FrameLayout(activity)
        frame.setBackgroundDrawable(Theme.createRoundRectDrawable(
            dp(10), Theme.getColor(Theme.key_graySection)))
        iv = BackupImageView(activity)
        self._bind_emoji_image(iv, entry)
        ilp = FrameLayout.LayoutParams(-1, -1)
        ilp.setMargins(dp(8), dp(8), dp(8), dp(8))
        frame.addView(iv, ilp)
        if entry.get("doc") is None:
            fallback = TextView(activity)
            fallback.setText(entry.get("emoji") or "ID")
            fallback.setTextSize(1, 26.0 if entry.get("emoji") else 12.0)
            fallback.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            fallback.setGravity(Gravity.CENTER)
            frame.addView(fallback, FrameLayout.LayoutParams(-1, -1))
        if entry["count"] > 1:
            badge = TextView(activity)
            badge.setText(f"×{entry['count']}")
            badge.setTextSize(1, 11.0)
            badge.setTypeface(Typeface.DEFAULT_BOLD)
            badge.setTextColor(Color.WHITE)
            badge.setBackgroundDrawable(Theme.createRoundRectDrawable(
                dp(9), Theme.getColor(Theme.key_featuredStickers_addButton)))
            badge.setPadding(dp(6), dp(1), dp(6), dp(1))
            blp = FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.END)
            blp.setMargins(0, dp(2), dp(2), 0)
            frame.addView(badge, blp)
        pack_label = ui.get("pack_labels", {}).get(int(entry.get("set_id") or 0))
        if pack_label:
            pack_badge = TextView(activity)
            pack_badge.setText(pack_label)
            pack_badge.setTextSize(1, 10.0)
            pack_badge.setTypeface(Typeface.DEFAULT_BOLD)
            pack_badge.setTextColor(Color.WHITE)
            pack_badge.setBackgroundDrawable(Theme.createRoundRectDrawable(
                dp(8), Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)))
            pack_badge.setPadding(dp(5), dp(1), dp(5), dp(1))
            plp = FrameLayout.LayoutParams(-2, -2, Gravity.BOTTOM | Gravity.START)
            plp.setMargins(dp(4), 0, 0, dp(4))
            frame.addView(pack_badge, plp)
        frame.setOnClickListener(click_listener(lambda: self._emoji_menu(ui, entry)))
        frame.setOnLongClickListener(long_click_listener(
            lambda: self._emoji_menu(ui, entry)))
        return frame

    def _emoji_row(self, activity, ui, entry, tail):
        row = LinearLayout(activity)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(4), dp(6), dp(4), dp(6))

        stack = FrameLayout(activity)
        stack_w = dp(64) + (dp(20) * len(tail) if tail else 0)
        alphas = (0.5, 0.32, 0.18)
        for i, tail_entry in enumerate(reversed(tail)):
            ghost = BackupImageView(activity)
            self._bind_emoji_image(ghost, tail_entry)
            ghost.setAlpha(alphas[min(len(tail) - 1 - i, 2)])
            glp = FrameLayout.LayoutParams(dp(64), dp(64), Gravity.CENTER_VERTICAL)
            glp.setMargins(dp(20) * (len(tail) - i), 0, 0, 0)
            stack.addView(ghost, glp)
        iv = BackupImageView(activity)
        self._bind_emoji_image(iv, entry)
        stack.addView(iv, FrameLayout.LayoutParams(dp(64), dp(64), Gravity.CENTER_VERTICAL))
        row.addView(stack, LinearLayout.LayoutParams(stack_w, dp(68)))

        col = LinearLayout(activity)
        col.setOrientation(LinearLayout.VERTICAL)
        clp = LinearLayout.LayoutParams(0, -2, 1.0)
        clp.setMargins(dp(12), 0, dp(6), 0)

        title = TextView(activity)
        pack_title = self._set_title(entry["set_id"]) if entry["set_id"] else None
        pack_label = ui.get("pack_labels", {}).get(int(entry.get("set_id") or 0))
        title_text = pack_title or (entry["emoji"] or "Custom Emoji")
        if pack_label:
            title_text = f"{pack_label} · {title_text}"
        title.setText(title_text)
        title.setTextSize(1, 15.0)
        title.setTypeface(Typeface.DEFAULT_BOLD)
        title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        title.setSingleLine(True)
        col.addView(title)

        sub = TextView(activity)
        when = time.strftime("%d.%m.%Y %H:%M", time.localtime(entry["date"])) if entry["date"] else ""
        count_part = f" · ×{entry['count']}" if entry["count"] > 1 else ""
        access = "бесплатный" if entry["free"] else "Premium"
        sub.setText(f"{self._sender_name(entry['sender_id'])} · {when}{count_part} · {access}")
        sub.setTextSize(1, 13.0)
        sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
        sub.setSingleLine(True)
        col.addView(sub)
        row.addView(col, clp)

        row.setOnClickListener(click_listener(lambda: self._emoji_menu(ui, entry)))
        row.setOnLongClickListener(long_click_listener(
            lambda: self._emoji_menu(ui, entry)))
        return row

    def _bind_emoji_image(self, iv, entry):
        try:
            doc = entry.get("doc")
            if doc is None:
                return
            thumbs = getattr(doc, "thumbs", None)
            thumb = None
            if thumbs is not None and thumbs.size() > 0:
                thumb = FileLoader.getClosestPhotoSizeWithSize(thumbs, 320)
            if entry["animated"] and thumb is not None:
                loc = ImageLocation.getForDocument(thumb, doc)
            else:
                loc = ImageLocation.getForDocument(doc)
            iv.setImage(loc, "100_100", cast(Drawable, None), doc)
        except Exception as e:
            self.log(f"[ChatEmoji] bind image: {e}")

    def _input_set(self, entry):
        s = TLRPC.TL_inputStickerSetID()
        s.id = entry["set_id"]
        s.access_hash = entry["set_hash"]
        return s

    def _open_emoji_pack(self, ui, entry):
        input_set = entry.get("input_set")
        if input_set is None and not entry["set_id"]:
            BulletinHelper.show_info("У этого Emoji нет набора")
            return
        try:
            best = None
            for constructor in StickersAlert.getClass().getConstructors():
                names = [p.getSimpleName() for p in constructor.getParameterTypes()]
                if (len(names) >= 3 and "Context" in names[0]
                        and "BaseFragment" in names[1]
                        and "InputStickerSet" in names[2]):
                    if best is None or len(names) < len(best.getParameterTypes()):
                        best = constructor
            if best is None:
                raise RuntimeError("no matching StickersAlert constructor")
            args = [
                ui["activity"],
                get_last_fragment(),
                input_set if input_set is not None else self._input_set(entry),
            ]
            for parameter in best.getParameterTypes()[3:]:
                name = parameter.getSimpleName()
                if name == "boolean":
                    args.append(False)
                elif name in ("int", "long", "short", "byte", "float", "double"):
                    args.append(0)
                else:
                    args.append(None)
            alert = best.newInstance(*args)
            alert.show()
        except Exception as e:
            self.log(f"[ChatEmoji] open pack: {e}")
            BulletinHelper.show_error("Не удалось открыть набор Emoji")

    def _emoji_menu(self, ui, entry):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle(entry["emoji"] or "Custom Emoji")

        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(0, dp(8), 0, dp(8))
        dialog_ref = []

        def add_item(text, fn):
            tv = TextView(activity)
            tv.setText(text)
            tv.setTextSize(1, 16.0)
            tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            tv.setPadding(dp(22), dp(12), dp(22), dp(12))
            tv.setClickable(True)

            def on_click():
                if dialog_ref:
                    try:
                        dialog_ref[0].dismiss()
                    except Exception:
                        pass
                fn()
            tv.setOnClickListener(click_listener(on_click))
            container.addView(tv, LinearLayout.LayoutParams(-1, -2))

        add_item("Посмотреть набор", lambda: self._open_emoji_pack(ui, entry))
        add_item("Скопировать набор", lambda: self._copy_emoji_pack(ui, entry))
        add_item("Добавить смайл в мой набор", lambda: self._add_emoji_to_my_set(ui, entry))
        add_item("Перейти к сообщению", lambda: self._jump_to_message(ui, entry))

        builder.setView(container)
        builder.setNegativeButton("Отмена", None)
        dialog_ref.append(builder.show())

    def _make_get_source_pack_request(self, entry):
        input_set = entry.get("input_set")
        if input_set is None:
            if not entry.get("set_id"):
                raise ValueError("emoji set is missing")
            input_set = self._input_set(entry)
        request_class = getattr(TLRPC, "TL_messages_getStickerSet", None)
        if request_class is None:
            raise RuntimeError("messages.getStickerSet is unavailable")
        req = request_class()
        req.stickerset = input_set
        req.hash = 0
        return req

    def _input_document_from_document(self, document):
        input_document = TLRPC.TL_inputDocument()
        input_document.id = _to_int64(self._jfield(document, "id"), 0)
        input_document.access_hash = _to_int64(self._jfield(document, "access_hash"), 0)
        input_document.file_reference = self._jfield(document, "file_reference")
        if (not input_document.id or not input_document.access_hash
                or input_document.file_reference is None):
            raise ValueError("emoji input document is incomplete")
        return input_document

    def _input_item_from_document(self, document, emoji, keywords=""):
        item = TLRPC.TL_inputStickerSetItem()
        item.document = self._input_document_from_document(document)
        item.emoji = str(emoji or "🙂")
        keywords = str(keywords or "").strip()
        if keywords:
            item.keywords = keywords
            try:
                item.flags = int(self._jfield(item, "flags") or 0) | 2
            except Exception:
                pass
        return item

    def _document_custom_emoji_alt(self, document):
        fallback = ""
        for attribute in _java_values(self._jfield(document, "attributes")):
            alt = str(self._jfield(attribute, "alt") or "")
            if alt and not fallback:
                fallback = alt
            normalized = "".join(
                ch for ch in _java_class_name(attribute).lower() if ch.isalnum()
            )
            if "documentattributecustomemoji" in normalized:
                return alt
            if (self._jfield(attribute, "stickerset") is not None
                    and self._jfield(attribute, "alt") is not None):
                fallback = alt or fallback
        return fallback

    def _parse_source_emoji_pack(self, response):
        source_set = self._jfield(response, "set")
        if source_set is None:
            raise ValueError("Telegram did not return sticker set info")
        if self._jfield(source_set, "emojis") is False:
            raise ValueError("This is not a custom emoji set")

        emoji_by_document = {}
        for pack in _java_values(self._jfield(response, "packs")):
            emoticon = str(self._jfield(pack, "emoticon") or "")
            for document_id in _java_values(self._jfield(pack, "documents")):
                doc_id = _to_int64(document_id, 0)
                if doc_id and emoticon and doc_id not in emoji_by_document:
                    emoji_by_document[doc_id] = emoticon

        keywords_by_document = {}
        for keyword in _java_values(self._jfield(response, "keywords")):
            doc_id = _to_int64(self._jfield(keyword, "document_id"), 0)
            values = [str(value) for value in _java_values(self._jfield(keyword, "keyword")) if str(value)]
            if doc_id and values:
                keywords_by_document[doc_id] = ",".join(values)

        items = []
        for document in _java_values(self._jfield(response, "documents")):
            doc_id = _to_int64(self._jfield(document, "id"), 0)
            emoji = self._document_custom_emoji_alt(document) or emoji_by_document.get(doc_id) or "🙂"
            keywords = keywords_by_document.get(doc_id, "")
            try:
                input_item = self._input_item_from_document(document, emoji, keywords)
            except Exception:
                continue
            items.append({
                "document": document,
                "document_id": doc_id,
                "emoji": emoji,
                "keywords": keywords,
                "input_item": input_item,
            })

        if not items:
            raise ValueError("The source set has no reusable emoji documents")
        return {
            "id": _to_int64(self._jfield(source_set, "id"), 0),
            "access_hash": _to_int64(self._jfield(source_set, "access_hash"), 0),
            "title": str(self._jfield(source_set, "title") or "Emoji-набор"),
            "short_name": str(self._jfield(source_set, "short_name") or ""),
            "text_color": bool(self._jfield(source_set, "text_color")),
            "items": items,
        }

    def _make_create_copied_pack_request(self, pack, title, short_name):
        items = list(pack.get("items") or [])
        if not items:
            raise ValueError("source emoji set is empty")
        request_class = getattr(TLRPC, "TL_stickers_createStickerSet", None)
        user_class = getattr(TLRPC, "TL_inputUserSelf", None)
        if request_class is None or user_class is None:
            raise RuntimeError("stickers.createStickerSet is unavailable")
        req = request_class()
        req.user_id = user_class()
        req.title = str(title)
        req.short_name = str(short_name)
        req.emojis = True
        # В AyuGram/ExteraGram поле text_color присутствует не во всех TL-схемах.
        # Бит custom emoji обязателен; text_color добавляем только при поддержке.
        flags = 32
        try:
            req.text_color = bool(pack.get("text_color"))
            if req.text_color:
                flags |= 64
        except AttributeError:
            pass
        req.flags = flags
        req.stickers = ArrayList()
        req.stickers.add(items[0]["input_item"])
        return req

    def _copy_error_action(self, error_text):
        value = str(error_text or "").upper()
        if any(token in value for token in (
                "STICKER_ALREADY", "STICKER_EXIST", "STICKER_FILE_INVALID",
                "STICKER_EMOJI_INVALID", "STICKER_INVALID", "FILE_REFERENCE")):
            return "skip"
        return "stop"

    def _copy_emoji_pack(self, ui, entry):
        try:
            req = self._make_get_source_pack_request(entry)
        except Exception as e:
            self.log(f"[ChatEmoji] prepare source pack: {e}")
            BulletinHelper.show_error("Не удалось определить исходный Emoji-набор")
            return

        BulletinHelper.show_info("Загружаю исходный Emoji-набор…")

        def on_response(response, error):
            def finish():
                if error is not None:
                    error_text = str(self._jfield(error, "text") or error)
                    BulletinHelper.show_error(f"Не удалось загрузить набор: {error_text}")
                    return
                try:
                    pack = self._parse_source_emoji_pack(response)
                except Exception as e:
                    self.log(f"[ChatEmoji] parse source pack: {e}")
                    BulletinHelper.show_error("Не удалось подготовить Emoji из этого набора")
                    return
                self._show_copy_pack_options(ui, pack)
            run_on_ui_thread(finish)

        try:
            send_request(req, on_response)
        except Exception as e:
            self.log(f"[ChatEmoji] get source pack: {e}")
            BulletinHelper.show_error("Не удалось запросить исходный Emoji-набор")

    def _show_copy_pack_options(self, ui, pack):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle("Скопировать набор")
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(0, dp(8), 0, dp(8))
        dialog_ref = []

        def add_option(title_text, subtext, callback):
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.VERTICAL)
            row.setPadding(dp(22), dp(11), dp(22), dp(11))
            title = TextView(activity)
            title.setText(title_text)
            title.setTextSize(1, 16.0)
            title.setTypeface(Typeface.DEFAULT_BOLD)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            row.addView(title, LinearLayout.LayoutParams(-1, -2))
            sub = TextView(activity)
            sub.setText(subtext)
            sub.setTextSize(1, 13.0)
            sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            row.addView(sub, LinearLayout.LayoutParams(-1, -2))

            def choose():
                if dialog_ref:
                    try:
                        dialog_ref[0].dismiss()
                    except Exception:
                        pass
                callback()
            row.setOnClickListener(click_listener(choose))
            container.addView(row, LinearLayout.LayoutParams(-1, -2))

        add_option(
            "Создать новый набор",
            "Задать название и новую ссылку t.me/addemoji/…",
            lambda: self._show_create_pack_dialog(ui, pack),
        )
        add_option(
            "Добавить в существующий",
            "Перенести все Emoji в один из ваших наборов @stickers",
            lambda: self._copy_pack_to_existing(ui, pack),
        )
        builder.setView(container)
        builder.setNegativeButton("Отмена", None)
        dialog_ref.append(builder.show())

    def _make_suggest_short_name_request(self, title):
        request_class = getattr(TLRPC, "TL_stickers_suggestShortName", None)
        if request_class is None:
            raise RuntimeError("stickers.suggestShortName is unavailable")
        req = request_class()
        req.title = str(title)
        return req

    def _suggest_short_name_for_dialog(self, title, short_input, expected_value):
        try:
            req = self._make_suggest_short_name_request(title)
        except Exception:
            return

        def on_response(response, error):
            def apply_suggestion():
                if error is not None:
                    return
                suggestion = str(self._jfield(response, "short_name") or "").strip()
                if not suggestion:
                    return
                try:
                    current = str(short_input.getText() or "").strip()
                except Exception:
                    current = ""
                if current == str(expected_value or "").strip():
                    short_input.setText(suggestion[:64])
            run_on_ui_thread(apply_suggestion)

        try:
            send_request(req, on_response)
        except Exception:
            pass

    def _suggested_copy_short_name(self, pack):
        source = str(pack.get("short_name") or "emoji_pack")
        source = re.sub(r"[^A-Za-z0-9_]+", "_", source)
        source = re.sub(r"_+", "_", source).strip("_")
        if not source or not source[0].isalpha():
            source = "emoji_" + source
        suffix = str(int(time.time()))[-6:]
        room = max(1, 64 - len("_copy_") - len(suffix))
        return f"{source[:room]}_copy_{suffix}"[:64]

    def _validate_new_pack_identity(self, title, short_name):
        title = str(title or "").strip()
        short_name = str(short_name or "").strip()
        if not (1 <= len(title) <= 64):
            return "Название должно содержать от 1 до 64 символов"
        if not (1 <= len(short_name) <= 64):
            return "Ссылка должна содержать от 1 до 64 символов"
        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*", short_name):
            return "Ссылка: английские буквы, цифры и _, начинается с буквы"
        if "__" in short_name:
            return "В ссылке нельзя использовать два подчёркивания подряд"
        return ""

    def _style_create_pack_input(self, edit_text):
        text_color = Theme.getColor(Theme.key_dialogTextBlack)
        hint_color = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)
        accent_color = Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)

        try:
            edit_text.setTextColor(text_color)
        except Exception:
            pass
        try:
            edit_text.setHintTextColor(hint_color)
        except Exception:
            pass
        try:
            edit_text.setHighlightColor(accent_color)
        except Exception:
            pass

        # Android 10+ позволяет безопасно перекрасить курсор напрямую.
        # На старых версиях API вызовы отсутствуют и просто пропускаются.
        try:
            cursor = edit_text.getTextCursorDrawable()
            if cursor is not None:
                try:
                    cursor = cursor.mutate()
                except Exception:
                    pass
                try:
                    cursor.setTint(text_color)
                except Exception:
                    try:
                        Theme.setDrawableColor(cursor, text_color)
                    except Exception:
                        pass
                edit_text.setTextCursorDrawable(cursor)
        except Exception:
            pass

    def _show_create_pack_dialog(self, ui, pack):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle("Новый Emoji-набор")
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(dp(22), dp(10), dp(22), dp(10))

        title_label = TextView(activity)
        title_label.setText("Название")
        title_label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        container.addView(title_label, LinearLayout.LayoutParams(-1, -2))
        title_input = EditText(activity)
        title_input.setSingleLine(True)
        self._style_create_pack_input(title_input)
        default_title = f"{pack.get('title') or 'Emoji-набор'} — копия"
        title_input.setText(default_title[:64])
        container.addView(title_input, LinearLayout.LayoutParams(-1, -2))

        short_label = TextView(activity)
        short_label.setText("Новая ссылка: t.me/addemoji/…")
        short_label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        short_label.setPadding(0, dp(10), 0, 0)
        container.addView(short_label, LinearLayout.LayoutParams(-1, -2))
        short_input = EditText(activity)
        short_input.setSingleLine(True)
        self._style_create_pack_input(short_input)
        local_short_name = self._suggested_copy_short_name(pack)
        short_input.setText(local_short_name)
        container.addView(short_input, LinearLayout.LayoutParams(-1, -2))

        create_button = TextView(activity)
        create_button.setText("Создать и скопировать")
        create_button.setTextSize(1, 16.0)
        create_button.setTypeface(Typeface.DEFAULT_BOLD)
        create_button.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
        create_button.setPadding(0, dp(18), 0, dp(8))
        container.addView(create_button, LinearLayout.LayoutParams(-1, -2))

        builder.setView(container)
        builder.setNegativeButton("Отмена", None)
        dialog = builder.show()
        self._suggest_short_name_for_dialog(
            str(title_input.getText() or default_title), short_input, local_short_name
        )

        def create():
            title = str(title_input.getText() or "").strip()
            short_name = str(short_input.getText() or "").strip()
            error = self._validate_new_pack_identity(title, short_name)
            if error:
                BulletinHelper.show_error(error)
                return
            try:
                dialog.dismiss()
            except Exception:
                pass
            self._check_short_name_and_create(ui, pack, title, short_name)

        create_button.setOnClickListener(click_listener(create))

    def _check_short_name_and_create(self, ui, pack, title, short_name):
        # createStickerSet сам проверяет корректность и доступность short_name.
        # В некоторых сборках AyuGram/ExteraGram callback checkShortName не
        # возвращается, из-за чего создание набора зависает без результата.
        try:
            self._create_copied_pack(ui, pack, title, short_name)
        except Exception as e:
            self.log(f"[ChatEmoji] start create copied pack: {e}")
            BulletinHelper.show_error("Не удалось запустить создание Emoji-набора")

    def _show_copy_status_dialog(self, ui, title, message, cancelable=True):
        activity = ui.get("activity") if isinstance(ui, dict) else None
        if activity is None:
            return None
        try:
            builder = AlertDialog.Builder(activity)
            builder.setTitle(str(title))
            builder.setMessage(str(message))
            if cancelable:
                builder.setPositiveButton("Закрыть", None)
            else:
                try:
                    builder.setCancelable(False)
                except Exception:
                    pass
            return builder.show()
        except Exception:
            return None

    def _dismiss_dialog_safely(self, dialog):
        if dialog is None:
            return
        try:
            dialog.dismiss()
        except Exception:
            pass

    def _create_copied_pack(self, ui, pack, title, short_name):
        try:
            req = self._make_create_copied_pack_request(pack, title, short_name)
        except Exception as e:
            self.log(f"[ChatEmoji] prepare create pack: {e}")
            self._show_copy_status_dialog(
                ui, "Не удалось создать набор",
                f"Не удалось подготовить запрос: {e}",
            )
            return

        progress_dialog = self._show_copy_status_dialog(
            ui, "Создание Emoji-набора",
            "Отправляю запрос в Telegram…",
            cancelable=False,
        )
        token = f"create:{time.time_ns()}"
        finished = [False]

        def finish_once():
            if finished[0]:
                return False
            finished[0] = True
            pending = getattr(self, "_pending_create_callbacks", None)
            if pending is not None:
                pending.pop(token, None)
            self._dismiss_dialog_safely(progress_dialog)
            return True

        def on_response(response, error):
            def finish():
                if not finish_once():
                    return
                if error is not None:
                    error_text = str(self._jfield(error, "text") or error)
                    if "SHORT_NAME_OCCUPIED" in error_text or "PACK_SHORT_NAME_OCCUPIED" in error_text:
                        user_text = "Эта ссылка уже занята. Укажи другое короткое имя."
                    elif "SHORT_NAME_INVALID" in error_text or "PACK_SHORT_NAME_INVALID" in error_text:
                        user_text = "Некорректная ссылка набора. Используй английские буквы, цифры и _."
                    elif "USER_ID_INVALID" in error_text or "PEER_ID_INVALID" in error_text:
                        user_text = "Telegram не принял владельца набора. Код: " + error_text
                    elif "STICKER_FILE_INVALID" in error_text or "STICKER_INVALID" in error_text:
                        user_text = "Telegram не разрешил использовать исходный Emoji при создании. Код: " + error_text
                    else:
                        user_text = "Ошибка Telegram: " + error_text
                    self._show_copy_status_dialog(ui, "Не удалось создать набор", user_text)
                    return

                try:
                    source_set = self._jfield(response, "set")
                    target = {
                        "id": _to_int64(self._jfield(source_set, "id"), 0),
                        "access_hash": _to_int64(self._jfield(source_set, "access_hash"), 0),
                        "title": title,
                        "short_name": short_name,
                    }
                    if not target["id"]:
                        self._show_copy_status_dialog(
                            ui, "Набор создан не полностью",
                            "Telegram ответил без ID нового набора.",
                        )
                        return
                    target["count"] = 1
                    self._remember_recent_owned_set(target)
                    self._copy_items_sequentially(
                        ui, pack, target, start_index=1, copied=1, skipped=0,
                        created_short_name=short_name,
                    )
                except Exception as e:
                    self.log(f"[ChatEmoji] process create pack response: {e}")
                    self._show_copy_status_dialog(
                        ui, "Ошибка обработки ответа", str(e),
                    )
            run_on_ui_thread(finish)

        # Держим Python callback сильной ссылкой до ответа или тайм-аута.
        pending = getattr(self, "_pending_create_callbacks", None)
        if pending is None:
            pending = {}
            self._pending_create_callbacks = pending
        pending[token] = on_response

        try:
            request_id = send_request(req, on_response)
            self.log(f"[ChatEmoji] createStickerSet request id={request_id}")
        except Exception as e:
            finish_once()
            self.log(f"[ChatEmoji] create pack send: {e}")
            self._show_copy_status_dialog(
                ui, "Не удалось создать набор",
                f"Запрос не был отправлен: {e}",
            )
            return

        plugin = self
        class _CreateTimeout(dynamic_proxy(Runnable)):
            def run(s):
                if not finish_once():
                    return
                plugin._show_copy_status_dialog(
                    ui, "Telegram не ответил",
                    "За 20 секунд не получен ответ на создание набора. "
                    "Попробуй другое имя ссылки или повтори позже.",
                )
        try:
            AndroidUtilities.runOnUIThread(_CreateTimeout(), 20000)
        except Exception:
            pass

    def _load_owned_emoji_sets_for_copy(self, callback):
        request_class = getattr(TLRPC, "TL_messages_getMyStickers", None)
        if request_class is None:
            BulletinHelper.show_error("Эта версия клиента не поддерживает собственные наборы")
            return
        owned = []
        seen = set()

        def request_page(offset_id):
            try:
                req = request_class()
                req.offset_id = int(offset_id)
                req.limit = 100

                def on_response(response, error):
                    run_on_ui_thread(lambda: process_page(offset_id, response, error))
                send_request(req, on_response)
            except Exception as e:
                self.log(f"[ChatEmoji] copy getMyStickers: {e}")
                BulletinHelper.show_error("Не удалось загрузить ваши Emoji-наборы")

        def process_page(offset_id, response, error):
            if error is not None:
                error_text = str(self._jfield(error, "text") or error)
                BulletinHelper.show_error(f"Не удалось загрузить наборы: {error_text}")
                return
            covered_sets = _java_values(self._jfield(response, "sets"))
            last_id = 0
            for covered in covered_sets:
                raw_set = self._jfield(covered, "set") or covered
                raw_id = _to_int64(self._jfield(raw_set, "id"), 0)
                if raw_id:
                    last_id = raw_id
                info = self._owned_emoji_set_info(covered)
                if info is not None and info["id"] not in seen:
                    seen.add(info["id"])
                    owned.append(info)
            if _should_request_next_owned_page(len(covered_sets), last_id, offset_id):
                request_page(last_id)
                return
            merged_owned = self._merge_recent_owned_sets(owned)
            callback(merged_owned)

        request_page(0)

    def _copy_pack_to_existing(self, ui, pack):
        BulletinHelper.show_info("Загружаю ваши Emoji-наборы…")
        self._load_owned_emoji_sets_for_copy(
            lambda owned: self._show_copy_target_sets(ui, pack, owned)
        )

    def _show_copy_target_sets(self, ui, pack, owned):
        activity = ui["activity"]
        source_id = int(pack.get("id") or 0)
        owned = [target for target in owned if int(target.get("id") or 0) != source_id]
        builder = AlertDialog.Builder(activity)
        if not owned:
            builder.setTitle("Нет подходящих Emoji-наборов")
            builder.setMessage("Создай новый набор или добавь набор через @stickers.")
            builder.setNegativeButton("Закрыть", None)
            builder.show()
            return

        builder.setTitle("Копировать в набор")
        scroll = ScrollView(activity)
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(0, dp(6), 0, dp(6))
        dialog_ref = []
        for target in owned:
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.VERTICAL)
            row.setPadding(dp(22), dp(10), dp(22), dp(10))
            title = TextView(activity)
            title.setText(target["title"])
            title.setTextSize(1, 16.0)
            title.setTypeface(Typeface.DEFAULT_BOLD)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            row.addView(title, LinearLayout.LayoutParams(-1, -2))
            sub = TextView(activity)
            sub.setText(f"{target['count']} Emoji" if target.get("count") else "Собственный Emoji-набор")
            sub.setTextSize(1, 13.0)
            sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            row.addView(sub, LinearLayout.LayoutParams(-1, -2))

            def choose(chosen=target):
                if dialog_ref:
                    try:
                        dialog_ref[0].dismiss()
                    except Exception:
                        pass
                self._copy_items_sequentially(ui, pack, chosen)
            row.setOnClickListener(click_listener(choose))
            container.addView(row, LinearLayout.LayoutParams(-1, -2))
        scroll.addView(container)
        builder.setView(scroll)
        builder.setNegativeButton("Отмена", None)
        dialog_ref.append(builder.show())

    def _target_input_set(self, target):
        if target.get("id"):
            result = TLRPC.TL_inputStickerSetID()
            result.id = int(target["id"])
            result.access_hash = int(target.get("access_hash") or 0)
            return result
        short_class = getattr(TLRPC, "TL_inputStickerSetShortName", None)
        if short_class is not None and target.get("short_name"):
            result = short_class()
            result.short_name = str(target["short_name"])
            return result
        raise ValueError("target emoji set is incomplete")

    def _make_add_pack_item_request(self, item, target):
        req = TLRPC.TL_stickers_addStickerToSet()
        req.stickerset = self._target_input_set(target)
        req.sticker = item["input_item"]
        return req

    def _copy_items_sequentially(self, ui, pack, target, start_index=0,
                                 copied=0, skipped=0, created_short_name=""):
        items = list(pack.get("items") or [])
        total = len(items)
        if not total:
            BulletinHelper.show_error("В исходном наборе нет Emoji")
            return
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle("Копирование Emoji")
        progress_text = TextView(activity)
        progress_text.setTextSize(1, 15.0)
        progress_text.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        progress_text.setPadding(dp(22), dp(16), dp(22), dp(16))
        builder.setView(progress_text)
        progress_dialog = builder.show()

        def update(index_value, copied_value, skipped_value):
            progress_text.setText(
                f"Копирование: {min(index_value, total)} из {total}\n"
                f"Добавлено: {copied_value}   Пропущено: {skipped_value}"
            )

        def finish(copied_value, skipped_value, error_text=""):
            try:
                progress_dialog.dismiss()
            except Exception:
                pass
            if error_text:
                BulletinHelper.show_error(
                    f"Копирование остановлено: {copied_value} добавлено, "
                    f"{skipped_value} пропущено. {error_text}"
                )
                return
            if created_short_name:
                self._show_created_pack_result(
                    ui, target.get("title") or pack.get("title"), created_short_name,
                    copied_value, skipped_value,
                )
            else:
                BulletinHelper.show_success(
                    f"Скопировано в «{target.get('title') or 'Emoji-набор'}»: "
                    f"{copied_value} из {total}"
                )

        def step(index_value, copied_value, skipped_value):
            update(index_value, copied_value, skipped_value)
            if index_value >= total:
                finish(copied_value, skipped_value)
                return
            try:
                req = self._make_add_pack_item_request(items[index_value], target)
            except Exception as e:
                self.log(f"[ChatEmoji] prepare copied item: {e}")
                step(index_value + 1, copied_value, skipped_value + 1)
                return

            def on_response(response, error):
                def continue_on_ui():
                    if error is None:
                        step(index_value + 1, copied_value + 1, skipped_value)
                        return
                    error_text = str(self._jfield(error, "text") or error)
                    if self._copy_error_action(error_text) == "skip":
                        step(index_value + 1, copied_value, skipped_value + 1)
                        return
                    finish(copied_value, skipped_value, error_text)
                run_on_ui_thread(continue_on_ui)

            try:
                send_request(req, on_response)
            except Exception as e:
                self.log(f"[ChatEmoji] copy item request: {e}")
                finish(copied_value, skipped_value, "Ошибка отправки запроса")

        step(int(start_index), int(copied), int(skipped))

    def _show_created_pack_result(self, ui, title, short_name, copied, skipped):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle("Emoji-набор создан")
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(dp(22), dp(12), dp(22), dp(12))
        message = TextView(activity)
        message.setText(
            f"{title}\n\nДобавлено: {copied}   Пропущено: {skipped}\n\n"
            f"https://t.me/addemoji/{short_name}"
        )
        message.setTextSize(1, 15.0)
        message.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        container.addView(message, LinearLayout.LayoutParams(-1, -2))
        builder.setView(container)
        builder.setPositiveButton("Готово", None)
        builder.show()

    def _owned_emoji_set_info(self, covered):
        sset = self._jfield(covered, "set")
        if sset is None:
            sset = covered
        if not bool(self._jfield(sset, "emojis")):
            return None
        set_id = _to_int64(self._jfield(sset, "id"), 0)
        access_hash = _to_int64(self._jfield(sset, "access_hash"), 0)
        if not set_id:
            return None
        return {
            "id": set_id,
            "access_hash": access_hash,
            "title": str(self._jfield(sset, "title") or "Мой Emoji-набор"),
            "short_name": str(self._jfield(sset, "short_name") or ""),
            "count": _to_int64(self._jfield(sset, "count"), 0),
        }

    def _add_emoji_to_my_set(self, ui, entry):
        if entry.get("doc") is None:
            BulletinHelper.show_error("Документ Emoji ещё не загружен")
            return
        request_class = getattr(TLRPC, "TL_messages_getMyStickers", None)
        if request_class is None:
            BulletinHelper.show_error("Эта версия клиента не поддерживает список собственных наборов")
            return

        BulletinHelper.show_info("Загружаю ваши Emoji-наборы…")
        owned = []
        seen = set()

        def request_page(offset_id):
            try:
                req = request_class()
                req.offset_id = int(offset_id)
                req.limit = 100

                def on_response(response, error):
                    run_on_ui_thread(lambda: process_page(offset_id, response, error))

                send_request(req, on_response)
            except Exception as e:
                self.log(f"[ChatEmoji] getMyStickers request: {e}")
                BulletinHelper.show_error("Не удалось загрузить ваши Emoji-наборы")

        def process_page(offset_id, response, error):
            if error is not None:
                error_text = str(self._jfield(error, "text") or error)
                BulletinHelper.show_error(f"Не удалось загрузить наборы: {error_text}")
                return
            covered_sets = _java_values(self._jfield(response, "sets"))
            last_id = 0
            for covered in covered_sets:
                raw_set = self._jfield(covered, "set") or covered
                raw_id = _to_int64(self._jfield(raw_set, "id"), 0)
                if raw_id:
                    last_id = raw_id
                info = self._owned_emoji_set_info(covered)
                if info is not None and info["id"] not in seen:
                    seen.add(info["id"])
                    owned.append(info)
            if _should_request_next_owned_page(len(covered_sets), last_id, offset_id):
                request_page(last_id)
                return
            merged_owned = self._merge_recent_owned_sets(owned)
            self._show_owned_emoji_sets(ui, entry, merged_owned)

        request_page(0)

    def _show_owned_emoji_sets(self, ui, entry, owned):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        if not owned:
            builder.setTitle("Нет собственных Emoji-наборов")
            container = LinearLayout(activity)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setPadding(dp(22), dp(12), dp(22), dp(12))
            message = TextView(activity)
            message.setText("Создай набор через @stickers, затем повтори добавление.")
            message.setTextSize(1, 15.0)
            message.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            container.addView(message, LinearLayout.LayoutParams(-1, -2))
            button = TextView(activity)
            button.setText("Открыть @stickers")
            button.setTextSize(1, 16.0)
            button.setTypeface(Typeface.DEFAULT_BOLD)
            button.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            button.setPadding(0, dp(18), 0, dp(8))
            button.setOnClickListener(click_listener(self._open_stickers_bot))
            container.addView(button, LinearLayout.LayoutParams(-1, -2))
            builder.setView(container)
            builder.setNegativeButton("Закрыть", None)
            builder.show()
            return

        builder.setTitle("Добавить Emoji в набор")
        scroll = ScrollView(activity)
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(0, dp(6), 0, dp(6))
        dialog_ref = []

        for target in owned:
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.VERTICAL)
            row.setPadding(dp(22), dp(10), dp(22), dp(10))
            title = TextView(activity)
            title.setText(target["title"])
            title.setTextSize(1, 16.0)
            title.setTypeface(Typeface.DEFAULT_BOLD)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            row.addView(title, LinearLayout.LayoutParams(-1, -2))
            sub = TextView(activity)
            count_text = f"{target['count']} Emoji" if target["count"] else "Собственный Emoji-набор"
            sub.setText(count_text)
            sub.setTextSize(1, 13.0)
            sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            row.addView(sub, LinearLayout.LayoutParams(-1, -2))

            def select_target(chosen=target):
                if dialog_ref:
                    try:
                        dialog_ref[0].dismiss()
                    except Exception:
                        pass
                self._send_add_emoji_to_set(entry, chosen)

            row.setOnClickListener(click_listener(select_target))
            container.addView(row, LinearLayout.LayoutParams(-1, -2))

        scroll.addView(container)
        builder.setView(scroll)
        builder.setNegativeButton("Отмена", None)
        dialog_ref.append(builder.show())

    def _make_add_emoji_request(self, entry, target):
        document = entry.get("doc")
        if document is None:
            raise ValueError("emoji document is missing")

        input_document = TLRPC.TL_inputDocument()
        input_document.id = _to_int64(self._jfield(document, "id"), 0)
        input_document.access_hash = _to_int64(self._jfield(document, "access_hash"), 0)
        input_document.file_reference = self._jfield(document, "file_reference")
        if not input_document.id or not input_document.access_hash or input_document.file_reference is None:
            raise ValueError("emoji input document is incomplete")

        item = TLRPC.TL_inputStickerSetItem()
        item.document = input_document
        item.emoji = str(entry.get("emoji") or "🙂")

        target_set = TLRPC.TL_inputStickerSetID()
        target_set.id = int(target["id"])
        target_set.access_hash = int(target["access_hash"])

        req = TLRPC.TL_stickers_addStickerToSet()
        req.stickerset = target_set
        req.sticker = item
        return req

    def _send_add_emoji_to_set(self, entry, target):
        try:
            req = self._make_add_emoji_request(entry, target)

            def on_response(response, error):
                def finish():
                    if error is not None:
                        error_text = str(self._jfield(error, "text") or error)
                        if "STICKERPACK_STICKERS_TOO_MUCH" in error_text or "STICKERS_TOO_MUCH" in error_text:
                            BulletinHelper.show_error("В выбранном наборе больше нет места")
                        elif "STICKERSET_INVALID" in error_text:
                            BulletinHelper.show_error("Набор недоступен для изменения")
                        elif "FILE_REFERENCE" in error_text:
                            BulletinHelper.show_error("Ссылка на Emoji устарела — открой поиск заново")
                        elif "STICKER" in error_text and "EXIST" in error_text:
                            BulletinHelper.show_info("Этот Emoji уже есть в наборе")
                        else:
                            BulletinHelper.show_error(f"Не удалось добавить Emoji: {error_text}")
                        return
                    BulletinHelper.show_success(f"Emoji добавлен в «{target['title']}»")
                run_on_ui_thread(finish)

            send_request(req, on_response)
        except Exception as e:
            self.log(f"[ChatEmoji] add emoji to set: {e}")
            BulletinHelper.show_error("Не удалось подготовить Emoji для добавления")

    def _open_stickers_bot(self):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                BulletinHelper.show_error("Не удалось открыть @stickers")
                return
            get_messages_controller().openByUserName("stickers", fragment, 1)
        except Exception as e:
            self.log(f"[ChatEmoji] open @stickers: {e}")
            BulletinHelper.show_error("Не удалось открыть @stickers")

    def _jump_to_message(self, ui, entry):
        try:
            ui["sheet"].dismiss()
        except Exception:
            pass
        try:
            dialog_id = ui["dialog_id"]
            args = Bundle()
            if dialog_id > 0:
                args.putLong("user_id", dialog_id)
            else:
                args.putLong("chat_id", -dialog_id)
            args.putInt("message_id", entry["msg_id"])
            fragment = get_last_fragment()
            if fragment is not None:
                fragment.presentFragment(ChatActivity(args))
        except Exception as e:
            self.log(f"[ChatStickers] jump: {e}")

    def _cycle_default_sort(self, view):
        current = str(self.get_setting("default_sort", "date"))
        if current not in SORT_MODES:
            current = "date"
        new = SORT_MODES[(SORT_MODES.index(current) + 1) % len(SORT_MODES)]
        self.set_setting("default_sort", new, reload_settings=True)
        BulletinHelper.show_info(f"Сортировка по умолчанию: {SORT_TITLES[new]}")

    def create_settings(self):
        current_sort = str(self.get_setting("default_sort", "date"))
        if current_sort not in SORT_MODES:
            current_sort = "date"
        return [
            Header(text="Chat Emoji"),
            Switch(key="default_grid", text="Сетка по умолчанию",
                   subtext="Открывать Emoji в виде сетки; иначе — списком с автором и датой",
                   default=False),
            Switch(key="pack_numbering", text="Нумерация наборов",
                   subtext="Показывать метки Н1, Н2, Н3 у смайлов из одного набора",
                   default=True),
            Text(text=f"Сортировка по умолчанию: {SORT_TITLES[current_sort]}",
                 on_click=self._cycle_default_sort),
            Switch(key="animations", text="Анимации", default=True),
            Divider(),
            Input(key="scan_depth", text="Глубина автосканирования",
                  default=str(DEFAULT_SCAN_DEPTH),
                  subtext="Сколько сообщений листать за одно открытие экрана. Дальше — кнопкой «Сканировать дальше»"),
            Custom(factory=USAGE_SETTING_FACTORY.instance.java),
        ]

class ChatStickersFeature:
    def __init__(self, host):
        self._host = host

    def __getattr__(self, name):
        return getattr(self._host, name)

    MENU_ITEM_ID = "chat_sticker_working_18_open"

    def on_plugin_load(self):
        self._sticker_cache = {}
        self._sticker_generation = 0
        self._active_sticker_dialog = 0
        self._active_chat_token = None
        self._sender_name_cache = {}
        self._set_title_cache = {}
        self._pending_create_callbacks = {}
        self._recent_owned_sets = self._load_recent_owned_sets()
        self._lock = threading.Lock()
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="Стикеры чата",
            on_click=self._on_sticker_menu_click,
            icon="input_smile",
            item_id=self.MENU_ITEM_ID,
        ))

    def on_plugin_unload(self):
        with self._lock:
            self._sticker_cache.clear()
        self._sender_name_cache.clear()
        self._set_title_cache.clear()
        self._pending_create_callbacks.clear()

    RECENT_OWNED_SETTING_KEY = "recent_owned_sticker_sets"

    def _load_recent_owned_sets(self):
        try:
            return _decode_recent_owned_sets(
                self.get_setting(self.RECENT_OWNED_SETTING_KEY, "[]")
            )
        except Exception:
            return []

    def _save_recent_owned_sets(self):
        try:
            value = json.dumps(
                list(getattr(self, "_recent_owned_sets", []) or [])[:RECENT_OWNED_SET_LIMIT],
                ensure_ascii=False,
                separators=(",", ":"),
            )
            self.set_setting(self.RECENT_OWNED_SETTING_KEY, value, reload_settings=False)
        except Exception as e:
            self.log(f"[ChatStickers] save recent owned sets: {e}")

    def _remember_recent_owned_set(self, target):
        item = dict(target or {})
        if not _to_int64(item.get("id"), 0) and not str(item.get("short_name") or "").strip():
            return
        item["saved_at"] = int(time.time())
        current = list(getattr(self, "_recent_owned_sets", []) or [])
        self._recent_owned_sets = _merge_owned_sets(current, [item])[-RECENT_OWNED_SET_LIMIT:]
        self._save_recent_owned_sets()

    def _merge_recent_owned_sets(self, owned):
        current = list(getattr(self, "_recent_owned_sets", []) or [])
        merged = _merge_owned_sets(owned, current)
        api_ids = {_to_int64(item.get("id"), 0) for item in list(owned or [])}
        if api_ids:
            self._recent_owned_sets = [
                item for item in current
                if _to_int64(item.get("id"), 0) not in api_ids
            ]
            self._save_recent_owned_sets()
        return merged

    def _on_sticker_menu_click(self, context):
        try:
            dialog_id = self._dialog_id_from_context(context)
            activity = self._activity()
            if dialog_id == 0 or activity is None:
                BulletinHelper.show_error("Не удалось определить чат")
                return
            self._open_sticker_sheet(activity, dialog_id)
        except Exception as e:
            self.log(f"[ChatStickers] menu click: {e}")

    def _dialog_id_from_context(self, context):
        for key in ("dialog_id", "dialogId"):
            try:
                val = context.get(key)
                if val is not None:
                    return int(val)
            except Exception:
                pass
        try:
            chat = context.get("chat")
            if chat is not None:
                return -int(chat.id)
        except Exception:
            pass
        try:
            user = context.get("user")
            if user is not None:
                return int(user.id)
        except Exception:
            pass
        fragment = get_last_fragment()
        if fragment and hasattr(fragment, "getDialogId"):
            try:
                return int(fragment.getDialogId())
            except Exception:
                pass
        return 0

    def _activity(self):
        f = get_last_fragment()
        return f.getParentActivity() if f is not None else None

    def _jfield(self, obj, name):
        # Ответы и элементы Vector могут быть видны Python как базовый TLObject.
        # Читаем поле из реального Java-класса и всей цепочки наследования.
        return _java_field(obj, name, None)

    def _empty_sticker_state(self, generation):
        return {
            "generation": generation,
            "items": {},
            "items_revision": 0,
            "sorted_cache": {},
            "pack_label_cache": (-1, {}),
            "offset_id": 0,
            "finished": False,
            "scanned": 0,
            "scanning": False,
            "scan_budget": 0,
            "request_error": "",
            "seen_occurrences": set(),
        }

    def _mark_items_changed(self, state):
        state["items_revision"] = int(state.get("items_revision", 0)) + 1
        state["sorted_cache"] = {}
        state["pack_label_cache"] = (-1, {})

    def _new_sticker_session(self, dialog_id):
        # Each new chat session starts at offset_id=0 and invalidates old callbacks.
        with self._lock:
            self._sticker_generation += 1
            generation = self._sticker_generation
            self._active_sticker_dialog = int(dialog_id)
            self._sticker_cache.clear()
            self._sticker_cache[int(dialog_id)] = self._empty_sticker_state(generation)
            return generation

    def _current_chat_token(self):
        fragment = get_last_fragment()
        if fragment is None:
            return "none"
        try:
            return f"{_java_class_name(fragment)}:{int(fragment.hashCode())}"
        except Exception:
            try:
                return f"{_java_class_name(fragment)}:{str(fragment)}"
            except Exception:
                return str(id(fragment))

    def _reusable_sticker_session(self, dialog_id, chat_token):
        with self._lock:
            state = self._sticker_cache.get(int(dialog_id))
            if state is None:
                return None
            if int(dialog_id) != int(self._active_sticker_dialog):
                return None
            if chat_token != self._active_chat_token:
                return None
            if not state.get("items") or state.get("scanning"):
                return None
            return int(state.get("generation", self._sticker_generation))

    def _sticker_session_valid(self, dialog_id, ui):
        try:
            return (
                int(dialog_id) == int(self._active_sticker_dialog)
                and int(ui.get("generation", -1)) == int(self._sticker_generation)
            )
        except Exception:
            return False

    def _sticker_cache_for(self, dialog_id):
        with self._lock:
            entry = self._sticker_cache.get(int(dialog_id))
            if entry is None:
                entry = self._empty_sticker_state(self._sticker_generation)
                self._sticker_cache[int(dialog_id)] = entry
            return entry

    def _scan_depth(self):
        try:
            return max(PAGE_SIZE, int(self.get_setting("scan_depth", str(DEFAULT_SCAN_DEPTH))))
        except Exception:
            return DEFAULT_SCAN_DEPTH

    def _start_sticker_scan(self, dialog_id, ui):
        if not self._sticker_session_valid(dialog_id, ui):
            return
        state = self._sticker_cache_for(dialog_id)
        if state["scanning"] or state["finished"]:
            self._refresh_sticker_ui(dialog_id, ui)
            return
        state["scanning"] = True
        state["scan_budget"] = self._scan_depth()
        self._request_sticker_page(dialog_id, ui)

    def _request_sticker_page(self, dialog_id, ui):
        if not self._sticker_session_valid(dialog_id, ui):
            return
        state = self._sticker_cache_for(dialog_id)
        state["request_error"] = ""
        try:
            def on_response(response, error):
                self._on_sticker_page(dialog_id, ui, response, error)

            self._request_history_page_shared(
                dialog_id,
                int(state["offset_id"]),
                on_response,
            )
        except Exception as e:
            state["scanning"] = False
            state["request_error"] = str(e)
            self.log(f"[ChatStickers] shared history request: {e}")
            run_on_ui_thread(lambda: self._refresh_sticker_ui(dialog_id, ui))

    def _on_sticker_page(self, dialog_id, ui, response, error):
        if not self._sticker_session_valid(dialog_id, ui):
            return
        state = self._sticker_cache_for(dialog_id)
        try:
            if error is not None:
                state["scanning"] = False
                state["request_error"] = str(self._jfield(error, "text") or error)
                if "FLOOD_WAIT" in state["request_error"]:
                    BulletinHelper.show_error("Telegram просит подождать — попробуй позже")
                self._refresh_sticker_ui(dialog_id, ui)
                return

            direct_messages = _java_field(response, "messages", None)
            messages = _java_values(
                direct_messages if direct_messages is not None
                else self._jfield(response, "messages")
            )
            count = len(messages)
            min_id = None
            changed = False
            for msg in messages:
                try:
                    mid = _to_int64(self._jfield(msg, "id"), 0)
                    if mid and (min_id is None or mid < min_id):
                        min_id = mid
                    if self._consume_sticker_message(state, msg):
                        changed = True
                except Exception as e:
                    self.log(f"[ChatStickers] message parse: {e}")
            if changed:
                self._mark_items_changed(state)

            state["scanned"] += count
            state["scan_budget"] -= count
            if count < PAGE_SIZE or min_id is None or min_id <= 1:
                state["finished"] = True
                state["scanning"] = False
            else:
                state["offset_id"] = min_id
                if state["scan_budget"] <= 0:
                    state["scanning"] = False

            self._refresh_sticker_ui(dialog_id, ui)
            if state["scanning"]:
                self._request_sticker_page(dialog_id, ui)
        except Exception as e:
            state["scanning"] = False
            state["request_error"] = str(e)
            self.log(f"[ChatStickers] scan: {e}")
            self._refresh_sticker_ui(dialog_id, ui)

    def _consume_sticker_message(self, state, msg):
        media = self._jfield(msg, "media")
        document = self._jfield(media, "document") if media is not None else None
        if document is None:
            return False

        sticker_attribute = None
        for attribute in _java_values(self._jfield(document, "attributes")):
            normalized = "".join(
                ch for ch in _java_class_name(attribute).lower() if ch.isalnum()
            )
            if "documentattributesticker" in normalized:
                sticker_attribute = attribute
                break
        if sticker_attribute is None:
            return False

        msg_id = _to_int64(self._jfield(msg, "id"), 0)
        document_id = _to_int64(self._jfield(document, "id"), 0)
        if not document_id:
            return False
        occurrence = (msg_id, document_id)
        if occurrence in state["seen_occurrences"]:
            return False
        state["seen_occurrences"].add(occurrence)

        existing = state["items"].get(document_id)
        if existing is not None:
            existing["count"] += 1
            return True

        input_set = self._jfield(sticker_attribute, "stickerset")
        set_id = _to_int64(self._jfield(input_set, "id"), 0)
        set_hash = _to_int64(self._jfield(input_set, "access_hash"), 0)
        mime = str(self._jfield(document, "mime_type") or "").lower()
        if "tgsticker" in mime or "tgs" in mime:
            kind = "анимированный"
        elif "webm" in mime or "video" in mime:
            kind = "видео"
        else:
            kind = "статический"

        state["items"][document_id] = {
            "doc": document,
            "doc_id": document_id,
            "input_set": input_set,
            "set_id": set_id,
            "set_hash": set_hash,
            "emoji": str(self._jfield(sticker_attribute, "alt") or ""),
            "sender_id": self._sender_id(msg),
            "date": _to_int64(self._jfield(msg, "date"), 0),
            "msg_id": msg_id,
            "count": 1,
            "animated": kind != "статический",
            "kind": kind,
        }
        return True





    def _sender_id(self, msg):
        fid = self._jfield(msg, "from_id")
        if fid is not None:
            uid = _to_int64(self._jfield(fid, "user_id"), 0)
            if uid:
                return uid
            cid = _to_int64(self._jfield(fid, "channel_id"), 0)
            if cid:
                return -cid
        return 0

    def _sender_name(self, sender_id):
        if not sender_id:
            return "Аноним"
        cache = self._sender_name_cache
        if sender_id in cache:
            return cache[sender_id]
        result = str(sender_id)
        try:
            mc = get_messages_controller()
            if sender_id > 0:
                user = mc.getUser(sender_id)
                if user is not None:
                    name = f"{getattr(user, 'first_name', '') or ''} {getattr(user, 'last_name', '') or ''}".strip()
                    if name:
                        result = name
            else:
                chat = mc.getChat(-sender_id)
                if chat is not None and getattr(chat, "title", None):
                    result = str(chat.title)
        except Exception:
            pass
        cache[sender_id] = result
        return result

    def _set_title(self, set_id):
        set_id = int(set_id or 0)
        if not set_id:
            return None
        cache = self._set_title_cache
        if set_id in cache:
            return cache[set_id]
        title = None
        try:
            sset = MediaDataController.getInstance(
                UserConfig.selectedAccount
            ).getStickerSetById(set_id)
            if sset is not None and getattr(sset, "set", None) is not None:
                title = str(sset.set.title)
        except Exception:
            pass
        cache[set_id] = title
        return title

    def _open_sticker_sheet(self, activity, dialog_id):
        chat_token = self._current_chat_token()
        self._activate_history_session(dialog_id, chat_token)
        generation = self._reusable_sticker_session(dialog_id, chat_token)
        reused = generation is not None
        if not reused:
            generation = self._new_sticker_session(dialog_id)
            self._active_chat_token = chat_token
        else:
            self._active_sticker_dialog = int(dialog_id)

        ui = {
            "grid": bool(self.get_setting("default_grid", False)),
            "packs_only": False,
            "sort": str(self.get_setting("default_sort", "date")),
            "show_pack_numbers": bool(self.get_setting("pack_numbering", True)),
            "activity": activity,
            "dialog_id": dialog_id,
            "generation": generation,
        }
        if ui["sort"] not in SORT_MODES:
            ui["sort"] = "date"

        root = LinearLayout(activity)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setBackgroundColor(Theme.getColor(Theme.key_dialogBackground))
        root.setLayoutParams(FrameLayout.LayoutParams(-1, -1))
        root.addView(self._build_sticker_header(activity, ui))

        status_row = LinearLayout(activity)
        status_row.setOrientation(LinearLayout.HORIZONTAL)
        status_row.setGravity(Gravity.CENTER_VERTICAL)
        status_row.setPadding(dp(16), dp(2), dp(16), dp(2))
        progress = ProgressBar(activity)
        plp = LinearLayout.LayoutParams(dp(14), dp(14))
        plp.setMargins(0, 0, dp(8), 0)
        status_row.addView(progress, plp)
        status_tv = TextView(activity)
        status_tv.setTextSize(1, 12.0)
        status_tv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
        status_row.addView(status_tv)
        root.addView(status_row)
        ui["progress"] = progress
        ui["status"] = status_tv

        scroll = ScrollView(activity)

        class ScrollGuard(dynamic_proxy(View.OnTouchListener)):
            def onTouch(s, v, event):
                try:
                    action = event.getAction()
                    if action == MotionEvent.ACTION_DOWN:
                        v.getParent().requestDisallowInterceptTouchEvent(True)
                    elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        v.getParent().requestDisallowInterceptTouchEvent(False)
                except Exception:
                    pass
                return False
        scroll.setOnTouchListener(ScrollGuard())

        content = LinearLayout(activity)
        content.setOrientation(LinearLayout.VERTICAL)
        content.setPadding(dp(10), dp(6), dp(10), dp(16))
        scroll.addView(content)
        root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1.0))
        ui["content"] = content

        sheet = BottomSheet(activity, False)
        sheet.setCustomView(root)
        ui["sheet"] = sheet
        sheet.show()

        self._refresh_sticker_ui(dialog_id, ui)
        if not reused:
            self._start_sticker_scan(dialog_id, ui)

    def _build_sticker_header(self, activity, ui):
        wrap = LinearLayout(activity)
        wrap.setOrientation(LinearLayout.VERTICAL)

        handle = View(activity)
        handle.setBackgroundDrawable(Theme.createRoundRectDrawable(
            dp(2), Theme.getColor(Theme.key_sheet_scrollUp)))
        hlp = LinearLayout.LayoutParams(dp(34), dp(4))
        hlp.gravity = Gravity.CENTER_HORIZONTAL
        hlp.setMargins(0, dp(8), 0, 0)
        wrap.addView(handle, hlp)

        header = LinearLayout(activity)
        header.setOrientation(LinearLayout.HORIZONTAL)
        header.setGravity(Gravity.CENTER_VERTICAL)
        header.setPadding(dp(18), dp(8), dp(10), dp(6))

        title = TextView(activity)
        title.setText("Стикеры чата")
        title.setTextSize(1, 19.0)
        title.setTypeface(Typeface.DEFAULT_BOLD)
        title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        header.addView(title, LinearLayout.LayoutParams(0, -2, 1.0))

        ui["btn_sort"] = self._header_button(
            activity, header, "⇅", lambda: self._cycle_sticker_sort(ui))
        ui["btn_packs"] = self._header_button(
            activity, header, "▤", lambda: self._toggle_sticker_packs(ui))
        ui["btn_mode"] = self._header_button(
            activity, header, "▦", lambda: self._toggle_sticker_mode(ui))
        self._header_button(activity, header, "✕", lambda: ui["sheet"].dismiss())
        self._sync_sticker_header_icons(ui)
        wrap.addView(header)
        return wrap

    def _header_button(self, activity, parent, symbol, fn):
        btn = TextView(activity)
        btn.setText(symbol)
        btn.setTextSize(1, 18.0)
        btn.setTypeface(Typeface.DEFAULT_BOLD)
        btn.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        btn.setGravity(Gravity.CENTER)
        btn.setClickable(True)
        lp = LinearLayout.LayoutParams(dp(40), dp(40))
        lp.setMargins(dp(2), 0, dp(2), 0)
        btn.setOnClickListener(click_listener(fn))
        self._touch_anim(btn)
        parent.addView(btn, lp)
        return btn

    def _touch_anim(self, view):
        class _T(dynamic_proxy(View.OnTouchListener)):
            def onTouch(s, v, event):
                try:
                    action = event.getAction()
                    if action == MotionEvent.ACTION_DOWN:
                        v.animate().scaleX(0.82).scaleY(0.82).setDuration(60).start()
                    elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        v.animate().scaleX(1.0).scaleY(1.0).setDuration(90).start()
                except Exception:
                    pass
                return False
        view.setOnTouchListener(_T())

    def _sync_sticker_header_icons(self, ui):
        ui["btn_mode"].setText("▦" if not ui["grid"] else "☰")
        accent = Theme.getColor(Theme.key_featuredStickers_addButton)
        plain = Theme.getColor(Theme.key_dialogTextBlack)
        ui["btn_packs"].setTextColor(accent if ui["packs_only"] else plain)
        ui["btn_sort"].setTextColor(accent if ui["sort"] != "date" else plain)

    def _toggle_sticker_mode(self, ui):
        ui["grid"] = not ui["grid"]
        self._sync_sticker_header_icons(ui)
        self._animate_sticker_refresh(ui)

    def _toggle_sticker_packs(self, ui):
        ui["packs_only"] = not ui["packs_only"]
        self._sync_sticker_header_icons(ui)
        self._animate_sticker_refresh(ui)

    def _cycle_sticker_sort(self, ui):
        ui["sort"] = SORT_MODES[(SORT_MODES.index(ui["sort"]) + 1) % len(SORT_MODES)]
        self._sync_sticker_header_icons(ui)
        self._animate_sticker_refresh(ui)

    def _animate_sticker_refresh(self, ui):
        if not self.get_setting("animations", True):
            self._refresh_sticker_ui(ui["dialog_id"], ui)
            return
        content = ui["content"]
        plugin = self

        class _After(dynamic_proxy(Runnable)):
            def run(s):
                try:
                    plugin._refresh_sticker_ui(ui["dialog_id"], ui)
                    content.setAlpha(0.0)
                    content.animate().alpha(1.0).setDuration(160).start()
                except Exception:
                    pass
        content.animate().alpha(0.0).setDuration(110).withEndAction(_After()).start()

    def _sorted_sticker_items(self, ui):
        state = self._sticker_cache_for(ui["dialog_id"])
        cache_key = (
            int(state.get("items_revision", 0)),
            str(ui["sort"]),
            bool(ui["packs_only"]),
        )
        cache = state["sorted_cache"]
        if cache_key in cache:
            return cache[cache_key]

        items = list(state["items"].values())
        sort = ui["sort"]
        if sort == "count":
            items.sort(key=lambda e: (-e["count"], -e["date"]))
        elif sort == "pack":
            items.sort(key=lambda e: (e["set_id"], -e["date"]))
        else:
            items.sort(key=lambda e: -e["date"])

        if not ui["packs_only"]:
            result = [(entry, []) for entry in items]
        else:
            groups = {}
            order = []
            for entry in items:
                key = entry["set_id"] or ("solo", entry["doc_id"])
                if key in groups:
                    groups[key].append(entry)
                else:
                    groups[key] = []
                    order.append((key, entry))
            result = [(head, groups[key][:3]) for key, head in order]

        state["sorted_cache"] = {cache_key: result}
        return result

    def _pack_label_map(self, state):
        revision = int(state.get("items_revision", 0))
        cached_revision, cached_labels = state.get("pack_label_cache", (-1, {}))
        if cached_revision == revision:
            return cached_labels

        counts = {}
        order = []
        for entry in state["items"].values():
            set_id = int(entry.get("set_id") or 0)
            if not set_id:
                continue
            if set_id not in counts:
                counts[set_id] = 0
                order.append(set_id)
            counts[set_id] += 1
        labels = {}
        number = 1
        for set_id in order:
            if counts.get(set_id, 0) > 1:
                labels[set_id] = f"Н{number}"
                number += 1
        state["pack_label_cache"] = (revision, labels)
        return labels

    def _pack_labels_for_ui(self, state, ui):
        if not bool(ui.get("show_pack_numbers", True)):
            return {}
        return self._pack_label_map(state)

    def _refresh_sticker_ui(self, dialog_id, ui):
        if not self._sticker_session_valid(dialog_id, ui):
            return
        try:
            state = self._sticker_cache_for(dialog_id)
            busy = bool(state["scanning"])
            status = SORT_TITLES[ui["sort"]]
            if ui["packs_only"]:
                status += " · только наборы"
            status += f" · {state['scanned']} сообщ. · {len(state['items'])} стикеров"
            if busy:
                status += " · поиск…"
            if state["request_error"]:
                status += " · ошибка загрузки"

            if ui.get("_last_status") != status:
                ui["status"].setText(status)
                ui["_last_status"] = status
            visibility = View.VISIBLE if busy else View.GONE
            if ui.get("_last_progress_visibility") != visibility:
                ui["progress"].setVisibility(visibility)
                ui["_last_progress_visibility"] = visibility

            content_key = (
                int(state.get("items_revision", 0)),
                bool(ui["grid"]),
                bool(ui["packs_only"]),
                str(ui["sort"]),
                bool(state["finished"]),
                busy,
            )
            if ui.get("_last_content_key") == content_key:
                return

            now = time.monotonic()
            last_render = float(ui.get("_last_content_render_at", 0.0) or 0.0)
            if busy and now - last_render < UI_RENDER_INTERVAL:
                if not ui.get("_refresh_scheduled"):
                    ui["_refresh_scheduled"] = True
                    delay = max(0.01, UI_RENDER_INTERVAL - (now - last_render))
                    timer = threading.Timer(
                        delay,
                        lambda: run_on_ui_thread(
                            lambda: self._deferred_sticker_refresh(dialog_id, ui)
                        ),
                    )
                    timer.daemon = True
                    timer.start()
                return

            ui["_refresh_scheduled"] = False
            ui["_last_content_render_at"] = now
            content = ui["content"]
            content.removeAllViews()
            activity = ui["activity"]
            rows = self._sorted_sticker_items(ui)
            ui["pack_labels"] = self._pack_labels_for_ui(state, ui)

            if not rows:
                empty = TextView(activity)
                empty.setText(
                    "Стикеры пока не найдены"
                    if not state["finished"]
                    else "В этом чате нет стикеров"
                )
                empty.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
                empty.setGravity(Gravity.CENTER)
                empty.setPadding(dp(16), dp(40), dp(16), dp(20))
                content.addView(empty, LinearLayout.LayoutParams(-1, -2))
            elif ui["grid"]:
                self._render_sticker_grid(activity, content, ui, rows)
            else:
                self._render_sticker_rows(activity, content, ui, rows)

            if not state["finished"] and not busy:
                more = TextView(activity)
                more.setText("Сканировать дальше")
                more.setTextSize(1, 15.0)
                more.setTypeface(Typeface.DEFAULT_BOLD)
                more.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                more.setGravity(Gravity.CENTER)
                more.setPadding(0, dp(14), 0, dp(14))
                more.setOnClickListener(click_listener(
                    lambda: self._start_sticker_scan(dialog_id, ui)))
                content.addView(more, LinearLayout.LayoutParams(-1, -2))

            ui["_last_content_key"] = content_key
        except Exception as e:
            self.log(f"[ChatStickers] refresh: {e}")

    def _deferred_sticker_refresh(self, dialog_id, ui):
        ui["_refresh_scheduled"] = False
        self._refresh_sticker_ui(dialog_id, ui)

    def _render_sticker_grid(self, activity, content, ui, rows):
        per_row = 4
        row_layout = None
        for idx, (entry, _tail) in enumerate(rows):
            if idx % per_row == 0:
                row_layout = LinearLayout(activity)
                row_layout.setOrientation(LinearLayout.HORIZONTAL)
                content.addView(row_layout, LinearLayout.LayoutParams(-1, -2))
            lp = LinearLayout.LayoutParams(0, dp(92), 1.0)
            lp.setMargins(dp(3), dp(3), dp(3), dp(3))
            row_layout.addView(self._sticker_cell(activity, ui, entry), lp)
        if rows and len(rows) % per_row != 0:
            for _ in range(per_row - len(rows) % per_row):
                lp = LinearLayout.LayoutParams(0, dp(92), 1.0)
                lp.setMargins(dp(3), dp(3), dp(3), dp(3))
                row_layout.addView(View(activity), lp)

    def _render_sticker_rows(self, activity, content, ui, rows):
        for idx, (entry, tail) in enumerate(rows):
            if idx:
                divider = View(activity)
                divider.setBackgroundColor(Theme.getColor(Theme.key_divider))
                dlp = LinearLayout.LayoutParams(-1, 1)
                dlp.setMargins(dp(80), 0, 0, 0)
                content.addView(divider, dlp)
            content.addView(
                self._sticker_row(activity, ui, entry, tail),
                LinearLayout.LayoutParams(-1, -2),
            )

    def _sticker_cell(self, activity, ui, entry):
        frame = FrameLayout(activity)
        frame.setBackgroundDrawable(Theme.createRoundRectDrawable(
            dp(10), Theme.getColor(Theme.key_graySection)))
        iv = BackupImageView(activity)
        self._bind_sticker_image(iv, entry)
        ilp = FrameLayout.LayoutParams(-1, -1)
        ilp.setMargins(dp(8), dp(8), dp(8), dp(8))
        frame.addView(iv, ilp)
        if entry.get("doc") is None:
            fallback = TextView(activity)
            fallback.setText(entry.get("emoji") or "ID")
            fallback.setTextSize(1, 26.0 if entry.get("emoji") else 12.0)
            fallback.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            fallback.setGravity(Gravity.CENTER)
            frame.addView(fallback, FrameLayout.LayoutParams(-1, -1))
        if entry["count"] > 1:
            badge = TextView(activity)
            badge.setText(f"×{entry['count']}")
            badge.setTextSize(1, 11.0)
            badge.setTypeface(Typeface.DEFAULT_BOLD)
            badge.setTextColor(Color.WHITE)
            badge.setBackgroundDrawable(Theme.createRoundRectDrawable(
                dp(9), Theme.getColor(Theme.key_featuredStickers_addButton)))
            badge.setPadding(dp(6), dp(1), dp(6), dp(1))
            blp = FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.END)
            blp.setMargins(0, dp(2), dp(2), 0)
            frame.addView(badge, blp)
        pack_label = ui.get("pack_labels", {}).get(int(entry.get("set_id") or 0))
        if pack_label:
            pack_badge = TextView(activity)
            pack_badge.setText(pack_label)
            pack_badge.setTextSize(1, 10.0)
            pack_badge.setTypeface(Typeface.DEFAULT_BOLD)
            pack_badge.setTextColor(Color.WHITE)
            pack_badge.setBackgroundDrawable(Theme.createRoundRectDrawable(
                dp(8), Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)))
            pack_badge.setPadding(dp(5), dp(1), dp(5), dp(1))
            plp = FrameLayout.LayoutParams(-2, -2, Gravity.BOTTOM | Gravity.START)
            plp.setMargins(dp(4), 0, 0, dp(4))
            frame.addView(pack_badge, plp)
        frame.setOnClickListener(click_listener(lambda: self._sticker_menu(ui, entry)))
        frame.setOnLongClickListener(long_click_listener(
            lambda: self._sticker_menu(ui, entry)))
        return frame

    def _sticker_row(self, activity, ui, entry, tail):
        row = LinearLayout(activity)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(4), dp(6), dp(4), dp(6))

        stack = FrameLayout(activity)
        stack_w = dp(64) + (dp(20) * len(tail) if tail else 0)
        alphas = (0.5, 0.32, 0.18)
        for i, tail_entry in enumerate(reversed(tail)):
            ghost = BackupImageView(activity)
            self._bind_sticker_image(ghost, tail_entry)
            ghost.setAlpha(alphas[min(len(tail) - 1 - i, 2)])
            glp = FrameLayout.LayoutParams(dp(64), dp(64), Gravity.CENTER_VERTICAL)
            glp.setMargins(dp(20) * (len(tail) - i), 0, 0, 0)
            stack.addView(ghost, glp)
        image = BackupImageView(activity)
        self._bind_sticker_image(image, entry)
        stack.addView(image, FrameLayout.LayoutParams(dp(64), dp(64), Gravity.CENTER_VERTICAL))
        row.addView(stack, LinearLayout.LayoutParams(stack_w, dp(68)))

        column = LinearLayout(activity)
        column.setOrientation(LinearLayout.VERTICAL)
        clp = LinearLayout.LayoutParams(0, -2, 1.0)
        clp.setMargins(dp(12), 0, dp(6), 0)

        title = TextView(activity)
        pack_title = self._set_title(entry["set_id"]) if entry["set_id"] else None
        pack_label = ui.get("pack_labels", {}).get(int(entry.get("set_id") or 0))
        title_text = pack_title or (entry.get("emoji") or "Стикер")
        if pack_label:
            title_text = f"{pack_label} · {title_text}"
        title.setText(title_text)
        title.setTextSize(1, 15.0)
        title.setTypeface(Typeface.DEFAULT_BOLD)
        title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        title.setSingleLine(True)
        column.addView(title)

        sub = TextView(activity)
        when = time.strftime("%d.%m.%Y %H:%M", time.localtime(entry["date"])) if entry["date"] else ""
        count_part = f" · ×{entry['count']}" if entry["count"] > 1 else ""
        sub.setText(
            f"{self._sender_name(entry['sender_id'])} · {when}{count_part} · "
            f"{entry.get('kind') or 'стикер'}"
        )
        sub.setTextSize(1, 13.0)
        sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
        sub.setSingleLine(True)
        column.addView(sub)
        row.addView(column, clp)

        row.setOnClickListener(click_listener(lambda: self._sticker_menu(ui, entry)))
        row.setOnLongClickListener(long_click_listener(lambda: self._sticker_menu(ui, entry)))
        return row

    def _bind_sticker_image(self, iv, entry):
        try:
            doc = entry.get("doc")
            if doc is None:
                return
            thumbs = getattr(doc, "thumbs", None)
            thumb = None
            if thumbs is not None and thumbs.size() > 0:
                thumb = FileLoader.getClosestPhotoSizeWithSize(thumbs, 320)
            if entry["animated"] and thumb is not None:
                loc = ImageLocation.getForDocument(thumb, doc)
            else:
                loc = ImageLocation.getForDocument(doc)
            iv.setImage(loc, "100_100", cast(Drawable, None), doc)
        except Exception as e:
            self.log(f"[ChatStickers] bind image: {e}")

    def _input_set(self, entry):
        s = TLRPC.TL_inputStickerSetID()
        s.id = entry["set_id"]
        s.access_hash = entry["set_hash"]
        return s

    def _open_sticker_pack(self, ui, entry):
        input_set = entry.get("input_set")
        if input_set is None and not entry["set_id"]:
            BulletinHelper.show_info("У этого стикера нет набора")
            return
        try:
            best = None
            for constructor in StickersAlert.getClass().getConstructors():
                names = [p.getSimpleName() for p in constructor.getParameterTypes()]
                if (len(names) >= 3 and "Context" in names[0]
                        and "BaseFragment" in names[1]
                        and "InputStickerSet" in names[2]):
                    if best is None or len(names) < len(best.getParameterTypes()):
                        best = constructor
            if best is None:
                raise RuntimeError("no matching StickersAlert constructor")
            args = [
                ui["activity"],
                get_last_fragment(),
                input_set if input_set is not None else self._input_set(entry),
            ]
            for parameter in best.getParameterTypes()[3:]:
                name = parameter.getSimpleName()
                if name == "boolean":
                    args.append(False)
                elif name in ("int", "long", "short", "byte", "float", "double"):
                    args.append(0)
                else:
                    args.append(None)
            alert = best.newInstance(*args)
            alert.show()
        except Exception as e:
            self.log(f"[ChatStickers] open pack: {e}")
            BulletinHelper.show_error("Не удалось открыть набор стикеров")

    def _sticker_menu(self, ui, entry):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle(entry.get("emoji") or "Стикер")

        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(0, dp(8), 0, dp(8))
        dialog_ref = []

        def add_item(text, callback):
            view = TextView(activity)
            view.setText(text)
            view.setTextSize(1, 16.0)
            view.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            view.setPadding(dp(22), dp(12), dp(22), dp(12))
            view.setClickable(True)

            def on_click():
                if dialog_ref:
                    try:
                        dialog_ref[0].dismiss()
                    except Exception:
                        pass
                callback()
            view.setOnClickListener(click_listener(on_click))
            container.addView(view, LinearLayout.LayoutParams(-1, -2))

        add_item("Посмотреть набор", lambda: self._open_sticker_pack(ui, entry))
        add_item("Скопировать набор", lambda: self._copy_sticker_pack(ui, entry))
        add_item("Добавить стикер в мой набор", lambda: self._add_sticker_to_my_set(ui, entry))
        add_item("Перейти к сообщению", lambda: self._jump_to_message(ui, entry))

        builder.setView(container)
        builder.setNegativeButton("Отмена", None)
        dialog_ref.append(builder.show())

    def _make_get_source_pack_request(self, entry):
        input_set = entry.get("input_set")
        if input_set is None:
            if not entry.get("set_id"):
                raise ValueError("sticker set is missing")
            input_set = self._input_set(entry)
        request_class = getattr(TLRPC, "TL_messages_getStickerSet", None)
        if request_class is None:
            raise RuntimeError("messages.getStickerSet is unavailable")
        req = request_class()
        req.stickerset = input_set
        req.hash = 0
        return req

    def _input_document_from_document(self, document):
        input_document = TLRPC.TL_inputDocument()
        input_document.id = _to_int64(self._jfield(document, "id"), 0)
        input_document.access_hash = _to_int64(self._jfield(document, "access_hash"), 0)
        input_document.file_reference = self._jfield(document, "file_reference")
        if (not input_document.id or not input_document.access_hash
                or input_document.file_reference is None):
            raise ValueError("sticker input document is incomplete")
        return input_document

    def _input_item_from_document(self, document, emoji, keywords=""):
        item = TLRPC.TL_inputStickerSetItem()
        item.document = self._input_document_from_document(document)
        item.emoji = str(emoji or "🙂")
        keywords = str(keywords or "").strip()
        if keywords:
            item.keywords = keywords
            try:
                item.flags = int(self._jfield(item, "flags") or 0) | 2
            except Exception:
                pass
        return item

    def _document_sticker_alt(self, document):
        for attribute in _java_values(self._jfield(document, "attributes")):
            normalized = "".join(
                ch for ch in _java_class_name(attribute).lower() if ch.isalnum()
            )
            if "documentattributesticker" in normalized:
                return str(self._jfield(attribute, "alt") or "")
        return ""

    def _parse_source_sticker_pack(self, response):
        source_set = self._jfield(response, "set")
        if source_set is None:
            raise ValueError("Telegram did not return sticker set info")
        if bool(self._jfield(source_set, "emojis")):
            raise ValueError("This is a custom emoji set, not a regular sticker set")
        if bool(self._jfield(source_set, "masks")):
            raise ValueError("Mask sticker sets are not supported")

        emoji_by_document = {}
        for pack in _java_values(self._jfield(response, "packs")):
            emoticon = str(self._jfield(pack, "emoticon") or "")
            for document_id in _java_values(self._jfield(pack, "documents")):
                doc_id = _to_int64(document_id, 0)
                if doc_id and emoticon and doc_id not in emoji_by_document:
                    emoji_by_document[doc_id] = emoticon

        keywords_by_document = {}
        for keyword in _java_values(self._jfield(response, "keywords")):
            doc_id = _to_int64(self._jfield(keyword, "document_id"), 0)
            values = [
                str(value) for value in _java_values(self._jfield(keyword, "keyword"))
                if str(value)
            ]
            if doc_id and values:
                keywords_by_document[doc_id] = ",".join(values)

        items = []
        kinds = set()
        for document in _java_values(self._jfield(response, "documents")):
            doc_id = _to_int64(self._jfield(document, "id"), 0)
            emoji = self._document_sticker_alt(document) or emoji_by_document.get(doc_id) or "🙂"
            keywords = keywords_by_document.get(doc_id, "")
            try:
                input_item = self._input_item_from_document(document, emoji, keywords)
            except Exception:
                continue
            mime = str(self._jfield(document, "mime_type") or "").lower()
            if "tgsticker" in mime or "tgs" in mime:
                kind = "анимированный"
            elif "webm" in mime or "video" in mime:
                kind = "видео"
            else:
                kind = "статический"
            kinds.add(kind)
            items.append({
                "document": document,
                "document_id": doc_id,
                "emoji": emoji,
                "keywords": keywords,
                "input_item": input_item,
                "kind": kind,
            })

        if not items:
            raise ValueError("The source set has no reusable sticker documents")
        return {
            "id": _to_int64(self._jfield(source_set, "id"), 0),
            "access_hash": _to_int64(self._jfield(source_set, "access_hash"), 0),
            "title": str(self._jfield(source_set, "title") or "Набор стикеров"),
            "short_name": str(self._jfield(source_set, "short_name") or ""),
            "kinds": kinds,
            "items": items,
        }

    def _make_create_copied_pack_request(self, pack, title, short_name):
        items = list(pack.get("items") or [])
        if not items:
            raise ValueError("source sticker set is empty")
        request_class = getattr(TLRPC, "TL_stickers_createStickerSet", None)
        user_class = getattr(TLRPC, "TL_inputUserSelf", None)
        if request_class is None or user_class is None:
            raise RuntimeError("stickers.createStickerSet is unavailable")
        req = request_class()
        req.user_id = user_class()
        req.title = str(title)
        req.short_name = str(short_name)
        # A regular sticker set must not set custom-emoji or mask flags.
        try:
            req.emojis = False
        except Exception:
            pass
        try:
            req.masks = False
        except Exception:
            pass
        req.flags = 0
        req.stickers = ArrayList()
        req.stickers.add(items[0]["input_item"])
        return req

    def _copy_error_action(self, error_text):
        value = str(error_text or "").upper()
        if any(token in value for token in (
                "STICKER_ALREADY", "STICKER_EXIST", "STICKER_FILE_INVALID",
                "STICKER_EMOJI_INVALID", "STICKER_INVALID", "FILE_REFERENCE")):
            return "skip"
        return "stop"

    def _copy_sticker_pack(self, ui, entry):
        try:
            req = self._make_get_source_pack_request(entry)
        except Exception as e:
            self.log(f"[ChatStickers] prepare source pack: {e}")
            BulletinHelper.show_error("Не удалось определить исходный набор стикеров")
            return

        BulletinHelper.show_info("Загружаю исходный набор стикеров…")

        def on_response(response, error):
            def finish():
                if error is not None:
                    error_text = str(self._jfield(error, "text") or error)
                    BulletinHelper.show_error(f"Не удалось загрузить набор: {error_text}")
                    return
                try:
                    pack = self._parse_source_sticker_pack(response)
                except Exception as e:
                    self.log(f"[ChatStickers] parse source pack: {e}")
                    BulletinHelper.show_error("Не удалось подготовить стикеры из этого набора")
                    return
                self._show_copy_pack_options(ui, pack)
            run_on_ui_thread(finish)

        try:
            send_request(req, on_response)
        except Exception as e:
            self.log(f"[ChatStickers] get source pack: {e}")
            BulletinHelper.show_error("Не удалось запросить исходный набор стикеров")

    def _show_copy_pack_options(self, ui, pack):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle("Скопировать набор")
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(0, dp(8), 0, dp(8))
        dialog_ref = []

        def add_option(title_text, subtext, callback):
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.VERTICAL)
            row.setPadding(dp(22), dp(11), dp(22), dp(11))
            title = TextView(activity)
            title.setText(title_text)
            title.setTextSize(1, 16.0)
            title.setTypeface(Typeface.DEFAULT_BOLD)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            row.addView(title, LinearLayout.LayoutParams(-1, -2))
            sub = TextView(activity)
            sub.setText(subtext)
            sub.setTextSize(1, 13.0)
            sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            row.addView(sub, LinearLayout.LayoutParams(-1, -2))

            def choose():
                if dialog_ref:
                    try:
                        dialog_ref[0].dismiss()
                    except Exception:
                        pass
                callback()
            row.setOnClickListener(click_listener(choose))
            container.addView(row, LinearLayout.LayoutParams(-1, -2))

        add_option(
            "Создать новый набор",
            "Задать название и новую ссылку t.me/addstickers/…",
            lambda: self._show_create_pack_dialog(ui, pack),
        )
        add_option(
            "Добавить в существующий",
            "Перенести все стикеры в один из ваших наборов @stickers",
            lambda: self._copy_pack_to_existing(ui, pack),
        )
        builder.setView(container)
        builder.setNegativeButton("Отмена", None)
        dialog_ref.append(builder.show())

    def _make_suggest_short_name_request(self, title):
        request_class = getattr(TLRPC, "TL_stickers_suggestShortName", None)
        if request_class is None:
            raise RuntimeError("stickers.suggestShortName is unavailable")
        req = request_class()
        req.title = str(title)
        return req

    def _suggest_short_name_for_dialog(self, title, short_input, expected_value):
        try:
            req = self._make_suggest_short_name_request(title)
        except Exception:
            return

        def on_response(response, error):
            def apply_suggestion():
                if error is not None:
                    return
                suggestion = str(self._jfield(response, "short_name") or "").strip()
                if not suggestion:
                    return
                try:
                    current = str(short_input.getText() or "").strip()
                except Exception:
                    current = ""
                if current == str(expected_value or "").strip():
                    short_input.setText(suggestion[:64])
            run_on_ui_thread(apply_suggestion)

        try:
            send_request(req, on_response)
        except Exception:
            pass

    def _suggested_copy_short_name(self, pack):
        source = str(pack.get("short_name") or "sticker_pack")
        source = re.sub(r"[^A-Za-z0-9_]+", "_", source)
        source = re.sub(r"_+", "_", source).strip("_")
        if not source or not source[0].isalpha():
            source = "sticker_" + source
        suffix = str(int(time.time()))[-6:]
        room = max(1, 64 - len("_copy_") - len(suffix))
        return f"{source[:room]}_copy_{suffix}"[:64]

    def _validate_new_pack_identity(self, title, short_name):
        title = str(title or "").strip()
        short_name = str(short_name or "").strip()
        if not (1 <= len(title) <= 64):
            return "Название должно содержать от 1 до 64 символов"
        if not (1 <= len(short_name) <= 64):
            return "Ссылка должна содержать от 1 до 64 символов"
        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*", short_name):
            return "Ссылка: английские буквы, цифры и _, начинается с буквы"
        if "__" in short_name:
            return "В ссылке нельзя использовать два подчёркивания подряд"
        return ""

    def _style_create_pack_input(self, edit_text):
        text_color = Theme.getColor(Theme.key_dialogTextBlack)
        hint_color = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)
        accent_color = Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)

        try:
            edit_text.setTextColor(text_color)
        except Exception:
            pass
        try:
            edit_text.setHintTextColor(hint_color)
        except Exception:
            pass
        try:
            edit_text.setHighlightColor(accent_color)
        except Exception:
            pass

        # Android 10+ позволяет безопасно перекрасить курсор напрямую.
        # На старых версиях API вызовы отсутствуют и просто пропускаются.
        try:
            cursor = edit_text.getTextCursorDrawable()
            if cursor is not None:
                try:
                    cursor = cursor.mutate()
                except Exception:
                    pass
                try:
                    cursor.setTint(text_color)
                except Exception:
                    try:
                        Theme.setDrawableColor(cursor, text_color)
                    except Exception:
                        pass
                edit_text.setTextCursorDrawable(cursor)
        except Exception:
            pass

    def _show_create_pack_dialog(self, ui, pack):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle("Новый набор стикеров")
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(dp(22), dp(10), dp(22), dp(10))

        title_label = TextView(activity)
        title_label.setText("Название")
        title_label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        container.addView(title_label, LinearLayout.LayoutParams(-1, -2))
        title_input = EditText(activity)
        title_input.setSingleLine(True)
        self._style_create_pack_input(title_input)
        default_title = f"{pack.get('title') or 'Набор стикеров'} — копия"
        title_input.setText(default_title[:64])
        container.addView(title_input, LinearLayout.LayoutParams(-1, -2))

        short_label = TextView(activity)
        short_label.setText("Новая ссылка: t.me/addstickers/…")
        short_label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        short_label.setPadding(0, dp(10), 0, 0)
        container.addView(short_label, LinearLayout.LayoutParams(-1, -2))
        short_input = EditText(activity)
        short_input.setSingleLine(True)
        self._style_create_pack_input(short_input)
        local_short_name = self._suggested_copy_short_name(pack)
        short_input.setText(local_short_name)
        container.addView(short_input, LinearLayout.LayoutParams(-1, -2))

        create_button = TextView(activity)
        create_button.setText("Создать и скопировать")
        create_button.setTextSize(1, 16.0)
        create_button.setTypeface(Typeface.DEFAULT_BOLD)
        create_button.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
        create_button.setPadding(0, dp(18), 0, dp(8))
        container.addView(create_button, LinearLayout.LayoutParams(-1, -2))

        builder.setView(container)
        builder.setNegativeButton("Отмена", None)
        dialog = builder.show()
        self._suggest_short_name_for_dialog(
            str(title_input.getText() or default_title), short_input, local_short_name
        )

        def create():
            title = str(title_input.getText() or "").strip()
            short_name = str(short_input.getText() or "").strip()
            error = self._validate_new_pack_identity(title, short_name)
            if error:
                BulletinHelper.show_error(error)
                return
            try:
                dialog.dismiss()
            except Exception:
                pass
            self._check_short_name_and_create(ui, pack, title, short_name)

        create_button.setOnClickListener(click_listener(create))

    def _check_short_name_and_create(self, ui, pack, title, short_name):
        # createStickerSet сам проверяет корректность и доступность short_name.
        # В некоторых сборках AyuGram/ExteraGram callback checkShortName не
        # возвращается, из-за чего создание набора зависает без результата.
        try:
            self._create_copied_pack(ui, pack, title, short_name)
        except Exception as e:
            self.log(f"[ChatStickers] start create copied pack: {e}")
            BulletinHelper.show_error("Не удалось запустить создание набора стикеров")

    def _show_copy_status_dialog(self, ui, title, message, cancelable=True):
        activity = ui.get("activity") if isinstance(ui, dict) else None
        if activity is None:
            return None
        try:
            builder = AlertDialog.Builder(activity)
            builder.setTitle(str(title))
            builder.setMessage(str(message))
            if cancelable:
                builder.setPositiveButton("Закрыть", None)
            else:
                try:
                    builder.setCancelable(False)
                except Exception:
                    pass
            return builder.show()
        except Exception:
            return None

    def _dismiss_dialog_safely(self, dialog):
        if dialog is None:
            return
        try:
            dialog.dismiss()
        except Exception:
            pass

    def _create_copied_pack(self, ui, pack, title, short_name):
        try:
            req = self._make_create_copied_pack_request(pack, title, short_name)
        except Exception as e:
            self.log(f"[ChatStickers] prepare create pack: {e}")
            self._show_copy_status_dialog(
                ui, "Не удалось создать набор",
                f"Не удалось подготовить запрос: {e}",
            )
            return

        progress_dialog = self._show_copy_status_dialog(
            ui, "Создание набора стикеров",
            "Отправляю запрос в Telegram…",
            cancelable=False,
        )
        token = f"create:{time.time_ns()}"
        finished = [False]

        def finish_once():
            if finished[0]:
                return False
            finished[0] = True
            pending = getattr(self, "_pending_create_callbacks", None)
            if pending is not None:
                pending.pop(token, None)
            self._dismiss_dialog_safely(progress_dialog)
            return True

        def on_response(response, error):
            def finish():
                if not finish_once():
                    return
                if error is not None:
                    error_text = str(self._jfield(error, "text") or error)
                    if "SHORT_NAME_OCCUPIED" in error_text or "PACK_SHORT_NAME_OCCUPIED" in error_text:
                        user_text = "Эта ссылка уже занята. Укажи другое короткое имя."
                    elif "SHORT_NAME_INVALID" in error_text or "PACK_SHORT_NAME_INVALID" in error_text:
                        user_text = "Некорректная ссылка набора. Используй английские буквы, цифры и _."
                    elif "USER_ID_INVALID" in error_text or "PEER_ID_INVALID" in error_text:
                        user_text = "Telegram не принял владельца набора. Код: " + error_text
                    elif "STICKER_FILE_INVALID" in error_text or "STICKER_INVALID" in error_text:
                        user_text = "Telegram не разрешил использовать исходный стикер при создании. Код: " + error_text
                    else:
                        user_text = "Ошибка Telegram: " + error_text
                    self._show_copy_status_dialog(ui, "Не удалось создать набор", user_text)
                    return

                try:
                    source_set = self._jfield(response, "set")
                    target = {
                        "id": _to_int64(self._jfield(source_set, "id"), 0),
                        "access_hash": _to_int64(self._jfield(source_set, "access_hash"), 0),
                        "title": title,
                        "short_name": short_name,
                    }
                    if not target["id"]:
                        self._show_copy_status_dialog(
                            ui, "Набор создан не полностью",
                            "Telegram ответил без ID нового набора.",
                        )
                        return
                    target["count"] = 1
                    self._remember_recent_owned_set(target)
                    self._copy_items_sequentially(
                        ui, pack, target, start_index=1, copied=1, skipped=0,
                        created_short_name=short_name,
                    )
                except Exception as e:
                    self.log(f"[ChatStickers] process create pack response: {e}")
                    self._show_copy_status_dialog(
                        ui, "Ошибка обработки ответа", str(e),
                    )
            run_on_ui_thread(finish)

        # Держим Python callback сильной ссылкой до ответа или тайм-аута.
        pending = getattr(self, "_pending_create_callbacks", None)
        if pending is None:
            pending = {}
            self._pending_create_callbacks = pending
        pending[token] = on_response

        try:
            request_id = send_request(req, on_response)
            self.log(f"[ChatStickers] createStickerSet request id={request_id}")
        except Exception as e:
            finish_once()
            self.log(f"[ChatStickers] create pack send: {e}")
            self._show_copy_status_dialog(
                ui, "Не удалось создать набор",
                f"Запрос не был отправлен: {e}",
            )
            return

        plugin = self
        class _CreateTimeout(dynamic_proxy(Runnable)):
            def run(s):
                if not finish_once():
                    return
                plugin._show_copy_status_dialog(
                    ui, "Telegram не ответил",
                    "За 20 секунд не получен ответ на создание набора. "
                    "Попробуй другое имя ссылки или повтори позже.",
                )
        try:
            AndroidUtilities.runOnUIThread(_CreateTimeout(), 20000)
        except Exception:
            pass

    def _load_owned_sticker_sets_for_copy(self, callback):
        request_class = getattr(TLRPC, "TL_messages_getMyStickers", None)
        if request_class is None:
            BulletinHelper.show_error("Эта версия клиента не поддерживает собственные наборы")
            return
        owned = []
        seen = set()

        def request_page(offset_id):
            try:
                req = request_class()
                req.offset_id = int(offset_id)
                req.limit = 100

                def on_response(response, error):
                    run_on_ui_thread(lambda: process_page(offset_id, response, error))
                send_request(req, on_response)
            except Exception as e:
                self.log(f"[ChatStickers] copy getMyStickers: {e}")
                BulletinHelper.show_error("Не удалось загрузить ваши наборы стикеров")

        def process_page(offset_id, response, error):
            if error is not None:
                error_text = str(self._jfield(error, "text") or error)
                BulletinHelper.show_error(f"Не удалось загрузить наборы: {error_text}")
                return
            covered_sets = _java_values(self._jfield(response, "sets"))
            last_id = 0
            for covered in covered_sets:
                raw_set = self._jfield(covered, "set") or covered
                raw_id = _to_int64(self._jfield(raw_set, "id"), 0)
                if raw_id:
                    last_id = raw_id
                info = self._owned_sticker_set_info(covered)
                if info is not None and info["id"] not in seen:
                    seen.add(info["id"])
                    owned.append(info)
            if _should_request_next_owned_page(len(covered_sets), last_id, offset_id):
                request_page(last_id)
                return
            merged_owned = self._merge_recent_owned_sets(owned)
            callback(merged_owned)

        request_page(0)

    def _copy_pack_to_existing(self, ui, pack):
        BulletinHelper.show_info("Загружаю ваши наборы стикеров…")
        self._load_owned_sticker_sets_for_copy(
            lambda owned: self._show_copy_target_sets(ui, pack, owned)
        )

    def _show_copy_target_sets(self, ui, pack, owned):
        activity = ui["activity"]
        source_id = int(pack.get("id") or 0)
        owned = [target for target in owned if int(target.get("id") or 0) != source_id]
        builder = AlertDialog.Builder(activity)
        if not owned:
            builder.setTitle("Нет подходящих наборов стикеров")
            builder.setMessage("Создай новый набор или добавь набор через @stickers.")
            builder.setNegativeButton("Закрыть", None)
            builder.show()
            return

        builder.setTitle("Копировать в набор")
        scroll = ScrollView(activity)
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(0, dp(6), 0, dp(6))
        dialog_ref = []
        for target in owned:
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.VERTICAL)
            row.setPadding(dp(22), dp(10), dp(22), dp(10))
            title = TextView(activity)
            title.setText(target["title"])
            title.setTextSize(1, 16.0)
            title.setTypeface(Typeface.DEFAULT_BOLD)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            row.addView(title, LinearLayout.LayoutParams(-1, -2))
            sub = TextView(activity)
            sub.setText(f"{target['count']} стикеров" if target.get("count") else "Собственный набор стикеров")
            sub.setTextSize(1, 13.0)
            sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            row.addView(sub, LinearLayout.LayoutParams(-1, -2))

            def choose(chosen=target):
                if dialog_ref:
                    try:
                        dialog_ref[0].dismiss()
                    except Exception:
                        pass
                self._copy_items_sequentially(ui, pack, chosen)
            row.setOnClickListener(click_listener(choose))
            container.addView(row, LinearLayout.LayoutParams(-1, -2))
        scroll.addView(container)
        builder.setView(scroll)
        builder.setNegativeButton("Отмена", None)
        dialog_ref.append(builder.show())

    def _target_input_set(self, target):
        if target.get("id"):
            result = TLRPC.TL_inputStickerSetID()
            result.id = int(target["id"])
            result.access_hash = int(target.get("access_hash") or 0)
            return result
        short_class = getattr(TLRPC, "TL_inputStickerSetShortName", None)
        if short_class is not None and target.get("short_name"):
            result = short_class()
            result.short_name = str(target["short_name"])
            return result
        raise ValueError("target sticker set is incomplete")

    def _make_add_pack_item_request(self, item, target):
        req = TLRPC.TL_stickers_addStickerToSet()
        req.stickerset = self._target_input_set(target)
        req.sticker = item["input_item"]
        return req

    def _copy_items_sequentially(self, ui, pack, target, start_index=0,
                                 copied=0, skipped=0, created_short_name=""):
        items = list(pack.get("items") or [])
        total = len(items)
        if not total:
            BulletinHelper.show_error("В исходном наборе нет стикеров")
            return
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle("Копирование стикеров")
        progress_text = TextView(activity)
        progress_text.setTextSize(1, 15.0)
        progress_text.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        progress_text.setPadding(dp(22), dp(16), dp(22), dp(16))
        builder.setView(progress_text)
        progress_dialog = builder.show()

        def update(index_value, copied_value, skipped_value):
            progress_text.setText(
                f"Копирование: {min(index_value, total)} из {total}\n"
                f"Добавлено: {copied_value}   Пропущено: {skipped_value}"
            )

        def finish(copied_value, skipped_value, error_text=""):
            try:
                progress_dialog.dismiss()
            except Exception:
                pass
            if error_text:
                BulletinHelper.show_error(
                    f"Копирование остановлено: {copied_value} добавлено, "
                    f"{skipped_value} пропущено. {error_text}"
                )
                return
            if created_short_name:
                self._show_created_pack_result(
                    ui, target.get("title") or pack.get("title"), created_short_name,
                    copied_value, skipped_value,
                )
            else:
                BulletinHelper.show_success(
                    f"Скопировано в «{target.get('title') or 'набор стикеров'}»: "
                    f"{copied_value} из {total}"
                )

        def step(index_value, copied_value, skipped_value):
            update(index_value, copied_value, skipped_value)
            if index_value >= total:
                finish(copied_value, skipped_value)
                return
            try:
                req = self._make_add_pack_item_request(items[index_value], target)
            except Exception as e:
                self.log(f"[ChatStickers] prepare copied item: {e}")
                step(index_value + 1, copied_value, skipped_value + 1)
                return

            def on_response(response, error):
                def continue_on_ui():
                    if error is None:
                        step(index_value + 1, copied_value + 1, skipped_value)
                        return
                    error_text = str(self._jfield(error, "text") or error)
                    if self._copy_error_action(error_text) == "skip":
                        step(index_value + 1, copied_value, skipped_value + 1)
                        return
                    finish(copied_value, skipped_value, error_text)
                run_on_ui_thread(continue_on_ui)

            try:
                send_request(req, on_response)
            except Exception as e:
                self.log(f"[ChatStickers] copy item request: {e}")
                finish(copied_value, skipped_value, "Ошибка отправки запроса")

        step(int(start_index), int(copied), int(skipped))

    def _show_created_pack_result(self, ui, title, short_name, copied, skipped):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        builder.setTitle("Набор стикеров создан")
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(dp(22), dp(12), dp(22), dp(12))
        message = TextView(activity)
        message.setText(
            f"{title}\n\nДобавлено: {copied}   Пропущено: {skipped}\n\n"
            f"https://t.me/addstickers/{short_name}"
        )
        message.setTextSize(1, 15.0)
        message.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        container.addView(message, LinearLayout.LayoutParams(-1, -2))
        builder.setView(container)
        builder.setPositiveButton("Готово", None)
        builder.show()

    def _owned_sticker_set_info(self, covered):
        sticker_set = self._jfield(covered, "set")
        if sticker_set is None:
            sticker_set = covered
        if bool(self._jfield(sticker_set, "emojis")):
            return None
        if bool(self._jfield(sticker_set, "masks")):
            return None
        set_id = _to_int64(self._jfield(sticker_set, "id"), 0)
        access_hash = _to_int64(self._jfield(sticker_set, "access_hash"), 0)
        if not set_id:
            return None
        return {
            "id": set_id,
            "access_hash": access_hash,
            "title": str(self._jfield(sticker_set, "title") or "Мой набор стикеров"),
            "short_name": str(self._jfield(sticker_set, "short_name") or ""),
            "count": _to_int64(self._jfield(sticker_set, "count"), 0),
        }

    def _add_sticker_to_my_set(self, ui, entry):
        if entry.get("doc") is None:
            BulletinHelper.show_error("Документ стикера ещё не загружен")
            return
        request_class = getattr(TLRPC, "TL_messages_getMyStickers", None)
        if request_class is None:
            BulletinHelper.show_error("Эта версия клиента не поддерживает список собственных наборов")
            return

        BulletinHelper.show_info("Загружаю ваши наборы стикеров…")
        owned = []
        seen = set()

        def request_page(offset_id):
            try:
                req = request_class()
                req.offset_id = int(offset_id)
                req.limit = 100

                def on_response(response, error):
                    run_on_ui_thread(lambda: process_page(offset_id, response, error))

                send_request(req, on_response)
            except Exception as e:
                self.log(f"[ChatStickers] getMyStickers request: {e}")
                BulletinHelper.show_error("Не удалось загрузить ваши наборы стикеров")

        def process_page(offset_id, response, error):
            if error is not None:
                error_text = str(self._jfield(error, "text") or error)
                BulletinHelper.show_error(f"Не удалось загрузить наборы: {error_text}")
                return
            covered_sets = _java_values(self._jfield(response, "sets"))
            last_id = 0
            for covered in covered_sets:
                raw_set = self._jfield(covered, "set") or covered
                raw_id = _to_int64(self._jfield(raw_set, "id"), 0)
                if raw_id:
                    last_id = raw_id
                info = self._owned_sticker_set_info(covered)
                if info is not None and info["id"] not in seen:
                    seen.add(info["id"])
                    owned.append(info)
            if _should_request_next_owned_page(len(covered_sets), last_id, offset_id):
                request_page(last_id)
                return
            merged_owned = self._merge_recent_owned_sets(owned)
            self._show_owned_sticker_sets(ui, entry, merged_owned)

        request_page(0)

    def _show_owned_sticker_sets(self, ui, entry, owned):
        activity = ui["activity"]
        builder = AlertDialog.Builder(activity)
        if not owned:
            builder.setTitle("Нет собственных наборов стикеров")
            container = LinearLayout(activity)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setPadding(dp(22), dp(12), dp(22), dp(12))
            message = TextView(activity)
            message.setText("Создай набор через @stickers, затем повтори добавление.")
            message.setTextSize(1, 15.0)
            message.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            container.addView(message, LinearLayout.LayoutParams(-1, -2))
            button = TextView(activity)
            button.setText("Открыть @stickers")
            button.setTextSize(1, 16.0)
            button.setTypeface(Typeface.DEFAULT_BOLD)
            button.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            button.setPadding(0, dp(18), 0, dp(8))
            button.setOnClickListener(click_listener(self._open_stickers_bot))
            container.addView(button, LinearLayout.LayoutParams(-1, -2))
            builder.setView(container)
            builder.setNegativeButton("Закрыть", None)
            builder.show()
            return

        builder.setTitle("Добавить стикер в набор")
        scroll = ScrollView(activity)
        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(0, dp(6), 0, dp(6))
        dialog_ref = []

        for target in owned:
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.VERTICAL)
            row.setPadding(dp(22), dp(10), dp(22), dp(10))
            title = TextView(activity)
            title.setText(target["title"])
            title.setTextSize(1, 16.0)
            title.setTypeface(Typeface.DEFAULT_BOLD)
            title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            row.addView(title, LinearLayout.LayoutParams(-1, -2))
            sub = TextView(activity)
            count_text = f"{target['count']} стикеров" if target["count"] else "Собственный набор стикеров"
            sub.setText(count_text)
            sub.setTextSize(1, 13.0)
            sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            row.addView(sub, LinearLayout.LayoutParams(-1, -2))

            def select_target(chosen=target):
                if dialog_ref:
                    try:
                        dialog_ref[0].dismiss()
                    except Exception:
                        pass
                self._send_add_sticker_to_set(entry, chosen)

            row.setOnClickListener(click_listener(select_target))
            container.addView(row, LinearLayout.LayoutParams(-1, -2))

        scroll.addView(container)
        builder.setView(scroll)
        builder.setNegativeButton("Отмена", None)
        dialog_ref.append(builder.show())

    def _make_add_sticker_request(self, entry, target):
        document = entry.get("doc")
        if document is None:
            raise ValueError("sticker document is missing")

        input_document = TLRPC.TL_inputDocument()
        input_document.id = _to_int64(self._jfield(document, "id"), 0)
        input_document.access_hash = _to_int64(self._jfield(document, "access_hash"), 0)
        input_document.file_reference = self._jfield(document, "file_reference")
        if not input_document.id or not input_document.access_hash or input_document.file_reference is None:
            raise ValueError("sticker input document is incomplete")

        item = TLRPC.TL_inputStickerSetItem()
        item.document = input_document
        item.emoji = str(entry.get("emoji") or "🙂")

        target_set = TLRPC.TL_inputStickerSetID()
        target_set.id = int(target["id"])
        target_set.access_hash = int(target["access_hash"])

        req = TLRPC.TL_stickers_addStickerToSet()
        req.stickerset = target_set
        req.sticker = item
        return req

    def _send_add_sticker_to_set(self, entry, target):
        try:
            req = self._make_add_sticker_request(entry, target)

            def on_response(response, error):
                def finish():
                    if error is not None:
                        error_text = str(self._jfield(error, "text") or error)
                        if "STICKERPACK_STICKERS_TOO_MUCH" in error_text or "STICKERS_TOO_MUCH" in error_text:
                            BulletinHelper.show_error("В выбранном наборе больше нет места")
                        elif "STICKERSET_INVALID" in error_text:
                            BulletinHelper.show_error("Набор недоступен для изменения")
                        elif "FILE_REFERENCE" in error_text:
                            BulletinHelper.show_error("Ссылка на стикер устарела — открой поиск заново")
                        elif "STICKER" in error_text and "EXIST" in error_text:
                            BulletinHelper.show_info("Этот стикер уже есть в наборе")
                        else:
                            BulletinHelper.show_error(f"Не удалось добавить стикер: {error_text}")
                        return
                    BulletinHelper.show_success(f"Стикер добавлен в «{target['title']}»")
                run_on_ui_thread(finish)

            send_request(req, on_response)
        except Exception as e:
            self.log(f"[ChatStickers] add sticker to set: {e}")
            BulletinHelper.show_error("Не удалось подготовить стикер для добавления")

    def _open_stickers_bot(self):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                BulletinHelper.show_error("Не удалось открыть @stickers")
                return
            get_messages_controller().openByUserName("stickers", fragment, 1)
        except Exception as e:
            self.log(f"[ChatStickers] open @stickers: {e}")
            BulletinHelper.show_error("Не удалось открыть @stickers")

    def _jump_to_message(self, ui, entry):
        try:
            ui["sheet"].dismiss()
        except Exception:
            pass
        try:
            dialog_id = ui["dialog_id"]
            args = Bundle()
            if dialog_id > 0:
                args.putLong("user_id", dialog_id)
            else:
                args.putLong("chat_id", -dialog_id)
            args.putInt("message_id", entry["msg_id"])
            fragment = get_last_fragment()
            if fragment is not None:
                fragment.presentFragment(ChatActivity(args))
        except Exception as e:
            self.log(f"[ChatStickers] jump: {e}")

    def _cycle_default_sort(self, view):
        current = str(self.get_setting("default_sort", "date"))
        if current not in SORT_MODES:
            current = "date"
        new = SORT_MODES[(SORT_MODES.index(current) + 1) % len(SORT_MODES)]
        self.set_setting("default_sort", new, reload_settings=True)
        BulletinHelper.show_info(f"Сортировка по умолчанию: {SORT_TITLES[new]}")

    def create_settings(self):
        current_sort = str(self.get_setting("default_sort", "date"))
        if current_sort not in SORT_MODES:
            current_sort = "date"
        return [
            Header(text="Chat Stickers"),
            Switch(key="default_grid", text="Сетка по умолчанию",
                   subtext="Открывать стикеры в виде сетки; иначе — списком с автором и датой",
                   default=False),
            Switch(key="pack_numbering", text="Нумерация наборов",
                   subtext="Показывать метки Н1, Н2, Н3 у стикеров из одного набора",
                   default=True),
            Text(text=f"Сортировка по умолчанию: {SORT_TITLES[current_sort]}",
                 on_click=self._cycle_default_sort),
            Switch(key="animations", text="Анимации", default=True),
            Divider(),
            Input(key="scan_depth", text="Глубина автосканирования",
                  default=str(DEFAULT_SCAN_DEPTH),
                  subtext="Сколько сообщений листать за одно открытие экрана. Дальше — кнопкой «Сканировать дальше»"),
            Custom(factory=USAGE_SETTING_FACTORY.instance.java),
        ]

class ChatEmojiStickersPlugin(BasePlugin):
    def on_plugin_load(self):
        self._history_cache_lock = threading.Lock()
        self._history_session_key = None
        self._history_page_cache = {}
        self._history_page_order = []
        self._history_page_waiters = {}
        self._emoji_feature = ChatEmojisFeature(self)
        self._sticker_feature = ChatStickersFeature(self)
        self._emoji_feature.on_plugin_load()
        self._sticker_feature.on_plugin_load()

    def _activate_history_session(self, dialog_id, chat_token):
        key = (int(dialog_id), str(chat_token))
        with self._history_cache_lock:
            if key == self._history_session_key:
                return
            self._history_session_key = key
            self._history_page_cache.clear()
            self._history_page_order.clear()
            # Old callbacks are session-guarded by each feature generation.
            self._history_page_waiters.clear()


    def _request_history_page_shared(self, dialog_id, offset_id, callback):
        key = (int(dialog_id), int(offset_id))
        cached_payload = _UNCACHED
        joined_inflight = False
        with self._history_cache_lock:
            cached_payload = self._history_page_cache.get(key, _UNCACHED)
            if cached_payload is _UNCACHED:
                waiters = self._history_page_waiters.get(key)
                if waiters is not None:
                    waiters.append(callback)
                    joined_inflight = True
                else:
                    self._history_page_waiters[key] = [callback]

        if cached_payload is not _UNCACHED:
            response, error = cached_payload
            run_on_ui_thread(lambda: callback(response, error))
            return
        if joined_inflight:
            return

        try:
            req = TLRPC.TL_messages_getHistory()
            req.peer = get_messages_controller().getInputPeer(int(dialog_id))
            req.offset_id = int(offset_id)
            req.offset_date = 0
            req.add_offset = 0
            req.limit = PAGE_SIZE
            req.max_id = 0
            req.min_id = 0
            req.hash = 0

            def on_response(response, error):
                with self._history_cache_lock:
                    callbacks = self._history_page_waiters.pop(key, [])
                    if error is None:
                        self._history_page_cache[key] = (response, error)
                        self._history_page_order.append(key)
                        while len(self._history_page_order) > HISTORY_CACHE_PAGE_LIMIT:
                            oldest = self._history_page_order.pop(0)
                            self._history_page_cache.pop(oldest, None)
                for pending in callbacks:
                    run_on_ui_thread(
                        lambda pending=pending: pending(response, error)
                    )

            send_request(req, on_response)
        except Exception as exc:
            with self._history_cache_lock:
                callbacks = self._history_page_waiters.pop(key, [])
            for pending in callbacks:
                run_on_ui_thread(
                    lambda pending=pending, exc=exc: pending(None, exc)
                )

    def on_plugin_unload(self):
        with getattr(self, "_history_cache_lock", threading.Lock()):
            getattr(self, "_history_page_cache", {}).clear()
            getattr(self, "_history_page_order", []).clear()
            getattr(self, "_history_page_waiters", {}).clear()
        emoji_feature = getattr(self, "_emoji_feature", None)
        sticker_feature = getattr(self, "_sticker_feature", None)
        if emoji_feature is not None:
            try:
                emoji_feature.on_plugin_unload()
            except Exception as e:
                self.log(f"[ChatEmojiStickers] unload Emoji: {e}")
        if sticker_feature is not None:
            try:
                sticker_feature.on_plugin_unload()
            except Exception as e:
                self.log(f"[ChatEmojiStickers] unload stickers: {e}")

    def _cycle_default_sort(self, view):
        current = str(self.get_setting("default_sort", "date"))
        if current not in SORT_MODES:
            current = "date"
        new = SORT_MODES[(SORT_MODES.index(current) + 1) % len(SORT_MODES)]
        self.set_setting("default_sort", new, reload_settings=True)
        BulletinHelper.show_info(f"Сортировка по умолчанию: {SORT_TITLES[new]}")

    def create_settings(self):
        current_sort = str(self.get_setting("default_sort", "date"))
        if current_sort not in SORT_MODES:
            current_sort = "date"
        return [
            Header(text="Chat Emoji & Stickers"),
            Switch(
                key="default_grid",
                text="Сетка по умолчанию",
                subtext="Открывать Emoji и стикеры в виде сетки; иначе — списком с автором и датой",
                default=False,
            ),
            Switch(
                key="pack_numbering",
                text="Нумерация наборов",
                subtext="Показывать метки Н1, Н2, Н3 у Emoji и стикеров из одного набора",
                default=True,
            ),
            Text(
                text=f"Сортировка по умолчанию: {SORT_TITLES[current_sort]}",
                on_click=self._cycle_default_sort,
            ),
            Switch(key="animations", text="Анимации", default=True),
            Divider(),
            Input(
                key="scan_depth",
                text="Глубина автосканирования",
                default=str(DEFAULT_SCAN_DEPTH),
                subtext="Сколько сообщений листать при открытии экрана. Дальше — кнопкой «Сканировать дальше»",
            ),
            Custom(factory=USAGE_SETTING_FACTORY.instance.java),
        ]
