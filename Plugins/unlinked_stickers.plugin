from typing import Any, Dict, Optional
import time

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from ui.bulletin import BulletinHelper
from java import jclass

from org.telegram.messenger import FileLoader, MessageObject, UserConfig
from org.telegram.tgnet import TLRPC
from org.telegram.ui.ActionBar import ActionBarMenuItem
from android_utils import OnClickListener
from client_utils import get_last_fragment


__id__ = "unlinked_stickers"
__name__ = "Unlinked Stickers"
__description__ = "Send stickers from any pack as your own uploaded documents, detached from the original sticker set. \n\nIdea's author: @mishabotov"
__author__ = "@itNotMax - @MaxExteraPlugins"
__version__ = "1.1"
__icon__ = "MaxExteraPluginsStickers/26"
__min_version__ = "12.1.1"
__app_version__ = ">=12.1.1"

SendMessagesHelper = jclass("org.telegram.messenger.SendMessagesHelper")
SendMessageParams = jclass("org.telegram.messenger.SendMessagesHelper$SendMessageParams")
R_drawable = jclass("org.telegram.messenger.R$drawable")

_PRIORITY_HIGH = 3
_bypass_ids = set()

_TGS_MAX_SIZE = 65536


def _compress_tgs(path):
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
        if raw[:2] == b"\x1f\x8b":
            return None
        import gzip
        comp = gzip.compress(raw, compresslevel=9)
        if len(comp) >= len(raw) or len(comp) > _TGS_MAX_SIZE:
            return None
        with open(path, "wb") as fh:
            fh.write(comp)
        return len(comp)
    except Exception:
        return None


def _ensure_sticker_mime_and_name(document, local_file):
    mime = str(getattr(document, "mime_type", "") or "")
    if mime == "application/x-tgsticker" or str(local_file.getName()).lower().endswith(".tgs"):
        document.mime_type = "application/x-tgsticker"
        try:
            attrs = document.attributes
            if attrs is not None:
                for i in range(attrs.size()):
                    attr = attrs.get(i)
                    if isinstance(attr, TLRPC.TL_documentAttributeFilename):
                        attr.file_name = "sticker.tgs"
                        break
        except Exception:
            pass
    elif mime == "video/webm" or str(local_file.getName()).lower().endswith(".webm"):
        document.mime_type = "video/webm"
        try:
            attrs = document.attributes
            if attrs is not None:
                for i in range(attrs.size()):
                    attr = attrs.get(i)
                    if isinstance(attr, TLRPC.TL_documentAttributeFilename):
                        attr.file_name = "sticker.webm"
                        break
        except Exception:
            pass


class _StickerSendHook:
    def __init__(self, plugin: "UnlinkedStickersPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param: Any) -> None:
        try:
            if not self.plugin.enabled:
                return
            if not param.args or len(param.args) == 0:
                return

            send_params = param.args[0]
            if send_params is None or not hasattr(send_params, "document"):
                return

            result = self.plugin._prepare_anonymous_sticker(send_params, param.thisObject)
            if result == "cancel":
                param.setResult(None)
        except Exception as e:
            try:
                self.plugin.log(f"[UnlinkedStickers] send hook error: {e}")
            except Exception:
                pass


class _StickerRecentHook:
    def __init__(self, plugin: "UnlinkedStickersPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param: Any) -> None:
        try:
            if not self.plugin.enabled:
                return
            if not param.args or len(param.args) < 5:
                return

            type_val = int(param.args[0])
            if type_val != 0:
                return

            remove = bool(param.args[4])
            if remove:
                return

            document = param.args[2]
            if document is None:
                return

            attr = self.plugin._get_sticker_attribute(document)
            if attr is None:
                return

            sticker_set = getattr(attr, "stickerset", None)
            if sticker_set is None or isinstance(sticker_set, TLRPC.TL_inputStickerSetEmpty):
                parentObject = param.args[1]
                parent_class_name = parentObject.getClass().getSimpleName() if parentObject else ""
                if "message" in parent_class_name.lower():
                    param.setResult(None)
        except Exception as e:
            try:
                self.plugin.log(f"[UnlinkedStickers] recent hook error: {e}")
            except Exception:
                pass


class PreviewSheetHook(MethodHook):

    def __init__(self, plugin):
        self._plugin = plugin

    def after_hooked_method(self, param):
        try:
            viewer = get_private_field(param.thisObject, "this$0")
        except Exception as e:
            self._plugin.log("PREVIEW: viewer resolve FAILED: " + repr(e))
            return
        if viewer is None:
            return
        try:
            popup_window = get_private_field(viewer, "popupWindow")
            preview_menu = None
            if popup_window is not None:
                preview_menu = popup_window.getContentView()
            else:
                preview_menu = get_private_field(viewer, "popupLayout")
            document = get_private_field(viewer, "currentDocument")
        except Exception as e:
            self._plugin.log("PREVIEW: menu resolve FAILED: " + repr(e))
            return
        if preview_menu is None or document is None:
            return
        try:
            mime = str(getattr(document, "mime_type", "") or "").lower()
            if mime.endswith("webp") or mime.endswith("webm") or \
                    mime.endswith("tgsticker"):
                try:
                    acc = UserConfig.selectedAccount
                    fl = FileLoader.getInstance(acc)
                    cp = fl.getPathToAttach(document, False)
                    if cp is not None and not cp.exists():
                        fl.loadFile(document, None, _PRIORITY_HIGH, 0)
                except Exception:
                    pass
        except Exception:
            pass
        try:
            self._plugin._add_send_pack_button(preview_menu, viewer, document)
        except Exception as e:
            self._plugin.log("PREVIEW: button add FAILED: " + repr(e))


class UnlinkedStickersPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hook_refs = []
        self._download_request_times = {}
        self._notify_times = {}

    def on_plugin_load(self):
        self._hook_send_message()
        self._hook_add_recent_sticker()
        self._register_preview_menu_hook()
        self.log("Unlinked Stickers loaded")

    def on_plugin_unload(self):
        for ref in list(self._hook_refs):
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self._hook_refs.clear()
        self._download_request_times.clear()
        self._notify_times.clear()
        try:
            _bypass_ids.clear()
        except Exception:
            pass
        self.log("Unlinked Stickers unloaded")

    def _hook_send_message(self) -> None:
        try:
            send_helper_cls = find_class("org.telegram.messenger.SendMessagesHelper")
            if send_helper_cls is None:
                self.log("[UnlinkedStickers] SendMessagesHelper class not found")
                return

            try:
                methods = list(send_helper_cls.getClass().getDeclaredMethods())
            except Exception:
                methods = []

            hooked = 0
            for method in methods:
                try:
                    if method is None:
                        continue
                    if method.getName() != "sendMessage":
                        continue
                    method.setAccessible(True)
                    ref = self.hook_method(method, _StickerSendHook(self))
                    if ref is not None:
                        self._hook_refs.append(ref)
                        hooked += 1
                except Exception:
                    pass

            self.log(f"[UnlinkedStickers] Hooked sendMessage overloads: {hooked}")
        except Exception as e:
            self.log(f"[UnlinkedStickers] hook setup error: {e}")

    def _hook_add_recent_sticker(self) -> None:
        try:
            media_data_ctrl_cls = find_class("org.telegram.messenger.MediaDataController")
            if media_data_ctrl_cls is None:
                self.log("[UnlinkedStickers] MediaDataController class not found")
                return

            try:
                methods = list(media_data_ctrl_cls.getClass().getDeclaredMethods())
            except Exception:
                methods = []

            for method in methods:
                try:
                    if method is None:
                        continue
                    if method.getName() != "addRecentSticker":
                        continue
                    method.setAccessible(True)
                    ref = self.hook_method(method, _StickerRecentHook(self))
                    if ref is not None:
                        self._hook_refs.append(ref)
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[UnlinkedStickers] recent hook setup error: {e}")

    def _register_preview_menu_hook(self):
        try:
            runnable = find_class("org.telegram.ui.ContentPreviewViewer$1")
            if runnable is None:
                self.log("preview menu hook FAILED: class not found")
                return
            method = runnable.getClass().getDeclaredMethod("run")
            self.hook_method(method, PreviewSheetHook(self))
        except Exception as e:
            self.log("preview menu hook registration FAILED: " + repr(e))

    def _add_send_pack_button(self, preview_menu, viewer, document):
        try:
            mime = str(getattr(document, "mime_type", "") or "").lower()
            if not (mime.endswith("webp") or mime.endswith("webm") or
                    mime.endswith("tgsticker")):
                return
            resources_provider = None
            try:
                resources_provider = get_private_field(viewer, "resourcesProvider")
            except Exception:
                pass
            icon = 0
            try:
                ctxt = preview_menu.getContext()
                icon = ctxt.getResources().getIdentifier(
                    "msg_send", "drawable", ctxt.getPackageName())
            except Exception:
                pass
            if icon == 0:
                try:
                    icon = R_drawable.msg_send
                except Exception:
                    icon = 0
            item = ActionBarMenuItem.addItem(
                preview_menu, icon, "Отправить со стикерпаком",
                False, resources_provider)
            item.setOnClickListener(OnClickListener(
                lambda *_: self._send_with_pack(viewer, document)))
        except Exception as e:
            self.log("PREVIEW: button add FAILED: " + repr(e))

    def _send_with_pack(self, viewer, document):
        try:
            dialog_id = None
            try:
                parent = get_private_field(viewer, "parentFragment")
                if parent is not None:
                    dialog_id = parent.getDialogId()
            except Exception:
                dialog_id = None
            if dialog_id is None:
                try:
                    last = get_last_fragment()
                    if last is not None:
                        dialog_id = last.getDialogId()
                except Exception:
                    dialog_id = None
            if dialog_id is None or dialog_id == 0:
                self.log("send_with_pack: no dialog context")
                return
            account = UserConfig.selectedAccount
            _bypass_ids.add(document.id)
            params = SendMessageParams.of(None, dialog_id)
            try:
                fld = params.getClass().getField("notify")
                fld.setBoolean(params, True)
            except Exception:
                try:
                    fld = params.getClass().getDeclaredField("notify")
                    fld.setAccessible(True)
                    fld.setBoolean(params, True)
                except Exception:
                    pass
            params.document = document
            SendMessagesHelper.getInstance(account).sendMessage(params)
        except Exception as e:
            self.log("send_with_pack FAILED: " + repr(e))
        finally:
            try:
                method = viewer.getClass().getDeclaredMethod("dismissPopupWindow")
                method.setAccessible(True)
                method.invoke(viewer)
            except Exception:
                pass

    def _prepare_anonymous_sticker(self, send_params: Any, send_helper: Any) -> Optional[str]:
        document = getattr(send_params, "document", None)
        if document is None:
            return None

        doc_id = int(getattr(document, "id", 0) or 0)
        if doc_id in _bypass_ids:
            try:
                _bypass_ids.discard(doc_id)
            except Exception:
                pass
            return None

        sticker_attr = self._get_sticker_attribute(document)
        if sticker_attr is None:
            return None

        if not self._looks_like_sticker(document):
            return None

        if self._is_already_anonymous_upload(document, send_params):
            self._strip_runtime_pack_hints(send_params)
            return None

        account = self._resolve_account(send_helper)
        local_file = self._find_existing_sticker_file(account, document)
        if local_file is None:
            self._request_download_if_needed(account, document, getattr(send_params, "parentObject", None))
            self._notify_once(
                int(getattr(document, "id", 0) or 0),
                "Стикер скачивается, нажми на него ещё раз после загрузки",
                is_error=False,
            )
            return "cancel"

        try:
            anonymous_document = self._clone_document_for_upload(document, local_file)
            setattr(send_params, "document", anonymous_document)
            setattr(send_params, "path", local_file.getAbsolutePath())
            self._strip_runtime_pack_hints(send_params)
            return None
        except Exception as e:
            self.log(f"[UnlinkedStickers] anonymize failed: {e}")
            self._show_error("Не удалось обезличить стикер. Отправка отменена.")
            return "cancel"

    def _looks_like_sticker(self, document: Any) -> bool:
        try:
            return bool(
                MessageObject.isStickerDocument(document)
                or MessageObject.isAnimatedStickerDocument(document, True)
                or MessageObject.isVideoSticker(document)
            )
        except Exception:
            mime_type = str(getattr(document, "mime_type", "") or "")
            return mime_type in ("image/webp", "application/x-tgsticker", "video/webm")

    def _get_sticker_attribute(self, document: Any) -> Any:
        attrs = getattr(document, "attributes", None)
        if attrs is None:
            return None
        try:
            size = attrs.size()
            for i in range(size):
                attr = attrs.get(i)
                if isinstance(attr, TLRPC.TL_documentAttributeSticker):
                    return attr
        except Exception:
            try:
                for attr in attrs:
                    if isinstance(attr, TLRPC.TL_documentAttributeSticker):
                        return attr
            except Exception:
                return None
        return None

    def _is_already_anonymous_upload(self, document: Any, send_params: Any) -> bool:
        try:
            if int(getattr(document, "access_hash", 0) or 0) != 0:
                return False
            path = getattr(send_params, "path", None)
            if not path:
                return False
            attr = self._get_sticker_attribute(document)
            sticker_set = getattr(attr, "stickerset", None) if attr is not None else None
            return sticker_set is None or isinstance(sticker_set, TLRPC.TL_inputStickerSetEmpty)
        except Exception:
            return False

    def _find_existing_sticker_file(self, account: int, document: Any) -> Any:
        file_loader = FileLoader.getInstance(int(account))
        candidates = []
        for force_cache in (False, True):
            try:
                file_obj = file_loader.getPathToAttach(document, force_cache)
                if file_obj is not None:
                    candidates.append(file_obj)
            except Exception:
                pass

        try:
            local_path = getattr(document, "localPath", None)
            if local_path:
                from java.io import File
                candidates.append(File(str(local_path)))
        except Exception:
            pass

        for file_obj in candidates:
            try:
                if file_obj is not None and file_obj.exists() and file_obj.length() > 0:
                    return file_obj
            except Exception:
                pass
        return None

    def _request_download_if_needed(self, account: int, document: Any, parent_object: Any) -> None:
        try:
            doc_id = int(getattr(document, "id", 0) or 0)
            now = time.time()
            last = float(self._download_request_times.get(doc_id, 0) or 0)
            if now - last < 2.0:
                return
            self._download_request_times[doc_id] = now
            FileLoader.getInstance(int(account)).loadFile(document, parent_object, FileLoader.PRIORITY_HIGH, 0)
        except Exception as e:
            self.log(f"[UnlinkedStickers] download request failed: {e}")

    def _clone_document_for_upload(self, document: Any, local_file: Any) -> Any:
        new_document = TLRPC.TL_document()
        new_document.flags = 0
        new_document.id = 0
        new_document.access_hash = 0
        new_document.file_reference = bytearray()
        new_document.date = int(time.time())
        new_document.mime_type = str(getattr(document, "mime_type", "") or "")
        try:
            new_document.size = local_file.length()
        except Exception:
            new_document.size = int(getattr(document, "size", 0) or 0)
        new_document.dc_id = 0
        try:
            new_document.localPath = local_file.getAbsolutePath()
        except Exception:
            pass

        self._copy_safe_thumbs(document, new_document)
        self._copy_attributes_without_pack(document, new_document)

        try:
            fname = local_file.getName().lower()
            if fname.endswith(".tgs") or new_document.mime_type == "application/x-tgsticker":
                new_document.mime_type = "application/x-tgsticker"
                compressed = _compress_tgs(local_file.getAbsolutePath())
                if compressed is not None:
                    new_document.size = compressed
            elif fname.endswith(".webm") or new_document.mime_type == "video/webm":
                new_document.mime_type = "video/webm"
        except Exception:
            pass

        _ensure_sticker_mime_and_name(new_document, local_file)
        return new_document

    def _copy_safe_thumbs(self, source: Any, target: Any) -> None:
        copied = False
        try:
            thumbs = getattr(source, "thumbs", None)
            if thumbs is not None:
                count = thumbs.size()
                for i in range(count):
                    thumb = thumbs.get(i)
                    if isinstance(thumb, TLRPC.TL_photoStrippedSize):
                        target.thumbs.add(thumb)
                        copied = True
        except Exception:
            copied = False

        if copied:
            try:
                target.flags = int(getattr(target, "flags", 0) or 0) | 1
            except Exception:
                pass

    def _copy_attributes_without_pack(self, source: Any, target: Any) -> None:
        attrs = getattr(source, "attributes", None)
        if attrs is None:
            return

        has_filename = False
        try:
            count = attrs.size()
            for i in range(count):
                attr = attrs.get(i)
                if isinstance(attr, TLRPC.TL_documentAttributeSticker):
                    target.attributes.add(self._anonymous_sticker_attribute(attr))
                else:
                    if isinstance(attr, TLRPC.TL_documentAttributeFilename):
                        has_filename = True
                    target.attributes.add(attr)
        except Exception:
            for attr in attrs:
                if isinstance(attr, TLRPC.TL_documentAttributeSticker):
                    target.attributes.add(self._anonymous_sticker_attribute(attr))
                else:
                    if isinstance(attr, TLRPC.TL_documentAttributeFilename):
                        has_filename = True
                    target.attributes.add(attr)

        if not has_filename:
            filename_attr = TLRPC.TL_documentAttributeFilename()
            filename_attr.file_name = self._default_file_name(str(getattr(source, "mime_type", "") or ""))
            target.attributes.add(filename_attr)

    def _anonymous_sticker_attribute(self, source_attr: Any) -> Any:
        attr = TLRPC.TL_documentAttributeSticker()
        try:
            attr.flags = int(getattr(source_attr, "flags", 0) or 0)
        except Exception:
            attr.flags = 0
        try:
            attr.alt = str(getattr(source_attr, "alt", "") or "")
        except Exception:
            attr.alt = ""
        try:
            attr.mask = bool(getattr(source_attr, "mask", False))
        except Exception:
            attr.mask = False
        try:
            attr.mask_coords = getattr(source_attr, "mask_coords", None)
        except Exception:
            pass
        attr.stickerset = TLRPC.TL_inputStickerSetEmpty()
        return attr

    def _default_file_name(self, mime_type: str) -> str:
        if mime_type == "application/x-tgsticker":
            return "sticker.tgs"
        if mime_type == "video/webm":
            return "sticker.webm"
        return "sticker.webp"

    def _strip_runtime_pack_hints(self, send_params: Any) -> None:
        try:
            setattr(send_params, "updateStickersOrder", False)
        except Exception:
            pass
        try:
            setattr(send_params, "parentObject", None)
        except Exception:
            pass
        try:
            params = getattr(send_params, "params", None)
            if params is not None:
                try:
                    params.remove("query")
                except Exception:
                    pass
        except Exception:
            pass

    def _resolve_account(self, send_helper: Any) -> int:
        for field_name in ("currentAccount",):
            try:
                value = get_private_field(send_helper, field_name)
                if value is not None:
                    return int(value)
            except Exception:
                pass
            try:
                value = getattr(send_helper, field_name)
                if value is not None:
                    return int(value)
            except Exception:
                pass
        try:
            return int(UserConfig.selectedAccount)
        except Exception:
            return 0

    def _notify_once(self, doc_id: int, text: str, is_error: bool = False) -> None:
        now = time.time()
        last = float(self._notify_times.get(doc_id, 0) or 0)
        if now - last < 1.5:
            return
        self._notify_times[doc_id] = now
        if is_error:
            self._show_error(text)
        else:
            self._show_info(text)

    def _show_info(self, text: str) -> None:
        try:
            BulletinHelper.show_info(text)
        except Exception:
            self.log(f"[UnlinkedStickers] {text}")

    def _show_error(self, text: str) -> None:
        try:
            BulletinHelper.show_error(text)
        except Exception:
            self.log(f"[UnlinkedStickers] {text}")

