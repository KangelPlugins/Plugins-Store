SYSTEM_LANGUAGE_ALIASES = {'iw': 'he', 'in': 'id', 'ji': 'yi', 'zh-hans': 'zh', 'zh-hant': 'zh'}

def _normalize_system_language(value):
    try:
        raw = str(value or '').strip().lower().replace('_', '-')
    except Exception:
        return ''
    if not raw:
        return ''
    raw = SYSTEM_LANGUAGE_ALIASES.get(raw, raw)
    base = raw.split('-', 1)[0]
    return SYSTEM_LANGUAGE_ALIASES.get(base, base)


def _get_system_language_code():
    """Возвращает код языка интерфейса Telegram/Android или английский fallback."""
    candidates = []
    try:
        lc = LocaleController.getInstance()
        if lc is not None:
            for method_name in ('getCurrentLocaleInfo', 'getCurrentLocale', 'getCurrentLangCode', 'getCurrentLanguageName'):
                try:
                    member = getattr(lc, method_name, None)
                    value = member() if callable(member) else member
                    candidates.append(value)
                    for attr in ('shortName', 'pluralLangCode', 'langCode', 'name', 'nameEnglish'):
                        candidates.append(getattr(value, attr, None))
                except Exception:
                    pass
    except Exception:
        pass
    try:
        candidates.append(Locale.getDefault().getLanguage())
    except Exception:
        pass
    for candidate in candidates:
        code = _normalize_system_language(candidate)
        if code in INTERFACE_LANGUAGE_CODES:
            return code
    return 'en'


def _safe_locale(code):
    try:
        return Locale.forLanguageTag(str(code or '').replace('_', '-'))
    except Exception:
        return None


class WikiSearch(BasePlugin):
    def on_plugin_load(self):
        log("[WikiSearch] Plugin loaded!")
        self.add_on_send_message_hook()

    def on_plugin_unload(self):
        log("[WikiSearch] Plugin unloaded!")

    def _interface_language_code(self):
        try:
            mode = int(self.get_setting('interface_language', 0))
        except Exception:
            mode = 0
        if mode < 0 or mode >= len(INTERFACE_LANGUAGE_CODES):
            mode = 0
        code = INTERFACE_LANGUAGE_CODES[mode]
        return _get_system_language_code() if code == 'auto' else code

    def _language_item(self, language_code):
        """Название языка на языке интерфейса; флаг только при точном соответствии."""
        ui_code = self._interface_language_code()
        display = ''
        try:
            target = _safe_locale(language_code)
            viewer = _safe_locale(ui_code)
            if target is not None and viewer is not None:
                display = str(target.getDisplayLanguage(viewer) or '').strip()
        except Exception:
            display = ''
        if not display or display.lower() == str(language_code).lower():
            if ui_code == 'ru':
                display = RUSSIAN_LANGUAGE_NAMES.get(language_code, '')
            elif ui_code == 'en':
                display = ENGLISH_LANGUAGE_NAMES.get(language_code, '')
        if not display:
            display = NATIVE_LANGUAGE_NAMES.get(language_code, ENGLISH_LANGUAGE_NAMES.get(language_code, language_code))
        flag = LANGUAGE_FLAGS.get(language_code, '')
        return (flag + ' ' if flag else '') + display

    def _sync_wiki_language_text(self):
        code = self._interface_language_code()
        labels = {
            'ru': ('Синхронизировать язык Wikipedia', 'Автоматически менять язык Wikipedia при смене языка интерфейса'),
            'uk': ('Синхронізувати мову Wikipedia', 'Автоматично змінювати мову Wikipedia при зміні мови інтерфейсу'),
            'be': ('Сінхранізаваць мову Wikipedia', 'Аўтаматычна змяняць мову Wikipedia пры змене мовы інтэрфейсу'),
            'en': ('Synchronize Wikipedia language', 'Automatically change Wikipedia language when the interface language changes'),
        }
        return labels.get(code, labels['en'])

    def Z(self, key):
        """Возвращает интерфейсную строку на выбранном языке или безопасный fallback."""
        code = self._interface_language_code()
        legacy_idx = LEGACY_INTERFACE_CODES.index(code) if code in LEGACY_INTERFACE_CODES else -1
        if legacy_idx >= 0:
            try:
                return str(TRANSLATIONS.get(key, (key,) * 16)[legacy_idx])
            except Exception:
                return str(key)
        return str(INTERFACE_TEXTS.get(code, INTERFACE_TEXTS.get('en', {})).get(key, key))

    def _on_interface_language_changed(self, value):
        """Меняет интерфейс и автоматически выбирает одноимённый раздел Wikipedia."""
        try:
            selected = int(value)
        except Exception:
            selected = 0
        if selected < 0 or selected >= len(INTERFACE_LANGUAGE_CODES):
            selected = 0
        code = INTERFACE_LANGUAGE_CODES[selected]
        if code == 'auto':
            code = _get_system_language_code()
        try:
            if self.get_setting('sync_wiki_language', True) and code in WIKI_LANGUAGES:
                self.set_setting('wiki_language', WIKI_LANGUAGES.index(code))
            self.set_setting('interface_language', selected, reload_settings=True)
        except Exception as e:
            log(f'[WikiSearch] Error changing interface language: {e}')

    def create_settings(self):
        Z = self.Z
        language_items = [self._language_item(code) for code in WIKI_LANGUAGES]
        interface_items = [Z('auto_language') if 'auto_language' in INTERFACE_TEXTS.get(self._interface_language_code(), {}) else 'Automatic (system language)']
        interface_items.extend(self._language_item(code) for code in INTERFACE_LANGUAGE_CODES[1:])
        try:
            default_index = WIKI_LANGUAGES.index(DEFAULT_WIKI_LANGUAGE_CODE)
        except ValueError:
            default_index = 0
        sync_title, sync_subtext = self._sync_wiki_language_text()
        return [
            Header(text=Z('settings_header')),
            Header(text=Z('language_header')),
            Selector(
                key='interface_language',
                text=Z('interface_language'),
                default=self.get_setting('interface_language', 0),
                items=interface_items,
                on_change=self._on_interface_language_changed
            ),
            Divider(text=Z('interface_language_desc')),
            Divider(),
            Header(text=Z('wiki_language_header')),
            Selector(
                key='wiki_language',
                text=Z('wiki_language'),
                default=self.get_setting('wiki_language', default_index),
                items=language_items
            ),
            Divider(text=Z('wiki_language_desc')),
            Switch(key='sync_wiki_language', text=sync_title, default=True, subtext=sync_subtext),
            Divider(),
            Header(text=Z('content_filter_header')),
            Switch(key='allow_adult', text=Z('allow_adult'), default=False, subtext=Z('allow_adult_desc')),
            Divider(),
            Header(text=Z('display_settings_header')),
            Switch(key='show_url', text=Z('show_url'), default=True, subtext=Z('show_url_desc')),
            Switch(key='show_last_modified', text=Z('show_last_modified'), default=False, subtext=Z('show_last_modified_desc')),
            Divider(text=Z('usage_divider')),
        ]

    def _get_language_code(self):
        """Возвращает код языка для поиска Wikipedia"""
        index = self.get_setting("wiki_language", DEFAULT_WIKI_LANGUAGE_INDEX)
        if 0 <= index < len(WIKI_LANGUAGES):
            return WIKI_LANGUAGES[index]
        return "ru"  # fallback

    def _is_adult_query(self, query):
        """Проверяет, является ли запрос 18+"""
        adult_keywords = [
            "секс", "порно", "эротика", "эротический", "инцест", "изнасилование",
            "педофил", "педофилия", "гомосексуал", "гомосексуализм", "лесбиянка",
            "лесбийский", "трансгендер", "транссексуал", "нудист", "нудизм",
            "оргия", "садизм", "мазохизм", "садомазохизм", "бдсм", "BDSM",
            "вуайеризм", "экстибиционизм", "фрики", "извращение", "извращенец",
            "разврат", "развратный", "пошлость", "непристойный", "вульгарный",
            "сексуальный", "сексуальное", "сексуальная", "сексуальные",
            "половой", "половая", "половое", "половые", "половых",
            "гениталии", "пенис", "вагина", "грудь", "женская грудь",
            "оральный", "оральная", "оральное", "анальный", "анальная",
            "sex", "porn", "porno", "erotic", "erotica", "incest", "rape",
            "pedophile", "pedophilia", "homosexual", "homosexuality", "lesbian",
            "transgender", "transsexual", "nudist", "nudism", "orgy", "sadism",
            "masochism", "sadomasochism", "bdsm", "voyeurism", "exhibitionism",
            "pervert", "perversion", "obscene", "obscenity", "vulgar", "vulgarity",
            "sexual", "sexually", "genital", "genitals", "penis", "vagina",
            "breast", "breasts", "oral", "anal", "fetish", "fetishism",
            "pornographic", "pornography", "xxx", "nsfw", "adult", "mature"
        ]
        query_lower = query.lower()
        for keyword in adult_keywords:
            if keyword in query_lower:
                return True
        return False

    def _search_wikipedia(self, query, language):
        try:
            url = f"https://{language}.wikipedia.org/w/api.php"

            params = {
                "action": "query",
                "format": "json",
                "list": "search",
                "srsearch": query,
                "srlimit": 5,
                "srprop": "snippet",
                "utf8": 1
            }
            headers = {
                "User-Agent": "Wikipedia Plugin/1.0 (Mozilla/5.0)",
                "Accept-Language": language
            }
            response = requests.get(url, params=params, headers=headers, timeout=15)
            response.raise_for_status()
            data = response.json()
            results = data.get("query", {}).get("search", [])
            return results, None
        except Exception as e:
            log(f"Error searching Wikipedia: {e}")
            return None, f"Error searching Wikipedia: {str(e)}"

    def _get_article_summary(self, title, language):
        try:
            encoded_title = urllib.parse.quote(title.replace(' ', '_'), safe='')
            url = f"https://{language}.wikipedia.org/api/rest_v1/page/summary/{encoded_title}"

            headers = {
                "User-Agent": "Wikipedia Plugin/1.0 (Mozilla/5.0)",
                "Accept-Language": language
            }
            response = requests.get(url, headers=headers, timeout=15)
            response.raise_for_status()
            return response.json(), None
        except Exception as e:
            log(f"Error fetching article summary: {e}")
            return None, f"Error fetching article summary: {str(e)}"

    def _get_page_images(self, title, language):
        """Проверяет наличие изображений на странице"""
        try:
            url = f"https://{language}.wikipedia.org/w/api.php"
            params = {
                "action": "query",
                "format": "json",
                "prop": "images",
                "titles": title,
                "imlimit": 1,
                "utf8": 1
            }
            headers = {
                "User-Agent": "Wikipedia Plugin/1.0 (Mozilla/5.0)",
                "Accept-Language": language
            }
            response = requests.get(url, params=params, headers=headers, timeout=10)
            response.raise_for_status()
            data = response.json()

            pages = data.get("query", {}).get("pages", {})
            for page_id, page_data in pages.items():
                if "images" in page_data and page_data["images"]:
                    return True
            return False
        except Exception as e:
            log(f"Error checking images: {e}")
            return False

    def _clean_html(self, text):
        if not text:
            return ""
        text = re.sub(r'<[^>]+>', '', text)
        text = re.sub(r'\s+', ' ', text)
        return text.strip()

    def _format_summary(self, summary_data):
        try:
            title = summary_data.get("title", "No Title")
            extract = summary_data.get("extract", "")

            if not extract or len(extract) < 10:
                extract = summary_data.get("description", "")

            if not extract:
                extract = "No description available"

            max_length = 700
            if len(extract) > max_length:
                cut_point = extract[:max_length].rfind('. ')
                if cut_point == -1:
                    cut_point = extract[:max_length].rfind(', ')
                if cut_point == -1:
                    cut_point = extract[:max_length].rfind(' ')
                if cut_point != -1:
                    extract = extract[:cut_point + 1] + "..."
                else:
                    extract = extract[:max_length] + "..."

            url = summary_data.get("content_urls", {}).get("desktop", {}).get("page", "")
            thumbnail = summary_data.get("thumbnail", {}).get("source", "")
            return title, extract, url, thumbnail
        except Exception as e:
            log(f"Error formatting summary: {e}")
            return "Error formatting summary.", "", "", ""

    def _do_search(self, query, params):
        """Выполняет поиск с языком из настроек"""
        def search():
            try:
                # Проверяем фильтр 18+
                allow_adult = self.get_setting("allow_adult", False)
                if not allow_adult and self._is_adult_query(query):
                    params.message = "❌ 18+ content search is disabled. Enable it in plugin settings."
                    run_on_ui_thread(lambda: self._send_result(params))
                    return

                # Используем язык из настроек
                lang = self._get_language_code()

                log(f"[WikiSearch] Searching '{query}' in {lang}")

                search_results, error = self._search_wikipedia(query, lang)

                if error:
                    params.message = f"❌ {error}"
                    run_on_ui_thread(lambda: self._send_result(params))
                    return

                if not search_results:
                    if " " in query:
                        log("[WikiSearch] No results, trying first word only...")
                        first_word = query.split()[0]
                        search_results, error = self._search_wikipedia(first_word, lang)

                    if not search_results:
                        params.message = f"❌ No results found for '{query}' in {lang}"
                        run_on_ui_thread(lambda: self._send_result(params))
                        return

                first_result = search_results[0]
                title = first_result.get("title", "")

                summary_data, error = self._get_article_summary(title, lang)

                if error or not summary_data:
                    snippet = first_result.get("snippet", "")
                    snippet = self._clean_html(snippet)
                    if snippet:
                        params.message = f"**{title}**\n\n{snippet}"
                        run_on_ui_thread(lambda: self._send_result(params))
                        return
                    else:
                        params.message = f"⚠️ Could not retrieve article for '{title}'"
                        run_on_ui_thread(lambda: self._send_result(params))
                        return

                title, extract, url, thumbnail = self._format_summary(summary_data)
                extract = self._clean_html(extract)

                if self.get_setting("show_last_modified", False):
                    lastmod = summary_data.get("timestamp") or summary_data.get("lastmodified") or summary_data.get("last_modified")
                    if lastmod:
                        extract += f"\n\n📅 Last updated: {lastmod[:10]}"

                show_url = self.get_setting("show_url", True)
                if url and show_url:
                    extract += f"\n\n🔗 [Read more]"

                # Проверяем наличие изображений
                has_thumbnail = bool(thumbnail)
                if not has_thumbnail:
                    has_images = self._get_page_images(title, lang)
                else:
                    has_images = True

                has_any_image = has_thumbnail or has_images

                if lang == "ru":
                    if has_any_image:
                        thumb_text = "\n\n*В этом запросе есть изображение*"
                    else:
                        thumb_text = "\n\n*В этом запросе нет обложки*"
                else:
                    if has_any_image:
                        thumb_text = "\n\n*This request has an image*"
                    else:
                        thumb_text = "\n\n*No thumbnail available for this request*"

                extract += thumb_text

                # Формируем сообщение
                header = f"Wikipedia: {title}"
                body = f"**{title}**\n\n{extract}"
                params.message = f"{header}\n\n{body}"

                # Добавляем форматирование
                if not hasattr(params, "entities") or params.entities is None:
                    params.entities = ArrayList()
                elif not isinstance(params.entities, ArrayList):
                    params.entities = ArrayList(params.entities)

                # Заголовок "Wikipedia: ..." жирным
                header_start = params.message.find("Wikipedia:")
                if header_start != -1:
                    header_end = params.message.find("\n", header_start)
                    if header_end == -1:
                        header_end = len(params.message)
                    entity_header = TLRPC.TL_messageEntityBold()
                    entity_header.offset = header_start
                    entity_header.length = header_end - header_start
                    params.entities.add(entity_header)

                # Название в теле жирным
                title_start = params.message.find(f"**{title}**")
                if title_start != -1:
                    entity_bold = TLRPC.TL_messageEntityBold()
                    entity_bold.offset = title_start
                    entity_bold.length = len(title) + 4
                    params.entities.add(entity_bold)

                # Цитата (обложка)
                quote_start = params.message.find("\n\n", header_start)
                if quote_start != -1:
                    quote_end = params.message.find("\n\n🔗") if "\n\n🔗" in params.message else len(params.message)
                    if quote_end > quote_start:
                        entity_quote = TLRPC.TL_messageEntityBlockquote()
                        entity_quote.offset = quote_start + 2
                        entity_quote.length = quote_end - quote_start - 2
                        entity_quote.collapsed = True
                        params.entities.add(entity_quote)

                # Ссылка "Read more"
                if url and show_url:
                    link_text = "Read more"
                    link_offset = params.message.find("Read more")
                    if link_offset != -1:
                        entity_url = TLRPC.TL_messageEntityTextUrl()
                        entity_url.offset = link_offset
                        entity_url.length = len(link_text)
                        entity_url.url = url
                        params.entities.add(entity_url)

                run_on_ui_thread(lambda: self._send_result(params))
            except Exception as e:
                log(f"Error in Wikipedia plugin: {e}")
                params.message = f"❌ Error: {str(e)}"
                run_on_ui_thread(lambda: self._send_result(params))

        threading.Thread(target=search, daemon=True).start()

    def on_send_message_hook(self, account, params):
        if not hasattr(params, 'message') or not isinstance(params.message, str):
            return HookResult()

        if not params.message.startswith(".wiki "):
            return HookResult()

        query = params.message[6:].strip()
        if not query:
            params.message = "Please provide a search term after .wiki"
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        # Запускаем поиск сразу с языком из настроек
        self._do_search(query, params)

        return HookResult(strategy=HookStrategy.CANCEL)

    def _send_result(self, params):
        from client_utils import get_send_messages_helper
        get_send_messages_helper().sendMessage(params)

plugin = WikiSearch()