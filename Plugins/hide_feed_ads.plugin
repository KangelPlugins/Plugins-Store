from base_plugin import BasePlugin, MethodReplacement
from hook_utils import find_class

__id__ = "hide_feed_ads"
__name__ = "Hide Feed Ads"
__description__ = "Hides promotional posts inserted into the feed."
__author__ = "@rezolvePlugins"
__version__ = "1.0"
__app_version__ = ">=12.9.0"
__sdk_version__ = ">=1.4.5.1"

FEED_AD_CONTROLLER_CLASS = "com.exteragram.messenger.feed.ads.FeedAdController"
IS_ENABLED_METHOD = "isEnabled"


class DisableFeedAds(MethodReplacement):
    def replace_hooked_method(self, param):
        return False


class HideFeedAdsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._unhooks = []

    def on_plugin_load(self):
        self.on_plugin_unload()
        controller = find_class(FEED_AD_CONTROLLER_CLASS)
        self._unhooks = self.hook_all_methods(
            controller,
            IS_ENABLED_METHOD,
            DisableFeedAds(),
        ) or []

    def on_plugin_unload(self):
        for unhook in list(self._unhooks):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self._unhooks.clear()
