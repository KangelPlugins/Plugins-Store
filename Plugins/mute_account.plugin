from typing import Any, List
from base_plugin import BasePlugin, MethodHook, HookResult, HookStrategy
from hook_utils import find_class, get_private_field
from ui.settings import Header, Switch, Text
from ui.alert import AlertDialogBuilder
from client_utils import get_last_fragment

__id__ = "mute_account"
__name__ = "Mute Account"
__description__ = "Плагин отключает push-уведомления и локальные всплытия только для выбранных аккаунтов. @bobrplugins"
__author__ = "@bober41"
__version__ = "1.0"
__icon__ = "bobrplugins/15"
__app_version__ = ">=12.8.1"
__sdk_version__ = ">=1.4.3.10"

class NotificationBlockHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            current = get_private_field(param.thisObject, "currentAccount")
            if current is not None and self.plugin.get_setting(f"mute_acc_{current}", False):
                param.setResult(None)
        except Exception:
            pass


class MuteAccountPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_hook("TL_account_registerDevice")
        self.add_hook("TL_account_unregisterDevice")

        try:
            from java.lang import Class
            nc = Class.forName("org.telegram.messenger.NotificationsController")
            methods = nc.getDeclaredMethods()
            hooked = 0
            target_names = ["showOrUpdateNotification", "showNewMessageNotification",
                            "showInAppNotification", "showOutgoingNotification"]

            for i in range(len(methods)):
                method = methods[i]
                if method.getName() in target_names:
                    method.setAccessible(True)
                    self.hook_method(method, NotificationBlockHook(self))
                    hooked += 1

            self.log(f"MuteAccount: hooked {hooked} notification method(s)")

        except Exception as e:
            self.log(f"MuteAccount: hook error: {e}")

    def pre_request_hook(self, request_name, account, request):
        if request_name not in ("TL_account_registerDevice", "TL_account_unregisterDevice"):
            return HookResult()
        if self.get_setting(f"mute_acc_{account}", False):
            return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult()

    def _show_about(self, view):
        fragment = get_last_fragment()
        if not fragment:
            return
        activity = fragment.getParentActivity()
        if not activity:
            return

        builder = AlertDialogBuilder(activity)
        builder.set_title("О плагине")
        builder.set_message(
            "Плагин отключает push-уведомления и локальные всплытия только для выбранных аккаунтов, "
            "оставляя их для остальных. Сообщения по-прежнему приходят и отображаются в списке чатов.\n\n"
            "Автор: @bober41\n"
            "Канал обновлений: @bobrplugins"
        )
        builder.set_positive_button("OK", lambda b, w: b.dismiss())
        builder.show()

    def _get_all_accounts(self):
        found = []
        try:
            from org.telegram.messenger import UserConfig
            uc_class = UserConfig.getClass()
            f = uc_class.getDeclaredField("Instance")
            f.setAccessible(True)
            arr = f.get(None)
            if arr is None:
                return found

            for i in range(len(arr)):
                try:
                    cfg = arr[i]
                    if cfg is None:
                        continue
                    cid = cfg.getClientUserId()
                    if cid == 0:
                        continue
                    user = cfg.getCurrentUser()
                    found.append((i, cid, user))
                except Exception:
                    pass
        except Exception as e:
            self.log(f"MuteAccount: scan error: {e}")

        return found

    def create_settings(self) -> List[Any]:
        settings = [Header(text="Mute Account")]
        accounts = self._get_all_accounts()

        if not accounts:
            settings.append(Text(text="No active accounts found", icon="msg_error"))
            return settings

        for i, client_id, user in accounts:
            parts = []
            if user:
                if user.first_name:
                    parts.append(str(user.first_name))
                if user.last_name:
                    parts.append(str(user.last_name))

            name = " ".join(parts) if parts else f"Account {i}"
            if user and user.phone:
                name += f" (+{user.phone})"
            elif client_id != 0:
                name += f" (ID {client_id})"

            settings.append(Switch(
                key=f"mute_acc_{i}",
                text=name,
                default=False,
                icon="msg_mute",
            ))

        settings.append(Text(
            text="О плагине",
            icon="msg_info",
            on_click=self._show_about,
        ))

        return settings
