import base64
import zlib
import threading

from java import jclass
from org.telegram.messenger import ApplicationLoader

from base_plugin import BasePlugin
from android_utils import log
from typing import Any, List

__id__ = "pill_stack_to_header"
__name__ = "Pill Stack to Header"
__description__ = "Перемещает Pill Stack из строки поиска на панель главного экрана.\n\n**Ссылка на документацию в настройках плагина!**"
__author__ = "@itNotMax - @MaxExteraPlugins"
__version__ = "3.0"
__icon__ = "MaxExteraPluginsStickers/18"
__min_version__ = "12.1.1"
__app_version__ = ">=12.1.1"
__sdk_version__ = ">=1.4.3.3"

ENTRY_CLASS = "com.maxplugins.pillstack.Main"
DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"
PREFS_NAME = "pill_stack_prefs"

_BOOL_KEYS = ("hide_title", "expanded_only", "align_right")
_INT_KEYS = ("offset_dp", "offset_top_dp", "offset_right_dp")


class Dex:
    def __init__(self, ec):
        self.ec = ec
        self.clazz = None
        self.loaded = False
        self._m = {}
    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            ctx = ApplicationLoader.applicationContext
            if not ctx:
                raise RuntimeError("no ctx")
            self.clazz = jclass("dalvik.system.InMemoryDexClassLoader")(jclass("java.nio.ByteBuffer").wrap(self._rp()), ctx.getClassLoader()).loadClass(self.ec)
            for m in self.clazz.getDeclaredMethods():
                m.setAccessible(True)
                self._m[str(m.getName())] = m
        self._m["load"].invoke(None)
        self.loaded = True
    def unload(self):
        try:
            if self.loaded and "unload" in self._m:
                self._m["unload"].invoke(None)
        except Exception:
            pass
        self.loaded = False
    def call(self, name, *args):
        try:
            if self.loaded and name in self._m:
                return self._m[name].invoke(None, *args)
        except Exception as e:
            log(f"[PillTabs] dex.{name}: {e}")
        return None
    def _rp(self):
        with open(__file__, "r", encoding="utf-8") as f:
            t = f.read()
        b = t.split(f"# {DEX_BEGIN}", 1)[1].split(f"# {DEX_END}", 1)[0]
        p = "".join(l.strip()[1:].strip() for l in b.splitlines() if l.strip().startswith("#"))
        if not p:
            raise RuntimeError("dex empty")
        return zlib.decompress(base64.b64decode(p))


class PillTabsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex = Dex(ENTRY_CLASS)

    def _prefs(self):
        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS_NAME, 0)

    def _sync_settings_to_java(self):
        try:
            editor = self._prefs().edit()
            for key in _BOOL_KEYS:
                v = self.get_setting(key, None)
                if v is not None:
                    editor.putBoolean(key, bool(v))
            for key in _INT_KEYS:
                v = self.get_setting(key, None)
                if v is not None:
                    try:
                        editor.putInt(key, int(v))
                    except Exception:
                        pass
            editor.apply()
        except Exception:
            pass

    def _load_dex(self):
        try:
            self.dex.load()
        except Exception as e:
            log(f"[PillTabs] dex load: {e}")
        try:
            self.dex.call("pyFlushConfig")
        except Exception:
            pass

    def on_plugin_load(self):
        self._sync_settings_to_java()
        threading.Thread(target=self._load_dex, daemon=True, name="PillTabs-init").start()

    def on_plugin_unload(self):
        try:
            self.dex.unload()
        except Exception:
            pass

    def _on_bool_changed(self, v):
        self._sync_settings_to_java()
        try:
            self.dex.call("pyFlushConfig")
        except Exception:
            pass

    def _on_str_changed(self, v):
        self._sync_settings_to_java()
        try:
            self.dex.call("pyFlushConfig")
        except Exception:
            pass

    def _on_align_changed(self, v):
        self._sync_settings_to_java()
        try:
            self.dex.call("pyFlushConfigFull")
        except Exception:
            pass

    def _open_url(self, url):
        def handler(view):
            try:
                from org.telegram.messenger.browser import Browser
                ctx = view.getContext()
                Browser.openUrl(ctx, url)
            except Exception:
                pass
        return handler

    def create_settings(self) -> List[Any]:
        from ui.settings import Input, Header, Switch, Divider, Text
        return [
            Header(text="Информация"),
            Text(
                text="Документация",
                icon="msg_link",
                on_click=self._open_url("https://telegra.ph/Dokumentaciya-k-plaginu-Pill-Stack-on-the-Tab-06-26"),
            ),
            Text(
                text="Канал автора",
                icon="msg_channel",
                on_click=self._open_url("https://t.me/MaxExteraPlugins"),
            ),
            Divider(),
            Header(text="Заголовок"),
            Switch(
                key="hide_title",
                text="Скрыть заголовок",
                default=True,
                subtext="Скрыть заголовок (Telegram/ExteraGram/ваше имя/название папки) на главном экране, чтобы для Pill Stack было место",
                on_change=self._on_bool_changed,
            ),
            Divider(),
            Header(text="Видимость"),
            Switch(
                key="expanded_only",
                text="Раскрытый режим",
                default=True,
                subtext="Показывать Pill Stack при вытягивании историй (видео-пример в документации)",
                on_change=self._on_bool_changed,
            ),
            Divider(),
            Header(text="Позиция Pill Stack"),
            Switch(
                key="align_right",
                text="Прижать к правому краю",
                default=False,
                subtext="Размещает Pill Stack у правой границы экрана. Отступ от левого края игнорируется",
                on_change=self._on_align_changed,
            ),
            Input(
                key="offset_dp",
                text="Отступ от левого края (dp)",
                default="16",
                subtext="Расстояние от левого края экрана. \nПо умолчанию: 16",
                on_change=self._on_str_changed,
            ),
            Input(
                key="offset_right_dp",
                text="Отступ от правого края (dp)",
                default="16",
                subtext="Расстояние от правого края экрана (при включённой функции «Прижать к правому краю»). \nПо умолчанию: 16",
                on_change=self._on_str_changed,
            ),
            Input(
                key="offset_top_dp",
                text="Отступ от верха (dp)",
                default="1",
                subtext="Дополнительный сдвиг вниз от верхней границы. \nПо умолчанию: 1",
                on_change=self._on_str_changed,
            ),
        ]


__plugin__ = PillTabsPlugin


