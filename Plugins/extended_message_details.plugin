def to_python_list(java_obj):
    """Converts a Java List / ArrayList or Python iterable to a Python list."""
    if not java_obj:
        return []
    if isinstance(java_obj, (list, tuple)):
        return list(java_obj)
    res = []
    try:
        size = java_obj.size()
        for i in range(size):
            res.append(java_obj.get(i))
        return res
    except Exception:
        pass
    try:
        return list(java_obj)
    except Exception:
        pass
    return []


def get_loc_string(key, fallback=""):
    """Helper to fetch localized string based on current Telegram language."""
    try:
        locale_controller = find_class("org.telegram.messenger.LocaleController")
        lang_code = str(locale_controller.getInstance().getCurrentLocaleInfo().pluralLangCode)
    except Exception:
        lang_code = "en"
    lang = "ru" if lang_code.startswith("ru") else "en"
    return LOCALIZATION.get(lang, {}).get(key, LOCALIZATION["en"].get(key, fallback or key))


_R_DRAWABLE_CACHE = None

def get_drawable_id(name, default_id=0):
    """Safely get Telegram native R.drawable ID with cached class lookup."""
    global _R_DRAWABLE_CACHE
    if _R_DRAWABLE_CACHE is None:
        try:
            _R_DRAWABLE_CACHE = find_class("org.telegram.messenger.R$drawable")
        except Exception:
            _R_DRAWABLE_CACHE = False

    if _R_DRAWABLE_CACHE:
        try:
            return getattr(_R_DRAWABLE_CACHE, name, default_id)
        except Exception:
            pass
    return default_id


def format_time_exteragram(ts):
    """Format Unix timestamp using exteraGram's exact formatTime logic."""
    if not ts or ts <= 0:
        return None
    if ts == 2147483646:
        try:
            lc = find_class("org.telegram.messenger.LocaleController")
            r_str = find_class("org.telegram.messenger.R$string")
            return str(lc.getString(getattr(r_str, "SendWhenOnline")))
        except Exception:
            return "When Online"
    try:
        lc_cls = find_class("org.telegram.messenger.LocaleController")
        lc = lc_cls.getInstance()
        r_str = find_class("org.telegram.messenger.R$string")
        fmt_id = getattr(r_str, "formatDateAtTime", 0)

        date_cls = find_class("java.util.Date")
        j_date = date_cls(int(ts) * 1000)

        year_str = lc.getFormatterYear().format(j_date)
        time_str = lc.getFormatterDayWithSeconds().format(j_date)

        return str(lc_cls.formatString("formatDateAtTime", fmt_id, year_str, time_str))
    except Exception:
        dt = datetime.datetime.fromtimestamp(int(ts))
        return dt.strftime("%d.%m.%Y %H:%M:%S")


def format_short_duration(seconds):
    """Format seconds duration into standard string."""
    if not seconds or seconds <= 0:
        return None
    try:
        android_utilities = find_class("org.telegram.messenger.AndroidUtilities")
        return str(android_utilities.formatShortDuration(int(seconds)))
    except Exception:
        m, s = divmod(int(seconds), 60)
        h, m = divmod(m, 60)
        return f"{h:02d}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


class DetailItem:
    """Represents a single row in the message details menu."""
    def __init__(self, title, subtitle, icon_name, item_id=-1, real_value=None, mime_type="*/*", owner_id=0, input_sticker_set=None, doc=None):
        self.title = title
        self.subtitle = subtitle
        self.icon_name = icon_name
        self.item_id = item_id
        self.real_value = real_value or subtitle
        self.mime_type = mime_type
        self.owner_id = owner_id
        self.input_sticker_set = input_sticker_set
        self.doc = doc


class MutagenExtractor:
    """Extracts audio metadata using Mutagen library."""
    @staticmethod
    def extract_audio_metadata(file_path, doc_title="", doc_artist="", doc_size=0, duration=0):
        res = {
            "title": doc_title or None,
            "artist": doc_artist or None,
            "sample_rate": None,
            "bit_depth": None,
            "channels": None,
            "bitrate": None
        }
        if file_path:
            try:
                audio = mutagen.File(file_path)
                if audio is not None:
                    tags = getattr(audio, "tags", None)
                    if tags:
                        for k in ("TIT2", "title", "TITLE", "\xa9nam"):
                            if k in tags:
                                val = tags[k]
                                if isinstance(val, (list, tuple)) and len(val) > 0:
                                    val = val[0]
                                if str(val).strip():
                                    res["title"] = str(val).strip()
                                    break
                        for k in ("TPE1", "artist", "ARTIST", "\xa9ART", "author"):
                            if k in tags:
                                val = tags[k]
                                if isinstance(val, (list, tuple)) and len(val) > 0:
                                    val = val[0]
                                if str(val).strip():
                                    res["artist"] = str(val).strip()
                                    break

                    aud_info = getattr(audio, "info", None)
                    if aud_info:
                        if hasattr(aud_info, "sample_rate") and aud_info.sample_rate:
                            sr = int(aud_info.sample_rate)
                            if sr > 0:
                                res["sample_rate"] = sr
                        if hasattr(aud_info, "bits_per_sample") and aud_info.bits_per_sample:
                            res["bit_depth"] = int(aud_info.bits_per_sample)
                        elif hasattr(aud_info, "sample_size") and aud_info.sample_size:
                            res["bit_depth"] = int(aud_info.sample_size)
                        if hasattr(aud_info, "channels") and aud_info.channels:
                            res["channels"] = int(aud_info.channels)
                        if hasattr(aud_info, "bitrate") and aud_info.bitrate:
                            b = int(aud_info.bitrate)
                            if b > 0:
                                res["bitrate"] = (b / 1000.0) if b > 2000 else float(b)
            except Exception:
                pass

        return res


class MediaFormatExtractor:
    """Extracts media format details via Android MediaExtractor with sample size summation for true VBR bitrate."""
    @staticmethod
    def extract(file_path, duration_sec=0):
        res = {
            "sample_rate": None,
            "channels": None,
            "fps": None,
            "video_codec": None,
            "audio_bitrate": None,
            "video_bitrate": None
        }
        if not file_path:
            return res
        try:
            media_extractor_cls = find_class("android.media.MediaExtractor")
            media_format_cls = find_class("android.media.MediaFormat")
            extractor = media_extractor_cls()
            extractor.setDataSource(str(file_path))
            track_count = extractor.getTrackCount()

            for i in range(track_count):
                fmt = extractor.getTrackFormat(i)
                mime = fmt.getString(getattr(media_format_cls, "KEY_MIME", "mime")) or ""

                dur_ms = duration_sec * 1000.0 if duration_sec > 0 else 0.0
                key_dur = getattr(media_format_cls, "KEY_DURATION", "durationUs")
                if dur_ms <= 0 and fmt.containsKey(key_dur):
                    dur_us = fmt.getLong(key_dur)
                    if dur_us > 0:
                        dur_ms = dur_us / 1000.0

                if mime.startswith("audio/"):
                    key_sr = getattr(media_format_cls, "KEY_SAMPLE_RATE", "sample-rate")
                    if fmt.containsKey(key_sr):
                        res["sample_rate"] = fmt.getInteger(key_sr)
                    key_ch = getattr(media_format_cls, "KEY_CHANNEL_COUNT", "channel-count")
                    if fmt.containsKey(key_ch):
                        res["channels"] = fmt.getInteger(key_ch)

                    audio_br = MediaFormatExtractor._calc_track_bitrate(extractor, i, dur_ms, file_path)
                    if audio_br <= 0 and fmt.containsKey(getattr(media_format_cls, "KEY_BIT_RATE", "bitrate")):
                        raw_br = fmt.getInteger(getattr(media_format_cls, "KEY_BIT_RATE", "bitrate"))
                        if raw_br > 0:
                            audio_br = raw_br / 1000.0
                    if audio_br > 0:
                        res["audio_bitrate"] = int(round(audio_br))

                elif mime.startswith("video/"):
                    key_fr = getattr(media_format_cls, "KEY_FRAME_RATE", "frame-rate")
                    if fmt.containsKey(key_fr):
                        try:
                            res["fps"] = round(fmt.getFloat(key_fr))
                        except Exception:
                            try:
                                res["fps"] = fmt.getInteger(key_fr)
                            except Exception:
                                pass
                    if not res["video_codec"]:
                        res["video_codec"] = mime.replace("video/", "")

                    video_br = MediaFormatExtractor._calc_track_bitrate(extractor, i, dur_ms, file_path)
                    if video_br <= 0 and fmt.containsKey(getattr(media_format_cls, "KEY_BIT_RATE", "bitrate")):
                        raw_br = fmt.getInteger(getattr(media_format_cls, "KEY_BIT_RATE", "bitrate"))
                        if raw_br > 0:
                            video_br = raw_br / 1000.0
                    if video_br > 0:
                        res["video_bitrate"] = int(round(video_br))

            extractor.release()
        except Exception:
            pass
        return res

    @staticmethod
    def _calc_track_bitrate(extractor, track_index, dur_ms, file_path=None):
        """Calculates exact track VBR bitrate in Kbps by sampling a frame window."""
        if dur_ms <= 0:
            return 0.0
        try:
            extractor.selectTrack(track_index)
            extractor.seekTo(0, 0)
            t0 = extractor.getSampleTime()
            total_bytes = 0
            count = 0
            max_samples = 300
            while count < max_samples:
                sz = extractor.getSampleSize()
                if sz < 0:
                    break
                total_bytes += sz
                count += 1
                if not extractor.advance():
                    break
            t1 = extractor.getSampleTime()
            extractor.unselectTrack(track_index)

            if count > 0:
                if t1 > t0 and t0 >= 0:
                    win_dur_ms = (t1 - t0) / 1000.0
                    if win_dur_ms > 0:
                        return (total_bytes * 8.0) / win_dur_ms
                if total_bytes > 0 and dur_ms > 0:
                    return (total_bytes * 8.0) / dur_ms
        except Exception:
            pass
        return 0.0


class DetailsConstructorHook(MethodHook):
    """Hook targeting MessageDetailsPopupWrapper constructor."""
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.on_details_popup_created(param)
        except Exception as e:
            self.plugin.log(f"DetailsConstructorHook error: {e}\n{traceback.format_exc()}")


class ExtendedMessageDetailsPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            jclass("com.radolyn.ayugram.database.AyuData")
            self.is_ayugram = True
        except Exception:
            self.is_ayugram = False

        try:
            wrapper_cls = find_class("com.exteragram.messenger.components.MessageDetailsPopupWrapper")
            if wrapper_cls:
                for ct in wrapper_cls.getClass().getDeclaredConstructors():
                    self.hook_method(ct, DetailsConstructorHook(self))
            self.log(f"Extended Message Details plugin loaded successfully (is_ayugram={self.is_ayugram}).")
        except Exception as e:
            self.log(f"Plugin load error: {e}\n{traceback.format_exc()}")

    def on_plugin_unload(self):
        self.log("Extended Message Details plugin unloaded.")

    def on_details_popup_created(self, param):
        wrapper = param.thisObject
        base_fragment = param.args[0]
        popup_swipe_back_layout = param.args[1]
        message_obj = param.args[2]
        resources_provider = param.args[3]

        if not wrapper or not message_obj:
            return

        msg_id = getattr(message_obj, "getId", lambda: 0)()
        self.log(f"Opened message options context menu for message {msg_id}")

        self._attach_details_subitem_long_click(popup_swipe_back_layout, message_obj, wrapper)

        swipe_back = getattr(wrapper, "swipeBack", None)
        if not swipe_back or swipe_back.getChildCount() < 2:
            return

        scroll_view = swipe_back.getChildAt(1)
        if not scroll_view or not hasattr(scroll_view, "getChildAt"):
            return

        container = scroll_view.getChildAt(0)
        if not container or not hasattr(container, "removeAllViews"):
            return

        header_items, dates_items, middle_items, dc_item = self.build_ordered_detail_items(message_obj)

        # Single combined log for performance (avoids UI lag on click)
        all_items = header_items + dates_items + middle_items + ([dc_item] if dc_item else [])
        item_summaries = [f"{it.title}: '{it.subtitle}'" for it in all_items]
        self.log(f"Details popup built for msg {msg_id} ({len(all_items)} items): [{', '.join(item_summaries)}]")

        self.render_container_views(wrapper, container, header_items, dates_items, middle_items, dc_item, base_fragment, popup_swipe_back_layout, resources_provider)

    def _attach_details_subitem_long_click(self, popup_swipe_back_layout, message_obj, wrapper):
        """Attaches long-click listener to the Details subitem in the context menu to copy message JSON."""
        if not popup_swipe_back_layout or not message_obj:
            return
        try:
            subitem = self._find_details_subitem(popup_swipe_back_layout)
            if not subitem:
                return

            self.log("Found Details subitem in context menu; attaching long-click listener.")

            def _handle_long_click(v):
                json_str = self.build_message_json(message_obj)
                try:
                    android_utilities = find_class("org.telegram.messenger.AndroidUtilities")
                    if android_utilities:
                        android_utilities.addToClipboard(str(json_str))
                except Exception as e:
                    self.log(f"Clipboard copy error on long click Details: {e}")

                msg_id = getattr(message_obj, "getId", lambda: 0)()
                self.log(f"User long pressed Details button for msg {msg_id}: copied full JSON metadata ({len(json_str)} chars) to clipboard.")

                if wrapper and hasattr(wrapper, "closeMenu"):
                    try:
                        wrapper.closeMenu()
                    except Exception as e:
                        self.log(f"Error closing menu on long click: {e}")
                elif popup_swipe_back_layout and hasattr(popup_swipe_back_layout, "closeForeground"):
                    try:
                        popup_swipe_back_layout.closeForeground()
                    except Exception as e:
                        self.log(f"Error closing popup swipe back on long click: {e}")
                return True

            try:
                long_click_listener = OnLongClickListener(_handle_long_click)
            except Exception:
                ViewOnLongClickListener = find_class("android.view.View$OnLongClickListener")
                class _DetailsLongClickListener(dynamic_proxy(ViewOnLongClickListener)):
                    def onLongClick(self, v):
                        return _handle_long_click(v)
                long_click_listener = _DetailsLongClickListener()

            subitem.setOnLongClickListener(long_click_listener)
        except Exception as e:
            self.log(f"Error attaching long click to Details subitem: {e}")

    def _find_details_subitem(self, view):
        """Recursively finds the ActionBarMenuSubItem for Details in the context menu."""
        if not view:
            return None
        try:
            cls_name = view.getClass().getSimpleName()
            if "ActionBarMenuSubItem" in cls_name:
                tv = getattr(view, "textView", None)
                if tv and hasattr(tv, "getText"):
                    t_str = str(tv.getText() or "").lower()
                    if "detail" in t_str or "детал" in t_str:
                        return view
        except Exception:
            pass

        if hasattr(view, "getChildCount"):
            try:
                for i in range(view.getChildCount()):
                    res = self._find_details_subitem(view.getChildAt(i))
                    if res:
                        return res
            except Exception:
                pass
        return None

    def build_message_json(self, msg_obj):
        """Builds a complete JSON string containing all message metadata and details."""
        owner = getattr(msg_obj, "messageOwner", None)
        msg_id = getattr(msg_obj, "getId", lambda: 0)()
        dialog_id = msg_obj.getDialogId() if hasattr(msg_obj, "getDialogId") else 0

        header_items, dates_items, middle_items, dc_item = self.build_ordered_detail_items(msg_obj)
        all_items = header_items + dates_items + middle_items + ([dc_item] if dc_item else [])

        details_dict = {}
        for item in all_items:
            if item and item.title:
                details_dict[item.title] = item.subtitle if item.subtitle is not None else (item.real_value or "")

        msg_obj_info = {}
        for method_name in [
            "getId", "getDialogId", "getSenderId", "getDuration", "getSize", 
            "getMimeType", "getRestrictionReason", "isOut", "isOutOwner", 
            "isUnread", "isContentUnread", "isEdited", "isForwarded", 
            "isSecretMedia", "isVoice", "isMusic", "isVideo", "isRoundVideo", 
            "isGif", "isPhoto", "isSticker", "isAnimatedSticker", "isVideoSticker", 
            "isMediaEmpty", "isScheduled", "isSponsored"
        ]:
            if hasattr(msg_obj, method_name):
                try:
                    res = getattr(msg_obj, method_name)()
                    if isinstance(res, (int, float, str, bool, type(None))):
                        msg_obj_info[method_name] = res
                except Exception:
                    pass

        owner_dict = {}
        if owner:
            owner_dict["_class"] = owner.getClass().getSimpleName()
            for field in [
                "id", "date", "edit_date", "dialog_id", "views", "forwards", 
                "ttl_period", "destroyTime", "destroyTimeMillis", "message", 
                "grouped_id", "via_bot_id", "noforwards", "silent", "post", 
                "post_author", "legacy", "mentioned", "media_unread", "pinned", 
                "invert_media", "ayuDeleted", "ayuNoforwards"
            ]:
                if hasattr(owner, field):
                    try:
                        val = getattr(owner, field)
                        if isinstance(val, (int, float, str, bool, type(None))):
                            owner_dict[field] = val
                    except Exception:
                        pass

            for peer_field in ["from_id", "peer_id", "saved_peer_id"]:
                if hasattr(owner, peer_field):
                    p_val = getattr(owner, peer_field)
                    if p_val:
                        owner_dict[peer_field] = str(p_val)

            media = getattr(owner, "media", None)
            if media:
                owner_dict["media_class"] = media.getClass().getSimpleName()
                if hasattr(media, "ttl_seconds"):
                    owner_dict["media_ttl_seconds"] = getattr(media, "ttl_seconds")

            action = getattr(owner, "action", None)
            if action:
                owner_dict["action_class"] = action.getClass().getSimpleName()
                if hasattr(action, "ttl_period"):
                    owner_dict["action_ttl_period"] = getattr(action, "ttl_period")

        full_data = {
            "id": msg_id,
            "dialog_id": dialog_id,
            "ui_details": details_dict,
            "message_object": msg_obj_info,
            "raw_message": owner_dict
        }

        return json.dumps(full_data, ensure_ascii=False, indent=2)

    def _get_delete_date(self, msg_obj, owner):
        """Retrieves deletion timestamp from AyuGram database or Telegram TTL / destroyTime."""
        if getattr(self, "is_ayugram", False):
            try:
                user_config = find_class("org.telegram.messenger.UserConfig")
                account = getattr(user_config, "selectedAccount", 0) if user_config else 0
                user_inst = user_config.getInstance(account) if user_config else None
                client_id = user_inst.getClientUserId() if user_inst else 0
                dialog_id = msg_obj.getDialogId() if hasattr(msg_obj, "getDialogId") else 0
                msg_id = getattr(owner, "id", 0)

                if client_id > 0 and dialog_id != 0 and msg_id > 0:
                    ayu_data = find_class("com.radolyn.ayugram.database.AyuData")
                    if ayu_data:
                        dao = ayu_data.getDeletedMessageDao()
                        if dao:
                            del_full = dao.getMessage(int(client_id), int(dialog_id), int(msg_id))
                            if del_full:
                                d_msg = getattr(del_full, "message", del_full)
                                ts = int(getattr(d_msg, "entityCreateDate", 0))
                                if ts > 0:
                                    return ts
            except Exception as e:
                self.log(f"Error fetching AyuGram deleted date: {e}")

        dt = getattr(owner, "destroyTime", 0)
        if dt > 0:
            return dt
        dt_ms = getattr(owner, "destroyTimeMillis", 0)
        if dt_ms > 0:
            return int(dt_ms // 1000)
        ttl = getattr(owner, "ttl_period", 0)
        if ttl > 0:
            if ttl > 1000000000:
                return ttl
            m_date = getattr(owner, "date", 0)
            if m_date > 0:
                return m_date + ttl

        media = getattr(owner, "media", None)
        if media:
            m_ttl = getattr(media, "ttl_seconds", 0)
            if m_ttl > 0:
                if m_ttl > 1000000000:
                    return m_ttl
                m_date = getattr(owner, "date", 0)
                if m_date > 0:
                    return m_date + m_ttl
        return 0

    def _get_read_date(self, msg_obj, owner):
        """Retrieves read timestamp from AyuSpyController or standard Telegram read_date."""
        if getattr(self, "is_ayugram", False):
            try:
                user_config = find_class("org.telegram.messenger.UserConfig")
                account = getattr(user_config, "selectedAccount", 0) if user_config else 0
                user_inst = user_config.getInstance(account) if user_config else None
                client_id = user_inst.getClientUserId() if user_inst else 0
                dialog_id = msg_obj.getDialogId() if hasattr(msg_obj, "getDialogId") else 0
                msg_id = getattr(owner, "id", 0)

                if dialog_id != 0 and msg_id > 0:
                    r_obj = None

                    try:
                        spy = find_class("com.radolyn.ayugram.controllers.AyuSpyController")
                        if spy:
                            spy_inst = spy.getInstance(account)
                            if spy_inst:
                                r_obj = spy_inst.getMessageRead(int(dialog_id), int(msg_id)) or spy_inst.getMessageContentsRead(int(dialog_id), int(msg_id))
                    except Exception:
                        pass

                    if not r_obj and client_id > 0:
                        try:
                            ayu_data = find_class("com.radolyn.ayugram.database.AyuData")
                            if ayu_data:
                                dao = ayu_data.getSpyDao()
                                if dao:
                                    r_obj = dao.getMessageRead(int(client_id), int(dialog_id), int(msg_id)) or dao.getMessageContentsRead(int(client_id), int(dialog_id), int(msg_id))
                        except Exception:
                            pass

                    if r_obj and hasattr(r_obj, "entityCreateDate"):
                        ts = int(getattr(r_obj, "entityCreateDate", 0))
                        if ts > 0:
                            return ts
            except Exception as e:
                self.log(f"Error fetching AyuGram read date: {e}")

        rd = getattr(owner, "read_date", 0)
        if rd > 0:
            return rd

        return 0

    def build_ordered_detail_items(self, msg_obj):
        owner = getattr(msg_obj, "messageOwner", None)
        if not owner:
            return [], [], [], None

        header_items = []
        dates_items = []
        middle_items = []
        dc_item = None

        # 1. Header Section: Views, Shares
        try:
            views = getattr(owner, "views", 0)
            if views > 0:
                header_items.append(DetailItem(get_loc_string("views"), str(views), "msg_view_file"))
            forwards = getattr(owner, "forwards", 0)
            if forwards > 0:
                header_items.append(DetailItem(get_loc_string("shares"), str(forwards), "msg_forward"))
        except Exception as e:
            self.log(f"Error extracting views/shares: {e}")

        # 2. Dates & ID Section: ID, Sticker Set ID (if present), Date, Delete Date, Read Date, Forwarded Date, Edit Date
        try:
            dates_items.append(DetailItem(get_loc_string("id"), str(owner.id), "msg_info"))

            # Stickerset ID right after ID per user request
            doc = msg_obj.getDocument() if hasattr(msg_obj, "getDocument") else None
            stickerset_id = 0
            if doc:
                attrs = to_python_list(getattr(doc, "attributes", None))
                for attr in attrs:
                    if not attr:
                        continue
                    try:
                        cls_name = attr.getClass().getSimpleName()
                        if "documentAttributeSticker" in cls_name or "documentAttributeCustomEmoji" in cls_name:
                            if hasattr(attr, "stickerset") and attr.stickerset:
                                st_set = attr.stickerset
                                stickerset_id = getattr(st_set, "id", 0)
                                if stickerset_id <= 0:
                                    try:
                                        user_config = find_class("org.telegram.messenger.UserConfig")
                                        account = getattr(user_config, "selectedAccount", 0) if user_config else 0
                                        mdc = find_class("org.telegram.messenger.MediaDataController")
                                        if mdc:
                                            s_obj = mdc.getInstance(account).getStickerSet(st_set, 0, False)
                                            if s_obj and hasattr(s_obj, "set") and s_obj.set:
                                                stickerset_id = int(getattr(s_obj.set, "id", 0))
                                    except Exception:
                                        pass
                                if stickerset_id > 0:
                                    break
                    except Exception:
                        pass

            if stickerset_id > 0:
                dates_items.append(DetailItem(get_loc_string("stickerset_id"), str(stickerset_id), "msg_sticker"))

            if owner.date > 0:
                dates_items.append(DetailItem(get_loc_string("date"), format_time_exteragram(owner.date), "msg_calendar2"))

            del_ts = self._get_delete_date(msg_obj, owner)
            if del_ts > 0:
                dates_items.append(DetailItem(get_loc_string("delete_date"), format_time_exteragram(del_ts), "msg_delete"))

            read_ts = self._get_read_date(msg_obj, owner)
            if read_ts > 0:
                dates_items.append(DetailItem(get_loc_string("read_date"), format_time_exteragram(read_ts), "msg_seen"))

            fwd_header = getattr(owner, "fwd_from", None)
            if fwd_header and getattr(fwd_header, "date", 0) > 0 and fwd_header.date != owner.date:
                dates_items.append(DetailItem(get_loc_string("fwd_date"), format_time_exteragram(fwd_header.date), "msg_recent"))

            edit_date = getattr(owner, "edit_date", 0)
            if edit_date > 0 and edit_date != owner.date and not getattr(owner, "edit_hide", False):
                dates_items.append(DetailItem(get_loc_string("edited_date"), format_time_exteragram(edit_date), "msg_edit"))
        except Exception as e:
            self.log(f"Error extracting dates section: {e}")

        # 3. Middle Section: Evaluated per message type (Starts with File Size under divider)
        try:
            doc_size = msg_obj.getSize() if hasattr(msg_obj, "getSize") else 0
            if doc_size > 0:
                try:
                    android_utilities = find_class("org.telegram.messenger.AndroidUtilities")
                    fs_str = str(android_utilities.formatFileSize(doc_size))
                except Exception:
                    fs_str = f"{doc_size} B"
                middle_items.append(DetailItem(get_loc_string("file_size"), fs_str, "msg_sendfile"))

            chat_utils = find_class("com.exteragram.messenger.utils.chats.ChatUtils")
            file_path = None
            if chat_utils:
                try:
                    inst = chat_utils.getInstance()
                    file_path = inst.getPathToMessage(msg_obj)
                except Exception:
                    pass

            doc = msg_obj.getDocument() if hasattr(msg_obj, "getDocument") else None
            photo = msg_obj.getPhoto() if hasattr(msg_obj, "getPhoto") else None
            media = getattr(owner, "media", None)
            action = getattr(owner, "action", None)

            if msg_obj.isVoice() or msg_obj.isMusic():
                self._extract_audio_middle_items(middle_items, msg_obj, owner, doc, file_path)
            elif msg_obj.isVideo() or msg_obj.isRoundVideo() or msg_obj.isGif():
                self._extract_video_middle_items(middle_items, msg_obj, owner, doc, file_path)
            elif msg_obj.isSticker() or (doc and self._has_sticker_attr(doc)):
                self._extract_sticker_middle_items(middle_items, msg_obj, owner, doc, file_path)
            elif msg_obj.isPhoto() or photo or self._is_photo_as_doc(doc):
                self._extract_photo_middle_items(middle_items, msg_obj, owner, photo, doc, file_path)
            elif media and "TL_messageMediaPoll" in media.getClass().getSimpleName():
                self._extract_poll_middle_items(middle_items, media)
            elif action:
                self._extract_service_middle_items(middle_items, action)
            else:
                mime = msg_obj.getMimeType() if hasattr(msg_obj, "getMimeType") else None
                if mime:
                    middle_items.append(DetailItem(get_loc_string("mime_type"), str(mime), "msg_media"))
                if file_path:
                    middle_items.append(DetailItem(get_loc_string("file_path"), get_loc_string("open"), "msg_map", item_id=1, real_value=str(file_path), mime_type=mime))
        except Exception as e:
            self.log(f"Error extracting middle items section: {e}")

        # 4. Bottom Section: Datacenter (ALWAYS AT THE VERY BOTTOM)
        try:
            dc_id = self._extract_datacenter_id(owner)
            if dc_id > 0:
                dc_name = ""
                if chat_utils:
                    try:
                        dc_name = str(chat_utils.getDCName(dc_id))
                    except Exception:
                        pass
                subtitle = f"DC{dc_id}, {dc_name}" if dc_name else f"DC{dc_id}"
                dc_item = DetailItem(get_loc_string("datacenter"), subtitle, "msg_satellite")
        except Exception as e:
            self.log(f"Error extracting datacenter: {e}")

        return header_items, dates_items, middle_items, dc_item

    def _get_exteragram_bitrate(self, msg_obj, file_path):
        """Calculates VBR bitrate with sample size summation / size-duration fallback."""
        if file_path:
            try:
                mf = MediaFormatExtractor.extract(file_path)
                br = mf.get("video_bitrate") or mf.get("audio_bitrate")
                if br and br > 0:
                    return int(round(float(br)))
            except Exception:
                pass

        try:
            msg_size = msg_obj.getSize() if hasattr(msg_obj, "getSize") else 0
            dur = float(msg_obj.getDuration()) if hasattr(msg_obj, "getDuration") else 0.0
            if msg_size > 0 and dur > 0:
                br_val = int(round(((msg_size / dur) * 8.0) / 1000.0))
                if br_val > 0:
                    return br_val
        except Exception:
            pass

        return 0

    def _extract_audio_middle_items(self, items, msg_obj, owner, doc, file_path):
        is_voice = msg_obj.isVoice()
        items.append(DetailItem(get_loc_string("audio_type"), get_loc_string("voice_note") if is_voice else get_loc_string("music_track"), "msg_tone_on"))

        mime = msg_obj.getMimeType()
        if mime:
            items.append(DetailItem(get_loc_string("mime_type"), str(mime), "msg_media"))

        if file_path:
            items.append(DetailItem(get_loc_string("file_path"), get_loc_string("open"), "msg_map", item_id=1, real_value=str(file_path), mime_type=mime))

        attr_title = ""
        attr_performer = ""
        waveform = None
        attrs = to_python_list(getattr(doc, "attributes", None)) if doc else []
        for attr in attrs:
            if not attr:
                continue
            try:
                cls_name = attr.getClass().getSimpleName()
                if "documentAttributeAudio" in cls_name or "DocumentAttributeAudio" in cls_name:
                    attr_title = getattr(attr, "title", "") or ""
                    attr_performer = getattr(attr, "performer", "") or ""
                    waveform = getattr(attr, "waveform", None)
                    break
            except Exception:
                pass

        doc_size = getattr(doc, "size", 0) if doc else (msg_obj.getSize() if hasattr(msg_obj, "getSize") else 0)
        if file_path and doc_size <= 0:
            try:
                if os.path.exists(str(file_path)):
                    doc_size = os.path.getsize(str(file_path))
            except Exception:
                pass

        duration = int(msg_obj.getDuration()) if hasattr(msg_obj, "getDuration") else 0

        audio_meta = MutagenExtractor.extract_audio_metadata(file_path, attr_title, attr_performer, doc_size, duration)
        mf_meta = MediaFormatExtractor.extract(file_path, duration)

        if audio_meta.get("artist"):
            items.append(DetailItem(get_loc_string("artists"), audio_meta["artist"], "msg_contacts"))
        if audio_meta.get("title"):
            items.append(DetailItem(get_loc_string("track_title"), audio_meta["title"], "msg_contacts_name"))

        if duration > 0:
            items.append(DetailItem(get_loc_string("duration"), format_short_duration(duration), "msg2_animations"))

        bitrate = 0
        if doc_size > 0 and duration > 0:
            bitrate = int(round(((doc_size * 8.0) / duration) / 1000.0))
        if bitrate <= 0:
            bitrate = audio_meta.get("bitrate") or mf_meta.get("audio_bitrate") or self._get_exteragram_bitrate(msg_obj, file_path)

        if bitrate and bitrate > 0:
            items.append(DetailItem(get_loc_string("bitrate"), f"{int(round(bitrate))} Kbps", "msg_noise_on"))

        sr = audio_meta.get("sample_rate") or mf_meta.get("sample_rate")
        if sr and sr > 0:
            sr_str = f"{sr // 1000} kHz" if sr % 1000 == 0 else f"{sr / 1000:.1f} kHz"
            items.append(DetailItem(get_loc_string("sample_rate"), sr_str, "msg_photo_curve"))

        if audio_meta.get("bit_depth"):
            items.append(DetailItem(get_loc_string("bit_depth"), f"{audio_meta['bit_depth']} bit", "msg_customize"))

        comp_mode = "Lossless" if (mime and any(x in str(mime).lower() for x in ("flac", "wav", "alac", "ape", "pcm", "aiff"))) else "Lossy"
        items.append(DetailItem(get_loc_string("compression_mode"), comp_mode, "msg_archive"))

        stream_sz = doc_size
        if file_path:
            try:
                if os.path.exists(str(file_path)):
                    stream_sz = os.path.getsize(str(file_path))
            except Exception:
                pass
        if stream_sz > 0:
            total_file_size = getattr(doc, "size", 0) if doc else (msg_obj.getSize() if hasattr(msg_obj, "getSize") else stream_sz)
            try:
                android_utilities = find_class("org.telegram.messenger.AndroidUtilities")
                sz_str = str(android_utilities.formatFileSize(stream_sz))
            except Exception:
                sz_str = f"{stream_sz} B"
            if total_file_size > 0:
                percent = int(round((stream_sz * 100.0) / total_file_size))
                sz_str += f" ({percent}%)"
            items.append(DetailItem(get_loc_string("stream_size"), sz_str, "msg_filehq"))

        ch = audio_meta.get("channels") or mf_meta.get("channels")
        if ch and ch > 0:
            ch_str = get_loc_string("mono") if ch == 1 else (get_loc_string("stereo") if ch == 2 else f"{ch} ch")
            items.append(DetailItem(get_loc_string("channels"), ch_str, "msg_call_speaker"))

        if waveform is not None:
            items.append(DetailItem(get_loc_string("waveform_len"), str(len(waveform)), "filled_chatlist_poll"))

    def _extract_video_middle_items(self, items, msg_obj, owner, doc, file_path):
        if msg_obj.isRoundVideo():
            vtype = get_loc_string("video_round")
        elif msg_obj.isGif():
            vtype = get_loc_string("video_gif")
        else:
            vtype = get_loc_string("video_standard")
        items.append(DetailItem(get_loc_string("video_type"), vtype, "msg_video"))

        mime = msg_obj.getMimeType()
        if mime:
            items.append(DetailItem(get_loc_string("mime_type"), str(mime), "msg_media"))

        if file_path:
            items.append(DetailItem(get_loc_string("file_path"), get_loc_string("open"), "msg_map", item_id=1, real_value=str(file_path), mime_type=mime))

        self._extract_photo_video_details(items, msg_obj, None, doc, file_path)

        attr_video = None
        attrs = to_python_list(getattr(doc, "attributes", None)) if doc else []
        for attr in attrs:
            if not attr:
                continue
            try:
                cls_name = attr.getClass().getSimpleName()
                if "documentAttributeVideo" in cls_name or "DocumentAttributeVideo" in cls_name:
                    attr_video = attr
                    break
            except Exception:
                pass

        duration = int(msg_obj.getDuration()) if hasattr(msg_obj, "getDuration") else 0
        if duration > 0:
            items.append(DetailItem(get_loc_string("duration"), format_short_duration(duration), "msg2_animations"))

        mf_meta = MediaFormatExtractor.extract(file_path, duration)

        doc_size = getattr(doc, "size", 0) if doc else (msg_obj.getSize() if hasattr(msg_obj, "getSize") else 0)
        if file_path and doc_size <= 0:
            try:
                if os.path.exists(str(file_path)):
                    doc_size = os.path.getsize(str(file_path))
            except Exception:
                pass

        total_br = 0
        if doc_size > 0 and duration > 0:
            total_br = int(round(((doc_size * 8.0) / duration) / 1000.0))
        if total_br <= 0:
            total_br = self._get_exteragram_bitrate(msg_obj, file_path)

        audio_br = mf_meta.get("audio_bitrate") or 0

        if audio_br > 0 and total_br > audio_br:
            video_br = total_br - audio_br
        else:
            video_br = mf_meta.get("video_bitrate") or total_br

        if video_br and video_br > 0:
            items.append(DetailItem(get_loc_string("bitrate"), f"{int(round(video_br))} Kbps", "msg_noise_on"))

        if audio_br and audio_br > 0:
            items.append(DetailItem(get_loc_string("audio_bitrate"), f"{int(round(audio_br))} Kbps", "msg_tone_on"))

        if mf_meta.get("fps"):
            items.append(DetailItem(get_loc_string("fps"), f"{mf_meta['fps']} FPS", "msg_stats"))

        codec = getattr(attr_video, "video_codec", "") or mf_meta.get("video_codec")
        if codec:
            items.append(DetailItem(get_loc_string("video_codec"), str(codec), "msg_video"))

        if mf_meta.get("channels"):
            ch = mf_meta["channels"]
            ch_str = get_loc_string("mono") if ch == 1 else (get_loc_string("stereo") if ch == 2 else f"{ch} ch")
            items.append(DetailItem(get_loc_string("channels"), ch_str, "msg_call_speaker"))

        if attr_video and getattr(attr_video, "supports_streaming", False):
            items.append(DetailItem(get_loc_string("supports_streaming"), get_loc_string("yes"), "msg_media"))

    def _extract_photo_middle_items(self, items, msg_obj, owner, photo, doc, file_path):
        mime = msg_obj.getMimeType() if hasattr(msg_obj, "getMimeType") else None
        if mime:
            items.append(DetailItem(get_loc_string("mime_type"), str(mime), "msg_media"))

        if file_path:
            items.append(DetailItem(get_loc_string("file_path"), get_loc_string("open"), "msg_map", item_id=1, real_value=str(file_path), mime_type=mime))

        self._extract_photo_video_details(items, msg_obj, photo, doc, file_path)

    def _extract_photo_video_details(self, items, msg_obj, photo, doc, file_path):
        # Platform (for photo or photo as doc if file_path exists)
        if file_path and (photo or (doc and self._is_photo_as_doc(doc))):
            try:
                media_utils = find_class("com.exteragram.messenger.utils.MediaUtils")
                if media_utils:
                    platform = str(media_utils.getPhotoPlatform(str(file_path)) or "")
                    if platform:
                        items.append(DetailItem(get_loc_string("platform"), platform, "menu_devices"))
            except Exception as e:
                self.log(f"Error extracting photo platform: {e}")

        # Resolution (for photo, video, gif, or photo as doc)
        res_str = self._get_media_resolution(msg_obj, photo, doc, file_path)
        if res_str:
            items.append(DetailItem(get_loc_string("resolution"), res_str, "msg_photo_crop"))

    def _is_photo_as_doc(self, doc):
        if not doc:
            return False
        attrs = to_python_list(getattr(doc, "attributes", None))
        for attr in attrs:
            if not attr:
                continue
            try:
                name = attr.getClass().getSimpleName()
                if "documentAttributeImageSize" in name:
                    return True
            except Exception:
                pass
        return False

    def _get_media_resolution(self, msg_obj, photo, doc, file_path):
        w, h = 0, 0
        if doc:
            attrs = to_python_list(getattr(doc, "attributes", None))
            for attr in attrs:
                if not attr:
                    continue
                try:
                    name = attr.getClass().getSimpleName()
                    if "documentAttributeImageSize" in name or "documentAttributeVideo" in name:
                        w = getattr(attr, "w", 0)
                        h = getattr(attr, "h", 0)
                        if w > 0 and h > 0:
                            return f"{w}x{h}"
                except Exception:
                    pass
        if photo and hasattr(photo, "sizes"):
            sizes = to_python_list(photo.sizes)
            for s in sizes:
                sw = getattr(s, "w", 0)
                sh = getattr(s, "h", 0)
                if sw > w and sh > h:
                    w, h = sw, sh
            if w > 0 and h > 0:
                return f"{w}x{h}"

        if file_path:
            try:
                bmp_opts = find_class("android.graphics.BitmapFactory$Options")()
                bmp_opts.inJustDecodeBounds = True
                bmp_factory = find_class("android.graphics.BitmapFactory")
                bmp_factory.decodeFile(str(file_path), bmp_opts)
                if bmp_opts.outWidth > 0 and bmp_opts.outHeight > 0:
                    return f"{bmp_opts.outWidth}x{bmp_opts.outHeight}"
            except Exception:
                pass
        return None

    def _extract_sticker_middle_items(self, items, msg_obj, owner, doc, file_path):
        is_tgs = False
        is_video_stk = False
        is_custom_emoji = False
        alt_emoji = ""
        stickerset = None
        filename = ""

        attrs = to_python_list(getattr(doc, "attributes", None)) if doc else []
        for attr in attrs:
            if not attr:
                continue
            try:
                cls_name = attr.getClass().getSimpleName()
                if "documentAttributeFilename" in cls_name:
                    filename = getattr(attr, "file_name", "") or ""
                elif "documentAttributeSticker" in cls_name:
                    alt_emoji = getattr(attr, "alt", "") or ""
                    if hasattr(attr, "stickerset") and attr.stickerset:
                        stickerset = attr.stickerset
                elif "documentAttributeCustomEmoji" in cls_name:
                    is_custom_emoji = True
                    alt_emoji = getattr(attr, "alt", "") or ""
                    if hasattr(attr, "stickerset") and attr.stickerset:
                        stickerset = attr.stickerset
                elif "documentAttributeVideo" in cls_name:
                    is_video_stk = True
            except Exception:
                pass

        mime = msg_obj.getMimeType() or (getattr(doc, "mime_type", "") if doc else "")
        if mime and "tgs" in mime.lower():
            is_tgs = True

        if is_custom_emoji:
            stk_type = get_loc_string("custom_emoji")
        elif is_video_stk:
            stk_type = get_loc_string("sticker_video")
        elif is_tgs:
            stk_type = get_loc_string("sticker_animated")
        else:
            stk_type = get_loc_string("sticker_static")

        items.append(DetailItem(get_loc_string("video_type"), stk_type, "msg_sticker"))

        if mime:
            items.append(DetailItem(get_loc_string("mime_type"), str(mime), "msg_media"))
        if filename:
            items.append(DetailItem(get_loc_string("file_name"), str(filename), "msg_log"))
        if file_path:
            items.append(DetailItem(get_loc_string("file_path"), get_loc_string("open"), "msg_map", item_id=1, real_value=str(file_path), mime_type=mime))

        # Owner and Sticker Pack (short_name/index) right after file_path
        set_id = getattr(stickerset, "id", 0) if stickerset else 0
        short_name = getattr(stickerset, "short_name", "") or "" if stickerset else ""
        sticker_index = -1

        if stickerset:
            try:
                user_config = find_class("org.telegram.messenger.UserConfig")
                account = getattr(user_config, "selectedAccount", 0) if user_config else 0
                mdc = find_class("org.telegram.messenger.MediaDataController")
                if mdc:
                    s_obj = mdc.getInstance(account).getStickerSet(stickerset, 0, False)
                    if s_obj:
                        if hasattr(s_obj, "set") and s_obj.set:
                            if not short_name and hasattr(s_obj.set, "short_name"):
                                short_name = str(s_obj.set.short_name or "")
                            if set_id <= 0 and hasattr(s_obj.set, "id"):
                                set_id = int(getattr(s_obj.set, "id", 0))

                        # 0-indexed position of this sticker inside the pack
                        if doc and hasattr(s_obj, "documents"):
                            doc_list = to_python_list(s_obj.documents)
                            doc_id = getattr(doc, "id", 0)
                            if doc_id > 0:
                                for idx, d in enumerate(doc_list):
                                    if d and getattr(d, "id", 0) == doc_id:
                                        sticker_index = idx
                                        break
            except Exception as e:
                self.log(f"Error resolving sticker set info: {e}")

        chat_utils = find_class("com.exteragram.messenger.utils.chats.ChatUtils")
        owner_id = 0

        if chat_utils and set_id > 0:
            try:
                owner_id = chat_utils.extractOwnerId(set_id)
                if owner_id > 0:
                    owner_item = DetailItem(get_loc_string("stickerpack_owner"), str(owner_id), "msg_contacts_name", item_id=0, owner_id=owner_id)
                    items.append(owner_item)
            except Exception as e:
                self.log(f"Error extracting owner ID: {e}")

        if short_name or sticker_index >= 0 or set_id > 0 or stickerset:
            if short_name and sticker_index >= 0:
                pack_val = f"{short_name}/{sticker_index}"
            elif short_name:
                pack_val = str(short_name)
            elif sticker_index >= 0:
                pack_val = str(sticker_index)
            else:
                pack_val = str(set_id)
            items.append(DetailItem(get_loc_string("sticker_pack"), pack_val, "msg_sticker", input_sticker_set=stickerset, doc=doc))

        if alt_emoji:
            items.append(DetailItem(get_loc_string("associated_emoji"), str(alt_emoji), "msg_emoji_smiles"))

        if is_custom_emoji:
            for attr in attrs:
                if not attr:
                    continue
                try:
                    if "documentAttributeCustomEmoji" in attr.getClass().getSimpleName():
                        if getattr(attr, "text_color", False):
                            items.append(DetailItem(get_loc_string("adapt_text_color"), get_loc_string("yes"), "msg_palette"))
                        break
                except Exception:
                    pass

        # Extra sticker / emoji metadata (resolution, duration, bitrate, FPS, video codec, streaming)
        res_str = self._get_media_resolution(msg_obj, None, doc, file_path)
        if res_str:
            items.append(DetailItem(get_loc_string("resolution"), res_str, "msg_photo_crop"))

        duration = int(msg_obj.getDuration()) if hasattr(msg_obj, "getDuration") else 0
        if duration > 0:
            items.append(DetailItem(get_loc_string("duration"), format_short_duration(duration), "msg2_animations"))

        container_br = self._get_exteragram_bitrate(msg_obj, file_path)
        if container_br and container_br > 0:
            items.append(DetailItem(get_loc_string("bitrate"), f"{int(round(container_br))} Kbps", "msg_noise_on"))

        mf_meta = MediaFormatExtractor.extract(file_path) if file_path else {}
        if mf_meta.get("fps"):
            items.append(DetailItem(get_loc_string("fps"), f"{mf_meta['fps']} FPS", "msg_stats"))

        codec = mf_meta.get("video_codec")
        if codec:
            items.append(DetailItem(get_loc_string("video_codec"), str(codec), "msg_video"))

        for attr in attrs:
            if not attr:
                continue
            try:
                if "documentAttributeVideo" in attr.getClass().getSimpleName():
                    if getattr(attr, "supports_streaming", False):
                        items.append(DetailItem(get_loc_string("supports_streaming"), get_loc_string("yes"), "msg_media"))
                    break
            except Exception:
                pass

    def _extract_poll_middle_items(self, items, media):
        poll = getattr(media, "poll", None)
        results = getattr(media, "results", None)
        if not poll:
            return

        question = getattr(poll, "question", "")
        if hasattr(question, "text"):
            question = question.text
        if question:
            items.append(DetailItem(get_loc_string("poll_question"), str(question), "msg_emoji_question"))

        desc = getattr(poll, "solution", "") or getattr(poll, "description", "")
        if desc:
            items.append(DetailItem(get_loc_string("poll_description"), str(desc), "msg_log"))

        # Voter names / Show Who Voted
        items.append(DetailItem(get_loc_string("voter_names"), get_loc_string("yes") if getattr(poll, "public_voters", False) else get_loc_string("no"), "msg_view_file"))

        # Multiple Choice
        items.append(DetailItem(get_loc_string("multiple_choice"), get_loc_string("yes") if getattr(poll, "multiple_choice", False) else get_loc_string("no"), "msg_select"))

        # Add Options
        items.append(DetailItem(get_loc_string("add_options"), get_loc_string("yes") if getattr(poll, "open_answers", False) else get_loc_string("no"), "msg_addbot"))

        # Allow Revoting
        revoting_disabled = getattr(poll, "revoting_disabled", False)
        items.append(DetailItem(get_loc_string("allow_revoting"), get_loc_string("no") if revoting_disabled else get_loc_string("yes"), "msg_replace"))

        # Shuffle Options
        items.append(DetailItem(get_loc_string("shuffle_options"), get_loc_string("yes") if getattr(poll, "shuffle_answers", False) else get_loc_string("no"), "msg_forward_replace"))

        # Quiz Mode
        items.append(DetailItem(get_loc_string("quiz_mode"), get_loc_string("yes") if getattr(poll, "quiz", False) else get_loc_string("no"), "floating_check"))

        # Duration Limit
        close_period = getattr(poll, "close_period", 0)
        if close_period > 0:
            items.append(DetailItem(get_loc_string("duration_limit"), format_short_duration(close_period), "msg_stories_timer"))

        # Auto-Close Date
        close_date = getattr(poll, "close_date", 0)
        if close_date > 0:
            items.append(DetailItem(get_loc_string("auto_close_date"), format_time_exteragram(close_date), "msg_autodelete"))

        # Hide Results
        if getattr(poll, "hide_results_until_close", False):
            items.append(DetailItem(get_loc_string("hide_results"), get_loc_string("yes"), "msg_stories_stealth"))

        # Poll Status
        status_str = get_loc_string("poll_closed") if getattr(poll, "closed", False) else get_loc_string("poll_open")
        items.append(DetailItem(get_loc_string("poll_status"), status_str, "filled_chatlist_poll"))

        # Total Voters
        if results and hasattr(results, "total_voters"):
            items.append(DetailItem(get_loc_string("total_voters"), str(results.total_voters), "msg_stats"))

    def _extract_service_middle_items(self, items, action):
        action_name = action.getClass().getSimpleName()
        items.append(DetailItem(get_loc_string("service_action"), str(action_name), "msg_settings"))

        title = getattr(action, "title", None)
        if title:
            items.append(DetailItem(get_loc_string("new_chat_title"), str(title), "msg_edit"))

        users = getattr(action, "users", None) or getattr(action, "user_id", None)
        if users:
            user_list = to_python_list(users)
            if user_list:
                user_str = ", ".join(str(u) for u in user_list)
                items.append(DetailItem(get_loc_string("target_users"), user_str, "msg_groups"))
            elif isinstance(users, (int, float, str)) and str(users).strip():
                items.append(DetailItem(get_loc_string("target_users"), str(users).strip(), "msg_groups"))

    def _extract_datacenter_id(self, owner):
        media = getattr(owner, "media", None)
        if not media:
            return 0
        photo = getattr(media, "photo", None)
        if photo and getattr(photo, "dc_id", 0) > 0:
            return photo.dc_id
        doc = getattr(media, "document", None)
        if doc and getattr(doc, "dc_id", 0) > 0:
            return doc.dc_id
        webpage = getattr(media, "webpage", None)
        if webpage:
            wphoto = getattr(webpage, "photo", None)
            if wphoto and getattr(wphoto, "dc_id", 0) > 0:
                return wphoto.dc_id
            wdoc = getattr(webpage, "document", None)
            if wdoc and getattr(wdoc, "dc_id", 0) > 0:
                return wdoc.dc_id
        return 0

    def _has_sticker_attr(self, doc):
        if not doc:
            return False
        attrs = to_python_list(getattr(doc, "attributes", None))
        for attr in attrs:
            if not attr:
                continue
            try:
                name = attr.getClass().getSimpleName()
                if "Sticker" in name or "CustomEmoji" in name:
                    return True
            except Exception:
                pass
        return False

    def render_container_views(self, wrapper, container, header_items, dates_items, middle_items, dc_item, base_fragment, popup_swipe_back_layout, resources_provider):
        container.removeAllViews()
        context = base_fragment.getParentActivity()

        # Add top section gap
        container.addView(self._create_gap(context, resources_provider), self._create_linear_params(-1, 8))

        # 1. Header items (Views, Shares)
        if header_items:
            for item in header_items:
                self._add_item_view(wrapper, container, item, base_fragment, popup_swipe_back_layout, resources_provider)
            container.addView(self._create_gap(context, resources_provider), self._create_linear_params(-1, 8))

        # 2. Dates & ID items
        if dates_items:
            for item in dates_items:
                self._add_item_view(wrapper, container, item, base_fragment, popup_swipe_back_layout, resources_provider)
            # Gap / divider after ID & dates section (before middle items like File Size)
            if middle_items or dc_item:
                container.addView(self._create_gap(context, resources_provider), self._create_linear_params(-1, 8))

        # 3. Middle items (Media details, starts with File Size)
        if middle_items:
            for item in middle_items:
                self._add_item_view(wrapper, container, item, base_fragment, popup_swipe_back_layout, resources_provider)

        # 4. Datacenter item (ALWAYS AT THE VERY BOTTOM)
        if dc_item:
            self._add_item_view(wrapper, container, dc_item, base_fragment, popup_swipe_back_layout, resources_provider)

    def _add_item_view(self, wrapper, container, item, base_fragment, popup_swipe_back_layout, resources_provider):
        context = base_fragment.getParentActivity()
        if not hasattr(self, "_sub_item_cls"):
            self._sub_item_cls = find_class("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
            self._android_utilities = find_class("org.telegram.messenger.AndroidUtilities")
            try:
                tu = find_class("android.text.TextUtils$TruncateAt")
                self._truncate_marquee = getattr(tu, "MARQUEE", None)
            except Exception:
                self._truncate_marquee = None

        item_view = self._sub_item_cls(context, False, False, resources_provider)
        icon_id = get_drawable_id(item.icon_name)
        item_view.setTextAndIcon(item.title, icon_id)

        if self._android_utilities:
            item_view.setMinimumWidth(self._android_utilities.dp(196.0))

        if item.subtitle:
            item_view.setSubtext(str(item.subtitle))
            tv = item_view.subtextView
            if tv:
                try:
                    if self._truncate_marquee:
                        tv.setEllipsize(self._truncate_marquee)
                    tv.setMarqueeRepeatLimit(-1)
                    tv.setSelected(True)
                except Exception:
                    pass
            item_view.setItemHeight(56)
            height = 56
        else:
            height = 48

        # Owner info resolution asynchronously if item_id == 0
        if item.item_id == 0 and item.owner_id > 0:
            self._fetch_owner_info(item.owner_id, item, item_view)

        # Sticker set info resolution asynchronously if input_sticker_set is present
        if item.input_sticker_set:
            self._fetch_sticker_set_async(item.input_sticker_set, item.doc, item, item_view)

        def _handle_long_click(v):
            self._on_item_clicked(wrapper, item, base_fragment, popup_swipe_back_layout, close=False)
            return True

        click_listener = OnClickListener(lambda v: self._on_item_clicked(wrapper, item, base_fragment, popup_swipe_back_layout, close=True))
        try:
            long_click_listener = OnLongClickListener(_handle_long_click)
        except Exception:
            ViewOnLongClickListener = find_class("android.view.View$OnLongClickListener")
            class _LongClickListener(dynamic_proxy(ViewOnLongClickListener)):
                def onLongClick(self, v):
                    return _handle_long_click(v)
            long_click_listener = _LongClickListener()

        item_view.setOnClickListener(click_listener)
        item_view.setOnLongClickListener(long_click_listener)

        container.addView(item_view, self._create_linear_params(-1, height))

    def _fetch_owner_info(self, owner_id, item, item_view):
        try:
            user_config = find_class("org.telegram.messenger.UserConfig")
            account = getattr(user_config, "selectedAccount", 0) if user_config else 0
            mc = find_class("org.telegram.messenger.MessagesController")
            user_obj_cls = find_class("org.telegram.messenger.UserObject")
            contacts_cls = find_class("org.telegram.messenger.ContactsController")

            if mc:
                cached_user = mc.getInstance(account).getUser(int(owner_id))
                if cached_user:
                    pub_name = str(user_obj_cls.getPublicUsername(cached_user) or "") if user_obj_cls else ""
                    if pub_name:
                        item.subtitle = f"@{pub_name}"
                        item.real_value = f"@{pub_name}"
                    elif contacts_cls:
                        fname = str(contacts_cls.formatName(cached_user) or "")
                        if fname:
                            item.subtitle = fname
                    try:
                        item_view.setSubtext(str(item.subtitle))
                    except Exception:
                        pass

            chat_utils_cls = find_class("com.exteragram.messenger.utils.chats.ChatUtils")
            if not chat_utils_cls:
                return
            cb_cls = find_class("org.telegram.messenger.Utilities$Callback")

            class _UserCallback(dynamic_proxy(cb_cls)):
                def run(self, user):
                    if user:
                        pub_name = ""
                        if user_obj_cls:
                            pub_name = str(user_obj_cls.getPublicUsername(user) or "")
                        if pub_name:
                            item.subtitle = f"@{pub_name}"
                            item.real_value = f"@{pub_name}"
                        elif contacts_cls:
                            fname = str(contacts_cls.formatName(user) or "")
                            if fname:
                                item.subtitle = fname
                                item.real_value = str(owner_id)

                        def _ui_update():
                            try:
                                item_view.setSubtext(str(item.subtitle))
                            except Exception:
                                pass
                        run_on_ui_thread(_ui_update)

            chat_utils_cls.getInstance().searchUserById(int(owner_id), _UserCallback())
            self.log(f"Dispatched searchUserById query for owner user_id {owner_id}")
        except Exception as e:
            self.log(f"Error searching user by ID {owner_id}: {e}")

    def _fetch_sticker_set_async(self, input_sticker_set, doc, item, item_view):
        if not input_sticker_set:
            return
        try:
            user_config = find_class("org.telegram.messenger.UserConfig")
            account = getattr(user_config, "selectedAccount", 0) if user_config else 0
            mdc = find_class("org.telegram.messenger.MediaDataController")
            if not mdc:
                return

            cb_cls = find_class("org.telegram.messenger.Utilities$Callback")

            class _StickerSetCallback(dynamic_proxy(cb_cls)):
                def run(self, set_obj):
                    if set_obj and hasattr(set_obj, "set") and set_obj.set:
                        short_name = str(getattr(set_obj.set, "short_name", "") or "")
                        index = -1
                        if doc and hasattr(set_obj, "documents"):
                            doc_list = to_python_list(set_obj.documents)
                            doc_id = getattr(doc, "id", 0)
                            if doc_id > 0:
                                for idx, d in enumerate(doc_list):
                                    if d and getattr(d, "id", 0) == doc_id:
                                        index = idx
                                        break

                        if short_name and index >= 0:
                            pack_str = f"{short_name}/{index}"
                        elif short_name:
                            pack_str = short_name
                        elif index >= 0:
                            pack_str = str(index)
                        else:
                            pack_str = str(getattr(set_obj.set, "id", ""))

                        def _ui_update():
                            try:
                                item.subtitle = pack_str
                                item.real_value = pack_str
                                item_view.setSubtext(pack_str)
                            except Exception:
                                pass
                        run_on_ui_thread(_ui_update)

            mdc.getInstance(account).getStickerSet(input_sticker_set, None, False, _StickerSetCallback())
        except Exception as e:
            self.log(f"Error fetching sticker set async: {e}")

    def _on_item_clicked(self, wrapper, item, base_fragment, popup_swipe_back_layout, close=True):
        val = item.real_value if item.real_value else (item.subtitle if item.subtitle else item.title)

        if close:
            if item.item_id == 1 and item.real_value:
                self.log(f"User clicked detail item '{item.title}': launching file '{item.real_value}'")
                if wrapper and hasattr(wrapper, "closeMenu"):
                    try:
                        wrapper.closeMenu()
                    except Exception as e:
                        self.log(f"Error closing menu: {e}")
                if popup_swipe_back_layout:
                    try:
                        popup_swipe_back_layout.closeForeground()
                    except Exception:
                        pass
                activity = base_fragment.getParentActivity()
                self._open_file(activity, item.real_value, item.mime_type)
                return

            if item.item_id == 0 and item.owner_id > 0:
                self.log(f"User clicked detail item '{item.title}': opening profile for user {item.owner_id}")
                if wrapper and hasattr(wrapper, "closeMenu"):
                    try:
                        wrapper.closeMenu()
                    except Exception as e:
                        self.log(f"Error closing menu: {e}")
                if popup_swipe_back_layout:
                    try:
                        popup_swipe_back_layout.closeForeground()
                    except Exception:
                        pass
                def _open_profile():
                    try:
                        bundle_cls = find_class("android.os.Bundle")
                        b = bundle_cls()
                        b.putLong("user_id", int(item.owner_id))
                        prof_cls = find_class("org.telegram.ui.ProfileActivity")
                        base_fragment.presentFragment(prof_cls(b))
                    except Exception as e:
                        self.log(f"Error opening ProfileActivity for user {item.owner_id}: {e}")

                run_on_ui_thread(_open_profile)
                return

            if wrapper and hasattr(wrapper, "closeMenu"):
                try:
                    wrapper.closeMenu()
                except Exception as e:
                    self.log(f"Error closing menu: {e}")

            if popup_swipe_back_layout:
                try:
                    popup_swipe_back_layout.closeForeground()
                except Exception:
                    pass

        try:
            if not hasattr(self, "_android_utilities"):
                self._android_utilities = find_class("org.telegram.messenger.AndroidUtilities")
            if self._android_utilities:
                self._android_utilities.addToClipboard(str(val))
        except Exception as e:
            self.log(f"Copy error: {e}")

        action_type = "clicked" if close else "long pressed"
        self.log(f"User {action_type} detail item '{item.title}': copied '{val}' to clipboard")

    def _open_file(self, activity, file_path, mime_type="*/*"):
        self.log(f"Opening file path '{file_path}' (MIME: '{mime_type}') via system intent")
        try:
            file_cls = find_class("java.io.File")
            f = file_cls(str(file_path))
            file_provider = find_class("androidx.core.content.FileProvider")
            app_loader = find_class("org.telegram.messenger.ApplicationLoader")
            app_id = str(app_loader.getApplicationId())
            uri = file_provider.getUriForFile(activity, f"{app_id}.provider", f)

            intent_cls = find_class("android.content.Intent")
            intent = intent_cls("android.intent.action.VIEW")
            intent.setFlags(1)  # FLAG_GRANT_READ_URI_PERMISSION
            intent.setDataAndType(uri, str(mime_type or "*/*"))

            pm = activity.getPackageManager()
            if not pm.queryIntentActivities(intent, 0).isEmpty():
                activity.startActivity(intent)
            else:
                send_intent = intent_cls("android.intent.action.SEND")
                send_intent.setFlags(1)
                send_intent.putExtra("android.intent.extra.STREAM", uri)
                send_intent.setDataAndType(uri, str(mime_type or "*/*"))
                chooser = intent_cls.createChooser(send_intent, get_loc_string("open"))
                activity.startActivity(chooser)
        except Exception as e:
            self.log(f"Error opening file path '{file_path}': {e}\n{traceback.format_exc()}")

    def _create_gap(self, context, resources_provider):
        if not hasattr(self, "_gap_cls"):
            try:
                self._gap_cls = find_class("org.telegram.ui.ActionBar.ActionBarPopupWindow$GapView")
            except Exception:
                self._gap_cls = False

        if self._gap_cls:
            try:
                gap = self._gap_cls(context, resources_provider)
                gap.setDividerVisible(False)
                return gap
            except Exception:
                pass
        view_cls = find_class("android.view.View")
        return view_cls(context)

    def _create_linear_params(self, w, h):
        if not hasattr(self, "_layout_helper"):
            try:
                self._layout_helper = find_class("org.telegram.ui.Components.LayoutHelper")
            except Exception:
                self._layout_helper = False

        if self._layout_helper:
            try:
                return self._layout_helper.createLinear(w, h)
            except Exception:
                pass
        lp_cls = find_class("android.widget.LinearLayout$LayoutParams")
        return lp_cls(w, h)
