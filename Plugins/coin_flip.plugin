__id__ = "coin_flip"
__name__ = "Coin Flip"
__version__ = "1.0"
__author__ = "v1sile"
__description__ = "Plugin for playing Heads or Tails"
__min_version__ = "12.1.1"
__icon__ = "cryptovalue/3"

import json
import os.path
import random
from base_plugin import BasePlugin, HookResult, HookStrategy
from android_utils import log
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input

class CoinFlip(BasePlugin):
    def __init__(self):
        super().__init__()
        
        self.config_file = os.path.join(
            os.path.dirname(os.path.realpath(__file__)), 
            "cache/config_coin_flip.json"
        )
        os.makedirs(os.path.dirname(self.config_file), exist_ok=True)
        
        self.lang = self.get_language()
        self.load_settings()
        
    def get_language(self) -> str:
        try:
            from org.telegram.messenger import LocaleController
            lang = LocaleController.getInstance().getCurrentLocale().getLanguage()
            if lang in ["ru", "uk", "be"]:
                return "ru"
            return "en"
        except:
            return "en"
            
    def get_text(self, key: str) -> str:
        texts = {
            "help": {
                "ru": (
                    "Игра Орёл и Решка\n\n"
                    "Команды:\n"
                    ".flip - подбросить монетку\n"
                    ".flip help - показать это сообщение"
                ),
                "en": (
                    "Heads or Tails Game\n\n"
                    "Commands:\n"
                    ".flip - flip the coin\n"
                    ".flip help - show this message"
                )
            },
            "result": {
                "ru": "Монета упала. Результат: {}",
                "en": "Coin fell. Result: {}"
            },
            "heads": {
                "ru": "Орёл",
                "en": "Heads"
            },
            "tails": {
                "ru": "Решка",
                "en": "Tails"
            },
            "error": {
                "ru": "Ошибка: {}",
                "en": "Error: {}"
            }
        }
        return texts.get(key, {}).get(self.lang, texts.get(key, {}).get("en", key))
        
    def on_plugin_load(self):
        self.log(f"Plugin '{self.name}' loaded successfully.")
        self.add_on_send_message_hook()
        self.load_settings()
        
    def on_plugin_unload(self):
        self.log(f"Plugin '{self.name}' unloaded successfully.")
        
    def create_settings(self):
        return [
            Header("Информация"),
            Input(
                "info",
                "",
                "Команда: .flip",
                "",
                enabled=False
            )
        ]
        
    def load_settings(self):
        try:
            if os.path.exists(self.config_file):
                with open(self.config_file, 'r') as f:
                    settings = json.load(f)
            else:
                self.save_settings()
        except Exception as e:
            self.log(f"Error loading settings: {str(e)}")
            self.save_settings()
            
    def save_settings(self):
        try:
            settings = {}
            with open(self.config_file, 'w') as f:
                json.dump(settings, f, indent=4)
        except Exception as e:
            self.log(f"Error saving settings: {str(e)}")
            
    def on_send_message_hook(self, account, params):
        if not hasattr(params, 'message') or not isinstance(params.message, str):
            return HookResult()
            
        message = params.message.strip()
        
        if not message.startswith(".flip"):
            return HookResult()
            
        try:
            args = message.split()
            
            if len(args) >= 2 and args[1].lower() in ["help", "h", "?"]:
                params.message = self.get_text("help")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
                
            if len(args) == 1 or (len(args) >= 2 and args[1].lower() not in ["help", "h", "?"]):
                result = random.choice(["heads", "tails"])
                if result == "heads":
                    result_text = self.get_text("heads")
                else:
                    result_text = self.get_text("tails")
                
                params.message = self.get_text("result").format(result_text)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
                
        except Exception as e:
            params.message = self.get_text("error").format(str(e))
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
            
        return HookResult()
        
    def get_context(self):
        try:
            from android_utils import get_context
            return get_context()
        except:
            return None