from typing import Any, List
import base64
import zlib
from base_plugin import BasePlugin
from java import jclass
from org.telegram.messenger import ApplicationLoader
from android.os import Build
from ui.settings import Divider, Header, Selector, Switch, Text

__id__ = "motion_blur_fx"
__name__ = "Motion Blur"
__description__ = "Направленное размытие в движении: скролл, свайпы, меню, свайп папок."
__author__ = "@winrar738 && @dekma0091"
__version__ = "2.0"
__icon__ = "exteraPlugins/1"
__min_version__ = "12.5.1"

ENTRY_CLASS = "ni.dekma.motionblur.MotionBlurBridge"
BuildVersion = jclass("android.os.Build$VERSION")

_DEX_BASE64 = ""

MIN_SDK = 31
INT_MIN, INT_MAX, INT_STEP, INT_DEF = 0, 49, 1, 7
INT_ITEMS = [f"{v}" for v in range(INT_MIN, INT_MAX + 1, INT_STEP)]
INT_DEF_IDX = INT_DEF

STRETCH_MIN, STRETCH_MAX, STRETCH_STEP, STRETCH_DEF = 0, 29, 1, 29
STRETCH_ITEMS = [f"{0.2 + v * 0.08:.2f}x" for v in range(STRETCH_MIN, STRETCH_MAX + 1, STRETCH_STEP)]
STRETCH_DEF_IDX = STRETCH_DEF


class NativeBridge:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            context = ApplicationLoader.applicationContext
            if context is None:
                raise RuntimeError("application context is not ready")
            if int(BuildVersion.SDK_INT) < 26:
                raise RuntimeError("embedded DEX requires Android API 26+")
            if not _DEX_BASE64:
                raise RuntimeError("embedded DEX payload is empty")
            payload = zlib.decompress(base64.b64decode(_DEX_BASE64))
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            loader = InMemoryDexClassLoader(
                ByteBuffer.wrap(payload),
                context.getClassLoader(),
            )
            self.clazz = loader.loadClass(self.entry_class)
        try:
            self._invoke("load")
            self.loaded = True
        except Exception as load_error:
            try:
                self._invoke("unload")
            except Exception as cleanup_error:
                self.loaded = False
                raise RuntimeError(f"DEX load failed: {load_error}") from cleanup_error
            self.loaded = False
            raise

    def unload(self):
        if self.clazz is None or not self.loaded:
            return
        self._invoke("unload")
        self.loaded = False

    def _invoke(self, method_name, *args):
        if self.clazz is None:
            raise RuntimeError("embedded DEX class is not loaded")
        matches = []
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) != method_name:
                continue
            if len(method.getParameterTypes()) != len(args):
                continue
            method.setAccessible(True)
            matches.append(method)
        if len(matches) > 1:
            raise RuntimeError(f"ambiguous core method: {method_name}/{len(args)}")
        if matches:
            return matches[0].invoke(None, *args)
        raise RuntimeError(f"core method not found: {method_name}/{len(args)}")


class MotionBlurPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.sdk_ok = Build.VERSION.SDK_INT >= MIN_SDK
        self.bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        if not self.sdk_ok:
            self.log(f"Motion Blur: API {Build.VERSION.SDK_INT} < {MIN_SDK}, эффект неактивен.")
            return
        try:
            self.bridge.load()
            self.sync_settings()
            self.log("Motion Blur: DEX модуль загружен успешно.")
        except Exception as e:
            self.log(f"Motion Blur: ошибка загрузки DEX: {e}")

    def on_plugin_unload(self):
        try:
            self.bridge.unload()
        except Exception as e:
            self.log(f"Motion Blur: ошибка выгрузки DEX: {e}")

    def sync_settings(self):
        if not hasattr(self, 'bridge') or not self.bridge:
            return
        try:
            g = self.get_setting
            enabled = True
            b_idx = int(g("blur_intensity_idx", INT_DEF_IDX))
            s_idx = int(g("stretch_intensity_idx", STRETCH_DEF_IDX))
            scroll = bool(g("enable_scroll", True))
            swipe = bool(g("enable_swipe", True))
            main_swipe = bool(g("enable_main_swipe", True))
            menu = bool(g("enable_menu", True))
            self.bridge._invoke("updateSettings", enabled, b_idx, s_idx, scroll, swipe, main_swipe, menu)
        except Exception as e:
            self.log(f"Motion Blur sync_settings error: {e}")

    def _handler(self, key):
        def _cb(*args):
            val = None
            if len(args) == 1:
                val = args[0]
            elif len(args) >= 2:
                val = args[1]
            if val is not None:
                try:
                    if isinstance(val, bool):
                        self.set_setting(key, val)
                    elif isinstance(val, int):
                        self.set_setting(key, val)
                    elif isinstance(val, str):
                        if val.isdigit():
                            self.set_setting(key, int(val))
                        elif val.endswith("x"):
                            v = float(val[:-1])
                            idx = int(round((v - 0.2) / 0.08))
                            self.set_setting(key, max(0, min(29, idx)))
                except Exception:
                    pass
            self.sync_settings()
        return _cb

    def create_settings(self) -> List[Any]:
        s: List[Any] = [Header(text="Motion Blur")]
        if not self.sdk_ok:
            s.append(Text(text=f"API {Build.VERSION.SDK_INT} < {MIN_SDK}, эффект неактивен.", red=True))
            s.append(Divider())
        s.append(Header(text="Параметры размытия"))
        s.append(Selector(key="blur_intensity_idx", text="Размытие",
                           default=INT_DEF_IDX, items=INT_ITEMS, on_change=self._handler("blur_intensity_idx")))
        s.append(Selector(key="stretch_intensity_idx", text="Сила растягивания",
                           default=STRETCH_DEF_IDX, items=STRETCH_ITEMS, on_change=self._handler("stretch_intensity_idx")))
        s.append(Divider())
        s.append(Header(text="Применять эффект к"))
        s.append(Switch(key="enable_scroll", text="Скролл", default=True,
                         subtext="Списки чатов и сообщений.", on_change=self._handler("enable_scroll")))
        s.append(Switch(key="enable_swipe", text="Свайпы", default=True,
                         subtext="Медиа-просмотрщик, вкладки.", on_change=self._handler("enable_swipe")))
        s.append(Switch(key="enable_main_swipe", text="Свайп в главном меню", default=True,
                         subtext="Свайп между папками на главном экране.", on_change=self._handler("enable_main_swipe")))
        s.append(Switch(key="enable_menu", text="Меню", default=True,
                         subtext="Всплывающие меню.", on_change=self._handler("enable_menu")))
        return s
