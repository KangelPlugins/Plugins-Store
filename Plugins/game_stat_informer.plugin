# osu! API v2 ruleset ids, keyed by every alias a user might type after the nickname
OSU_MODE_ALIASES = {
    "osu": "osu", "std": "osu", "standard": "osu",
    "taiko": "taiko",
    "catch": "fruits", "fruits": "fruits", "ctb": "fruits",
    "mania": "mania",
}
OSU_MODE_LABELS = {"osu": "osu!", "taiko": "osu!taiko", "fruits": "osu!catch", "mania": "osu!mania"}

# osu! v2 grade strings -> (short label, emoji)
GRADE_MAP = {
    "XH": ("SS", "🟡"), "X": ("SS", "🟡"),
    "SH": ("S", "⚪"), "S": ("S", "⚪"),
    "A": ("A", "🟢"),
    "B": ("B", "🔵"),
    "C": ("C", "🟣"),
    "D": ("D", "🔴"),
    "F": ("F", "⚫"),
}

OSU_API_BASE = "https://osu.ppy.sh/api/v2"
OSU_TOKEN_URL = "https://osu.ppy.sh/oauth/token"

BEATMAP_LINK_PATTERNS = [
    re.compile(r"osu\.ppy\.sh/beatmapsets/\d+#\w+/(\d+)"),
    re.compile(r"osu\.ppy\.sh/b/(\d+)"),
    re.compile(r"osu\.ppy\.sh/beatmaps/(\d+)"),
]
BEATMAPSET_LINK_RE = re.compile(r"osu\.ppy\.sh/beatmapsets/(\d+)")

PROFILE_LINK_RE = re.compile(r"osu\.ppy\.(?:sh|me)/(?:users|u)/([^/?\s]+)(?:/(osu|taiko|fruits|mania|catch))?")

STAR_RANGE_RE = re.compile(r"^(\d+(?:\.\d+)?)-(\d+(?:\.\d+)?)$")

# для запросов к /beatmapsets/search
OSU_MODE_SEARCH_NUM = {"osu": 0, "taiko": 1, "fruits": 2, "mania": 3}

STATUS_LABELS = {
    "graveyard": "⚪ Graveyard",
    "wip": "🔧 WIP",
    "pending": "🟠 Pending",
    "ranked": "🟢 Ranked",
    "approved": "🟢 Approved",
    "qualified": "🔵 Qualified",
    "loved": "❤️ Loved",
}

CACHE_TTL_SECONDS = 60


class GameInformerPlugin(BasePlugin):

    def on_plugin_load(self):
        self._osu_token: Optional[str] = None
        self._osu_token_expires_at: float = 0.0
        self._osu_cache: Dict[Tuple[str, str], Tuple[float, dict]] = {}
        self.add_on_send_message_hook()
        self.log("Game Stat Informer загружен")

    # ---------------------------------------------------------------- UI ---

    def show_toast(self, text: str):
        def run():
            try:
                Toast.makeText(ApplicationLoader.applicationContext, str(text), 0).show()
            except Exception as e:
                self.log(f"Toast error: {e}")
        run_on_ui_thread(run)

    def _debug_toast(self, text: str):
        if self.get_setting("debug_toasts", True):
            self.show_toast(text)

