import base64
import zlib
from typing import Any, List
from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Input
from java import jclass
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader

__id__ = "message_undo"
__name__ = "Message Undo"
__description__ = "Добавляет кнопку с таймером, которая позволяет удалить последнее отправленное сообщение"
__author__ = "@dekma0091"
__version__ = "1.0"
__icon__ = "pixelcamera/11"
__min_version__ = "12.5.1"

ENTRY_CLASS = "ni.dekma.message_undo.MessageUndoBridge"


class NativeBridge:
    def __init__(self, entry_class_name):
        self.entry_class_name = entry_class_name
        self.target_class = None
        self.is_active = False

    def start(self):
        if self.is_active:
            return
        if self.target_class is None:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                raise RuntimeError("Application context is unavailable")
            if not _DEX_BASE64:
                raise RuntimeError("Payload data is missing")
            compressed_data = base64.b64decode(_DEX_BASE64)
            dex_data = zlib.decompress(compressed_data)
            dex_buffer = ByteBuffer.wrap(dex_data)
            class_loader = InMemoryDexClassLoader(
                dex_buffer,
                ctx.getClassLoader(),
            )
            self.target_class = class_loader.loadClass(self.entry_class_name)
        try:
            self._invoke_static("load")
            self.is_active = True
        except Exception as load_err:
            try:
                self._invoke_static("unload")
            except Exception as reset_err:
                self.is_active = False
                raise RuntimeError(
                    f"Bridge initialization failed: {load_err} (Reset error: {reset_err})"
                ) from reset_err
            self.is_active = False
            raise

    def stop(self):
        if self.target_class is None or not self.is_active:
            return
        self._invoke_static("unload")
        self.is_active = False

    def show_undo(self, account: int, peer_id: int):
        if self.target_class and self.is_active:
            try:
                self._invoke_static("showUndo", account, peer_id)
            except Exception:
                pass

    def _invoke_static(self, method_name, *args):
        if self.target_class is None:
            raise RuntimeError("Target class reference is null")
        methods = []
        for method in self.target_class.getDeclaredMethods():
            if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                method.setAccessible(True)
                methods.append(method)
        if not methods:
            raise RuntimeError(f"Static method not found: {method_name}")
        if len(methods) > 1:
            raise RuntimeError(f"Multiple method signature matches: {method_name}")
        return methods[0].invoke(None, *args)


class message_undo(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        try:
            self.add_on_send_message_hook()
            self.bridge.start()
        except Exception as err:
            try:
                self.bridge.stop()
            except Exception as stop_err:
                self.log(f"Stop error: {stop_err}")
            self.log(f"Start error: {err}")

    def on_plugin_unload(self):
        try:
            self.bridge.stop()
        except Exception as err:
            self.log(f"Unload error: {err}")

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        try:
            peer_id = getattr(params, "peer", 0) if params else 0
            self.bridge.show_undo(account, peer_id)
            return HookResult(strategy=HookStrategy.DEFAULT)
        finally:
            del params

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Настройки отмены отправки"),
            Input(
                key="duration",
                text="Время отображения (секунды)",
                default="5",
                subtext="Длительность показа кнопки отмены от 1 до 60 секунд",
            ),
        ]


_DEX_BASE64 = ""
