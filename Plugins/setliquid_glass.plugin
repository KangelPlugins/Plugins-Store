from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from android_utils import log, run_on_ui_thread
from ui.settings import Header, Switch, Divider, Input, Text
from android.os import Build
from android.graphics import Color
from org.telegram.messenger import LocaleController
from java.lang import Float, Integer

__id__ = "setliquid_glass"
__name__ = "𝖲𝖾𝗍𝗍𝗂𝗇𝗀𝗌 𝖫𝗂𝗊𝗎𝗂𝖽 𝖦𝗅𝖺𝗌𝗌"
__description__ = "**настройка параметров эффекта Liquid Glass (нужно включить блюр и Liquid Glass в [энергосбережений](tg://settings/power))**\n\n**adjusting Liquid Glass Effect parameters (you need to enable blur and Liquid Glass in [power saving](tg://settings/power))**"
__author__ = "@ModeelX"
__version__ = "1.0"
__min_version__ = "12.5.1"
__icon__ = "Capoo_Static2/2"

class SettingsLiquidGlass(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hook_ref = None

    def _get_strings(self):
        try:
            lang = LocaleController.getInstance().getCurrentLocale().getLanguage()
        except:
            lang = "en"

        if lang.startswith("ru"):
            return {
                "header": "Эффект Liquid Glass",
                "enabled": "включить кастомные настройки",
                "enabled_sub": "переопределить стандартные параметры эффекта",
                "effect_params": "параметры эффекта",
                "thickness": "толщина",
                "thickness_sub": "рекомендую: 0.0 – 50.0",
                "intensity": "интенсивность",
                "intensity_sub": "рекомендую 0.0 – 1.0",
                "index": "индекс",
                "index_sub": "рекомендую: 0.0 – 0.8",
                "color": "цвет (HEX)",
                "color_sub": "формат #AARRGGBB или #RRGGBB",
                "apply": "применить изменения",
                "apply_sub": "принудительно перерисовать интерфейс",
                "defaults": {
                    "thickness": "0.0",
                    "intensity": "0.5",
                    "index": "0.4",
                    "color": "#40000000"
                }
            }
        else:
            return {
                "header": "Liquid Glass Effect",
                "enabled": "enable custom settings",
                "enabled_sub": "override default effect parameters",
                "effect_params": "effect parameters",
                "thickness": "thickness",
                "thickness_sub": "recommend: 0.0 – 50.0",
                "intensity": "intensity",
                "intensity_sub": "recommend: 0.0 – 1.0",
                "index": "index",
                "index_sub": "recommend: 0.0 – 0.8",
                "color": "color (HEX)",
                "color_sub": "format #AARRGGBB or #RRGGBB",
                "apply": "apply changes",
                "apply_sub": "force redraw the interface",
                "defaults": {
                    "thickness": "0.0",
                    "intensity": "0.5",
                    "index": "0.4",
                    "color": "#40000000"
                }
            }

    def on_plugin_load(self):
        if Build.VERSION.SDK_INT < 33:
            log("[setliquid_glass] android 13+ required, plugin stopped˙𐃷˙")
            return

        try:
            liquid_glass_cls = find_class("org.telegram.ui.Components.blur3.LiquidGlassEffect")
            update_method = liquid_glass_cls.getClass().getDeclaredMethod(
                "update",
                Float.TYPE, Float.TYPE, Float.TYPE, Float.TYPE,
                Float.TYPE, Float.TYPE, Float.TYPE, Float.TYPE,
                Float.TYPE, Float.TYPE, Float.TYPE,
                Integer.TYPE
            )
            update_method.setAccessible(True)
            self._hook_ref = self.hook_method(update_method, self._UpdateHook(self))
            log("[setliquid_glass] hook installed successfully!")
        except Exception as e:
            log(f"[setliquid_glass] failed to hook: {e}")

    def on_plugin_unload(self):
        if self._hook_ref:
            try:
                self.unhook_method(self._hook_ref)
                self._hook_ref = None
                log("[setliquid_glass] hook removed!")
            except Exception as e:
                log(f"[setliquid_glass] unhook error: {e}")

    def create_settings(self):
        s = self._get_strings()
        def on_change(_):
            run_on_ui_thread(lambda: None)

        return [
            Header(text=s["header"]),
            Switch(
                key="lg_enabled",
                text=s["enabled"],
                subtext=s["enabled_sub"],
                default=True,
                on_change=on_change
            ),
            Divider(),
            Header(text=s["effect_params"]),
            Input(
                key="lg_thickness",
                text=s["thickness"],
                default=s["defaults"]["thickness"],
                subtext=s["thickness_sub"],
                on_change=on_change
            ),
            Input(
                key="lg_intensity",
                text=s["intensity"],
                default=s["defaults"]["intensity"],
                subtext=s["intensity_sub"],
                on_change=on_change
            ),
            Input(
                key="lg_index",
                text=s["index"],
                default=s["defaults"]["index"],
                subtext=s["index_sub"],
                on_change=on_change
            ),
            Input(
                key="lg_color",
                text=s["color"],
                default=s["defaults"]["color"],
                subtext=s["color_sub"],
                on_change=on_change
            ),
            Divider(),
            Text(
                text=s["apply"],
                icon="msg_retry",
                subtext=s["apply_sub"],
                on_click=lambda v: self._force_redraw()
            )
        ]

    def _force_redraw(self):
        log("[setliquid_glass] there was no need to click on this, because the changes happen automaticallyˆ𐃷ˆ")

    def _get_float_setting(self, key, default):
        try:
            val = self.get_setting(key, default)
            return float(str(val).replace(',', '.'))
        except:
            return float(default)

    def _get_color_setting(self, key, default):
        try:
            return Color.parseColor(self.get_setting(key, default))
        except:
            try:
                return Color.parseColor(default)
            except:
                return 0x1AFFFFFF

    class _UpdateHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                if not self.plugin.get_setting("lg_enabled", True):
                    return

                args = param.args
                if len(args) < 12:
                    return

                s = self.plugin._get_strings()
                thickness = self.plugin._get_float_setting("lg_thickness", s["defaults"]["thickness"])
                intensity = self.plugin._get_float_setting("lg_intensity", s["defaults"]["intensity"])
                index_val = self.plugin._get_float_setting("lg_index", s["defaults"]["index"])
                color_val = self.plugin._get_color_setting("lg_color", s["defaults"]["color"])

                args[8] = Float(thickness)
                args[9] = Float(intensity)
                args[10] = Float(index_val)
                args[11] = Integer(color_val)

            except Exception as e:
                log(f"[setliquid_glass] hook error: {e}")