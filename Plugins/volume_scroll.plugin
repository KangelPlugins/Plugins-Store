import time
from typing import Any, List
from collections import deque

from base_plugin import BasePlugin, MethodHook
from ui.settings import Header, Selector, Switch
from android_utils import run_on_ui_thread
from client_utils import get_last_fragment
from ui.bulletin import BulletinHelper
from hook_utils import find_class, get_private_field
from java import jclass

try:
    from android.os import VibrationEffect
except Exception:
    VibrationEffect = None

__id__ = "volume_scroll"
__name__ = "Volume Scroll"
__description__ = "Листает кнопками громкости любые списки: чат, диалоги, настройки, профиль. Двойное нажатие любой кнопки громкости вкл/выкл режим. Удержание — ускорение прокрутки."
__author__ = "@YouPlugins"
__version__ = "1.1"
__icon__ = "exteraBadges/4"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

KEYCODE_VOLUME_UP = 24
KEYCODE_VOLUME_DOWN = 25
ACTION_DOWN = 0

DOUBLE_TAP_WINDOW = 0.4
TOGGLE_COOLDOWN = 0.6


class VolumeScrollPlugin(BasePlugin):

    SCROLL_HINTS = (
        "RecyclerView",
        "RecyclerListView",
        "AbsListView",
        "ListView",
        "GridView",
        "ScrollView",
    )

    def __init__(self):
        super().__init__()
        self._unhooks = []
        self._scroll_mode = False
        self._last_tap_time = 0.0
        self._toggle_lock_until = 0.0
        self._scrollable_cache = {}

    def on_plugin_load(self):
        self._scroll_mode = False
        self._hook_key_events()

    def on_plugin_unload(self):
        self._scroll_mode = False
        for unhook in getattr(self, "_unhooks", []):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self._unhooks = []

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Volume Scroll"),
            Selector(
                key="scroll_amount",
                text="Сила прокрутки",
                default=1,
                items=["Короткая", "Средняя", "Большая"],
                icon="msg_sort",
            ),
            Switch(
                key="invert",
                text="Инвертировать направление",
                default=False,
                subtext="Громкость вверх листает вниз и наоборот",
            ),
            Switch(
                key="haptics",
                text="Вибрация при переключении",
                default=True,
                subtext="Короткий отклик при вкл/выкл режима",
            ),
        ]

    def _setting_int(self, key, default_val):
        val = self.get_setting(key, default_val)
        try:
            return int(val)
        except Exception:
            return default_val

    def _hook_key_events(self):
        try:
            launch_cls = find_class("org.telegram.ui.LaunchActivity")
            if launch_cls is None:
                return
            plugin = self

            class DispatchKeyHook(MethodHook):
                def before_hooked_method(self, param):
                    try:
                        event = param.args[0]
                        if plugin._on_key_event(event):
                            param.setResult(True)
                    except Exception:
                        pass

            unhooks = self.hook_all_methods(
                launch_cls, "dispatchKeyEvent", DispatchKeyHook()
            )
            if unhooks:
                for u in unhooks:
                    self._unhooks.append(u)
        except Exception:
            pass

    def _on_key_event(self, event) -> bool:
        try:
            keycode = event.getKeyCode()
            action = event.getAction()
        except Exception:
            return False
        if keycode not in (KEYCODE_VOLUME_UP, KEYCODE_VOLUME_DOWN):
            return False
        if action != ACTION_DOWN:
            return self._scroll_mode
        up = keycode == KEYCODE_VOLUME_UP
        try:
            repeat = event.getRepeatCount()
        except Exception:
            repeat = 0
        if repeat > 0:
            if self._scroll_mode:
                self._scroll(up, repeat)
                return True
            return False
        now = time.time()
        if now < self._toggle_lock_until:
            if self._scroll_mode:
                self._scroll(up, 0)
                return True
            return False
        is_double = (now - self._last_tap_time) <= DOUBLE_TAP_WINDOW
        if is_double:
            self._last_tap_time = 0.0
            self._toggle_lock_until = now + TOGGLE_COOLDOWN
            self._toggle_mode()
            return True
        self._last_tap_time = now
        if self._scroll_mode:
            self._scroll(up, 0)
            return True
        return False

    def _toggle_mode(self):
        self._scroll_mode = not self._scroll_mode
        state = "включён" if self._scroll_mode else "выключен"
        run_on_ui_thread(
            lambda: BulletinHelper.show_info("Скролл громкостью: " + state)
        )
        self._vibrate()

    def _vibrate(self):
        if not self.get_setting("haptics", True):
            return
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is None:
                return
            vibrator = activity.getSystemService("vibrator")
            if vibrator is None:
                return
            if VibrationEffect is not None:
                try:
                    effect = VibrationEffect.createOneShot(
                        40, VibrationEffect.DEFAULT_AMPLITUDE
                    )
                    vibrator.vibrate(effect)
                    return
                except Exception:
                    pass
            vibrator.vibrate(40)
        except Exception:
            pass

    def _scroll(self, up: bool, repeat: int):
        def do():
            try:
                fragment = get_last_fragment()
                if fragment is None:
                    return
                direction = -1 if up else 1
                if self.get_setting("invert", False):
                    direction = -direction
                view = self._find_scrollable(fragment, direction)
                if view is None:
                    return
                base = self._scroll_delta()
                multiplier = 1.0 + min(2.0, max(0, repeat) * 0.12)
                dy = int(base * multiplier) * direction
                self._perform_scroll(view, dy)
            except Exception:
                pass

        run_on_ui_thread(do)

    def _scrollable_classes(self):
        classes = []
        for name in (
            "org.telegram.ui.Components.RecyclerListView",
            "androidx.recyclerview.widget.RecyclerView",
            "android.widget.AbsListView",
            "android.widget.ScrollView",
            "androidx.core.widget.NestedScrollView",
        ):
            if name in self._scrollable_cache:
                cls = self._scrollable_cache[name]
            else:
                try:
                    cls = find_class(name)
                except Exception:
                    cls = None
                self._scrollable_cache[name] = cls
            if cls is not None:
                classes.append(cls)
        return classes

    def _is_scrollable_view(self, view, classes):
        try:
            name = view.getClass().getName()
        except Exception:
            return False
        if any(hint in name for hint in self.SCROLL_HINTS):
            return True
        for cls in classes:
            try:
                if cls.isInstance(view):
                    return True
            except Exception:
                continue
        return False

    def _find_scrollable(self, fragment, direction):
        for attr in ("chatListView", "listView"):
            try:
                lv = get_private_field(fragment, attr)
                if lv is not None:
                    return lv
            except Exception:
                continue
        try:
            root = get_private_field(fragment, "fragmentView")
        except Exception:
            root = None
        if root is None:
            return None
        classes = self._scrollable_classes()
        queue = deque([root])
        first_shown = None
        steps = 0
        while queue and steps < 800:
            view = queue.popleft()
            steps += 1
            if self._is_scrollable_view(view, classes):
                try:
                    if view.isShown() and view.getHeight() > 0:
                        if first_shown is None:
                            first_shown = view
                        try:
                            if view.canScrollVertically(direction):
                                return view
                        except Exception:
                            pass
                except Exception:
                    pass
            try:
                count = view.getChildCount()
                for i in range(count):
                    queue.append(view.getChildAt(i))
            except Exception:
                pass
        return first_shown

    def _is_abs_list(self, view):
        cls = view.getClass()
        depth = 0
        while cls is not None and depth < 12:
            try:
                name = cls.getName()
            except Exception:
                return False
            if name == "android.widget.AbsListView":
                return True
            if name in (
                "android.view.View",
                "android.widget.ScrollView",
                "androidx.core.widget.NestedScrollView",
                "androidx.recyclerview.widget.RecyclerView",
            ):
                return False
            try:
                cls = cls.getSuperclass()
            except Exception:
                return False
            depth += 1
        return False

    def _perform_scroll(self, view, dy):
        if dy == 0:
            return
        if self._is_abs_list(view):
            try:
                view.smoothScrollBy(dy, 350)
                return
            except Exception:
                pass
        try:
            view.smoothScrollBy(0, dy)
        except Exception:
            pass

    def _scroll_delta(self) -> int:
        android_utilities = jclass("org.telegram.messenger.AndroidUtilities")
        idx = self._setting_int("scroll_amount", 1)
        dp_map = {0: 120, 1: 260, 2: 500}
        return android_utilities.dp(dp_map.get(idx, 260))
