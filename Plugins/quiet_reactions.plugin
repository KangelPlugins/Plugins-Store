__id__ = "quiet_reactions"
__name__ = "Quiet Reactions"
__description__ = "Управление большими реакциями, эффектами, вибрацией и автопрочтением в группах и ЛС.\n\nManage big fullscreen reactions, background effects, vibration and auto-read in groups and PMs."
__author__ = "@RnPlugins"
__version__ = "1.0.0"
__icon__ = "RnDev/20"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

import base64
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader, LocaleController
from ui.settings import Header, Switch, Divider

DEX_B64 = """"""

class QuietReactionsPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.quietreactions.QuietReactions")
            
            for m in self.dex_class.getMethods():
                if m.getName() == "start":
                    m.invoke(None)
                    break
            
            self.apply_settings()
        except Exception as e:
            self.log(f"Load error: {e}")

    def on_plugin_unload(self):
        try:
            if hasattr(self, "dex_class") and self.dex_class is not None:
                for m in self.dex_class.getMethods():
                    if m.getName() == "stop":
                        m.invoke(None)
                        break
        except Exception:
            pass
        finally:
            self.dex_class = None
            self.dex_loader = None

    def apply_settings(self):
        if not hasattr(self, "dex_class") or self.dex_class is None:
            return
            
        big_groups = bool(self.get_setting("enable_big_groups", False))
        big_pms = bool(self.get_setting("enable_big_pms", False))
        effects_groups = bool(self.get_setting("enable_effects_groups", True))
        effects_pms = bool(self.get_setting("enable_effects_pms", True))
        haptic_groups = bool(self.get_setting("enable_haptic_groups", False))
        haptic_pms = bool(self.get_setting("enable_haptic_pms", True))
        auto_read_groups = bool(self.get_setting("auto_read_groups", False))
        auto_read_pms = bool(self.get_setting("auto_read_pms", False))
        affect_own = bool(self.get_setting("affect_own_reactions", False))
        
        for m in self.dex_class.getMethods():
            if m.getName() == "updateSettings":
                m.invoke(None, big_groups, big_pms, effects_groups, effects_pms, haptic_groups, haptic_pms, auto_read_groups, auto_read_pms, affect_own)
                break

    def _is_ru(self):
        try:
            lang = LocaleController.getInstance().getCurrentLocale().getLanguage()
            return lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be")
        except Exception:
            return True

    def create_settings(self):
        is_ru = self._is_ru()
        
        return [
            Header(
                text="Большие реакции (на весь экран)" if is_ru else "Big Reactions (Fullscreen)"
            ),
            Switch(
                key="enable_big_groups",
                text="В групповых чатах" if is_ru else "In group chats",
                subtext="Полноэкранная анимация при реакциях" if is_ru else "Fullscreen animation on reactions",
                default=False,
                icon="msg_groups",
                on_change=lambda val: self.apply_settings()
            ),
            Switch(
                key="enable_big_pms",
                text="В личных чатах" if is_ru else "In private chats",
                subtext="Полноэкранная анимация при реакциях" if is_ru else "Fullscreen animation on reactions",
                default=False,
                icon="msg_contacts",
                on_change=lambda val: self.apply_settings()
            ),
            Header(
                text="Эффекты вокруг сообщений" if is_ru else "Reaction Effects Around Message"
            ),
            Switch(
                key="enable_effects_groups",
                text="В групповых чатах" if is_ru else "In group chats",
                subtext="Вылетающие всполохи вокруг сообщения" if is_ru else "Popup flares around message",
                default=True,
                icon="msg_groups",
                on_change=lambda val: self.apply_settings()
            ),
            Switch(
                key="enable_effects_pms",
                text="В личных чатах" if is_ru else "In private chats",
                subtext="Вылетающие всполохи вокруг сообщения" if is_ru else "Popup flares around message",
                default=True,
                icon="msg_contacts",
                on_change=lambda val: self.apply_settings()
            ),
            Header(
                text="Вибрация (тактильная отдача)" if is_ru else "Haptic Vibration"
            ),
            Switch(
                key="enable_haptic_groups",
                text="В групповых чатах" if is_ru else "In group chats",
                subtext="Вибрация при реакциях" if is_ru else "Vibration on reactions",
                default=False,
                icon="msg_groups",
                on_change=lambda val: self.apply_settings()
            ),
            Switch(
                key="enable_haptic_pms",
                text="В личных чатах" if is_ru else "In private chats",
                subtext="Вибрация при реакциях" if is_ru else "Vibration on reactions",
                default=True,
                icon="msg_contacts",
                on_change=lambda val: self.apply_settings()
            ),
            Header(
                text="Автопрочтение реакций" if is_ru else "Auto-Read Reactions"
            ),
            Switch(
                key="auto_read_groups",
                text="В групповых чатах" if is_ru else "In group chats",
                subtext="Сразу сбрасывает счетчики и кнопку реакций" if is_ru else "Instantly clears reaction badges and button",
                default=False,
                icon="msg_groups",
                on_change=lambda val: self.apply_settings()
            ),
            Switch(
                key="auto_read_pms",
                text="В личных чатах" if is_ru else "In private chats",
                subtext="Сразу сбрасывает счетчики и кнопку реакций" if is_ru else "Instantly clears reaction badges and button",
                default=False,
                icon="msg_contacts",
                on_change=lambda val: self.apply_settings()
            ),
            Header(
                text="Собственные реакции" if is_ru else "Own Reactions"
            ),
            Switch(
                key="affect_own_reactions",
                text="Включая свои реакции" if is_ru else "Include own reactions",
                subtext="Применять ограничения и к вашим реакциям" if is_ru else "Apply restrictions to your own reactions",
                default=False,
                icon="msg_openprofile",
                on_change=lambda val: self.apply_settings()
            ),
            Divider(
                text="Настройки применяются мгновенно." if is_ru else "Settings apply immediately."
            )
        ]
