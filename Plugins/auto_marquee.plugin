from typing import Any, List

from java import jclass
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.settings import Header, Switch, Divider, Text

__id__ = "auto_marquee"
__name__ = "Auto Marquee"
__description__ = "Auto-scrolling (marquee) for long titles: chat header (profiles/groups/channels), profile name, screen titles and settings rows. Instead of fading/ellipsis the text smoothly scrolls"
__author__ = "@chestertech"
__version__ = "1.1.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.8.1"
__sdk_version__ = ">=1.4.3.10"

try:
    from android_utils import run_on_ui_thread
except Exception:
    run_on_ui_thread = None

try:
    TruncateAt = jclass("android.text.TextUtils$TruncateAt")
except Exception:
    TruncateAt = None

CHAT_AVATAR_CONTAINER = "org.telegram.ui.Components.ChatAvatarContainer"
ACTION_BAR = "org.telegram.ui.ActionBar.ActionBar"
PROFILE_ACTIVITY = "org.telegram.ui.ProfileActivity"
LOCALE_CONTROLLER = "org.telegram.messenger.LocaleController"

SETTINGS_CELL_CLASSES = [
    "org.telegram.ui.Cells.TextSettingsCell",
    "org.telegram.ui.Cells.TextCheckCell",
    "org.telegram.ui.Cells.NotificationsCheckCell",
    "org.telegram.ui.Cells.HeaderCell",
    "org.telegram.ui.Cells.TextDetailSettingsCell",
    "org.telegram.ui.Cells.TextCell",
    "org.telegram.ui.Cells.TextCheckBoxCell",
]

TEXT_FIELD_CANDIDATES = ["textView"]

_CAPABILITY_CACHE = {}

_LAST_LANG = None


def _class_name(obj: Any) -> str:
    try:
        return str(obj.getClass().getName())
    except Exception:
        try:
            return type(obj).__name__
        except Exception:
            return "?"


def _has_method(obj: Any, name: str) -> bool:
    cache_key = f"{_class_name(obj)}#{name}"
    cached = _CAPABILITY_CACHE.get(cache_key)
    if cached is not None:
        return cached
    ok = callable(getattr(obj, name, None))
    _CAPABILITY_CACHE[cache_key] = ok
    return ok


def _reflection_class(clazz: Any) -> Any:
    if clazz is None:
        return None

    get_name = getattr(clazz, "getName", None)
    if callable(get_name):
        try:
            get_name()
            return clazz
        except Exception:
            pass

    try:
        reflected = clazz.getClass()
    except Exception:
        return None

    if reflected is not None and callable(getattr(reflected, "getName", None)):
        try:
            reflected.getName()
            return reflected
        except Exception:
            pass
    return None


def _find_hook_class(class_name: str) -> Any:
    try:
        return _reflection_class(find_class(class_name))
    except Exception:
        return None


def _java_array_to_list(array: Any) -> List[Any]:
    if array is None:
        return []
    items = []
    try:
        length = len(array)
    except Exception:
        try:
            for item in array:
                items.append(item)
        except Exception:
            return []
        return items
    for index in range(length):
        try:
            items.append(array[index])
        except Exception:
            pass
    return items


def _collect_constructors(clazz: Any) -> List[Any]:
    for getter in ("getDeclaredConstructors", "getConstructors"):
        try:
            members = _java_array_to_list(getattr(clazz, getter)())
        except Exception:
            members = []
        if members:
            return members
    return []


def _collect_methods(clazz: Any, method_name: str) -> List[Any]:
    current = clazz
    while current is not None:
        found = []
        for getter in ("getDeclaredMethods", "getMethods"):
            try:
                members = _java_array_to_list(getattr(current, getter)())
            except Exception:
                members = []
            for member in members:
                try:
                    if member.getName() == method_name:
                        found.append(member)
                except Exception:
                    pass
            if found:
                return found
        try:
            current = current.getSuperclass()
        except Exception:
            return []
    return []


STRINGS = {
    'en': {
        'header_main': 'Auto Marquee',
        'enabled_title': 'Enable marquee',
        'enabled_sub': 'Global switch',
        'header_where': 'Where to enable',
        'chat_header_title': 'Chat header',
        'chat_header_sub': 'Names of profiles, groups and channels in an open chat',
        'profile_name_title': 'Name in profile',
        'profile_name_sub': 'User name / chat title on the profile page',
        'action_bar_title': 'Screen titles',
        'action_bar_sub': 'ActionBar titles (settings sections, etc.)',
        'settings_cells_title': 'Settings rows',
        'settings_cells_sub': 'Settings rows where the text is cut off with an ellipsis',
        'note': 'Names in the chat list are drawn manually (StaticLayout), so marquee is not supported there.',
    },
    'ru': {
        'header_main': 'Auto Marquee',
        'enabled_title': 'Включить бегущую строку',
        'enabled_sub': 'Глобальный выключатель',
        'header_where': 'Где включать',
        'chat_header_title': 'Шапка чата',
        'chat_header_sub': 'Названия профилей, групп и каналов в открытом чате',
        'profile_name_title': 'Имя в профиле',
        'profile_name_sub': 'Имя пользователя / название чата на странице профиля',
        'action_bar_title': 'Заголовки экранов',
        'action_bar_sub': 'Заголовки ActionBar (разделы настроек и др.)',
        'settings_cells_title': 'Пункты настроек',
        'settings_cells_sub': 'Строки настроек, где текст обрезается многоточием',
        'note': 'Названия в списке чатов рисуются вручную (StaticLayout), поэтому бегущая строка там не поддерживается.',
    },
}


_LANG_NAME_MAP = {
    'english': 'en',
    'russian': 'ru',
    'русский': 'ru',
}


def _locale_controller():
    try:
        cls = find_class(LOCALE_CONTROLLER)
        if cls is not None:
            return cls
    except Exception:
        pass
    try:
        return jclass(LOCALE_CONTROLLER)
    except Exception:
        return None


def _locale_instance():
    cls = _locale_controller()
    if cls is None:
        return None
    try:
        return cls.getInstance()
    except Exception:
        return None


def _norm_lang(raw):
    if raw is None:
        return None
    try:
        code = str(raw).strip().lower()
    except Exception:
        return None
    if not code or code in ("null", "none"):
        return None
    code = _LANG_NAME_MAP.get(code, code)
    code = code.replace('_', '-').split('-', 1)[0]
    return code if code in STRINGS else None


def _lang_from_locale_info(inst):
    info = None
    if _has_method(inst, "getCurrentLocaleInfo"):
        try:
            info = inst.getCurrentLocaleInfo()
        except Exception:
            info = None

    if info is None:
        info = _get_field(inst, "currentLocaleInfo")
    if info is None:
        return None

    for getter in ("getLangCode", "getBaseLangCode", "getPluralLangCode", "getKey"):
        if not _has_method(info, getter):
            continue
        try:
            code = _norm_lang(getattr(info, getter)())
        except Exception:
            code = None
        if code:
            return code

    for fld in ("shortName", "pluralLangCode", "baseLangCode", "langCode", "name"):
        code = _norm_lang(_get_field(info, fld))
        if code:
            return code
    return None


def _get_lang():
    inst = _locale_instance()

    if inst is not None:
        try:
            code = _lang_from_locale_info(inst)
            if code:
                return code
        except Exception:
            pass

        if _has_method(inst, "getCurrentLocale"):
            try:
                locale_obj = inst.getCurrentLocale()
                if locale_obj is not None:
                    code = _norm_lang(locale_obj.getLanguage())
                    if code:
                        return code
            except Exception:
                pass

        locale_obj = _get_field(inst, "currentLocale")
        if locale_obj is not None:
            try:
                code = _norm_lang(locale_obj.getLanguage())
                if code:
                    return code
            except Exception:
                pass

        if _has_method(inst, "getCurrentLanguageName"):
            try:
                code = _norm_lang(inst.getCurrentLanguageName())
                if code:
                    return code
            except Exception:
                pass

    try:
        Locale = jclass("java.util.Locale")
        code = _norm_lang(Locale.getDefault().getLanguage())
        if code:
            return code
    except Exception:
        pass

    return 'en'


def _get_field(obj: Any, name: str) -> Any:
    try:
        cls = obj.getClass()
    except Exception:
        return None
    while cls is not None:
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            return field.get(obj)
        except Exception:
            try:
                cls = cls.getSuperclass()
            except Exception:
                return None
    return None


class _ViewRegistry:
    def __init__(self):
        self.simple = {}
        self.plain = {}

    def has(self, key):
        return key in self.simple or key in self.plain

    def clear(self):
        self.simple.clear()
        self.plain.clear()


def _apply_marquee(plugin: "AutoMarqueePlugin", view: Any) -> None:
    if view is None:
        return

    registry = plugin._registry

    try:
        key = view.hashCode()
    except Exception:
        key = None

    if key is not None and registry.has(key):
        return

    if _has_method(view, "setScrollNonFitText"):
        try:
            view.setScrollNonFitText(True)
            if key is not None:
                registry.simple[key] = view
            return
        except Exception:
            pass

    if TruncateAt is None or not _has_method(view, "setEllipsize"):
        return

    try:
        view.setSingleLine(True)
        view.setEllipsize(TruncateAt.MARQUEE)
        view.setMarqueeRepeatLimit(-1)
        view.setHorizontalFadingEdgeEnabled(True)
        view.setSelected(True)
        if key is not None:
            registry.plain[key] = view
    except Exception:
        pass


def _revert_view(view: Any, is_simple: bool) -> None:
    try:
        if is_simple:
            view.setScrollNonFitText(False)
        else:
            view.setSelected(False)
            view.setHorizontalFadingEdgeEnabled(False)
            if TruncateAt is not None:
                view.setEllipsize(TruncateAt.END)
            view.setMarqueeRepeatLimit(3)
    except Exception:
        pass


class _ChatAvatarContainerHook(MethodHook):
    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin = plugin

    def after_hooked_method(self, param):
        p = self._plugin
        try:
            if not (p.get_setting("enabled", True) and p.get_setting("chat_header", True)):
                return
            container = param.thisObject
            if container is None:
                return
            if not _has_method(container, "getTitleTextView"):
                _apply_marquee(p, _get_field(container, "titleTextView"))
                return
            try:
                _apply_marquee(p, container.getTitleTextView())
            except Exception:
                pass
        except Exception:
            pass


class _ActionBarTitleHook(MethodHook):
    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin = plugin

    def after_hooked_method(self, param):
        p = self._plugin
        try:
            if not (p.get_setting("enabled", True) and p.get_setting("action_bar", True)):
                return
            action_bar = param.thisObject
            if action_bar is None:
                return

            title_view = None
            if _has_method(action_bar, "getTitleTextView"):
                try:
                    title_view = action_bar.getTitleTextView()
                except Exception:
                    title_view = None

            if title_view is None:
                title_view = _get_field(action_bar, "titleTextView")
            if title_view is None:
                return

            if hasattr(title_view, "__len__") and not _has_method(title_view, "setEllipsize"):
                try:
                    for view in title_view:
                        _apply_marquee(p, view)
                    return
                except Exception:
                    pass

            _apply_marquee(p, title_view)
        except Exception:
            pass


class _ProfileNameHook(MethodHook):
    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin = plugin

    def after_hooked_method(self, param):
        p = self._plugin
        try:
            if not (p.get_setting("enabled", True) and p.get_setting("profile_name", True)):
                return
            fragment = param.thisObject
            if fragment is None:
                return
            names = _get_field(fragment, "nameTextView")
            if names is None:
                return
            if hasattr(names, "__len__") and not _has_method(names, "setScrollNonFitText"):
                try:
                    for view in names:
                        _apply_marquee(p, view)
                    return
                except Exception:
                    pass
            _apply_marquee(p, names)
        except Exception:
            pass


class _SettingsCellHook(MethodHook):
    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin = plugin

    def after_hooked_method(self, param):
        p = self._plugin
        try:
            if not (p.get_setting("enabled", True) and p.get_setting("settings_cells", True)):
                return
            cell = param.thisObject
            if cell is None:
                return
            for field_name in TEXT_FIELD_CANDIDATES:
                view = _get_field(cell, field_name)
                if view is not None:
                    _apply_marquee(p, view)
        except Exception:
            pass


class _LanguageChangeHook(MethodHook):

    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin = plugin

    def after_hooked_method(self, param):
        try:
            self._plugin._refresh_language()
        except Exception:
            pass


class AutoMarqueePlugin(BasePlugin):
    def _hook_members(self, members: List[Any], hook: Any) -> List[Any]:
        unhooks = []
        for member in members:
            try:
                member.setAccessible(True)
            except Exception:
                pass
            try:
                unhook = self.hook_method(member, hook)
            except Exception:
                unhook = None
            if unhook:
                unhooks.append(unhook)
        return unhooks

    def _hook_constructors(self, clazz: Any, hook: Any) -> List[Any]:
        try:
            unhooks = self.hook_all_constructors(clazz, hook)
        except Exception:
            unhooks = None
        if unhooks:
            unhooks = list(unhooks)
        else:
            unhooks = self._hook_members(_collect_constructors(clazz), hook)
        self._unhooks.extend(unhooks)
        return unhooks

    def _hook_methods(self, clazz: Any, method_name: str, hook: Any) -> List[Any]:
        try:
            unhooks = self.hook_all_methods(clazz, method_name, hook)
        except Exception:
            unhooks = None
        if unhooks:
            unhooks = list(unhooks)
        else:
            unhooks = self._hook_members(_collect_methods(clazz, method_name), hook)
        self._unhooks.extend(unhooks)
        return unhooks

    def on_plugin_load(self):
        global _LAST_LANG
        self._registry = _ViewRegistry()
        self._unhooks = []
        _CAPABILITY_CACHE.clear()

        try:
            _LAST_LANG = _get_lang()
        except Exception:
            _LAST_LANG = None

        try:
            clazz = _find_hook_class(CHAT_AVATAR_CONTAINER)
            if clazz:
                self._hook_constructors(clazz, _ChatAvatarContainerHook(self))
        except Exception:
            pass

        try:
            clazz = _find_hook_class(ACTION_BAR)
            if clazz:
                self._hook_methods(clazz, "setTitle", _ActionBarTitleHook(self))
        except Exception:
            pass

        try:
            clazz = _find_hook_class(PROFILE_ACTIVITY)
            if clazz:
                profile_hook = _ProfileNameHook(self)
                for method_name in ("updateProfileData", "createView"):
                    self._hook_methods(clazz, method_name, profile_hook)
        except Exception:
            pass

        cell_hook = _SettingsCellHook(self)
        for class_name in SETTINGS_CELL_CLASSES:
            try:
                clazz = _find_hook_class(class_name)
                if clazz:
                    self._hook_constructors(clazz, cell_hook)
            except Exception:
                pass

        try:
            clazz = _locale_controller()
            if clazz:
                lang_hook = _LanguageChangeHook(self)
                for method_name in ("applyLanguage", "recreateFormatters"):
                    self._hook_methods(clazz, method_name, lang_hook)
        except Exception:
            pass

    def on_plugin_unload(self):
        self._revert_all()

    def _revert_all(self):
        registry = getattr(self, "_registry", None)
        if registry is None:
            return

        def do_revert():
            try:
                for view in list(registry.simple.values()):
                    _revert_view(view, is_simple=True)
                for view in list(registry.plain.values()):
                    _revert_view(view, is_simple=False)
                registry.clear()
            except Exception:
                pass

        try:
            if run_on_ui_thread is not None:
                run_on_ui_thread(do_revert)
            else:
                do_revert()
        except Exception:
            pass

    def _refresh_language(self):
        global _LAST_LANG
        try:
            lang = _get_lang()
        except Exception:
            return
        if lang == _LAST_LANG:
            return
        _LAST_LANG = lang

        def do_reload():
            for name in ("reload_settings", "reloadSettings"):
                fn = getattr(self, name, None)
                if callable(fn):
                    try:
                        fn()
                        return
                    except Exception:
                        pass
            try:
                tick = int(self.get_setting("lang_tick", 0) or 0) + 1
            except Exception:
                tick = 1
            try:
                self.set_setting("lang_tick", tick, reload_settings=True)
            except Exception:
                pass

        try:
            if run_on_ui_thread is not None:
                run_on_ui_thread(do_reload)
            else:
                do_reload()
        except Exception:
            pass

    def _on_master_switch(self, enabled: bool):
        self.set_setting("enabled", bool(enabled), reload_settings=False)
        if not enabled:
            self._revert_all()

    def create_settings(self) -> List[Any]:
        global _LAST_LANG
        lang = _get_lang()
        _LAST_LANG = lang

        def tr(key):
            return STRINGS.get(lang, STRINGS['en']).get(key, key)

        return [
            Header(text=tr('header_main')),
            Switch(
                key="enabled",
                text=tr('enabled_title'),
                subtext=tr('enabled_sub'),
                default=True,
                on_change=self._on_master_switch,
            ),
            Divider(),
            Header(text=tr('header_where')),
            Switch(
                key="chat_header",
                text=tr('chat_header_title'),
                subtext=tr('chat_header_sub'),
                default=True,
            ),
            Switch(
                key="profile_name",
                text=tr('profile_name_title'),
                subtext=tr('profile_name_sub'),
                default=True,
            ),
            Switch(
                key="action_bar",
                text=tr('action_bar_title'),
                subtext=tr('action_bar_sub'),
                default=True,
            ),
            Switch(
                key="settings_cells",
                text=tr('settings_cells_title'),
                subtext=tr('settings_cells_sub'),
                default=True,
            ),
            Divider(),
            Text(
                text=tr('note'),
            ),
        ]


def create_plugin():
    return AutoMarqueePlugin()
