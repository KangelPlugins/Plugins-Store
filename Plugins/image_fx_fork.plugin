def dlog(msg):
    try:
        Log.d("image_fx", str(msg))
    except Exception:
        pass
    try:
        log(str(msg))
    except Exception:
        pass


def _to_class(value):
    if value is None:
        return None
    try:
        if hasattr(value, "getDeclaredMethod"):
            return value
    except Exception:
        pass
    try:
        return value.getClass()
    except Exception:
        return None



def _lut(fn):
    return [max(0, min(255, int(fn(i)))) for i in range(256)]


def _curve(img, r=None, g=None, b=None):
    rr, gg, bb = img.split()
    if r is not None:
        rr = rr.point(_lut(r))
    if g is not None:
        gg = gg.point(_lut(g))
    if b is not None:
        bb = bb.point(_lut(b))
    return Image.merge("RGB", (rr, gg, bb))


def _enhance(img, color=None, contrast=None, brightness=None, sharpness=None):
    if color is not None:
        img = ImageEnhance.Color(img).enhance(color)
    if contrast is not None:
        img = ImageEnhance.Contrast(img).enhance(contrast)
    if brightness is not None:
        img = ImageEnhance.Brightness(img).enhance(brightness)
    if sharpness is not None:
        img = ImageEnhance.Sharpness(img).enhance(sharpness)
    return img


def _blend_mode(base, layer, mode="soft_light"):
    try:
        return getattr(ImageChops, mode)(base, layer)
    except Exception:
        return Image.blend(base, layer, 0.5)


def _tint(img, color, amount=0.3):
    layer = Image.new("RGB", img.size, color)
    return Image.blend(img, _blend_mode(img, layer, "soft_light"), amount)


def _split_tone(img, shadow, highlight, amount=0.35):
    lum = ImageOps.grayscale(img)
    tone = Image.composite(
        Image.new("RGB", img.size, highlight),
        Image.new("RGB", img.size, shadow),
        lum,
    )
    return Image.blend(img, _blend_mode(img, tone, "soft_light"), amount)


def _gradient(size, colors, vertical=False):
    seed = Image.new("RGB", (1, len(colors)) if vertical else (len(colors), 1))
    seed.putdata([tuple(c) for c in colors])
    return seed.resize(size, Image.Resampling.BICUBIC)


def _vignette(img, strength=0.7):
    w, h = img.size
    grad = Image.radial_gradient("L").resize((w, h), Image.Resampling.BILINEAR)
    mask = grad.point(_lut(lambda i: 255 - ((i / 255.0) ** 1.6) * 255 * strength))
    return ImageChops.multiply(img, Image.merge("RGB", (mask, mask, mask)))


def _lift(img, amount=26):
    scale = (255.0 - amount) / 255.0
    return _curve(img, lambda i: amount + i * scale, lambda i: amount + i * scale, lambda i: amount + i * scale)


def _scanlines(img, step=3, darkness=0.78):
    w, h = img.size
    col = Image.new("L", (1, h))
    col.putdata([int(255 * darkness) if (y % step == 0) else 255 for y in range(h)])
    mask = col.resize((w, h), Image.Resampling.NEAREST)
    return ImageChops.multiply(img, Image.merge("RGB", (mask, mask, mask)))


def _channel_shift(img, pixels):
    r, g, b = img.split()
    shift = float(max(1.0, pixels))
    r = r.transform(r.size, Image.Transform.AFFINE, (1.0, 0.0, shift, 0.0, 1.0, 0.0))
    b = b.transform(b.size, Image.Transform.AFFINE, (1.0, 0.0, -shift, 0.0, 1.0, 0.0))
    return Image.merge("RGB", (r, g, b))


def _pixelate(img, factor):
    w, h = img.size
    tw = max(8, w // max(2, factor))
    th = max(8, h // max(2, factor))
    return img.resize((tw, th), Image.Resampling.NEAREST).resize((w, h), Image.Resampling.NEAREST)


def _rel(img, ratio, minimum=1.0):
    return max(minimum, min(img.size) * ratio)




def _p_blur(img, t):
    radius = _rel(img, 0.012, 1.2) * t
    if radius < 0.4:
        return img
    return img.filter(ImageFilter.GaussianBlur(radius=radius))


def _p_pixel(img, t):
    factor = 1.0 + 7.0 * t
    if factor < 1.6:
        return img
    return _pixelate(img, int(round(factor)))


def _p_deep_fried(img, t):
    factor = 1.0 + 99.0 * (t ** 2)
    out = _pixelate(img, int(round(factor))) if factor >= 2.0 else img
    return _enhance(out, contrast=1.0 + 1.5 * t, color=1.0 + 2.0 * t, sharpness=1.0 + 1.0 * t)


def _p_jpeg(img, t):
    quality = int(round(95 - 91 * (t ** 0.6)))
    buf = io.BytesIO()
    img.save(buf, format="JPEG", quality=max(1, min(95, quality)))
    buf.seek(0)
    crunched = Image.open(buf)
    crunched.load()
    return _enhance(crunched.convert("RGB"), color=1.0 + 0.6 * t, contrast=1.0 + 0.3 * t)


def _p_glitch(img, t):
    shift = _rel(img, 0.015, 2.0) * t
    if shift < 1.0:
        return img
    return _channel_shift(img, shift)


def _p_vhs(img, t):
    shift = _rel(img, 0.008, 1.5) * t
    out = _channel_shift(img, shift) if shift >= 1.0 else img
    out = _scanlines(out, step=3, darkness=1.0 - 0.22 * t)
    return _enhance(out, color=1.0 + 0.25 * t, contrast=1.0 + 0.1 * t)


def _p_posterize(img, t):
    bits = int(round(8 - 5 * t))
    if bits >= 8:
        return img
    return ImageOps.posterize(img, max(1, bits))


def _p_solarize(img, t):
    threshold = int(round(255 - 127 * t))
    if threshold >= 255:
        return img
    return ImageOps.solarize(img, max(0, threshold))


def _p_vignette(img, t):
    if t <= 0.01:
        return img
    return _vignette(img, 0.8 * t)


def _p_oil(img, t):
    if t < 0.15:
        return img
    size = 3 if t < 0.6 else 5
    bits = max(4, min(8, int(round(8 - 3 * t))))
    w, h = img.size
    scale = min(1.0, 1024.0 / max(w, h))
    work = img if scale >= 1.0 else img.resize(
        (max(1, int(w * scale)), max(1, int(h * scale))), Image.Resampling.BILINEAR)
    out = ImageOps.posterize(work.filter(ImageFilter.MedianFilter(size)), bits).filter(ImageFilter.SMOOTH)
    return out if scale >= 1.0 else out.resize((w, h), Image.Resampling.BICUBIC)


def _p_gigachad(img, t):
    gray = Image.blend(img, ImageOps.grayscale(img).convert("RGB"), t)
    return _enhance(gray, contrast=1.0 + 1.2 * t, sharpness=1.0 + 2.0 * t)


def _p_cursed(img, t):
    out = _enhance(img, color=1.0 + 1.6 * t, contrast=1.0 + 0.9 * t, sharpness=1.0 + 1.5 * t)
    out = Image.blend(out, _blend_mode(out, out.filter(ImageFilter.EMBOSS), "overlay"), t)
    return _vignette(out, t)


PARAMETRIC_FUNCS = {
    "blur": _p_blur,
    "pixel": _p_pixel,
    "deep_fried": _p_deep_fried,
    "jpeg": _p_jpeg,
    "glitch": _p_glitch,
    "vhs": _p_vhs,
    "posterize": _p_posterize,
    "solarize": _p_solarize,
    "vignette": _p_vignette,
    "oil": _p_oil,
    "gigachad": _p_gigachad,
    "cursed": _p_cursed,
}


def _f_auto(img):
    return ImageOps.autocontrast(img, cutoff=1)


def _f_grayscale(img):
    return ImageOps.grayscale(img).convert("RGB")


def _f_sepia(img):
    return ImageOps.colorize(ImageOps.grayscale(img), black="#704214", white="#C2B280")


def _f_invert(img):
    return ImageOps.invert(img)


def _f_bright(img):
    return _enhance(img, brightness=1.25, contrast=1.05)


def _f_dark(img):
    return _enhance(img, brightness=0.78, contrast=1.1)


def _f_contrast(img):
    return _enhance(img, contrast=1.45)


def _f_sharpen(img):
    return img.filter(ImageFilter.SHARPEN)


def _f_clarity(img):
    return img.filter(ImageFilter.UnsharpMask(radius=_rel(img, 0.004, 1.5), percent=160, threshold=3))


def _f_detail(img):
    return img.filter(ImageFilter.DETAIL)


def _f_smooth(img):
    return img.filter(ImageFilter.SMOOTH_MORE)


def _f_blur(img):
    return _p_blur(img, 1.0)


def _f_vignette(img):
    return _p_vignette(img, 1.0)


def _f_vivid(img):
    return _enhance(img, color=1.55, contrast=1.15)


def _f_punch(img):
    return _enhance(img, color=1.7, contrast=1.3, sharpness=1.3)


def _f_warm(img):
    return _curve(img, lambda i: i * 1.12 + 10, lambda i: i * 1.02 + 2, lambda i: i * 0.88)


def _f_cool(img):
    return _curve(img, lambda i: i * 0.86, lambda i: i * 1.02 + 4, lambda i: i * 1.18 + 12)


def _f_faded(img):
    return _enhance(_lift(img, 34), color=0.78, contrast=0.88)


def _f_matte(img):
    out = _curve(img, lambda i: 18 + i * 0.9, lambda i: 20 + i * 0.9, lambda i: 26 + i * 0.88)
    return _enhance(out, color=0.85)


def _f_pastel(img):
    return _enhance(_lift(img, 20), color=0.7, contrast=0.92, brightness=1.12)


def _f_mint(img):
    return _tint(_enhance(img, color=0.9), "#3DDC97", 0.38)


def _f_azure(img):
    return _tint(_enhance(img, color=0.95), "#2F6FED", 0.36)


def _f_rose(img):
    return _tint(_enhance(img, color=1.05), "#F2678C", 0.34)


def _f_duotone(img):
    return ImageOps.colorize(ImageOps.grayscale(img), black="#2B0F54", white="#FFB86B")


def _f_retro(img):
    return _curve(img, lambda i: i * 1.15 + 12, lambda i: i * 1.05 + 4, lambda i: i * 0.85)


def _f_polaroid(img):
    out = _curve(img, lambda i: i * 0.85, lambda i: i * 1.05 + 5, lambda i: i * 1.2 + 15)
    return _enhance(_lift(out, 22), contrast=0.95)


def _f_vintage(img):
    out = _split_tone(img, "#2A1D12", "#F4D9A6", 0.45)
    return _vignette(_enhance(out, color=0.72, contrast=1.08), 0.55)


def _f_lomo(img):
    return _vignette(_enhance(img, color=1.6, contrast=1.4), 0.95)


def _f_film70(img):
    out = _curve(_lift(img, 30), lambda i: i * 1.08 + 8, lambda i: i * 1.0 + 4, lambda i: i * 0.82)
    return _enhance(out, color=0.9, contrast=0.95)


def _f_kodak(img):
    out = _split_tone(img, "#1B2A1E", "#FFE3B0", 0.4)
    return _enhance(out, color=1.15, contrast=1.12)


def _f_crossprocess(img):
    return _curve(
        img,
        lambda i: i * 1.2 - 12,
        lambda i: i * 1.05 + 6,
        lambda i: i * 0.9 + 26,
    )


def _f_cinema(img):
    out = _split_tone(img, "#0B3B4A", "#FF9A4D", 0.5)
    return _enhance(out, contrast=1.18, color=1.05)


def _f_noir(img):
    gray = ImageOps.grayscale(img).convert("RGB")
    return _vignette(_enhance(gray, contrast=1.6), 0.85)


def _f_moonlight(img):
    out = _curve(img, lambda i: i * 0.8, lambda i: i * 0.9, lambda i: i * 1.15 + 18)
    return _enhance(out, brightness=0.9, contrast=1.15, color=0.8)


def _f_bleach(img):
    gray = ImageOps.grayscale(img).convert("RGB")
    out = _blend_mode(_enhance(img, color=0.45), gray, "overlay")
    return _enhance(out, contrast=1.25)


def _f_dramatic(img):
    return _vignette(_enhance(img, color=0.65, contrast=1.6, sharpness=1.4), 0.8)


def _f_horror(img):
    out = _curve(img, lambda i: i * 0.85, lambda i: i * 1.05, lambda i: i * 0.8)
    return _vignette(_enhance(out, contrast=1.45, color=0.7), 1.0)


def _f_cyberpunk(img):
    out = _split_tone(img, "#12043A", "#FF2ED1", 0.55)
    return _enhance(out, color=1.5, contrast=1.25)


def _f_sunshine(img):
    out = _enhance(img, color=1.4, brightness=1.1)
    return _curve(out, lambda i: i * 1.05 + 5)


def _f_golden(img):
    out = _split_tone(img, "#3A2410", "#FFC15E", 0.5)
    return _enhance(out, brightness=1.06, color=1.2)


def _f_sunset(img):
    layer = _gradient(img.size, [(255, 168, 76), (255, 96, 92), (108, 62, 148)], vertical=True)
    return Image.blend(img, _blend_mode(img, layer, "soft_light"), 0.55)


def _f_gold(img):
    return ImageOps.colorize(ImageOps.grayscale(img), black="#1F1410", white="#FFD700")


def _f_hdr(img):
    out = _enhance(img, contrast=1.4, sharpness=1.6)
    return out.filter(ImageFilter.UnsharpMask(radius=_rel(out, 0.006, 2.0), percent=120, threshold=2))


def _f_fresh(img):
    out = _curve(img, lambda i: i * 0.97, lambda i: i * 1.06 + 4, lambda i: i * 1.06 + 6)
    return _enhance(out, color=1.25, brightness=1.08)


def _f_haze(img):
    soft = img.filter(ImageFilter.GaussianBlur(radius=_rel(img, 0.02, 2.0)))
    return _enhance(Image.blend(img, soft, 0.45), brightness=1.1, contrast=0.9)


def _f_contour(img):
    return img.filter(ImageFilter.CONTOUR)


def _f_emboss(img):
    return img.filter(ImageFilter.EMBOSS)


def _f_edge_enhance(img):
    return img.filter(ImageFilter.EDGE_ENHANCE_MORE)


def _f_sketch(img):
    gray = ImageOps.grayscale(img)
    blur = gray.filter(ImageFilter.GaussianBlur(radius=_rel(img, 0.006, 1.5)))
    diff = ImageChops.difference(gray, blur)
    sketch = ImageOps.autocontrast(ImageOps.invert(diff), cutoff=1)
    return sketch.convert("RGB")


def _f_oil(img):
    return _p_oil(img, 1.0)


def _f_posterize(img):
    return _p_posterize(img, 1.0)


def _f_solarize(img):
    return _p_solarize(img, 1.0)


def _f_neon(img):
    return ImageOps.colorize(ImageOps.grayscale(img), black="#00FFFF", white="#FF00FF")


def _f_infrared(img):
    r, g, b = img.split()
    return _enhance(Image.merge("RGB", (b, r, g)), color=1.4, contrast=1.15)


def _f_xray(img):
    gray = ImageOps.invert(ImageOps.grayscale(img)).convert("RGB")
    return _tint(_enhance(gray, contrast=1.35), "#7FC8FF", 0.4)


def _f_popart(img):
    out = ImageOps.posterize(_enhance(img, color=1.8, contrast=1.5), 2)
    return _tint(out, "#FF00A8", 0.25)


def _f_deep_fried(img):
    return _p_deep_fried(img, 1.0)


def _f_glitch(img):
    return _p_glitch(img, 1.0)


def _f_pixel(img):
    return _p_pixel(img, 1.0)


def _f_thermal(img):
    r_lut, g_lut, b_lut = [], [], []
    for i in range(256):
        if i < 64:
            r_lut.append(0)
            g_lut.append(0)
            b_lut.append(int(i * 4))
        elif i < 128:
            r_lut.append(0)
            g_lut.append(int((i - 64) * 4))
            b_lut.append(255 - int((i - 64) * 4))
        elif i < 192:
            r_lut.append(int((i - 128) * 4))
            g_lut.append(255)
            b_lut.append(0)
        else:
            r_lut.append(255)
            g_lut.append(255 - int((i - 192) * 4))
            b_lut.append(int((i - 192) * 4))
    return img.convert("L").point(r_lut + g_lut + b_lut, "RGB")


def _f_gigachad(img):
    return _p_gigachad(img, 1.0)


def _f_vhs(img):
    return _p_vhs(img, 1.0)


def _f_jpeg(img):
    return _p_jpeg(img, 1.0)


def _f_rainbow(img):
    colors = [
        (255, 0, 0), (255, 154, 0), (208, 222, 33), (79, 220, 74),
        (63, 218, 216), (47, 201, 226), (28, 127, 238), (95, 21, 242),
        (186, 12, 248), (251, 7, 217),
    ]
    layer = _gradient(img.size, colors)
    return Image.blend(img, _blend_mode(img, layer, "soft_light"), 0.7)


def _f_cursed(img):
    return _p_cursed(img, 1.0)


