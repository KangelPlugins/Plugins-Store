def apply_filter(img, filter_key: str, intensity: float = 1.0):
    base = img if img.mode == "RGB" else img.convert("RGB")
    if not filter_key or filter_key == "original" or intensity <= 0.0:
        return base

    strength = min(1.0, float(intensity))

    parametric = PARAMETRIC_FUNCS.get(filter_key)
    if parametric is not None:
        out = parametric(base, strength)
        if out is None:
            return base
        if out.mode != "RGB":
            out = out.convert("RGB")
        if out.size != base.size:
            out = out.resize(base.size, Image.Resampling.LANCZOS)
        return out

    func = FILTER_FUNCS.get(filter_key)
    if func is None:
        return base

    out = func(base)
    if out is None:
        return base
    if out.mode != "RGB":
        out = out.convert("RGB")
    if out.size != base.size:
        out = out.resize(base.size, Image.Resampling.LANCZOS)
    if strength >= 1.0:
        return out
    return Image.blend(base, out, strength)


def draw_crop_overlay(img, box, show_grid=True):
    left, top, right, bottom = box
    out = ImageEnhance.Brightness(img).enhance(0.32)
    out.paste(img.crop(box), (left, top))

    draw = ImageDraw.Draw(out)
    line_w = max(2, int(min(img.size) * 0.004))
    thin = max(1, line_w // 2)
    white = (255, 255, 255)

    if show_grid:
        for i in (1, 2):
            x = left + (right - left) * i // 3
            y = top + (bottom - top) * i // 3
            draw.line([(x, top), (x, bottom)], fill=(255, 255, 255), width=thin)
            draw.line([(left, y), (right, y)], fill=(255, 255, 255), width=thin)

    draw.rectangle([left, top, right - 1, bottom - 1], outline=white, width=line_w)

    corner = max(10, int(min(right - left, bottom - top) * 0.13))
    cw = line_w * 3
    off = cw // 2
    for cx, cy, dx, dy in ((left, top, 1, 1), (right, top, -1, 1), (left, bottom, 1, -1), (right, bottom, -1, -1)):
        ax = cx + dx * off
        ay = cy + dy * off
        draw.line([(ax, ay), (ax + dx * corner, ay)], fill=white, width=cw)
        draw.line([(ax, ay), (ax, ay + dy * corner)], fill=white, width=cw)
    return out


def pil_to_android_bitmap(pil_img, format="JPEG", config_name=None, quality=88):
    try:
        buf = io.BytesIO()
        if format == "JPEG":
            pil_img.convert("RGB").save(buf, format="JPEG", quality=quality)
        else:
            pil_img.save(buf, format="PNG")
        byte_data = buf.getvalue()

        j_byte_array = jarray(jbyte)(byte_data)

        BitmapFactory = jclass("android.graphics.BitmapFactory")
        Options = jclass("android.graphics.BitmapFactory$Options")
        Config = jclass("android.graphics.Bitmap$Config")
        options = Options()
        if config_name:
            options.inPreferredConfig = getattr(Config, config_name)
        elif format == "JPEG":
            options.inPreferredConfig = Config.RGB_565
        else:
            options.inPreferredConfig = Config.ARGB_8888

        return BitmapFactory.decodeByteArray(j_byte_array, 0, len(j_byte_array), options)
    except Exception as e:
        dlog(f"[ImageFX+ JNI] pil_to_android_bitmap error: {e}")
        return None


def read_oriented_size(path):
    with Image.open(path) as im:
        w, h = im.size
        orientation = 1
        try:
            orientation = int(im.getexif().get(274, 1) or 1)
        except Exception:
            orientation = 1
    if orientation in (5, 6, 7, 8):
        w, h = h, w
    return w, h



class JavaRunnable(dynamic_proxy(find_class("java.lang.Runnable"))):
    def __init__(self, run_fn):
        super().__init__()
        self.run_fn = run_fn

    def run(self):
        self.run_fn()


class PreviewTouchListener(dynamic_proxy(jclass("android.view.View$OnTouchListener"))):
    def __init__(self, editor):
        super().__init__()
        self.editor = editor

    def onTouch(self, v, event):
        return self.editor.on_preview_touch(v, event)


class IntensityListener(dynamic_proxy(jclass("android.widget.SeekBar$OnSeekBarChangeListener"))):
    def __init__(self, editor):
        super().__init__()
        self.editor = editor

    def onProgressChanged(self, seek_bar, progress, from_user):
        self.editor.on_intensity_changed(int(progress), bool(from_user))

    def onStartTrackingTouch(self, seek_bar):
        self.editor.on_intensity_tracking(True)

    def onStopTrackingTouch(self, seek_bar):
        self.editor.on_intensity_tracking(False)


class CropInputWatcher(dynamic_proxy(jclass("android.text.TextWatcher"))):
    def __init__(self, editor, field):
        super().__init__()
        self.editor = editor
        self.field = field

    def beforeTextChanged(self, s, start, count, after):
        pass

    def onTextChanged(self, s, start, before, count):
        pass

    def afterTextChanged(self, s):
        try:
            self.editor.on_crop_input_changed(self.field, str(s.toString()))
        except Exception as e:
            dlog(f"[ImageFX+] crop watcher error: {e}")


class DialogDismissListener(dynamic_proxy(jclass("android.content.DialogInterface$OnDismissListener"))):
    def __init__(self, editor):
        super().__init__()
        self.editor = editor

    def onDismiss(self, dialog):
        self.editor.cleanup()



class ImageFXEditor:
    def __init__(self, activity, photo_path, preview_path, peer_id, is_from_viewer, plugin):
        self.activity = activity
        self.photo_path = photo_path
        self.preview_path = preview_path
        self.peer_id = peer_id
        self.is_from_viewer = is_from_viewer
        self.plugin = plugin

        self.mode = "filters"
        self.selected_filter = "original"
        self.selected_category = "all"
        self.intensity = plugin.default_intensity() / 100.0
        self.crop_rect = None
        self.crop_ratio_key = "free"
        self.crop_ratio = None
        self.show_grid = plugin.get_setting("crop_grid", True)

        self.preview_pil = None
        self.fast_pil = None
        self.original_bitmap = None
        self.displayed_bitmap = None
        self.thumb_bitmaps = {}

        self.filter_views = {}
        self.category_chips = {}
        self.ratio_chips = {}
        self.crop_inputs = {}
        self.tab_views = {}
        self._java_refs = []

        self._render_gen = 0
        self._thumb_gen = 0
        self._last_drag_render = 0.0
        self._suppress_input_sync = False
        self._dragging_intensity = False
        self._comparing = False
        self._alive = True
        self._render_lock = threading.Lock()
        self._render_event = threading.Event()
        self._render_request = None
        self._render_thread = None
        self.drag_mode = None
        self.drag_anchor = None
        self.drag_start_rect = None

        self.Dialog = jclass("android.app.Dialog")
        self.FrameLayout = jclass("android.widget.FrameLayout")
        self.LinearLayout = jclass("android.widget.LinearLayout")
        self.TextView = jclass("android.widget.TextView")
        self.EditText = jclass("android.widget.EditText")
        self.ImageView = jclass("android.widget.ImageView")
        self.SeekBar = jclass("android.widget.SeekBar")
        self.HorizontalScrollView = jclass("android.widget.HorizontalScrollView")
        self.ViewGroup = jclass("android.view.ViewGroup")
        self.View = jclass("android.view.View")
        self.Color = jclass("android.graphics.Color")
        self.Gravity = jclass("android.view.Gravity")
        self.TypedValue = jclass("android.util.TypedValue")
        self.MotionEvent = jclass("android.view.MotionEvent")
        self.Typeface = jclass("android.graphics.Typeface")
        self.InputType = jclass("android.text.InputType")
        self.ColorStateList = jclass("android.content.res.ColorStateList")

        self.src_size = (0, 0)
        try:
            self.src_size = read_oriented_size(photo_path)
        except Exception as e:
            dlog(f"[ImageFX+] Failed to read source size: {e}")

        AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
        self.status_bar_height = 0
        if AndroidUtilities:
            try:
                self.status_bar_height = int(getattr(AndroidUtilities, "statusBarHeight", 0))
            except Exception:
                pass
        if self.status_bar_height == 0:
            self.status_bar_height = self.dp(24)
        self.bottom_inset = 0


    def dp(self, val):
        return int(self.TypedValue.applyDimension(
            self.TypedValue.COMPLEX_UNIT_DIP,
            float(val),
            self.activity.getResources().getDisplayMetrics()
        ))

    def color(self, value):
        return self.Color.parseColor(value)

    def resolve_bottom_inset(self):
        try:
            decor = self.dialog.getWindow().getDecorView()
            insets = decor.getRootWindowInsets()
            if insets is not None:
                bottom = None
                try:
                    SdkVersion = jclass("android.os.Build$VERSION")
                    if int(SdkVersion.SDK_INT) >= 30:
                        InsetsType = jclass("android.view.WindowInsets$Type")
                        bottom = int(insets.getInsets(InsetsType.navigationBars()).bottom)
                except Exception:
                    bottom = None
                if bottom is None:
                    bottom = int(insets.getSystemWindowInsetBottom())
                return max(0, min(bottom, self.dp(60)))
        except Exception as e:
            dlog(f"[ImageFX+] window insets unavailable: {e}")

        AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
        if AndroidUtilities:
            try:
                cached = int(getattr(AndroidUtilities, "navigationBarHeight", 0))
                if cached > 0:
                    return min(cached, self.dp(60))
            except Exception:
                pass
        try:
            resources = self.activity.getResources()
            res_id = resources.getIdentifier("navigation_bar_height", "dimen", "android")
            if res_id > 0:
                return min(int(resources.getDimensionPixelSize(res_id)), self.dp(60))
        except Exception:
            pass
        return 0

    def apply_bottom_inset(self):
        try:
            self.bottom_inset = self.resolve_bottom_inset()
            self.rootView.setPadding(0, self.status_bar_height, 0, self.bottom_inset + self.dp(8))
        except Exception as e:
            dlog(f"[ImageFX+] apply_bottom_inset error: {e}")

    def create_card_background(self, fill_color, stroke_color, corner_radius, stroke_width=2):
        try:
            GradientDrawable = jclass("android.graphics.drawable.GradientDrawable")
            gd = GradientDrawable()
            gd.setShape(GradientDrawable.RECTANGLE)
            gd.setColor(fill_color)
            gd.setCornerRadius(float(corner_radius))
            if stroke_color != 0:
                gd.setStroke(self.dp(stroke_width), stroke_color)
            return gd
        except Exception as e:
            dlog(f"[ImageFX+ JNI] create_card_background error: {e}")
            return None

    def make_text(self, text, size_sp, color_value, bold=False):
        tv = self.TextView(self.activity)
        tv.setText(text)
        tv.setTextColor(color_value)
        tv.setTextSize(self.TypedValue.COMPLEX_UNIT_SP, float(size_sp))
        if bold:
            tv.setTypeface(self.Typeface.DEFAULT_BOLD)
        return tv

    def make_chip(self, text, selected, on_click):
        chip = self.make_text(text, 12, self.Color.WHITE if selected else self.color(COLOR_TEXT_DIM), selected)
        chip.setGravity(self.Gravity.CENTER)
        chip.setPadding(self.dp(14), self.dp(6), self.dp(14), self.dp(6))
        self.style_chip(chip, selected)
        params = self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.WRAP_CONTENT, self.dp(32))
        params.rightMargin = self.dp(8)
        chip.setLayoutParams(params)
        chip.setOnClickListener(OnClickListener(on_click))
        return chip

    def style_chip(self, chip, selected):
        fill = self.color(COLOR_ACCENT) if selected else self.color(COLOR_SURFACE)
        bg = self.create_card_background(fill, 0, self.dp(16))
        if bg:
            chip.setBackground(bg)
        chip.setTextColor(self.Color.WHITE if selected else self.color(COLOR_TEXT_DIM))
        chip.setTypeface(self.Typeface.DEFAULT_BOLD if selected else self.Typeface.DEFAULT)


    def show(self):
        R_style = jclass("android.R$style")
        self.dialog = self.Dialog(self.activity, R_style.Theme_Black_NoTitleBar)
        self.dialog.requestWindowFeature(jclass("android.view.Window").FEATURE_NO_TITLE)

        root = self.LinearLayout(self.activity)
        root.setOrientation(self.LinearLayout.VERTICAL)
        root.setBackgroundColor(self.color(COLOR_BG))
        root.setPadding(0, self.status_bar_height, 0, self.dp(8))
        root.setLayoutParams(self.ViewGroup.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.MATCH_PARENT))
        self.rootView = root

        root.addView(self.build_header())
        root.addView(self.build_preview())
        root.addView(self.build_bottom_panel())

        try:
            with Image.open(self.preview_path) as raw:
                self.preview_pil = raw.convert("RGB")
            w, h = self.preview_pil.size
            fast_scale = min(1.0, 560.0 / max(w, h))
            if fast_scale < 1.0:
                self.fast_pil = self.preview_pil.resize(
                    (max(1, int(w * fast_scale)), max(1, int(h * fast_scale))), Image.Resampling.BILINEAR)
            else:
                self.fast_pil = self.preview_pil
        except Exception as e:
            dlog(f"[ImageFX+] Preview loading failed: {e}")

        if self.src_size[0] <= 0 and self.preview_pil:
            self.src_size = self.preview_pil.size
        self.crop_rect = (0, 0, self.src_size[0], self.src_size[1])

        if self.preview_pil:
            self.original_bitmap = pil_to_android_bitmap(self.preview_pil)
            if self.original_bitmap:
                self.previewImageView.setImageBitmap(self.original_bitmap)

        self.build_carousel()
        self.sync_crop_inputs()
        self.update_intensity_row()
        self.request_thumbnails()

        self.dialog.setContentView(root)
        listener = DialogDismissListener(self)
        self._java_refs.append(listener)
        self.dialog.setOnDismissListener(listener)
        self.dialog.show()

        self._render_thread = threading.Thread(target=self._render_loop, daemon=True)
        self._render_thread.start()
        root.post(R(self.apply_bottom_inset))

    def build_header(self):
        header = self.LinearLayout(self.activity)
        header.setOrientation(self.LinearLayout.HORIZONTAL)
        header.setGravity(self.Gravity.CENTER_VERTICAL)
        header.setBackgroundColor(self.color(COLOR_BG))
        header.setLayoutParams(self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.dp(56)))

        close_btn = self.make_text("✕", 20, self.Color.WHITE)
        close_btn.setGravity(self.Gravity.CENTER)
        close_btn.setPadding(self.dp(16), 0, self.dp(16), 0)
        close_btn.setOnClickListener(OnClickListener(lambda v: self.dialog.dismiss()))
        header.addView(close_btn)

        self.titleText = self.make_text("Фильтры", 17, self.Color.WHITE, True)
        title_params = self.LinearLayout.LayoutParams(0, self.ViewGroup.LayoutParams.WRAP_CONTENT, 1.0)
        title_params.leftMargin = self.dp(4)
        self.titleText.setLayoutParams(title_params)
        header.addView(self.titleText)

        reset_btn = self.make_text("Сброс", 13, self.color(COLOR_TEXT_DIM))
        reset_btn.setGravity(self.Gravity.CENTER)
        reset_btn.setPadding(self.dp(12), self.dp(8), self.dp(12), self.dp(8))
        reset_btn.setOnClickListener(OnClickListener(lambda v: self.reset_all()))
        header.addView(reset_btn)

        send_btn = self.make_text("Отправить", 14, self.Color.WHITE, True)
        send_btn.setGravity(self.Gravity.CENTER)
        send_btn.setPadding(self.dp(16), self.dp(8), self.dp(16), self.dp(8))
        bg = self.create_card_background(self.color(COLOR_ACCENT), 0, self.dp(18))
        if bg:
            send_btn.setBackground(bg)
        send_params = self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.WRAP_CONTENT, self.ViewGroup.LayoutParams.WRAP_CONTENT)
        send_params.rightMargin = self.dp(12)
        send_params.leftMargin = self.dp(4)
        send_btn.setLayoutParams(send_params)
        send_btn.setOnClickListener(OnClickListener(lambda v: self.on_send_clicked()))
        header.addView(send_btn)
        return header

    def build_preview(self):
        container = self.FrameLayout(self.activity)
        container.setLayoutParams(self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, 0, 1.0))

        self.previewImageView = self.ImageView(self.activity)
        self.previewImageView.setScaleType(self.ImageView.ScaleType.FIT_CENTER)
        container.addView(self.previewImageView, self.FrameLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.MATCH_PARENT))

        self.originalIndicator = self.make_text("Оригинал", 12, self.Color.WHITE)
        self.originalIndicator.setPadding(self.dp(12), self.dp(6), self.dp(12), self.dp(6))
        ind_bg = self.create_card_background(self.color("#80000000"), 0, self.dp(14))
        if ind_bg:
            self.originalIndicator.setBackground(ind_bg)
        ind_params = self.FrameLayout.LayoutParams(
            self.ViewGroup.LayoutParams.WRAP_CONTENT, self.ViewGroup.LayoutParams.WRAP_CONTENT)
        ind_params.gravity = self.Gravity.TOP | self.Gravity.CENTER_HORIZONTAL
        ind_params.topMargin = self.dp(16)
        self.originalIndicator.setLayoutParams(ind_params)
        self.originalIndicator.setVisibility(self.View.GONE)
        container.addView(self.originalIndicator)

        self.cropSizeLabel = self.make_text("", 12, self.Color.WHITE)
        self.cropSizeLabel.setPadding(self.dp(12), self.dp(6), self.dp(12), self.dp(6))
        size_bg = self.create_card_background(self.color("#99000000"), 0, self.dp(14))
        if size_bg:
            self.cropSizeLabel.setBackground(size_bg)
        size_params = self.FrameLayout.LayoutParams(
            self.ViewGroup.LayoutParams.WRAP_CONTENT, self.ViewGroup.LayoutParams.WRAP_CONTENT)
        size_params.gravity = self.Gravity.BOTTOM | self.Gravity.CENTER_HORIZONTAL
        size_params.bottomMargin = self.dp(12)
        self.cropSizeLabel.setLayoutParams(size_params)
        self.cropSizeLabel.setVisibility(self.View.GONE)
        container.addView(self.cropSizeLabel)

        touch_listener = PreviewTouchListener(self)
        self._java_refs.append(touch_listener)
        self.previewImageView.setOnTouchListener(touch_listener)
        return container

    def build_bottom_panel(self):
        panel = self.LinearLayout(self.activity)
        panel.setOrientation(self.LinearLayout.VERTICAL)
        panel.setBackgroundColor(self.color(COLOR_PANEL))
        panel.setLayoutParams(self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.WRAP_CONTENT))

        panel.addView(self.build_intensity_row())
        panel.addView(self.build_category_row())
        panel.addView(self.build_carousel_scroll())
        panel.addView(self.build_crop_panel())
        panel.addView(self.build_tab_bar())
        return panel

    def build_intensity_row(self):
        row = self.LinearLayout(self.activity)
        row.setOrientation(self.LinearLayout.HORIZONTAL)
        row.setGravity(self.Gravity.CENTER_VERTICAL)
        row.setPadding(self.dp(16), self.dp(6), self.dp(16), self.dp(2))
        row.setLayoutParams(self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.WRAP_CONTENT))

        self.intensityTitle = self.make_text("Сила эффекта", 12, self.color(COLOR_TEXT_DIM))
        row.addView(self.intensityTitle, self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.WRAP_CONTENT, self.ViewGroup.LayoutParams.WRAP_CONTENT))

        self.intensitySeek = self.SeekBar(self.activity)
        self.intensitySeek.setMax(100)
        self.intensitySeek.setProgress(int(self.intensity * 100))
        try:
            accent = self.ColorStateList.valueOf(self.color(COLOR_ACCENT))
            self.intensitySeek.setProgressTintList(accent)
            self.intensitySeek.setThumbTintList(accent)
            self.intensitySeek.setProgressBackgroundTintList(
                self.ColorStateList.valueOf(self.color("#4D4D4D")))
        except Exception as e:
            dlog(f"[ImageFX+] SeekBar tint unsupported: {e}")
        seek_params = self.LinearLayout.LayoutParams(0, self.dp(38), 1.0)
        seek_params.leftMargin = self.dp(10)
        seek_params.rightMargin = self.dp(10)
        self.intensitySeek.setLayoutParams(seek_params)
        seek_listener = IntensityListener(self)
        self._java_refs.append(seek_listener)
        self.intensitySeek.setOnSeekBarChangeListener(seek_listener)
        row.addView(self.intensitySeek)

        self.intensityValue = self.make_text(f"{int(self.intensity * 100)}%", 13, self.color(COLOR_ACCENT), True)
        self.intensityValue.setGravity(self.Gravity.END)
        self.intensityValue.setMinWidth(self.dp(42))
        row.addView(self.intensityValue)

        self.intensityRow = row
        return row

    def build_category_row(self):
        scroll = self.HorizontalScrollView(self.activity)
        scroll.setHorizontalScrollBarEnabled(False)
        scroll.setLayoutParams(self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.WRAP_CONTENT))

        container = self.LinearLayout(self.activity)
        container.setOrientation(self.LinearLayout.HORIZONTAL)
        container.setPadding(self.dp(12), self.dp(6), self.dp(12), self.dp(6))

        for key, name in CATEGORIES:
            chip = self.make_chip(name, key == self.selected_category,
                                  lambda v, k=key: self.select_category(k))
            self.category_chips[key] = chip
            container.addView(chip)

        scroll.addView(container, self.ViewGroup.LayoutParams(
            self.ViewGroup.LayoutParams.WRAP_CONTENT, self.ViewGroup.LayoutParams.WRAP_CONTENT))
        self.categoryScroll = scroll
        return scroll

    def build_carousel_scroll(self):
        self.carouselScroll = self.HorizontalScrollView(self.activity)
        self.carouselScroll.setHorizontalScrollBarEnabled(False)
        self.carouselScroll.setLayoutParams(self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.dp(96)))

        self.carouselContainer = self.LinearLayout(self.activity)
        self.carouselContainer.setOrientation(self.LinearLayout.HORIZONTAL)
        self.carouselContainer.setPadding(self.dp(12), self.dp(4), self.dp(12), self.dp(4))
        self.carouselScroll.addView(self.carouselContainer, self.ViewGroup.LayoutParams(
            self.ViewGroup.LayoutParams.WRAP_CONTENT, self.ViewGroup.LayoutParams.MATCH_PARENT))
        return self.carouselScroll

    def build_crop_panel(self):
        panel = self.LinearLayout(self.activity)
        panel.setOrientation(self.LinearLayout.VERTICAL)
        panel.setVisibility(self.View.GONE)
        panel.setLayoutParams(self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.WRAP_CONTENT))

        ratio_scroll = self.HorizontalScrollView(self.activity)
        ratio_scroll.setHorizontalScrollBarEnabled(False)
        ratio_container = self.LinearLayout(self.activity)
        ratio_container.setOrientation(self.LinearLayout.HORIZONTAL)
        ratio_container.setPadding(self.dp(12), self.dp(8), self.dp(12), self.dp(6))
        for key, name, _ratio in CROP_RATIOS:
            chip = self.make_chip(name, key == self.crop_ratio_key,
                                  lambda v, k=key: self.select_ratio(k))
            self.ratio_chips[key] = chip
            ratio_container.addView(chip)
        ratio_scroll.addView(ratio_container, self.ViewGroup.LayoutParams(
            self.ViewGroup.LayoutParams.WRAP_CONTENT, self.ViewGroup.LayoutParams.WRAP_CONTENT))
        panel.addView(ratio_scroll, self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.WRAP_CONTENT))

        panel.addView(self.build_crop_input_row([("x", "X"), ("y", "Y")]))
        panel.addView(self.build_crop_input_row([("w", "Ширина"), ("h", "Высота")]))

        hint_row = self.LinearLayout(self.activity)
        hint_row.setOrientation(self.LinearLayout.HORIZONTAL)
        hint_row.setGravity(self.Gravity.CENTER_VERTICAL)
        hint_row.setPadding(self.dp(16), self.dp(2), self.dp(16), self.dp(8))

        self.cropHint = self.make_text("", 11, self.color(COLOR_TEXT_DIM))
        hint_row.addView(self.cropHint, self.LinearLayout.LayoutParams(
            0, self.ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

        center_btn = self.make_text("По центру", 12, self.color(COLOR_ACCENT), True)
        center_btn.setPadding(self.dp(10), self.dp(6), self.dp(10), self.dp(6))
        center_btn.setOnClickListener(OnClickListener(lambda v: self.center_crop()))
        hint_row.addView(center_btn)

        full_btn = self.make_text("Всё фото", 12, self.color(COLOR_ACCENT), True)
        full_btn.setPadding(self.dp(10), self.dp(6), self.dp(10), self.dp(6))
        full_btn.setOnClickListener(OnClickListener(lambda v: self.reset_crop()))
        hint_row.addView(full_btn)

        panel.addView(hint_row)
        self.cropPanel = panel
        return panel

    def build_crop_input_row(self, fields):
        row = self.LinearLayout(self.activity)
        row.setOrientation(self.LinearLayout.HORIZONTAL)
        row.setPadding(self.dp(12), self.dp(2), self.dp(12), self.dp(2))
        row.setLayoutParams(self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.WRAP_CONTENT))

        for field, label_text in fields:
            cell = self.LinearLayout(self.activity)
            cell.setOrientation(self.LinearLayout.HORIZONTAL)
            cell.setGravity(self.Gravity.CENTER_VERTICAL)
            cell_params = self.LinearLayout.LayoutParams(0, self.ViewGroup.LayoutParams.WRAP_CONTENT, 1.0)
            cell_params.leftMargin = self.dp(4)
            cell_params.rightMargin = self.dp(4)
            cell.setLayoutParams(cell_params)

            label = self.make_text(label_text, 12, self.color(COLOR_TEXT_DIM))
            label.setMinWidth(self.dp(56))
            cell.addView(label)

            field_input = self.EditText(self.activity)
            field_input.setInputType(self.InputType.TYPE_CLASS_NUMBER)
            field_input.setTextColor(self.Color.WHITE)
            field_input.setTextSize(self.TypedValue.COMPLEX_UNIT_SP, 14)
            field_input.setSingleLine(True)
            field_input.setGravity(self.Gravity.CENTER_VERTICAL)
            field_input.setPadding(self.dp(10), self.dp(8), self.dp(10), self.dp(8))
            field_input.setSelectAllOnFocus(True)
            bg = self.create_card_background(self.color(COLOR_SURFACE), 0, self.dp(8))
            if bg:
                field_input.setBackground(bg)
            input_params = self.LinearLayout.LayoutParams(
                0, self.ViewGroup.LayoutParams.WRAP_CONTENT, 1.0)
            field_input.setLayoutParams(input_params)
            watcher = CropInputWatcher(self, field)
            self._java_refs.append(watcher)
            field_input.addTextChangedListener(watcher)
            cell.addView(field_input)

            self.crop_inputs[field] = field_input
            row.addView(cell)
        return row

    def build_tab_bar(self):
        bar = self.LinearLayout(self.activity)
        bar.setOrientation(self.LinearLayout.HORIZONTAL)
        bar.setBackgroundColor(self.color(COLOR_BG))
        bar.setLayoutParams(self.LinearLayout.LayoutParams(
            self.ViewGroup.LayoutParams.MATCH_PARENT, self.dp(52)))

        for key, name in (("filters", "Фильтры"), ("crop", "Кадрирование")):
            tab = self.make_text(name, 13, self.Color.WHITE if key == self.mode else self.color(COLOR_TEXT_DIM),
                                 key == self.mode)
            tab.setGravity(self.Gravity.CENTER)
            tab.setLayoutParams(self.LinearLayout.LayoutParams(
                0, self.ViewGroup.LayoutParams.MATCH_PARENT, 1.0))
            tab.setOnClickListener(OnClickListener(lambda v, k=key: self.select_mode(k)))
            self.tab_views[key] = tab
            bar.addView(tab)
        return bar


    def build_carousel(self):
        for filter_key, filter_name, category in FILTERS:
            item = self.LinearLayout(self.activity)
            item.setOrientation(self.LinearLayout.VERTICAL)
            item.setGravity(self.Gravity.CENTER_HORIZONTAL)
            item_params = self.LinearLayout.LayoutParams(self.dp(74), self.ViewGroup.LayoutParams.WRAP_CONTENT)
            item_params.leftMargin = self.dp(3)
            item_params.rightMargin = self.dp(3)
            item.setLayoutParams(item_params)

            frame = self.FrameLayout(self.activity)
            frame.setLayoutParams(self.LinearLayout.LayoutParams(self.dp(58), self.dp(58)))
            frame.setPadding(self.dp(3), self.dp(3), self.dp(3), self.dp(3))

            thumb_view = self.ImageView(self.activity)
            thumb_view.setScaleType(self.ImageView.ScaleType.CENTER_CROP)
            thumb_view.setBackgroundColor(self.color(COLOR_SURFACE))
            frame.addView(thumb_view, self.FrameLayout.LayoutParams(
                self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.MATCH_PARENT))
            item.addView(frame)

            label = self.make_text(filter_name, 11, self.color(COLOR_TEXT_DIM))
            label.setGravity(self.Gravity.CENTER)
            label.setSingleLine(True)
            label_params = self.LinearLayout.LayoutParams(
                self.ViewGroup.LayoutParams.MATCH_PARENT, self.ViewGroup.LayoutParams.WRAP_CONTENT)
            label_params.topMargin = self.dp(5)
            label.setLayoutParams(label_params)
            item.addView(label)

            item.setOnClickListener(OnClickListener(lambda v, k=filter_key: self.select_filter(k)))
            self.carouselContainer.addView(item)
            self.filter_views[filter_key] = (item, frame, label, thumb_view, category)
            self.style_filter_item(filter_key)

    def style_filter_item(self, filter_key):
        views = self.filter_views.get(filter_key)
        if not views:
            return
        _item, frame, label, _thumb, _cat = views
        selected = filter_key == self.selected_filter
        border = self.color(COLOR_ACCENT) if selected else self.Color.TRANSPARENT
        bg = self.create_card_background(self.Color.TRANSPARENT, border, self.dp(10))
        if bg:
            frame.setBackground(bg)
        label.setTextColor(self.color(COLOR_ACCENT) if selected else self.color(COLOR_TEXT_DIM))
        label.setTypeface(self.Typeface.DEFAULT_BOLD if selected else self.Typeface.DEFAULT)

    def request_thumbnails(self):
        if not self.preview_pil:
            return
        self._thumb_gen += 1
        gen = self._thumb_gen
        source_pil = self.thumbnail_source()
        if source_pil is None:
            return

        ordered = [f for f in FILTERS if self.selected_category in ("all", f[2])]
        ordered += [f for f in FILTERS if f not in ordered]

        def work():
            batch = []
            for filter_key, _name, _cat in ordered:
                if gen != self._thumb_gen:
                    return
                try:
                    processed = apply_filter(source_pil, filter_key, 1.0)
                    bmp = pil_to_android_bitmap(self.round_thumb(processed), format="PNG", config_name="ARGB_8888")
                    if bmp:
                        batch.append((filter_key, bmp))
                except Exception as e:
                    dlog(f"[ImageFX+] thumbnail error for {filter_key}: {e}")
                if len(batch) >= 6:
                    self.post_thumbs(gen, batch)
                    batch = []
            if batch:
                self.post_thumbs(gen, batch)

        threading.Thread(target=work, daemon=True).start()

    def thumbnail_source(self):
        try:
            base = self.preview_pil
            if base is None:
                return None
            if not self.crop_is_full():
                base = base.crop(self.mapped_crop_box(base.size))
            return ImageOps.fit(base, (112, 112), Image.Resampling.LANCZOS)
        except Exception as e:
            dlog(f"[ImageFX+] thumbnail_source error: {e}")
            return None

    def round_thumb(self, pil_img):
        mask = Image.new("L", pil_img.size, 0)
        ImageDraw.Draw(mask).rounded_rectangle(
            (0, 0, pil_img.size[0] - 1, pil_img.size[1] - 1), radius=int(pil_img.size[0] * 0.14), fill=255)
        rounded = Image.new("RGBA", pil_img.size, (0, 0, 0, 0))
        rounded.paste(pil_img.convert("RGB"), (0, 0), mask=mask)
        return rounded

    def post_thumbs(self, gen, batch):
        def apply_batch():
            if gen != self._thumb_gen:
                for _key, bmp in batch:
                    try:
                        bmp.recycle()
                    except Exception:
                        pass
                return
            for filter_key, bmp in batch:
                views = self.filter_views.get(filter_key)
                if not views:
                    continue
                views[3].setImageBitmap(bmp)
                old = self.thumb_bitmaps.get(filter_key)
                self.thumb_bitmaps[filter_key] = bmp
                if old:
                    try:
                        old.recycle()
                    except Exception:
                        pass
        run_on_ui_thread(R(apply_batch))


    def crop_is_full(self):
        if not self.crop_rect:
            return True
        return self.crop_rect == (0, 0, self.src_size[0], self.src_size[1])

    def mapped_crop_box(self, size):
        src_w, src_h = self.src_size
        w, h = size
        if src_w <= 0 or src_h <= 0:
            return (0, 0, w, h)
        sx = float(w) / float(src_w)
        sy = float(h) / float(src_h)
        left, top, right, bottom = self.crop_rect
        box = (
            max(0, min(w - 1, int(left * sx))),
            max(0, min(h - 1, int(top * sy))),
            max(1, min(w, int(round(right * sx)))),
            max(1, min(h, int(round(bottom * sy)))),
        )
        left, top, right, bottom = box
        if right - left < 1:
            right = min(w, left + 1)
        if bottom - top < 1:
            bottom = min(h, top + 1)
        return (left, top, right, bottom)

    def clamp_rect(self, rect):
        src_w, src_h = self.src_size
        left, top, right, bottom = [int(round(v)) for v in rect]
        left = max(0, min(left, src_w - MIN_CROP_PX))
        top = max(0, min(top, src_h - MIN_CROP_PX))
        right = max(left + MIN_CROP_PX, min(right, src_w))
        bottom = max(top + MIN_CROP_PX, min(bottom, src_h))
        return (left, top, right, bottom)

    def set_crop_rect(self, rect, sync_inputs=True, fast=False):
        self.crop_rect = self.clamp_rect(rect)
        if sync_inputs:
            self.sync_crop_inputs()
        self.update_crop_labels()
        self.request_render(fast=fast)

    def sync_crop_inputs(self):
        if not self.crop_inputs or not self.crop_rect:
            return
        left, top, right, bottom = self.crop_rect
        values = {"x": left, "y": top, "w": right - left, "h": bottom - top}
        self._suppress_input_sync = True
        try:
            for field, value in values.items():
                view = self.crop_inputs.get(field)
                if view is None:
                    continue
                if str(view.getText().toString()) != str(value):
                    view.setText(str(value))
        finally:
            self._suppress_input_sync = False
        self.update_crop_labels()

    def update_crop_labels(self):
        if not self.crop_rect:
            return
        left, top, right, bottom = self.crop_rect
        w, h = right - left, bottom - top
        try:
            self.cropHint.setText(f"Исходник: {self.src_size[0]}×{self.src_size[1]} px")
            self.cropSizeLabel.setText(f"{w} × {h} px")
        except Exception:
            pass

    def on_crop_input_changed(self, field, raw_text):
        if self._suppress_input_sync or not self.crop_rect:
            return
        text = "".join(ch for ch in raw_text if ch.isdigit())
        if not text:
            return
        try:
            value = int(text)
        except ValueError:
            return

        left, top, right, bottom = self.crop_rect
        src_w, src_h = self.src_size
        if field == "x":
            width = right - left
            left = max(0, min(value, src_w - MIN_CROP_PX))
            right = min(src_w, left + width)
        elif field == "y":
            height = bottom - top
            top = max(0, min(value, src_h - MIN_CROP_PX))
            bottom = min(src_h, top + height)
        elif field == "w":
            right = left + max(MIN_CROP_PX, min(value, src_w - left))
        elif field == "h":
            bottom = top + max(MIN_CROP_PX, min(value, src_h - top))

        new_rect = self.clamp_rect((left, top, right, bottom))
        if self.crop_ratio and field in ("w", "h"):
            new_rect = self.fit_ratio(new_rect, self.crop_ratio, anchor="tl")
        if new_rect == self.crop_rect:
            return
        self.crop_rect = new_rect
        self.update_crop_labels()
        self.request_render(fast=False)

    def fit_ratio(self, rect, ratio, anchor="center"):
        src_w, src_h = self.src_size
        left, top, right, bottom = rect
        cx = (left + right) / 2.0
        cy = (top + bottom) / 2.0
        width = float(right - left)
        height = float(bottom - top)

        if width / max(1.0, height) > ratio:
            width = height * ratio
        else:
            height = width / ratio

        if width < MIN_CROP_PX:
            width = float(MIN_CROP_PX)
            height = width / ratio
        if height < MIN_CROP_PX:
            height = float(MIN_CROP_PX)
            width = height * ratio

        max_w = min(float(src_w), float(src_h) * ratio)
        max_h = max_w / ratio
        shrink = min(1.0, max_w / max(width, 1.0), max_h / max(height, 1.0))
        width *= shrink
        height *= shrink

        if anchor == "tl":
            new_left, new_top = left, top
        else:
            new_left, new_top = cx - width / 2.0, cy - height / 2.0

        new_left = max(0.0, min(new_left, src_w - width))
        new_top = max(0.0, min(new_top, src_h - height))
        return self.clamp_rect((new_left, new_top, new_left + width, new_top + height))

    def maximize_ratio(self, ratio):
        src_w, src_h = self.src_size
        left, top, right, bottom = self.crop_rect
        cx = (left + right) / 2.0
        cy = (top + bottom) / 2.0
        width = min(float(src_w), float(src_h) * ratio)
        height = width / ratio
        new_left = max(0.0, min(cx - width / 2.0, src_w - width))
        new_top = max(0.0, min(cy - height / 2.0, src_h - height))
        return self.clamp_rect((new_left, new_top, new_left + width, new_top + height))

    def select_ratio(self, ratio_key):
        entry = next((r for r in CROP_RATIOS if r[0] == ratio_key), None)
        if not entry:
            return
        self.crop_ratio_key = ratio_key
        raw_ratio = entry[2]
        if raw_ratio is None:
            self.crop_ratio = None
        elif raw_ratio < 0:
            self.crop_ratio = float(self.src_size[0]) / float(max(1, self.src_size[1]))
        else:
            self.crop_ratio = float(raw_ratio)

        for key, chip in self.ratio_chips.items():
            self.style_chip(chip, key == ratio_key)

        if self.crop_ratio:
            self.set_crop_rect(self.maximize_ratio(self.crop_ratio))
        else:
            self.request_render()

    def center_crop(self):
        left, top, right, bottom = self.crop_rect
        width, height = right - left, bottom - top
        src_w, src_h = self.src_size
        new_left = max(0, (src_w - width) // 2)
        new_top = max(0, (src_h - height) // 2)
        self.set_crop_rect((new_left, new_top, new_left + width, new_top + height))

    def reset_crop(self):
        self.crop_ratio_key = "free"
        self.crop_ratio = None
        for key, chip in self.ratio_chips.items():
            self.style_chip(chip, key == "free")
        self.set_crop_rect((0, 0, self.src_size[0], self.src_size[1]))


    def select_mode(self, mode):
        if self.mode == mode:
            return
        previous = self.mode
        self.mode = mode
        for key, tab in self.tab_views.items():
            selected = key == mode
            tab.setTextColor(self.Color.WHITE if selected else self.color(COLOR_TEXT_DIM))
            tab.setTypeface(self.Typeface.DEFAULT_BOLD if selected else self.Typeface.DEFAULT)

        crop_mode = mode == "crop"
        self.cropPanel.setVisibility(self.View.VISIBLE if crop_mode else self.View.GONE)
        self.categoryScroll.setVisibility(self.View.GONE if crop_mode else self.View.VISIBLE)
        self.carouselScroll.setVisibility(self.View.GONE if crop_mode else self.View.VISIBLE)
        self.intensityRow.setVisibility(self.View.GONE if crop_mode else self.View.VISIBLE)
        self.cropSizeLabel.setVisibility(self.View.VISIBLE if crop_mode else self.View.GONE)
        self.titleText.setText("Кадрирование" if crop_mode else "Фильтры")

        if crop_mode:
            self.sync_crop_inputs()
        elif previous == "crop":
            self.request_thumbnails()
        self.request_render()

    def select_category(self, category_key):
        if self.selected_category == category_key:
            return
        self.selected_category = category_key
        for key, chip in self.category_chips.items():
            self.style_chip(chip, key == category_key)
        for filter_key, views in self.filter_views.items():
            item, _frame, _label, _thumb, category = views
            visible = category_key == "all" or category == category_key
            item.setVisibility(self.View.VISIBLE if visible else self.View.GONE)
        try:
            self.carouselScroll.smoothScrollTo(0, 0)
        except Exception:
            pass

    def select_filter(self, filter_key):
        previous = self.selected_filter
        self.selected_filter = filter_key
        self.style_filter_item(previous)
        self.style_filter_item(filter_key)
        self.update_intensity_row()
        if previous != filter_key:
            self.request_render()

    def update_intensity_row(self):
        enabled = self.selected_filter != "original"
        alpha = 1.0 if enabled else 0.35
        for view in (self.intensitySeek, self.intensityTitle, self.intensityValue):
            try:
                view.setAlpha(float(alpha))
            except Exception:
                pass
        try:
            self.intensitySeek.setEnabled(bool(enabled))
        except Exception:
            pass

    def on_intensity_changed(self, progress, from_user):
        self.intensity = max(0.0, min(1.0, progress / 100.0))
        try:
            self.intensityValue.setText(f"{progress}%")
        except Exception:
            pass
        if not from_user or self.selected_filter == "original":
            return
        if self._dragging_intensity:
            now = time.monotonic()
            if now - self._last_drag_render < 0.09:
                return
            self._last_drag_render = now
            self.request_render(fast=True)
        else:
            self.request_render()

    def on_intensity_tracking(self, dragging):
        self._dragging_intensity = dragging
        if not dragging:
            self.request_render()

    def reset_all(self):
        previous = self.selected_filter
        self.selected_filter = "original"
        self.style_filter_item(previous)
        self.style_filter_item("original")
        self.intensity = self.plugin.default_intensity() / 100.0
        try:
            self.intensitySeek.setProgress(int(self.intensity * 100))
            self.intensityValue.setText(f"{int(self.intensity * 100)}%")
        except Exception:
            pass
        self.update_intensity_row()
        self.reset_crop()
        self.request_thumbnails()
        BulletinHelper.show_info("Изменения сброшены")


    def compose_preview(self, fast=False):
        base = self.fast_pil if (fast and self.fast_pil is not None) else self.preview_pil
        if base is None:
            return None
        if self.mode == "crop":
            filtered = apply_filter(base, self.selected_filter, self.intensity)
            return draw_crop_overlay(filtered, self.mapped_crop_box(filtered.size), self.show_grid)
        source = base if self.crop_is_full() else base.crop(self.mapped_crop_box(base.size))
        return apply_filter(source, self.selected_filter, self.intensity)

    def request_render(self, fast=False):
        with self._render_lock:
            self._render_gen += 1
            self._render_request = (self._render_gen, fast)
        self._render_event.set()

    def _render_loop(self):
        while True:
            self._render_event.wait()
            self._render_event.clear()
            if not self._alive:
                return
            with self._render_lock:
                request = self._render_request
                self._render_request = None
            if request is None:
                continue
            gen, fast = request
            try:
                pil = self.compose_preview(fast=fast)
                if pil is None or gen != self._render_gen:
                    continue
                bmp = pil_to_android_bitmap(pil, quality=78 if fast else 90)
                if bmp is None:
                    continue
                if gen != self._render_gen or not self._alive:
                    bmp.recycle()
                    continue
                run_on_ui_thread(R(lambda b=bmp, g=gen: self._publish_bitmap(b, g)))
            except Exception as e:
                dlog(f"[ImageFX+] render error: {e}\n{traceback.format_exc()}")

    def _publish_bitmap(self, bmp, gen):
        if gen != self._render_gen or not self._alive:
            try:
                bmp.recycle()
            except Exception:
                pass
            return
        old = self.displayed_bitmap
        self.displayed_bitmap = bmp
        if not self._comparing:
            self.previewImageView.setImageBitmap(bmp)
        if old is not None and old is not self.original_bitmap:
            try:
                old.recycle()
            except Exception:
                pass


    def view_to_source(self, view, x, y):
        if not self.preview_pil:
            return None
        vw = float(view.getWidth())
        vh = float(view.getHeight())
        iw, ih = self.preview_pil.size
        if vw <= 0 or vh <= 0 or iw <= 0 or ih <= 0:
            return None
        scale = min(vw / iw, vh / ih)
        off_x = (vw - iw * scale) / 2.0
        off_y = (vh - ih * scale) / 2.0
        px = (float(x) - off_x) / scale
        py = (float(y) - off_y) / scale
        src_w, src_h = self.src_size
        return (px * src_w / iw, py * src_h / ih, scale * iw / src_w)

    def on_preview_touch(self, view, event):
        if self.mode != "crop":
            return self.on_touch_compare(view, event)

        mapped = self.view_to_source(view, event.getX(), event.getY())
        if mapped is None:
            return False
        sx, sy, view_scale = mapped
        action = event.getAction()
        handle_px = self.dp(26) / max(view_scale, 0.0001)

        if action == self.MotionEvent.ACTION_DOWN:
            self.drag_start_rect = self.crop_rect
            self.drag_anchor = (sx, sy)
            self.drag_mode = self.detect_handle(sx, sy, handle_px)
            return True

        if action == self.MotionEvent.ACTION_MOVE and self.drag_mode:
            self.apply_drag(sx, sy)
            now = time.monotonic()
            if now - self._last_drag_render >= 0.07:
                self._last_drag_render = now
                self.request_render(fast=True)
            return True

        if action in (self.MotionEvent.ACTION_UP, self.MotionEvent.ACTION_CANCEL):
            if self.drag_mode:
                self.apply_drag(sx, sy)
                self.drag_mode = None
                self.sync_crop_inputs()
                self.request_render()
            return True
        return False

    def detect_handle(self, sx, sy, tolerance):
        left, top, right, bottom = self.crop_rect
        near_left = abs(sx - left) <= tolerance
        near_right = abs(sx - right) <= tolerance
        near_top = abs(sy - top) <= tolerance
        near_bottom = abs(sy - bottom) <= tolerance

        if near_left and near_top:
            return "tl"
        if near_right and near_top:
            return "tr"
        if near_left and near_bottom:
            return "bl"
        if near_right and near_bottom:
            return "br"
        if left <= sx <= right and top <= sy <= bottom:
            return "move"
        return "new"

    def apply_drag(self, sx, sy):
        if not self.drag_start_rect or not self.drag_anchor:
            return
        left, top, right, bottom = self.drag_start_rect
        ax, ay = self.drag_anchor
        src_w, src_h = self.src_size

        if self.drag_mode == "move":
            dx = sx - ax
            dy = sy - ay
            width = right - left
            height = bottom - top
            new_left = max(0, min(src_w - width, left + dx))
            new_top = max(0, min(src_h - height, top + dy))
            rect = (new_left, new_top, new_left + width, new_top + height)
        elif self.drag_mode == "new":
            rect = (min(ax, sx), min(ay, sy), max(ax, sx), max(ay, sy))
        else:
            new_left, new_top, new_right, new_bottom = left, top, right, bottom
            if "l" in self.drag_mode:
                new_left = min(sx, right - MIN_CROP_PX)
            if "r" in self.drag_mode:
                new_right = max(sx, left + MIN_CROP_PX)
            if "t" in self.drag_mode:
                new_top = min(sy, bottom - MIN_CROP_PX)
            if "b" in self.drag_mode:
                new_bottom = max(sy, top + MIN_CROP_PX)
            rect = (new_left, new_top, new_right, new_bottom)

        rect = self.clamp_rect(rect)
        if self.crop_ratio and self.drag_mode != "move":
            anchor = "tl" if self.drag_mode in ("br", "new") else "center"
            rect = self.fit_ratio(rect, self.crop_ratio, anchor=anchor)
        self.crop_rect = rect
        self.update_crop_labels()

    def on_touch_compare(self, v, event):
        action = event.getAction()
        if action == self.MotionEvent.ACTION_DOWN:
            if self.original_bitmap:
                self._comparing = True
                self.previewImageView.setImageBitmap(self.original_bitmap)
            self.originalIndicator.setVisibility(self.View.VISIBLE)
            return True
        if action in (self.MotionEvent.ACTION_UP, self.MotionEvent.ACTION_CANCEL):
            self._comparing = False
            active = self.displayed_bitmap if self.displayed_bitmap else self.original_bitmap
            if active:
                self.previewImageView.setImageBitmap(active)
            self.originalIndicator.setVisibility(self.View.GONE)
            return True
        return False


    def on_send_clicked(self):
        dlog(f"[ImageFX+] on_send_clicked filter={self.selected_filter} "
             f"intensity={self.intensity} crop={self.crop_rect}")
        filter_key = self.selected_filter
        intensity = self.intensity
        crop_rect = None if self.crop_is_full() else tuple(self.crop_rect)
        self.dialog.dismiss()

        if self.is_from_viewer:
            try:
                pv = PhotoViewerClass.getInstance()
                if pv:
                    pv.closePhoto(True, False)
                from client_utils import get_last_fragment
                last_fragment = get_last_fragment()
                if last_fragment:
                    last_fragment.dismissCurrentDialog()
                    f_class = last_fragment.getClass().getSimpleName()
                    if "PhotoPicker" in f_class or "Media" in f_class or "Gallery" in f_class:
                        last_fragment.finishFragment()
            except Exception as e:
                dlog(f"[ImageFX+ JNI] Error closing viewer: {e}")

        BulletinHelper.show_info("Обработка и отправка…")

        def bg_save():
            try:
                final_path = self.plugin.render_final_image(
                    self.photo_path, filter_key, intensity, crop_rect)
                dlog(f"[ImageFX+] Dispatching photo to peer {self.peer_id} at: {final_path}")
                self.plugin.send_processed_image(self.peer_id, final_path)
            except Exception as ex:
                dlog(f"[ImageFX+ JNI] bg_save error: {ex}\n{traceback.format_exc()}")
                run_on_ui_thread(R(lambda: BulletinHelper.show_error("Ошибка обработки изображения.")))

        threading.Thread(target=bg_save, daemon=True).start()

    def cleanup(self):
        dlog("[ImageFX+ JNI] Cleaning up dialog resources...")
        self._alive = False
        self._render_gen += 1
        self._thumb_gen += 1
        self._render_request = None
        self._render_event.set()
        self._comparing = False

        try:
            self.previewImageView.setImageBitmap(None)
        except Exception:
            pass
        for filter_key, views in self.filter_views.items():
            try:
                views[3].setImageBitmap(None)
            except Exception:
                pass

        for bmp in (self.original_bitmap, self.displayed_bitmap):
            if bmp:
                try:
                    bmp.recycle()
                except Exception:
                    pass
        self.original_bitmap = None
        self.displayed_bitmap = None
        for bmp in self.thumb_bitmaps.values():
            try:
                bmp.recycle()
            except Exception:
                pass
        self.thumb_bitmaps.clear()

        self.preview_pil = None
        self.fast_pil = None
        self.filter_views.clear()
        self.category_chips.clear()
        self.ratio_chips.clear()
        self.crop_inputs.clear()
        self.tab_views.clear()
        self._java_refs = []

        self.plugin.discard_temp_file(self.preview_path)


class OpenPhotoHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            dlog("[ImageFX+] PhotoViewer.openPhoto method intercepted. Setup send button long click...")

            def setup():
                pv = PhotoViewerClass.getInstance()
                if pv:
                    send_btn = get_private_field(pv, "pickerViewSendButton")
                    if send_btn:
                        self.plugin.setup_send_button_long_click(send_btn)
            run_on_ui_thread(R(setup))
        except Exception as e:
            dlog(f"[ImageFX+] OpenPhotoHook error: {e}\n{traceback.format_exc()}")


class ImageFXPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.menu_id = None
        self.hooks_list = []
        self.hooked_buttons = set()
        self.hooked_buttons_listeners = {}
        self.temp_files = []
        self.temp_dir = None


    def create_settings(self) -> List[Any]:
        return [
            Header(text="Редактор"),
            Selector(
                key="default_intensity",
                text="Сила эффекта по умолчанию",
                default=3,
                items=[f"{v}%" for v in DEFAULT_INTENSITIES],
                icon="msg_photo_settings",
            ),
            Switch(
                key="crop_grid",
                text="Сетка при кадрировании",
                default=True,
                subtext="Направляющие по правилу третей",
                icon="media_crop",
            ),
            Divider(),
            Header(text="Отправка"),
            Selector(
                key="output_size",
                text="Максимальный размер",
                default=2,
                items=["1280 px", "2048 px", "2560 px", "Оригинал"],
                icon="msg_photo_settings",
            ),
            Divider(text="Больший размер — выше качество и дольше обработка."),
            Text(
                text="Как пользоваться",
                subtext="Долгое нажатие на кнопку отправки в галерее или пункт «Редактор ImageFX» в меню сообщения.",
                icon="msg_info",
            ),
        ]

    def default_intensity(self) -> int:
        try:
            index = int(self.get_setting("default_intensity", 3))
        except Exception:
            index = 3
        if index < 0 or index >= len(DEFAULT_INTENSITIES):
            index = 3
        return DEFAULT_INTENSITIES[index]

    def max_output_side(self) -> int:
        try:
            index = int(self.get_setting("output_size", 2))
        except Exception:
            index = 2
        if index < 0 or index >= len(MAX_OUTPUT_SIDES):
            index = 2
        return MAX_OUTPUT_SIDES[index]


    def on_plugin_load(self):
        dlog("[ImageFX+] Plugin load initiated.")
        self.hooks_list = []
        self.hooked_buttons = set()
        self.hooked_buttons_listeners = {}
        self.temp_files = []
        self.temp_dir = self._get_temp_dir()
        self.prune_temp_files()

        try:
            self.menu_id = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text="Редактор ImageFX",
                icon="msg_edit",
                on_click=self.on_message_click,
                priority=100
            ))
            dlog("[ImageFX+] Message context menu item registered.")
        except Exception as e:
            dlog(f"[ImageFX+] Context menu registration failed: {e}\n{traceback.format_exc()}")

        try:
            photo_viewer_class = _to_class(PhotoViewerClass)
            hooked_open = False
            for m in photo_viewer_class.getDeclaredMethods():
                if m.getName() == "openPhoto" and len(m.getParameterTypes()) >= 10:
                    m.setAccessible(True)
                    self.hooks_list.append(self.hook_method(m, OpenPhotoHook(self)))
                    hooked_open = True
            if hooked_open:
                dlog("[ImageFX+] PhotoViewer.openPhoto hook injected.")
            else:
                dlog("[ImageFX+] Failed to find PhotoViewer.openPhoto method signature.")
        except Exception as e:
            dlog(f"[ImageFX+] Hooking PhotoViewer failed: {e}\n{traceback.format_exc()}")

        try:
            pv = PhotoViewerClass.getInstance()
            if pv:
                send_btn = get_private_field(pv, "pickerViewSendButton")
                if send_btn:
                    self.setup_send_button_long_click(send_btn)
        except Exception as e:
            dlog(f"[ImageFX+] Pre-hook view check failed: {e}")

    def on_plugin_unload(self):
        dlog("[ImageFX+] Unloading plugin hooks...")
        if self.menu_id:
            try:
                self.remove_menu_item(self.menu_id)
            except Exception as e:
                dlog(f"[ImageFX+] Failed to remove menu item: {e}")
            self.menu_id = None

        for h in self.hooks_list:
            try:
                self.unhook_method(h)
            except Exception as e:
                dlog(f"[ImageFX+] Failed to unhook Xposed hook: {e}")
        self.hooks_list = []

        for btn, orig_listener in self.hooked_buttons_listeners.items():
            try:
                btn.setOnLongClickListener(orig_listener)
            except Exception as e:
                dlog(f"[ImageFX+] Error restoring original long click listener: {e}")

        self.hooked_buttons.clear()
        self.hooked_buttons_listeners.clear()
        self._cleanup_temp_files()
        dlog("[ImageFX+] Plugin unloaded successfully.")

    def setup_send_button_long_click(self, send_btn):
        try:
            btn_hash = hash(send_btn)
            if btn_hash in self.hooked_buttons:
                return

            dlog("[ImageFX+] Overriding send button long click listener...")
            orig_listener = None
            listener_info = get_private_field(send_btn, "mListenerInfo")
            if listener_info:
                try:
                    orig_listener = get_private_field(listener_info, "mOnLongClickListener")
                except Exception:
                    pass

            def custom_long_click(view):
                dlog("[ImageFX+] Send button long-pressed in PhotoViewer.")
                try:
                    pv = PhotoViewerClass.getInstance()
                    if not pv:
                        dlog("[ImageFX+] PhotoViewer instance is null.")
                        return False

                    is_video = get_private_field(pv, "isCurrentVideo") or False
                    if is_video:
                        dlog("[ImageFX+] Selected media is video, forwarding to original send menu.")
                        if orig_listener:
                            return orig_listener.onLongClick(view)
                        return False

                    imagesArrLocals = get_private_field(pv, "imagesArrLocals")
                    currentIndex = get_private_field(pv, "currentIndex") or 0
                    dlog(f"[ImageFX+] Image collection size: {imagesArrLocals.size() if imagesArrLocals else 'None'}, current index: {currentIndex}")

                    path = None
                    if imagesArrLocals and 0 <= currentIndex < imagesArrLocals.size():
                        entry = imagesArrLocals.get(currentIndex)
                        if entry:
                            path = getattr(entry, "path", None) or getattr(entry, "imagePath", None)

                    if not path:
                        path = get_private_field(pv, "currentPathObject")

                    dlog(f"[ImageFX+] Path extracted from PhotoViewer: {path}")
                    if not path:
                        BulletinHelper.show_error("Не удалось найти путь к изображению.")
                        return True

                    if path.startswith("content://"):
                        path = self._copy_uri_to_cache(path)
                        dlog(f"[ImageFX+] Copied content URI to cache path: {path}")

                    if path and os.path.exists(path):
                        parentChatActivity = get_private_field(pv, "parentChatActivity")
                        peer_id = 0
                        if parentChatActivity:
                            peer_id = parentChatActivity.getDialogId()

                        dlog("[ImageFX+] Showing drop-down action menu next to send button...")
                        self.show_custom_menu(view, path, peer_id, pv)
                        return True
                    else:
                        dlog(f"[ImageFX+] Path does not exist locally: {path}")
                        BulletinHelper.show_error("Изображение недоступно на диске.")
                        return True
                except Exception as ex:
                    dlog(f"[ImageFX+] custom_long_click error: {ex}\n{traceback.format_exc()}")
                    return False

            send_btn.setOnLongClickListener(OnLongClickListener(custom_long_click))
            self.hooked_buttons.add(btn_hash)
            self.hooked_buttons_listeners[send_btn] = orig_listener
            dlog("[ImageFX+] Hooked send button successfully.")
        except Exception as e:
            dlog(f"[ImageFX+] Overriding long click listener failed: {e}\n{traceback.format_exc()}")

    def show_custom_menu(self, view, path, peer_id, pv):
        try:
            ItemOptionsClass = find_class("org.telegram.ui.Components.ItemOptions")
            DarkThemeResourceProvider = find_class("org.telegram.ui.Stories.DarkThemeResourceProvider")
            dtrp = DarkThemeResourceProvider()
            containerView = get_private_field(pv, "containerView")

            options = ItemOptionsClass.makeOptions(containerView, dtrp, view)

            msg_edit_res = int(getattr(R_drawable, "msg_edit", 0))
            options.add(msg_edit_res, "Редактировать в ImageFX",
                        JavaRunnable(lambda: self.on_menu_edit_clicked(options, path, peer_id, pv)))

            parentChatActivity = get_private_field(pv, "parentChatActivity")
            user = None
            canScheduleMessage = False
            if parentChatActivity:
                try:
                    user = parentChatActivity.getCurrentUser()
                    canScheduleMessage = parentChatActivity.canScheduleMessage()
                except Exception:
                    pass

            userIsSelf = False
            if user:
                try:
                    UserObject = find_class("org.telegram.messenger.UserObject")
                    userIsSelf = UserObject.isUserSelf(user)
                except Exception:
                    pass

            showSchedule = canScheduleMessage
            showWithoutSound = not userIsSelf

            if showWithoutSound:
                input_notify_off_res = int(getattr(R_drawable, "input_notify_off", 0))
                options.add(input_notify_off_res, self.get_locale_string("SendWithoutSound"),
                            JavaRunnable(lambda: self.on_send_without_sound_clicked(options)))

            if showSchedule:
                msg_calendar2_res = int(getattr(R_drawable, "msg_calendar2", 0))
                key_schedule = "SetReminder" if userIsSelf else "ScheduleMessage"
                options.add(msg_calendar2_res, self.get_locale_string(key_schedule),
                            JavaRunnable(lambda: self.on_schedule_clicked(options)))

            Gravity = find_class("android.view.Gravity")
            gravity_right = int(getattr(Gravity, "RIGHT", 5))
            options.setGravity(gravity_right).show()
            dlog("[ImageFX+] Menu displayed successfully next to send button.")
        except Exception as e:
            dlog(f"[ImageFX+] show_custom_menu error: {e}\n{traceback.format_exc()}")

    def on_menu_edit_clicked(self, options, path, peer_id, pv):
        try:
            options.dismiss()
            parentChatActivity = get_private_field(pv, "parentChatActivity")
            self.launch_editor(parentChatActivity, path, peer_id, True)
        except Exception as e:
            dlog(f"[ImageFX+] on_menu_edit_clicked error: {e}")

    def on_send_without_sound_clicked(self, options):
        try:
            options.dismiss()
            self.trigger_send_without_sound()
        except Exception as e:
            dlog(f"[ImageFX+] on_send_without_sound_clicked error: {e}")

    def on_schedule_clicked(self, options):
        try:
            options.dismiss()
            pv = PhotoViewerClass.getInstance()
            if pv:
                self.resolve_schedule_dialog(pv)
        except Exception as e:
            dlog(f"[ImageFX+] on_schedule_clicked error: {e}")

    def get_locale_string(self, key):
        try:
            R_string = find_class("org.telegram.messenger.R$string")
            res_id = int(getattr(R_string, key, 0))
            if res_id != 0:
                return LocaleControllerClass.getString(key, res_id)
        except Exception:
            pass
        fallbacks = {
            "SetReminder": "Set Reminder",
            "ScheduleMessage": "Schedule Message",
            "SendWithoutSound": "Send Without Sound"
        }
        return fallbacks.get(key, key)

    def trigger_send_without_sound(self):
        try:
            pv = PhotoViewerClass.getInstance()
            if not pv:
                return
            try:
                self.resolve_send_pressed(pv, (False, 0, 0))
                return
            except Exception:
                pass
            try:
                self.resolve_send_pressed(pv, (False, 0, 0, False, False, False))
                return
            except Exception as e6:
                dlog(f"[ImageFX+] Failed to trigger sendPressed: {e6}")
        except Exception as e:
            dlog(f"[ImageFX+] trigger_send_without_sound critical error: {e}\n{traceback.format_exc()}")

    def resolve_send_pressed(self, pv, args):
        Boolean_TYPE = find_class("java.lang.Boolean").TYPE
        Integer_TYPE = find_class("java.lang.Integer").TYPE
        if len(args) == 3:
            sig = [Boolean_TYPE, Integer_TYPE, Integer_TYPE]
        elif len(args) == 6:
            sig = [Boolean_TYPE, Integer_TYPE, Integer_TYPE, Boolean_TYPE, Boolean_TYPE, Boolean_TYPE]
        else:
            raise ValueError("Invalid args size")

        photo_viewer_class = _to_class(PhotoViewerClass)
        try:
            m = photo_viewer_class.getDeclaredMethod("sendPressed", *sig)
            m.setAccessible(True)
            java_args = self.to_java_args_for_method(m, args)
            return m.invoke(pv, java_args)
        except Exception:
            pass

        for m in photo_viewer_class.getDeclaredMethods():
            name = m.getName()
            if name.startswith("lambda$") or name.startswith("access$"):
                continue
            if m.getReturnType().getName() == "void":
                m_params = m.getParameterTypes()
                if len(m_params) == len(sig):
                    match = True
                    for p_actual, p_expected in zip(m_params, sig):
                        if p_actual != p_expected:
                            match = False
                            break
                    if match:
                        m.setAccessible(True)
                        java_args = self.to_java_args_for_method(m, args)
                        return m.invoke(pv, java_args)
        raise AttributeError("sendPressed method not found")

    def resolve_schedule_dialog(self, pv):
        Object = find_class("java.lang.Object")
        empty_args = jarray(Object)([])
        photo_viewer_class = _to_class(PhotoViewerClass)
        try:
            m = photo_viewer_class.getDeclaredMethod("showScheduleDatePickerDialog")
            m.setAccessible(True)
            return m.invoke(pv, empty_args)
        except Exception:
            pass
        for m in photo_viewer_class.getDeclaredMethods():
            name = m.getName()
            if name.startswith("lambda$") or name.startswith("access$"):
                continue
            if m.getReturnType().getName() == "void" and len(m.getParameterTypes()) == 0:
                if any(x in name.lower() for x in ["schedule", "date", "picker"]):
                    m.setAccessible(True)
                    return m.invoke(pv, empty_args)
        raise AttributeError("showScheduleDatePickerDialog method not found")

    def to_java_args_for_method(self, method, args):
        Integer = find_class("java.lang.Integer")
        Boolean = find_class("java.lang.Boolean")
        Long = find_class("java.lang.Long")
        Object = find_class("java.lang.Object")
        param_types = method.getParameterTypes()
        wrapped_args = []
        for i, x in enumerate(args):
            if i >= len(param_types):
                wrapped_args.append(x)
                continue
            p_type = param_types[i].getName()
            if p_type == "long":
                wrapped_args.append(Long(int(x)))
            elif p_type == "int":
                wrapped_args.append(Integer(int(x)))
            elif p_type == "boolean":
                wrapped_args.append(Boolean(bool(x)))
            else:
                wrapped_args.append(x)
        return jarray(Object)(wrapped_args)

    def on_message_click(self, ctx):
        dlog("[ImageFX+] Message context menu clicked.")
        try:
            msg = ctx.get("message")
            fragment = ctx.get("fragment")
            if msg and fragment:
                if not self._has_photo(msg):
                    BulletinHelper.show_error("Это сообщение не содержит изображение.")
                    return
                activity = fragment.getParentActivity() if fragment else None
                peer_id = msg.getDialogId()
                dlog(f"[ImageFX+] Message dialog ID: {peer_id}, initiating download...")
                BulletinHelper.show_info("Загрузка оригинального изображения...")

                def bg_download():
                    try:
                        path = self._download_photo_sync(msg)
                        if path and os.path.exists(path):
                            dlog(f"[ImageFX+] Message photo downloaded: {path}")
                            run_on_ui_thread(R(lambda: self.launch_editor(activity, path, peer_id, False)))
                        else:
                            run_on_ui_thread(R(lambda: BulletinHelper.show_error("Не удалось скачать фото.")))
                    except Exception as e:
                        message = f"Ошибка загрузки: {e}"
                        dlog(f"[ImageFX+] bg_download error: {e}\n{traceback.format_exc()}")
                        run_on_ui_thread(R(lambda: BulletinHelper.show_error(message)))

                threading.Thread(target=bg_download, daemon=True).start()
        except Exception as e:
            dlog(f"[ImageFX+] on_message_click error: {e}\n{traceback.format_exc()}")

    def launch_editor(self, activity, photo_path, peer_id, is_from_viewer):
        dlog(f"[ImageFX+] launch_editor initiated. activity={activity}, path={photo_path}, peer={peer_id}")

        if activity and hasattr(activity, "getParentActivity"):
            dlog("[ImageFX+] Activity parameter is a fragment. Extracting parent activity...")
            try:
                activity = activity.getParentActivity()
            except Exception as e:
                dlog(f"[ImageFX+] Failed to get parent activity from fragment: {e}")

        if not activity:
            dlog("[ImageFX+] Activity is null. Resolving last visible fragment...")
            try:
                from client_utils import get_last_fragment
                fragment = get_last_fragment()
                if fragment:
                    activity = fragment.getParentActivity()
            except Exception as e:
                dlog(f"[ImageFX+] Failed fallback activity resolution: {e}")

        dlog(f"[ImageFX+] Final resolved Android activity instance: {activity}")
        if not activity:
            dlog("[ImageFX+] Critical error: activity context could not be resolved.")
            BulletinHelper.show_error("Не удалось определить active Activity.")
            return

        self.prune_temp_files()

        preview_name = f"editor_preview_{uuid.uuid4()}.jpg"
        preview_path = os.path.join(self.temp_dir.getAbsolutePath(), preview_name)
        dlog(f"[ImageFX+] Resizing original image to: {preview_path}")

        try:
            with Image.open(photo_path) as raw:
                img = ImageOps.exif_transpose(raw)
                w, h = img.size
                scale = min(1024.0 / w, 1024.0 / h)
                if scale < 1.0:
                    img = img.resize((int(w * scale), int(h * scale)), Image.Resampling.LANCZOS)
                img.convert("RGB").save(preview_path, "JPEG", quality=90)
            self.temp_files.append(preview_path)
            dlog(f"[ImageFX+] Saved 1024px preview image at: {preview_path}")
        except Exception as e:
            dlog(f"[ImageFX+] Preview generation failed: {e}\n{traceback.format_exc()}")
            BulletinHelper.show_error("Не удалось подготовить изображение.")
            return

        try:
            editor = ImageFXEditor(activity, photo_path, preview_path, peer_id, is_from_viewer, self)
            editor.show()
            dlog("[ImageFX+] Python-based ImageFXEditor displayed successfully.")
        except Exception as e:
            dlog(f"[ImageFX+] launch_editor error: {e}\n{traceback.format_exc()}")
            BulletinHelper.show_error("Не удалось запустить редактор.")


    def apply_filter_to_file(self, filepath_or_img: Any, filter_key: str, intensity: float = 1.0) -> Optional[Any]:
        try:
            if isinstance(filepath_or_img, str):
                img = Image.open(filepath_or_img)
                img = ImageOps.exif_transpose(img)
            else:
                img = filepath_or_img
            return apply_filter(img, filter_key, intensity)
        except Exception as e:
            dlog(f"[ImageFX+] Filter processing failed: {e}\n{traceback.format_exc()}")
            return None

    def render_final_image(self, source_path: str, filter_key: str, intensity: float, crop_rect) -> str:
        max_side = self.max_output_side()
        needs_filter = bool(filter_key) and filter_key != "original" and intensity > 0

        if not crop_rect and not needs_filter:
            try:
                width, height = read_oriented_size(source_path)
            except Exception:
                width = height = 0
            if max_side <= 0 or (width and max(width, height) <= max_side):
                return source_path

        with Image.open(source_path) as raw:
            img = ImageOps.exif_transpose(raw).convert("RGB")

        if crop_rect:
            left, top, right, bottom = [int(v) for v in crop_rect]
            left = max(0, min(left, img.size[0] - 1))
            top = max(0, min(top, img.size[1] - 1))
            right = max(left + 1, min(right, img.size[0]))
            bottom = max(top + 1, min(bottom, img.size[1]))
            img = img.crop((left, top, right, bottom))

        if max_side > 0 and max(img.size) > max_side:
            scale = float(max_side) / float(max(img.size))
            img = img.resize(
                (max(1, int(img.size[0] * scale)), max(1, int(img.size[1] * scale))),
                Image.Resampling.LANCZOS)

        if needs_filter:
            img = apply_filter(img, filter_key, intensity)

        out_name = f"final_fx_{uuid.uuid4()}.jpg"
        final_path = os.path.join(self.temp_dir.getAbsolutePath(), out_name)
        img.save(final_path, "JPEG", quality=95, subsampling=0)
        self.temp_files.append(final_path)
        dlog(f"[ImageFX+] Final image rendered: {final_path} size={img.size}")
        return final_path

    def send_processed_image(self, peer_id: int, image_path: str):
        try:
            dlog(f"[ImageFX+] Generating Telegram sizes and sending to peer: {peer_id}...")
            send_helper = get_send_messages_helper()
            generated_photo = send_helper.generatePhotoSizes(image_path, None)
            if not generated_photo:
                run_on_ui_thread(R(lambda: BulletinHelper.show_error("Ошибка генерации превью фото.")))
                return

            send_message({
                "peer": peer_id,
                "photo": generated_photo,
                "path": image_path,
                "replyToMsg": None,
                "asRound": False,
                "silent": False,
                "scheduleDate": 0,
                "ttl": 0,
                "sendAsGiga": False
            })
            run_on_ui_thread(R(lambda: BulletinHelper.show_success("Фотография успешно отправлена!")))
            dlog("[ImageFX+] Message sent successfully.")
        except Exception as e:
            dlog(f"[ImageFX+] Error sending message: {e}\n{traceback.format_exc()}")
            run_on_ui_thread(R(lambda: BulletinHelper.show_error("Не удалось отправить фото.")))

    def _has_photo(self, message_obj: MessageObject) -> bool:
        if not message_obj or not message_obj.messageOwner:
            return False
        media = message_obj.messageOwner.media
        return isinstance(media, TLRPC.TL_messageMediaPhoto) and media.photo is not None

    def _download_photo_sync(self, message_obj: MessageObject) -> Optional[str]:
        try:
            media = message_obj.messageOwner.media
            photo = media.photo
            largest_size = None
            max_dim = 0

            if photo.sizes and not photo.sizes.isEmpty():
                for i in range(photo.sizes.size()):
                    size = photo.sizes.get(i)
                    if isinstance(size, (TLRPC.TL_photoSize, TLRPC.TL_photoSizeProgressive, TLRPC.TL_photoCachedSize)):
                        current_dim = max(size.w, size.h)
                        if current_dim > max_dim:
                            max_dim = current_dim
                            largest_size = size

            if not largest_size and photo.sizes and not photo.sizes.isEmpty():
                largest_size = photo.sizes.get(photo.sizes.size() - 1)

            if not largest_size:
                return None
            current_account = UserConfig.selectedAccount
            file_loader = FileLoader.getInstance(current_account)
            file_path_obj = file_loader.getPathToAttach(largest_size, True)
            if not file_path_obj:
                return None
            file_path = file_path_obj.getAbsolutePath()

            if os.path.exists(file_path):
                return file_path
            image_location = ImageLocation.getForPhoto(largest_size, photo)
            if not image_location:
                return None

            dlog("[ImageFX+] Downloading file size object from servers...")
            file_loader.loadFile(image_location, message_obj, "jpg", FileLoader.PRIORITY_HIGH, 1)

            timeout = 30
            for _ in range(timeout):
                if os.path.exists(file_path) and os.path.getsize(file_path) > 0:
                    return file_path
                time.sleep(1)
            return None
        except Exception as e:
            dlog(f"[ImageFX+] _download_photo_sync error: {e}\n{traceback.format_exc()}")
            return None

    def _copy_uri_to_cache(self, path: str) -> str:
        try:
            UriClass = find_class("android.net.Uri")
            uri = UriClass.parse(path)
            cr = ApplicationLoader.applicationContext.getContentResolver()
            ins = cr.openInputStream(uri)
            if not ins:
                return path

            cache_dir = ApplicationLoader.applicationContext.getCacheDir().getAbsolutePath()
            dest_path = os.path.join(cache_dir, f"copied_fx_{int(time.time() * 1000)}.jpg")

            from java.io import FileOutputStream
            out = FileOutputStream(dest_path)

            j_bytes = bytearray(4096)
            while True:
                bytes_read = ins.read(j_bytes)
                if bytes_read <= 0:
                    break
                out.write(j_bytes, 0, bytes_read)

            ins.close()
            out.close()
            self.temp_files.append(dest_path)
            return dest_path
        except Exception as e:
            dlog(f"[ImageFX+] copy_uri_to_cache error: {e}")
            return path

    def _get_temp_dir(self) -> Optional[File]:
        try:
            base_dir = ApplicationLoader.getFilesDirFixed()
            if not base_dir:
                return None
            temp_dir = File(base_dir, "ImageFX_Ultimate_Temp")
            if not temp_dir.exists() and not temp_dir.mkdirs():
                return None
            return temp_dir
        except Exception as e:
            dlog(f"[ImageFX+] Error creating temp dir: {e}")
            return None

    def discard_temp_file(self, path: str):
        if not path:
            return
        try:
            if path in self.temp_files:
                self.temp_files.remove(path)
            if os.path.exists(path):
                os.remove(path)
        except Exception as e:
            dlog(f"[ImageFX+] discard_temp_file failed for {path}: {e}")

    def prune_temp_files(self, max_age_seconds: int = 3600):
        if not self.temp_dir:
            return
        try:
            base = self.temp_dir.getAbsolutePath()
            now = time.time()
            for name in os.listdir(base):
                path = os.path.join(base, name)
                try:
                    if os.path.isfile(path) and now - os.path.getmtime(path) > max_age_seconds:
                        os.remove(path)
                        if path in self.temp_files:
                            self.temp_files.remove(path)
                        dlog(f"[ImageFX+] Pruned stale temp file: {path}")
                except Exception:
                    pass
        except Exception as e:
            dlog(f"[ImageFX+] prune_temp_files error: {e}")

    def _cleanup_temp_files(self):
        dlog("[ImageFX+] Cleaning up temporary editor files...")
        for path in self.temp_files:
            try:
                if os.path.exists(path):
                    os.remove(path)
                    dlog(f"[ImageFX+] Deleted temp file: {path}")
            except Exception as e:
                dlog(f"[ImageFX+] Cleanup failed for {path}: {e}")
        self.temp_files = []


class Plugin(ImageFXPlugin):
    pass
