        self._ss(KEY_BANNER_FADE_CX, self._banner_fade_cx)
        self._ss(KEY_BANNER_FADE_CY, self._banner_fade_cy)
        self._ss(KEY_BG_FADE_CX, self._bg_fade_cx)
