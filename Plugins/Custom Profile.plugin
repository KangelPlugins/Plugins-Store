        self._name_font = int(self._gs(KEY_NAME_FONT, 0))
        self._name_font_path = self._gs(KEY_NAME_FONT_PATH, "") or ""
        self._name_grad_c1 = self._color_setting(KEY_NAME_GRAD_C1, DEF_NAME_GRAD_C1)
        self._name_grad_c2 = self._color_setting(KEY_NAME_GRAD_C2, DEF_NAME_GRAD_C2)
        self._avatar_shape = int(self._gs(KEY_AVATAR_SHAPE, 0))
        self._avatar_radius = int(self._gs(KEY_AVATAR_RADIUS, 18))
        self._avatar_round = int(self._gs(KEY_AVATAR_ROUND, 0))
        self._avatar_custom = self._gs(KEY_AVATAR_CUSTOM, "") or ""
        self._avatar_alpha = int(self._gs(KEY_AVATAR_ALPHA, 100))
        self._avatar_dim = int(self._gs(KEY_AVATAR_DIM, 0))
        self._thought_text = str(self._gs(KEY_THOUGHT_TEXT, "") or "")
        _thc = self._parse_color(str(self._gs(KEY_THOUGHT_TEXT_COLOR, "") or ""))
        self._thought_text_color = -1 if _thc is None else int(_thc)
        _thb = self._parse_color(str(self._gs(KEY_THOUGHT_BG_COLOR, "") or ""))
        self._thought_bg_color = -871557603 if _thb is None else int(_thb)
        self._thought_font = int(self._gs(KEY_THOUGHT_FONT, 0))
        self._thought_font_copy = bool(self._gs(KEY_THOUGHT_FONT_COPY, True))
        self._thought_font_path = self._gs(KEY_THOUGHT_FONT_PATH, "") or ""
        self._avatar_fade = int(self._gs(KEY_AVATAR_FADE, 0))
        self._avatar_fade_radius = int(self._gs(KEY_AVATAR_FADE_RADIUS, 50))
        self._avatar_custom_pts = self._parse_custom_pts(self._avatar_custom)
        self._av_last_r = None
        self._banner_mode = int(self._gs(KEY_BANNER_MODE, 0))
        self._banner_color = self._color_setting(KEY_BANNER_COLOR, DEF_BANNER_COLOR)

        self._grad_type = int(self._gs(KEY_GRAD_TYPE, 0))
        self._grad_dir = int(self._gs(KEY_GRAD_DIR, 0))
        self._grad_angle = int(self._gs(KEY_GRAD_ANGLE, 0))
        self._grad_c1 = self._color_setting(KEY_GRAD_C1, DEF_GRAD_C1)
        self._grad_c2 = self._color_setting(KEY_GRAD_C2, DEF_GRAD_C2)
        self._grad_c3 = self._color_setting(KEY_GRAD_C3, DEF_GRAD_C3)
        self._grad_use3 = bool(self._gs(KEY_GRAD_USE3, False))
        self._grad_radius = int(self._gs(KEY_GRAD_RADIUS, 100))
        self._grad_count = int(self._gs(KEY_GRAD_COUNT, 3 if self._grad_use3 else 2))
        self._banner_alpha = int(self._gs(KEY_BANNER_ALPHA, 100))
        self._banner_dim = int(self._gs(KEY_BANNER_DIM, 0))
        self._banner_fade = int(self._gs(KEY_BANNER_FADE, 0))
        self._banner_fade_angle = int(self._gs(KEY_BANNER_FADE_ANGLE, 0))
        self._banner_fade_radius = int(self._gs(KEY_BANNER_FADE_RADIUS, 100))
        self._bg_alpha = int(self._gs(KEY_BG_ALPHA, 100))
        self._bg_dim = int(self._gs(KEY_BG_DIM, 0))
        self._bg_fade = int(self._gs(KEY_BG_FADE, 0))
        self._bg_fade_angle = int(self._gs(KEY_BG_FADE_ANGLE, 0))
        self._bg_fade_radius = int(self._gs(KEY_BG_FADE_RADIUS, 100))
        self._grad_cx = float(self._gs(KEY_GRAD_CX, 0.5))
        self._grad_cy = float(self._gs(KEY_GRAD_CY, 0.5))
        self._banner_fade_cx = float(self._gs(KEY_BANNER_FADE_CX, 0.5))
        self._banner_fade_cy = float(self._gs(KEY_BANNER_FADE_CY, 0.5))
        self._bg_fade_cx = float(self._gs(KEY_BG_FADE_CX, 0.5))
        self._bg_fade_cy = float(self._gs(KEY_BG_FADE_CY, 0.5))
        self._bmp_src = None
        self._banner_img_dirty = True

        self._bg_enabled = bool(self._gs(KEY_BG_ENABLED, False))
        self._bg_mode = int(self._gs(KEY_BG_MODE, 0))
        self._bg_color = self._color_setting(KEY_BG_COLOR, DEF_BG_COLOR)
        self._blocks_color_enabled = bool(self._gs(KEY_BLOCKS_ENABLED, False))
        self._blocks_color = self._color_setting(KEY_BLOCKS_COLOR, DEF_BLOCKS_COLOR)
        self._blocks_alpha = int(self._gs(KEY_BLOCKS_ALPHA, 100))
        self._blocks_blur = int(self._gs(KEY_BLOCKS_BLUR, 0))
        self._blocks_depth = int(self._gs(KEY_BLOCKS_DEPTH, 4))
        self._bg_bmp = None
        self._bg_drawable = None
        self._bg_dirty = True
        self._bg_applied = False
        self._snapshot = ""
        self._snap_ts = 0.0
        self._snap_busy = False
        self._snap_path = ""
        self._preview_fragment = None
        self._preview_view = None

        try:
            self._ab_cls = find_class(ACTION_BAR)
            self._au_cls = find_class(ANDROID_UTILS)
        except Exception as e:
            self.log(f"[cpb] static class lookup failed: {e}")

        for _k in (KEY_BANNER_PATH, KEY_BG_PATH):
            try:
                if self._gs(_k, "") is None:
                    self._ss(_k, "")
            except Exception:
                pass

        banner_path = self._gs(KEY_BANNER_PATH, "")
        if banner_path:
            try:
                self._load_banner_bitmap(banner_path)
            except Exception as e:
                self.log(f"[cpb] load saved banner failed: {e}")

        bg_path = self._gs(KEY_BG_PATH, "")
        if bg_path:
            try:
                self._bg_bmp = self._decode_downsampled(bg_path)
            except Exception as e:
                self.log(f"[cpb] load saved bg failed: {e}")

        try:
            from org.telegram.messenger import ApplicationLoader
            _base = ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()
            self._snap_path = _base + "/cpb_profile_snap.jpg"
            if os.path.exists(self._snap_path):
                self._snapshot = self._file_to_data_uri(self._snap_path)
        except Exception as e:
            self.log(f"[cpb] snap load failed: {e}")

        try:
            top_cls = find_class(TOP_VIEW)
            if top_cls is None:
                self.log("[cpb] TopView class NOT found")
            else:
                u1 = self.hook_all_methods(top_cls, "onDraw", _OnDrawHook(self))
                if u1:
                    self._unhooks += list(u1)
                try:
                    u2 = self.hook_all_methods(top_cls, "updateBackgroundPaint", _BgPaintHook(self))
                    if u2:
                        self._unhooks += list(u2)
                except Exception as e:
                    self.log(f"[cpb] updateBackgroundPaint hook skipped: {e}")
        except Exception as e:
            self.log(f"[cpb] TopView hook failed: {e}")

        try:
            _tth = _ThoughtTouchHook(self)
            _rlt = find_class("org.telegram.ui.Components.RecyclerListView")
            _ut1 = None
            if _rlt is not None:
                try:
                    _ut1 = self.hook_all_methods(_rlt, "onTouchEvent", _tth)
                    if _ut1:
                        self._unhooks += list(_ut1)
                except Exception:
                    _ut1 = None
                try:
                    _ut2 = self.hook_all_methods(_rlt, "onInterceptTouchEvent", _tth)
                    if _ut2:
                        self._unhooks += list(_ut2)
                except Exception:
                    pass
            if not _ut1:
                _rvc = find_class("androidx.recyclerview.widget.RecyclerView")
                if _rvc is not None:
                    _ut3 = self.hook_all_methods(_rvc, "onTouchEvent", _tth)
                    if _ut3:
                        self._unhooks += list(_ut3)
        except Exception as e:
            self.log(f"[cpb] thought touch hook failed: {e}")

        try:
            la_cls = find_class(LAUNCH_ACTIVITY)
            if la_cls is not None:
                u3 = self.hook_all_methods(la_cls, "onActivityResult", _ActivityResultHook(self))
                if u3:
                    self._unhooks += list(u3)
        except Exception as e:
            self.log(f"[cpb] onActivityResult hook failed: {e}")

        try:
            pa_cls = find_class("org.telegram.ui.ProfileActivity")
            if pa_cls is not None:
                u4 = self.hook_all_methods(pa_cls, "createView", _ProfileMenuHook(self))
                if u4:
                    self._unhooks += list(u4)
        except Exception as e:
            self.log(f"[cpb] ProfileActivity menu hook failed: {e}")

        try:
            av_cls = find_class("org.telegram.ui.ProfileActivity$AvatarImageView")
            if av_cls is None:
                self.log("[cpb] AvatarImageView class NOT found")
            else:
                u5 = self.hook_all_methods(av_cls, "onDraw", _AvatarDrawHook(self))
                u5l = list(u5) if u5 else []
                self._unhooks += u5l
                self.log(f"[cpb] AvatarImageView onDraw hooked n={len(u5l)}")
        except Exception as e:
            self.log(f"[cpb] AvatarImageView onDraw hook failed: {e}")

        try:
            rl_cls = find_class("org.telegram.ui.Components.RecyclerListView")
            if rl_cls is not None:
                u7 = self.hook_all_methods(rl_cls, "drawSectionBackground", _CpbSectionBgHook(self))
                u7l = list(u7) if u7 else []
                self._unhooks += u7l
                self.log(f"[cpb] drawSectionBackground hooked n={len(u7l)}")
        except Exception as e:
            self.log(f"[cpb] drawSectionBackground hook failed: {e}")

        try:
            bf_cls = find_class("org.telegram.ui.ActionBar.BaseFragment")
            u8 = self.hook_all_methods(bf_cls, "getThemedColor", _CpbThemeColorHook(self))
            u8l = list(u8) if u8 else []
            self._unhooks += u8l
            self.log(f"[cpb] getThemedColor hooked n={len(u8l)}")
        except Exception as e:
            self.log(f"[cpb] getThemedColor hook failed: {e}")

        try:
            pf_cls = find_class("org.telegram.ui.ProfileActivity")
            ph = _CpbProfilePauseHook(self)
            n9 = 0
            for mname in ("onPause", "onFragmentDestroy", "onBecomeFullyHidden"):
                try:
                    u9 = self.hook_all_methods(pf_cls, mname, ph)
                    u9l = list(u9) if u9 else []
                    self._unhooks += u9l
                    n9 += len(u9l)
                except Exception:
                    pass
            self.log(f"[cpb] profile lifecycle hooked n={n9}")
        except Exception as e:
            self.log(f"[cpb] profile lifecycle hook failed: {e}")

        try:
            rl2 = find_class("org.telegram.ui.Components.RecyclerListView")
            u10 = self.hook_all_methods(rl2, "dispatchDraw", _CpbListDrawHook(self))
            u10l = list(u10) if u10 else []
            self._unhooks += u10l
            self.log(f"[cpb] listView dispatchDraw hooked n={len(u10l)}")
        except Exception as e:
            self.log(f"[cpb] listView dispatchDraw hook failed: {e}")

        try:
            rl3 = find_class("org.telegram.ui.Components.RecyclerListView")
            u11 = self.hook_all_methods(rl3, "drawSectionsBackgrounds", _CpbSectionsGateHook(self))
            u11l = list(u11) if u11 else []
            self._unhooks += u11l
            u12 = self.hook_all_methods(rl3, "drawBackgroundRect", _CpbBgRectHook(self))
            u12l = list(u12) if u12 else []
            self._unhooks += u12l
            self.log(f"[cpb] bgRect hooks n={len(u11l)}+{len(u12l)}")
        except Exception as e:
            self.log(f"[cpb] bgRect hook failed: {e}")

        self.log(f"[cpb] loaded mode={self._banner_mode} banner={'y' if self._bmp else 'n'} bg={self._bg_enabled}")

    def _field(self, obj, name):
        cls = obj.getClass()
        key = (cls, name)
        f = self._fields.get(key)
        if f is None:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            self._fields[key] = f
        return f

    def _header_height(self, pa):
        extra = self._field(pa, "extraHeight").getFloat(pa)
        search = self._field(pa, "searchTransitionOffset").getInt(pa)
        ab_h = self._ab_cls.getCurrentActionBarHeight()
        sb_h = self._au_cls.statusBarHeight
        return float(ab_h) + float(sb_h) + float(extra) + float(search)

    def _update_bitmap_matrix(self, width, v10):
        if self._shader is None or self._bmp is None:
            return
        from android.graphics import Matrix
        if width <= 0:
            return
        if v10 <= 0:
            v10 = float(width)
        bw = float(self._bmp.getWidth())
        bh = float(self._bmp.getHeight())
        if bw <= 0 or bh <= 0:
            return
        sx = float(width) / bw
        sy = float(v10) / bh
        s = sx if sx > sy else sy
        m = Matrix()
        m.setScale(s, s)
        m.postTranslate((float(width) - bw * s) / 2.0, (float(v10) - bh * s) / 2.0)
        self._shader.setLocalMatrix(m)

    def _banner_sig(self):
        return (self._banner_mode, self._grad_type,
                int(getattr(self, "_grad_angle", 0)),
                int(getattr(self, "_grad_radius", 100)),
                int(getattr(self, "_grad_count", 2)),
                round(float(getattr(self, "_grad_cx", 0.5)), 3),
                round(float(getattr(self, "_grad_cy", 0.5)), 3),
                self._banner_color, self._grad_c1, self._grad_c2,
                self._grad_c3)

    def _build_unit_shader(self):
        from java import jint, jfloat, jarray
        from android.graphics import LinearGradient, RadialGradient, Shader
        import math
        tile = Shader.TileMode.CLAMP
        if self._banner_mode == 1:
            cols = jarray(jint)([self._banner_color, self._banner_color])
            pos = jarray(jfloat)([0.0, 1.0])
            return LinearGradient(0.0, 0.0, 1.0, 0.0, cols, pos, tile)
        count = int(getattr(self, "_grad_count", 2))
        color_list = [self._grad_c1, self._grad_c2]
        if count >= 3:
            color_list.append(self._grad_c3)
        cols = jarray(jint)(color_list)
        if len(color_list) == 3:
            pos = jarray(jfloat)([0.0, 0.5, 1.0])
        else:
            pos = jarray(jfloat)([0.0, 1.0])
        radius = int(getattr(self, "_grad_radius", 100))
        if radius < 20:
            radius = 20
        if radius > 200:
            radius = 200
        rfrac = radius / 100.0
        gt = self._grad_type
        if gt == 1:
            r = 0.5 * rfrac
            if r <= 0.0:
                r = 0.5
            cx = float(getattr(self, "_grad_cx", 0.5))
            cy = float(getattr(self, "_grad_cy", 0.5))
            return RadialGradient(cx, cy, r, cols, pos, tile)
        ang = float(int(getattr(self, "_grad_angle", 0)) % 360)
        rad = ang * math.pi / 180.0
        dx = math.sin(rad)
        dy = -math.cos(rad)
        hl = 0.5 * rfrac
        x0 = 0.5 - dx * hl
        y0 = 0.5 - dy * hl
        x1 = 0.5 + dx * hl
        y1 = 0.5 + dy * hl
        return LinearGradient(x0, y0, x1, y1, cols, pos, tile)

    def _ensure_banner_shader(self, width, v10):
        mode = self._banner_mode
        if mode == 0:
            if getattr(self, "_banner_img_dirty", False):
                self._rebuild_banner_bitmap()
            if self._bmp is None:
                return None
            if self._shader is None:
                from android.graphics import BitmapShader, Shader
                self._shader = BitmapShader(self._bmp, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
            self._update_bitmap_matrix(width, v10)
            return self._shader
        sig = self._banner_sig()
        if self._grad_shader is None or self._grad_sig != sig:
            self._grad_shader = self._build_unit_shader()
            self._grad_sig = sig
        if self._grad_shader is not None:
            from android.graphics import Matrix
            w = float(width) if width and width > 0 else 1.0
            h = float(v10) if v10 and v10 > 0 else w
            m = Matrix()
            m.setScale(w, h)
            self._grad_shader.setLocalMatrix(m)
        return self._grad_shader

    def _is_own_profile(self, pa):
        try:
            args = pa.getArguments()
            if args is None:
                return False
            viewed = int(args.getLong("user_id", 0))
            if viewed == 0:
                return False
            uc = find_class("org.telegram.messenger.UserConfig")
            try:
                acc = int(pa.getCurrentAccount())
            except Exception:
                acc = int(uc.selectedAccount)
            me = int(uc.getInstance(acc).getClientUserId())
            return viewed == me
        except Exception:
            return False

    def _is_edit_target(self, pa):
        try:
            _ec = int(getattr(self, "_edit_chat", 0) or 0)
        except Exception:
            _ec = 0
        if _ec:
            try:
                return int(self._viewed_uid(pa)) == -_ec
            except Exception:
                return False
        return self._is_own_profile(pa)

    def _viewed_uid(self, pa):
        try:
            args = pa.getArguments()
            if args is None:
                return 0
            u = int(args.getLong("user_id", 0))
            if u != 0:
                return u
            c = int(args.getLong("chat_id", 0))
            if c > 0:
                return -c
            return 0
        except Exception:
            return 0

    def _owned_chat_id(self, frag):
        try:
            if frag is None:
                return 0
            try:
                cn = str(frag.getClass().getName())
            except Exception:
                cn = ""
            if "ProfileActivity" not in cn:
                return 0
            args = frag.getArguments()
            if args is None:
                return 0
            cid = int(args.getLong("chat_id", 0))
            if cid <= 0:
                return 0
            chat = None
            try:
                from java.lang import Long as _JL
            except Exception:
                _JL = None
            for _g in (1, 2):
                if chat is not None:
                    break
                try:
                    if _g == 1:
                        _mcz = frag.getMessagesController()
                    else:
                        uc = find_class("org.telegram.messenger.UserConfig")
                        mc = find_class("org.telegram.messenger.MessagesController")
                        _mcz = mc.getInstance(int(uc.selectedAccount))
                    try:
                        chat = _mcz.getChat(_JL.valueOf(cid)) if _JL is not None else _mcz.getChat(cid)
                    except Exception:
                        chat = _mcz.getChat(cid)
                except Exception:
                    chat = None
            if chat is None:
                return 0
            ok = False
            try:
                ok = bool(chat.creator)
            except Exception:
                ok = False
            if not ok:
                try:
                    ar = getattr(chat, "admin_rights", None)
                    ok = ar is not None and bool(getattr(ar, "change_info", False))
                except Exception:
                    ok = False
            if not ok and not getattr(self, "_ownchk_dbg", False):
                self._ownchk_dbg = True
                try:
                    self.log("[cpb] owncheck cid=%d chat=%s creator=%s" % (cid, "y" if chat is not None else "n", getattr(chat, "creator", None)))
                except Exception:
                    pass
            return cid if ok else 0
        except Exception:
            return 0

    def _files_dir(self):
        d = getattr(self, "_filesdir", "")
        if d:
            return d
        try:
            from org.telegram.messenger import ApplicationLoader
            d = ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()
            self._filesdir = d
            return d
        except Exception:
            return ""

    def _http_get_bytes(self, url):
        import urllib.request, urllib.error
        req = urllib.request.Request(url, method="GET")
        try:
            resp = urllib.request.urlopen(req, timeout=25)
            return resp.getcode(), resp.read()
        except urllib.error.HTTPError as he:
            return he.code, b""
        except Exception as e:
            self.log(f"[cpb] http get failed: {e}")
            return 0, b""

    def _build_unit_shader_cfg(self, cfg):
        from java import jint, jfloat, jarray
        from android.graphics import LinearGradient, RadialGradient, Shader
        import math
        tile = Shader.TileMode.CLAMP
        mode = int(cfg.get("banner_mode", 0))
        if mode == 1:
            col = self._parse_color(cfg.get("banner_color", "#FF3390EC"))
            if col is None:
                col = -16777216
            cols = jarray(jint)([col, col])
            pos = jarray(jfloat)([0.0, 1.0])
            return LinearGradient(0.0, 0.0, 1.0, 0.0, cols, pos, tile)
        count = int(cfg.get("grad_count", 2))
        def pc(key, dflt):
            c = self._parse_color(cfg.get(key, dflt))
            return c if c is not None else -16777216
        color_list = [pc("grad_c1", "#FF2B5876"), pc("grad_c2", "#FF4E4376")]
        if count >= 3:
            color_list.append(pc("grad_c3", "#FF8E2DE2"))
        cols = jarray(jint)(color_list)
        if len(color_list) == 3:
            pos = jarray(jfloat)([0.0, 0.5, 1.0])
        else:
            pos = jarray(jfloat)([0.0, 1.0])
        radius = int(cfg.get("grad_radius", 100))
        if radius < 20:
            radius = 20
        if radius > 200:
            radius = 200
        rfrac = radius / 100.0
        gt = int(cfg.get("grad_type", 0))
        if gt == 1:
            r = 0.5 * rfrac
            if r <= 0.0:
                r = 0.5
            cx = float(cfg.get("grad_cx", 0.5))
            cy = float(cfg.get("grad_cy", 0.5))
            return RadialGradient(cx, cy, r, cols, pos, tile)
        ang = float(int(cfg.get("grad_angle", 0)) % 360)
        rad = ang * math.pi / 180.0
        dx = math.sin(rad)
        dy = -math.cos(rad)
        hl = 0.5 * rfrac
        return LinearGradient(0.5 - dx * hl, 0.5 - dy * hl, 0.5 + dx * hl, 0.5 + dy * hl, cols, pos, tile)

    def _fetch_remote(self, uid, view):
        try:
            if uid < 0 and self._try_local_draft(uid, view):
                return
        except Exception as e:
            self.log(f"[cpb] draft check failed: {e}")
        if not getattr(self, "_remote_enabled", False):
            return
        try:
            base = VPS_BASE
            code, raw = self._http_get_bytes(base + "/api/profile?uid=" + str(uid))
            if code == 404:
                self._remote[uid] = {"state": "empty"}
                self.log(f"[cpb] remote {uid}: empty")
                return
            if code != 200:
                self._remote[uid] = {"state": "error"}
                self.log(f"[cpb] remote {uid}: profile http {code}")
                return
            cfg = json.loads(raw.decode("utf-8", "replace"))
            bg_col = self._parse_color(cfg.get("bg_color", "#FF000000"))
            entry = {
                "state": "ready",
                "cfg": cfg,
                "ts": int(cfg.get("ts", 0)),
                "enabled": bool(cfg.get("banner_enabled", True)),
                "show_emoji": bool(cfg.get("show_emoji", True)),
                "mode": int(cfg.get("banner_mode", 0)),
                "bmp": None,
                "shader": None,
                "grad_shader": None,
                "bg_enabled": bool(cfg.get("bg_enabled", False)),
                "bg_mode": int(cfg.get("bg_mode", 0)),
                "bg_color": bg_col if bg_col is not None else -16777216,
                "bg_bmp": None,
                "bg_drawable": None,
                "blocks_enabled": bool(cfg.get("blocks_color_enabled", False)),
                "blocks_color": self._parse_color(str(cfg.get("blocks_color", "#FF000000"))),
                "blocks_alpha": int(cfg.get("blocks_alpha", 100)),
                "blocks_blur": int(cfg.get("blocks_blur", 0)),
            }
            fd = self._files_dir()
            if entry["enabled"]:
                if entry["mode"] == 0:
                    icode, ibytes = self._http_get_bytes(base + "/api/image?uid=" + str(uid))
                    if icode == 200 and ibytes and fd:
                        path = fd + "/cpb_remote_" + str(uid) + ".img"
                        try:
                            with open(path, "wb") as f:
                                f.write(ibytes)
                            src = self._decode_downsampled(path)
                            proc = self._process_bitmap(
                                src,
                                int(cfg.get("banner_alpha", 100)),
                                int(cfg.get("banner_fade", 0)),
                                int(cfg.get("banner_fade_angle", 0)),
                                int(cfg.get("banner_fade_radius", 100)),
                                float(cfg.get("banner_fade_cx", 0.5)),
                                float(cfg.get("banner_fade_cy", 0.5)),
                                int(cfg.get("banner_dim", 0)),
                            )
                            from android.graphics import BitmapShader, Shader
                            entry["bmp"] = proc
                            entry["shader"] = BitmapShader(proc, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
                        except Exception as e:
                            self.log(f"[cpb] remote {uid}: banner decode failed: {e}")
                    else:
                        self.log(f"[cpb] remote {uid}: banner image http {icode}")
                else:
                    try:
                        entry["grad_shader"] = self._build_unit_shader_cfg(cfg)
                    except Exception as e:
                        self.log(f"[cpb] remote {uid}: grad build failed: {e}")
            if entry["bg_enabled"] and entry["bg_mode"] == 1:
                bcode, bbytes = self._http_get_bytes(base + "/api/image?uid=" + str(uid) + "&kind=bg")
                if bcode == 200 and bbytes and fd:
                    bpath = fd + "/cpb_remote_bg_" + str(uid) + ".img"
                    try:
                        with open(bpath, "wb") as f:
                            f.write(bbytes)
                        entry["bg_bmp"] = self._decode_downsampled(bpath)
                    except Exception as e:
                        self.log(f"[cpb] remote {uid}: bg decode failed: {e}")
                        entry["bg_enabled"] = False
                else:
                    self.log(f"[cpb] remote {uid}: bg image http {bcode}")
                    entry["bg_enabled"] = False
            entry["font_path"] = ""
            try:
                if int(cfg.get("name_font", 0) or 0) == 6 and fd:
                    fcode, fbytes = self._http_get_bytes(base + "/api/image?uid=" + str(uid) + "&kind=font")
                    if fcode == 200 and fbytes:
                        fpath = fd + "/cpb_remote_font_" + str(uid) + ".bin"
                        with open(fpath, "wb") as f:
                            f.write(fbytes)
                        entry["font_path"] = fpath
                        try:
                            _tfc = getattr(self, "_name_tf_cache", None)
                            if _tfc:
                                for _k in list(_tfc.keys()):
                                    if isinstance(_k, tuple) and len(_k) >= 2 and _k[1] == fpath:
                                        _tfc.pop(_k, None)
                        except Exception:
                            pass
                    else:
                        self.log(f"[cpb] remote {uid}: font http {fcode}")
            except Exception as e:
                self.log(f"[cpb] remote {uid}: font fetch failed: {e}")
            entry["thought_font_path"] = ""
            try:
                if int(cfg.get("thought_font", 0) or 0) == 6 and not cfg.get("thought_font_copy", True) and fd:
                    tcode2, tbytes2 = self._http_get_bytes(base + "/api/image?uid=" + str(uid) + "&kind=tfont")
                    if tcode2 == 200 and tbytes2:
                        tfpath = fd + "/cpb_remote_tfont_" + str(uid) + ".bin"
                        with open(tfpath, "wb") as f:
                            f.write(tbytes2)
                        entry["thought_font_path"] = tfpath
                        try:
                            _tfc2 = getattr(self, "_name_tf_cache", None)
                            if _tfc2:
                                for _k2 in list(_tfc2.keys()):
                                    if isinstance(_k2, tuple) and len(_k2) >= 2 and _k2[1] == tfpath:
                                        _tfc2.pop(_k2, None)
                        except Exception:
                            pass
                    else:
                        self.log(f"[cpb] remote {uid}: tfont http {tcode2}")
            except Exception as e:
                self.log(f"[cpb] remote {uid}: tfont fetch failed: {e}")
            has_banner = bool(entry["enabled"] and (entry["shader"] is not None or entry["grad_shader"] is not None))
            has_bg = bool(entry["bg_enabled"] and (entry["bg_mode"] == 0 or entry["bg_bmp"] is not None))
            if not has_banner and not has_bg:
                entry["state"] = "empty"
            self._remote[uid] = entry
            self.log(f"[cpb] remote {uid}: ready banner={has_banner} bg={has_bg}")
            self._invalidate_view_later(view)
        except Exception as e:
            self._remote[uid] = {"state": "error"}
            self.log(f"[cpb] remote {uid}: fetch failed: {e}")

    def _try_local_draft(self, uid, view):
        cid = -int(uid)
        if cid <= 0:
            return False
        try:
            v = self.get_setting(self._acct_tag() + ("_c%d" % cid) + "_draft_saved", 0)
        except Exception:
            v = 0
        if str(v) not in ("1", "true", "True"):
            return False
        entry = self._build_chat_draft_entry(cid)
        if entry is None:
            return False
        self._remote[uid] = entry
        self.log("[cpb] draft %d: applied locally" % cid)
        try:
            self._invalidate_view_later(view)
        except Exception:
            pass
        return True

    def _build_chat_draft_entry(self, cid):
        _prev = int(getattr(self, "_edit_chat", 0) or 0)
        cfg = None
        banner_path = ""
        bg_path = ""
        font_path = ""
        try:
            self._edit_chat = int(cid)
            self._reload_state()
            cfg = self._collect_config()
            banner_path = str(self._gs(KEY_BANNER_PATH, "") or "")
            bg_path = str(self._gs(KEY_BG_PATH, "") or "")
            font_path = str(self._gs(KEY_NAME_FONT_PATH, "") or "")
        except Exception as e:
            self.log(f"[cpb] draft collect failed: {e}")
            cfg = None
        finally:
            self._edit_chat = _prev
            try:
                self._reload_state()
            except Exception:
                pass
        if not cfg:
            return None
        try:
            bg_col = self._parse_color(cfg.get("bg_color", "#FF000000"))
            entry = {
                "state": "ready",
                "draft": True,
                "cfg": cfg,
                "ts": int(cfg.get("ts", 0) or 0),
                "enabled": bool(cfg.get("banner_enabled", True)),
                "show_emoji": bool(cfg.get("show_emoji", True)),
                "mode": int(cfg.get("banner_mode", 0)),
                "bmp": None,
                "shader": None,
                "grad_shader": None,
                "bg_enabled": bool(cfg.get("bg_enabled", False)),
                "bg_mode": int(cfg.get("bg_mode", 0)),
                "bg_color": bg_col if bg_col is not None else -16777216,
                "bg_bmp": None,
                "bg_drawable": None,
                "blocks_enabled": bool(cfg.get("blocks_color_enabled", False)),
                "blocks_color": self._parse_color(str(cfg.get("blocks_color", "#FF000000"))),
                "blocks_alpha": int(cfg.get("blocks_alpha", 100)),
                "blocks_blur": int(cfg.get("blocks_blur", 0)),
            }
            if entry["enabled"]:
                if entry["mode"] == 0:
                    if banner_path:
                        try:
                            src = self._decode_downsampled(banner_path)
                            proc = self._process_bitmap(
                                src,
                                int(cfg.get("banner_alpha", 100)),
                                int(cfg.get("banner_fade", 0)),
                                int(cfg.get("banner_fade_angle", 0)),
                                int(cfg.get("banner_fade_radius", 100)),
                                float(cfg.get("banner_fade_cx", 0.5)),
                                float(cfg.get("banner_fade_cy", 0.5)),
                                int(cfg.get("banner_dim", 0)),
                            )
                            from android.graphics import BitmapShader, Shader
                            entry["bmp"] = proc
                            entry["shader"] = BitmapShader(proc, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
                        except Exception as e:
                            self.log(f"[cpb] draft {cid}: banner decode failed: {e}")
                else:
                    try:
                        entry["grad_shader"] = self._build_unit_shader_cfg(cfg)
                    except Exception as e:
                        self.log(f"[cpb] draft {cid}: grad build failed: {e}")
            if entry["bg_enabled"] and entry["bg_mode"] == 1:
                if bg_path:
                    try:
                        entry["bg_bmp"] = self._decode_downsampled(bg_path)
                    except Exception:
                        entry["bg_enabled"] = False
                else:
                    entry["bg_enabled"] = False
            entry["font_path"] = ""
            try:
                if int(cfg.get("name_font", 0) or 0) == 6 and font_path:
                    entry["font_path"] = font_path
                if int(cfg.get("thought_font", 0) or 0) == 6 and not cfg.get("thought_font_copy", True):
                    _tfp2 = self._gs(KEY_THOUGHT_FONT_PATH, "") or ""
                    if _tfp2:
                        entry["thought_font_path"] = _tfp2
            except Exception:
                pass
            return entry
        except Exception as e:
            self.log(f"[cpb] draft {cid}: build failed: {e}")
            return None

    def _maybe_recheck_remote(self, uid, view):
        try:
            cur = self._remote.get(uid)
            if isinstance(cur, dict) and cur.get("draft"):
                return
        except Exception:
            pass
        if not getattr(self, "_remote_enabled", False):
            return
        try:
            if not hasattr(self, "_remote_check") or self._remote_check is None:
                self._remote_check = {}
            try:
                _vk = int(view.hashCode()) if view is not None else 0
            except Exception:
                _vk = id(view)
            _rk = (int(uid), _vk)
            if _rk in self._remote_check:
                return
            if len(self._remote_check) > 512:
                self._remote_check.clear()
            self._remote_check[_rk] = 1
            import threading
            threading.Thread(target=lambda: self._recheck_remote(uid, view), daemon=True).start()
        except Exception:
            pass

    def _recheck_remote(self, uid, view):
        try:
            base = VPS_BASE
            code, raw = self._http_get_bytes(base + "/api/profile?uid=" + str(uid))
            cur = self._remote.get(uid) or {}
            old_ts = int(cur.get("ts", -1))
            if code == 404:
                if cur.get("state") != "empty" or old_ts != -1:
                    self._remote[uid] = {"state": "empty", "ts": -1}
                    self.log(f"[cpb] remote {uid}: became empty")
                    self._invalidate_view_later(view)
                return
            if code != 200:
                return
            cfg = json.loads(raw.decode("utf-8", "replace"))
            new_ts = int(cfg.get("ts", 0))
            if new_ts != old_ts:
                self.log(f"[cpb] remote {uid}: changed ts {old_ts}->{new_ts}, refetching")
                self._fetch_remote(uid, view)
        except Exception as e:
            self.log(f"[cpb] remote {uid}: recheck failed: {e}")

    def _start_remote_fetch(self, uid, view):
        if not getattr(self, "_remote_enabled", False):
            return
        try:
            import threading
            threading.Thread(target=lambda: self._fetch_remote(uid, view), daemon=True).start()
            self.log(f"[cpb] remote {uid}: fetching")
        except Exception as e:
            self.log(f"[cpb] remote fetch thread failed: {e}")

    def _invalidate_view_later(self, view):
        try:
            if view is None:
                return
            run_on_ui_thread(lambda: self._safe_invalidate(view))
        except Exception:
            pass

    def _safe_invalidate(self, view):
        try:
            view.invalidate()
        except Exception:
            pass

    def _remote_shader(self, entry, width, v10):
        mode = int(entry.get("mode", 0))
        if mode == 0:
            bmp = entry.get("bmp")
            sh = entry.get("shader")
            if bmp is None or sh is None:
                return None
            from android.graphics import Matrix
            if width <= 0:
                return sh
            vv = v10 if v10 and v10 > 0 else float(width)
            bw = float(bmp.getWidth())
            bh = float(bmp.getHeight())
            if bw <= 0 or bh <= 0:
                return sh
            sx = float(width) / bw
            sy = float(vv) / bh
            s = sx if sx > sy else sy
            m = Matrix()
            m.setScale(s, s)
            m.postTranslate((float(width) - bw * s) / 2.0, (float(vv) - bh * s) / 2.0)
            sh.setLocalMatrix(m)
            return sh
        sh = entry.get("grad_shader")
        if sh is None:
            return None
        from android.graphics import Matrix
        w = float(width) if width and width > 0 else 1.0
        h = float(v10) if v10 and v10 > 0 else w
        m = Matrix()
        m.setScale(w, h)
        sh.setLocalMatrix(m)
        return sh

    def _build_bg_drawable_cfg(self, context_view, entry):
        from java import jint
        from android.graphics.drawable import ColorDrawable, BitmapDrawable
        cfg = entry.get("cfg", {})
        mode = int(entry.get("bg_mode", 0))
        if mode == 1:
            base_bmp = entry.get("bg_bmp")
            if base_bmp is None:
                return None
            bmp = base_bmp
            try:
                tw = int(context_view.getWidth())
                th = int(context_view.getHeight())
            except Exception:
                tw = th = 0
            if tw <= 0 or th <= 0:
                return None
            try:
                cropped = self._center_crop_bitmap(base_bmp, tw, th)
                if cropped is not None:
                    bmp = cropped
            except Exception as e:
                self.log(f"[cpb] remote bg crop failed: {e}")
            try:
                bmp = self._process_bitmap(
                    bmp,
                    int(cfg.get("bg_alpha", 100)),
                    int(cfg.get("bg_fade", 0)),
                    int(cfg.get("bg_fade_angle", 0)),
                    int(cfg.get("bg_fade_radius", 100)),
                    float(cfg.get("bg_fade_cx", 0.5)),
                    float(cfg.get("bg_fade_cy", 0.5)),
                    int(cfg.get("bg_dim", 0)),
                )
            except Exception as e:
                self.log(f"[cpb] remote bg process failed: {e}")
            return BitmapDrawable(context_view.getResources(), bmp)
        col = entry.get("bg_color")
        if col is None:
            col = -16777216
        try:
            _rdv = int(cfg.get("bg_dim", 0) or 0)
        except Exception:
            _rdv = 0
        if _rdv > 0:
            col = self._dim_color(int(col), _rdv)
        return ColorDrawable(jint(col))

    def _apply_remote_background(self, pa, entry):
        if not entry.get("bg_enabled"):
            return
        list_view = self._field(pa, "listView").get(pa)
        if list_view is None:
            return
        mode = int(entry.get("bg_mode", 0))
        if mode == 1 and entry.get("bg_bmp") is None:
            return
        try:
            cwh = (int(list_view.getWidth()), int(list_view.getHeight()))
        except Exception:
            cwh = (0, 0)
        if mode == 1 and (cwh[0] <= 0 or cwh[1] <= 0):
            return
        d = entry.get("bg_drawable")
        if d is None or (mode == 1 and cwh != entry.get("bg_crop_wh")):
            d = self._build_bg_drawable_cfg(list_view, entry)
            if d is None:
                return
            entry["bg_drawable"] = d
            if mode == 1:
                entry["bg_crop_wh"] = cwh
            list_view.setBackground(d)
            return
        cur = list_view.getBackground()
        if cur is None or not cur.equals(d):
            list_view.setBackground(d)

    def _field_super(self, obj, name):
        cls = obj.getClass()
        key = (cls, name)
        f = self._fields.get(key)
        if f is not None:
            return f
        c = cls
        while c is not None:
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                self._fields[key] = f
                return f
            except Exception:
                try:
                    c = c.getSuperclass()
                except Exception:
                    c = None
        raise Exception("field not found: " + name)

    def _av_write_radius(self, ir, r):
        f = None
        try:
            f = self._field_super(ir, "roundRadius")
        except Exception:
            f = None
        if f is not None:
            try:
                cur = f.get(ir)
                try:
                    ln = len(cur)
                except Exception:
                    ln = -1
                if ln >= 0:
                    for i in range(ln):
                        cur[i] = r
                    return True
                f.setInt(ir, int(r))
                return True
            except Exception as e:
                if not getattr(self, "_avatar_err3", False):
                    self._avatar_err3 = True
                    self.log(f"[cpb] avatar roundRadius field error: {e}")
        try:
            ir.setRoundRadius(r)
        except Exception as e:
            if not getattr(self, "_avatar_err2", False):
                self._avatar_err2 = True
                self.log(f"[cpb] avatar setRoundRadius error: {e}")
        return False

    def _apply_avatar_shape(self, pa):
        av = None
        try:
            av = self._field(pa, "avatarImage").get(pa)
        except Exception as e:
            if not getattr(self, "_avatar_err", False):
                self._avatar_err = True
                self.log(f"[cpb] avatar field error: {e}")
            return
        if av is None:
            return
        from org.telegram.messenger import AndroidUtilities
        shape = int(getattr(self, "_avatar_shape", 0))
        if shape == 2 or shape >= 3:
            r = 0
        elif shape == 1:
            rad = max(0, min(64, int(getattr(self, "_avatar_radius", 18))))
            r = int(AndroidUtilities.dp(float(rad)))
        else:
            r = int(AndroidUtilities.dp(200.0))
        try:
            ir = av.getImageReceiver()
        except Exception:
            ir = None
        if ir is None:
            return
        self._av_write_radius(ir, r)
        try:
            pe = self._field_super(av, "progressToExpand")
            expand = float(pe.getFloat(av))
        except Exception:
            expand = 0.0
        if expand <= 0.01:
            try:
                fe = self._field_super(av, "roundRadiusExpand")
                if int(fe.getInt(av)) != int(r):
                    fe.setInt(av, int(r))
                    try:
                        av.invalidate()
                    except Exception:
                        pass
            except Exception as e:
                if not getattr(self, "_avatar_err4", False):
                    self._avatar_err4 = True
                    self.log(f"[cpb] roundRadiusExpand error: {e}")
        if getattr(self, "_av_last_r", None) != r:
            self._av_last_r = r
            try:
                av.invalidate()
            except Exception:
                pass

    def _parse_custom_pts(self, s):
        try:
            import json as _json
            arr = _json.loads(s) if s else []
        except Exception:
            return []
        out = []
        for it in arr:
            try:
                x = float(it[0])
                y = float(it[1])
                x = 0.0 if x < 0.0 else (1.0 if x > 1.0 else x)
                y = 0.0 if y < 0.0 else (1.0 if y > 1.0 else y)
                out.append((x, y))
            except Exception:
                pass
        return out

    def _build_shape_path(self, shape, w, h):
        import math
        from android.graphics import Path
        p = Path()
        cx = w / 2.0
        cy = h / 2.0
        R = (w if w < h else h) / 2.0

        def poly(n, rot):
            for i in range(n):
                a = rot + 2.0 * math.pi * i / n
                x = cx + R * math.cos(a)
                y = cy + R * math.sin(a)
                if i == 0:
                    p.moveTo(float(x), float(y))
                else:
                    p.lineTo(float(x), float(y))
            p.close()

        if shape == 3:
            poly(6, -math.pi / 2.0)
        elif shape == 4:
            poly(5, -math.pi / 2.0)
        elif shape == 5:
            n = 5
            inner = R * 0.42
            for i in range(2 * n):
                rad = R if (i % 2 == 0) else inner
                a = -math.pi / 2.0 + math.pi * i / n
                x = cx + rad * math.cos(a)
                y = cy + rad * math.sin(a)
                if i == 0:
                    p.moveTo(float(x), float(y))
                else:
                    p.lineTo(float(x), float(y))
            p.close()
        elif shape == 6:
            steps = 72
            raw = []
            for i in range(steps + 1):
                t = 2.0 * math.pi * i / steps
                hx = 16.0 * (math.sin(t) ** 3)
                hy = (13.0 * math.cos(t) - 5.0 * math.cos(2.0 * t)
                      - 2.0 * math.cos(3.0 * t) - math.cos(4.0 * t))
                raw.append((hx, hy))
            mx = max(abs(a) for a, b in raw)
            my = max(abs(b) for a, b in raw)
            sc = R / (mx if mx > my else my)
            for i, (hx, hy) in enumerate(raw):
                x = cx + hx * sc
                y = cy - hy * sc
                if i == 0:
                    p.moveTo(float(x), float(y))
                else:
                    p.lineTo(float(x), float(y))
            p.close()
        elif shape == 7:
            n = 8
            inner = R * 0.80
            a0 = -math.pi / 2.0
            sx = cx + inner * math.cos(a0)
            sy = cy + inner * math.sin(a0)
            p.moveTo(float(sx), float(sy))
            for i in range(n):
                amid = a0 + 2.0 * math.pi * (i + 0.5) / n
                anext = a0 + 2.0 * math.pi * (i + 1) / n
                bx = cx + R * math.cos(amid)
                by = cy + R * math.sin(amid)
                nx = cx + inner * math.cos(anext)
                ny = cy + inner * math.sin(anext)
                p.quadTo(float(bx), float(by), float(nx), float(ny))
            p.close()
        elif shape == 8:
            pts = getattr(self, "_cur_custom_pts", None) or []
            if len(pts) >= 3:
                for i, (nx, ny) in enumerate(pts):
                    x = nx * w
                    y = ny * h
                    if i == 0:
                        p.moveTo(float(x), float(y))
                    else:
                        p.lineTo(float(x), float(y))
                p.close()
            else:
                p.addCircle(float(cx), float(cy), float(R), Path.Direction.CW)
        else:
            p.addCircle(float(cx), float(cy), float(R), Path.Direction.CW)
        rr = int(getattr(self, "_cur_round", getattr(self, "_avatar_round", 0)))
        if rr > 0 and shape != 0:
            try:
                from android.graphics import Paint as _Paint, CornerPathEffect, Path as _Path2
                eff = CornerPathEffect(float(rr) / 100.0 * R)
                _pt = _Paint()
                _pt.setPathEffect(eff)
                out = _Path2()
                if _pt.getFillPath(p, out):
                    return out
            except Exception as e:
                if not getattr(self, "_avround_err", False):
                    self._avround_err = True
                    self.log(f"[cpb] corner round error: {e}")
        return p

    def avatar_draw_before(self, param):
        if not getattr(self, "_avdbg1", False):
            self._avdbg1 = True
            try:
                self.log("[cpb] avdraw before fired own=%s shape=%s" % (getattr(self, "_cur_own", None), getattr(self, "_avatar_shape", 0)))
            except Exception:
                pass
        shape = int(getattr(self, "_cur_shape", 0))
        alpha = int(getattr(self, "_cur_alpha", 100))
        dim = int(getattr(self, "_cur_dim", 0))
        if dim < 0:
            dim = 0
        if dim > 100:
            dim = 100
        fade = int(getattr(self, "_cur_fade", 0))
        fade_rad = int(getattr(self, "_cur_fade_radius", 50))
        if fade_rad < 0:
            fade_rad = 0
        if fade_rad > 100:
            fade_rad = 100
        if alpha < 0:
            alpha = 0
        if alpha > 100:
            alpha = 100
        if fade < 0:
            fade = 0
        if fade > 100:
            fade = 100
        need_clip = shape >= 3
        need_alpha = alpha < 100
        need_fade = fade > 0
        need_dim = dim > 0
        if not need_clip and not need_alpha and not need_fade and not need_dim:
            return
        view = param.thisObject
        try:
            pe = self._field_super(view, "progressToExpand")
            if float(pe.getFloat(view)) > 0.01:
                return
        except Exception:
            pass
        w = int(view.getWidth())
        h = int(view.getHeight())
        if w <= 0 or h <= 0:
            return
        canvas = param.args[0]
        path = None
        if need_clip:
            try:
                path = self._build_shape_path(shape, w, h)
            except Exception as e:
                if not getattr(self, "_avpath_err", False):
                    self._avpath_err = True
                    self.log(f"[cpb] avatar path build error: {e}")
                path = None
                need_clip = False
                if not need_alpha and not need_dim:
                    self._av_layer = None
                    self._av_dim = None
                    return
        try:
            sc = canvas.save()
            if need_alpha:
                try:
                    canvas.saveLayerAlpha(0.0, 0.0, float(w), float(h), int(round(alpha * 255.0 / 100.0)))
                except Exception as _ea:
                    if not getattr(self, "_avalpha_err", False):
                        self._avalpha_err = True
                        self.log(f"[cpb] saveLayerAlpha failed: {_ea}")
            elif need_fade or need_dim:
                try:
                    canvas.saveLayer(0.0, 0.0, float(w), float(h), None)
                except Exception as _el:
                    if not getattr(self, "_avlayer_err", False):
                        self._avlayer_err = True
                        self.log(f"[cpb] saveLayer failed: {_el}")
                    need_fade = False
            if need_clip and path is not None:
                canvas.clipPath(path)
            self._av_layer = ("clip", sc, (fade, fade_rad, w, h) if need_fade else None)
            self._av_dim = (dim, w, h) if need_dim else None
            if not getattr(self, "_avdbg3", False):
                self._avdbg3 = True
                self.log("[cpb] avdraw clip=%s alpha=%d w=%d h=%d" % (need_clip, alpha, w, h))
        except Exception as e2:
            self._av_layer = None
            if not getattr(self, "_avclip_err", False):
                self._avclip_err = True
                self.log(f"[cpb] avatar clipPath failed: {e2}")

    def avatar_draw_after(self, param):
        lay = getattr(self, "_av_layer", None)
        if not lay:
            return
        self._av_layer = None
        mode = lay[0]
        canvas = param.args[0]
        if mode == "layer":
            rc = lay[1]
            path = lay[2]
            try:
                from android.graphics import Paint
                from java import jclass
                PDX = jclass("android.graphics.PorterDuffXfermode")
                PDM = jclass("android.graphics.PorterDuff$Mode")
                paint = Paint(Paint.ANTI_ALIAS_FLAG)
                paint.setXfermode(PDX(PDM.DST_IN))
                canvas.drawPath(path, paint)
            except Exception as e:
                if not getattr(self, "_avmask_err", False):
                    self._avmask_err = True
                    self.log(f"[cpb] avatar mask draw error: {e}")
            finally:
                try:
                    canvas.restoreToCount(rc)
                except Exception:
                    pass
        else:
            try:
                _dinf = getattr(self, "_av_dim", None)
                if _dinf is not None:
                    self._av_dim = None
                    from android.graphics import Paint as _DP, PorterDuff as _PD, PorterDuffXfermode as _PDX
                    from java import jint as _ji
                    _dd, _dw, _dh = _dinf
                    _da = int(max(0, min(100, int(_dd))) * 255 / 100)
                    _dcol = ((_da & 0xFF) << 24)
                    if _dcol >= 0x80000000:
                        _dcol -= 0x100000000
                    _dpp = _DP(_DP.ANTI_ALIAS_FLAG)
                    _dpp.setColor(_ji(int(_dcol)))
                    _dpp.setXfermode(_PDX(_PD.Mode.SRC_ATOP))
                    canvas.drawRect(0.0, 0.0, float(_dw), float(_dh), _dpp)
            except Exception as _de:
                if not getattr(self, "_avdim_err", False):
                    self._avdim_err = True
                    self.log(f"[cpb] avatar dim error: {_de}")
            try:
                fadeinfo = lay[2]
                if fadeinfo is not None:
                    try:
                        from android.graphics import RadialGradient, Shader, Paint, PorterDuff, PorterDuffXfermode
                        from java import jint, jfloat, jarray
                        fd, frad, fw, fh = fadeinfo
                        R = 0.5 * (float(fw) if fw > fh else float(fh))
                        inner = float(frad) / 100.0
                        if inner < 0.02:
                            inner = 0.02
                        if inner > 0.98:
                            inner = 0.98
                        _ea = int(round(255.0 * (1.0 - float(fd) / 100.0)))
                        if _ea < 0:
                            _ea = 0
                        if _ea > 255:
                            _ea = 255
                        _edge = ((_ea & 0xFF) << 24) | 0x00FFFFFF
                        if _edge >= 0x80000000:
                            _edge -= 0x100000000
                        cols = jarray(jint)([-1, -1, _edge])
                        pos = jarray(jfloat)([0.0, inner, 1.0])
                        rg = RadialGradient(float(fw) / 2.0, float(fh) / 2.0, R, cols, pos, Shader.TileMode.CLAMP)
                        mp = Paint(Paint.ANTI_ALIAS_FLAG)
                        mp.setShader(rg)
                        mp.setXfermode(PorterDuffXfermode(PorterDuff.Mode.DST_IN))
                        canvas.drawRect(0.0, 0.0, float(fw), float(fh), mp)
                    except Exception as _ef:
                        if not getattr(self, "_avfade_err", False):
                            self._avfade_err = True
                            self.log(f"[cpb] avatar fade error: {_ef}")
            finally:
                try:
                    canvas.restoreToCount(lay[1])
                except Exception:
                    pass

    def _name_views(self, pa):
        out = []
        views = self._deep_field(pa, "nameTextView")
        if views is None:
            return out
        try:
            n = int(len(views))
            for i in range(n):
                try:
                    v = views[i]
                except Exception:
                    v = None
                if v is not None:
                    out.append(v)
        except Exception:
            out.append(views)
        return out

    def _sin01(self, x):
        try:
            import math
            return math.sin(float(x) * 6.28318530718)
        except Exception:
            return 0.0

    def _hsv_color(self, h):
        try:
            from java import jfloat, jarray
            from android.graphics import Color
            arr = jarray(jfloat)([float(h) * 360.0, 1.0, 1.0])
            return int(Color.HSVToColor(arr))
        except Exception:
            return -1

    def _jcol(self, v):
        v = int(v) & 0xFFFFFFFF
        if v >= 0x80000000:
            v -= 0x100000000
        return int(v)

    def _rc_col(self, cfg, key, dflt):
        try:
            c = self._parse_color(cfg.get(key, ""))
            return int(c) if c is not None else int(dflt)
        except Exception:
            return int(dflt)

    def _name_shader(self, fx, w, phase, c1, c2, base_col, ang=0):
        try:
            from java import jint, jfloat, jarray
            from android.graphics import LinearGradient, Shader, Matrix
            wf = float(w)
            if wf <= 1.0:
                return None
            if fx == 2:
                cols = jarray(jint)([int(c1), int(c2), int(c1)])
                pos = jarray(jfloat)([0.0, 0.5, 1.0])
                sh = LinearGradient(0.0, 0.0, wf, 0.0, cols, pos, Shader.TileMode.MIRROR)
            elif fx == 3:
                b = int(base_col)
                cols = jarray(jint)([b, b, -1, b, b])
                pos = jarray(jfloat)([0.0, 0.38, 0.5, 0.62, 1.0])
                sh = LinearGradient(0.0, 0.0, wf, 0.0, cols, pos, Shader.TileMode.CLAMP)
            elif fx == 6:
                cols = jarray(jint)([self._jcol(0xFFFF3B30), self._jcol(0xFFFF9500), self._jcol(0xFFFFE04D), self._jcol(0xFFFF9500), self._jcol(0xFFFF3B30)])
                pos = jarray(jfloat)([0.0, 0.3, 0.5, 0.7, 1.0])
                sh = LinearGradient(0.0, 0.0, wf, 0.0, cols, pos, Shader.TileMode.MIRROR)
            elif fx == 7:
                cols = jarray(jint)([self._jcol(0xFFFFFFFF), self._jcol(0xFF7FDBFF), self._jcol(0xFF3390EC), self._jcol(0xFF7FDBFF), self._jcol(0xFFFFFFFF)])
                pos = jarray(jfloat)([0.0, 0.3, 0.5, 0.7, 1.0])
                sh = LinearGradient(0.0, 0.0, wf, 0.0, cols, pos, Shader.TileMode.MIRROR)
            else:
                carr = []
                parr = []
                for i in range(7):
                    carr.append(self._hsv_color(float(i) / 6.0))
                    parr.append(float(i) / 6.0)
                cols = jarray(jint)(carr)
                pos = jarray(jfloat)(parr)
                sh = LinearGradient(0.0, 0.0, wf, 0.0, cols, pos, Shader.TileMode.REPEAT)
            m = Matrix()
            if fx == 3:
                m.setTranslate(wf * (2.0 * float(phase) - 1.0), 0.0)
            else:
                m.setTranslate(wf * float(phase), 0.0)
            try:
                _a = float(int(ang) % 360)
            except Exception:
                _a = 0.0
            if _a != 0.0:
                m.postRotate(_a, wf * 0.5, 0.0)
            sh.setLocalMatrix(m)
            return sh
        except Exception:
            return None

    def _name_font_tf(self, fid, path=None):
        try:
            fid = int(fid)
        except Exception:
            fid = 0
        if fid <= 0:
            return None
        cache = getattr(self, "_name_tf_cache", None)
        if cache is None:
            cache = {}
            self._name_tf_cache = cache
        if fid == 6:
            if not path:
                path = getattr(self, "_name_font_path", "") or ""
            if not path:
                return None
            try:
                import os as _os
                _mt = int(_os.path.getmtime(path)) if _os.path.exists(path) else 0
            except Exception:
                _mt = 0
            key = ("c", path, _mt)
            if key in cache:
                return cache[key]
            ctf = None
            try:
                import os
                from android.graphics import Typeface
                if os.path.exists(path):
                    ctf = Typeface.createFromFile(path)
            except Exception:
                ctf = None
            cache[key] = ctf
            return ctf
        if fid in cache:
            return cache[fid]
        tf = None
        try:
            from android.graphics import Typeface
            if fid == 1:
                tf = Typeface.create("sans-serif", Typeface.NORMAL)
            elif fid == 2:
                tf = Typeface.create("serif", Typeface.BOLD)
            elif fid == 3:
                tf = Typeface.create("monospace", Typeface.BOLD)
            elif fid == 4:
                tf = Typeface.create("sans-serif", Typeface.BOLD_ITALIC)
            elif fid == 5:
                tf = Typeface.create("sans-serif-condensed", Typeface.BOLD)
        except Exception:
            tf = None
        cache[fid] = tf
        return tf

    def _apply_name_style(self, pa, size_pct, font_id, font_path=None):
        try:
            try:
                size_pct = int(size_pct)
            except Exception:
                size_pct = 100
            try:
                font_id = int(font_id)
            except Exception:
                font_id = 0
            if size_pct < 50 or size_pct > 200:
                size_pct = 100
            if font_id < 0 or font_id > 6:
                font_id = 0
            active = (size_pct != 100) or (font_id > 0)
            st = getattr(self, "_name_style_state", None)
            if st is None:
                if not active:
                    return
                st = {}
                self._name_style_state = st
            views = self._name_views(pa)
            if not views:
                return
            try:
                pkey = int(pa.hashCode())
            except Exception:
                pkey = id(pa)
            from org.telegram.messenger import AndroidUtilities
            dens = float(AndroidUtilities.density)
            if dens <= 0.0:
                dens = 1.0
            dmap = getattr(self, "_glow_dups", None) or {}
            idx = -1
            for v in views:
                idx += 1
                skey = (pkey, idx)
                ent = st.get(skey)
                if ent is None:
                    if not active:
                        continue
                    try:
                        ent = {"px": float(v.getPaint().getTextSize()), "tf": v.getPaint().getTypeface()}
                    except Exception:
                        continue
                    st[skey] = ent
                _fpk = ""
                if font_id == 6:
                    _fp0 = font_path or getattr(self, "_name_font_path", "") or ""
                    _fpk = _fp0
                    if _fp0:
                        try:
                            _fpk = _fp0 + ":" + str(int(os.path.getmtime(_fp0)))
                        except Exception:
                            pass
                if ent.get("ap") != (size_pct, font_id, _fpk):
                    try:
                        want_px = float(ent["px"]) * (float(size_pct) / 100.0)
                        v.setTextSize(int(round(want_px / dens)))
                    except Exception:
                        pass
                    try:
                        tf = self._name_font_tf(font_id, font_path)
                        if tf is None:
                            tf = ent.get("tf")
                        v.setTypeface(tf)
                    except Exception:
                        pass
                    ent["ap"] = (size_pct, font_id, _fpk)
                    try:
                        v.requestLayout()
                    except Exception:
                        pass
                    try:
                        v.invalidate()
                    except Exception:
                        pass
                dent = dmap.get(skey) if dmap else None
                if dent is not None:
                    dup = dent.get("view")
                    if dup is not None:
                        try:
                            if abs(float(dup.getPaint().getTextSize()) - float(v.getPaint().getTextSize())) > 0.6:
                                dup.setTextSize(int(round(float(v.getPaint().getTextSize()) / dens)))
                                dup.getPaint().setTextSize(float(v.getPaint().getTextSize()))
                                dup.invalidate()
                        except Exception:
                            pass
                        try:
                            _vtf = v.getPaint().getTypeface()
                            _dtf = dup.getPaint().getTypeface()
                            if (_dtf is None) != (_vtf is None) or (_dtf is not None and not _dtf.equals(_vtf)):
                                dup.setTypeface(_vtf)
                                dup.invalidate()
                        except Exception:
                            pass
                if not active:
                    st.pop(skey, None)
        except Exception:
            pass

    def _name_glow_dup(self, v, skey):
        try:
            dmap = getattr(self, "_glow_dups", None)
            if dmap is None:
                dmap = {}
                self._glow_dups = dmap
            ent = dmap.get(skey)
            if ent is not None and ent.get("view") is not None:
                return ent
            parent = v.getParent()
            if parent is None:
                return None
            from org.telegram.ui.ActionBar import SimpleTextView
            dup = SimpleTextView(v.getContext())
            try:
                from org.telegram.messenger import AndroidUtilities
                dens = float(AndroidUtilities.density)
                if dens <= 0.0:
                    dens = 1.0
                dup.setTextSize(int(round(float(v.getPaint().getTextSize()) / dens)))
            except Exception:
                pass
            try:
                dup.setTypeface(v.getPaint().getTypeface())
            except Exception:
                pass
            try:
                dup.getPaint().setTextSize(float(v.getPaint().getTextSize()))
            except Exception:
                pass
            try:
                dup.setGravity(int(v.getGravity()))
            except Exception:
                pass
            try:
                parent.setClipChildren(False)
                parent.setClipToPadding(False)
            except Exception:
                pass
            idx = 0
            try:
                idx = int(parent.indexOfChild(v))
            except Exception:
                idx = 0
            try:
                from android.view import ViewGroup
                parent.addView(dup, idx, ViewGroup.LayoutParams(-2, -2))
            except Exception:
                return None
            ent = {"view": dup, "rad": -1.0, "txt": None}
            dmap[skey] = ent
            return ent
        except Exception:
            return None

    def _glow_set_blur(self, ent, rad):
        try:
            dup = ent.get("view")
            if dup is None:
                return
            try:
                from org.telegram.messenger import AndroidUtilities
                r = float(AndroidUtilities.dp(float(rad))) * 0.75
            except Exception:
                r = float(rad) * 2.0
            if r < 1.0:
                r = 1.0
            if abs(float(ent.get("rad", -1.0)) - r) < 0.5:
                return
            ent["rad"] = r
            try:
                from android.graphics import Paint
                p = dup.getPaint()
                p.setStyle(Paint.Style.FILL_AND_STROKE)
                sw = r * 0.35
                if sw > 14.0:
                    sw = 14.0
                if sw < 2.0:
                    sw = 2.0
                p.setStrokeWidth(float(sw))
            except Exception:
                pass
            try:
                from android.graphics import RenderEffect, Shader
                dup.setRenderEffect(RenderEffect.createBlurEffect(r, r, Shader.TileMode.DECAL))
                return
            except Exception:
                pass
            try:
                from android.graphics import BlurMaskFilter
                dup.setLayerType(1, None)
                dup.getPaint().setMaskFilter(BlurMaskFilter(r, BlurMaskFilter.Blur.NORMAL))
            except Exception:
                pass
        except Exception:
            pass

    def _apply_name_fx(self, pa, glow_on, glow_col, glow_rad, glow_str, fx, speed, c1, c2, nc_on, nc_col, top_view, grad_ang=0):
        fx = int(fx)
        active = bool(glow_on) or fx > 0
        if not active and not getattr(self, "_name_fx_dirty", False):
            return
        views = self._name_views(pa)
        if not views:
            return
        self._name_fx_dirty = active
        base_map = getattr(self, "_name_fx_base", None)
        if base_map is None:
            base_map = {}
            self._name_fx_base = base_map
        try:
            pkey = int(pa.hashCode())
        except Exception:
            pkey = id(pa)
        import time
        t = float(time.time())
        sp = float(speed) / 100.0
        if sp <= 0.05:
            sp = 1.0
        phase = (t * 0.35 * sp) % 1.0
        wave = 0.5 + 0.5 * self._sin01(t * 0.35 * sp)
        flick = 0.68 + 0.32 * abs(self._sin01(t * 2.3 * sp) * self._sin01(t * 5.1 * sp + 0.7))
        if 0.5 + 0.5 * self._sin01(t * 0.83 * sp + 0.31) > 0.94:
            flick = flick * 0.35
        g_alpha = int(max(0, min(100, int(glow_str))) * 254 // 100)
        _hfade = 1.0
        try:
            _w0 = 0.0
            try:
                if top_view is not None:
                    _w0 = float(top_view.getMeasuredWidth())
            except Exception:
                _w0 = 0.0
            _hfade = float(self._scroll_fade(pa, _w0))
        except Exception:
            _hfade = 1.0
        idx = -1
        for v in views:
            idx += 1
            skey = (pkey, idx)
            try:
                tp = v.getPaint()
            except Exception:
                tp = None
            if tp is None:
                continue
            if skey not in base_map:
                try:
                    base_map[skey] = int(v.getTextColor())
                except Exception:
                    base_map[skey] = -1
            base = int(nc_col) if nc_on else int(base_map.get(skey, -1))
            try:
                tp.setShader(None)
            except Exception:
                pass
            try:
                tp.clearShadowLayer()
            except Exception:
                pass
            if not active:
                try:
                    v.setTextColor(int(base_map.get(skey, base)))
                except Exception:
                    pass
                base_map.pop(skey, None)
                try:
                    _ge = (getattr(self, "_glow_dups", None) or {}).get(skey)
                    if _ge is not None and _ge.get("view") is not None:
                        _ge["view"].setVisibility(8)
                except Exception:
                    pass
                try:
                    v.invalidate()
                except Exception:
                    pass
                continue
            g_rad = float(glow_rad)
            eff_rad = max(g_rad, 10.0) if fx == 5 else g_rad
            ga = float(g_alpha) / 255.0
            if fx == 1:
                ga = ga * (0.3 + 0.7 * wave)
            if fx == 5:
                ga = ga * flick
            glow_need = (bool(glow_on) or fx == 5) and g_alpha > 0 and eff_rad > 0.2
            dup = None
            if glow_need:
                ent = self._name_glow_dup(v, skey)
            else:
                ent = (getattr(self, "_glow_dups", None) or {}).get(skey)
            if ent is not None:
                dup = ent.get("view")
            if dup is not None and not glow_need:
                try:
                    dup.setVisibility(8)
                except Exception:
                    pass
                dup = None
            if dup is not None:
                try:
                    if int(dup.getVisibility()) != int(v.getVisibility()):
                        dup.setVisibility(int(v.getVisibility()))
                    txt = None
                    try:
                        txt = v.getText()
                    except Exception:
                        txt = None
                    if txt is not None and ent.get("txt") != str(txt):
                        ent["txt"] = str(txt)
                        dup.setText(txt)
                    _need_lay = (dup.getLeft() != v.getLeft() or dup.getTop() != v.getTop() or dup.getRight() != v.getRight() or dup.getBottom() != v.getBottom())
                    _tw = 0
                    try:
                        _tw = int(dup.getTextWidth())
                    except Exception:
                        _tw = 0
                    if _need_lay or _tw <= 0:
                        try:
                            _wm = int(v.getWidth())
                            _hm = int(v.getHeight())
                            if _wm > 0 and _hm > 0:
                                dup.measure(int(1073741824 | _wm), int(1073741824 | _hm))
                                dup.layout(int(v.getLeft()), int(v.getTop()), int(v.getRight()), int(v.getBottom()))
                        except Exception:
                            pass
                    _ox = 0.0
                    try:
                        _ox = float(v.getTextStartX()) - float(int(v.getX()))
                    except Exception:
                        _ox = 0.0
                    if _ox < 0.0 or _ox > float(v.getWidth()):
                        _ox = 0.0
                    try:
                        if int(dup.getTextWidth()) > 0:
                            _do = float(dup.getTextStartX()) - float(int(dup.getX()))
                            if 0.0 <= _do <= float(dup.getWidth()):
                                _ox = _ox - _do
                    except Exception:
                        pass
                    _oy = 0.0
                    try:
                        _f = self._field_super(v, "offsetY")
                        _oy = float(int(_f.getInt(v)))
                        try:
                            if int(dup.getTextWidth()) > 0:
                                _oy = _oy - float(int(_f.getInt(dup)))
                        except Exception:
                            pass
                    except Exception:
                        _oy = 0.0
                    if _oy < -float(v.getHeight()) or _oy > float(v.getHeight()):
                        _oy = 0.0
                    dup.setTranslationX(float(v.getX()) - float(dup.getLeft()) + _ox * float(v.getScaleX()))
                    dup.setTranslationY(float(v.getY()) - float(dup.getTop()) + _oy * float(v.getScaleY()))
                    try:
                        dup.setPivotX(float(v.getPivotX()))
                        dup.setPivotY(float(v.getPivotY()))
                    except Exception:
                        pass
                    dup.setScaleX(float(v.getScaleX()))
                    dup.setScaleY(float(v.getScaleY()))
                    self._glow_set_blur(ent, eff_rad)
                    col = (int(base) & 0x00FFFFFF) | (0xFF << 24)
                    if col >= 0x80000000:
                        col = col - 0x100000000
                    try:
                        dup.setTextColor(int(col))
                    except Exception:
                        pass
                    a = float(ga) * float(v.getAlpha()) * float(_hfade)
                    if a < 0.0:
                        a = 0.0
                    if a > 1.0:
                        a = 1.0
                    dup.setAlpha(a)
                    if fx not in (2, 3, 4, 6, 7):
                        try:
                            dup.getPaint().setShader(None)
                        except Exception:
                            pass
                    dup.invalidate()
                except Exception:
                    pass
            if fx == 1:
                a = int(80 + 175 * wave)
                col = (int(base) & 0x00FFFFFF) | ((a & 0xFF) << 24)
                if col >= 0x80000000:
                    col = col - 0x100000000
                try:
                    v.setTextColor(int(col))
                except Exception:
                    pass
            elif fx == 5:
                a = int(150 + 105 * flick)
                col = (int(base) & 0x00FFFFFF) | ((a & 0xFF) << 24)
                if col >= 0x80000000:
                    col = col - 0x100000000
                try:
                    v.setTextColor(int(col))
                except Exception:
                    pass
            else:
                try:
                    v.setTextColor(int(base))
                except Exception:
                    pass
                if fx in (2, 3, 4, 6, 7):
                    w = 0
                    try:
                        w = int(v.getTextWidth())
                    except Exception:
                        w = 0
                    if w <= 0:
                        try:
                            w = int(v.getMeasuredWidth())
                        except Exception:
                            w = 0
                    sh = self._name_shader(fx, w, phase, c1, c2, base, grad_ang)
                    if sh is not None:
                        try:
                            tp.setShader(sh)
                        except Exception:
                            pass
                        if dup is not None:
                            try:
                                dup.getPaint().setShader(sh)
                            except Exception:
                                pass
            try:
                v.invalidate()
            except Exception:
                pass
        if fx > 0 and active:
            self._name_color_state = {}
            try:
                if top_view is not None:
                    top_view.invalidate()
            except Exception:
                pass
        if not active:
            self._name_color_state = {}

    def _apply_name_color(self, pa, enabled, color):
        views = self._deep_field(pa, "nameTextView")
        if views is None:
            return
        try:
            n = int(len(views))
            is_arr = True
        except Exception:
            n = 1
            is_arr = False
        if n <= 0:
            return
        state = getattr(self, "_name_color_state", None)
        if state is None:
            state = {}
            self._name_color_state = state
        orig = getattr(self, "_name_color_orig", None)
        if orig is None:
            orig = {}
            self._name_color_orig = orig
        try:
            pkey = int(pa.hashCode())
        except Exception:
            pkey = id(pa)
        for i in range(n):
            try:
                v = views[i] if is_arr else views
            except Exception:
                continue
            if v is None:
                continue
            skey = (pkey, i)
            if enabled:
                if state.get(skey) != color:
                    if skey not in orig:
                        try:
                            orig[skey] = int(v.getTextColor())
                        except Exception:
                            pass
                    try:
                        v.setTextColor(int(color))
                        state[skey] = color
                    except Exception:
                        pass
            elif skey in state:
                o = orig.get(skey)
                if o is not None:
                    try:
                        v.setTextColor(int(o))
                    except Exception:
                        pass
                state.pop(skey, None)

    def apply_before_draw(self, param):
        top_view = param.thisObject
        pa = self._field(top_view, "this$0").get(top_view)
        own = self._is_edit_target(pa)
        self._cur_own = own
        if own:
            try:
                _atag = self._acct_tag()
                if getattr(self, "_loaded_acct", None) != _atag:
                    self._loaded_acct = _atag
                    self._migrate_account()
                    self._reload_state()
            except Exception as _re:
                if not getattr(self, "_reload_err", False):
                    self._reload_err = True
                    self.log(f"[cpb] account reload failed: {_re}")
        self._cur_alpha = 100
        self._cur_dim = 0
        self._cur_fade = 0
        self._cur_fade_radius = 50
        self._cur_shape = 0
        self._cur_round = 0
        self._cur_custom_pts = []
        if own:
            self._cur_shape = int(getattr(self, "_avatar_shape", 0))
            self._cur_round = int(getattr(self, "_avatar_round", 0))
            self._cur_custom_pts = getattr(self, "_avatar_custom_pts", None) or []
            self._cur_alpha = int(getattr(self, "_avatar_alpha", 100))
            self._cur_dim = int(getattr(self, "_avatar_dim", 0))
            self._cur_fade = int(getattr(self, "_avatar_fade", 0))
            self._cur_fade_radius = int(getattr(self, "_avatar_fade_radius", 50))
        else:
            try:
                _uid = self._viewed_uid(pa)
                _ent = self._remote.get(_uid) if _uid and _uid != 0 else None
                if _ent and _ent.get("state") == "ready":
                    _rc = _ent.get("cfg") or {}
                    self._cur_shape = int(_rc.get("avatar_shape", 0))
                    self._cur_round = int(_rc.get("avatar_round", 0))
                    self._cur_custom_pts = self._parse_custom_pts(_rc.get("avatar_custom", ""))
                    self._cur_alpha = int(_rc.get("avatar_alpha", 100))
                    self._cur_dim = int(_rc.get("avatar_dim", 0))
                    self._cur_fade = int(_rc.get("avatar_fade", 0))
                    self._cur_fade_radius = int(_rc.get("avatar_fade_radius", 50))
            except Exception:
                pass
        if own:
            try:
                self._apply_avatar_shape(pa)
            except Exception:
                pass

        try:
            _nc_on = False
            _nc_col = -1
            if own:
                _nc_on = bool(getattr(self, "_name_color_enabled", False))
                _nc_col = int(getattr(self, "_name_color", -1))
            else:
                _nuid = self._viewed_uid(pa)
                _nent = self._remote.get(_nuid) if _nuid and _nuid != 0 else None
                if _nent and _nent.get("state") == "ready":
                    _nrc = _nent.get("cfg") or {}
                    _nc_on = bool(_nrc.get("name_color_enabled", False))
                    _npc = self._parse_color(_nrc.get("name_color", ""))
                    _nc_col = _npc if _npc is not None else -1
            self._apply_name_color(pa, _nc_on, _nc_col)
            _nsz = 100
            _nfont = 0
            _nfp = None
            if own:
                _nsz = int(getattr(self, "_name_size", 100))
                _nfont = int(getattr(self, "_name_font", 0))
            else:
                try:
                    if _nent and _nent.get("state") == "ready":
                        _nrc4 = _nent.get("cfg") or {}
                        _nsz = int(_nrc4.get("name_size", 100) or 100)
                        _nfont = int(_nrc4.get("name_font", 0) or 0)
                        if _nfont == 6:
                            _nfp = str(_nent.get("font_path") or "")
                            if not _nfp or not os.path.exists(_nfp):
                                _nfont = 0
                                _nfp = None
                        elif _nfont > 6:
                            _nfont = 0
                except Exception:
                    pass
            try:
                self._apply_name_style(pa, _nsz, _nfont, _nfp)
            except Exception:
                pass
            if own:
                _g_on = bool(getattr(self, "_name_glow_enabled", False))
                _g_col = int(getattr(self, "_name_glow_color", -1))
                _g_rad = int(getattr(self, "_name_glow_radius", 12))
                _g_str = int(getattr(self, "_name_glow_strength", 100))
                _fx = int(getattr(self, "_name_fx", 0))
                _fxsp = int(getattr(self, "_name_fx_speed", 100))
                _gc1 = int(getattr(self, "_name_grad_c1", -1))
                _gc2 = int(getattr(self, "_name_grad_c2", -1))
                _gang = int(getattr(self, "_name_grad_angle", 0))
            else:
                _g_on = False
                _g_col = -1
                _g_rad = 12
                _g_str = 100
                _fx = 0
                _fxsp = 100
                _gc1 = -1
                _gc2 = -1
                _gang = 0
                if _nent and _nent.get("state") == "ready":
                    _nrc2 = _nent.get("cfg") or {}
                    _g_on = bool(_nrc2.get("name_glow_enabled", False))
                    _g_col = self._rc_col(_nrc2, "name_glow_color", -1)
                    _g_rad = int(_nrc2.get("name_glow_radius", 12) or 0)
                    _g_str = int(_nrc2.get("name_glow_strength", 100) or 100)
                    _fx = int(_nrc2.get("name_fx", 0) or 0)
                    _fxsp = int(_nrc2.get("name_fx_speed", 100) or 100)
                    _gc1 = self._rc_col(_nrc2, "name_grad_c1", -1)
                    _gc2 = self._rc_col(_nrc2, "name_grad_c2", -1)
                    _gang = int(_nrc2.get("name_grad_angle", 0) or 0)
            self._apply_name_fx(pa, _g_on, _g_col, _g_rad, _g_str, _fx, _fxsp, _gc1, _gc2, _nc_on, _nc_col, top_view, _gang)
        except Exception as _nce:
            if not getattr(self, "_namecolor_err", False):
                self._namecolor_err = True
                self.log("[cpb] name color error: " + str(_nce))
        paint = self._field(top_view, "paint").get(top_view)
        shader = None
        if own and self._enabled:
            width = top_view.getMeasuredWidth()
            v10 = self._header_height(pa)
            if v10 <= 0:
                v10 = float(width)
            try:
                shader = self._ensure_banner_shader(width, v10)
            except Exception as e:
                if not getattr(self, "_shader_err", False):
                    self._shader_err = True
                    self.log(f"[cpb] shader build error: {e}")
                shader = None
        elif not own:
            try:
                uid = self._viewed_uid(pa)
                if uid != 0 and not getattr(self, "_remote_enabled", False):
                    self._maybe_ask_remote_consent()
                if uid != 0:
                    if getattr(self, "_remote", None) is None:
                        self._remote = {}
                    entry = self._remote.get(uid)
                    if entry is not None and entry.get("state") != "loading":
                        self._maybe_recheck_remote(uid, top_view)
                    if entry is None and getattr(self, "_remote_enabled", False):
                        self._remote[uid] = {"state": "loading"}
                        self._start_remote_fetch(uid, top_view)
                    elif entry.get("state") == "ready":
                        width = top_view.getMeasuredWidth()
                        v10 = self._header_height(pa)
                        if v10 <= 0:
                            v10 = float(width)
                        shader = self._remote_shader(entry, width, v10)
            except Exception as e:
                if not getattr(self, "_remote_err", False):
                    self._remote_err = True
                    self.log(f"[cpb] remote draw error: {e}")
                shader = None
        if shader is not None:
            paint.setShader(shader)
            self._active_shader = shader
        else:
            paint.setShader(None)
            self._active_shader = None

        if own:
            if not self._show_emoji:
                try:
                    self._field(top_view, "hasEmoji").setBoolean(top_view, False)
                except Exception:
                    pass
        else:
            try:
                e = self._remote.get(self._viewed_uid(pa))
                if e and e.get("state") == "ready" and not e.get("show_emoji", True):
                    self._field(top_view, "hasEmoji").setBoolean(top_view, False)
            except Exception:
                pass

        if own:
            try:
                self._apply_profile_background(pa)
            except Exception:
                pass
            try:
                self._apply_block_colors(pa)
            except Exception:
                pass
        else:
            try:
                e2 = self._remote.get(self._viewed_uid(pa))
                if e2 and e2.get("state") == "ready" and e2.get("bg_enabled"):
                    self._apply_remote_background(pa, e2)
            except Exception:
                pass
            try:
                self._apply_block_colors(pa)
            except Exception:
                pass

    def apply_after_draw(self, param):
        top_view = param.thisObject
        pa = self._field(top_view, "this$0").get(top_view)
        own = self._is_edit_target(pa)
        txt = ""
        tcol = -1
        bcol = -871557603
        fid = 0
        fpath = ""
        if own:
            if getattr(self, "_enabled", False):
                txt = str(getattr(self, "_thought_text", "") or "")
                tcol = int(getattr(self, "_thought_text_color", -1))
                bcol = int(getattr(self, "_thought_bg_color", -871557603))
                if getattr(self, "_thought_font_copy", True):
                    fid = int(getattr(self, "_name_font", 0))
                    fpath = getattr(self, "_name_font_path", "") or ""
                else:
                    fid = int(getattr(self, "_thought_font", 0))
                    if fid == 6:
                        fpath = getattr(self, "_thought_font_path", "") or ""
                        if not fpath:
                            fid = 0
        else:
            try:
                _uid = self._viewed_uid(pa)
                _rm = getattr(self, "_remote", None) or {}
                _ent = _rm.get(_uid) if _uid else None
                if _ent and _ent.get("state") == "ready":
                    _rc = _ent.get("cfg") or {}
                    txt = str(_rc.get("thought_text", "") or "")
                    tcol = self._rc_col(_rc, "thought_text_color", -1)
                    bcol = self._rc_col(_rc, "thought_bg_color", -871557603)
                    if _rc.get("thought_font_copy", True):
                        fid = int(_rc.get("name_font", 0) or 0)
                        fpath = _ent.get("font_path") or ""
                    else:
                        fid = int(_rc.get("thought_font", 0) or 0)
                        if fid == 6:
                            fpath = _ent.get("thought_font_path") or ""
                            if not fpath:
                                fid = 0
            except Exception:
                txt = ""
        txt = (txt or "").strip()
        if not txt:
            self._thought_hit = None
            return
        try:
            self._thought_tap_pa = int(pa.hashCode()) if own else 0
        except Exception:
            self._thought_tap_pa = 0
        try:
            self._thought_touch_lazy(pa)
        except Exception:
            pass
        try:
            self._draw_thought(param.args[0], top_view, pa, txt[:120], tcol, bcol, fid, fpath)
        except Exception as e:
            if not getattr(self, "_thought_err", False):
                self._thought_err = True
                self.log("[cpb] thought draw error: %s" % e)

    def _thought_touch_lazy(self, pa):
        done = getattr(self, "_tt_lazy", None)
        if done is None:
            done = set()
            self._tt_lazy = done
        try:
            lv = self._field(pa, "listView").get(pa)
        except Exception:
            lv = None
        if lv is None:
            return
        try:
            self._thought_tap_lv = int(lv.hashCode())
        except Exception:
            self._thought_tap_lv = 0
        try:
            c = lv.getClass()
        except Exception:
            return
        hk = _ThoughtTouchHook(self)
        depth = 0
        while c is not None and depth < 6:
            try:
                nm = str(c.getName())
            except Exception:
                break
            if nm.startswith("android.view.") or nm.startswith("java."):
                break
            if nm in done:
                break
            done.add(nm)
            total = 0
            for mn in ("onTouchEvent", "onInterceptTouchEvent", "dispatchTouchEvent"):
                try:
                    u = self.hook_all_methods(c, mn, hk)
                    if u:
                        ul = list(u)
                        self._unhooks += ul
                        total += len(ul)
                except Exception:
                    pass
            try:
                c = c.getSuperclass()
            except Exception:
                break
            depth += 1

    def _thought_touch(self, param):
        hit = getattr(self, "_thought_hit", None)
        if not hit:
            return
        pk = int(getattr(self, "_thought_tap_pa", 0) or 0)
        if not pk or int(hit[0]) != pk:
            return
        try:
            ev = param.args[0]
        except Exception:
            ev = None
        if ev is None:
            return
        act = int(ev.getActionMasked())
        if act != 0 and act != 1 and act != 3:
            return
        if act == 3:
            self._thought_down = None
            return
        lx, ly = self._view_abs_pos(param.thisObject)
        x = float(ev.getX()) + float(lx)
        y = float(ev.getY()) + float(ly)
        if act == 0:
            self._thought_down = None
            if hit[1] <= x <= hit[3] and hit[2] <= y <= hit[4]:
                ok = False
                try:
                    ok = int(param.thisObject.hashCode()) == int(getattr(self, "_thought_tap_lv", 0) or 0)
                except Exception:
                    ok = False
                if not ok:
                    try:
                        fr = get_last_fragment()
                        ok = fr is not None and int(fr.hashCode()) == pk
                    except Exception:
                        ok = False
                if ok:
                    self._thought_down = (x, y)
            return
        d = getattr(self, "_thought_down", None)
        if not d:
            return
        self._thought_down = None
        try:
            from org.telegram.messenger import AndroidUtilities
            slop = 10.0 * float(AndroidUtilities.density)
        except Exception:
            slop = 25.0
        if abs(x - d[0]) <= slop and abs(y - d[1]) <= slop:
            self._show_thought_editor()

    def _show_thought_editor(self):
        if getattr(self, "_thought_dlg", False):
            return
        self._thought_dlg = True
        plugin = self

        def _run():
            try:
                act = plugin._get_activity()
                if act is None:
                    plugin._thought_dlg = False
                    return
                from java import dynamic_proxy
                from android.widget import EditText, FrameLayout
                from org.telegram.messenger import AndroidUtilities
                dens = float(AndroidUtilities.density)
                et = EditText(act)
                et.setText(str(getattr(plugin, "_thought_text", "") or ""))
                try:
                    et.setHint(cpb_tr("Твоя мысль..."))
                    et.setMaxLines(4)
                    et.setSelection(int(et.getText().length()))
                except Exception:
                    pass
                fl = FrameLayout(act)
                fl.setPadding(int(dens * 22.0), int(dens * 6.0), int(dens * 22.0), 0)
                fl.addView(et)
                _OnBtn = find_class("org.telegram.ui.ActionBar.AlertDialog$OnButtonClickListener")
                _OnDis = find_class("android.content.DialogInterface$OnDismissListener")

                class _CpbTBtn(dynamic_proxy(_OnBtn)):
                    def __init__(self, fn):
                        super().__init__()
                        self._fn = fn

                    def onClick(self, dialog, which):
                        try:
                            self._fn()
                        except Exception:
                            pass

                class _CpbTDis(dynamic_proxy(_OnDis)):
                    def onDismiss(self, dialog):
                        plugin._thought_dlg = False

                def _cancel():
                    plugin._thought_dlg = False

                def _save(show_hint=True):
                    t = ""
                    try:
                        t = str(et.getText().toString())
                    except Exception:
                        t = ""
                    t = t.strip()[:200]
                    plugin._thought_text = t
                    try:
                        plugin._ss(KEY_THOUGHT_TEXT, t)
                    except Exception:
                        pass
                    plugin._thought_dlg = False
                    try:
                        fr = get_last_fragment()
                        tv = plugin._field(fr, "topView").get(fr)
                        if tv is not None:
                            tv.invalidate()
                    except Exception:
                        pass
                    try:
                        if not show_hint:
                            pass
                        elif t:
                            plugin._toast("Мысль сохранена. Чтобы увидели другие — опубликуй в редакторе")
                        else:
                            plugin._toast("Мысль очищена")
                    except Exception:
                        pass

                def _save_pub():
                    _save(False)
                    try:
                        if getattr(plugin, "_pub_consent", False):
                            plugin._on_publish()
                            plugin._toast("Мысль сохранена, публикуем…")
                        else:
                            plugin._toast("Нужно согласие на публикацию — один раз опубликуй через редактор")
                    except Exception:
                        pass

                Builder = find_class("org.telegram.ui.ActionBar.AlertDialog$Builder")
                b = Builder(act)
                b.setTitle(cpb_tr("Мысль"))
                b.setView(fl)
                b.setPositiveButton(cpb_tr("Сохранить"), _CpbTBtn(_save))
                b.setNegativeButton(cpb_tr("Отмена"), _CpbTBtn(_cancel))
                try:
                    if bool(getattr(plugin, "_share_enabled", False)):
                        b.setNeutralButton(cpb_tr("Опубликовать"), _CpbTBtn(_save_pub))
                except Exception:
                    pass
                dlg = b.show()
                try:
                    dlg.setOnDismissListener(_CpbTDis())
                except Exception:
                    pass
            except Exception as e:
                plugin._thought_dlg = False
                plugin.log(f"[cpb] thought editor failed: {e}")

        run_on_ui_thread(_run)

    def _view_abs_pos(self, v):
        x = 0.0
        y = 0.0
        d = 0
        while v is not None and d < 14:
            try:
                x += float(v.getX())
                y += float(v.getY())
            except Exception:
                break
            try:
                v = v.getParent()
            except Exception:
                v = None
            d += 1
        return x, y

    def _scroll_fade(self, pa, width=0.0):
        try:
            from org.telegram.messenger import AndroidUtilities
            dens = float(AndroidUtilities.density)
        except Exception:
            dens = 1.0

        def dp(v):
            return v * dens

        try:
            _extra = float(self._field(pa, "extraHeight").getFloat(pa))
        except Exception:
            return 1.0
        try:
            _key = int(pa.hashCode())
        except Exception:
            _key = 0
        _aw = -1.0
        _sc = 1.0
        try:
            _av = self._field(pa, "avatarImage").get(pa)
            if _av is not None:
                _aw = float(_av.getWidth()) * float(_av.getScaleX())
                _sc = float(_av.getScaleX())
        except Exception:
            _aw = -1.0
        _st = getattr(self, "_thought_eh", None)
        if not _st or len(_st) < 5 or _st[0] != _key:
            _st = [_key, 0.0, -1.0, 0, 0.0]
            self._thought_eh = _st
        if abs(_extra - _st[2]) <= dp(1.0):
            _st[3] = int(_st[3]) + 1
        else:
            _st[3] = 1
        _st[2] = _extra
        _attop = False
        try:
            _lv = self._field(pa, "listView").get(pa)
            if _lv is not None:
                _attop = not bool(_lv.canScrollVertically(-1))
        except Exception:
            _attop = False
        if _attop and _st[3] >= 3 and _extra >= dp(48.0):
            if _st[4] <= 0.0 or _extra < _st[4]:
                _st[4] = _extra
        if _st[4] > 0.0:
            _base = float(_st[4])
        else:
            _ok = _sc <= 1.9
            if width > 0.0 and _aw >= width * 0.5:
                _ok = False
            if _ok and _extra > _st[1]:
                _st[1] = _extra
            _base = float(_st[1])
        if _base < dp(48.0):
            _base = dp(88.0)
        _floor = dp(88.0) if _base > dp(140.0) else 0.0
        _den = _base - _floor
        if _den <= 0:
            _den = _base
        _fade = (_extra - _floor) / _den
        if _fade < 0.0:
            _fade = 0.0
        if _fade > 1.0:
            _fade = 1.0
        return _fade

    def _draw_thought(self, canvas, top_view, pa, txt, tcol=-1, bcol=-871557603, fid=0, fpath=""):
        av = None
        try:
            av = self._field(pa, "avatarImage").get(pa)
        except Exception:
            av = None
        if av is None:
            return
        from android.graphics import Paint, RectF
        from org.telegram.messenger import AndroidUtilities
        from java import jint
        dens = float(AndroidUtilities.density)

        def dp(v):
            return v * dens

        try:
            sx = float(av.getScaleX())
            sy = float(av.getScaleY())
        except Exception:
            sx = 1.0
            sy = 1.0
        aw = float(av.getWidth()) * sx
        ah = float(av.getHeight()) * sy
        if aw < dp(40.0):
            return
        ax0, ay0 = self._view_abs_pos(av)
        tx0, ty0 = self._view_abs_pos(top_view)
        ax = ax0 - tx0
        ay = ay0 - ty0
        width = float(top_view.getMeasuredWidth())
        if width <= 0:
            return
        sig = (int(tcol), int(bcol), int(fid), str(fpath or ""))
        _pc = getattr(self, "_thought_pc", None)
        if not _pc or _pc[0] != sig:
            tp = Paint(Paint.ANTI_ALIAS_FLAG)
            tp.setTextSize(dp(12.5))
            tp.setColor(jint(int(tcol)))
            if fid:
                try:
                    _tf = self._name_font_tf(fid, fpath or None)
                    if _tf is not None:
                        tp.setTypeface(_tf)
                except Exception:
                    pass
            bp = Paint(Paint.ANTI_ALIAS_FLAG)
            bp.setColor(jint(int(bcol)))
            _pc = (sig, tp, bp)
            self._thought_pc = _pc
        tp = _pc[1]
        bp = _pc[2]
        _fade = self._scroll_fade(pa, float(width))
        if _fade <= 0.02:
            self._thought_hit = None
            return
        try:
            tp.setAlpha(jint(int(((int(tcol) >> 24) & 0xFF) * _fade)))
            bp.setAlpha(jint(int(((int(bcol) >> 24) & 0xFF) * _fade)))
        except Exception:
            pass
        pad_h = dp(9.0)
        pad_v = dp(5.0)
        bx = ax + aw + dp(12.0)
        by = ay + dp(2.0)
        avail = width - bx - dp(8.0)
        _cap = width * 0.58
        if avail > _cap:
            avail = _cap
        if avail < dp(70.0):
            avail = min(dp(160.0), width - dp(16.0))
            bx = width - avail - dp(8.0)
        maxtw = avail - 2.0 * pad_h
        if maxtw < dp(30.0):
            return

        def _wrap(_maxl):
            _lines = []
            _words = txt.split(" ")
            cur = ""
            _wi = 0
            while _wi < len(_words):
                if len(_lines) >= _maxl:
                    return _lines, False
                w0 = _words[_wi]
                if w0 == "":
                    _wi += 1
                    continue
                cand = (cur + " " + w0) if cur else w0
                if tp.measureText(cand) <= maxtw:
                    cur = cand
                    _wi += 1
                    continue
                if cur:
                    _lines.append(cur)
                    cur = ""
                    continue
                k = len(w0)
                while k > 1 and tp.measureText(w0[:k]) > maxtw:
                    k -= 1
                _lines.append(w0[:k])
                _words[_wi] = w0[k:]
                if not _words[_wi]:
                    _wi += 1
            if cur:
                _lines.append(cur)
            return _lines, len(_lines) <= _maxl

        base_sz = dp(12.5)
        min_sz = dp(8.0)
        step = (base_sz - min_sz) / 9.0
        if step <= 0:
            step = 1.0
        sz = base_sz
        lines = None
        try:
            while True:
                tp.setTextSize(float(sz))
                _ls, _fit = _wrap(4)
                if _fit:
                    lines = _ls
                    break
                if sz <= min_sz:
                    lines, _f2 = _wrap(1000)
                    break
                sz = sz - step
                if sz < min_sz:
                    sz = min_sz
        except Exception:
            try:
                tp.setTextSize(float(base_sz))
            except Exception:
                pass
            lines = [txt]
        if not lines:
            return
        fm = tp.getFontMetrics()
        th = float(fm.descent - fm.ascent)
        gap = dp(2.0)
        tw = 0.0
        for _ln in lines:
            _w2 = tp.measureText(_ln)
            if _w2 > tw:
                tw = _w2
        bw = tw + 2.0 * pad_h
        bh = th * len(lines) + gap * (len(lines) - 1) + 2.0 * pad_v
        r = bh / 2.0 if len(lines) == 1 else dp(12.0)
        try:
            self._thought_hit = (int(pa.hashCode()), float(tx0 + bx), float(ty0 + by), float(tx0 + bx + bw), float(ty0 + by + bh))
        except Exception:
            pass
        rect = RectF(float(bx), float(by), float(bx + bw), float(by + bh))
        canvas.drawRoundRect(rect, r, r, bp)
        try:
            canvas.drawCircle(float(bx - dp(3.0)), float(by + bh - dp(1.0)), dp(2.4), bp)
            canvas.drawCircle(float(bx - dp(8.5)), float(by + bh + dp(3.0)), dp(1.5), bp)
        except Exception:
            pass
        _ty = by + pad_v - fm.ascent
        for _ln in lines:
            canvas.drawText(_ln, float(bx + pad_h), float(_ty), tp)
            _ty += th + gap

    def apply_after_bg_paint(self, param):
        shader = self._active_shader
        if shader is None:
            return
        top_view = param.thisObject
        bg = self._field(top_view, "backgroundPaint").get(top_view)
        bg.setShader(shader)

    def _blocks_collect(self, root, depth, out, maxd=4):
        try:
            n = int(root.getChildCount())
        except Exception:
            return out
        for i in range(n):
            try:
                ch = root.getChildAt(i)
            except Exception:
                continue
            if ch is None:
                continue
            out.append(ch)
            if depth + 1 < maxd:
                self._blocks_collect(ch, depth + 1, out, maxd)
        return out

    def _blocks_tint_drawable(self, d, f, depth=0):
        if d is None or depth > 3:
            return
        try:
            n = int(d.getNumberOfLayers())
            for i in range(n):
                try:
                    self._blocks_tint_drawable(d.getDrawable(i), f, depth + 1)
                except Exception:
                    pass
        except Exception:
            pass
        try:
            b = d.getBackgroundDrawable()
            if b is not None:
                self._blocks_tint_drawable(b, f, depth + 1)
        except Exception:
            pass
        try:
            if f is not None:
                d.mutate()
            d.setColorFilter(f)
        except Exception:
            pass

    def _blocks_cleanup(self, lv):
        try:
            for ch in self._blocks_collect(lv, 0, [], 8):
                try:
                    bgd = ch.getBackground()
                    if bgd is not None and bgd.getColorFilter() is not None:
                        self._blocks_tint_drawable(bgd, None)
                        ch.invalidate()
                except Exception:
                    pass
        except Exception:
            pass
        try:
            om = getattr(self, "_blocks_orig", None) or {}
            for h in list(om.keys()):
                try:
                    ch, orig = om[h]
                    ch.setBackground(orig)
                    ch.invalidate()
                except Exception:
                    pass
            self._blocks_orig = {}
            self._blocks_mine = set()
        except Exception:
            pass
        try:
            st = getattr(self, "_blocks_paints", None) or []
            from java import jint
            for kind, ref_, orig in st:
                try:
                    if kind == "p":
                        ref_.setColor(jint(int(orig)))
                    else:
                        fd, obj = ref_
                        fd.setInt(obj, jint(int(orig)))
                except Exception:
                    pass
            self._blocks_paints = []
            self._blocks_paints_live = []
            self._blocks_theme_restore()
            self._blocks_in_lv = False
        except Exception:
            pass
        self._blocks_theme_on = False
        try:
            lv.invalidate()
        except Exception:
            pass

    def _blocks_theme_key(self):
        kw = getattr(self, "_blocks_key_wbw", None)
        if kw is None:
            try:
                kw = find_class(THEME).key_windowBackgroundWhite
            except Exception:
                kw = None
            self._blocks_key_wbw = kw
        return kw

    def _blocks_theme_put(self, kw, col):
        from java import jint
        try:
            t = find_class(THEME)
        except Exception:
            return False
        try:
            if int(t.getColor(int(kw))) == int(col):
                return True
        except Exception:
            pass
        touched = getattr(self, "_blocks_tmaps", None)
        if touched is None:
            touched = []
            self._blocks_tmaps = touched
        diag = []
        ok = False
        try:
            jc = find_class("java.lang.Class")
            cls = jc.forName("org.telegram.ui.ActionBar.Theme")
            flds = cls.getDeclaredFields()
        except Exception as e:
            self._blocks_put_diag = "refl err:" + str(e)[:40]
            return False
        for fd in flds:
            if ok:
                break
            try:
                tn = str(fd.getType().getName())
                fname = str(fd.getName())
                if tn == "android.util.SparseIntArray" or tn == "java.util.HashMap":
                    fd.setAccessible(True)
                    m = fd.get(None)
                    if m is None:
                        continue
                    m.put(jint(int(kw)), jint(int(col)))
                    touched.append(("m", m))
                    gc = int(t.getColor(int(kw)))
                    diag.append("%s gc=#%08X" % (fname, gc & 0xFFFFFFFF))
                    if gc == int(col):
                        self._blocks_tmap_name = fname
                        ok = True
                elif tn == "[I":
                    fd.setAccessible(True)
                    arr = fd.get(None)
                    if arr is None:
                        continue
                    k = int(kw)
                    if k < 0 or k >= len(arr):
                        continue
                    old = int(arr[k])
                    arr[k] = jint(int(col))
                    touched.append(("a", (arr, k, old)))
                    gc = int(t.getColor(int(kw)))
                    diag.append("%s[] gc=#%08X" % (fname, gc & 0xFFFFFFFF))
                    if gc == int(col):
                        self._blocks_tmap_name = fname + "[]"
                        ok = True
            except Exception:
                pass
        self._blocks_put_diag = " ".join(diag[:8])[:300]
        return ok

    def _blocks_theme_set(self, col):
        kw = self._blocks_theme_key()
        if kw is None:
            return "nokey"
        from java import jint
        try:
            t = find_class(THEME)
        except Exception:
            return "nocls"
        orig = None
        try:
            orig = int(t.getColor(int(kw)))
        except Exception:
            pass
        if getattr(self, "_blocks_tset_orig", None) is None and orig is not None and orig != int(col):
            self._blocks_tset_orig = orig
        try:
            t.setColor(int(kw), jint(int(col)), False)
            self._blocks_tset_on = True
            exact = False
            try:
                exact = int(t.getColor(int(kw))) == int(col)
            except Exception:
                exact = False
            res = "ok"
            if not exact:
                if self._blocks_theme_put(kw, col):
                    exact = True
                    res = "ok:" + str(getattr(self, "_blocks_tmap_name", "?"))
                else:
                    res = "ok~"
            try:
                self._blocks_tset_eff = int(t.getColor(int(kw)))
            except Exception:
                self._blocks_tset_eff = int(col)
            return res
        except Exception as e:
            try:
                cc = t.currentColors
                cc.put(jint(int(kw)), jint(int(col)))
                self._blocks_tset_on = True
                return "ok2"
            except Exception:
                return "err:" + str(e)[:60]

    def _blocks_theme_restore(self):
        try:
            if not getattr(self, "_blocks_tset_on", False):
                return
            orig = getattr(self, "_blocks_tset_orig", None)
            kw = self._blocks_theme_key()
            if orig is None or kw is None:
                return
            from java import jint
            t = find_class(THEME)
            try:
                t.setColor(int(kw), jint(int(orig)), False)
            except Exception:
                try:
                    t.currentColors.put(jint(int(kw)), jint(int(orig)))
                except Exception:
                    pass
            try:
                st = getattr(self, "_blocks_tmaps", None) or []
                for kind, ref_ in st:
                    try:
                        if kind == "m":
                            ref_.put(jint(int(kw)), jint(int(orig)))
                        else:
                            arr2, k2, old2 = ref_
                            arr2[k2] = jint(int(old2))
                    except Exception:
                        pass
                self._blocks_tmaps = []
            except Exception:
                pass
            self._blocks_tset_on = False
        except Exception:
            pass

    def blocks_profile_pause_after(self, param):
        try:
            if int(param.thisObject.hashCode()) == int(getattr(self, "_blocks_theme_pa", 0)):
                self._blocks_theme_restore()
        except Exception:
            pass

    def _blocks_field_objs(self, pa, lv):
        objs = [(lv, True), (pa, False)]
        try:
            n = int(lv.getItemDecorationCount())
            for i in range(n):
                try:
                    objs.append((lv.getItemDecorationAt(i), True))
                except Exception:
                    pass
        except Exception:
            pass
        try:
            n = int(lv.getChildCount())
            for i in range(n):
                ch = lv.getChildAt(i)
                if ch is None:
                    continue
                objs.append((ch, True))
                try:
                    bgd = ch.getBackground()
                    if bgd is not None:
                        objs.append((bgd, True))
                except Exception:
                    pass
                try:
                    m = int(ch.getChildCount())
                    for k in range(m):
                        c2 = ch.getChildAt(k)
                        if c2 is None:
                            continue
                        objs.append((c2, True))
                        try:
                            b2 = c2.getBackground()
                            if b2 is not None:
                                objs.append((b2, True))
                        except Exception:
                            pass
                except Exception:
                    pass
        except Exception:
            pass
        return objs

    def _blocks_paint_recolor(self, pa, lv, col):
        from java import jint
        store = getattr(self, "_blocks_paints", None)
        if store is None:
            store = []
            self._blocks_paints = store
        live = []
        self._blocks_paints_live = live
        refs = set()
        ref_s = "?"
        try:
            t = find_class(THEME)
            r = int(pa.getThemedColor(t.key_windowBackgroundWhite))
            refs.add(r)
            ref_s = "#%08X" % (r & 0xFFFFFFFF)
        except Exception:
            pass
        diag = []
        hit = 0
        if not refs:
            return hit, diag, ref_s
        pnames = ("android.graphics.Paint", "android.text.TextPaint")
        seen = set()
        for obj, allow_int in self._blocks_field_objs(pa, lv):
            try:
                cls = obj.getClass()
            except Exception:
                continue
            dep = 0
            while cls is not None and dep < 5:
                dep += 1
                try:
                    cname = str(cls.getName())
                except Exception:
                    break
                if cname.startswith("android.") or cname.startswith("java."):
                    break
                short = cname.split(".")[-1]
                try:
                    flds = cls.getDeclaredFields()
                except Exception:
                    flds = []
                for fd in flds:
                    try:
                        fname = str(fd.getName())
                        low = fname.lower()
                        want = ("background" in low) or ("section" in low)
                        ftn = str(fd.getType().getName())
                        if ftn in pnames:
                            fd.setAccessible(True)
                            p = fd.get(obj)
                            if p is None:
                                continue
                            pc = int(p.getColor())
                            if pc in refs:
                                if not want:
                                    diag.append("%s.%s=skip" % (short, fname))
                                    continue
                                ph = int(p.hashCode())
                                if ph in seen:
                                    continue
                                seen.add(ph)
                                diag.append("%s.%s=P" % (short, fname))
                                store.append(("p", p, pc))
                                live.append(p)
                                p.setColor(jint(int(col)))
                                hit += 1
                        elif allow_int and want and ftn == "int":
                            fd.setAccessible(True)
                            v = int(fd.getInt(obj))
                            if v in refs:
                                diag.append("%s.%s=I" % (short, fname))
                                store.append(("i", (fd, obj), v))
                                fd.setInt(obj, jint(int(col)))
                                hit += 1
                    except Exception:
                        pass
                try:
                    cls = cls.getSuperclass()
                except Exception:
                    break
        return hit, diag, ref_s

    def _apply_block_colors(self, pa):
        try:
            en = bool(getattr(self, "_blocks_color_enabled", False))
            maxd = 2
            base = int(getattr(self, "_blocks_color", -16777216))
            al = max(0, min(100, int(getattr(self, "_blocks_alpha", 100))))
            bl = max(0, min(50, int(getattr(self, "_blocks_blur", 0))))
            try:
                if not self._is_edit_target(pa):
                    uid = self._viewed_uid(pa)
                    ent = self._remote.get(uid) if (uid and uid != 0 and hasattr(self, "_remote")) else None
                    if ent is not None and ent.get("state") == "ready" and bool(ent.get("blocks_enabled", False)) and ent.get("blocks_color", None) is not None:
                        en = True
                        base = int(ent.get("blocks_color"))
                        al = max(0, min(100, int(ent.get("blocks_alpha", 100))))
                        bl = max(0, min(50, int(ent.get("blocks_blur", 0))))
                    else:
                        en = False
            except Exception:
                pass
            a = (((base >> 24) & 0xFF) * al) // 100
            col = ((a & 0xFF) << 24) | (base & 0x00FFFFFF)
            if col >= 0x80000000:
                col -= 0x100000000
            self._blocks_blur_cur = bl
            sig = (en, maxd, col, bl)
            fr = int(getattr(self, "_blocks_frame", 0)) + 1
            self._blocks_frame = fr
            changed = sig != getattr(self, "_blocks_sig", None)
            from java import jint
            from android.graphics import PorterDuff, PorterDuffColorFilter
            if not changed and en:
                live = getattr(self, "_blocks_paints_live", None)
                if live:
                    drift = False
                    for p in live:
                        try:
                            if int(p.getColor()) != col:
                                p.setColor(jint(int(col)))
                                drift = True
                        except Exception:
                            pass
                    if drift:
                        dn = int(getattr(self, "_blocks_drift", 0)) + 1
                        self._blocks_drift = dn
                        if dn == 1:
                            try:
                                self.log("[cpb] paint drift detected: fork resets paint colors")
                            except Exception:
                                pass
                        if (dn % 30) == 1:
                            try:
                                lv0 = self._field(pa, "listView").get(pa)
                                if lv0 is not None:
                                    lv0.invalidate()
                            except Exception:
                                pass
                if False and (fr % 30) == 3:
                    try:
                        kw = self._blocks_theme_key()
                        if kw is not None:
                            t = find_class(THEME)
                            if int(t.getColor(int(kw))) != int(getattr(self, "_blocks_tset_eff", col)):
                                self._blocks_theme_set(col)
                                lv1 = self._field(pa, "listView").get(pa)
                                if lv1 is not None:
                                    lv1.invalidate()
                    except Exception:
                        pass
            if not changed:
                if not en:
                    return
                if (fr % 15) != 1:
                    return
            lv = self._field(pa, "listView").get(pa)
            if lv is None:
                return
            if changed:
                self._blocks_sig = sig
                self._blocks_cleanup(lv)
            if not en:
                return
            try:
                self._blocks_lv_hash = int(lv.hashCode())
            except Exception:
                self._blocks_lv_hash = 0
            self._blocks_lv_ref = lv
            self._blocks_col_cached = col
            self._blocks_theme_col = col
            try:
                self._blocks_theme_pa = int(pa.hashCode())
            except Exception:
                self._blocks_theme_pa = 0
            self._blocks_theme_on = True
            if changed:
                hit = 0
                pdiag = []
                ref_s = "?"
                try:
                    hit, pdiag, ref_s = self._blocks_paint_recolor(pa, lv, col)
                except Exception as e:
                    pdiag = ["scan err: %s" % e]
                try:
                    lv.invalidate()
                    n = int(lv.getChildCount())
                    for i in range(n):
                        ch = lv.getChildAt(i)
                        if ch is not None:
                            ch.invalidate()
                except Exception:
                    pass
                try:
                    self._blocks_tset_res = "off"
                    lv.invalidate()
                except Exception:
                    pass
            f = getattr(self, "_blocks_filter", None)
            if f is None or getattr(self, "_blocks_filter_col", None) != col:
                f = PorterDuffColorFilter(jint(col), PorterDuff.Mode.SRC_IN)
                self._blocks_filter = f
                self._blocks_filter_col = col
            for ch in self._blocks_collect(lv, 0, [], maxd):
                try:
                    bgd = ch.getBackground()
                    if bgd is None:
                        continue
                    cur = bgd.getColorFilter()
                    if cur is not None and cur == f:
                        continue
                    self._blocks_tint_drawable(bgd, f)
                    ch.invalidate()
                except Exception:
                    pass
            self._blocks_applied = True
        except Exception as e:
            if not getattr(self, "_blocks_err_once", False):
                self._blocks_err_once = True
                try:
                    self.log(f"[cpb] blocks recolor failed: {e}")
                except Exception:
                    pass

    def blocks_list_draw_before(self, param):
        if not getattr(self, "_blocks_color_enabled", False):
            return
        try:
            if int(param.thisObject.hashCode()) != int(getattr(self, "_blocks_lv_hash", 0)):
                return
        except Exception:
            return
        col = getattr(self, "_blocks_col_cached", None)
        live = getattr(self, "_blocks_paints_live", None)
        if col is None or not live:
            return
        try:
            from java import jint
            for p in live:
                try:
                    if int(p.getColor()) != col:
                        p.setColor(jint(int(col)))
                except Exception:
                    pass
        except Exception:
            pass

    def _blocks_blur_bmp_get(self, lv):
        try:
            bl = int(getattr(self, "_blocks_blur_cur", 0))
            if bl <= 0 or lv is None:
                return None
            d = lv.getBackground()
            if d is None:
                return None
            w = int(lv.getWidth())
            h = int(lv.getHeight())
            if w <= 0 or h <= 0:
                return None
            key = (int(d.hashCode()), bl, w, h)
            if getattr(self, "_bblur_key", None) == key:
                return getattr(self, "_bblur_bmp", None)
            Bitmap = find_class("android.graphics.Bitmap")
            Canvas = find_class("android.graphics.Canvas")
            cfg8 = find_class("android.graphics.Bitmap$Config").ARGB_8888
            f = 3 + int(bl)
            tw = w // f
            th = h // f
            if tw < 2:
                tw = 2
            if th < 2:
                th = 2
            hw = w // 2
            hh = h // 2
            if hw < tw:
                hw = tw
            if hh < th:
                hh = th
            small = Bitmap.createBitmap(int(hw), int(hh), cfg8)
            c = Canvas(small)
            c.scale(float(hw) / float(w), float(hh) / float(h))
            d.setBounds(0, 0, int(w), int(h))
            d.draw(c)
            cur = small
            cw0 = hw
            ch0 = hh
            while cw0 // 2 >= tw and ch0 // 2 >= th:
                cw0 = cw0 // 2
                ch0 = ch0 // 2
                cur = Bitmap.createScaledBitmap(cur, int(cw0), int(ch0), True)
            while cw0 * 2 <= hw and ch0 * 2 <= hh:
                cw0 = cw0 * 2
                ch0 = ch0 * 2
                cur = Bitmap.createScaledBitmap(cur, int(cw0), int(ch0), True)
            self._bblur_bmp = cur
            self._bblur_key = key
            return cur
        except Exception as e:
            if not getattr(self, "_blur_err", False):
                self._blur_err = True
                try:
                    self.log("[cpb] blur build error: %s" % e)
                except Exception:
                    pass
            return None

    def _blocks_draw_blur(self, canvas, lvv, rect, r1, r2, va, bl0):
        from java import jint, jfloat, jarray
        bmp = self._blocks_blur_bmp_get(lvv)
        if bmp is None:
            if not getattr(self, "_blur_warned", False):
                self._blur_warned = True
                try:
                    bgd = lvv.getBackground() if lvv is not None else None
                    self.log("[cpb] blur skip: lv=%s bg=%s blur=%d" % (lvv is not None, bgd is not None, bl0))
                except Exception:
                    pass
            return
        bw = int(lvv.getWidth())
        bh = int(lvv.getHeight())
        bp = getattr(self, "_blocks_blur_paint", None)
        if bp is None:
            bp = find_class("android.graphics.Paint")(3)
            self._blocks_blur_paint = bp
        bva = int(255 * va)
        if bva > 255:
            bva = 255
        if bva < 0:
            bva = 0
        bp.setAlpha(jint(bva))
        pth2 = getattr(self, "_blocks_blur_path", None)
        if pth2 is None:
            pth2 = find_class("android.graphics.Path")()
            self._blocks_blur_path = pth2
        pth2.rewind()
        radii2 = jarray(jfloat)([r1, r1, r1, r1, r2, r2, r2, r2])
        cw2 = find_class("android.graphics.Path$Direction").CW
        pth2.addRoundRect(rect, radii2, cw2)
        sc = canvas.save()
        try:
            canvas.clipPath(pth2)
            canvas.scale(float(bw) / float(bmp.getWidth()), float(bh) / float(bmp.getHeight()))
            canvas.drawBitmap(bmp, jfloat(0.0), jfloat(0.0), bp)
        finally:
            canvas.restoreToCount(sc)
        if not getattr(self, "_blur_logged", False):
            self._blur_logged = True
            self.log("[cpb] blur active: %dx%d blur=%d" % (int(bmp.getWidth()), int(bmp.getHeight()), bl0))

    def blocks_bg_rect_before(self, param):
        if not getattr(self, "_blocks_color_enabled", False):
            return
        if not getattr(self, "_blocks_in_lv", False):
            return
        col = getattr(self, "_blocks_col_cached", None)
        if col is None:
            return
        from java import jint, jfloat
        canvas = param.args[0]
        rect = param.args[1]
        if canvas is None or rect is None:
            return
        r1 = float(param.args[2])
        r2 = float(param.args[3])
        va = float(param.args[4])
        if va > 1.0:
            va = 1.0
        if va > 0.001:
            u = int(col) & 0xFFFFFFFF
            a = int(((u >> 24) & 0xFF) * va)
            if a > 255:
                a = 255
            nc = (a << 24) | (u & 0x00FFFFFF)
            if nc >= 0x80000000:
                nc -= 0x100000000
            p = getattr(self, "_blocks_bg_paint", None)
            if p is None:
                p = find_class("android.graphics.Paint")(1)
                self._blocks_bg_paint = p
            p.setColor(jint(int(nc)))
            try:
                self._blocks_last_r1 = float(r1)
                self._blocks_last_r2 = float(r2)
                bl0 = int(getattr(self, "_blocks_blur_cur", 0))
                lvv = None
                try:
                    lvv = param.thisObject
                except Exception:
                    lvv = None
                if lvv is None:
                    lvv = getattr(self, "_blocks_lv_ref", None)
                if bl0 > 0:
                    self._blocks_draw_blur(canvas, lvv, rect, r1, r2, va, bl0)
            except Exception:
                pass
            drawn = False
            if abs(r1 - r2) > 0.01:
                try:
                    from java import jarray
                    path = getattr(self, "_blocks_bg_path", None)
                    if path is None:
                        path = find_class("android.graphics.Path")()
                        self._blocks_bg_path = path
                    path.rewind()
                    radii = jarray(jfloat)([r1, r1, r1, r1, r2, r2, r2, r2])
                    cw = find_class("android.graphics.Path$Direction").CW
                    path.addRoundRect(rect, radii, cw)
                    canvas.drawPath(path, p)
                    drawn = True
                except Exception:
                    drawn = False
            if not drawn:
                canvas.drawRoundRect(rect, r1, r1, p)
            self._blocks_bgdraw = int(getattr(self, "_blocks_bgdraw", 0)) + 1
        try:
            param.args[4] = jfloat(0.0)
        except Exception:
            pass
        try:
            param.setResult(None)
        except Exception:
            pass

    def blocks_section_bg_before(self, param):
        if not getattr(self, "_blocks_color_enabled", False):
            return
        try:
            if int(param.thisObject.hashCode()) != int(getattr(self, "_blocks_lv_hash", 0)):
                return
        except Exception:
            return
        col = getattr(self, "_blocks_col_cached", None)
        if col is None:
            return
        try:
            bl0 = int(getattr(self, "_blocks_blur_cur", 0))
            if bl0 > 0:
                canvas0 = param.args[0]
                lvv = param.thisObject
                ints = []
                for k in range(1, len(param.args)):
                    try:
                        v = param.args[k]
                    except Exception:
                        continue
                    if isinstance(v, int) and not isinstance(v, bool) and 0 <= v < 100000:
                        ints.append(int(v))
                if not getattr(self, "_secblur_logged", False):
                    self._secblur_logged = True
                    try:
                        self.log("[cpb] secblur fired n=%d ints=%s" % (len(param.args), ints))
                    except Exception:
                        pass
                if canvas0 is not None and len(ints) >= 2:
                    p0 = min(ints[0], ints[1])
                    p1 = max(ints[0], ints[1])
                    top = None
                    bot = None
                    left = None
                    right = None
                    for ap in range(p0, min(p1, p0 + 30) + 1):
                        try:
                            vh = lvv.findViewHolderForAdapterPosition(int(ap))
                        except Exception:
                            vh = None
                        if vh is None:
                            continue
                        it = vh.itemView
                        t = float(it.getY())
                        b = t + float(it.getHeight())
                        l = float(it.getX())
                        r = l + float(it.getWidth())
                        top = t if (top is None or t < top) else top
                        bot = b if (bot is None or b > bot) else bot
                        left = l if (left is None or l < left) else left
                        right = r if (right is None or r > right) else right
                    if not getattr(self, "_secblur_rect_logged", False):
                        self._secblur_rect_logged = True
                        try:
                            self.log("[cpb] secblur rect: t=%s b=%s l=%s r=%s p=(%d..%d)" % (top, bot, left, right, p0, p1))
                        except Exception:
                            pass
                    if top is not None and bot is not None and bot > top and right is not None and right > left:
                        RectF = find_class("android.graphics.RectF")
                        rf = getattr(self, "_blocks_sec_rectf", None)
                        if rf is None:
                            rf = RectF()
                            self._blocks_sec_rectf = rf
                        rf.set(float(left), float(top), float(right), float(bot))
                        rr1 = float(getattr(self, "_blocks_last_r1", 0.0))
                        rr2 = float(getattr(self, "_blocks_last_r2", rr1))
                        self._blocks_draw_blur(canvas0, lvv, rf, rr1, rr2, 1.0, bl0)
        except Exception as e:
            if not getattr(self, "_secblur_err", False):
                self._secblur_err = True
                try:
                    self.log("[cpb] secblur error: %s" % e)
                except Exception:
                    pass
        try:
            from java import jint
            args = param.args
            n = len(args)
            idx = -1
            for k in range(n - 1, -1, -1):
                try:
                    v = args[k]
                except Exception:
                    continue
                if isinstance(v, int) and not isinstance(v, bool):
                    if v < 0:
                        idx = k
                        break
                    if idx == -1:
                        idx = k
            if idx >= 0:
                param.args[idx] = jint(int(col))
                if not getattr(self, "_blocks_secbg_logged", False):
                    self._blocks_secbg_logged = True
                    try:
                        self.log(f"[cpb] section bg recolored (arg {idx} of {n})")
                    except Exception:
                        pass
        except Exception as e:
            if not getattr(self, "_blocks_secbg_err", False):
                self._blocks_secbg_err = True
                try:
                    self.log(f"[cpb] section bg recolor failed: {e}")
                except Exception:
                    pass

    def blocks_theme_color_after(self, param):
        if not getattr(self, "_blocks_theme_on", False):
            return
        try:
            if int(param.thisObject.hashCode()) != int(getattr(self, "_blocks_theme_pa", 0)):
                return
        except Exception:
            return
        kw = getattr(self, "_blocks_key_wbw", None)
        if kw is None:
            try:
                kw = find_class(THEME).key_windowBackgroundWhite
            except Exception:
                kw = None
            self._blocks_key_wbw = kw
        if kw is None:
            return
        try:
            same = int(param.args[0]) == int(kw)
        except Exception:
            try:
                same = str(param.args[0]) == str(kw)
            except Exception:
                same = False
        if not same:
            return
        try:
            from java import jint
            param.setResult(jint(int(getattr(self, "_blocks_theme_col", -16777216))))
        except Exception as e:
            if not getattr(self, "_blocks_setres_err", False):
                self._blocks_setres_err = True
                try:
                    self.log(f"[cpb] theme setResult failed: {e}")
                except Exception:
                    pass

    def _apply_profile_background(self, pa):
        list_view = self._field(pa, "listView").get(pa)
        if list_view is None:
            return
        if not self._bg_enabled:
            if self._bg_applied:
                try:
                    theme = find_class(THEME)
                    col = pa.getThemedColor(theme.key_windowBackgroundGray)
                    list_view.setBackgroundColor(col)
                except Exception:
                    pass
                self._bg_applied = False
                self._bg_drawable = None
                self._bg_dirty = True
            return
        if self._bg_mode == 1:
            try:
                cwh = (int(list_view.getWidth()), int(list_view.getHeight()))
                if cwh[0] > 0 and cwh[1] > 0 and cwh != getattr(self, "_bg_crop_wh", None):
                    self._bg_dirty = True
            except Exception:
                pass
        if self._bg_dirty or self._bg_drawable is None:
            d = self._build_bg_drawable(list_view)
            if d is None:
                return
            self._bg_drawable = d
            self._bg_dirty = False
            list_view.setBackground(d)
            self._bg_applied = True
            return
        cur = list_view.getBackground()
        if cur is None or not cur.equals(self._bg_drawable):
            list_view.setBackground(self._bg_drawable)
            self._bg_applied = True

    def _dim_color(self, col, dv):
        try:
            c = int(col) & 0xFFFFFFFF
            f = (100 - max(0, min(100, int(dv)))) / 100.0
            a = (c >> 24) & 0xFF
            r = int(((c >> 16) & 0xFF) * f)
            g = int(((c >> 8) & 0xFF) * f)
            b = int((c & 0xFF) * f)
            out = (a << 24) | (r << 16) | (g << 8) | b
            if out >= 0x80000000:
                out -= 0x100000000
            return int(out)
        except Exception:
            return int(col)

    def _build_bg_drawable(self, context_view):
        from java import jint
        from android.graphics.drawable import ColorDrawable, BitmapDrawable
        if self._bg_mode == 1:
            if self._bg_bmp is None:
                return None
            bmp = self._bg_bmp
            try:
                tw = int(context_view.getWidth())
                th = int(context_view.getHeight())
            except Exception:
                tw = th = 0
            if tw <= 0 or th <= 0:
                return None
            try:
                cropped = self._center_crop_bitmap(self._bg_bmp, tw, th)
                if cropped is not None:
                    bmp = cropped
            except Exception as e:
                self.log(f"[cpb] bg crop failed: {e}")
            self._bg_crop_wh = (tw, th)
            try:
                bmp = self._process_bitmap(
                    bmp,
                    int(getattr(self, "_bg_alpha", 100)),
                    int(getattr(self, "_bg_fade", 0)),
                    int(getattr(self, "_bg_fade_angle", 0)),
                    int(getattr(self, "_bg_fade_radius", 100)),
                    float(getattr(self, "_bg_fade_cx", 0.5)),
                    float(getattr(self, "_bg_fade_cy", 0.5)),
                    int(getattr(self, "_bg_dim", 0)),
                )
            except Exception as e:
                self.log(f"[cpb] bg process failed: {e}")
            return BitmapDrawable(context_view.getResources(), bmp)
        _bcol = int(self._bg_color)
        _bdv = int(getattr(self, "_bg_dim", 0) or 0)
        if _bdv > 0:
            _bcol = self._dim_color(_bcol, _bdv)
        return ColorDrawable(jint(_bcol))

    def _center_crop_bitmap(self, bmp, tw, th):
        from android.graphics import Bitmap, Canvas, Matrix, Paint
        bw = float(bmp.getWidth())
        bh = float(bmp.getHeight())
        if bw <= 0 or bh <= 0:
            return None
        sx = float(tw) / bw
        sy = float(th) / bh
        s = sx if sx > sy else sy
        out = Bitmap.createBitmap(int(tw), int(th), Bitmap.Config.ARGB_8888)
        c = Canvas(out)
        m = Matrix()
        m.setScale(s, s)
        m.postTranslate((float(tw) - bw * s) / 2.0, (float(th) - bh * s) / 2.0)
        p = Paint()
        try:
            p.setFilterBitmap(True)
        except Exception:
            pass
        c.drawBitmap(bmp, m, p)
        return out

    def _decode_downsampled(self, path):
        from android.graphics import BitmapFactory
        bounds = BitmapFactory.Options()
        bounds.inJustDecodeBounds = True
        BitmapFactory.decodeFile(path, bounds)
        w = bounds.outWidth
        h = bounds.outHeight
        if w <= 0 or h <= 0:
            raise ValueError("could not decode image bounds")
        sample = 1
        while (w // sample) > MAX_DIM or (h // sample) > MAX_DIM:
            sample *= 2
        opts = BitmapFactory.Options()
        opts.inSampleSize = sample
        bmp = BitmapFactory.decodeFile(path, opts)
        if bmp is None:
            raise ValueError("decodeFile returned None")
        return bmp

    def _load_banner_bitmap(self, path):
        bmp = self._decode_downsampled(path)
        self._bmp_src = bmp
        self._banner_img_dirty = True
        self._rebuild_banner_bitmap()

    def _rebuild_banner_bitmap(self):
        from android.graphics import BitmapShader, Shader
        srcbmp = getattr(self, "_bmp_src", None)
        if srcbmp is None:
            self._bmp = None
            self._shader = None
            self._banner_img_dirty = False
            return
        try:
            proc = self._process_bitmap(
                srcbmp,
                int(getattr(self, "_banner_alpha", 100)),
                int(getattr(self, "_banner_fade", 0)),
                int(getattr(self, "_banner_fade_angle", 0)),
                int(getattr(self, "_banner_fade_radius", 100)),
                float(getattr(self, "_banner_fade_cx", 0.5)),
                float(getattr(self, "_banner_fade_cy", 0.5)),
                int(getattr(self, "_banner_dim", 0)),
            )
        except Exception as e:
            self.log(f"[cpb] banner process failed: {e}")
            proc = srcbmp
        self._bmp = proc
        self._shader = BitmapShader(proc, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
        self._banner_img_dirty = False

    def _process_bitmap(self, srcbmp, alpha, fade, angle, radius, cx=0.5, cy=0.5, dim=0):
        from java import jint, jfloat, jarray
        from android.graphics import (Bitmap, Canvas, Paint, LinearGradient,
                                       RadialGradient, Shader, PorterDuff,
                                       PorterDuffXfermode)
        import math
        try:
            dim = int(dim)
        except Exception:
            dim = 0
        if alpha >= 100 and fade == 0 and dim <= 0:
            return srcbmp
        w = int(srcbmp.getWidth())
        h = int(srcbmp.getHeight())
        if w <= 0 or h <= 0:
            return srcbmp
        out = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        c = Canvas(out)
        p = Paint()
        try:
            p.setFilterBitmap(True)
        except Exception:
            pass
        av = int(max(0, min(100, alpha)) * 255 / 100)
        p.setAlpha(av)
        c.drawBitmap(srcbmp, 0.0, 0.0, p)
        if dim > 0:
            _dv = max(0, min(100, dim))
            _dcol = (int(_dv * 255 / 100) & 0xFF) << 24
            if _dcol >= 0x80000000:
                _dcol -= 0x100000000
            _dp = Paint()
            _dp.setColor(jint(int(_dcol)))
            c.drawRect(0.0, 0.0, float(w), float(h), _dp)
        if fade != 0:
            rr = max(20, min(200, radius)) / 100.0
            cols = jarray(jint)([-1, 0x00FFFFFF])
            pos = jarray(jfloat)([0.0, 1.0])
            tile = Shader.TileMode.CLAMP
            if fade == 2:
                big = w if w > h else h
                r = 0.5 * rr * big
                if r <= 0.0:
                    r = float(big)
                sh = RadialGradient(w * cx, h * cy, r, cols, pos, tile)
            else:
                ang = float(int(angle) % 360)
                rad = ang * math.pi / 180.0
                dx = math.sin(rad)
                dy = -math.cos(rad)
                hl = 0.5 * rr
                x0 = (cx - dx * hl) * w
                y0 = (cy - dy * hl) * h
                x1 = (cx + dx * hl) * w
                y1 = (cy + dy * hl) * h
                sh = LinearGradient(x0, y0, x1, y1, cols, pos, tile)
            mp = Paint()
            mp.setShader(sh)
            mp.setXfermode(PorterDuffXfermode(PorterDuff.Mode.DST_IN))
            c.drawRect(0.0, 0.0, float(w), float(h), mp)
        return out

    def _get_activity(self):
        frag = get_last_fragment()
        if frag is None:
            return None
        return frag.getParentActivity()

    def _start_pick(self, request_code, title, mime="image/*"):
        title = cpb_tr(title)
        from android.content import Intent
        activity = self._get_activity()
        if activity is None:
            return
        intent = Intent(Intent.ACTION_GET_CONTENT)
        intent.setType(mime)
        intent.addCategory(Intent.CATEGORY_OPENABLE)
        activity.startActivityForResult(Intent.createChooser(intent, title), request_code)

    def on_activity_result(self, param):
        code = int(param.args[0])
        result = int(param.args[1])
        data = param.args[2]
        if code not in (PICK_BANNER_CODE, PICK_BG_CODE, PICK_FONT_CODE, PICK_TFONT_CODE):
            return
        if result != -1 or data is None:
            return
        uri = data.getData()
        if uri is None:
            return
        activity = param.thisObject
        if code == PICK_BANNER_CODE:
            dest = self._copy_uri_to_file(activity, uri, "custom_profile_banner_%s.img" % self._key_tag())
            if not dest:
                return
            try:
                self._load_banner_bitmap(dest)
                self._ss(KEY_BANNER_PATH, dest)
                self._push_image("banner")
            except Exception as e:
                self.log(f"[cpb] banner decode failed: {e}")
        elif code == PICK_FONT_CODE:
            dest = self._copy_uri_to_file(activity, uri, "custom_profile_font_%s.bin" % self._key_tag())
            if not dest:
                return
            _fok = False
            try:
                from android.graphics import Typeface
                _ftf = Typeface.createFromFile(dest)
                _fok = _ftf is not None
            except Exception as _fe:
                self.log(f"[cpb] font load failed: {_fe}")
                _fok = False
            if _fok:
                self._name_font_path = dest
                self._ss(KEY_NAME_FONT_PATH, dest)
                try:
                    _c = getattr(self, "_name_tf_cache", None)
                    if _c is not None:
                        _c.clear()
                except Exception:
                    pass
                self._toast("Шрифт загружен")
            else:
                self._toast("Не удалось загрузить шрифт")
        elif code == PICK_TFONT_CODE:
            dest = self._copy_uri_to_file(activity, uri, "custom_profile_tfont_%s.bin" % self._key_tag())
            if not dest:
                return
            _tok = False
            try:
                from android.graphics import Typeface
                _ttf = Typeface.createFromFile(dest)
                _tok = _ttf is not None
            except Exception as _te:
                self.log(f"[cpb] tfont load failed: {_te}")
                _tok = False
            if _tok:
                self._thought_font_path = dest
                self._ss(KEY_THOUGHT_FONT_PATH, dest)
                self._thought_pc = None
                try:
                    _c2 = getattr(self, "_name_tf_cache", None)
                    if _c2 is not None:
                        _c2.clear()
                except Exception:
                    pass
                self._toast("Шрифт мыслей загружен")
            else:
                self._toast("Не удалось загрузить шрифт")
        else:
            dest = self._copy_uri_to_file(activity, uri, "custom_profile_bg_%s.img" % self._key_tag())
            if not dest:
                return
            try:
                self._bg_bmp = self._decode_downsampled(dest)
                self._ss(KEY_BG_PATH, dest)
                self._bg_dirty = True
                self._push_image("bg")
            except Exception as e:
                self.log(f"[cpb] bg decode failed: {e}")

    def _copy_uri_to_file(self, context, uri, name):
        from java import jbyte, jarray
        from java.io import FileOutputStream
        try:
            resolver = context.getContentResolver()
            istream = resolver.openInputStream(uri)
            if istream is None:
                return None
            dest = context.getFilesDir().getAbsolutePath() + "/" + name
            fos = FileOutputStream(dest)
            buf = jarray(jbyte)(8192)
            while True:
                n = istream.read(buf)
                if n is None or n <= 0:
                    break
                fos.write(buf, 0, n)
            fos.flush()
            fos.close()
            istream.close()
            return dest
        except Exception as e:
            self.log(f"[cpb] copy uri failed: {e}")
            return None

    def _toast(self, text):
        text = cpb_tr(text)
        def _show():
            try:
                if BulletinHelper is not None:
                    BulletinHelper.show_info(text)
            except Exception:
                pass
        run_on_ui_thread(_show)

    def _parse_color(self, s):
        if s is None:
            return None
        from android.graphics import Color
        try:
            s = str(s).strip()
            if not s.startswith("#"):
                s = "#" + s
            return Color.parseColor(s)
        except Exception:
            return None

    def _color_setting(self, key, default_hex):
        c = self._parse_color(self._gs(key, default_hex))
        if c is None:
            c = self._parse_color(default_hex)
        return c if c is not None else -16777216

    def _hex(self, color):
        return "#%08X" % (int(color) & 0xFFFFFFFF)

    def _css_rgba(self, c, fallback):
        if c is None:
            return fallback
        c = int(c)
        a = (c >> 24) & 0xFF
        r = (c >> 16) & 0xFF
        g = (c >> 8) & 0xFF
        b = c & 0xFF
        return "rgba(%d,%d,%d,%.3f)" % (r, g, b, a / 255.0)

    def _theme_color(self, key, default):
        try:
            t = find_class(THEME)
            return int(t.getColor(getattr(t, key)))
        except Exception:
            return default

    def _bitmap_to_data_uri(self, bmp, max_px=PREVIEW_DIM):
        from java.io import ByteArrayOutputStream
        from android.graphics import Bitmap
        from android.util import Base64
        w = bmp.getWidth()
        h = bmp.getHeight()
        big = w if w > h else h
        if big > max_px and big > 0:
            scale = float(max_px) / float(big)
            nw = max(1, int(w * scale))
            nh = max(1, int(h * scale))
            small = Bitmap.createScaledBitmap(bmp, nw, nh, True)
        else:
            small = bmp
        stream = ByteArrayOutputStream()
        small.compress(Bitmap.CompressFormat.JPEG, 82, stream)
        data = Base64.encodeToString(stream.toByteArray(), Base64.NO_WRAP)
        return "data:image/jpeg;base64," + str(data)

    def _image_data_uri(self, which):
        bmp = self._bmp_src if which == "banner" else self._bg_bmp
        if bmp is None:
            return ""
        try:
            return self._bitmap_to_data_uri(bmp)
        except Exception as e:
            self.log(f"[cpb] preview encode failed: {e}")
            return ""

    def _file_to_data_uri(self, path):
        try:
            from android.util import Base64
            from java.io import FileInputStream, ByteArrayOutputStream
            from java import jbyte, jarray
            fis = FileInputStream(path)
            bos = ByteArrayOutputStream()
            buf = jarray(jbyte)(8192)
            while True:
                n = fis.read(buf)
                if n is None or n <= 0:
                    break
                bos.write(buf, 0, n)
            fis.close()
            data = Base64.encodeToString(bos.toByteArray(), Base64.NO_WRAP)
            return "data:image/jpeg;base64," + str(data)
        except Exception:
            return ""

    def _encode_and_save(self, bmp, path, max_px):
        from java.io import ByteArrayOutputStream, FileOutputStream
        from android.graphics import Bitmap
        from android.util import Base64
        w = bmp.getWidth()
        h = bmp.getHeight()
        big = w if w > h else h
        if big > max_px and big > 0:
            scale = float(max_px) / float(big)
            small = Bitmap.createScaledBitmap(bmp, max(1, int(w * scale)), max(1, int(h * scale)), True)
        else:
            small = bmp
        stream = ByteArrayOutputStream()
        small.compress(Bitmap.CompressFormat.JPEG, 84, stream)
        arr = stream.toByteArray()
        try:
            if path:
                fos = FileOutputStream(path)
                fos.write(arr)
                fos.flush()
                fos.close()
        except Exception:
            pass
        data = Base64.encodeToString(arr, Base64.NO_WRAP)
        return "data:image/jpeg;base64," + str(data)

    def _maybe_capture(self, pa):
        import time
        if getattr(self, "_snap_busy", False):
            return
        if (time.time() - getattr(self, "_snap_ts", 0.0)) < 2.0:
            return
        self._snap_busy = True
        self._snap_ts = time.time()
        self._capture_profile(pa)

    def _capture_profile(self, pa):
        def _run():
            try:
                from android.graphics import Bitmap, Canvas
                from java import jint
                view = None
                try:
                    view = pa.getFragmentView()
                except Exception:
                    view = None
                if view is None:
                    try:
                        view = self._field(pa, "fragmentView").get(pa)
                    except Exception:
                        view = None
                if view is None:
                    return
                w = int(view.getWidth())
                h = int(view.getHeight())
                if w <= 0 or h <= 0:
                    return
                bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
                canvas = Canvas(bmp)
                try:
                    bgc = pa.getThemedColor(find_class(THEME).key_windowBackgroundGray)
                    canvas.drawColor(jint(bgc))
                except Exception:
                    pass
                view.draw(canvas)
                uri = self._encode_and_save(bmp, getattr(self, "_snap_path", ""), 900)
                try:
                    bmp.recycle()
                except Exception:
                    pass
                if uri:
                    self._snapshot = uri
                    self._push_snapshot()
            except Exception as e:
                self.log(f"[cpb] snapshot failed: {e}")
            finally:
                self._snap_busy = False
        run_on_ui_thread(_run)

    def _push_snapshot(self):
        wv = self._webview
        if wv is None:
            return
        uri = getattr(self, "_snapshot", "") or ""
        if not uri:
            return
        js = "window.cpbSetSnapshot && cpbSetSnapshot(%s);" % json.dumps(uri)
        def _run():
            try:
                wv.evaluateJavascript(js, None)
            except Exception:
                pass
        run_on_ui_thread(_run)

    def _profile_info(self):
        info = {"name": "", "initials": "", "avatar": ""}
        try:
            uc = find_class("org.telegram.messenger.UserConfig")
            acc = uc.selectedAccount
            user = uc.getInstance(acc).getCurrentUser()
            if user is None:
                return info
            fn = user.first_name or ""
            ln = user.last_name or ""
            name = (str(fn) + " " + str(ln)).strip()
            info["name"] = name or cpb_tr("Профиль")
            ini = ""
            if fn:
                ini += str(fn)[0]
            if ln:
                ini += str(ln)[0]
            if not ini and name:
                ini = name[0]
            info["initials"] = ini.upper()
            try:
                un = getattr(user, "username", None)
                info["username"] = str(un) if un else ""
            except Exception:
                info["username"] = ""
            try:
                ph = getattr(user, "phone", None)
                info["phone"] = ("+" + str(ph)) if ph else ""
            except Exception:
                info["phone"] = ""
            try:
                photo = user.photo
                if photo is not None and photo.photo_small is not None:
                    fl = find_class("org.telegram.messenger.FileLoader").getInstance(acc)
                    f = fl.getPathToAttach(photo.photo_small, True)
                    if f is not None and f.exists():
                        bmp = self._decode_downsampled(f.getAbsolutePath())
                        info["avatar"] = self._bitmap_to_data_uri(bmp, 220)
            except Exception as e:
                self.log(f"[cpb] avatar load failed: {e}")
        except Exception as e:
            self.log(f"[cpb] profile info failed: {e}")
        return info

    def _push_image(self, which):
        wv = self._webview
        if wv is None:
            return
        uri = self._image_data_uri(which)
        js = "window.cpbSetImage && cpbSetImage(%s,%s);" % (json.dumps(which), json.dumps(uri))

        def _run():
            try:
                wv.evaluateJavascript(js, None)
            except Exception:
                try:
                    wv.loadUrl("javascript:" + js)
                except Exception:
                    pass
        run_on_ui_thread(_run)

    def _install_html_file(self):
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        base = ctx.getFilesDir().getAbsolutePath()
        d = os.path.join(base, "cpb_ui")
        try:
            os.makedirs(d, exist_ok=True)
        except Exception:
            pass
        path = os.path.join(d, "index.html")
        html = cpb_tr(self._build_html())
        with open(path, "w", encoding="utf-8") as w:
            w.write(html)
        self._html_path = path
        return path

    def _start_title_poll(self):
        import threading
        self._poll_gen = getattr(self, "_poll_gen", 0) + 1
        gen = self._poll_gen
        self._poll_active = True
        self._last_seq = 0
        def _loop():
            import time
            while getattr(self, "_poll_active", False) and getattr(self, "_poll_gen", 0) == gen:
                try:
                    run_on_ui_thread(self._poll_once)
                except Exception:
                    pass
                time.sleep(0.12)
        threading.Thread(target=_loop, daemon=True).start()

    def _poll_once(self):
        wv = self._webview
        if wv is None:
            return
        try:
            att = bool(wv.isAttachedToWindow())
        except Exception:
            att = True
        if att:
            self._was_attached = True
        elif getattr(self, "_was_attached", False):
            self._poll_active = False
            self._webview = None
            self._inline_container = None
            self._destroy_preview()
            return
        try:
            t = wv.getTitle()
        except Exception:
            return
        if not t:
            return
        t = str(t)
        if not t.startswith("CPBMSG:"):
            return
        try:
            rest = t[len("CPBMSG:"):]
            seq_str, cmd = rest.split(":", 1)
            seq = int(seq_str)
        except Exception:
            return
        if seq <= getattr(self, "_last_seq", 0):
            return
        self._last_seq = seq
        try:
            self._on_bridge_url(cmd)
        except Exception as e:
            self.log(f"[cpb] bridge err: {e}")

    def _my_user_id(self):
        try:
            uc = find_class("org.telegram.messenger.UserConfig")
            acc = int(uc.selectedAccount)
            return int(uc.getInstance(acc).getClientUserId())
        except Exception as e:
            self.log(f"[cpb] my uid failed: {e}")
            return 0

    def _acct_tag(self):
        try:
            uc = find_class("org.telegram.messenger.UserConfig")
            acc = int(uc.selectedAccount)
            uid = int(uc.getInstance(acc).getClientUserId())
            return str(uid) if uid > 0 else ("slot%d" % acc)
        except Exception:
            return "0"

    def _key_tag(self):
        t = self._acct_tag()
        try:
            _ec = int(getattr(self, "_edit_chat", 0) or 0)
        except Exception:
            _ec = 0
        return (t + "_c%d" % _ec) if _ec else t

    def _gs(self, key, default=None):
        try:
            return self.get_setting(self._key_tag() + "_" + key, default)
        except Exception:
            return default

    def _ss(self, key, value):
        try:
            return self.set_setting(self._key_tag() + "_" + key, value)
        except Exception:
            return None

    def _migrate_account(self):
        try:
            tag = self._acct_tag()
            mk = tag + "__cpb_migrated"
            if self.get_setting(mk, False):
                return
            _MISSING = object()
            for key in _CPB_ALL_KEYS:
                try:
                    g = self.get_setting(key, _MISSING)
                    if g is not _MISSING and g is not None:
                        self.set_setting(tag + "_" + key, g)
                except Exception:
                    pass
            self.set_setting(mk, True)
        except Exception as e:
            try:
                self.log(f"[cpb] migrate failed: {e}")
            except Exception:
                pass

    def _reload_state(self):
        self._enabled = bool(self._gs(KEY_ENABLED, True))
        self._share_enabled = bool(self._gs(KEY_SHARE_ENABLED, False))
        self._pub_consent = bool(self._gs(KEY_PUB_CONSENT, False))
        self._remote_enabled = bool(self._gs(KEY_REMOTE_ENABLED, False))
        self._remote_prompted = bool(self._gs(KEY_REMOTE_PROMPTED, False))
        self._show_emoji = bool(self._gs(KEY_EMOJI, True))
        self._name_color_enabled = bool(self._gs(KEY_NAME_COLOR_ENABLED, False))
        self._name_color = self._color_setting(KEY_NAME_COLOR, DEF_NAME_COLOR)
        self._name_glow_enabled = bool(self._gs(KEY_NAME_GLOW_ENABLED, False))
        self._name_glow_color = self._color_setting(KEY_NAME_GLOW_COLOR, DEF_NAME_GLOW_COLOR)
        self._name_glow_radius = int(self._gs(KEY_NAME_GLOW_RADIUS, 12))
        self._name_glow_strength = int(self._gs(KEY_NAME_GLOW_STRENGTH, 100))
        self._name_fx = int(self._gs(KEY_NAME_FX, 0))
        if self._name_fx < 0 or self._name_fx > 7:
            self._name_fx = 0
        self._name_fx_speed = int(self._gs(KEY_NAME_FX_SPEED, 100))
        self._name_grad_angle = int(self._gs(KEY_NAME_GRAD_ANGLE, 0))
        self._name_size = int(self._gs(KEY_NAME_SIZE, 100))
        self._name_font = int(self._gs(KEY_NAME_FONT, 0))
        self._name_font_path = self._gs(KEY_NAME_FONT_PATH, "") or ""
        self._name_grad_c1 = self._color_setting(KEY_NAME_GRAD_C1, DEF_NAME_GRAD_C1)
        self._name_grad_c2 = self._color_setting(KEY_NAME_GRAD_C2, DEF_NAME_GRAD_C2)
        self._avatar_shape = int(self._gs(KEY_AVATAR_SHAPE, 0))
        self._avatar_radius = int(self._gs(KEY_AVATAR_RADIUS, 18))
        self._avatar_round = int(self._gs(KEY_AVATAR_ROUND, 0))
        self._avatar_alpha = int(self._gs(KEY_AVATAR_ALPHA, 100))
        self._avatar_dim = int(self._gs(KEY_AVATAR_DIM, 0))
        self._thought_text = str(self._gs(KEY_THOUGHT_TEXT, "") or "")
        _thc = self._parse_color(str(self._gs(KEY_THOUGHT_TEXT_COLOR, "") or ""))
        self._thought_text_color = -1 if _thc is None else int(_thc)
        _thb = self._parse_color(str(self._gs(KEY_THOUGHT_BG_COLOR, "") or ""))
        self._thought_bg_color = -871557603 if _thb is None else int(_thb)
        self._thought_font = int(self._gs(KEY_THOUGHT_FONT, 0))
        self._thought_font_copy = bool(self._gs(KEY_THOUGHT_FONT_COPY, True))
        self._thought_font_path = self._gs(KEY_THOUGHT_FONT_PATH, "") or ""
        self._avatar_fade = int(self._gs(KEY_AVATAR_FADE, 0))
        self._avatar_fade_radius = int(self._gs(KEY_AVATAR_FADE_RADIUS, 50))
        self._avatar_custom = self._gs(KEY_AVATAR_CUSTOM, "") or ""
        self._avatar_custom_pts = self._parse_custom_pts(self._avatar_custom)
        self._av_last_r = None
        self._banner_mode = int(self._gs(KEY_BANNER_MODE, 0))
        self._banner_color = self._color_setting(KEY_BANNER_COLOR, DEF_BANNER_COLOR)
        self._grad_type = int(self._gs(KEY_GRAD_TYPE, 0))
        self._grad_dir = int(self._gs(KEY_GRAD_DIR, 0))
        self._grad_angle = int(self._gs(KEY_GRAD_ANGLE, 0))
        self._grad_c1 = self._color_setting(KEY_GRAD_C1, DEF_GRAD_C1)
        self._grad_c2 = self._color_setting(KEY_GRAD_C2, DEF_GRAD_C2)
        self._grad_c3 = self._color_setting(KEY_GRAD_C3, DEF_GRAD_C3)
        self._grad_use3 = bool(self._gs(KEY_GRAD_USE3, False))
        self._grad_radius = int(self._gs(KEY_GRAD_RADIUS, 100))
        self._grad_count = int(self._gs(KEY_GRAD_COUNT, 3 if self._grad_use3 else 2))
        self._banner_alpha = int(self._gs(KEY_BANNER_ALPHA, 100))
        self._banner_dim = int(self._gs(KEY_BANNER_DIM, 0))
        self._banner_fade = int(self._gs(KEY_BANNER_FADE, 0))
        self._banner_fade_angle = int(self._gs(KEY_BANNER_FADE_ANGLE, 0))
        self._banner_fade_radius = int(self._gs(KEY_BANNER_FADE_RADIUS, 100))
        self._bg_alpha = int(self._gs(KEY_BG_ALPHA, 100))
        self._bg_dim = int(self._gs(KEY_BG_DIM, 0))
        self._bg_fade = int(self._gs(KEY_BG_FADE, 0))
        self._bg_fade_angle = int(self._gs(KEY_BG_FADE_ANGLE, 0))
        self._bg_fade_radius = int(self._gs(KEY_BG_FADE_RADIUS, 100))
        self._grad_cx = float(self._gs(KEY_GRAD_CX, 0.5))
        self._grad_cy = float(self._gs(KEY_GRAD_CY, 0.5))
        self._banner_fade_cx = float(self._gs(KEY_BANNER_FADE_CX, 0.5))
        self._banner_fade_cy = float(self._gs(KEY_BANNER_FADE_CY, 0.5))
        self._bg_fade_cx = float(self._gs(KEY_BG_FADE_CX, 0.5))
        self._bg_fade_cy = float(self._gs(KEY_BG_FADE_CY, 0.5))
        self._bg_enabled = bool(self._gs(KEY_BG_ENABLED, False))
        self._bg_mode = int(self._gs(KEY_BG_MODE, 0))
        self._bg_color = self._color_setting(KEY_BG_COLOR, DEF_BG_COLOR)
        self._blocks_color_enabled = bool(self._gs(KEY_BLOCKS_ENABLED, False))
        self._blocks_color = self._color_setting(KEY_BLOCKS_COLOR, DEF_BLOCKS_COLOR)
        self._blocks_alpha = int(self._gs(KEY_BLOCKS_ALPHA, 100))
        self._blocks_blur = int(self._gs(KEY_BLOCKS_BLUR, 0))
        self._blocks_depth = int(self._gs(KEY_BLOCKS_DEPTH, 4))
        self._bmp = None
        self._bmp_src = None
        self._shader = None
        self._grad_shader = None
        self._grad_sig = None
        self._active_shader = None
        self._bg_bmp = None
        self._bg_drawable = None
        self._banner_img_dirty = True
        self._bg_dirty = True
        self._bg_applied = False
        try:
            bp = self._gs(KEY_BANNER_PATH, "")
            if bp:
                self._load_banner_bitmap(bp)
        except Exception as e:
            self.log(f"[cpb] reload banner failed: {e}")
        try:
            gp = self._gs(KEY_BG_PATH, "")
            if gp:
                self._bg_bmp = self._decode_downsampled(gp)
        except Exception as e:
            self.log(f"[cpb] reload bg failed: {e}")

    def _collect_config(self):
        return {
            "v": 1,
            "banner_enabled": bool(self._enabled),
            "show_emoji": bool(self._show_emoji),
            "banner_mode": int(self._banner_mode),
            "banner_color": self._hex(self._banner_color),
            "name_color_enabled": bool(getattr(self, "_name_color_enabled", False)),
            "name_color": self._hex(getattr(self, "_name_color", -1)),
            "name_glow_enabled": bool(getattr(self, "_name_glow_enabled", False)),
            "name_glow_color": self._hex(getattr(self, "_name_glow_color", -1)),
            "name_glow_radius": int(getattr(self, "_name_glow_radius", 12)),
            "name_glow_strength": int(getattr(self, "_name_glow_strength", 100)),
            "name_fx": int(getattr(self, "_name_fx", 0)),
            "name_fx_speed": int(getattr(self, "_name_fx_speed", 100)),
            "name_grad_c1": self._hex(getattr(self, "_name_grad_c1", -1)),
            "name_grad_c2": self._hex(getattr(self, "_name_grad_c2", -1)),
            "name_grad_angle": int(getattr(self, "_name_grad_angle", 0)),
            "name_size": int(getattr(self, "_name_size", 100)),
            "name_font": int(getattr(self, "_name_font", 0)),
            "grad_type": int(self._grad_type),
            "grad_angle": int(getattr(self, "_grad_angle", 0)),
            "grad_c1": self._hex(self._grad_c1),
            "grad_c2": self._hex(self._grad_c2),
            "grad_c3": self._hex(self._grad_c3),
            "grad_use3": bool(self._grad_use3),
            "grad_radius": int(getattr(self, "_grad_radius", 100)),
            "grad_count": int(getattr(self, "_grad_count", 2)),
            "banner_alpha": int(getattr(self, "_banner_alpha", 100)),
            "banner_dim": int(getattr(self, "_banner_dim", 0)),
            "banner_fade": int(getattr(self, "_banner_fade", 0)),
            "banner_fade_angle": int(getattr(self, "_banner_fade_angle", 0)),
            "banner_fade_radius": int(getattr(self, "_banner_fade_radius", 100)),
            "banner_fade_cx": float(getattr(self, "_banner_fade_cx", 0.5)),
            "banner_fade_cy": float(getattr(self, "_banner_fade_cy", 0.5)),
            "grad_cx": float(getattr(self, "_grad_cx", 0.5)),
            "grad_cy": float(getattr(self, "_grad_cy", 0.5)),
            "bg_enabled": bool(self._bg_enabled),
            "bg_mode": int(self._bg_mode),
            "bg_color": self._hex(self._bg_color),
            "blocks_color_enabled": bool(getattr(self, "_blocks_color_enabled", False)),
            "blocks_color": self._hex(getattr(self, "_blocks_color", -16777216)),
            "blocks_alpha": int(getattr(self, "_blocks_alpha", 100)),
            "blocks_blur": int(getattr(self, "_blocks_blur", 0)),
            "blocks_depth": int(getattr(self, "_blocks_depth", 4)),
            "bg_alpha": int(getattr(self, "_bg_alpha", 100)),
            "bg_dim": int(getattr(self, "_bg_dim", 0)),
            "bg_fade": int(getattr(self, "_bg_fade", 0)),
            "bg_fade_angle": int(getattr(self, "_bg_fade_angle", 0)),
            "bg_fade_radius": int(getattr(self, "_bg_fade_radius", 100)),
            "bg_fade_cx": float(getattr(self, "_bg_fade_cx", 0.5)),
            "bg_fade_cy": float(getattr(self, "_bg_fade_cy", 0.5)),
            "avatar_shape": int(getattr(self, "_avatar_shape", 0)),
            "avatar_radius": int(getattr(self, "_avatar_radius", 18)),
            "avatar_round": int(getattr(self, "_avatar_round", 0)),
            "avatar_alpha": int(getattr(self, "_avatar_alpha", 100)),
            "avatar_dim": int(getattr(self, "_avatar_dim", 0)),
            "thought_text": str(getattr(self, "_thought_text", "") or ""),
            "thought_text_color": self._hex(int(getattr(self, "_thought_text_color", -1))),
            "thought_bg_color": self._hex(int(getattr(self, "_thought_bg_color", -871557603))),
            "thought_font": int(getattr(self, "_thought_font", 0)),
            "thought_font_copy": bool(getattr(self, "_thought_font_copy", True)),
            "avatar_fade": int(getattr(self, "_avatar_fade", 0)),
            "avatar_fade_radius": int(getattr(self, "_avatar_fade_radius", 50)),
            "avatar_custom": getattr(self, "_avatar_custom", "") or "",
        }

    def _set_share(self, on):
        self._share_enabled = bool(on)
        try:
            self._ss(KEY_SHARE_ENABLED, self._share_enabled)
        except Exception:
            pass
        self.log(f"[cpb] share_enabled={self._share_enabled}")

    def _maybe_ask_remote_consent(self):
        if getattr(self, "_remote_enabled", False):
            return
        if getattr(self, "_remote_prompted", False):
            return
        if getattr(self, "_remote_dlg", False):
            return
        self._remote_dlg = True

        def _show():
            try:
                act = self._get_activity()
                if act is None:
                    self._remote_dlg = False
                    return
                from java import dynamic_proxy

                plugin = self

                _OnBtn = find_class("org.telegram.ui.ActionBar.AlertDialog$OnButtonClickListener")

                class _CpbConsentBtn(dynamic_proxy(_OnBtn)):
                    def __init__(self, fn):
                        super().__init__()
                        self._fn = fn

                    def onClick(self, dialog, which):
                        try:
                            self._fn()
                        except Exception:
                            pass

                def _accept():
                    plugin._remote_prompted = True
                    plugin._remote_enabled = True
                    try:
                        plugin._ss(KEY_REMOTE_PROMPTED, True)
                        plugin._ss(KEY_REMOTE_ENABLED, True)
                    except Exception:
                        pass
                    try:
                        rm = getattr(plugin, "_remote", None)
                        if rm:
                            for k in [k for k, v in rm.items() if isinstance(v, dict) and v.get("state") == "loading"]:
                                rm.pop(k, None)
                    except Exception:
                        pass

                def _decline():
                    plugin._remote_prompted = True
                    try:
                        plugin._ss(KEY_REMOTE_PROMPTED, True)
                    except Exception:
                        pass

                Builder = find_class("org.telegram.ui.ActionBar.AlertDialog$Builder")
                b = Builder(act)
                b.setTitle("Custom Profile")
                b.setMessage(cpb_tr("При открытии чужого профиля его числовой ID может отправляться на сервер плагина, чтобы загрузить опубликованное владельцем оформление. Разрешить? Изменить выбор можно в настройках плагина."))
                b.setPositiveButton(cpb_tr("Разрешить"), _CpbConsentBtn(_accept))
                b.setNegativeButton(cpb_tr("Отклонить"), _CpbConsentBtn(_decline))
                b.show()
            except Exception as e:
                self.log(f"[cpb] consent dialog failed: {e}")

        run_on_ui_thread(_show)

    def _set_remote_view(self, on):
        self._remote_enabled = bool(on)
        try:
            self._ss(KEY_REMOTE_ENABLED, self._remote_enabled)
        except Exception:
            pass
        self.log(f"[cpb] remote_enabled={self._remote_enabled}")

    def _start_notice_loop(self):
        try:
            if getattr(self, "_notice_thread", None) is not None:
                return
            import threading
            t = threading.Thread(target=self._notice_loop, daemon=True)
            self._notice_thread = t
            t.start()
        except Exception as e:
            self.log(f"[cpb] notice loop start failed: {e}")

    def _notice_loop(self):
        import time as _t
        import urllib.parse as _up
        _t.sleep(6)
        while True:
            if getattr(self, "_notice_stop", False):
                return
            try:
                url = VPS_BASE + "/api/notice?ver=" + _up.quote(str(__version__))
                code, raw = self._http_get_bytes(url)
                if code == 200 and raw:
                    j = json.loads(raw.decode("utf-8", "replace"))
                    if j.get("ok") and j.get("text"):
                        nid = str(j.get("id") or "")
                        if nid and nid != getattr(self, "_notice_shown", ""):
                            act = None
                            try:
                                act = self._get_activity()
                            except Exception:
                                act = None
                            if act is not None:
                                self._notice_shown = nid
                                self._show_notice(str(j.get("title") or ""), str(j.get("text") or ""))
            except Exception as e:
                self.log(f"[cpb] notice check failed: {e}")
            _t.sleep(300)

    def _show_notice(self, title, text):
        text = cpb_tr(text)
        def _run():
            try:
                act = self._get_activity()
                if act is None:
                    return
                Builder = find_class("org.telegram.ui.ActionBar.AlertDialog$Builder")
                b = Builder(act)
                b.setTitle(title or "Custom Profile")
                b.setMessage(text)
                b.setPositiveButton("OK", None)
                b.show()
            except Exception as e:
                self.log(f"[cpb] notice show failed: {e}")
        run_on_ui_thread(_run)

    def _device_key(self, create=True):
        try:
            k = str(self._gs(KEY_DEVICE_KEY, "") or "")
        except Exception:
            k = ""
        if len(k) != 64 and create:
            import secrets
            k = secrets.token_hex(32)
            try:
                self._ss(KEY_DEVICE_KEY, k)
            except Exception:
                pass
        return k

    def _notify_key(self, ok, msg):
        msg = cpb_tr(msg)
        wv = self._webview
        if wv is None:
            try:
                self._toast(msg)
            except Exception:
                pass
            return
        js = "window.cpbKeyResult && cpbKeyResult(%s,%s);" % ("true" if ok else "false", json.dumps(msg))
        def _run():
            try:
                wv.evaluateJavascript(js, None)
            except Exception as e:
                self.log(f"[cpb] key result js failed: {e}")
        run_on_ui_thread(_run)

    def _show_key_recovery(self, bot):
        wv = self._webview
        if wv is None:
            try:
                self._toast("Откройте редактор: требуется подтверждение владельца")
            except Exception:
                pass
            return
        _ec = 1 if int(getattr(self, "_edit_chat", 0) or 0) else 0
        js = "window.cpbShowRecovery && cpbShowRecovery(%s,%d);" % (json.dumps(str(bot or "")), _ec)
        def _run():
            try:
                wv.evaluateJavascript(js, None)
            except Exception as e:
                self.log(f"[cpb] recovery js failed: {e}")
        run_on_ui_thread(_run)

    def _on_key_confirm(self):
        def _run():
            try:
                import re
                from org.telegram.messenger import ApplicationLoader
                from java import jclass
                ctx = ApplicationLoader.applicationContext
                Context = jclass("android.content.Context")
                cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
                txt = ""
                try:
                    clip = cm.getPrimaryClip()
                    if clip is not None and clip.getItemCount() > 0:
                        t = clip.getItemAt(0).coerceToText(ctx)
                        txt = str(t) if t is not None else ""
                except Exception:
                    txt = ""
                m = re.search("[0-9a-fA-F]{64}", txt or "")
                if not m:
                    self._notify_key(False, "Ключ не найден в буфере обмена")
                    return
                try:
                    self._ss(KEY_DEVICE_KEY, m.group(0).lower())
                except Exception:
                    pass
                self._notify_key(True, "Ключ сохранён, публикуем…")
                self._on_publish()
            except Exception as e:
                self.log(f"[cpb] key confirm failed: {e}")
        run_on_ui_thread(_run)

    def _on_cfg_export(self):
        def _run():
            try:
                _skip = ("banner_path", "bg_path", "name_font_path", "last_pub_sig", "publish_consent", "remote_prompted", "share_enabled", "remote_enabled", "draft_saved")
                data = {}
                for k in _CPB_ALL_KEYS:
                    if k in _skip:
                        continue
                    try:
                        v = self._gs(k, None)
                    except Exception:
                        v = None
                    if v is not None:
                        data[k] = v
                payload = "CPBEXPORT1 " + json.dumps(data, ensure_ascii=True)
                from org.telegram.messenger import ApplicationLoader
                from java import jclass
                ctx = ApplicationLoader.applicationContext
                Context = jclass("android.content.Context")
                ClipData = jclass("android.content.ClipData")
                cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
                cm.setPrimaryClip(ClipData.newPlainText("cpb_config", payload))
                self._notify_key(True, "Конфиг скопирован в буфер обмена")
            except Exception as e:
                self.log(f"[cpb] cfg export failed: {e}")
                try:
                    self._notify_key(False, "Ошибка экспорта")
                except Exception:
                    pass
        run_on_ui_thread(_run)

    def _on_cfg_import(self):
        def _run():
            try:
                from org.telegram.messenger import ApplicationLoader
                from java import jclass
                ctx = ApplicationLoader.applicationContext
                Context = jclass("android.content.Context")
                cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
                txt = ""
                try:
                    clip = cm.getPrimaryClip()
                    if clip is not None and clip.getItemCount() > 0:
                        t = clip.getItemAt(0).coerceToText(ctx)
                        txt = str(t) if t is not None else ""
                except Exception:
                    txt = ""
                idx = (txt or "").find("CPBEXPORT1 ")
                if idx < 0:
                    self._notify_key(False, "В буфере нет конфига Custom Profile")
                    return
                data = json.loads(txt[idx + 11:].strip())
                if not isinstance(data, dict):
                    self._notify_key(False, "Неверный формат конфига")
                    return
                _skip = ("banner_path", "bg_path", "name_font_path", "last_pub_sig", "publish_consent", "remote_prompted", "share_enabled", "remote_enabled", "draft_saved")
                n = 0
                for k, v in data.items():
                    if k not in _CPB_ALL_KEYS or k in _skip:
                        continue
                    try:
                        self._ss(k, v)
                        n += 1
                    except Exception:
                        pass
                try:
                    self._reload_state()
                except Exception:
                    pass
                self._notify_key(True, "Импортировано настроек: %d. Переоткройте редактор" % n)
            except Exception as e:
                self.log(f"[cpb] cfg import failed: {e}")
                try:
                    self._notify_key(False, "Ошибка импорта")
                except Exception:
                    pass
        run_on_ui_thread(_run)

    def _on_publish(self):
        try:
            import threading
            threading.Thread(target=self._publish_my_profile, daemon=True).start()
        except Exception as e:
            self.log(f"[cpb] publish thread failed: {e}")

    def _http_post_json(self, url, body_bytes, headers):
        import urllib.request, urllib.error
        req = urllib.request.Request(url, data=body_bytes, method="POST")
        for k, v in headers.items():
            req.add_header(k, v)
        try:
            resp = urllib.request.urlopen(req, timeout=25)
            data = resp.read().decode("utf-8", "replace")
            return resp.getcode(), data
        except urllib.error.HTTPError as he:
            try:
                data = he.read().decode("utf-8", "replace")
            except Exception:
                data = ""
            return he.code, data

    def _notify_publish(self, ok, msg):
        msg = cpb_tr(msg)
        wv = self._webview
        if wv is not None:
            js = "window.cpbPublishResult && cpbPublishResult(%s,%s);" % ("true" if ok else "false", json.dumps(msg))
            def _run():
                try:
                    wv.evaluateJavascript(js, None)
                except Exception as e:
                    self.log(f"[cpb] publish result js failed: {e}")
            run_on_ui_thread(_run)
        else:
            try:
                self._toast(msg)
            except Exception:
                pass

    def _vps_publish(self, cfg, banner_path, bg_path=""):
        try:
            import base64
            img_b64 = ""
            if banner_path and os.path.exists(banner_path):
                try:
                    with open(banner_path, "rb") as f:
                        img_b64 = base64.b64encode(f.read()).decode("ascii")
                except Exception as e:
                    self.log(f"[cpb] read banner image failed: {e}")
            bg_b64 = ""
            if bg_path and os.path.exists(bg_path):
                try:
                    with open(bg_path, "rb") as f:
                        bg_b64 = base64.b64encode(f.read()).decode("ascii")
                except Exception as e:
                    self.log(f"[cpb] read bg image failed: {e}")
            font_b64 = ""
            try:
                if int(cfg.get("name_font", 0) or 0) == 6:
                    fpath = getattr(self, "_name_font_path", "") or ""
                    if fpath and os.path.exists(fpath) and os.path.getsize(fpath) <= 5 * 1024 * 1024:
                        with open(fpath, "rb") as f:
                            font_b64 = base64.b64encode(f.read()).decode("ascii")
            except Exception as e:
                self.log(f"[cpb] read font failed: {e}")
            if int(cfg.get("name_font", 0) or 0) == 6 and not font_b64:
                cfg["name_font"] = 0
            tfont_b64 = ""
            try:
                if int(cfg.get("thought_font", 0) or 0) == 6 and not cfg.get("thought_font_copy", True):
                    tfp = getattr(self, "_thought_font_path", "") or ""
                    if tfp and os.path.exists(tfp) and os.path.getsize(tfp) <= 5 * 1024 * 1024:
                        with open(tfp, "rb") as f:
                            tfont_b64 = base64.b64encode(f.read()).decode("ascii")
            except Exception as e:
                self.log(f"[cpb] read tfont failed: {e}")
            if int(cfg.get("thought_font", 0) or 0) == 6 and not cfg.get("thought_font_copy", True) and not tfont_b64:
                cfg["thought_font"] = 0
            body = {
                "token": VPS_TOKEN,
                "key": self._device_key(),
                "uid": int(cfg.get("uid", 0)),
                "owner": int(self._my_user_id() or 0),
                "config": cfg,
                "image_b64": img_b64,
                "image_bg_b64": bg_b64,
                "font_b64": font_b64,
                "tfont_b64": tfont_b64,
            }
            raw = json.dumps(body, ensure_ascii=True).encode("utf-8")
            url = VPS_BASE + "/api/publish"
            self.log(f"[cpb] vps publish -> {url} bytes={len(raw)} img={'y' if img_b64 else 'n'} bg={'y' if bg_b64 else 'n'}")
            code, data = self._http_post_json(url, raw, {"Content-Type": "application/json"})
            self.log(f"[cpb] vps publish resp {code}: {data[:180]}")
            if code == 200:
                self._notify_publish(True, "Профиль опубликован")
            else:
                err = None
                bot = ""
                try:
                    j = json.loads(data)
                    err = j.get("err")
                    bot = str(j.get("bot") or "")
                except Exception:
                    err = None
                _pub_chat = 0
                try:
                    _pub_chat = 1 if int(cfg.get("uid", 0) or 0) < 0 else 0
                except Exception:
                    _pub_chat = 0
                if err == "key" and not _pub_chat:
                    self._notify_publish(False, "Требуется подтверждение владельца")
                    self._show_key_recovery(bot)
                elif err == "chan" or (err == "key" and _pub_chat):
                    self._notify_publish(False, "Требуется привязка канала")
                    try:
                        _bt = bot or "@CustomProfileBot"
                        self._show_notice("Custom Profile", "Канал не привязан к владельцу.\n\n1. Добавьте бота %s в администраторы канала (достаточно любого права).\n2. Перешлите боту любой пост из канала — он проверит, что вы создатель, и привяжет канал.\n\nДля группы: добавьте бота в группу и отправьте в ней /bind.\n\nПодсказка есть и в самом боте: нажмите Start и выберите \xabПривязать канал или группу\xbb.\n\nПосле привязки нажмите \xabОпубликовать\xbb ещё раз. Бота можно удалить из админов." % _bt)
                    except Exception:
                        pass
                else:
                    self._notify_publish(False, "Ошибка публикации: " + str(code))
        except Exception as e:
            self.log(f"[cpb] vps publish failed: {e}")
            try:
                self._notify_publish(False, "Ошибка публикации")
            except Exception:
                pass

    def _publish_my_profile(self):
        try:
            if not getattr(self, "_share_enabled", False):
                self.log("[cpb] publish skipped: share disabled")
                return
            cfg = self._collect_config()
            _ec = int(getattr(self, "_edit_chat", 0) or 0)
            if _ec:
                cfg["uid"] = -_ec
                cfg["is_chat"] = 1
            else:
                cfg["uid"] = self._my_user_id()
            import time as _t
            cfg["ts"] = int(_t.time())
            payload = CFG_TAG + " " + json.dumps(cfg, ensure_ascii=True)
            banner_path = self._gs(KEY_BANNER_PATH, "") if int(self._banner_mode) == 0 else ""
            bg_path = self._gs(KEY_BG_PATH, "") if (bool(self._bg_enabled) and int(self._bg_mode) == 1) else ""
            self.log(f"[cpb] publish start uid={cfg['uid']} mode={self._banner_mode} img={'y' if banner_path else 'n'} bg={'y' if bg_path else 'n'} len={len(payload)}")
            try:
                self._ss(KEY_LAST_PUB_SIG, payload[:80])
            except Exception:
                pass
            self._vps_publish(cfg, banner_path if (banner_path and os.path.exists(banner_path)) else "", bg_path if (bg_path and os.path.exists(bg_path)) else "")
            self.log("[cpb] publish done")
        except Exception as e:
            self.log(f"[cpb] publish failed: {e}")

    def _show_pub_consent(self):
        wv = self._webview
        if wv is None:
            return
        def _run():
            try:
                wv.evaluateJavascript("window.cpbShowConsent && cpbShowConsent();", None)
            except Exception as e:
                self.log(f"[cpb] consent js failed: {e}")
        run_on_ui_thread(_run)

    def _on_bridge_url(self, url):
        from android.net import Uri
        uri = Uri.parse(url)
        host = uri.getHost()
        if host == "apply":
            self._apply_state(uri)
        elif host == "pick":
            self._pick_target(uri.getQueryParameter("target"))
        elif host == "clear":
            self._clear_target(uri.getQueryParameter("target"))
        elif host == "close":
            self._close_editor()
        elif host == "h":
            self._resize_inline(uri.getQueryParameter("v"))
        elif host == "publish":
            agree = None
            remember = None
            try:
                agree = uri.getQueryParameter("agree")
                remember = uri.getQueryParameter("remember")
            except Exception:
                pass
            if agree == "1":
                if remember == "1" and not getattr(self, "_pub_consent", False):
                    self._pub_consent = True
                    try:
                        self._ss(KEY_PUB_CONSENT, True)
                    except Exception:
                        pass
                self._on_publish()
            elif getattr(self, "_pub_consent", False):
                self._on_publish()
            else:
                self._show_pub_consent()
        elif host == "share":
            self._set_share(uri.getQueryParameter("on") == "1")
        elif host == "keyconfirm":
            self._on_key_confirm()
        elif host == "cfgexport":
            self._on_cfg_export()
        elif host == "cfgimport":
            self._on_cfg_import()
        elif host == "remoteview":
            self._set_remote_view(uri.getQueryParameter("on") == "1")
        elif host == "padrect":
            self._set_pad_rect(uri)

    def _set_pad_rect(self, uri):
        try:
            xs = uri.getQueryParameter("x")
            if xs is None:
                self._pad_rect = None
                return
            x = float(xs)
            y = float(uri.getQueryParameter("y"))
            w = float(uri.getQueryParameter("w"))
            h = float(uri.getQueryParameter("h"))
            if x < 0 or w <= 0 or h <= 0:
                self._pad_rect = None
            else:
                self._pad_rect = (x, y, w, h)
        except Exception:
            self._pad_rect = None

    def _resize_inline(self, v):
        try:
            css_px = int(float(v))
        except Exception:
            return
        from org.telegram.messenger import AndroidUtilities
        hpx = AndroidUtilities.dp(css_px)
        minh = AndroidUtilities.dp(180)
        if hpx < minh:
            hpx = minh
        cont = getattr(self, "_inline_container", None)
        if cont is None:
            return
        def _run():
            try:
                lp = cont.getLayoutParams()
                if lp is not None and lp.height != hpx:
                    lp.height = hpx
                    cont.setLayoutParams(lp)
                    cont.requestLayout()
                    p = cont.getParent()
                    if p is not None:
                        try:
                            p.requestLayout()
                        except Exception:
                            pass
            except Exception as e:
                self.log(f"[cpb] resize failed: {e}")
        run_on_ui_thread(_run)

    def _pick_target(self, target):
        if target == "banner":
            self._start_pick(PICK_BANNER_CODE, "Изображение баннера")
        elif target == "bg":
            self._start_pick(PICK_BG_CODE, "Изображение фона")
        elif target == "font":
            self._start_pick(PICK_FONT_CODE, "Файл шрифта (.ttf/.otf)", "*/*")
        elif target == "tfont":
            self._start_pick(PICK_TFONT_CODE, "Файл шрифта (.ttf/.otf)", "*/*")

    def _clear_target(self, target):
        if target == "banner":
            self._bmp = None
            self._shader = None
            self._ss(KEY_BANNER_PATH, "")
            self._push_image("banner")
        elif target == "bg":
            self._bg_bmp = None
            self._ss(KEY_BG_PATH, "")
            self._bg_dirty = True
            self._push_image("bg")
        elif target == "tfont":
            self._thought_font_path = ""
            self._ss(KEY_THOUGHT_FONT_PATH, "")
            self._thought_pc = None
            self._toast("Шрифт мыслей сброшен")
        elif target == "font":
            self._name_font_path = ""
            self._ss(KEY_NAME_FONT_PATH, "")
            try:
                _c = getattr(self, "_name_tf_cache", None)
                if _c is not None:
                    _c.clear()
            except Exception:
                pass

    def _apply_state(self, uri):
        def q(name):
            v = uri.getQueryParameter(name)
            return v if v is not None else ""

        def qf(name, cur):
            v = q(name)
            try:
                return float(v)
            except Exception:
                return cur

        def qi(name, cur):
            v = q(name)
            try:
                return int(v)
            except Exception:
                return cur

        def qb(name):
            return q(name) == "1"

        def qc(name, cur):
            c = self._parse_color(q(name))
            return c if c is not None else cur

        self._enabled = qb("banner_enabled")
        self._show_emoji = qb("show_emoji")
        self._name_color_enabled = qb("name_color_enabled")
        self._name_color = qc("name_color", getattr(self, "_name_color", -1))
        self._name_glow_enabled = qb("name_glow_enabled")
        self._name_glow_color = qc("name_glow_color", getattr(self, "_name_glow_color", -1))
        self._name_glow_radius = qi("name_glow_radius", int(getattr(self, "_name_glow_radius", 12)))
        self._name_glow_strength = qi("name_glow_strength", int(getattr(self, "_name_glow_strength", 100)))
        self._name_fx = qi("name_fx", int(getattr(self, "_name_fx", 0)))
        if self._name_fx < 0 or self._name_fx > 7:
            self._name_fx = 0
        self._name_fx_speed = qi("name_fx_speed", int(getattr(self, "_name_fx_speed", 100)))
        self._name_grad_c1 = qc("name_grad_c1", getattr(self, "_name_grad_c1", -1))
        self._name_grad_c2 = qc("name_grad_c2", getattr(self, "_name_grad_c2", -1))
        self._name_grad_angle = qi("name_grad_angle", int(getattr(self, "_name_grad_angle", 0)))
        self._name_size = qi("name_size", int(getattr(self, "_name_size", 100)))
        self._name_font = qi("name_font", int(getattr(self, "_name_font", 0)))
        self._avatar_shape = qi("avatar_shape", int(getattr(self, "_avatar_shape", 0)))
        self._avatar_radius = qi("avatar_radius", int(getattr(self, "_avatar_radius", 18)))
        self._avatar_round = qi("avatar_round", int(getattr(self, "_avatar_round", 0)))
        self._avatar_alpha = qi("avatar_alpha", int(getattr(self, "_avatar_alpha", 100)))
        self._avatar_dim = qi("avatar_dim", int(getattr(self, "_avatar_dim", 0)))
        self._thought_text = (q("thought_text") or "")[:200]
        self._thought_text_color = qc("thought_text_color", int(getattr(self, "_thought_text_color", -1)))
        self._thought_bg_color = qc("thought_bg_color", int(getattr(self, "_thought_bg_color", -871557603)))
        self._thought_font = qi("thought_font", int(getattr(self, "_thought_font", 0)))
        self._thought_font_copy = qb("thought_font_copy")
        self._avatar_fade = qi("avatar_fade", int(getattr(self, "_avatar_fade", 0)))
        self._avatar_fade_radius = qi("avatar_fade_radius", int(getattr(self, "_avatar_fade_radius", 50)))
        _cust = q("avatar_custom")
        self._avatar_custom = _cust
        self._avatar_custom_pts = self._parse_custom_pts(_cust)
        self._av_last_r = None
        self._banner_mode = qi("banner_mode", self._banner_mode)
        self._banner_color = qc("banner_color", self._banner_color)
        self._grad_type = qi("grad_type", self._grad_type)
        self._grad_dir = qi("grad_dir", self._grad_dir)
        self._grad_angle = qi("grad_angle", int(getattr(self, "_grad_angle", 0)))
        self._grad_c1 = qc("grad_c1", self._grad_c1)
        self._grad_c2 = qc("grad_c2", self._grad_c2)
        self._grad_c3 = qc("grad_c3", self._grad_c3)
        self._grad_use3 = qb("grad_use3")
        self._grad_radius = qi("grad_radius", int(getattr(self, "_grad_radius", 100)))
        self._grad_count = qi("grad_count", int(getattr(self, "_grad_count", 2)))
        self._grad_use3 = self._grad_count >= 3
        self._banner_alpha = qi("banner_alpha", int(getattr(self, "_banner_alpha", 100)))
        self._banner_dim = qi("banner_dim", int(getattr(self, "_banner_dim", 0)))
        self._banner_fade = qi("banner_fade", int(getattr(self, "_banner_fade", 0)))
        self._banner_fade_angle = qi("banner_fade_angle", int(getattr(self, "_banner_fade_angle", 0)))
        self._banner_fade_radius = qi("banner_fade_radius", int(getattr(self, "_banner_fade_radius", 100)))
        self._bg_alpha = qi("bg_alpha", int(getattr(self, "_bg_alpha", 100)))
        self._bg_dim = qi("bg_dim", int(getattr(self, "_bg_dim", 0)))
        self._bg_fade = qi("bg_fade", int(getattr(self, "_bg_fade", 0)))
        self._bg_fade_angle = qi("bg_fade_angle", int(getattr(self, "_bg_fade_angle", 0)))
        self._bg_fade_radius = qi("bg_fade_radius", int(getattr(self, "_bg_fade_radius", 100)))
        self._grad_cx = qf("grad_cx", float(getattr(self, "_grad_cx", 0.5)))
        self._grad_cy = qf("grad_cy", float(getattr(self, "_grad_cy", 0.5)))
        self._banner_fade_cx = qf("banner_fade_cx", float(getattr(self, "_banner_fade_cx", 0.5)))
        self._banner_fade_cy = qf("banner_fade_cy", float(getattr(self, "_banner_fade_cy", 0.5)))
        self._bg_fade_cx = qf("bg_fade_cx", float(getattr(self, "_bg_fade_cx", 0.5)))
        self._bg_fade_cy = qf("bg_fade_cy", float(getattr(self, "_bg_fade_cy", 0.5)))
        self._bg_enabled = qb("bg_enabled")
        self._bg_mode = qi("bg_mode", self._bg_mode)
        self._bg_color = qc("bg_color", self._bg_color)
        self._blocks_color_enabled = qb("blocks_color_enabled")
        self._blocks_color = qc("blocks_color", getattr(self, "_blocks_color", -16777216))
        self._blocks_alpha = qi("blocks_alpha", int(getattr(self, "_blocks_alpha", 100)))
        self._blocks_blur = qi("blocks_blur", int(getattr(self, "_blocks_blur", 0)))
        self._blocks_depth = qi("blocks_depth", int(getattr(self, "_blocks_depth", 4)))

        self._grad_sig = None
        self._bg_dirty = True
        self._banner_img_dirty = True

        self._ss(KEY_ENABLED, self._enabled)
        self._ss(KEY_EMOJI, self._show_emoji)
        self._ss(KEY_NAME_COLOR_ENABLED, bool(getattr(self, "_name_color_enabled", False)))
        self._ss(KEY_NAME_COLOR, self._hex(getattr(self, "_name_color", -1)))
        self._ss(KEY_NAME_GLOW_ENABLED, bool(getattr(self, "_name_glow_enabled", False)))
        self._ss(KEY_NAME_GLOW_COLOR, self._hex(getattr(self, "_name_glow_color", -1)))
        self._ss(KEY_NAME_GLOW_RADIUS, int(getattr(self, "_name_glow_radius", 12)))
        self._ss(KEY_NAME_GLOW_STRENGTH, int(getattr(self, "_name_glow_strength", 100)))
        self._ss(KEY_NAME_FX, int(getattr(self, "_name_fx", 0)))
        self._ss(KEY_NAME_FX_SPEED, int(getattr(self, "_name_fx_speed", 100)))
        self._ss(KEY_NAME_GRAD_C1, self._hex(getattr(self, "_name_grad_c1", -1)))
        self._ss(KEY_NAME_GRAD_C2, self._hex(getattr(self, "_name_grad_c2", -1)))
        self._ss(KEY_NAME_GRAD_ANGLE, int(getattr(self, "_name_grad_angle", 0)))
        self._ss(KEY_NAME_SIZE, int(getattr(self, "_name_size", 100)))
        self._ss(KEY_NAME_FONT, int(getattr(self, "_name_font", 0)))
        self._ss(KEY_NAME_FONT_PATH, getattr(self, "_name_font_path", "") or "")
        self._ss(KEY_AVATAR_SHAPE, self._avatar_shape)
        self._ss(KEY_AVATAR_RADIUS, self._avatar_radius)
        self._ss(KEY_AVATAR_ROUND, int(getattr(self, "_avatar_round", 0)))
        self._ss(KEY_AVATAR_ALPHA, int(getattr(self, "_avatar_alpha", 100)))
        self._ss(KEY_AVATAR_DIM, int(getattr(self, "_avatar_dim", 0)))
        self._ss(KEY_THOUGHT_TEXT, getattr(self, "_thought_text", "") or "")
        self._ss(KEY_THOUGHT_TEXT_COLOR, self._hex(int(getattr(self, "_thought_text_color", -1))))
        self._ss(KEY_THOUGHT_BG_COLOR, self._hex(int(getattr(self, "_thought_bg_color", -871557603))))
        self._ss(KEY_THOUGHT_FONT, int(getattr(self, "_thought_font", 0)))
        self._ss(KEY_THOUGHT_FONT_COPY, bool(getattr(self, "_thought_font_copy", True)))
        self._ss(KEY_AVATAR_FADE, int(getattr(self, "_avatar_fade", 0)))
        self._ss(KEY_AVATAR_FADE_RADIUS, int(getattr(self, "_avatar_fade_radius", 50)))
        self._ss(KEY_AVATAR_CUSTOM, getattr(self, "_avatar_custom", "") or "")
        self._ss(KEY_BANNER_MODE, self._banner_mode)
        self._ss(KEY_BANNER_COLOR, self._hex(self._banner_color))
        self._ss(KEY_GRAD_TYPE, self._grad_type)
        self._ss(KEY_GRAD_DIR, self._grad_dir)
        self._ss(KEY_GRAD_ANGLE, int(getattr(self, "_grad_angle", 0)))
        self._ss(KEY_GRAD_C1, self._hex(self._grad_c1))
        self._ss(KEY_GRAD_C2, self._hex(self._grad_c2))
        self._ss(KEY_GRAD_C3, self._hex(self._grad_c3))
        self._ss(KEY_GRAD_USE3, self._grad_use3)
        self._ss(KEY_GRAD_RADIUS, self._grad_radius)
        self._ss(KEY_GRAD_COUNT, self._grad_count)
        self._ss(KEY_BANNER_ALPHA, self._banner_alpha)
