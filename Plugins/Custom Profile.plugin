_CPB_TR_PAIRS = None
_CPB_LANG_EN = None

def _cpb_lang_en():
    global _CPB_LANG_EN
    if _CPB_LANG_EN is not None:
        return _CPB_LANG_EN
    code = ""
    try:
        _LC = find_class("org.telegram.messenger.LocaleController")
        _li = _LC.getInstance().getCurrentLocaleInfo()
        if _li is not None:
            code = str(_li.shortName or "")
    except Exception:
        code = ""
    if not code:
        try:
            from java.util import Locale
            code = str(Locale.getDefault().getLanguage() or "")
        except Exception:
            code = ""
    if not code:
        return False
    _CPB_LANG_EN = not code.lower().startswith("ru")
    return _CPB_LANG_EN

def cpb_tr(s):
    global _CPB_TR_PAIRS
    try:
        if s is None or not _cpb_lang_en():
            return s
        t = str(s)
        if _CPB_TR_PAIRS is None:
            _CPB_TR_PAIRS = sorted(CPB_EN.items(), key=lambda kv: -len(kv[0]))
        for k, v in _CPB_TR_PAIRS:
            if k in t:
                t = t.replace(k, v)
        return t
    except Exception:
        return s

try:
    if _cpb_lang_en():
        __description__ = "Style up your profile with this plugin!\n\n \u21b1 Settings on different versions: \n |  ExteraGram 12.5.1> - Profile -> \u22ee -> Style profile\n |  ExteraGram 12.8.1 - Plugin settings"
except Exception:
    pass

