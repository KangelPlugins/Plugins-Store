class _CpbSectionsGateHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if int(param.thisObject.hashCode()) == int(getattr(self.plugin, "_blocks_lv_hash", 0)):
                self.plugin._blocks_in_lv = True
        except Exception:
            pass

    def after_hooked_method(self, param):
        try:
            if int(param.thisObject.hashCode()) == int(getattr(self.plugin, "_blocks_lv_hash", 0)):
                self.plugin._blocks_in_lv = False
        except Exception:
            pass


