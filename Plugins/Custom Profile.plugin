class _OnDrawHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin
        self._err = False

    def before_hooked_method(self, param):
        try:
            self.plugin.apply_before_draw(param)
        except Exception as e:
            if not self._err:
                self._err = True
                self.plugin.log(f"[cpb] before draw error: {e}")

    def after_hooked_method(self, param):
        try:
            self.plugin.apply_after_draw(param)
        except Exception as e:
            if not getattr(self, "_err2", False):
                self._err2 = True
                self.plugin.log(f"[cpb] after draw error: {e}")


class _ThoughtTouchHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin
        self._err = False

    def before_hooked_method(self, param):
        try:
            self.plugin._thought_touch(param)
        except Exception as e:
            if not self._err:
                self._err = True
                self.plugin.log(f"[cpb] thought touch error: {e}")


class _BgPaintHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin
        self._err = False

    def after_hooked_method(self, param):
        try:
            self.plugin.apply_after_bg_paint(param)
        except Exception as e:
            if not self._err:
                self._err = True
                self.plugin.log(f"[cpb] bg paint error: {e}")


class _ActivityResultHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.on_activity_result(param)
        except Exception as e:
            self.plugin.log(f"[cpb] activity result error: {e}")


