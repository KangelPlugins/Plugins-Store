    ".tgp-row { display:flex; align-items:flex-start; gap:18px; padding:10px 16px; position:relative; }\n"
    ".tgp-row + .tgp-row:before { content:\"\"; position:absolute; left:54px; right:0; top:0;\n"
    "  height:1px; background:rgba(128,128,128,.16); }\n"
    ".tgp-ic { flex:0 0 auto; width:20px; text-align:center; font-size:17px; color:var(--muted); margin-top:2px; }\n"
    ".tgp-rt { min-width:0; }\n"
    ".tgp-rt b { font-weight:400; font-size:15px; color:var(--text); display:block; word-break:break-word; }\n"
    ".tgp-rt span { font-size:13px; color:var(--muted); display:block; margin-top:1px; }\n"
    ".tgp-rt a { color:var(--accent); text-decoration:none; }\n"
    ".mocklbl,.reallbl { font-size:12px; text-transform:uppercase; letter-spacing:.05em;\n"
    "  color:var(--muted); margin:2px 2px 6px; font-weight:700; }\n"
    ".realimg { width:100%; display:block; border-radius:14px; border:1px solid rgba(128,128,128,.16);\n"
    "  box-shadow:0 6px 24px rgba(0,0,0,.32); margin-bottom:16px; }\n"
    ".realhint { font-size:12px; color:var(--muted); padding:8px 2px 0; }\n"
    "\n"
    "/* --- controls --- */\n"
    "h3 { font-size:13px; text-transform:uppercase; letter-spacing:.06em; color:var(--accent);\n"
    "  margin:20px 2px 8px; font-weight:700; }\n"
    ".card { background:var(--card); border-radius:14px; padding:4px 14px; }\n"
    ".row { display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid rgba(128,128,128,.16); }\n"
    ".row:last-child { border-bottom:none; }\n"
    ".row .lbl { flex:1; }\n"
    ".row .lbl b { font-weight:600; }\n"
    ".row .lbl span { display:block; font-size:12px; color:var(--muted); margin-top:2px; }\n"
    ".switch { position:relative; width:48px; height:28px; flex:0 0 auto; }\n"
    ".switch input { opacity:0; width:0; height:0; }\n"
    ".slider { position:absolute; inset:0; background:rgba(128,128,128,.4); border-radius:28px; transition:.2s; }\n"
    ".slider:before { content:\"\"; position:absolute; width:22px; height:22px; left:3px; top:3px;\n"
    "  background:#fff; border-radius:50%; transition:.2s; box-shadow:0 1px 3px rgba(0,0,0,.4); }\n"
    ".switch input:checked + .slider { background:var(--accent); }\n"
    ".switch input:checked + .slider:before { transform:translateX(20px); }\n"
    ".seg { display:flex; gap:6px; flex-wrap:wrap; padding:10px 0; }\n"
    ".seg button { flex:1 1 auto; min-width:44px; padding:9px 8px; border-radius:10px; border:1px solid rgba(128,128,128,.3);\n"
    "  background:transparent; color:var(--text); font-size:13px; font-weight:600; display:flex; align-items:center; justify-content:center; }\n"
    ".seg button svg { width:22px; height:22px; display:block; }\n"
    ".seg button.active { background:var(--accent); border-color:var(--accent); color:#fff; }\n"
    ".colorRow { display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid rgba(128,128,128,.16); }\n"
    ".colorRow:last-child { border-bottom:none; }\n"
    ".colorRow .lbl { flex:1; }\n"
    ".colorRow input[type=color] { width:44px; height:34px; border:none; background:none; padding:0; border-radius:8px; }\n"
    ".colorRow input[type=range] { width:110px; }\n"
    ".hex { font-size:12px; color:var(--muted); font-family:monospace; width:78px; text-align:right; }\n"
    ".btnrow { display:flex; gap:10px; padding:12px 0; }\n"
    ".btn { flex:1; padding:11px; border-radius:10px; border:none; font-weight:600; font-size:14px; background:var(--accent); color:#fff; }\n"
    ".btn.sec { background:rgba(128,128,128,.22); color:var(--text); }\n"
    ".btn.danger { background:rgba(229,57,53,.16); color:#e53935; }\n"
    ".hint { font-size:12px; color:var(--muted); padding:8px 2px 0; }\n"
    ".sw{ width:46px; height:30px; border-radius:8px; border:1px solid rgba(128,128,128,.45); padding:0;\n"
    "  background-image: linear-gradient(var(--c,#000),var(--c,#000)),\n"
    "    conic-gradient(#c9c9c9 25%,#fff 0 50%,#c9c9c9 0 75%,#fff 0);\n"
    "  background-size:auto, 12px 12px; background-position:center; }\n"
    ".cp-toast{ position:fixed; left:16px; right:16px; bottom:20px; margin:0 auto; max-width:520px; z-index:130; padding:13px 16px; border-radius:12px; color:#fff; font-size:14px; font-weight:600; text-align:center; box-shadow:0 10px 34px rgba(0,0,0,.45); opacity:0; transform:translateY(18px); transition:opacity .22s, transform .22s; pointer-events:none; background:rgba(45,55,72,.97); } .cp-toast.on{ opacity:1; transform:translateY(0); } .cp-toast.okk{ background:rgba(38,150,74,.97); } .cp-toast.errr{ background:rgba(200,60,60,.97); } .cp-dim{ position:fixed; inset:0; z-index:50; background:rgba(0,0,0,.55); display:none;\n"
    "  align-items:center; justify-content:center; padding:18px; }\n"
    ".cp-dim.on{ display:flex; }\n"
    ".cp{ width:100%; max-width:340px; background:var(--card); border-radius:16px; padding:14px;\n"
    "  box-shadow:0 20px 60px rgba(0,0,0,.5); }\n"
    ".cp-sv{ position:relative; width:100%; height:170px; border-radius:12px; overflow:hidden; touch-action:none; }\n"
    ".cp-thumb{ position:absolute; width:18px; height:18px; border-radius:50%; border:2px solid #fff;\n"
    "  box-shadow:0 0 0 1px rgba(0,0,0,.4); transform:translate(-50%,-50%); pointer-events:none; }\n"
    "#cpHue,#cpAlpha{ width:100%; -webkit-appearance:none; appearance:none; height:14px; border-radius:8px; margin:0; }\n"
    "#cpHue{ margin-top:14px; background:linear-gradient(to right,#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00); }\n"
    ".cp-alpha{ margin-top:12px; border-radius:8px;\n"
    "  background-image:conic-gradient(#c9c9c9 25%,#fff 0 50%,#c9c9c9 0 75%,#fff 0); background-size:12px 12px; }\n"
    "#cpAlpha{ background:linear-gradient(to right, rgba(0,0,0,0), var(--ac,#000)); }\n"
    ".cp input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; appearance:none; width:18px; height:18px; border-radius:50%; background:#fff; border:1px solid rgba(0,0,0,.35); box-shadow:0 1px 4px rgba(0,0,0,.4); }\n"
    "input[type=range]:not(#cpHue):not(#cpAlpha){ -webkit-appearance:none; appearance:none; height:22px; border-radius:11px; background:rgba(128,128,128,.28); outline:none; margin:6px 0; cursor:pointer; }\n"
    "input[type=range]:not(#cpHue):not(#cpAlpha)::-webkit-slider-runnable-track{ height:22px; border-radius:11px; background:transparent; border:none; }\n"
    "input[type=range]:not(#cpHue):not(#cpAlpha)::-webkit-slider-thumb{ -webkit-appearance:none; appearance:none; width:1px; height:22px; background:transparent; border:none; box-shadow:none; }\n"
    ".cp-foot{ display:flex; align-items:center; gap:10px; margin-top:14px; }\n"
    ".cp-prev{ width:34px; height:34px; border-radius:8px; border:1px solid rgba(128,128,128,.4); flex:0 0 auto;\n"
    "  background-image:linear-gradient(var(--pc,#000),var(--pc,#000)),conic-gradient(#c9c9c9 25%,#fff 0 50%,#c9c9c9 0 75%,#fff 0);\n"
    "  background-size:auto,12px 12px; }\n"
    ".cp-hex{ flex:1; min-width:0; background:var(--bg); color:var(--text); border:1px solid rgba(128,128,128,.4);\n"
    "  border-radius:8px; padding:9px 10px; font-family:monospace; font-size:14px; }\n"
    ".angleRow{ display:flex; gap:16px; align-items:center; padding:12px 0; }\n"
    ".dial{ position:relative; width:76px; height:76px; flex:0 0 auto; border-radius:50%;\n"
    "  background:radial-gradient(circle at 50% 50%, rgba(128,128,128,.14), rgba(128,128,128,.05));\n"
    "  border:1px solid rgba(128,128,128,.3); touch-action:none; }\n"
    ".dial:before{ content:\"\"; position:absolute; left:50%; top:50%; width:6px; height:6px; margin:-3px;\n"
    "  border-radius:50%; background:var(--muted); }\n"
    ".dial-h{ position:absolute; width:14px; height:14px; margin:-7px; border-radius:50%;\n"
    "  background:var(--accent); box-shadow:0 0 0 3px rgba(0,0,0,.15); }\n"
    ".angmeta{ flex:1; min-width:0; }\n"
    ".angval{ font-weight:600; font-size:15px; margin-bottom:6px; }\n"
    ".angrange{ width:100%; accent-color:var(--accent); }\n"
    ".angpresets{ display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }\n"
    ".angpresets button{ width:34px; height:30px; border-radius:8px; border:1px solid rgba(128,128,128,.3);\n"
    "  background:transparent; color:var(--text); font-size:15px; }\n"
    ".padwrap{ display:flex; gap:16px; align-items:flex-start; padding:14px 0; }\n"
    ".pad{ position:relative; width:150px; height:150px; flex:0 0 auto; border-radius:14px;  background:radial-gradient(circle at 50% 50%, rgba(128,128,128,.14), rgba(128,128,128,.05));  border:1px solid rgba(128,128,128,.3); touch-action:none; overflow:hidden; -webkit-user-select:none; user-select:none; -webkit-touch-callout:none; }\n"
    ".pad-fade{ position:absolute; inset:0; border-radius:inherit; pointer-events:none; }.pad-svg{ position:absolute; inset:0; width:100%; height:100%; }\n"
    ".pad-linel{ stroke:var(--accent); stroke-width:2.6; stroke-linecap:round; }\n"
    ".pad-ringc{ stroke:var(--accent); stroke-width:2; fill:rgba(128,128,128,.06); }\n"
    ".pad-dot{ fill:var(--muted); }\n"
    ".pad-stop{ stroke:#fff; stroke-width:1; }\n"
    ".pad-h{ position:absolute; width:18px; height:18px; border-radius:50%; background:var(--accent);  border:2px solid #fff; box-shadow:0 1px 5px rgba(0,0,0,.5); transform:translate(-50%,-50%);  left:50%; top:10%; pointer-events:none; }\n"
    ".padmeta{ flex:1; min-width:0; }\n"
    ".padval{ font-weight:600; font-size:15px; margin-bottom:8px; }\n"
    ".mini{ display:block; font-size:12px; color:var(--muted); margin:10px 0 2px; }\n"
    ".rng{ width:100%; accent-color:var(--accent); touch-action:none; }\n"
    ".rng2{ flex:1; accent-color:var(--accent); touch-action:none; }\n"
    ".avfadewrap{ display:flex; gap:16px; align-items:flex-start; padding:12px 0; border-bottom:1px solid rgba(128,128,128,.16); }\n"
    ".avfadeprev{ position:relative; width:96px; height:96px; flex:0 0 auto; border-radius:14px; background:repeating-conic-gradient(rgba(128,128,128,.20) 0% 25%, rgba(128,128,128,.06) 0% 50%) 50% / 16px 16px; border:1px solid rgba(128,128,128,.3); overflow:hidden; }\n"
    ".avfadeimg{ position:absolute; inset:0; border-radius:50%; background:linear-gradient(135deg,#5caffa,#408acf); background-size:cover; background-position:center; }\n"
    ".avfadectr{ flex:1; min-width:0; }\n"
    ".rrow{ display:flex; align-items:center; gap:12px; }\n"
    ".tabs{ position:sticky; top:0; z-index:20; display:flex; gap:6px; padding:6px; margin:0 0 14px; background:var(--card); border-radius:14px; box-shadow:0 3px 14px rgba(0,0,0,.18); overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; scrollbar-width:none; }\n"
    ".tabs::-webkit-scrollbar{ display:none; width:0; height:0; }\n"
    ".tabs .tb{ flex:1 0 auto; min-width:max-content; padding:10px 14px; border-radius:10px; border:none; background:transparent; color:var(--muted); font-size:13px; font-weight:700; letter-spacing:.2px; transition:background .15s,color .15s; white-space:nowrap; }\n"
    ".tabs .tb.active{ background:var(--accent); color:#fff; box-shadow:0 2px 8px rgba(0,0,0,.28); }\n"
    ".sec{ display:none; }\n"
    ".sec.on{ display:block; }\n"
    ".sec h3:first-child{ margin-top:6px; }\n"
    "@keyframes cpbPulse { 0%,100%{ opacity:.42; } 50%{ opacity:1; } }\n"
    "@keyframes cpbSlide { 0%{ background-position:0% 50%; } 100%{ background-position:200% 50%; } }\n"
    "@keyframes cpbFlicker { 0%,100%{ opacity:1; } 7%{ opacity:.55; } 9%{ opacity:1; } 44%{ opacity:.8; } 48%{ opacity:1; } 71%{ opacity:.4; } 74%{ opacity:1; } }\n"
    ".fxgrad { background-size:200% 100%; -webkit-background-clip:text; background-clip:text; color:transparent !important; }\n"
    ".seg .fxd{ display:inline-block; font-weight:800; }\n"
    ".fx-pulse{ animation:cpbPulse 1.6s ease-in-out infinite; }\n"
    ".fx-grad{ background:linear-gradient(90deg,#7b5cff,#3390ec); -webkit-background-clip:text; background-clip:text; color:transparent; }\n"
    ".fx-shim{ background:linear-gradient(90deg,#8a97a5 20%,#ffffff 50%,#8a97a5 80%); background-size:200% 100%; -webkit-background-clip:text; background-clip:text; color:transparent; animation:cpbSlide 2.2s linear infinite; }\n"
    ".fx-rain{ background:linear-gradient(90deg,#ff5252,#ffb300,#ffee58,#66bb6a,#42a5f5,#ab47bc,#ff5252); background-size:200% 100%; -webkit-background-clip:text; background-clip:text; color:transparent; animation:cpbSlide 3s linear infinite; }\n"
    ".fx-neon{ color:#5ee7ff; text-shadow:0 0 6px rgba(41,211,255,.9),0 0 14px rgba(41,211,255,.55); animation:cpbFlicker 2.6s linear infinite; }\n"
    ".fx-fire{ background:linear-gradient(0deg,#ff3d00,#ff9800 55%,#ffe082); -webkit-background-clip:text; background-clip:text; color:transparent; text-shadow:0 0 10px rgba(255,110,0,.28); }\n"
    ".fx-ice{ background:linear-gradient(180deg,#f2fdff,#8fdcff 55%,#3f9dff); -webkit-background-clip:text; background-clip:text; color:transparent; text-shadow:0 0 10px rgba(130,200,255,.3); }\n"
    "</style></head>\n"
    "<body>\n"
    "<div class=\"wrap\">\n"
    "  <div class=\"preview\">\n"
    "    <div id=\"realWrap\" style=\"display:none\">\n"
    "      <div class=\"reallbl\">Ваш профиль</div>\n"
    "      <img id=\"phSnap\" class=\"realimg\" alt=\"\">\n"
    "    </div>\n"
    "    <div id=\"mockWrap\">\n"
    "    <div class=\"mocklbl\">Предпросмотр изменений баннера</div>\n"
    "    <div class=\"tgp\">\n"
    "      <div class=\"tgp-hero\" id=\"phBanner\">\n"
    "        <div id=\"phEmoji\">✨ ⭐ ✨ ⭐ ✨ ⭐ ✨ ⭐ ✨ ⭐ ✨ ⭐ ✨ ⭐ ✨ ⭐ ✨ ⭐ ✨ ⭐ ✨ ⭐</div>\n"
    "        <div class=\"tgp-gtop\"></div>\n"
    "        <div class=\"tgp-tabs\"><i class=\"on\"></i><i></i><i></i></div>\n"
    "        <div class=\"tgp-scrim\"></div>\n"
    "        <div class=\"tgp-info\">\n"
    "          <div class=\"tgp-avatar\" id=\"phAvatar\">&#128100;</div>\n"
    "          <div class=\"tgp-meta\">\n"
    "            <div class=\"tgp-name\"><span class=\"nm\" id=\"phNameTxt\">Профиль</span><span class=\"tgp-badge\">&#11088;</span></div>\n"
    "            <div class=\"tgp-status\"><span class=\"tgp-star\">&#9733;</span><span id=\"phStatus\">был(а) недавно</span></div>\n"
    "          </div>\n"
    "        </div>\n"
    "      </div>\n"
    "      <div class=\"tgp-body\" id=\"phBody\">\n"
    "        <div class=\"tgp-sect\">\n"
    "          <div class=\"tgp-row\"><span class=\"tgp-ic\">&#128241;</span><div class=\"tgp-rt\"><b id=\"phPhone\">+7 900 000 00 00</b><span>Телефон</span></div></div>\n"
    "          <div class=\"tgp-row\"><span class=\"tgp-ic\">@</span><div class=\"tgp-rt\"><b id=\"phUser\">@username</b><span>Имя пользователя</span></div></div>\n"
    "          <div class=\"tgp-row\"><span class=\"tgp-ic\">&#8505;</span><div class=\"tgp-rt\"><b>Расскажите о себе</b><span>О себе</span></div></div>\n"
    "          <div class=\"tgp-row\"><span class=\"tgp-ic\">&#127874;</span><div class=\"tgp-rt\"><b>13 апреля</b><span>День рождения</span></div></div>\n"
    "        </div>\n"
    "      </div>\n"
    "    </div>\n"
    "    </div>\n"
    "    <div class=\"realhint\" id=\"snapHint\">Откройте свой профиль один раз, чтобы загрузить реальный снимок.</div>\n"
    "  </div>\n"
    "\n"
    "<div class=\"tabs\"><button class=\"tb active\" data-t=\"banner\">Баннер</button><button class=\"tb\" data-t=\"name\">Ник</button><button class=\"tb\" data-t=\"avatar\">Аватар</button><button class=\"tb\" data-t=\"thought\">Мысли</button><button class=\"tb\" data-t=\"bg\">Фон</button><button class=\"tb\" data-t=\"share\">Публикация</button></div>\n"
    "  <div class=\"sec on\" id=\"sec_banner\">\n"
    "  <h3>Баннер профиля</h3>\n"
    "  <div class=\"card\">\n"
    "    <div class=\"row\"><div class=\"lbl\"><b>Включить баннер</b><span>Заменять фон шапки профиля</span></div>\n"
    "      <label class=\"switch\"><input type=\"checkbox\" id=\"sw_banner\"><span class=\"slider\"></span></label></div>\n"
    "    <div id=\"bannerBody\">\n"
    "      <div class=\"seg\" id=\"seg_banner_mode\">\n"
    "        <button data-g=\"banner_mode\" data-v=\"0\">Изображение</button>\n"
    "        <button data-g=\"banner_mode\" data-v=\"1\">Цвет</button>\n"
    "        <button data-g=\"banner_mode\" data-v=\"2\">Градиент</button>\n"
    "      </div>\n"
    "      <div id=\"ban_img_grp\">\n"
    "        <div class=\"btnrow\">\n"
    "          <button class=\"btn\" id=\"pick_banner\">Выбрать изображение</button>\n"
    "          <button class=\"btn danger\" id=\"clear_banner\">Сбросить</button>\n"
    "        </div>\n"
    "        <div class=\"colorRow\"><div class=\"lbl\"><b>Прозрачность</b><span>Общая непрозрачность</span></div>\n"
    "          <input type=\"range\" min=\"0\" max=\"100\" id=\"banAlpha\" class=\"rng2\"><span class=\"hex\" id=\"l_banAlpha\">100%</span></div>\n"
    "        <div class=\"colorRow\"><div class=\"lbl\"><b>Затемнение</b><span>Яркость баннера: чем выше — тем темнее</span></div>\n"
    "          <input type=\"range\" min=\"0\" max=\"100\" id=\"banDim\" class=\"rng2\"><span class=\"hex\" id=\"l_banDim\">0%</span></div>\n"
    "        <div class=\"seg\" id=\"seg_banner_fade\">\n"
    "          <button data-g=\"banner_fade\" data-v=\"0\">Без затухания</button>\n"
    "          <button data-g=\"banner_fade\" data-v=\"1\">Линейное</button>\n"
    "          <button data-g=\"banner_fade\" data-v=\"2\">Радиальное</button>\n"
    "        </div>\n"
    "        <div class=\"padwrap\" id=\"banFadeRow\">\n"
    "          <div class=\"pad\" id=\"bfpad\">\n"
    "            <svg class=\"pad-svg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\">\n"
    "              <circle class=\"pad-ringc\" id=\"bfpadRing\" cx=\"50\" cy=\"50\" r=\"30\"></circle>\n"
    "              <line class=\"pad-linel\" id=\"bfpadLine\" x1=\"50\" y1=\"50\" x2=\"50\" y2=\"10\"></line>\n"
    "              <circle class=\"pad-dot\" cx=\"50\" cy=\"50\" r=\"2.6\"></circle>\n"
    "            </svg>\n"
    "            <div class=\"pad-h\" id=\"bfpadH\"></div>\n"
    "          </div>\n"
    "          <div class=\"padmeta\">\n"
    "            <div class=\"padval\"><span id=\"bfAng\">0</span> deg &middot; <span id=\"bfRad\">100</span>%</div>\n"
    "            <label class=\"mini\" id=\"bfAngLbl\">Направление затухания</label>\n"
    "            <input type=\"range\" min=\"0\" max=\"360\" id=\"bfAngR\" class=\"rng\">\n"
    "            <label class=\"mini\">Размер</label>\n"
    "            <input type=\"range\" min=\"20\" max=\"200\" id=\"bfRadR\" class=\"rng\">\n"
    "          </div>\n"
    "        </div>\n"
    "      </div>\n"
    "      <div id=\"ban_color_grp\">\n"
    "        <div class=\"colorRow\"><div class=\"lbl\"><b>Цвет баннера</b></div>\n"
    "          <button class=\"sw\" id=\"sw_banner_color\"></button><span class=\"hex\" id=\"l_banner_color\"></span></div>\n"
    "      </div>\n"
    "      <div id=\"ban_grad_grp\">\n"
    "        <div class=\"seg\" id=\"seg_grad_type\">\n"
    "          <button data-g=\"grad_type\" data-v=\"0\">Линейный</button>\n"
    "          <button data-g=\"grad_type\" data-v=\"1\">Радиальный</button>\n"
    "        </div>\n"
    "        <div class=\"padwrap\" id=\"gradPadRow\">\n"
    "          <div class=\"pad\" id=\"gpad\">\n"
    "            <svg class=\"pad-svg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\">\n"
    "              <circle class=\"pad-ringc\" id=\"gpadRing\" cx=\"50\" cy=\"50\" r=\"30\"></circle>\n"
    "              <line class=\"pad-linel\" id=\"gpadLine\" x1=\"50\" y1=\"50\" x2=\"50\" y2=\"10\"></line>\n"
    "              <circle class=\"pad-dot\" cx=\"50\" cy=\"50\" r=\"2.6\"></circle>\n"
    "              <circle class=\"pad-stop\" id=\"gs0\" r=\"3.4\" cx=\"50\" cy=\"50\"></circle>\n"
    "              <circle class=\"pad-stop\" id=\"gs1\" r=\"3.4\" cx=\"50\" cy=\"50\"></circle>\n"
    "              <circle class=\"pad-stop\" id=\"gs2\" r=\"3.4\" cx=\"50\" cy=\"50\"></circle>\n"
    "            </svg>\n"
    "            <div class=\"pad-h\" id=\"gpadH\"></div>\n"
    "          </div>\n"
    "          <div class=\"padmeta\">\n"
    "            <div class=\"padval\"><span id=\"gpAng\">0</span> deg &middot; <span id=\"gpRad\">100</span>%</div>\n"
    "            <label class=\"mini\" id=\"gpAngLbl\">Направление</label>\n"
    "            <input type=\"range\" min=\"0\" max=\"360\" id=\"gpAngR\" class=\"rng\">\n"
    "            <label class=\"mini\">Радиус</label>\n"
    "            <input type=\"range\" min=\"20\" max=\"200\" id=\"gpRadR\" class=\"rng\">\n"
    "            <label class=\"mini\">Количество цветов</label>\n"
    "            <div class=\"seg\" id=\"seg_grad_count\">\n"
    "              <button data-g=\"grad_count\" data-v=\"2\">2</button>\n"
    "              <button data-g=\"grad_count\" data-v=\"3\">3</button>\n"
    "            </div>\n"
    "          </div>\n"
    "        </div>\n"
    "        <div class=\"colorRow\"><div class=\"lbl\"><b>Цвет 1</b></div>\n"
    "          <button class=\"sw\" id=\"sw_grad_c1\"></button><span class=\"hex\" id=\"l_grad_c1\"></span></div>\n"
    "        <div class=\"colorRow\"><div class=\"lbl\"><b>Цвет 2</b></div>\n"
    "          <button class=\"sw\" id=\"sw_grad_c2\"></button><span class=\"hex\" id=\"l_grad_c2\"></span></div>\n"
    "        <div class=\"colorRow\" id=\"grad_c3_row\"><div class=\"lbl\"><b>Цвет 3</b></div>\n"
    "          <button class=\"sw\" id=\"sw_grad_c3\"></button><span class=\"hex\" id=\"l_grad_c3\"></span></div>\n"
    "      </div>\n"
    "      <div class=\"row\"><div class=\"lbl\"><b>Показывать эмодзи</b><span>Эмодзи поверх баннера (переоткройте профиль)</span></div>\n"
    "        <label class=\"switch\"><input type=\"checkbox\" id=\"sw_emoji\"><span class=\"slider\"></span></label></div>\n"
    "    </div>\n"
    "  </div>\n"
    "\n"
    "</div>\n"
    "  <div class=\"sec\" id=\"sec_name\">\n"
    "  <h3>Ник</h3>\n"
    "  <div class=\"card\">\n"
    "    <div class=\"row\"><div class=\"lbl\"><b>Цвет ника</b><span>Свой цвет имени в шапке профиля</span></div>\n"
    "      <label class=\"switch\"><input type=\"checkbox\" id=\"sw_name_color_enabled\"><span class=\"slider\"></span></label></div>\n"
    "    <div class=\"colorRow\" id=\"nameColorRow\"><div class=\"lbl\"><b>Цвет имени</b></div>\n"
    "      <button class=\"sw\" id=\"sw_name_color\"></button><span class=\"hex\" id=\"l_name_color\"></span></div>\n"
    "    <div class=\"row\"><div class=\"lbl\"><b>Свечение ника <span style=\"display:inline-block;margin-left:2px;padding:1px 7px;border-radius:9px;font-size:9.5px;font-weight:800;letter-spacing:.6px;background:linear-gradient(90deg,#7b5cff,#3390ec);color:#fff;vertical-align:1px;\">BETA</span></b><span>Неоновый ореол вокруг имени</span></div>\n"
    "      <label class=\"switch\"><input type=\"checkbox\" id=\"sw_name_glow_enabled\"><span class=\"slider\"></span></label></div>\n"
    "    <div class=\"row\" id=\"nameGlowStrRow\"><div class=\"lbl\"><b>Сила свечения</b></div>\n"
    "      <input type=\"range\" min=\"0\" max=\"100\" id=\"nameGlowStr\" class=\"rng2\"><span class=\"hex\" id=\"l_nameGlowStr\"></span></div>\n"
    "    <div class=\"row\" id=\"nameGlowRadRow\"><div class=\"lbl\"><b>Радиус свечения</b></div>\n"
    "      <input type=\"range\" min=\"0\" max=\"40\" id=\"nameGlowRad\" class=\"rng2\"><span class=\"hex\" id=\"l_nameGlowRad\"></span></div>\n"
    "    <div class=\"lbl\"><b>Анимация ника</b></div>\n"
    "    <div class=\"seg\" id=\"seg_name_fx\">\n"
    "      <button data-g=\"name_fx\" data-v=\"0\">Нет</button>\n"
    "      <button data-g=\"name_fx\" data-v=\"1\"><span class=\"fxd fx-pulse\">Пульс</span></button>\n"
    "      <button data-g=\"name_fx\" data-v=\"2\"><span class=\"fxd fx-grad\">Градиент</span></button>\n"
    "      <button data-g=\"name_fx\" data-v=\"3\"><span class=\"fxd fx-shim\">Шиммер</span></button>\n"
    "      <button data-g=\"name_fx\" data-v=\"4\"><span class=\"fxd fx-rain\">Радуга</span></button>\n"
    "      <button data-g=\"name_fx\" data-v=\"5\"><span class=\"fxd fx-neon\">Неон</span></button>\n"
    "      <button data-g=\"name_fx\" data-v=\"6\"><span class=\"fxd fx-fire\">Огонь</span></button>\n"
    "      <button data-g=\"name_fx\" data-v=\"7\"><span class=\"fxd fx-ice\">Лёд</span></button>\n"
    "    </div>\n"
    "    <div id=\"nameGradGrp\">\n"
    "      <div class=\"colorRow\"><div class=\"lbl\"><b>Цвет 1</b></div>\n"
    "        <button class=\"sw\" id=\"sw_name_grad_c1\"></button><span class=\"hex\" id=\"l_name_grad_c1\"></span></div>\n"
    "      <div class=\"colorRow\"><div class=\"lbl\"><b>Цвет 2</b></div>\n"
    "        <button class=\"sw\" id=\"sw_name_grad_c2\"></button><span class=\"hex\" id=\"l_name_grad_c2\"></span></div>\n"
    "    </div>\n"
    "    <div class=\"row\" id=\"nameFxSpeedRow\"><div class=\"lbl\"><b>Скорость</b></div>\n"
    "      <input type=\"range\" min=\"10\" max=\"300\" id=\"nameFxSpeed\" class=\"rng2\"><span class=\"hex\" id=\"l_nameFxSpeed\"></span></div>\n"
    "    <div class=\"row\" id=\"nameGradAngRow\"><div class=\"lbl\"><b>Направление</b><span>Угол градиента и эффектов</span></div>\n"
    "      <input type=\"range\" min=\"0\" max=\"360\" id=\"nameGradAng\" class=\"rng2\"><span class=\"hex\" id=\"l_nameGradAng\"></span></div>\n"
    "    <div class=\"row\"><div class=\"lbl\"><b>Размер ника</b><span>Масштаб шрифта имени</span></div>\n"
    "      <input type=\"range\" min=\"50\" max=\"200\" id=\"nameSize\" class=\"rng2\"><span class=\"hex\" id=\"l_nameSize\"></span></div>\n"
    "    <div class=\"lbl\"><b>Шрифт ника</b></div>\n"
    "    <div class=\"seg\" id=\"seg_name_font\">\n"
    "      <button data-g=\"name_font\" data-v=\"0\">Стандарт</button>\n"
    "      <button data-g=\"name_font\" data-v=\"1\" style=\"font-weight:400\">Тонкий</button>\n"
    "      <button data-g=\"name_font\" data-v=\"2\" style=\"font-family:serif\">Засечки</button>\n"
    "      <button data-g=\"name_font\" data-v=\"3\" style=\"font-family:monospace\">Моно</button>\n"
    "      <button data-g=\"name_font\" data-v=\"4\" style=\"font-style:italic\">Курсив</button>\n"
    "      <button data-g=\"name_font\" data-v=\"5\">Узкий</button>\n"
    "      <button data-g=\"name_font\" data-v=\"6\">Свой</button>\n"
    "    </div>\n"
    "    <div class=\"btnrow\" id=\"fontPickRow\">\n"
    "      <button class=\"btn\" id=\"pick_font\">Загрузить шрифт (.ttf/.otf)</button>\n"
    "      <button class=\"btn danger\" id=\"clear_font\">Сбросить</button>\n"
    "    </div>\n"
    "    <div class=\"hint\" id=\"fontHint\">Свой шрифт виден только вам и не публикуется для подписчиков.</div>\n"
    "    <div class=\"hint\">Цвет, свечение и анимация имени в шапке профиля.</div>\n"
    "  </div>\n"
    "</div>\n"
    "  <div class=\"sec\" id=\"sec_avatar\">\n"
    "  <h3>Аватар</h3>\n"
    "  <div class=\"card\">\n"
    "    <div class=\"seg\" id=\"seg_avatar_shape\">\n"
    "      <button data-g=\"avatar_shape\" data-v=\"0\" title=\"Круг\"><svg viewBox='0 0 24 24' fill='currentColor'><circle cx='12' cy='12' r='9'/></svg></button>\n"
    "      <button data-g=\"avatar_shape\" data-v=\"1\" title=\"Скруглённый\"><svg viewBox='0 0 24 24' fill='currentColor'><rect x='3.5' y='3.5' width='17' height='17' rx='5.5'/></svg></button>\n"
    "      <button data-g=\"avatar_shape\" data-v=\"2\" title=\"Квадрат\"><svg viewBox='0 0 24 24' fill='currentColor'><rect x='3.5' y='3.5' width='17' height='17' rx='1.5'/></svg></button>\n"
    "      <button data-g=\"avatar_shape\" data-v=\"3\" title=\"Шестиугольник\"><svg viewBox='0 0 24 24' fill='currentColor'><polygon points='12,3 19.79,7.5 19.79,16.5 12,21 4.21,16.5 4.21,7.5'/></svg></button>\n"
    "      <button data-g=\"avatar_shape\" data-v=\"4\" title=\"Пятиугольник\"><svg viewBox='0 0 24 24' fill='currentColor'><polygon points='12,3 20.56,9.22 17.29,19.28 6.71,19.28 3.44,9.22'/></svg></button>\n"
    "      <button data-g=\"avatar_shape\" data-v=\"5\" title=\"Звезда\"><svg viewBox='0 0 24 24' fill='currentColor'><polygon points='12,3 14.23,8.93 20.56,9.22 15.61,13.17 17.29,19.28 12,15.8 6.71,19.28 8.39,13.17 3.44,9.22 9.77,8.93'/></svg></button>\n"
    "      <button data-g=\"avatar_shape\" data-v=\"6\" title=\"Сердце\"><svg viewBox='0 0 24 24' fill='currentColor'><path d='M12 20.3l-1.4-1.3C5.4 14.3 2 11.3 2 7.6 2 5 4 3 6.5 3c1.7 0 3.3 .9 4.2 2.3l.3 .4 .3-.4C12.2 3.9 13.8 3 15.5 3 18 3 20 5 20 7.6c0 3.7-3.4 6.7-8.6 11.4L12 20.3z'/></svg></button>\n"
    "      <button data-g=\"avatar_shape\" data-v=\"7\" title=\"Цветок\"><svg viewBox='0 0 24 24' fill='currentColor'><circle cx='12' cy='6' r='3.1'/><circle cx='17.2' cy='9' r='3.1'/><circle cx='17.2' cy='15' r='3.1'/><circle cx='12' cy='18' r='3.1'/><circle cx='6.8' cy='15' r='3.1'/><circle cx='6.8' cy='9' r='3.1'/><circle cx='12' cy='12' r='3.4'/></svg></button>\n"
    "      <button data-g=\"avatar_shape\" data-v=\"8\" title=\"Своя\"><svg viewBox='0 0 24 24' fill='currentColor'><path d='M3 17.2V21h3.8L17.8 10 14 6.2 3 17.2z'/><path d='M20.7 7.1c.4-.4 .4-1 0-1.4l-2.4-2.4c-.4-.4-1-.4-1.4 0L15 5.2 18.8 9l1.9-1.9z'/></svg></button>\n"
    "    </div>\n"
    "    <div class=\"colorRow\" id=\"avRadRow\"><div class=\"lbl\"><b>Радиус скругления</b></div>\n"
    "      <input type=\"range\" min=\"0\" max=\"64\" id=\"avRad\" class=\"rng2\"><span class=\"hex\" id=\"l_avRad\">18</span></div>\n"
    "    <div class=\"colorRow\" id=\"avAlphaRow\"><div class=\"lbl\"><b>Прозрачность</b></div>\n"
    "      <input type=\"range\" min=\"0\" max=\"100\" id=\"avAlpha\" class=\"rng2\"><span class=\"hex\" id=\"l_avAlpha\">100</span></div>\n"
    "    <div class=\"colorRow\" id=\"avDimRow\"><div class=\"lbl\"><b>Затемнение</b></div>\n"
    "      <input type=\"range\" min=\"0\" max=\"100\" id=\"avDim\" class=\"rng2\"><span class=\"hex\" id=\"l_avDim\">0%</span></div>\n"
    "    <div class=\"avfadewrap\" id=\"avFadeRow\"><div class=\"avfadeprev\" id=\"avFadePad\"><div class=\"avfadeimg\" id=\"avFadeImg\"></div></div><div class=\"avfadectr\"><div class=\"lbl\"><b>Растворение</b><span>Плавное исчезновение краёв</span></div><label class=\"mini\">Радиус</label><div class=\"rrow\"><input type=\"range\" min=\"0\" max=\"100\" id=\"avFadeRad\" class=\"rng2\"><span class=\"hex\" id=\"l_avFadeRad\">50</span></div><label class=\"mini\">Сила</label><div class=\"rrow\"><input type=\"range\" min=\"0\" max=\"100\" id=\"avFade\" class=\"rng2\"><span class=\"hex\" id=\"l_avFade\">0</span></div></div></div>\n"
    "    <div class=\"colorRow\" id=\"avRoundRow\"><div class=\"lbl\"><b>Сглаживание углов</b></div>\n"
    "      <input type=\"range\" min=\"0\" max=\"100\" id=\"avRound\" class=\"rng2\"><span class=\"hex\" id=\"l_avRound\">0</span></div>\n"
    "    <div id=\"avDrawRow\">\n"
    "      <div class=\"mini\">Нарисуйте свою форму пальцем</div>\n"
    "      <div class=\"pad\" id=\"avDraw\" style=\"width:100%;aspect-ratio:1/1;\">\n"
    "        <svg class=\"pad-svg\" id=\"avDrawSvg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\"><polygon id=\"avDrawPoly\" points=\"\" fill=\"rgba(90,175,250,.25)\" stroke=\"var(--accent)\" stroke-width=\"1.5\"></polygon></svg>\n"
    "      </div>\n"
    "      <div class=\"btnrow\"><button class=\"btn sec\" id=\"avDrawClear\">Очистить</button></div>\n"
    "      <div class=\"hint\">Обведите контур замкнутой линией — точки соединятся автоматически. Ползунок «Скругление углов» сглаживает контур.</div>\n"
    "    </div>\n"
    "    <div class=\"hint\">Форма применяется только к вашему профилю. Переоткройте профиль, чтобы увидеть изменение.</div>\n"
    "  </div>\n"
    "\n"
    "</div>\n"
    "  <div class=\"sec\" id=\"sec_thought\">\n"
    "  <div class=\"card\">\n"
    "    <div class=\"colorRow\"><div class=\"lbl\"><b>Мысль</b></div>\n"
    "      <input type=\"text\" id=\"thoughtText\" maxlength=\"80\" placeholder=\"Ваши мысли...\" style=\"flex:1;min-width:120px;background:#10161d;border:1px solid #2a3a4a;border-radius:8px;color:#e8eef4;padding:8px 10px;font-size:13px;outline:none\"></div>\n"
    "    <div class=\"colorRow\"><div class=\"lbl\"><b>Цвет текста</b></div>\n"
    "      <button class=\"sw\" id=\"sw_thought_text_color\"></button><span class=\"hex\" id=\"l_thought_text_color\"></span></div>\n"
    "    <div class=\"colorRow\"><div class=\"lbl\"><b>Цвет пузырька</b></div>\n"
    "      <button class=\"sw\" id=\"sw_thought_bg_color\"></button><span class=\"hex\" id=\"l_thought_bg_color\"></span></div>\n"
    "    <div class=\"row\"><div class=\"lbl\"><b>Шрифт как у ника</b><span>Копировать шрифт никнейма (вкл. свой загруженный)</span></div>\n"
    "      <label class=\"switch\"><input type=\"checkbox\" id=\"sw_thought_font_copy\"><span class=\"slider\"></span></label></div>\n"
    "    <div class=\"lbl\"><b>Шрифт мыслей</b></div>\n"
    "    <div class=\"seg\" id=\"seg_thought_font\">\n"
    "      <button data-g=\"thought_font\" data-v=\"0\">Стандарт</button>\n"
    "      <button data-g=\"thought_font\" data-v=\"1\" style=\"font-weight:400\">Тонкий</button>\n"
    "      <button data-g=\"thought_font\" data-v=\"2\" style=\"font-family:serif\">Засечки</button>\n"
    "      <button data-g=\"thought_font\" data-v=\"3\" style=\"font-family:monospace\">Моно</button>\n"
    "      <button data-g=\"thought_font\" data-v=\"4\" style=\"font-style:italic\">Курсив</button>\n"
    "      <button data-g=\"thought_font\" data-v=\"5\">Узкий</button>\n"
    "      <button data-g=\"thought_font\" data-v=\"6\">Свой</button>\n"
    "    </div>\n"
    "    <div class=\"btnrow\" id=\"tfontPickRow\">\n"
    "      <button class=\"btn\" id=\"pick_tfont\">Загрузить шрифт (.ttf/.otf)</button>\n"
    "      <button class=\"btn danger\" id=\"clear_tfont\">Сбросить</button>\n"
    "    </div>\n"
    "  </div>\n"
    "  </div>\n"
    "  <div class=\"sec\" id=\"sec_bg\">\n"
    "  <h3>Фон и блоки</h3>\n"
    "  <div class=\"card\">\n"
    "    <div class=\"row\"><div class=\"lbl\"><b>Включить свой фон</b><span>Общий фон за списком профиля</span></div>\n"
    "      <label class=\"switch\"><input type=\"checkbox\" id=\"sw_bg\"><span class=\"slider\"></span></label></div>\n"
    "    <div class=\"row\"><div class=\"lbl\"><b>Перекрасить блоки</b><span>Свой цвет карточек с информацией</span></div>\n"
    "      <label class=\"switch\"><input type=\"checkbox\" id=\"sw_blocks_color_enabled\"><span class=\"slider\"></span></label></div>\n"
    "    <div id=\"blocksGrp\">\n"
    "      <div class=\"colorRow\"><div class=\"lbl\"><b>Цвет блоков</b></div>\n"
    "        <button class=\"sw\" id=\"sw_blocks_color\"></button><span class=\"hex\" id=\"l_blocks_color\"></span></div>\n"
    "      <div class=\"colorRow\"><div class=\"lbl\"><b>Прозрачность блоков</b></div>\n"
    "        <input type=\"range\" min=\"10\" max=\"100\" id=\"blocksAlpha\" class=\"rng2\"><span class=\"hex\" id=\"l_blocksAlpha\">100%</span></div>\n"
    "      <div class=\"colorRow\"><div class=\"lbl\"><b>Размытие фона</b></div>\n"
    "        <input type=\"range\" min=\"0\" max=\"50\" id=\"blocksBlur\" class=\"rng2\"><span class=\"hex\" id=\"l_blocksBlur\">0</span></div>\n"
    "    </div>\n"
    "    <div id=\"bgBody\">\n"
    "      <div class=\"seg\" id=\"seg_bg_mode\">\n"
    "        <button data-g=\"bg_mode\" data-v=\"0\">Цвет</button>\n"
    "        <button data-g=\"bg_mode\" data-v=\"1\">Изображение</button>\n"
    "      </div>\n"
    "      <div id=\"bgc_color_grp\">\n"
    "        <div class=\"colorRow\"><div class=\"lbl\"><b>Цвет фона</b></div>\n"
    "          <button class=\"sw\" id=\"sw_bg_color\"></button><span class=\"hex\" id=\"l_bg_color\"></span></div>\n"
    "      </div>\n"
    "      <div id=\"bgc_img_grp\">\n"
    "        <div class=\"btnrow\">\n"
    "          <button class=\"btn\" id=\"pick_bg\">Выбрать изображение</button>\n"
    "          <button class=\"btn danger\" id=\"clear_bg\">Сбросить</button>\n"
    "        </div>\n"
    "        <div class=\"colorRow\"><div class=\"lbl\"><b>Прозрачность</b></div>\n"
    "          <input type=\"range\" min=\"0\" max=\"100\" id=\"bgAlpha\" class=\"rng2\"><span class=\"hex\" id=\"l_bgAlpha\">100%</span></div>\n"
    "        <div class=\"colorRow\"><div class=\"lbl\"><b>Затемнение</b></div>\n"
    "          <input type=\"range\" min=\"0\" max=\"100\" id=\"bgDim\" class=\"rng2\"><span class=\"hex\" id=\"l_bgDim\">0%</span></div>\n"
    "        <div class=\"seg\" id=\"seg_bg_fade\">\n"
    "          <button data-g=\"bg_fade\" data-v=\"0\">Без затухания</button>\n"
    "          <button data-g=\"bg_fade\" data-v=\"1\">Линейное</button>\n"
    "          <button data-g=\"bg_fade\" data-v=\"2\">Радиальное</button>\n"
    "        </div>\n"
    "        <div class=\"padwrap\" id=\"bgFadeRow\">\n"
    "          <div class=\"pad\" id=\"bgfpad\">\n"
    "            <svg class=\"pad-svg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\">\n"
    "              <circle class=\"pad-ringc\" id=\"bgfpadRing\" cx=\"50\" cy=\"50\" r=\"30\"></circle>\n"
    "              <line class=\"pad-linel\" id=\"bgfpadLine\" x1=\"50\" y1=\"50\" x2=\"50\" y2=\"10\"></line>\n"
    "              <circle class=\"pad-dot\" cx=\"50\" cy=\"50\" r=\"2.6\"></circle>\n"
    "            </svg>\n"
    "            <div class=\"pad-h\" id=\"bgfpadH\"></div>\n"
    "          </div>\n"
    "          <div class=\"padmeta\">\n"
    "            <div class=\"padval\"><span id=\"bgfAng\">0</span> deg &middot; <span id=\"bgfRad\">100</span>%</div>\n"
    "            <label class=\"mini\" id=\"bgfAngLbl\">Направление затухания</label>\n"
    "            <input type=\"range\" min=\"0\" max=\"360\" id=\"bgfAngR\" class=\"rng\">\n"
    "            <label class=\"mini\">Размер</label>\n"
    "            <input type=\"range\" min=\"20\" max=\"200\" id=\"bgfRadR\" class=\"rng\">\n"
    "          </div>\n"
    "        </div>\n"
    "      </div>\n"
    "    </div>\n"
    "    <div class=\"hint\">Карточки профиля имеют свой фон, поэтому цвет/картинка видны в промежутках и по краям.</div>\n"
    "  </div>\n"
    "\n"
    "</div>\n"
    "  <div class=\"sec\" id=\"sec_share\">\n"
    "  <h3>Публикация профиля</h3>\n"
    "  <div class=\"card\">\n"
    "    <div class=\"row\"><div class=\"lbl\"><b>Делиться моим профилем</b><span>Публиковать оформление на сервер</span></div>\n"
    "      <label class=\"switch\"><input type=\"checkbox\" id=\"sw_share\"><span class=\"slider\"></span></label></div>\n"
    "    <div class=\"row\"><div class=\"lbl\"><b>Оформление других</b><span>Загружать стили других пользователей при просмотре профилей</span></div>\n"
    "      <label class=\"switch\"><input type=\"checkbox\" id=\"sw_remote\"><span class=\"slider\"></span></label></div>\n"
    "    <div class=\"btnrow\"><button class=\"btn\" id=\"btn_publish\">Опубликовать мой профиль</button><div class=\"hint\" id=\"pub_offhint\" style=\"display:none;margin-top:8px\">Вы можете просто выйти из редактора</div></div>\n"
    "    <div class=\"btnrow\"><button class=\"btn\" id=\"btn_cfg_export\">Экспорт конфига</button><button class=\"btn\" id=\"btn_cfg_import\" style=\"margin-left:10px\">Импорт конфига</button></div>\n"
    "    <div class=\"hint\">Отправляет картинку баннера и настройки, чтобы другие пользователи плагина видели ваш профиль.</div>\n"
    "  </div>\n"
    "  </div>\n"
    "</div>\n"
    "\n"
    "<script>\n"
    "var INIT = /*__INIT__*/;\n"
    "var S = INIT.state;\n"
    "if(S.grad_angle==null) S.grad_angle=0;\n"
    "if(S.grad_radius==null) S.grad_radius=100;\n"
    "if(S.grad_count==null) S.grad_count=(S.grad_use3?3:2);\n"
    "if(S.grad_use3==null) S.grad_use3=(S.grad_count>=3);\n"
    "if(S.banner_alpha==null) S.banner_alpha=100;\n"
    "if(S.banner_fade==null) S.banner_fade=0;\n"
    "if(S.banner_fade_angle==null) S.banner_fade_angle=0;\n"
