*100).toFixed(2)+\"% \"+(p[1]*100).toFixed(2)+\"%\"; }).join(\", \")+\")\"; }catch(e){ return \"\"; } }\n"
    "function sqPad(){ try{ var pad=$(\"avDraw\"); if(!pad) return; var w=pad.getBoundingClientRect().width; if(w>0) pad.style.height=w+\"px\"; }catch(e){} }\n"
    "var __lastPad=\"\";\n"
    "function reportPadRect(){ try{ var pad=$(\"avDraw\"); var _v=pad && pad.offsetParent!==null; if(!_v){ if(__lastPad!==\"none\"){ __lastPad=\"none\"; bridge(\"cpb://padrect\"); } return; } var r=pad.getBoundingClientRect(); var dpr=window.devicePixelRatio||1; var x=Math.round(r.left*dpr), y=Math.round(r.top*dpr), w=Math.round(r.width*dpr), h=Math.round(r.height*dpr); var key=x+\"_\"+y+\"_\"+w+\"_\"+h; if(key===__lastPad) return; __lastPad=key; bridge(\"cpb://padrect?x=\"+x+\"&y=\"+y+\"&w=\"+w+\"&h=\"+h); }catch(e){} }\n"
    "function initDraw(){ var pad=$(\"avDraw\"); if(!pad) return; var poly=$(\"avDrawPoly\"); var drawing=false, pts=[]; function norm(cx,cy){ var r=pad.getBoundingClientRect(); if(!r.width||!r.height) return [0,0]; var x=(cx-r.left)/r.width, y=(cy-r.top)/r.height; return [Math.max(0,Math.min(1,x)), Math.max(0,Math.min(1,y))]; } function redraw(){ if(poly) poly.setAttribute(\"points\", pts.map(function(p){ return (p[0]*100)+\",\"+(p[1]*100); }).join(\" \")); } function start(cx,cy){ drawing=true; pts=[norm(cx,cy)]; redraw(); } function move(cx,cy){ if(!drawing) return; var p=norm(cx,cy); var l=pts[pts.length-1]; var dx=p[0]-l[0], dy=p[1]-l[1]; if(dx*dx+dy*dy<0.0006) return; pts.push(p); redraw(); } function end(){ if(!drawing) return; drawing=false; var q=pts; if(q.length>48){ var out=[]; var step=q.length/48; for(var i=0;i<48;i++){ out.push(q[Math.floor(i*step)]); } q=out; } if(q.length>=3){ pts=q; redraw(); S.avatar_custom=JSON.stringify(q.map(function(p){ return [Math.round(p[0]*1000)/1000, Math.round(p[1]*1000)/1000]; })); render(); sync(); } } if(window.PointerEvent){ pad.addEventListener(\"pointerdown\", function(e){ start(e.clientX,e.clientY); e.preventDefault(); e.stopPropagation(); }); window.addEventListener(\"pointermove\", function(e){ if(drawing){ move(e.clientX,e.clientY); e.preventDefault(); } }, {passive:false}); window.addEventListener(\"pointerup\", function(){ end(); }); window.addEventListener(\"pointercancel\", function(){ end(); }); } else { pad.addEventListener(\"touchstart\", function(e){ var t=e.touches[0]; if(!t) return; start(t.clientX,t.clientY); e.preventDefault(); e.stopPropagation(); }, {passive:false}); window.addEventListener(\"touchmove\", function(e){ if(drawing){ var t=e.touches[0]; if(t){ move(t.clientX,t.clientY); e.preventDefault(); } } }, {passive:false}); window.addEventListener(\"touchend\", function(){ end(); }); } var cb=$(\"avDrawClear\"); if(cb) cb.addEventListener(\"click\", function(){ pts=[]; redraw(); S.avatar_custom=\"\"; render(); sync(); }); (function(){ try{ var arr=JSON.parse(S.avatar_custom||\"[]\"); if(arr&&arr.length){ pts=arr.map(function(p){ return [p[0],p[1]]; }); redraw(); } }catch(e){} })(); }\n"
    "function applyAvatar(){ var a=$(\"phAvatar\"); if(!a) return; a.style.opacity=(S.avatar_alpha==null?1:(Math.max(0,Math.min(100,S.avatar_alpha))/100)); a.style.filter=\"brightness(\"+((100-(S.avatar_dim||0))/100)+\")\"; var _fd=(S.avatar_fade==null?0:Math.max(0,Math.min(100,S.avatar_fade))); if(_fd>0){ var _rr=(S.avatar_fade_radius==null?50:Math.max(0,Math.min(100,S.avatar_fade_radius))); var _in=Math.max(2,Math.min(98,_rr)); var _ea=(1-_fd/100); var _mg=\"radial-gradient(circle at 50% 50%, rgba(0,0,0,1) \"+_in+\"%, rgba(0,0,0,\"+_ea+\") 100%)\"; a.style.webkitMaskImage=_mg; a.style.maskImage=_mg; } else { a.style.webkitMaskImage=\"\"; a.style.maskImage=\"\"; } a.style.clipPath=\"\"; a.style.webkitClipPath=\"\"; a.style.borderRadius=\"50%\"; var s=S.avatar_shape; if(s==2){ a.style.borderRadius=\"0\"; } else if(s==1){ a.style.borderRadius=(S.avatar_radius||0)+\"px\"; } else if(s>=3){ a.style.borderRadius=\"0\"; var cp=\"\"; if(s==8){ cp=customClip(); } else if(typeof AV_CLIP!==\"undefined\"){ cp=AV_CLIP[s]; } if(cp){ a.style.clipPath=cp; a.style.webkitClipPath=cp; } } }\n"
    "function bindNum(id, field, lab, suf){\n"
    "  var e=$(id); if(!e) return; var cur=(S[field]==null?0:S[field]); e.value=cur;\n"
    "  var l=$(lab); if(l) l.textContent=cur+(suf||\"\");\n"
    "  e.addEventListener(\"input\", function(){ S[field]=parseInt(this.value)||0;\n"
    "    if(l) l.textContent=S[field]+(suf||\"\"); render(); sync(); });\n"
    "}\n"
    "function nameEl(){\n"
    "  var e=$(\"phName\"); if(!e){ try{ e=document.querySelector(\".tgp-name\"); }catch(err){ e=null; } }\n"
    "  return e;\n"
    "}\n"
    "function applyNameFx(){\n"
    "  var e=nameEl(); if(!e) return;\n"
    "  var base = S.name_color_enabled ? css(S.name_color) : \"#ffffff\";\n"
    "  var gr = S.name_glow_radius||0;\n"
    "  var gs = (S.name_glow_strength==null?100:S.name_glow_strength)/100;\n"
    "  var gcol = glowCss(S.name_color_enabled ? S.name_color : \"#FFFFFFFF\", gs);\n"
    "  e.style.textShadow = (S.name_glow_enabled && gr>0 && gs>0) ? ((\"0 0 \"+gr+\"px \"+gcol)+\", 0 0 \"+(gr*2)+\"px \"+gcol) : \"\";\n"
    "  e.classList.remove(\"fxgrad\"); e.style.animation=\"\"; e.style.backgroundImage=\"\";\n"
    "  var sp=(S.name_fx_speed||100)/100; if(sp<=0.05) sp=1;\n"
    "  var dur=(3/sp).toFixed(2)+\"s\";\n"
    "  var fx=parseInt(S.name_fx)||0;\n"
    "  if(fx==1){ e.style.animation=\"cpbPulse \"+dur+\" ease-in-out infinite\"; }\n"
    "  else if(fx==2){ e.style.backgroundImage=\"linear-gradient(90deg,\"+css(S.name_grad_c1)+\",\"+css(S.name_grad_c2)+\",\"+css(S.name_grad_c1)+\")\";\n"
    "    e.classList.add(\"fxgrad\"); e.style.animation=\"cpbSlide \"+dur+\" linear infinite\"; }\n"
    "  else if(fx==3){ e.style.backgroundImage=\"linear-gradient(90deg,\"+base+\" 38%,#ffffff 50%,\"+base+\" 62%)\";\n"
    "    e.classList.add(\"fxgrad\"); e.style.animation=\"cpbSlide \"+dur+\" linear infinite\"; }\n"
    "  else if(fx==4){ e.style.backgroundImage=\"linear-gradient(90deg,#ff3b30,#ff9500,#ffcc00,#34c759,#00c7be,#0a84ff,#af52de,#ff3b30)\";\n"
    "    e.classList.add(\"fxgrad\"); e.style.animation=\"cpbSlide \"+dur+\" linear infinite\"; }\n"
    "  else if(fx==5){ var nc=gcol; var nr=Math.max(gr||0,10);\n"
    "    e.style.textShadow=\"0 0 \"+nr+\"px \"+nc+\", 0 0 \"+(nr*2)+\"px \"+nc; e.style.animation=\"cpbFlicker \"+dur+\" linear infinite\"; }\n"
    "  else if(fx==6){ e.style.backgroundImage=\"linear-gradient(90deg,#ff3b30,#ff9500,#ffe04d,#ff9500,#ff3b30)\";\n"
    "    e.classList.add(\"fxgrad\"); e.style.animation=\"cpbSlide \"+dur+\" linear infinite\"; }\n"
    "  else if(fx==7){ e.style.backgroundImage=\"linear-gradient(90deg,#ffffff,#7fdbff,#3390ec,#7fdbff,#ffffff)\";\n"
    "    e.classList.add(\"fxgrad\"); e.style.animation=\"cpbSlide \"+dur+\" linear infinite\"; }\n"
    "}\n"
    "function applyNameColor(){\n"
    "  var e=$(\"phName\"); if(!e){ try{ e=document.querySelector(\".tgp-name\"); }catch(err){ e=null; } }\n"
    "  if(!e) return;\n"
    "  if(S.name_color_enabled){ e.style.color=css(S.name_color); } else { e.style.color=\"\"; }\n"
    "}\n"
    "function vis(){\n"
    "  show(\"bannerBody\", S.banner_enabled);\n"
    "  show(\"nameColorRow\", !!S.name_color_enabled);\n"
    "  show(\"nameGlowStrRow\", !!S.name_glow_enabled);\n"
    "  show(\"nameGlowRadRow\", !!S.name_glow_enabled);\n"
    "  show(\"nameGradGrp\", parseInt(S.name_fx)==2);\n"
    "  show(\"nameFxSpeedRow\", (parseInt(S.name_fx)||0)>0);\n"
    "  var _nga=(parseInt(S.name_fx)||0); show(\"nameGradAngRow\", _nga>=2&&_nga!=5);\n"
    "  show(\"fontPickRow\", (parseInt(S.name_font)||0)==6); show(\"fontHint\", (parseInt(S.name_font)||0)==6);\n"
    "  show(\"tfontPickRow\", (parseInt(S.thought_font)||0)==6 && !S.thought_font_copy);\n"
    "  show(\"ban_img_grp\", S.banner_mode==0);\n"
    "  show(\"ban_color_grp\", S.banner_mode==1);\n"
    "  show(\"ban_grad_grp\", S.banner_mode==2);\n"
    "  show(\"gpAngLbl\", S.grad_type!=1); show(\"gpAngR\", S.grad_type!=1);\n"
    "  show(\"grad_c3_row\", S.grad_count>=3);\n"
    "  show(\"banFadeRow\", S.banner_fade!=0);\n"
    "  show(\"bfAngLbl\", S.banner_fade==1); show(\"bfAngR\", S.banner_fade==1);\n"
    "  show(\"bgBody\", S.bg_enabled);\n"
    "  show(\"blocksGrp\", !!S.blocks_color_enabled);\n"
    "  show(\"bgc_color_grp\", S.bg_mode==0);\n"
    "  show(\"bgc_img_grp\", S.bg_mode==1);\n"
    "  show(\"bgFadeRow\", S.bg_fade!=0);\n"
    "  show(\"bgfAngLbl\", S.bg_fade==1); show(\"bgfAngR\", S.bg_fade==1);\n"
    "  show(\"avRadRow\", S.avatar_shape==1);\n"
    "  show(\"avRoundRow\", S.avatar_shape>=3);\n"
    "  show(\"avDrawRow\", S.avatar_shape==8);\n"
    "  if(S.avatar_shape==8){ sqPad(); }\n"
    "  applyNameColor();\n"
    "  applyNameFx();\n"
    "  reportPadRect();\n"
    "}\n"
    "function paintRange(el){ if(!el) return; if(el.id===\"cpHue\"||el.id===\"cpAlpha\") return; var mn=parseFloat(el.min); if(isNaN(mn)) mn=0; var mx=parseFloat(el.max); if(isNaN(mx)) mx=100; var v=parseFloat(el.value); if(isNaN(v)) v=mn; var p=(mx>mn)?((v-mn)*100/(mx-mn)):0; if(p<0)p=0; if(p>100)p=100; el.style.background=\"linear-gradient(90deg, var(--accent) 0%, var(--accent) \"+p+\"%, rgba(128,128,128,.28) \"+p+\"%, rgba(128,128,128,.28) 100%)\"; }\n"
    "function paintAllRanges(){ try{ var a=document.querySelectorAll(\"input[type=range]\"); for(var i=0;i<a.length;i++) paintRange(a[i]); }catch(e){} }\n"
    "document.addEventListener(\"input\", function(e){ if(e && e.target && e.target.type===\"range\") paintRange(e.target); }, true);\n"
    "function applyAvFade(){ var im=$(\"avFadeImg\"); if(!im) return; if(IMG.avatar){ im.style.backgroundImage=\"url('\"+IMG.avatar+\"')\"; } else { im.style.backgroundImage=\"\"; } var st=(S.avatar_fade==null?0:Math.max(0,Math.min(100,S.avatar_fade))); var rd=(S.avatar_fade_radius==null?50:Math.max(0,Math.min(100,S.avatar_fade_radius))); if(st>0){ var _in=Math.max(2,Math.min(98,rd)); var ea=(1-st/100); var _mg=\"radial-gradient(circle at 50% 50%, rgba(0,0,0,1) \"+_in+\"%, rgba(0,0,0,\"+ea+\") 100%)\"; im.style.webkitMaskImage=_mg; im.style.maskImage=_mg; } else { im.style.webkitMaskImage=\"\"; im.style.maskImage=\"\"; } }\n"
    "function render(){ vis(); applyBanner(); applyBg(); applyAvatar(); applyAvFade(); refreshPadTextures(); paintAllRanges(); for(var i=0;i<padRefreshers.length;i++){ try{ padRefreshers[i](); }catch(e){} } scheduleHeight(); }\n"
    "\n"
    "var pend=false;\n"
    "function sync(){ if(pend) return; pend=true; requestAnimationFrame(function(){ pend=false; doSync(); }); }\n"
    "function doSync(){\n"
    "  var p={ banner_enabled:S.banner_enabled?1:0, show_emoji:S.show_emoji?1:0, name_color_enabled: S.name_color_enabled?1:0, name_color: S.name_color, name_glow_enabled: S.name_glow_enabled?1:0, name_glow_color: S.name_glow_color, name_glow_radius: S.name_glow_radius, name_glow_strength: S.name_glow_strength, name_fx: S.name_fx, name_fx_speed: S.name_fx_speed, name_grad_c1: S.name_grad_c1, name_grad_c2: S.name_grad_c2, name_grad_angle: S.name_grad_angle, name_size: S.name_size, name_font: S.name_font, avatar_shape:S.avatar_shape, avatar_radius:S.avatar_radius, avatar_round:S.avatar_round, avatar_alpha:S.avatar_alpha, avatar_dim:S.avatar_dim, avatar_fade:S.avatar_fade, avatar_fade_radius:S.avatar_fade_radius, avatar_custom:S.avatar_custom, thought_text:(S.thought_text||''), thought_text_color:S.thought_text_color, thought_bg_color:S.thought_bg_color, thought_font:S.thought_font, thought_font_copy:S.thought_font_copy?1:0, banner_mode:S.banner_mode,\n"
    "    banner_color:S.banner_color, grad_type:S.grad_type, grad_dir:S.grad_dir, grad_angle:S.grad_angle,\n"
    "    grad_radius:S.grad_radius, grad_count:S.grad_count, grad_cx:S.grad_cx, grad_cy:S.grad_cy,\n"
    "    grad_c1:S.grad_c1, grad_c2:S.grad_c2, grad_c3:S.grad_c3, grad_use3:(S.grad_count>=3)?1:0,\n"
    "    banner_alpha:S.banner_alpha, banner_dim:S.banner_dim, banner_fade:S.banner_fade, banner_fade_angle:S.banner_fade_angle, banner_fade_radius:S.banner_fade_radius, banner_fade_cx:S.banner_fade_cx, banner_fade_cy:S.banner_fade_cy,\n"
    "    bg_enabled:S.bg_enabled?1:0, bg_mode:S.bg_mode, bg_color:S.bg_color, blocks_color_enabled:S.blocks_color_enabled?1:0, blocks_color:S.blocks_color, blocks_alpha:S.blocks_alpha, blocks_blur:S.blocks_blur, blocks_depth:S.blocks_depth,\n"
    "    bg_alpha:S.bg_alpha, bg_dim:S.bg_dim, bg_fade:S.bg_fade, bg_fade_angle:S.bg_fade_angle, bg_fade_radius:S.bg_fade_radius, bg_fade_cx:S.bg_fade_cx, bg_fade_cy:S.bg_fade_cy };\n"
    "  var qs=Object.keys(p).map(function(k){ return k+\"=\"+encodeURIComponent(p[k]); }).join(\"&\");\n"
    "  bridge(\"cpb://apply?\"+qs);\n"
    "}\n"
    "function cmd(u){ bridge(u); }\n"
    "\n"
    "function markSeg(g){\n"
    "  var list=document.querySelectorAll('.seg button[data-g=\"'+g+'\"]');\n"
    "  for(var i=0;i<list.length;i++){ var b=list[i]; b.classList.toggle(\"active\", parseInt(b.getAttribute(\"data-v\"))===S[g]); }\n"
    "}\n"
    "function initSeg(){\n"
    "  var btns=document.querySelectorAll(\".seg button\");\n"
    "  for(var i=0;i<btns.length;i++){\n"
    "    (function(btn){\n"
    "      btn.addEventListener(\"click\", function(){\n"
    "        var g=btn.getAttribute(\"data-g\"); S[g]=parseInt(btn.getAttribute(\"data-v\"));\n"
    "        if(g===\"grad_count\") S.grad_use3=(S.grad_count>=3);\n"
    "        markSeg(g); render(); sync();\n"
    "      });\n"
    "    })(btns[i]);\n"
    "  }\n"
    "  [\"banner_mode\",\"grad_type\",\"bg_mode\",\"grad_count\",\"banner_fade\",\"bg_fade\",\"avatar_shape\",\"name_fx\"].forEach(markSeg);\n"
    "}\n"
    "function bindSwitch(id, field){\n"
    "  var e=$(id); if(!e) return; e.checked=!!S[field];\n"
    "  e.addEventListener(\"change\", function(){ S[field]=e.checked; render(); sync(); });\n"
    "}\n"
    "function bindAlpha(id, field, lab){\n"
    "  var e=$(id); if(!e) return; var cur=(S[field]==null?100:S[field]); e.value=cur;\n"
    "  var l=$(lab); if(l) l.textContent=cur+\"%\";\n"
    "  e.addEventListener(\"input\", function(){ S[field]=parseInt(this.value)||0; if(l) l.textContent=S[field]+\"%\"; render(); sync(); });\n"
    "}\n"
    "function bindBlur(id, field, lab){\n"
    "  var e=$(id); if(!e) return; var cur=(S[field]==null?0:S[field]); e.value=cur;\n"
    "  var l=$(lab); if(l) l.textContent=cur;\n"
    "  e.addEventListener(\"input\", function(){ S[field]=parseInt(this.value)||0; if(l) l.textContent=S[field]; render(); sync(); });\n"
    "}\n"
    "function bindDepth(id, field, lab){\n"
    "  var e=$(id); if(!e) return; var cur=(S[field]==null?4:S[field]); e.value=cur;\n"
    "  var l=$(lab); if(l) l.textContent=cur;\n"
    "  e.addEventListener(\"input\", function(){ S[field]=parseInt(this.value)||1; if(l) l.textContent=S[field]; render(); sync(); });\n"
    "}\n"
    "function bindColor(name){\n"
    "  var sw=$(\"sw_\"+name), lab=$(\"l_\"+name);\n"
    "  function refresh(){ if(sw) sw.style.setProperty(\"--c\", css(S[name])); if(lab) lab.textContent=S[name]; }\n"
    "  colorRefreshers[name]=refresh; refresh();\n"
    "  if(sw) sw.addEventListener(\"click\", function(){ openPicker(name); });\n"
    "}\n"
    "function hsv2rgb(h,s,v){ h=(h%360+360)%360; s=s/100; v=v/100;\n"
    "  var c=v*s, x=c*(1-Math.abs((h/60)%2-1)), m=v-c, r=0,g=0,b=0;\n"
    "  if(h<60){r=c;g=x;} else if(h<120){r=x;g=c;} else if(h<180){g=c;b=x;}\n"
    "  else if(h<240){g=x;b=c;} else if(h<300){r=x;b=c;} else {r=c;b=x;}\n"
    "  return [Math.round((r+m)*255),Math.round((g+m)*255),Math.round((b+m)*255)]; }\n"
    "function rgb2hsv(r,g,b){ r/=255;g/=255;b/=255; var mx=Math.max(r,g,b),mn=Math.min(r,g,b),d=mx-mn,h=0;\n"
    "  if(d){ if(mx===r) h=((g-b)/d)%6; else if(mx===g) h=(b-r)/d+2; else h=(r-g)/d+4; h*=60; if(h<0)h+=360; }\n"
    "  var s=mx?d/mx:0; return [h, s*100, mx*100]; }\n"
    "function hx2(n){ n=Math.max(0,Math.min(255,n|0)); var h=n.toString(16).toUpperCase(); return h.length<2?\"0\"+h:h; }\n"
    "function parseArgb(str){ str=(str||\"\").trim(); if(str.charAt(0)===\"#\") str=str.slice(1);\n"
    "  var a=255,r=0,g=0,b=0;\n"
    "  if(str.length===8){ a=parseInt(str.slice(0,2),16); r=parseInt(str.slice(2,4),16); g=parseInt(str.slice(4,6),16); b=parseInt(str.slice(6,8),16); }\n"
    "  else if(str.length===6){ r=parseInt(str.slice(0,2),16); g=parseInt(str.slice(2,4),16); b=parseInt(str.slice(4,6),16); }\n"
    "  else return null;\n"
    "  if([a,r,g,b].some(isNaN)) return null; return [a,r,g,b]; }\n"
    "function argbStr(a,r,g,b){ return \"#\"+hx2(a)+hx2(r)+hx2(g)+hx2(b); }\n"
    "var CP={name:null,h:0,s:100,v:100,a:255};\n"
    "function ensurePicker(){ if($(\"cpDim\")) return;\n"
    "  var html='<div id=\"cpDim\" class=\"cp-dim\"><div class=\"cp\">'\n"
    "    +'<div class=\"cp-sv\" id=\"cpSV\"><div class=\"cp-thumb\" id=\"cpThumb\"></div></div>'\n"
    "    +'<input type=\"range\" min=\"0\" max=\"360\" id=\"cpHue\">'\n"
    "    +'<div class=\"cp-alpha\" id=\"cpAlphaBox\"><input type=\"range\" min=\"0\" max=\"255\" id=\"cpAlpha\"></div>'\n"
    "    +'<div class=\"cp-foot\"><span class=\"cp-prev\" id=\"cpPrev\"></span>'\n"
    "    +'<input class=\"cp-hex\" id=\"cpHex\" maxlength=\"9\" spellcheck=\"false\">'\n"
    "    +'<button class=\"btn\" id=\"cpDone\">OK</button></div></div></div>';\n"
    "  document.body.insertAdjacentHTML(\"beforeend\", html);\n"
    "  bindDrag($(\"cpSV\"), function(px,py){ CP.s=Math.max(0,Math.min(1,px))*100; CP.v=(1-Math.max(0,Math.min(1,py)))*100; cpFromHSV(true); });\n"
    "  $(\"cpHue\").addEventListener(\"input\", function(){ CP.h=parseInt(this.value); cpFromHSV(true); });\n"
    "  $(\"cpAlpha\").addEventListener(\"input\", function(){ CP.a=parseInt(this.value); cpFromHSV(true); });\n"
    "  $(\"cpHex\").addEventListener(\"change\", function(){ var p=parseArgb(this.value); if(p){ var hsv=rgb2hsv(p[1],p[2],p[3]); CP.a=p[0]; CP.h=hsv[0]; CP.s=hsv[1]; CP.v=hsv[2]; cpSync(); cpFromHSV(true); } });\n"
    "  $(\"cpDone\").addEventListener(\"click\", closePicker);\n"
    "  $(\"cpDim\").addEventListener(\"click\", function(e){ if(e.target===$(\"cpDim\")) closePicker(); });\n"
    "}\n"
    "function openPicker(name){ ensurePicker(); CP.name=name; var p=parseArgb(S[name])||[255,0,0,0];\n"
    "  var hsv=rgb2hsv(p[1],p[2],p[3]); CP.a=p[0]; CP.h=hsv[0]; CP.s=hsv[1]; CP.v=hsv[2];\n"
    "  cpSync(); cpFromHSV(false); $(\"cpDim\").classList.add(\"on\"); }\n"
    "function closePicker(){ var d=$(\"cpDim\"); if(d) d.classList.remove(\"on\"); }\n"
    "function cpSync(){ var hu=$(\"cpHue\"); if(hu) hu.value=Math.round(CP.h); var al=$(\"cpAlpha\"); if(al) al.value=Math.round(CP.a); }\n"
    "function cpFromHSV(push){\n"
    "  var rgb=hsv2rgb(CP.h,CP.s,CP.v), r=rgb[0], g=rgb[1], b=rgb[2];\n"
    "  var sv=$(\"cpSV\"); if(sv) sv.style.background=\"linear-gradient(to top,#000,rgba(0,0,0,0)),linear-gradient(to right,#fff,rgba(255,255,255,0)),hsl(\"+CP.h+\",100%,50%)\";\n"
    "  var th=$(\"cpThumb\"); if(th){ th.style.left=CP.s+\"%\"; th.style.top=(100-CP.v)+\"%\"; }\n"
    "  var box=$(\"cpAlphaBox\"); if(box) box.style.setProperty(\"--ac\",\"rgb(\"+r+\",\"+g+\",\"+b+\")\");\n"
    "  var full=argbStr(CP.a,r,g,b);\n"
    "  var pv=$(\"cpPrev\"); if(pv) pv.style.setProperty(\"--pc\", css(full));\n"
    "  var hex=$(\"cpHex\"); if(hex && document.activeElement!==hex) hex.value=full;\n"
    "  if(CP.name){ S[CP.name]=full; var rf=colorRefreshers[CP.name]; if(rf) rf(); render(); if(push) sync(); }\n"
    "}\n"
    "function bindDrag(el, cb){\n"
    "  if(!el) return;\n"
    "  var down=false;\n"
    "  el.style.touchAction=\"none\";\n"
    "  function pt(cx,cy){ var r=el.getBoundingClientRect(); cb((cx-r.left)/r.width, (cy-r.top)/r.height); }\n"
    "  if(window.PointerEvent){\n"
    "    el.addEventListener(\"pointerdown\", function(e){ down=true; pt(e.clientX,e.clientY); e.preventDefault(); e.stopPropagation(); });\n"
    "    window.addEventListener(\"pointermove\", function(e){ if(down){ pt(e.clientX,e.clientY); e.preventDefault(); } }, {passive:false});\n"
    "    window.addEventListener(\"pointerup\", function(){ down=false; });\n"
    "    window.addEventListener(\"pointercancel\", function(){ down=false; });\n"
    "  } else {\n"
    "    el.addEventListener(\"touchstart\", function(e){ var t=e.touches[0]; if(!t) return; down=true; pt(t.clientX,t.clientY); e.preventDefault(); e.stopPropagation(); }, {passive:false});\n"
    "    window.addEventListener(\"touchmove\", function(e){ if(down){ var t=e.touches[0]; if(t){ pt(t.clientX,t.clientY); e.preventDefault(); } } }, {passive:false});\n"
    "    window.addEventListener(\"touchend\", function(){ down=false; });\n"
    "    window.addEventListener(\"touchcancel\", function(){ down=false; });\n"
    "    el.addEventListener(\"mousedown\", function(e){ down=true; pt(e.clientX,e.clientY); e.preventDefault(); });\n"
    "    window.addEventListener(\"mousemove\", function(e){ if(down){ pt(e.clientX,e.clientY); e.preventDefault(); } });\n"
    "    window.addEventListener(\"mouseup\", function(){ down=false; });\n"
    "  }\n"
    "}\n"
    "function padLayer(pad,cls){ var el=pad.querySelector(\".\"+cls); if(!el){ el=document.createElement(\"div\"); el.className=cls; pad.insertBefore(el, pad.firstChild); } return el; }\n"
    "function setPadFade(id, mode, ang, rad, cx, cy){ var pad=$(id); if(!pad) return; var fl=padLayer(pad,\"pad-fade\"); if(!mode){ fl.style.background=\"transparent\"; return; } var rr=Math.max(20,Math.min(200,rad))/100; var DARK=\"rgba(0,0,0,.85)\"; if(mode==2){ var pp=Math.max(3, Math.min(160, 50*rr)); fl.style.background=\"radial-gradient(ellipse \"+pp+\"% \"+pp+\"% at \"+(cx*100)+\"% \"+(cy*100)+\"%, rgba(0,0,0,0) 0%, \"+DARK+\" 100%)\"; } else { var rd=ang*Math.PI/180, ux=Math.sin(rd), uy=-Math.cos(rd); var off=(cx-0.5)*ux+(cy-0.5)*uy; var mid=50+off*100; var half=Math.max(4, 50*rr); var a=Math.max(0, mid-half), b=Math.min(100, mid+half); if(b<=a) b=a+1; fl.style.background=\"linear-gradient(\"+ang+\"deg, rgba(0,0,0,0) \"+a+\"%, \"+DARK+\" \"+b+\"%)\"; } }\n"
    "function setPadTex(id,uri,useRatio){ var pad=$(id); if(!pad) return; if(pad.__tex===uri) return; pad.__tex=uri; if(uri){ pad.style.backgroundImage=\"url('\"+uri+\"')\"; pad.style.backgroundSize=\"cover\"; pad.style.backgroundPosition=\"center\"; if(useRatio){ var im=new Image(); im.onload=function(){ if(im.naturalWidth>0&&im.naturalHeight>0){ pad.style.height=\"auto\"; pad.style.aspectRatio=(im.naturalWidth/im.naturalHeight); scheduleHeight(); } }; im.src=uri; } } else { pad.style.backgroundImage=\"\"; pad.style.backgroundSize=\"\"; pad.style.backgroundPosition=\"\"; if(useRatio){ pad.style.aspectRatio=\"\"; pad.style.height=\"\"; } } }\n"
    "function refreshPadTextures(){ try{ setPadTex(\"bfpad\", IMG.banner||\"\", true); }catch(e){} try{ setPadTex(\"bgfpad\", IMG.bg||\"\", true); }catch(e){} try{ setPadTex(\"avDraw\", IMG.avatar||\"\", false); }catch(e){} }\n"
    "function makePad(o){\n"
    "  function ref(){\n"
    "    var ang=(S[o.af]==null?0:S[o.af]), rad=(S[o.rf]==null?100:S[o.rf]);\n"
    "    var radial=o.isRadial();\n"
    "    var frac=Math.min(1, rad/200), R=46;\n"
    "    var cx=(o.cxf&&S[o.cxf]!=null?S[o.cxf]:0.5), cy=(o.cyf&&S[o.cyf]!=null?S[o.cyf]:0.5);\n"
    "    var ccx=cx*100, ccy=cy*100;\n"
    "    var rr=ang*Math.PI/180, ux=Math.sin(rr), uy=-Math.cos(rr);\n"
    "    var hx, hy;\n"
    "    if(radial){ hx=ccx; hy=ccy; } else if(o.centerDrag){ hx=ccx; hy=ccy; } else { hx=50+ux*frac*R; hy=50+uy*frac*R; }\n"
    "    if(o.hand){ o.hand.style.left=hx+\"%\"; o.hand.style.top=hy+\"%\"; }\n"
    "    if(o.line){ o.line.style.display=radial?\"none\":\"\"; if(!radial){ var lbx=o.centerDrag?ccx:50, lby=o.centerDrag?ccy:50; o.line.setAttribute(\"x1\",(lbx-ux*frac*R)); o.line.setAttribute(\"y1\",(lby-uy*frac*R)); o.line.setAttribute(\"x2\",(lbx+ux*frac*R)); o.line.setAttribute(\"y2\",(lby+uy*frac*R)); } }\n"
    "    if(o.ring){ o.ring.style.display=radial?\"\":\"none\"; if(radial){ o.ring.setAttribute(\"cx\",ccx); o.ring.setAttribute(\"cy\",ccy); o.ring.setAttribute(\"r\",(frac*R)); } }\n"
    "    if(o.angEl) o.angEl.textContent=Math.round(ang);\n"
    "    if(o.radEl) o.radEl.textContent=Math.round(rad);\n"
    "    if(o.angR && +o.angR.value!==Math.round(ang)) o.angR.value=Math.round(ang);\n"
    "    if(o.radR && +o.radR.value!==Math.round(rad)) o.radR.value=Math.round(rad);\n"
    "    if(o.angR) paintRange(o.angR);\n"
    "    if(o.radR) paintRange(o.radR);\n"
    "    if(o.onRef) o.onRef(ang,rad,radial,frac,ux,uy,R,cx,cy);\n"
    "  }\n"
    "  if(o.pad) bindDrag(o.pad, function(px,py){\n"
    "    if(o.cxf && (o.centerDrag || o.isRadial())){\n"
    "      S[o.cxf]=Math.max(0, Math.min(1, px));\n"
    "      S[o.cyf]=Math.max(0, Math.min(1, py));\n"
    "    } else {\n"
    "      var x=px-0.5, y=py-0.5;\n"
    "      var ang=Math.atan2(x,-y)*180/Math.PI; if(ang<0) ang+=360;\n"
    "      var d=Math.min(0.5, Math.sqrt(x*x+y*y))/0.5;\n"
    "      S[o.af]=Math.round(ang);\n"
    "      S[o.rf]=Math.max(20, Math.min(200, Math.round(d*200)));\n"
    "    }\n"
    "    ref(); render(); sync();\n"
    "  });\n"
    "  if(o.angR) o.angR.addEventListener(\"input\", function(){ S[o.af]=parseInt(this.value)||0; ref(); render(); sync(); });\n"
    "  if(o.radR) o.radR.addEventListener(\"input\", function(){ S[o.rf]=parseInt(this.value)||100; ref(); render(); sync(); });\n"
    "  padRefreshers.push(ref);\n"
    "  return ref;\n"
    "}\n"
    "function gradStops(ang,rad,radial,frac,ux,uy,R,cx,cy){\n"
    "  var count=(S.grad_count>=3?3:2);\n"
    "  var cs=[S.grad_c1,S.grad_c2,S.grad_c3];\n"
    "  var ids=[\"gs0\",\"gs1\",\"gs2\"];\n"
    "  var ccx=(cx==null?0.5:cx)*100, ccy=(cy==null?0.5:cy)*100;\n"
    "  var sx=50-ux*frac*R, sy=50-uy*frac*R, ex=50+ux*frac*R, ey=50+uy*frac*R;\n"
    "  for(var i=0;i<3;i++){ var el=$(ids[i]); if(!el) continue;\n"
    "    if(i>=count){ el.style.display=\"none\"; continue; } el.style.display=\"\";\n"
    "    var t=count>1?i/(count-1):0, x, y;\n"
    "    if(radial){ x=ccx+ux*t*frac*R; y=ccy+uy*t*frac*R; }\n"
    "    else { x=sx+(ex-sx)*t; y=sy+(ey-sy)*t; }\n"
    "    el.setAttribute(\"cx\",x); el.setAttribute(\"cy\",y); el.setAttribute(\"fill\", css(cs[i]));\n"
    "  }\n"
    "}\n"
    "function initGradPad(){\n"
    "  makePad({ pad:$(\"gpad\"), hand:$(\"gpadH\"), line:$(\"gpadLine\"), ring:$(\"gpadRing\"),\n"
    "    angEl:$(\"gpAng\"), radEl:$(\"gpRad\"), angR:$(\"gpAngR\"), radR:$(\"gpRadR\"),\n"
    "    af:\"grad_angle\", rf:\"grad_radius\", cxf:\"grad_cx\", cyf:\"grad_cy\", isRadial:function(){ return S.grad_type==1; }, onRef:gradStops });\n"
    "}\n"
    "function initFadePads(){\n"
    "  makePad({ pad:$(\"bfpad\"), hand:$(\"bfpadH\"), line:$(\"bfpadLine\"), ring:$(\"bfpadRing\"),\n"
    "    angEl:$(\"bfAng\"), radEl:$(\"bfRad\"), angR:$(\"bfAngR\"), radR:$(\"bfRadR\"),\n"
    "    af:\"banner_fade_angle\", rf:\"banner_fade_radius\", cxf:\"banner_fade_cx\", cyf:\"banner_fade_cy\", isRadial:function(){ return S.banner_fade==2; }, centerDrag:true, onRef:function(a,r,radial,frac,ux,uy,R,cx,cy){ setPadFade(\"bfpad\", S.banner_fade, a, r, cx, cy); } });\n"
    "  makePad({ pad:$(\"bgfpad\"), hand:$(\"bgfpadH\"), line:$(\"bgfpadLine\"), ring:$(\"bgfpadRing\"),\n"
    "    angEl:$(\"bgfAng\"), radEl:$(\"bgfRad\"), angR:$(\"bgfAngR\"), radR:$(\"bgfRadR\"),\n"
    "    af:\"bg_fade_angle\", rf:\"bg_fade_radius\", cxf:\"bg_fade_cx\", cyf:\"bg_fade_cy\", isRadial:function(){ return S.bg_fade==2; }, centerDrag:true, onRef:function(a,r,radial,frac,ux,uy,R,cx,cy){ setPadFade(\"bgfpad\", S.bg_fade, a, r, cx, cy); } });\n"
    "}\n"
    "window.cpbSetImage=function(target, uri){ IMG[target]=uri||\"\"; render(); };\n"
    "function applySnapshot(uri){ var rw=$(\"realWrap\"), img=$(\"phSnap\"), hint=$(\"snapHint\");\n"
    "  if(uri && img){ img.src=uri; if(rw) rw.style.display=\"\"; if(hint) hint.style.display=\"none\"; }\n"
    "  scheduleHeight(); }\n"
    "window.cpbSetSnapshot=function(uri){ SNAP=uri||\"\"; applySnapshot(SNAP); };\n"
    "\n"
    "window.cpbShowRemoteConsent=function(){ var ov=$(\"cpRemoteConsent\"); if(!ov){ ov=document.createElement(\"div\"); ov.id=\"cpRemoteConsent\"; ov.style.cssText=\"position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.55);z-index:9999;display:none;align-items:center;justify-content:center;padding:18px\"; ov.innerHTML=\"<div style='background:#1f1f22;color:#fff;border-radius:14px;max-width:340px;width:100%;padding:16px 16px 12px;font-size:14px;line-height:1.5'><div style='font-size:16px;font-weight:700;margin-bottom:8px'>Загрузка чужого оформления</div><div style='opacity:.85'>Если включить, при открытии профиля другого пользователя его числовой ID будет отправляться на сервер плагина, чтобы загрузить опубликованное им оформление. Нажимая «Принять», вы соглашаетесь на передачу этих данных.</div><div style='display:flex;gap:10px;justify-content:flex-end;margin-top:12px'><button class='btn' id='cpRemoteNo' style='background:#3a3a3d'>Отклонить</button><button class='btn' id='cpRemoteYes'>Принять</button></div></div>\"; document.body.appendChild(ov); $(\"cpRemoteNo\").addEventListener(\"click\", function(){ ov.style.display=\"none\"; }); $(\"cpRemoteYes\").addEventListener(\"click\", function(){ ov.style.display=\"none\"; var sr2=$(\"sw_remote\"); if(sr2) sr2.checked=true; S.remote_enabled=1; cmd(\"cpb://remoteview?on=1\"); }); } ov.style.display=\"flex\";};\n"
    "(function(){ var sr=$(\"sw_remote\"); if(!sr) return; sr.checked=!!S.remote_enabled; sr.addEventListener(\"change\", function(){ if(!sr.checked){ S.remote_enabled=0; cmd(\"cpb://remoteview?on=0\"); return; } if(S.remote_enabled){ cmd(\"cpb://remoteview?on=1\"); return; } sr.checked=false; cpbShowRemoteConsent(); }); })();\n"
    "window.cpbShowConsent=function(){ var pb=$(\"btn_publish\"); if(pb){ if(pb._t){ clearTimeout(pb._t); pb._t=0; } pb.disabled=false; pb.textContent=\"Опубликовать мой профиль\"; } var ov=$(\"cpConsent\"); if(!ov){ ov=document.createElement(\"div\"); ov.id=\"cpConsent\"; ov.style.cssText=\"position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.55);z-index:9999;display:none;align-items:center;justify-content:center;padding:18px\"; ov.innerHTML=\"<div style='background:#1f1f22;color:#fff;border-radius:14px;max-width:340px;width:100%;padding:16px 16px 12px;font-size:14px;line-height:1.5'><div style='font-size:16px;font-weight:700;margin-bottom:8px'>Соглашение о публикации</div><div style='opacity:.85'>При публикации на сервер плагина отправляются ваш ID профиля и настройки оформления, чтобы другие пользователи плагина видели ваше оформление. Нажимая «Принять», вы соглашаетесь на передачу этих данных.</div><label style='display:flex;align-items:center;gap:8px;margin:12px 0'><input type='checkbox' id='cpConsentChk' checked> Больше не показывать</label><div style='display:flex;gap:10px;justify-content:flex-end'><button class='btn' id='cpConsentNo' style='background:#3a3a3d'>Отклонить</button><button class='btn' id='cpConsentYes'>Принять</button></div></div>\"; document.body.appendChild(ov); $(\"cpConsentNo\").addEventListener(\"click\", function(){ ov.style.display=\"none\"; }); $(\"cpConsentYes\").addEventListener(\"click\", function(){ var r=($(\"cpConsentChk\")&&$(\"cpConsentChk\").checked)?1:0; ov.style.display=\"none\"; var pb2=$(\"btn_publish\"); if(pb2){ pb2.disabled=true; pb2.textContent=\"Публикация…\"; pb2._t=setTimeout(function(){ pb2.disabled=false; pb2.textContent=\"Опубликовать мой профиль\"; }, 20000); } cmd(\"cpb://publish?agree=1&remember=\"+r); }); } ov.style.display=\"flex\";};\n"
    "window.cpbPublishResult=function(ok,msg){ var pb=$('btn_publish'); if(pb){ if(pb._t){ clearTimeout(pb._t); pb._t=0; } pb.disabled=false; pb.textContent='Опубликовать мой профиль'; } cpbToast(msg||'', ok); }; function cpbToast(msg,ok){ var t=$('cpToast'); if(!t){ t=document.createElement('div'); t.id='cpToast'; document.body.appendChild(t); } t.textContent=(msg||''); t.className='cp-toast '+(ok?'okk':'errr'); void t.offsetWidth; t.classList.add('on'); if(t._h) clearTimeout(t._h); t._h=setTimeout(function(){ t.classList.remove('on'); }, 2800); } initSeg();\n"
    "window.cpbShowRecovery=function(bot,isChat){ var pb=$('btn_publish'); if(pb){ if(pb._t){clearTimeout(pb._t);pb._t=0;} pb.disabled=false; pb.textContent='Опубликовать мой профиль'; } var ov=$('cpKeyOv'); if(!ov){ ov=document.createElement('div'); ov.id='cpKeyOv'; ov.style.cssText='position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.55);z-index:9999;display:none;align-items:center;justify-content:center;padding:18px'; ov.innerHTML=\"<div style='background:#1f1f22;color:#fff;border-radius:14px;max-width:340px;width:100%;padding:16px 16px 12px;font-size:14px;line-height:1.5'><div style='font-size:16px;font-weight:700;margin-bottom:8px'>Подтверждение владельца</div><div style='opacity:.85' id='cpKeyTxt'></div><div style='display:flex;gap:10px;justify-content:flex-end;margin-top:12px'><button class='btn' id='cpKeyNo' style='background:#3a3a3d'>Закрыть</button><button class='btn' id='cpKeyYes'>Я скопировал ключ</button></div></div>\"; document.body.appendChild(ov); $('cpKeyNo').addEventListener('click',function(){ov.style.display='none';}); $('cpKeyYes').addEventListener('click',function(){cmd('cpb://keyconfirm');}); } var tx=$('cpKeyTxt'); if(tx){ var b='<b>'+(bot||'(бот недоступен)')+'</b>'; if(isChat){ tx.innerHTML='Оформление канала или группы подтверждается вашим личным ключом, а он на этом устройстве отсутствует или не совпадает.<br>1. Откройте бота '+b+' в Telegram, нажмите Start и выберите «Ключ для личного профиля».<br>2. Скопируйте ключ из ответа.<br>3. Вернитесь сюда и нажмите «Я скопировал ключ» — ключ подставится из буфера обмена.<br><br>Если канал ещё не привязан, бот подскажет: Start → «Привязать канал или группу».'; } else { tx.innerHTML='На вашем ID уже зарегистрирован ключ, а ключ на устройстве отсутствует или не совпадает. Чтобы подтвердить, что профиль ваш:<br>1. Откройте бота '+b+' в Telegram, нажмите Start и выберите «Ключ для личного профиля».<br>2. Скопируйте ключ из ответа.<br>3. Вернитесь сюда и нажмите «Я скопировал ключ» — ключ подставится из буфера обмена.'; } } ov.style.display='flex'; }; window.cpbKeyResult=function(ok,msg){ if(ok){ var ov=$('cpKeyOv'); if(ov) ov.style.display='none'; } cpbToast(msg||'', ok); };\n"
    "bindSwitch(\"sw_banner\",\"banner_enabled\"); bindSwitch(\"sw_name_color_enabled\",\"name_color_enabled\"); bindSwitch(\"sw_name_glow_enabled\",\"name_glow_enabled\"); bindNum(\"nameGlowRad\",\"name_glow_radius\",\"l_nameGlowRad\",\"\"); bindNum(\"nameGlowStr\",\"name_glow_strength\",\"l_nameGlowStr\",\"%\"); bindNum(\"nameFxSpeed\",\"name_fx_speed\",\"l_nameFxSpeed\",\"%\"); bindNum(\"nameGradAng\",\"name_grad_angle\",\"l_nameGradAng\",\"°\"); bindNum(\"nameSize\",\"name_size\",\"l_nameSize\",\"%\"); bindNum(\"banDim\",\"banner_dim\",\"l_banDim\",\"%\"); bindNum(\"bgDim\",\"bg_dim\",\"l_bgDim\",\"%\");\n"
    "bindSwitch(\"sw_emoji\",\"show_emoji\");\n"
    "bindSwitch(\"sw_bg\",\"bg_enabled\"); bindSwitch(\"sw_blocks_color_enabled\",\"blocks_color_enabled\");\n"
    "[\"banner_color\",\"grad_c1\",\"grad_c2\",\"grad_c3\",\"bg_color\",\"blocks_color\",\"name_color\",\"name_grad_c1\",\"name_grad_c2\"].forEach(bindColor);\n"
    "bindAlpha(\"banAlpha\",\"banner_alpha\",\"l_banAlpha\");\n"
    "bindAlpha(\"bgAlpha\",\"bg_alpha\",\"l_bgAlpha\");\n"
    "bindAlpha(\"blocksAlpha\",\"blocks_alpha\",\"l_blocksAlpha\");\n"
    "bindBlur(\"blocksBlur\",\"blocks_blur\",\"l_blocksBlur\");\n"
    "(function(){ var e=$(\"avAlpha\"); if(!e) return; var cur=(S.avatar_alpha==null?100:S.avatar_alpha); e.value=cur; var l=$(\"l_avAlpha\"); if(l) l.textContent=cur; e.addEventListener(\"input\", function(){ S.avatar_alpha=parseInt(this.value); if(isNaN(S.avatar_alpha)) S.avatar_alpha=100; if(l) l.textContent=S.avatar_alpha; render(); sync(); }); })();\n"
    "bindNum(\"avDim\",\"avatar_dim\",\"l_avDim\",\"%\");\n"
    "(function(){ var e=$('thoughtText'); if(e){ e.value=(S.thought_text||''); e.addEventListener('input', function(){ S.thought_text=this.value.slice(0,80); sync(); }); } })();\n"
    "bindColor('thought_text_color'); bindColor('thought_bg_color'); bindSwitch('sw_thought_font_copy','thought_font_copy'); markSeg('thought_font');\n"
    "(function(){ var e=$(\"avFade\"); if(!e) return; var cur=(S.avatar_fade==null?0:S.avatar_fade); e.value=cur; var l=$(\"l_avFade\"); if(l) l.textContent=cur; e.addEventListener(\"input\", function(){ S.avatar_fade=parseInt(this.value); if(isNaN(S.avatar_fade)) S.avatar_fade=0; if(l) l.textContent=S.avatar_fade; render(); sync(); }); })();\n"
    "(function(){ var e=$(\"avFadeRad\"); if(!e) return; var cur=(S.avatar_fade_radius==null?50:S.avatar_fade_radius); e.value=cur; var l=$(\"l_avFadeRad\"); if(l) l.textContent=cur; e.addEventListener(\"input\", function(){ S.avatar_fade_radius=parseInt(this.value); if(isNaN(S.avatar_fade_radius)) S.avatar_fade_radius=50; if(l) l.textContent=S.avatar_fade_radius; render(); sync(); }); })();\n"
    "(function(){ var e=$(\"avRad\"); if(!e) return; var cur=(S.avatar_radius==null?18:S.avatar_radius); e.value=cur; var l=$(\"l_avRad\"); if(l) l.textContent=cur; e.addEventListener(\"input\", function(){ S.avatar_radius=parseInt(this.value)||0; if(l) l.textContent=S.avatar_radius; render(); sync(); }); })();\n"
    "(function(){ var e=$(\"avRound\"); if(!e) return; var cur=(S.avatar_round==null?0:S.avatar_round); e.value=cur; var l=$(\"l_avRound\"); if(l) l.textContent=cur; e.addEventListener(\"input\", function(){ S.avatar_round=parseInt(this.value)||0; if(l) l.textContent=S.avatar_round; render(); sync(); }); })();\n"
    "initDraw();\n"
    "initGradPad();\n"
    "initFadePads();\n"
    "$(\"pick_banner\").addEventListener(\"click\", function(){ cmd(\"cpb://pick?target=banner\"); });\n"
    "$(\"clear_banner\").addEventListener(\"click\", function(){ IMG.banner=\"\"; cmd(\"cpb://clear?target=banner\"); render(); });\n"
    "$(\"pick_bg\").addEventListener(\"click\", function(){ cmd(\"cpb://pick?target=bg\"); });\n"
    "$(\"pick_font\").addEventListener(\"click\", function(){ cmd(\"cpb://pick?target=font\"); });\n"
    "$(\"clear_font\").addEventListener(\"click\", function(){ cmd(\"cpb://clear?target=font\"); });\n"
    "$(\"pick_tfont\").addEventListener(\"click\", function(){ cmd(\"cpb://pick?target=tfont\"); });\n"
    "$(\"clear_tfont\").addEventListener(\"click\", function(){ cmd(\"cpb://clear?target=tfont\"); });\n"
    "$(\"clear_bg\").addEventListener(\"click\", function(){ IMG.bg=\"\"; cmd(\"cpb://clear?target=bg\"); render(); });\n"
    "(function(){ var sh=$(\"sw_share\"); var oh=$(\"pub_offhint\"); var pb=$(\"btn_publish\"); function pubUI(){ var on=sh?!!sh.checked:false; if(pb) pb.style.display=on?\"\":\"none\"; if(oh) oh.style.display=on?\"none\":\"\"; } if(sh){ sh.checked=!!S.share_enabled; sh.addEventListener(\"change\", function(){ cmd(\"cpb://share?on=\"+(sh.checked?1:0)); pubUI(); }); } if(pb){ pb.addEventListener(\"click\", function(){ pb.disabled=true; pb.textContent=\"Публикация…\"; cmd(\"cpb://publish\"); pb._t=setTimeout(function(){ if(!pb.disabled) return; pb.disabled=false; pb.textContent=\"Опубликовать мой профил��\"; }, 20000); }); } pubUI(); })();\n"
    "var P = INIT.profile || {};\n"
    "(function(){\n"
    "  var nt=$(\"phNameTxt\"); if(nt) nt.textContent=P.name||\"Profile\";\n"
    "  var av=$(\"phAvatar\");\n"
    "  if(av){ if(P.avatar){ av.style.backgroundImage=\"url('\"+P.avatar+\"')\"; av.textContent=\"\"; }\n"
    "    else if(P.initials){ av.textContent=P.initials; } }\n"
    "  var us=$(\"phUser\"); if(us) us.textContent = P.username ? (\"@\"+P.username) : \"@username\";\n"
    "  var pn=$(\"phPhone\"); if(pn && P.phone) pn.textContent = P.phone;\n"
    "})();\n"
    "var _bc=$(\"btnClose\"); if(_bc) _bc.addEventListener(\"click\", function(){ cmd(\"cpb://close\"); });\n"
    "var _ce=$(\"btn_cfg_export\"); if(_ce) _ce.addEventListener(\"click\", function(){ cmd(\"cpb://cfgexport\"); });\n"
    "var _ci=$(\"btn_cfg_import\"); if(_ci) _ci.addEventListener(\"click\", function(){ cmd(\"cpb://cfgimport\"); });\n"
    "function showTab(t){ var secs=document.querySelectorAll('.sec'); for(var i=0;i<secs.length;i++){ secs[i].classList.toggle('on', secs[i].id==='sec_'+t); } var tb=document.querySelectorAll('.tabs .tb'); for(var j=0;j<tb.length;j++){ tb[j].classList.toggle('active', tb[j].getAttribute('data-t')===t); } try{ var ab=document.querySelector('.tabs .tb.active'); if(ab&&ab.scrollIntoView){ ab.scrollIntoView({block:'nearest',inline:'center'}); } }catch(e){} render(); }\n"
    "(function(){ var tb=document.querySelectorAll('.tabs .tb'); for(var i=0;i<tb.length;i++){ (function(b){ b.addEventListener('click', function(){ showTab(b.getAttribute('data-t')); }); })(tb[i]); } })();\n"
    "showTab('banner');\n"
    "render();\n"
    "if(SNAP) applySnapshot(SNAP);\n"
    "window.addEventListener(\"load\", reportHeight);\n"
    "window.addEventListener(\"resize\", reportHeight);\n"
    "try { new ResizeObserver(reportHeight).observe(document.body); } catch(e){}\n"
    "setTimeout(reportHeight,120); setTimeout(reportHeight,400); setTimeout(reportHeight,1000);\n"
    "</script>\n"
    "</body></html>\n"
)

