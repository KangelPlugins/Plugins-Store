class RandomGamesPlugin(BasePlugin):

    def on_plugin_load(self):
        try:
            self.add_on_send_message_hook()
            self.log("Random Games 4.2.0: хук зарегистрирован")
        except Exception as e:
            self.log("Random Games: ошибка регистрации хука: " + str(e))

    def create_settings(self):
        return []

    def on_send_message_hook(self, account, params):
        try:
            message = getattr(params, "message", None)
            if not isinstance(message, str):
                return HookResult()

            text = message.strip()
            if not text.startswith("."):
                return HookResult()

            parts = text.split(maxsplit=1)
            cmd = parts[0].lower()
            args = parts[1] if len(parts) > 1 else ""

            result = self._handle(cmd, args)
            if result is None:
                return HookResult()

            params.message = result
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        except Exception as e:
            self.log("Random Games hook error: " + str(e))
            return HookResult()

    def _handle(self, cmd, args):
        if cmd == ".flip":      return self._flip()
        if cmd == ".dice":      return self._dice(args)
        if cmd == ".slots":     return self._slots()
        if cmd == ".rps":       return self._rps(args)
        if cmd == ".pick":      return self._pick(args)
        if cmd == ".rng":       return self._rng(args)
        if cmd == ".ball":      return self._ball(args)
        if cmd == ".lucky":     return self._lucky()
        if cmd == ".truthdare": return self._truth_dare()
        if cmd == ".roulette":  return self._roulette()
        if cmd == ".fact":      return self._fact()
        if cmd == ".quote":     return self._quote()
        if cmd == ".anime":     return self._anime()
        if cmd == ".box":       return self._box()
        if cmd == ".color":     return self._color()
        if cmd == ".compat":    return self._compat(args)
        if cmd == ".reverse":   return self._reverse(args)
        if cmd == ".statya":    return self._statya()
        if cmd == ".dere":      return self._dere()
        if cmd == ".love":      return self._love(args)
        if cmd == ".help":      return self._help()
        return None

    # ── Команды ───────────────────────────────────────────────────────────────

    def _flip(self):
        side = random.choice(["орёл", "решка", "упс! монетка укатилась в небытие..."])
        return "🪙 результат: " + side

    def _dice(self, args):
        parts = args.split()
        try:
            amount = max(1, min(int(parts[0]), 20)) if parts else 1
            sides  = max(2, min(int(parts[1]), 10000)) if len(parts) > 1 else 6
        except ValueError:
            return "🎲 используй: .dice [количество] [стороны]"
        rolls = [random.randint(1, sides) for _ in range(amount)]
        return "🎲 " + ", ".join(map(str, rolls)) + " (сумма: " + str(sum(rolls)) + ")"

    def _slots(self):
        symbols = ["🍒", "🍋", "🍓", "🍌", "🍎", "🔥", "💎", "7️⃣"]
        r = random.choices(symbols, k=3)
        line = " | ".join(r)
        if r[0] == r[1] == r[2]:
            verdict = "ДЖЕКПОТ! 🎉"
        elif r[0] == r[1] or r[1] == r[2] or r[0] == r[2]:
            verdict = "два совпадения!"
        else:
            verdict = "нет совпадений."
        return "🎰 [ " + line + " ] — " + verdict

    def _rps(self, args):
        choices = {"к": "камень 🪨", "н": "ножницы ✂️", "б": "бумага 📄"}
        beats   = {"к": "н", "н": "б", "б": "к"}
        uk = args.lower()[:1] if args and args.lower()[:1] in choices else random.choice(list(choices))
        bk = random.choice(list(choices))
        if uk == bk:       verdict = "ничья!"
        elif beats[uk]==bk: verdict = "ты победил! 🏆"
        else:               verdict = "ты проиграл 😔"
        return "✂️ ты: " + choices[uk] + ", бот: " + choices[bk] + " — " + verdict

    def _pick(self, args):
        opts = args.split()
        if not opts:
            return "🎯 укажи варианты: .pick яблоко груша банан"
        return "🎯 выпало: " + random.choice(opts)

    def _rng(self, args):
        try:
            nums = list(map(int, args.split()))
            if len(nums) == 2:   lo, hi = nums
            elif len(nums) == 1: lo, hi = 1, nums[0]
            else:                lo, hi = 1, 100
        except ValueError:
            return "🔢 используй: .rng [min] [max]"
        if lo > hi: lo, hi = hi, lo
        return "🔢 " + str(random.randint(lo, hi)) + "  [" + str(lo) + " — " + str(hi) + "]"

    def _ball(self, args):
        answers = [
            "да, определённо.", "без сомнений.", "скорее всего да.",
            "спроси позже.", "не могу предсказать.", "возможно.",
            "не рассчитывай на это.", "мой ответ — нет.", "скорее всего нет.",
        ]
        ans = random.choice(answers)
        if args:
            return "🎱 " + args + "\n— " + ans
        return "🎱 " + ans

    def _lucky(self):
        n = random.randint(1, 100)
        bar = "█" * (n // 10) + "░" * (10 - n // 10)
        if n >= 80:   msg = "🔥 сегодня твой день!"
        elif n >= 50: msg = "😊 день обещает быть хорошим."
        elif n >= 25: msg = "😬 удача капризничает."
        else:         msg = "💀 лучше сиди дома."
        return "🍀 удача: " + str(n) + "%\n[" + bar + "]\n" + msg

    def _truth_dare(self):
        return random.choice(TRUTH_DARE)

    def _roulette(self):
        return "💥 бах! ты умер." if random.randint(1, 6) == 1 else "🔫 щёлк! повезло."

    def _fact(self):
        return "📚 факт: " + random.choice(FACTS)

    def _quote(self):
        return "💬 " + random.choice(QUOTES)

    def _anime(self):
        return "🍥 тебе стоит посмотреть: " + random.choice(ANIME)

    def _box(self):
        return "*вы открыли коробку...* " + random.choice(BOX_OUTCOMES)

    def _color(self):
        return "🎨 твой цвет сегодня: " + random.choice(COLORS)

    def _compat(self, args):
        parts = args.split()
        if len(parts) != 2:
            return "💞 используй: .compat @имя1 @имя2"
        u1, u2 = parts[0].lstrip("@"), parts[1].lstrip("@")
        pct = random.randint(1, 100)
        msg = "из вас выйдет отличная пара!" if pct >= 50 else "увы.. в следующий раз.."
        return "💞 " + u1 + " + " + u2 + " = " + str(pct) + "%\n" + msg

    def _reverse(self, args):
        if not args:
            return "🔄 используй: .reverse [текст]"
        return args[::-1]

    def _statya(self):
        num, name, penalty = random.choice(STATYI)
        return "⚖️ Статья " + num + " УК РФ\n" + name + "\nНаказание: " + penalty

    def _dere(self):
        dere, desc, phrase = random.choice(DERE_TYPES)
        return "💘 Твой тип — " + dere + "\n\n" + desc + "\n\n" + phrase

    def _love(self, args):
        name = args.strip() if args.strip() else "он/она"
        petals = random.randint(5, 12)
        sequence = []
        for i in range(petals):
            sequence.append("любит" if i % 2 == 0 else "не любит")
        result = sequence[-1]
        icon = "💖" if result == "любит" else "💔"
        return (
            "🌸 " + name + "\n"
            + " — ".join(sequence)
            + "\n\n" + icon + " " + name.upper() + " " + result.upper() + "!"
        )

    def _help(self):
        return "\n".join([
            "🎮 команды:",
            "",
            "🪙 .flip — орёл или решка",
            "🎲 .dice [кол-во] [стороны] — кубики",
            "🎰 .slots — однорукий бандит",
            "✂️ .rps [к/н/б] — камень-ножницы-бумага",
            "🎯 .pick a b c — случайный выбор",
            "🔢 .rng [min] [max] — случайное число",
            "🎱 .ball [вопрос] — магический шар",
            "🍀 .lucky — проверить удачу",
            "🤔 .truthdare — правда или действие",
            "💀 .roulette — русская рулетка",
            "📚 .fact — случайный факт",
            "💬 .quote — случайная цитата",
            "🍥 .anime — случайное аниме",
            "📦 .box — тайная коробка",
            "🎨 .color — цвет дня",
            "💞 .compat @a @b — совместимость",
            "🔄 .reverse [текст] — текст наоборот",
            "⚖️ .statya — случайная статья УК РФ",
            "💘 .dere — твой тип дередере",
            "🌸 .love [имя] — любит или не любит",
            "ℹ️ .help — этот список",
        ])