class random_games_plugin(BasePlugin):

    def on_plugin_load(self):
        try:
            self.add_on_send_message_hook()
            self.log("random games 7.2.0: загружен")
        except Exception as e:
            self.log("random games: ошибка: " + str(e))

    def create_settings(self):
        return []

    def on_send_message_hook(self, account, params):
        try:
            message = getattr(params, "message", None)
            if not isinstance(message, str):
                return HookResult()
            text = message.strip()
            if not text.startswith("."):
                return HookResult()
            parts = text.split(maxsplit=1)
            cmd = parts[0].lower()
            args = parts[1] if len(parts) > 1 else ""
            result = self._handle(cmd, args)
            if result is None:
                return HookResult()
            params.message = result
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        except Exception as e:
            self.log("hook error: " + str(e))
            return HookResult()

    def _handle(self, cmd, args):
        if cmd == ".flip":      return self._flip()
        if cmd == ".slots":     return self._slots()
        if cmd == ".rps":       return self._rps(args)
        if cmd == ".pick":      return self._pick(args)
        if cmd == ".rng":       return self._rng(args)
        if cmd == ".ball":      return self._ball(args)
        if cmd == ".lucky":     return self._lucky()
        if cmd == ".truthdare": return self._truth_dare()
        if cmd == ".roulette":  return self._roulette()
        if cmd == ".battle":    return self._battle(args)
        if cmd == ".game":      return self._game()
        if cmd == ".love":      return self._love(args)
        if cmd == ".ship":      return self._ship(args)
        if cmd == ".rarity":    return self._rarity()
        if cmd == ".when":      return self._when(args)
        if cmd == ".dox":       return self._dox(args)
        if cmd == ".fact":      return self._fact()
        if cmd == ".quote":     return self._quote()
        if cmd == ".box":       return self._box()
        if cmd == ".color":     return self._color()
        if cmd == ".tarot":     return self._tarot()
        if cmd == ".story":     return self._story()
        if cmd == ".tongue":    return self._tongue()
        if cmd == ".mbti":      return self._mbti()
        if cmd == ".element":   return self._element()
        if cmd == ".power":     return self._power()
        if cmd == ".job":       return self._job()
        if cmd == ".die":       return self._die()
        if cmd == ".iq":        return self._iq()
        if cmd == ".aura":      return self._aura()
        if cmd == ".dere":      return self._dere()
        if cmd == ".npc":       return self._npc()
        if cmd == ".statya":    return self._statya()
        if cmd == ".food":      return self._food()
        if cmd == ".animal":    return self._animal()
        if cmd == ".reverse":   return self._reverse(args)
        if cmd == ".uwu":       return self._uwu(args)
        if cmd == ".clap":      return self._clap(args)
        if cmd == ".caesar":    return self._caesar(args)
        if cmd == ".morse":     return self._morse(args)
        if cmd == ".unmorse":   return self._unmorse(args)
        if cmd == ".repeat":    return self._repeat(args)
        if cmd == ".wc":        return self._wc(args)
        if cmd == ".calc":      return self._calc(args)
        if cmd == ".sqrt":      return self._sqrt(args)
        if cmd == ".pow":       return self._pow(args)
        if cmd == ".fib":       return self._fib(args)
        if cmd == ".text":      return self._text(args)
        if cmd == ".binary":    return self._binary(args)
        if cmd == ".hex":       return self._tohex(args)
        if cmd == ".roman":     return self._roman(args)
        if cmd == ".split":     return self._split(args)
        if cmd == ".bmi":       return self._bmi(args)
        if cmd == ".days":      return self._days(args)
        if cmd == ".temp":      return self._temp(args)
        if cmd == ".pass":      return self._pass(args)
        if cmd == ".help":      return self._help()
        return None

    def _flip(self):
        result = random.choice(["орёл","решка","монетка встала на ребро!"])
        if result == "монетка встала на ребро!":
            return "🪙 " + result + "\nневероятно редкий исход (1%)"
        return "🪙 результат: " + result

    def _slots(self):
        symbols = ["🫐","🍏","🍌","🍓","🍋","🔥","💎","7️⃣","⭐","🍀"]
        r = random.choices(symbols, k=3)
        line = " | ".join(r)
        if r[0] == r[1] == r[2]:
            if r[0] == "7️⃣":
                verdict = "мега джекпот!!! 🎰💰"
            elif r[0] == "💎":
                verdict = "алмазный джекпот! 💎✨"
            else:
                verdict = "джекпот! 🎉"
        elif r[0]==r[1] or r[1]==r[2] or r[0]==r[2]:
            verdict = "два совпадения! почти..."
        else:
            verdict = "нет совпадений."
        return "🎰 [ " + line + " ]\n→ " + verdict

    def _rps(self, args):
        choices = {"к":"камень 🪨","н":"ножницы ✂️","б":"бумага 📄"}
        beats = {"к":"н","н":"б","б":"к"}
        uk = args.lower()[:1] if args and args.lower()[:1] in choices else random.choice(list(choices))
        bk = random.choice(list(choices))
        if uk==bk: verdict="ничья! 🤝"
        elif beats[uk]==bk: verdict="ты победил! 🏆"
        else: verdict="ты проиграл 😔"
        return "✂️ ты: "+choices[uk]+"\nбот: "+choices[bk]+"\n→ "+verdict

    def _pick(self, args):
        opts = [o.strip() for o in args.split() if o.strip()]
        if not opts:
            return "🎯 используй: .pick - [...]"
        if len(opts) == 1:
            return "🎯 только один вариант? тогда " + opts[0]
        return "🎯 выпало: " + random.choice(opts)

    def _rng(self, args):
        try:
            nums = list(map(int, args.split()))
            if len(nums)==2: lo,hi=nums
            elif len(nums)==1: lo,hi=1,nums[0]
            else: lo,hi=1,100
        except Exception:
            return "🔢 используй: .rng - [...]"
        if lo>hi: lo,hi=hi,lo
        return "🔢 " + str(random.randint(lo,hi)) + "  [" + str(lo) + " - " + str(hi) + "]"

    def _ball(self, args):
        answers = [
            "да, определённо.","без сомнений.","скорее всего да.",
            "спроси позже.","не могу предсказать.","возможно.",
            "не рассчитывай на это.","мой ответ - нет.","скорее всего нет.",
            "всё указывает на да.","однозначно нет.","знаки говорят да.",
            "лучше не говорить сейчас.","сосредоточься и спроси снова.",
            "это секрет вселенной.","шансы 50/50, но я на твоей стороне.",
        ]
        ans = random.choice(answers)
        return "🎱 " + (args + "\n→ " + ans if args else ans)

    def _lucky(self):
        n = random.randint(1,100)
        bar = "█"*(n//10) + "░"*(10 - n//10)
        if n >= 90: msg = "🔥 сегодня твой день! всё получится."
        elif n >= 70: msg = "😊 удача на твоей стороне."
        elif n >= 40: msg = "😐 средний день. без сюрпризов."
        elif n >= 20: msg = "😬 удача капризничает. осторожнее."
        else: msg = "💀 лучше сиди дома и не высовывайся."
        return "🍀 удача: " + str(n) + "%\n[" + bar + "]\n" + msg

    def _truth_dare(self):
        return "🎲 " + random.choice(truth_dare)

    def _roulette(self):
        if random.randint(1,6) == 1:
            return "💥 бах! ты умер.\n💀 game over"
        return "🔫 щёлк... повезло.\nосталось патронов: " + str(random.randint(1,5))

    def _battle(self, args):
        parts = args.split()
        if len(parts) < 2:
            return "⚔️ используй: .battle - [...]"
        a, b = parts[0], parts[1]
        hp_a = random.randint(15, 100)
        hp_b = random.randint(15, 100)
        if hp_a == hp_b:
            hp_a += 1
        winner = a if hp_a > hp_b else b
        loser = b if hp_a > hp_b else a
        return ("⚔️ " + a + " vs " + b + "\n\n"
                + a + ": " + str(hp_a) + " hp\n"
                + b + ": " + str(hp_b) + " hp\n\n"
                + "🏆 победитель: " + winner + "\n"
                + "💀 " + loser + " повержен.")

    def _game(self):
        return "" + random.choice(["⚽", "🏀", "🎯", "🎳", "🎰", "🎲"])

    def _love(self, args):
        name = args.strip() or "он/она"
        count = random.randint(5, 11)
        seq = ["любит" if i % 2 == 0 else "не любит" for i in range(count)]
        result = seq[-1]
        return ("🌸 " + name + "\n"
                + " - ".join(seq) + "\n\n"
                + ("💖 " + result + "!" if result == "любит" else "💔 " + result + "..."))

    def _ship(self, args):
        parts = args.split()
        if len(parts) < 2:
            return "❤️ используй: .ship - [...]"
        a, b = parts[0], parts[1]
        name = a[:max(1, len(a)//2)] + b[max(1, len(b)//2):]
        score = random.randint(0, 100)
        bar = "❤️" * (score // 20) + "🖤" * (5 - score // 20)
        if score >= 85: c = "огонь. абсолютный шип. 🔥"
        elif score >= 60: c = "неплохо, есть химия."
        elif score >= 35: c = "спорно, но почему бы и нет."
        else: c = "нет. просто нет. 🚫"
        return ("❤️ " + a + " × " + b + "\n"
                + "название: " + name + "\n"
                + bar + " " + str(score) + "%\n" + c)

    def _rarity(self):
        weights = [40, 25, 15, 10, 6, 3, 1]
        rarity, desc = random.choices(rarities, weights=weights, k=1)[0]
        return "🎰 твоя редкость: " + rarity + "\n" + desc

    def _when(self, args):
        if not args:
            return "⏳ используй: .when - [...]"
        return "⏳ " + args + "?\n→ " + random.choice(when_answers)

    def _dox(self, args):
        target = args.strip() or "аноним"
        names = ["неопознанный аккаунт","долбаёб","олег владимирович","внеземной объект","барбоскин","жирный","разработчик экстеры","павел дуров"]
        phones = ["+8800555535","+666 (сам дьявол!)","+00000000000","+77777777777","жиропузик"]
        ips = ["382727282щвлалвб","неосознанно","404.not.found","ip.of.your.mom","0.0.0.0"]
        addresses = ["где-то","бля хз сорри","folk valley","мурино","в мусорке живёт"]
        devices = ["домофон","калькулятор","нокия","смартфон виво","тапок"]
        works = ["жирдяй","занимается движухой","безработный","профессиональный диванщик"]
        return ("🔍 пробив по базам " + target + ":\n\n"
                "👤 фио: " + random.choice(names) + "\n"
                "📞 телефон: " + random.choice(phones) + "\n"
                "🌐 ip: " + random.choice(ips) + "\n"
                "🏠 адрес: " + random.choice(addresses) + "\n"
                "📱 устройство: " + random.choice(devices) + "\n"
                "💼 работа: " + random.choice(works))

    def _fact(self):
        return "📚 факт: " + random.choice(facts)

    def _quote(self):
        return "💬 " + random.choice(quotes)

    def _box(self):
        return "📦 *вы открыли коробку...*\n" + random.choice(box_outcomes)

    def _color(self):
        return "🎨 твой цвет сегодня: " + random.choice(colors)

    def _tarot(self):
        card, meaning = random.choice(tarot_cards)
        return "🔮 твоя карта: " + card + "\n" + meaning

    def _story(self):
        return "📖 страшная история:\n" + random.choice(stories)

    def _tongue(self):
        return "👅 скороговорка: " + random.choice(tongue_twisters)

    def _mbti(self):
        t, desc = random.choice(mbti_types)
        return "🧬 твой тип: " + t + "\n" + desc

    def _element(self):
        el, desc = random.choice(elements)
        return "🌊 твоя стихия: " + el + "\n" + desc

    def _power(self):
        return "⚡ твоя суперсила:\n" + random.choice(powers)

    def _job(self):
        return "💼 твоя профессия будущего:\n" + random.choice(future_jobs)

    def _die(self):
        return "💀 как ты умрёшь:\n" + random.choice(death_reasons)

    def _iq(self):
        score = random.randint(40, 200)
        if score >= 160: c = "какой же ты умный. 🧠✨"
        elif score >= 130: c = "неплохо. выше среднего."
        elif score >= 100: c = "средний показатель. норма."
        elif score >= 70: c = "есть куда расти."
        else: c = "даже золо умнее. 🗿"
        return "🧠 твой iq: " + str(score) + "\n" + c

    def _aura(self):
        points = random.randint(-9000, 9000)
        if points >= 7000:
            c = random.choice([
                "pure aura 🔥🥶",
                "аура высшего уровня 👑",
                "легенда чата, все смотрят на тебя 🌟",
                "ты светишься. буквально.",
                "аура зашкаливает, датчики горят",
            ])
        elif points >= 3000:
            c = random.choice([
                "аура имеется 🍷🐺",
                "неплохо держишься 💪",
                "аура на уровне 📈",
                "уверенный плюс, продолжай",
                "есть чем гордиться",
            ])
        elif points >= 0:
            c = random.choice([
                "не так уж и много",
                "средне, бывало и хуже",
                "аура в спящем режиме 😴",
                "почти ноль, но это уже что-то",
                "можно и лучше",
            ])
        elif points >= -3000:
            c = random.choice([
                "иди фармь ауру олух.",
                "аура утекает как вода 💧",
                "минус в карму, плюс в опыт",
                "нужно срочно поднимать",
                "аура в минусе, работай",
            ])
        else:
            c = random.choice([
                "брух братанчик где аура 💀",
                "аура в реанимации 🚑",
                "антиаура, работай над собой",
                "это уже не аура, это долг",
                "критический уровень, вызывай помощь",
            ])
        return "✨ аура: " + str(points) + "\n" + c

    def _dere(self):
        dere, desc, phrase = random.choice(dere_types)
        return "💘 твой тип: " + dere + "\n\n" + desc + "\n\n«" + phrase + "»"

    def _npc(self):
        score = random.randint(0, 100)
        if score >= 85: c = "полный npc. скрипт на максималках."
        elif score >= 60: c = "почти npc. иногда выходишь за рамки."
        elif score >= 35: c = "50/50. бывает."
        else: c = "не npc. редкость."
        return "🤖 уровень npc: " + str(score) + "%\n" + c

    def _statya(self):
        num, name, penalty = random.choice(statyi)
        return "⚖️ ты сядешь за ст. " + num + " ук рф\n«" + name + "»\nнаказание: " + penalty

    def _food(self):
        return "🍽️ твоя еда сегодня: " + random.choice(foods)

    def _animal(self):
        return "🐾 твоё животное: " + random.choice(animals)

    def _reverse(self, args):
        return args[::-1] if args else "🔄 используй: .reverse - [...]"

    def _uwu(self, args):
        if not args:
            return "🌸 используй: .uwu - [...]"
        t = args
        t = t.replace("р", "ш").replace("Р", "Ш")
        t = t.replace("л", "й").replace("Л", "Й")
        t = t.replace("на", "ня").replace("На", "Ня")
        t = t.replace("не", "ня").replace("Не", "Ня")
        t = t.replace("ни", "ньи").replace("Ни", "Ньи")
        words = t.split()
        result = []
        for w in words:
            result.append(w)
            if random.random() < 0.3:
                result.append(random.choice(["~~", "~", "♡", "•ᴗ•"]))
        text = " ".join(result)
        suffix = random.choice([
            " uwu", " owo", " >w<", " ^w^", " :3", " нюня~",
            " ♡", " (˘ᵕ˘)", " (◕ᴗ◕✿)", " ~nya", " >.<",
            " (˶˃ᆺ˂˶)", " ✧٩(ˊωˋ*)و✧",
        ])
        if random.random() < 0.4 and words:
            first = words[0]
            text = first[0] + "-" + text if first else text
        out = text + suffix
        if random.random() < 0.4:
            out += " " + random.choice(uwu_extra)
        return out

    def _clap(self, args):
        if not args:
            return "👏 используй: .clap - [...]"
        return " 👏 ".join(args.split()) + " 👏"

    def _caesar(self, args):
        parts = args.split(maxsplit=1)
        try:
            shift = int(parts[0]) % 26
            text = parts[1] if len(parts) > 1 else ""
            if not text:
                return "🔐 используй: .caesar - [...]"
            result = ""
            for ch in text:
                if ch.isalpha():
                    base = ord("A") if ch.isupper() else ord("a")
                    result += chr((ord(ch) - base + shift) % 26 + base)
                else:
                    result += ch
            return "🔐 " + result
        except Exception:
            return "🔐 используй: .caesar - [...]"

    def _morse(self, args):
        if not args:
            return "📡 используй: .morse - [...]"
        result = [morse_enc.get(ch, "?") for ch in args.upper()]
        return "📡 " + " ".join(result)

    def _unmorse(self, args):
        if not args:
            return "📡 используй: .unmorse - [...]"
        words = args.strip().split(" / ")
        decoded = []
        for word in words:
            letters = [morse_dec.get(symbol, "?") for symbol in word.strip().split()]
            decoded.append("".join(letters))
        return "📡 " + " ".join(decoded)

    def _repeat(self, args):
        parts = args.split(maxsplit=1)
        if len(parts) < 2:
            return "🔁 используй: .repeat - [...]"
        try:
            n = max(1, min(int(parts[0]), 20))
            text = parts[1]
            return "\n".join([text] * n)
        except Exception:
            return "🔁 используй: .repeat - [...]"

    def _wc(self, args):
        if not args:
            return "📝 используй: .wc - [...]"
        words = len(args.split())
        chars = len(args)
        chars_no_space = len(args.replace(" ", ""))
        minutes = max(1, round(words / 200))
        return ("📝 слов: " + str(words) + "\n"
                + "символов: " + str(chars) + "\n"
                + "символов (без пробелов): " + str(chars_no_space) + "\n"
                + "время чтения: ~" + str(minutes) + " мин.")

    def _fmt_num(self, v):
        if isinstance(v, float) and v.is_integer():
            return str(int(v))
        if isinstance(v, float):
            return str(round(v, 6))
        return str(v)

    def _calc_eval(self, node, steps):
        if isinstance(node, ast.Expression):
            return self._calc_eval(node.body, steps)
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in calc_ops:
            left = self._calc_eval(node.left, steps)
            right = self._calc_eval(node.right, steps)
            if isinstance(node.op, ast.Pow) and (abs(right) > 100 or abs(left) > 100000):
                raise ValueError("слишком большое число")
            result = calc_ops[type(node.op)](left, right)
            sym = calc_symbols[type(node.op)]
            steps.append(self._fmt_num(left) + " " + sym + " " + self._fmt_num(right) + " = " + self._fmt_num(result))
            return result
        if isinstance(node, ast.UnaryOp) and type(node.op) in calc_ops:
            val = self._calc_eval(node.operand, steps)
            return calc_ops[type(node.op)](val)
        raise ValueError("недопустимое выражение")

    def _calc(self, args):
        expr = args.strip()[:200]
        if not expr:
            return "🧮 используй: .calc - [...]"
        try:
            tree = ast.parse(expr, mode="eval")
            steps = []
            value = self._calc_eval(tree, steps)
        except ZeroDivisionError:
            return "🧮 на ноль делить нельзя."
        except Exception:
            return "🧮 не получилось это посчитать."
        value_str = self._fmt_num(value)
        if len(steps) <= 1:
            return "🧮 " + expr + " = " + value_str
        lines = ["🧮 " + expr]
        for i, s in enumerate(steps, 1):
            lines.append("шаг " + str(i) + ": " + s)
        lines.append("результат: " + value_str)
        return "\n".join(lines)

    def _sqrt(self, args):
        try:
            n = float(args)
            if n < 0:
                return "🔢 корень из отрицательного - комплексное. не сегодня."
            return "🔢 √" + str(n) + " = " + str(round(n ** 0.5, 6))
        except Exception:
            return "🔢 используй: .sqrt - [...]"

    def _pow(self, args):
        parts = args.split()
        try:
            base, exp = float(parts[0]), float(parts[1])
            return "🔢 " + str(base) + "^" + str(exp) + " = " + str(round(base ** exp, 6))
        except Exception:
            return "🔢 используй: .pow - [...]"

    def _fib(self, args):
        try:
            n = min(int(args), 50)
            if n <= 0:
                return "🔢 используй: .fib - [...]"
            a, b = 0, 1
            seq = [0]
            for _ in range(n - 1):
                a, b = b, a + b
                seq.append(a)
            return "🔢 фибоначчи (" + str(n) + "):\n" + " ".join(map(str, seq))
        except Exception:
            return "🔢 используй: .fib - [...]"

    def _text(self, args):
        try:
            n = int(args)
            if n < 2:
                return "🔢 " + str(n) + " - не простое."
            for i in range(2, int(n ** 0.5) + 1):
                if n % i == 0:
                    return "🔢 " + str(n) + " - составное (делится на " + str(i) + ")."
            return "🔢 " + str(n) + " - простое число ✓"
        except Exception:
            return "🔢 используй: .text - [...]"

    def _binary(self, args):
        try:
            n = int(args.strip())
            return "🔢 " + str(n) + " → " + bin(n)[2:] + " (bin)"
        except Exception:
            return "🔢 используй: .binary - [...]"

    def _tohex(self, args):
        try:
            n = int(args.strip())
            return "🔢 " + str(n) + " → " + hex(n)[2:].upper() + " (hex)"
        except Exception:
            return "🔢 используй: .hex - [...]"

    def _roman(self, args):
        try:
            n = int(args.strip())
            if not 1 <= n <= 3999:
                return "🔢 число должно быть от 1 до 3999"
            vals = [(1000,"M"),(900,"CM"),(500,"D"),(400,"CD"),(100,"C"),(90,"XC"),
                    (50,"L"),(40,"XL"),(10,"X"),(9,"IX"),(5,"V"),(4,"IV"),(1,"I")]
            result = ""
            for v, r in vals:
                while n >= v:
                    result += r
                    n -= v
            return "🔢 " + args.strip() + " → " + result
        except Exception:
            return "🔢 используй: .roman - [...]"

    def _split(self, args):
        parts = args.split()
        try:
            total = float(parts[0])
            people = int(parts[1])
            if people <= 0:
                return "➗ количество людей должно быть больше 0"
            per = total / people
            return ("➗ счёт: " + str(total) + " руб.\n"
                    + "люди: " + str(people) + "\n"
                    + "каждый платит: " + str(round(per, 2)) + " руб.")
        except Exception:
            return "➗ используй: .split - [...]"

    def _bmi(self, args):
        parts = args.split()
        try:
            weight = float(parts[0])
            height = float(parts[1])
            if height > 3:
                height = height / 100
            bmi = weight / (height ** 2)
            bmi_r = round(bmi, 1)
            if bmi < 18.5: cat = "дефицит веса 🔵"
            elif bmi < 25: cat = "норма 🟢"
            elif bmi < 30: cat = "избыточный вес 🟡"
            elif bmi < 35: cat = "ожирение i 🟠"
            else: cat = "ожирение ii+ 🔴"
            return "⚖️ имт: " + str(bmi_r) + "\n" + cat
        except Exception:
            return "⚖️ используй: .bmi - [...]"

    def _days(self, args):
        try:
            target = datetime.strptime(args.strip(), "%d.%m.%Y").date()
            today = date.today()
            delta = (target - today).days
            if delta > 0:
                return "📅 до " + args.strip() + " осталось " + str(delta) + " дн."
            elif delta < 0:
                return "📅 с " + args.strip() + " прошло " + str(abs(delta)) + " дн."
            else:
                return "📅 это сегодня! 🎉"
        except Exception:
            return "📅 используй: .days - [...]"

    def _temp(self, args):
        parts = args.split()
        try:
            val = float(parts[0])
            unit = parts[1].lower() if len(parts) > 1 else "c"
            if unit in ("c", "с", "°c"):
                f = val * 9/5 + 32
                k = val + 273.15
                return ("🌡️ " + str(val) + "°c\n"
                        + "= " + str(round(f, 2)) + "°f\n"
                        + "= " + str(round(k, 2)) + "k")
            elif unit in ("f", "°f"):
                c = (val - 32) * 5/9
                k = c + 273.15
                return ("🌡️ " + str(val) + "°f\n"
                        + "= " + str(round(c, 2)) + "°c\n"
                        + "= " + str(round(k, 2)) + "k")
            elif unit in ("k", "к"):
                c = val - 273.15
                f = c * 9/5 + 32
                return ("🌡️ " + str(val) + "k\n"
                        + "= " + str(round(c, 2)) + "°c\n"
                        + "= " + str(round(f, 2)) + "°f")
            else:
                return "🌡️ укажи единицу: c, f или k"
        except Exception:
            return "🌡️ используй: .temp - [...]"

    def _pass(self, args):
        try:
            length = min(max(4, int(args)), 64) if args else 12
        except Exception:
            length = 12
        letters = string.ascii_letters
        digits = string.digits
        symbols = "!@#$%&*"
        pool = letters + digits + symbols
        pwd_chars = [random.choice(letters), random.choice(digits), random.choice(symbols)]
        pwd_chars += [random.choice(pool) for _ in range(length - len(pwd_chars))]
        random.shuffle(pwd_chars)
        return "🔑 пароль: " + "".join(pwd_chars)

