TAB_ID = 10
CACHE_TTL = 300
DEFAULT_HISTORY_LIMIT = 100
MAX_HISTORY_LIMIT = 100000
MAX_CACHED_CHATS = 3
MAX_USERS_CACHE = 300
MAX_SCAN_PER_CHAT = 20000

PARTICIPANTS_PAGE = 200
MAX_PAGES = 100
FULL_WINDOW = 16
FULL_COUNT_WINDOW = 4
TICK_MS = 120
UI_INTERVAL = 0.2

# retry config
MAX_PAGE_RETRIES = 3
PAGE_RETRY_DELAY_MS = 1000

