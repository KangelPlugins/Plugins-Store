# Кнопка генерации в фоторедакторе опирается на хуки Java-методов клиента.
# Всё загружается мягко: если версия SDK старее и API хуков нет, плагин
# работает без кнопки, а команда .d и меню сообщения остаются на месте.
try:
    from base_plugin import MethodHook as _MethodHook
except Exception:
    _MethodHook = None
try:
    from hook_utils import find_class as _find_class
except Exception:
    _find_class = None
try:
    from android_utils import run_on_ui_thread as _run_on_ui
except Exception:
    _run_on_ui = None
try:
    from android_utils import OnClickListener as _OnClickListener
except Exception:
    _OnClickListener = None


class _PairingNeeded(RuntimeError):
    """Depth API требует подтвердить аккаунт через бота RSec.

    Сама привязка здесь не начинается: из-под полноэкранного редактора бот
    открывается незаметно, и подтвердить вход невозможно. Вызывающий сам
    решает, как провести привязку на виду у человека.
    """


if _MethodHook is not None:

    class _SendProbeHook(_MethodHook):
        """Пишет в журнал, какие пути уходят в отправку фото.

        Чисто наблюдательный хук: по его строкам видно, ушёл ли в отправку
        обработанный файл (`imagePath`) или оригинал (`path`).
        """

        def __init__(self, plugin):
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                self.plugin._log_send_args(param.args)
            except Exception:
                pass

    class _EditorToolbarHook(_MethodHook):
        """Дожидается сборки панели фоторедактора и вставляет свою кнопку.

        Панель инструментов (обрезка, поворот, кисть, HD, фильтры) собирается в
        ``PhotoViewer.setParentActivity``. После его выполнения ``itemsLayout``
        уже наполнен, и туда можно добавить ещё одну кнопку.
        """

        def __init__(self, plugin):
            self.plugin = plugin
            self._told = False

        def after_hooked_method(self, param):
            try:
                self.plugin._inject_editor_button(param.thisObject)
            except Exception as e:
                if not self._told:
                    self._told = True
                    self.plugin.log(f"editor button inject failed: {e}")

else:
    _EditorToolbarHook = None
    _SendProbeHook = None


