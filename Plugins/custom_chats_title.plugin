def _normalize_text(val: Any) -> str:
    return str(val).strip() if val is not None else ""

def _is_instance(obj: Any, class_name: str) -> bool:
    if not obj:
        return False
    try:
        clazz = obj.getClass()
        while clazz:
            name = clazz.getName()
            if name == class_name or name.endswith(f".{class_name.split('.')[-1]}"):
                return True
            clazz = clazz.getSuperclass()
    except Exception:
        pass
    return False

def _find_parent_stories_cell(view: Any) -> Any:
    try:
        parent = view.getParent() if view else None
        while parent:
            if _is_instance(parent, "DialogStoriesCell"):
                return parent
            if not hasattr(parent, "getParent"):
                break
            parent = parent.getParent()
    except Exception:
        pass
    return None

def _serialize_title_spans(val: Any) -> str:
    if not val:
        return ""
    try:
        from android.text import Spanned
        if isinstance(val, Spanned) or hasattr(val, "getSpans"):
            span_cls = find_class("org.telegram.ui.Components.AnimatedEmojiSpan")
            if span_cls:
                spans = val.getSpans(0, val.length(), span_cls)
                if spans and len(spans) > 0:
                    spans_info = []
                    for s in spans:
                        start = val.getSpanStart(s)
                        end = val.getSpanEnd(s)
                        doc_id = getattr(s, "documentId", 0) or getattr(getattr(s, "document", None), "id", 0) or get_private_field(s, "documentId")
                        if doc_id and start >= 0 and end > start:
                            spans_info.append((start, end, int(doc_id)))
                    if spans_info:
                        spans_info.sort(key=lambda x: x[0], reverse=True)
                        text_str = str(val)
                        for start, end, doc_id in spans_info:
                            fallback = text_str[start:end]
                            text_str = text_str[:start] + f'<emoji id="{doc_id}">{fallback}</emoji>' + text_str[end:]
                        return text_str
    except Exception:
        pass
    return str(val)

def _create_animated_emoji_span(doc_id: int) -> Any:
    span_cls = find_class("org.telegram.ui.Components.AnimatedEmojiSpan")
    if not span_cls:
        return None
    for args in ((doc_id, None), (doc_id, 1.0), (doc_id, 24, 0), (doc_id, 20), (doc_id,)):
        try:
            return span_cls(*args)
        except Exception:
            continue
    return None

def _parse_title_spans(text: str) -> Any:
    if not text or ("<emoji" not in text.lower() and "<e:" not in text.lower()):
        return text
    try:
        from android.text import SpannableString
        from android.text import Spanned
        clean_text = ""
        span_records = []
        last_idx = 0
        for match in EMOJI_REGEX.finditer(text):
            clean_text += text[last_idx:match.start()]
            doc_id = match.group(1) or match.group(3)
            fallback = match.group(2) if match.group(1) else match.group(4)
            if not fallback:
                fallback = "⭐️"
            start_idx = len(clean_text)
            clean_text += fallback
            end_idx = len(clean_text)
            if doc_id and doc_id.isdigit():
                span_records.append((start_idx, end_idx, int(doc_id)))
            last_idx = match.end()
        clean_text += text[last_idx:]
        if not span_records:
            return clean_text
        sp_str = SpannableString(clean_text)
        for start, end, doc_id in span_records:
            span_obj = _create_animated_emoji_span(doc_id)
            if span_obj:
                try:
                    sp_str.setSpan(span_obj, start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
                except Exception:
                    pass
        return sp_str
    except Exception:
        return EMOJI_REGEX.sub(lambda m: (m.group(2) if m.group(1) else m.group(4)) or "⭐️", text)

class SetTitleHook(MethodHook):
    def __init__(self, plugin: "CustomChatsHeaderPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not param or not param.thisObject or not param.args:
            return
        fragment = get_private_field(param.thisObject, "parentFragment")
        if not fragment or not _is_instance(fragment, "DialogsActivity"):
            return
        orig_title = _normalize_text(param.args[0])
        if not self.plugin._is_target_title(orig_title):
            return
        custom_text = self.plugin._get_custom_title_text(fragment)
        if custom_text:
            self.plugin._remember_default_title(orig_title)
            param.args[0] = self.plugin._get_custom_title_spanned(fragment)

class LocaleUtilsTitleHook(MethodHook):
    def __init__(self, plugin: "CustomChatsHeaderPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not param:
            return
        acc_arg = param.args[0] if param.args and len(param.args) > 0 else None
        custom_text = self.plugin._get_custom_title_text(acc_arg)
        if not custom_text:
            return
        orig_result = _normalize_text(param.getResult())
        if self.plugin._is_target_title(orig_result):
            self.plugin._remember_default_title(orig_result)
            sig = str(getattr(param, "method", "unknown"))
            if sig not in self.plugin._seen_locale_signatures:
                self.plugin._seen_locale_signatures.add(sig)
                self.plugin.log(f"LocaleUtils.getActionBarTitle intercepted: {sig}")
            param.setResult(self.plugin._get_custom_title_spanned(acc_arg))

class TitleOverlayHook(MethodHook):
    def __init__(self, plugin: "CustomChatsHeaderPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not param or not param.thisObject or not param.args:
            return
        fragment = get_private_field(param.thisObject, "parentFragment")
        if not fragment or not _is_instance(fragment, "DialogsActivity"):
            return
        overlay_title = _normalize_text(param.args[0])
        if not overlay_title or not self.plugin._is_target_title(overlay_title):
            return
        custom_text = self.plugin._get_custom_title_text(fragment)
        if custom_text and overlay_title != custom_text:
            self.plugin._remember_default_title(overlay_title)
            param.args[0] = self.plugin._get_custom_title_spanned(fragment)

class DialogsLifecycleHook(MethodHook):
    def __init__(self, plugin: "CustomChatsHeaderPlugin", hook_name: str):
        self.plugin = plugin
        self.hook_name = hook_name

    def after_hooked_method(self, param):
        fragment = param.thisObject if param else None
        self.plugin._apply_title_to_fragment(fragment, f"DialogsActivity.{self.hook_name}")

class DialogsTitleOverlayHook(MethodHook):
    def __init__(self, plugin: "CustomChatsHeaderPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        fragment = param.thisObject if param else None
        if fragment and _is_instance(fragment, "DialogsActivity"):
            cell = get_private_field(fragment, "dialogStoriesCell")
            if cell:
                self.plugin._apply_title_to_stories_cell(cell, "DialogsActivity overlay", immediate=True)

class StoriesCellOverlayHook(MethodHook):
    def __init__(self, plugin: "CustomChatsHeaderPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if param and param.thisObject:
            self.plugin._apply_title_to_stories_cell(param.thisObject, "DialogStoriesCell overlay", immediate=True)

class StoriesCellUpdateItemsHook(MethodHook):
    def __init__(self, plugin: "CustomChatsHeaderPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not param or not param.thisObject:
            return
        animated = bool(param.args[0]) if param.args and len(param.args) >= 1 else False
        self.plugin._apply_title_to_stories_cell(param.thisObject, "DialogStoriesCell updateItems", animated=animated, immediate=True)

class StoriesAnimatedTextHook(MethodHook):
    def __init__(self, plugin: "CustomChatsHeaderPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not param or not param.thisObject or not param.args:
            return
        orig_title = _normalize_text(param.args[0])
        if not self.plugin._is_target_title(orig_title):
            return
        custom_text = self.plugin._get_custom_title_text(param.thisObject)
        if not custom_text or not self.plugin._is_stories_title_view(param.thisObject):
            return
        if orig_title and orig_title != custom_text:
            self.plugin._remember_default_stories_title(orig_title)
        param.args[0] = self.plugin._get_custom_title_spanned(param.thisObject)
        if not self.plugin._stories_title_logged:
            self.plugin._stories_title_logged = True
            self.plugin.log("Stories titleView.setText intercepted.")

class StoriesAnimatedDrawableTextHook(MethodHook):
    def __init__(self, plugin: "CustomChatsHeaderPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not param or not param.thisObject or not param.args:
            return
        orig_title = _normalize_text(param.args[0])
        if not self.plugin._is_target_title(orig_title):
            return
        custom_text = self.plugin._get_custom_title_text(param.thisObject)
        if not custom_text:
            return
        cb_view = getattr(param.thisObject, "getCallback", lambda: None)()
        if not self.plugin._is_stories_title_view(cb_view):
            return
        if orig_title and orig_title != custom_text:
            self.plugin._remember_default_stories_title(orig_title)
        cell = _find_parent_stories_cell(cb_view)
        spanned = self.plugin._get_custom_title_spanned(param.thisObject)
        if cell:
            try:
                set_private_field(cell, "currentTitle", spanned)
            except Exception:
                pass
        param.args[0] = spanned
        if not self.plugin._stories_drawable_logged:
            self.plugin._stories_drawable_logged = True
            self.plugin.log("Stories title drawable.setText intercepted.")

class CustomChatsHeaderPlugin(BasePlugin):
    def _reset_runtime_state(self):
        self._unhooks = []
        self._seen_locale_signatures = set()
        self._dialogs_default_title = ""
        self._stories_default_title = ""
        self._last_custom_title = ""
        self._last_custom_titles = {}
        self._stories_title_logged = False
        self._stories_drawable_logged = False
        self._locale_utils_class = None
        self._locale_controller_class = None

    def _get_current_account_id(self, context_obj: Any = None) -> int:
        if context_obj is not None:
            if isinstance(context_obj, (int, float)):
                return int(context_obj)
            try:
                from java.lang import Integer, Long
                if isinstance(context_obj, (Integer, Long)):
                    return int(context_obj.intValue())
            except Exception:
                pass
            try:
                acc = getattr(context_obj, "currentAccount", None) or get_private_field(context_obj, "currentAccount")
                if acc is not None:
                    return int(acc)
            except Exception:
                pass
        try:
            from client_utils import get_user_config
            cfg = get_user_config()
            if cfg and hasattr(cfg, "selectedAccount"):
                return int(cfg.selectedAccount)
        except Exception:
            pass
        try:
            from org.telegram.messenger import UserConfig
            return int(UserConfig.selectedAccount)
        except Exception:
            return 0

    def _get_setting_key(self, acc_id: int = 0) -> str:
        return SETTING_KEY if acc_id == 0 else f"{SETTING_KEY}_{acc_id}"

    def _get_custom_title_raw(self, context_obj: Any = None) -> str:
        acc_id = self._get_current_account_id(context_obj)
        return _normalize_text(self.get_setting(self._get_setting_key(acc_id), ""))

    def _get_custom_title_text(self, context_obj: Any = None) -> str:
        raw = self._get_custom_title_raw(context_obj)
        return EMOJI_REGEX.sub(lambda m: (m.group(2) if m.group(1) else m.group(4)) or "⭐️", raw)

    def _get_custom_title_spanned(self, context_obj: Any = None) -> Any:
        raw = self._get_custom_title_raw(context_obj)
        return _parse_title_spans(raw) if raw else ""

    def _get_last_custom_title(self, acc_id: int = 0) -> str:
        if not hasattr(self, "_last_custom_titles") or not isinstance(self._last_custom_titles, dict):
            self._last_custom_titles = {}
        return self._last_custom_titles.get(acc_id, getattr(self, "_last_custom_title", ""))

    def _set_last_custom_title(self, acc_id: int, title: str):
        if not hasattr(self, "_last_custom_titles") or not isinstance(self._last_custom_titles, dict):
            self._last_custom_titles = {}
        self._last_custom_titles[acc_id] = title
        self._last_custom_title = title

    def _get_lang(self) -> str:
        try:
            from java.util import Locale
            if str(Locale.getDefault().getLanguage() or "").lower().startswith("ru"):
                return "ru"
        except Exception:
            pass
        return "en"

    def _t(self, key: str, **kwargs: Any) -> str:
        text = I18N.get(self._get_lang(), {}).get(key) or I18N["en"].get(key) or key
        return text.format(**kwargs) if kwargs else text

    def _get_current_fragment(self) -> Any:
        try:
            return get_last_fragment() if get_last_fragment else None
        except Exception:
            return None

    def _get_current_activity(self, view: Any = None) -> Any:
        if view:
            try:
                ctx = view.getContext()
                if ctx:
                    return ctx
            except Exception:
                pass
        frag = self._get_current_fragment()
        try:
            return frag.getParentActivity() if frag else None
        except Exception:
            return None

    def _show_bulletin(self, message: str, kind: str = "info"):
        try:
            frag = self._get_current_fragment()
            if kind == "error":
                BulletinHelper.show_error(message, frag)
            elif kind == "success":
                BulletinHelper.show_success(message, frag)
            else:
                BulletinHelper.show_info(message, frag)
        except Exception:
            self.log(message)

    def _copy_to_clipboard(self, label: str, text: str, view: Any = None) -> bool:
        try:
            from android.content import ClipData, Context
            act = self._get_current_activity(view)
            if not act:
                return False
            cb = act.getSystemService(Context.CLIPBOARD_SERVICE)
            if not cb:
                return False
            cb.setPrimaryClip(ClipData.newPlainText(label, text))
            return True
        except Exception as e:
            self.log(f"Clipboard error: {e}")
            return False

    def _open_url(self, url: str, view: Any = None) -> bool:
        try:
            from android.content import Intent
            from android.net import Uri
            act = self._get_current_activity(view)
            if not act:
                return False
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            act.startActivity(intent)
            return True
        except Exception as e:
            self.log(f"URL open error ({url}): {e}")
            return False

    def _handle_url_click(self, url: str, label_key: str, view: Any = None):
        if self._open_url(url, view):
            return
        if self._copy_to_clipboard(self._t(label_key), url, view):
            self._show_bulletin(self._t("bio_open_failed"), kind="info")
        else:
            self._show_bulletin(self._t("bio_copy_failed"), kind="error")

    def _on_tg_click(self, view: Any = None):
        self._handle_url_click(TG_URL, "tg_clipboard_label", view)

    def _on_bio1_click(self, view: Any = None):
        self._handle_url_click(BIO1_URL, "bio1_clipboard_label", view)

    def _on_bio2_click(self, view: Any = None):
        self._handle_url_click(BIO2_URL, "bio2_clipboard_label", view)

    def _get_active_or_last_custom_title(self, context_obj: Any = None) -> str:
        return self._get_custom_title_text(context_obj) or self._get_last_custom_title(self._get_current_account_id(context_obj))

    def _strip_stale_custom_title(self, title: Any, context_obj: Any = None) -> str:
        norm = _normalize_text(title)
        return "" if not norm or norm == self._get_active_or_last_custom_title(context_obj) else norm

    def _is_network_status(self, title: str) -> bool:
        t = _normalize_text(title).lower()
        if t.endswith("...") or t.endswith("…"):
            return True
        return any(w in t for w in ("connect", "updat", "wait", "соединени", "обновлени", "ожидани", "поиск"))

    def _is_target_title(self, title: str) -> bool:
        if not title or self._is_network_status(title):
            return False
        if title.lower() in {"exteragram", "ayugram", "telegram"}:
            return True
        cached = self._strip_stale_custom_title(self._dialogs_default_title)
        return bool(cached and title == cached)

    def _remember_default_value(self, title: Any, attr_name: str, label: str):
        norm = self._strip_stale_custom_title(title)
        if norm and not self._is_network_status(norm) and norm != getattr(self, attr_name):
            setattr(self, attr_name, norm)
            self.log(f"Remembered default {label}: {norm}")

    def _remember_default_title(self, title: Any):
        self._remember_default_value(title, "_dialogs_default_title", "chats title")

    def _remember_default_stories_title(self, title: Any):
        self._remember_default_value(title, "_stories_default_title", "stories title")

    def _is_rtl(self) -> bool:
        try:
            return bool(self._locale_controller_class.isRTL) if self._locale_controller_class else False
        except Exception:
            return False

    def _get_live_default_dialogs_title(self, fragment: Any) -> str:
        if not self._locale_utils_class:
            return ""
        acc = getattr(fragment, "currentAccount", None) or get_private_field(fragment, "currentAccount")
        for args in ((acc,) if acc is not None else tuple(), tuple()):
            try:
                title = _normalize_text(self._locale_utils_class.getActionBarTitle(*args))
                if title and title != self._get_active_or_last_custom_title():
                    self._remember_default_title(title)
                    return title
            except Exception:
                continue
        return ""

    def _is_stories_title_view(self, view: Any) -> bool:
        if not view:
            return False
        cell = _find_parent_stories_cell(view)
        try:
            return cell is not None and get_private_field(cell, "titleView") == view
        except Exception:
            return False

    def _resolve_title(self, obj: Any, default_attr: str, remember_func: Any, live_func: Any, force_default: bool) -> str:
        field_name = "actionBarDefaultTitle" if default_attr == "_dialogs_default_title" else "currentTitle"
        cur_default = self._strip_stale_custom_title(get_private_field(obj, field_name), obj)
        if cur_default and not force_default:
            remember_func(cur_default)
        cached = self._strip_stale_custom_title(getattr(self, default_attr), obj)
        if force_default:
            return live_func(obj) or cached or cur_default
        custom = self._get_custom_title_text(obj)
        if custom:
            return custom
        if not cached and not cur_default:
            live = live_func(obj)
            if live:
                return live
        return cached or cur_default

    def _resolve_title_for_fragment(self, fragment: Any, force_default: bool = False) -> str:
        return self._resolve_title(fragment, "_dialogs_default_title", self._remember_default_title, self._get_live_default_dialogs_title, force_default)

    def _refresh_stories_default_title(self, cell: Any) -> str:
        cur = self._strip_stale_custom_title(get_private_field(cell, "currentTitle"))
        if cur:
            self._remember_default_stories_title(cur)
        try:
            cell.updateItems(False, True)
        except Exception:
            pass
        refreshed = self._strip_stale_custom_title(get_private_field(cell, "currentTitle"))
        if refreshed:
            self._remember_default_stories_title(refreshed)
        return self._strip_stale_custom_title(self._stories_default_title) or refreshed or cur

    def _resolve_title_for_stories_cell(self, cell: Any, force_default: bool = False) -> str:
        return self._resolve_title(cell, "_stories_default_title", self._remember_default_stories_title, self._refresh_stories_default_title, force_default)

    def _set_stories_title_view_text(self, title_view: Any, title: Any, animated: bool):
        try:
            title_view.setText(title, bool(animated) and not self._is_rtl())
        except Exception:
            title_view.setText(title)

    def _apply_title_to_stories_cell(self, cell: Any, source: str, force_default: bool = False, animated: bool = False, immediate: bool = False):
        def _task():
            try:
                if not cell or not _is_instance(cell, "DialogStoriesCell"):
                    return
                title_view = get_private_field(cell, "titleView")
                if not title_view:
                    return
                cur_title = _normalize_text(get_private_field(cell, "currentTitle"))
                custom_text = self._get_custom_title_text(cell)
                last_custom = _normalize_text(self._get_last_custom_title(self._get_current_account_id(cell)))
                is_main = (cur_title == custom_text and custom_text) or (last_custom and cur_title == last_custom) or self._is_target_title(cur_title)
                if not is_main and not force_default:
                    return
                final_title = self._resolve_title_for_stories_cell(cell, force_default=force_default)
                if not final_title or (cur_title == final_title and not force_default):
                    return
                spanned = self._get_custom_title_spanned(cell) if (final_title == custom_text and custom_text and not force_default) else final_title
                set_private_field(cell, "currentTitle", spanned)
                display_title = spanned if (getattr(cell, "hasOverlayText", False) or get_private_field(cell, "hasOverlayText")) and not force_default and custom_text else spanned
                self._set_stories_title_view_text(title_view, display_title, animated)
                animator = get_private_field(cell, "animatorHasTitleText")
                if animator:
                    try:
                        animator.setValue(bool(display_title), bool(animated))
                    except Exception:
                        pass
            except Exception as e:
                self.log(f"{source} stories apply error: {e}")

        _task() if immediate else run_on_ui_thread(_task)

    def _apply_title_to_fragment(self, fragment: Any, source: str, force_default: bool = False):
        def _task():
            try:
                if not fragment or not _is_instance(fragment, "DialogsActivity"):
                    return
                action_bar = get_private_field(fragment, "actionBar")
                if not action_bar:
                    return
                title = self._resolve_title_for_fragment(fragment, force_default=force_default)
                if not title:
                    return
                cur_title = _normalize_text(action_bar.getTitle())
                custom_text = self._get_custom_title_text(fragment)
                last_custom = _normalize_text(self._get_last_custom_title(self._get_current_account_id(fragment)))
                is_main = (cur_title == custom_text and custom_text) or (last_custom and cur_title == last_custom) or self._is_target_title(cur_title)

                if is_main or force_default:
                    if cur_title != title or force_default:
                        status_drw = get_private_field(fragment, "statusDrawable")
                        spanned = self._get_custom_title_spanned(fragment) if (title == custom_text and custom_text and not force_default) else title
                        action_bar.setTitle(spanned, status_drw) if status_drw else action_bar.setTitle(spanned)
                        set_private_field(fragment, "actionBarDefaultTitle", title)
                if getattr(action_bar, "titleOverlayShown", False) or get_private_field(action_bar, "titleOverlayShown"):
                    ov_data = get_private_field(action_bar, "overlayTitleToSet")
                    if ov_data and len(ov_data) >= 3:
                        ov_title = _normalize_text(ov_data[0])
                        if self._is_target_title(ov_title) or ov_title == custom_text:
                            def_ov = self._get_live_default_dialogs_title(fragment) or self._strip_stale_custom_title(self._dialogs_default_title)
                            action_bar.setTitleOverlayText((def_ov or ov_title) if force_default else title, ov_data[1], ov_data[2])
                cell = get_private_field(fragment, "dialogStoriesCell")
                if cell:
                    self._apply_title_to_stories_cell(cell, f"{source} stories", force_default=force_default, immediate=True)
            except Exception as e:
                self.log(f"{source} apply error: {e}")

        run_on_ui_thread(_task)

    def _get_all_dialogs_activities(self) -> List[Any]:
        results = []
        frag = self._get_current_fragment()
        if frag:
            if _is_instance(frag, "DialogsActivity"):
                results.append(frag)
            try:
                layout = getattr(frag, "getParentLayout", lambda: None)() or getattr(frag, "parentLayout", None) or get_private_field(frag, "parentLayout")
                if layout:
                    stack = getattr(layout, "fragmentsStack", None) or get_private_field(layout, "fragmentsStack")
                    if stack:
                        for f in stack:
                            if f and _is_instance(f, "DialogsActivity") and f not in results:
                                results.append(f)
            except Exception:
                pass
        try:
            from org.telegram.ui import LaunchActivity
            if hasattr(LaunchActivity, "instance") and LaunchActivity.instance:
                act = LaunchActivity.instance
                for field_name in ("mainFragmentsStack", "rightFragmentsStack", "layersActionBarLayout"):
                    try:
                        stack = getattr(act, field_name, None) or get_private_field(act, field_name)
                        if stack:
                            if isinstance(stack, list) or hasattr(stack, "__iter__"):
                                for f in stack:
                                    if f and _is_instance(f, "DialogsActivity") and f not in results:
                                        results.append(f)
                            elif _is_instance(stack, "ActionBarLayout"):
                                sub_stack = getattr(stack, "fragmentsStack", None) or get_private_field(stack, "fragmentsStack")
                                if sub_stack:
                                    for f in sub_stack:
                                        if f and _is_instance(f, "DialogsActivity") and f not in results:
                                            results.append(f)
                    except Exception:
                        pass
        except Exception:
            pass
        return results

    def _apply_title_immediately(self, force_default: bool = False):
        activities = self._get_all_dialogs_activities()
        if not activities and get_last_fragment:
            frag = self._get_current_fragment()
            if frag:
                activities.append(frag)
        for frag in activities:
            self._apply_title_to_fragment(frag, "Immediate apply", force_default=force_default)

    def _make_on_change_handler(self, acc_id: int):
        return lambda val: self._on_account_title_change(acc_id, val)

    def _on_account_title_change(self, acc_id: int, new_value: Any):
        serialized = _serialize_title_spans(new_value)
        key = self._get_setting_key(acc_id)
        self.set_setting(key, serialized)
        title = _normalize_text(self._get_custom_title_text()) if acc_id == 0 else _normalize_text(EMOJI_REGEX.sub(lambda m: (m.group(2) if m.group(1) else m.group(4)) or "⭐️", serialized))
        self._set_last_custom_title(acc_id, title)
        self.log(f"Account {acc_id} ({key}) -> {'cleared' if not title else title}")
        self._apply_title_immediately(force_default=not bool(title))

    def _on_custom_title_change(self, new_value: Any):
        self._on_account_title_change(0, new_value)

    def _hook(self, cls: Any, method_name: str, hook_inst: Any, label: str):
        try:
            unhooks = self.hook_all_methods(cls, method_name, hook_inst)
            if unhooks:
                self._unhooks.extend(unhooks)
                self.log(f"Hooked {label} ({len(unhooks)})")
        except Exception as e:
            self.log(f"Failed to hook {label}: {e}")

    def on_plugin_load(self):
        self._reset_runtime_state()
        self.log("Loading Custom Chats Header v2.1.0")
        self._locale_controller_class = find_class("org.telegram.messenger.LocaleController")
        self._locale_utils_class = find_class("com.exteragram.messenger.utils.LocaleUtils")

        act_bar_cls = find_class("org.telegram.ui.ActionBar.ActionBar")
        if act_bar_cls:
            self._hook(act_bar_cls, "setTitle", SetTitleHook(self), "ActionBar.setTitle")
            self._hook(act_bar_cls, "setTitleOverlayText", TitleOverlayHook(self), "ActionBar.setTitleOverlayText")

        if self._locale_utils_class:
            self._hook(self._locale_utils_class, "getActionBarTitle", LocaleUtilsTitleHook(self), "LocaleUtils.getActionBarTitle")

        dialogs_cls = find_class("org.telegram.ui.DialogsActivity")
        if dialogs_cls:
            self._hook(dialogs_cls, "setTitleOverlayText", DialogsTitleOverlayHook(self), "DialogsActivity.setTitleOverlayText")
            self._hook(dialogs_cls, "onResume", DialogsLifecycleHook(self, "onResume"), "DialogsActivity.onResume")
            self._hook(dialogs_cls, "onBecomeFullyVisible", DialogsLifecycleHook(self, "onBecomeFullyVisible"), "DialogsActivity.onBecomeFullyVisible")

        stories_cls = find_class("org.telegram.ui.Stories.DialogStoriesCell")
        if stories_cls:
            self._hook(stories_cls, "setTitleOverlayText", StoriesCellOverlayHook(self), "DialogStoriesCell.setTitleOverlayText")
            self._hook(stories_cls, "updateItems", StoriesCellUpdateItemsHook(self), "DialogStoriesCell.updateItems")

        anim_cls = find_class("org.telegram.ui.Components.AnimatedTextView")
        if anim_cls:
            self._hook(anim_cls, "setText", StoriesAnimatedTextHook(self), "AnimatedTextView.setText")

        drw_cls = find_class("org.telegram.ui.Components.AnimatedTextView$AnimatedTextDrawable")
        if drw_cls:
            self._hook(drw_cls, "setText", StoriesAnimatedDrawableTextHook(self), "AnimatedTextDrawable.setText")

        self.log(f"Total hooks registered: {len(self._unhooks)}")
        cur = self._get_custom_title_text()
        if cur:
            self._set_last_custom_title(self._get_current_account_id(), cur)
            self._apply_title_immediately()

    def on_plugin_unload(self):
        for u in self._unhooks:
            try:
                self.unhook_method(u)
            except Exception:
                pass
        self._apply_title_immediately(force_default=True)
        self._reset_runtime_state()
        self.log("Custom Header unloaded.")

    def _get_active_accounts(self) -> List[Tuple[int, str]]:
        accounts = []
        try:
            from org.telegram.messenger import UserConfig
            for i in range(16):
                cfg = UserConfig.getInstance(i)
                if not cfg or not cfg.isClientActivated():
                    continue
                user = cfg.getCurrentUser()
                name = f"{self._t('settings_account_prefix', default='Account')} {i+1}"
                if user:
                    full = f"{getattr(user, 'first_name', '') or ''} {getattr(user, 'last_name', '') or ''}".strip()
                    if full:
                        name = f"{full} (#{i+1})"
                accounts.append((i, name))
        except Exception as e:
            self.log(f"Accounts scan error: {e}")
        return accounts or [(0, f"{self._t('settings_account_prefix', default='Account')} 1")]

    def create_settings(self) -> List[Any]:
        items = [Header(text=self._t("settings_header"))]
        active_accs = self._get_active_accounts()
        multi = len(active_accs) > 1

        for acc_id, acc_name in active_accs:
            items.append(
                Input(
                    key=self._get_setting_key(acc_id),
                    text=f"{self._t('settings_input_text')} • {acc_name}" if multi else self._t("settings_input_text"),
                    default="",
                    subtext=f"{self._t('settings_input_subtext')} ({acc_name})" if multi else self._t("settings_input_subtext"),
                    icon="msg_text",
                    on_change=self._make_on_change_handler(acc_id),
                    link_alias=f"custom_chats_header_input_{acc_id}" if multi else "custom_chats_header_input",
                )
            )

        items.extend([
            Divider(text=self._t("settings_hint")),
            Header(text=self._t("about_header")),
            Text(
                text=self._t("suggestions_text"),
                subtext=self._t("suggestions_subtext"),
                icon="msg_discuss",
                accent=True,
                on_click=self._on_tg_click,
                link_alias="custom_chats_header_suggestions",
            ),
            Text(
                text=self._t("bio1_text"),
                subtext=self._t("bio1_subtext"),
                icon="msg_info",
                accent=False,
                on_click=self._on_bio1_click,
                link_alias="custom_chats_header_bio1",
            ),
            Text(
                text=self._t("bio2_text"),
                subtext=self._t("bio2_subtext"),
                icon="msg_info",
                accent=False,
                on_click=self._on_bio2_click,
                link_alias="custom_chats_header_bio2",
            ),
            Divider(text=self._t("bio_footer")),
        ])
        return items