    def __init__(self):
        self.language = Locale.getDefault().getLanguage()
        self.language = self.language if self.language in self.strings else "en"

    def get_string(self, key):
        return self.strings[self.language].get(key, self.strings["en"].get(key, key))


localization = LocalizationManager()


class FakeDNSHTTPSConnection(http.client.HTTPSConnection):
    def __init__(self, host, port=443, real_ip=None, proxy=None, **kwargs):
        super().__init__(host, port, **kwargs)
        self.real_ip = real_ip
        self.proxy = proxy

    def connect(self):
        target_ip = self.real_ip or self.host

        if self.proxy:
            proxy_host, proxy_port = self.proxy
            sock = socket.create_connection((proxy_host, proxy_port), self.timeout)
            req = f"CONNECT {target_ip}:{self.port} HTTP/1.1\r\n" f"Host: {target_ip}:{self.port}\r\n" f"Connection: keep-alive\r\n\r\n"
            sock.sendall(req.encode())

            resp = b""
            while b"\r\n\r\n" not in resp:
                chunk = sock.recv(4096)
                if not chunk:
                    raise ConnectionError("Прокси разорвал соединение во время CONNECT")
                resp += chunk
            status_line = resp.split(b"\r\n", 1)[0]
            if b" 200 " not in status_line:
                raise ConnectionError(f"Прокси отклонил CONNECT: {status_line!r}")
        else:
            sock = socket.create_connection((target_ip, self.port), self.timeout)

        context = ssl.create_default_context()
        self.sock = context.wrap_socket(sock, server_hostname=self.host)


class FakeDNSAdapter(HTTPAdapter):
    def __init__(self, hosts_map, proxy_dict=None, *args, **kwargs):
        self.hosts_map = hosts_map
        self.proxy_dict = proxy_dict or {}
        super().__init__(*args, **kwargs)

    def send(self, request, **kwargs):
        url = urlparse(request.url)
        host = url.hostname

        if host not in self.hosts_map:
            return super().send(request, **kwargs)

        real_ip = self.hosts_map[host]
        port = url.port or (443 if url.scheme == "https" else 80)

        proxy = None
        proxy_url = self.proxy_dict.get(url.scheme)
        if proxy_url:
            p = urlparse(proxy_url)
            proxy = (p.hostname, p.port or 8080)

        timeout = kwargs.get("timeout")
        if isinstance(timeout, tuple):
            timeout = timeout[-1]

        conn = FakeDNSHTTPSConnection(host, port, real_ip=real_ip, proxy=proxy, timeout=timeout or 30)

        path = url.path or "/"
        if url.query:
            path += "?" + url.query

        headers = dict(request.headers)
        headers["Host"] = host

        conn.request(request.method, path, body=request.body, headers=headers)
        raw = conn.getresponse()
        data = raw.read()

        resp_headers = CaseInsensitiveDict(raw.getheaders())
        encoding = resp_headers.get("Content-Encoding", "").lower()
        if encoding == "gzip":
            data = gzip.decompress(data)
        elif encoding == "deflate":
            try:
                data = zlib.decompress(data)
            except zlib.error:
                data = zlib.decompress(data, -zlib.MAX_WBITS)
        if encoding in ("gzip", "deflate"):
            del resp_headers["Content-Encoding"]

        response = requests.Response()
        response.status_code = raw.status
        response.headers = CaseInsensitiveDict(raw.getheaders())
        response._content = data
        response.url = request.url
        response.request = request
        response.reason = raw.reason
        response.encoding = requests.utils.get_encoding_from_headers(response.headers)
        return response


def get_proxy_list_from_url(url):  # Credits: BooruSearch by @ArThirtyFour
    try:
        response = requests.get(url, timeout=10)
        response.raise_for_status()

        raw_proxies = [line.strip() for line in response.text.split("\n") if line.strip()]

        proxies = []
        for proxy in raw_proxies:
            norm = normalize_proxy_url(proxy)
            if norm:
                proxies.append(norm)

        return proxies
    except Exception:
        return []


def normalize_proxy_url(raw):  # Credits: BooruSearch by @ArThirtyFour
    try:
        if raw is None:
            return None
        s = str(raw).strip()
        if not s:
            return None

        if s.startswith("http://") or s.startswith("https://") or s.startswith("socks4://") or s.startswith("socks5://"):
            return s

        parts = s.split(":")
        if len(parts) == 2:
            host, port = parts
            if host and port:
                return f"http://{host}:{port}"
            return None

        if len(parts) == 4:
            host, port, user, pwd = parts
            if host and port and user and pwd:
                return f"http://{user}:{pwd}@{host}:{port}"
            return None

        return None
    except Exception:
        return None


def check_proxies_parallel(proxies, max_workers=50, max_working=20):  # Credits: BooruSearch by @ArThirtyFour
    working_proxies = []
    working_proxies_lock = threading.Lock()
    stop_search = threading.Event()

    def check_proxy_wrapper(proxy):
        if stop_search.is_set():
            return proxy, False, 0

        proxy, is_working, response_time = check_single_proxy(proxy)

        if is_working:
            with working_proxies_lock:
                working_proxies.append({"proxy": proxy, "response_time": response_time})

                if len(working_proxies) >= max_working:
                    stop_search.set()

        return proxy, is_working, response_time

    with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
        future_to_proxy = {executor.submit(check_proxy_wrapper, proxy): proxy for proxy in proxies}

        for _ in concurrent.futures.as_completed(future_to_proxy):
            if stop_search.is_set():
                for f in future_to_proxy:
                    f.cancel()
                break

    return working_proxies


def check_single_proxy(proxy):  # Credits: BooruSearch by @ArThirtyFour
    start_time = time.time()

    try:
        proxy_dict = build_requests_proxies(proxy)
        if not proxy_dict:
            return proxy, False, 0

        response = requests.get("https://deepgram.com/", proxies=proxy_dict, timeout=3)

        if response.status_code == 200:
            response_time = time.time() - start_time
            return proxy, True, response_time
        else:
            return proxy, False, 0

    except Exception:
        return proxy, False, 0


def build_requests_proxies(proxy_url):  # Credits: BooruSearch by @ArThirtyFour
    p = normalize_proxy_url(proxy_url)
    if not p:
        return None
    return {"http": p, "https": p}


def save_working_proxies_to_file(working_proxies, filename="transcriber_proxies.json"):
    try:
        data_dir = ApplicationLoader.getFilesDirFixed()
        file_path = os.path.join(str(data_dir), filename)

        with open(file_path, "w", encoding="utf-8") as f:
            json.dump(working_proxies, f, ensure_ascii=False, indent=2)
    except Exception as e:
        log(f"[Transcriber] Ошибка при сохранении файла: {e}")


def get_working_proxy(test_url: str = "https://deepgram.com/", rotate_ua: bool = True):  # Credits: BooruSearch by @ArThirtyFour
    try:
        working_proxies = load_working_proxies_from_file()

        if working_proxies:
            for proxy_info in working_proxies[:5]:
                proxy = proxy_info["proxy"]
                proxy_dict = build_requests_proxies(proxy)
                if not proxy_dict:
                    continue
                headers = get_request_headers(rotate_ua)

                try:
                    test_response = requests.get(test_url, proxies=proxy_dict, headers=headers, timeout=5)
                    if test_response.status_code == 200:
                        return proxy_dict
                except Exception:
                    continue

        log("[Transcriber] Рабочие прокси не найдены")
        return None

    except Exception:
        return None


def load_working_proxies_from_file(filename="transcriber_proxies.json"):  # Credits: BooruSearch by @ArThirtyFour
    try:
        data_dir = ApplicationLoader.getFilesDirFixed()
        file_path = os.path.join(str(data_dir), filename)

        if os.path.exists(file_path):
            with open(file_path, "r", encoding="utf-8") as f:
                working_proxies = json.load(f)
            return working_proxies
        else:
            return []
    except Exception:
        return []


def get_request_headers(rotate_ua: bool = True) -> dict:  # Credits: BooruSearch by @ArThirtyFour
    headers = {
        "Accept": "application/json",
        "Accept-Encoding": "gzip, deflate",
    }

    if rotate_ua:
        headers["User-Agent"] = random.choice(USER_AGENTS)
    else:
        headers["User-Agent"] = USER_AGENTS[0]

    return headers


class TranscriberPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            TranscribeButton = find_class("org.telegram.ui.Components.TranscribeButton")
            ChatActivity = find_class("org.telegram.ui.ChatActivity")
            TLRPC = find_class("org.telegram.tgnet.TLRPC")

            jboolean = Boolean.TYPE
            jfloat = Float.TYPE

            onTap = TranscribeButton.getClass().getDeclaredMethod("onTap")
            onTap.setAccessible(True)
            self.hook_method(onTap, self.CreateTranscribeButtonHook(self))

            onResume = ChatActivity.getClass().getDeclaredMethod("onResume")
            onResume.setAccessible(True)
            self.hook_method(onResume, self.ActivityResumeHook(self))

            applyAppConfig = get_messages_controller().getClass().getDeclaredMethod("applyAppConfig", TLRPC.TL_jsonObject)
            applyAppConfig.setAccessible(True)
            self.hook_method(applyAppConfig, self.ApplyAppConfigHook(self))

            createMenu = ChatActivity.getClass().getDeclaredMethod("createMenu", View, jboolean, jboolean, jfloat, jfloat, jboolean, jboolean)
            createMenu.setAccessible(True)
            self.hook_method(createMenu, self.CreateMenuHook(self))

            # Force enable transcription button (in case chat was opened before hooks worked)
            self.enable_transcription_button()

        except Exception as e:
            error_prefix = localization.get_string("error_load")
            self.show_error_with_button(str(e), error_prefix)
            self.log(f"[Transcriber] Load error: {e}")

        return super().on_plugin_load()

    def create_settings(self):
        model = self.get_setting("model", 2)
        settings = [
            Header(text=localization.get_string("header_settings")),
            Selector(
                key="model",
                text=localization.get_string("settings_model"),
                default=2,
                items=MODELS,
                icon="menu_feature_voice",
            ),
            Switch(
                key="separate_speakers",
                text=localization.get_string("settings_separate_speakers"),
                default=True,
                subtext=localization.get_string("settings_separate_speakers_subtext"),
                icon="msg_groups",
            ),
        ]

        if model in (3, 4):
            settings.extend(
                [
                    Switch(
                        key="thinking_mode",
                        text=localization.get_string("settings_thinking_mode"),
                        default=False,
                        subtext=localization.get_string("settings_thinking_mode_subtext"),
                        icon="msg_emoji_objects",
                    ),
                ]
            )

        settings.append(
            Text(
                text=localization.get_string("settings_advanced"),
                icon="msg_photo_settings",
                create_sub_fragment=self.create_advanced_settings,
            )
        )

        if model == 2:
            settings.extend(
                [
                    Header(text=localization.get_string("header_warning")),
                    Text(
                        text=localization.get_string("warning_mistral_phone"),
                        icon="msg_report",
                        accent=True,
                        on_click=lambda _: run_on_ui_thread(BulletinHelper.show_info(localization.get_string("warning_mistral_phone"))),
                    ),
                ]
            )
        elif model in (3, 4) and Locale.getDefault().getLanguage() == "ru":
            settings.extend(
                [
                    Header(text=localization.get_string("header_warning")),
                    Text(
                        text=localization.get_string("warning_gemini_vpn"),
                        icon="msg_report",
                        accent=True,
                        on_click=lambda _: run_on_ui_thread(BulletinHelper.show_info(localization.get_string("warning_gemini_vpn"))),
                    ),
                ]
            )

        settings.append(Header(text=localization.get_string("header_token")))
        if model == 0:
            settings.extend(
                [
                    Input(
                        key="token_assemblyai",
                        text=localization.get_string("token_token"),
                        icon="menu_privacy" if len(self.get_setting("token_assemblyai", "")) > 0 else "menu_unlock",
                    ),
                    Text(
                        text=localization.get_string("token_get_token"),
                        icon="msg_openin",
                        on_click=self.open_token_page,
                        red=len(self.get_setting("token_assemblyai", "")) <= 0,
                    ),
                ]
            )
        elif model == 1:
            settings.extend(
                [
                    Input(
                        key="token_deepgram",
                        text=localization.get_string("token_token"),
                        icon="menu_privacy" if len(self.get_setting("token_deepgram", "")) > 0 else "menu_unlock",
                    ),
                    Text(
                        text=localization.get_string("token_get_token"),
                        icon="msg_openin",
                        on_click=self.open_token_page,
                        red=len(self.get_setting("token_deepgram", "")) <= 0,
                    ),
                ]
            )
        elif model == 2:
            settings.extend(
                [
                    Input(
                        key="token_mistral",
                        text=localization.get_string("token_token"),
                        default=MISTRAL_TOKEN,
                        icon="menu_privacy" if len(self.get_setting("token_mistral", MISTRAL_TOKEN)) > 0 else "menu_unlock",
                    ),
                    Text(
                        text=localization.get_string("token_get_token"),
                        icon="msg_openin",
                        on_click=self.open_token_page,
                        red=len(self.get_setting("token_mistral", MISTRAL_TOKEN)) <= 0,
                    ),
                ]
            )
        elif model in (3, 4):
            settings.extend(
                [
                    Input(
                        key="token_gemini",
                        text=localization.get_string("token_token"),
                        icon="menu_privacy" if len(self.get_setting("token_gemini", "")) > 0 else "menu_unlock",
                    ),
                    Text(
                        text=localization.get_string("token_get_token"),
                        icon="msg_openin",
                        on_click=self.open_token_page,
                        red=len(self.get_setting("token_gemini", "")) <= 0,
                    ),
                ]
            )

        settings.extend(
            [
                Header(text=localization.get_string("header_info")),
                Text(text=localization.get_string("info_model_choice"), icon="msg_replace", on_click=self.open_model_choice_alert),
                Text(text=localization.get_string("info_pricing"), icon="menu_feature_paid", on_click=self.open_pricing_alert),
                Header(text=localization.get_string("header_other")),
                Text(text=localization.get_string("other_open_channel"), icon="msg_discuss", on_click=self.open_channel, accent=True),
            ]
        )
        return settings

    def create_advanced_settings(self):
        items = [
            Switch(
                key="convert_to_audio",
                text=localization.get_string("settings_convert_to_audio"),
                default=True,
                subtext=localization.get_string("settings_convert_to_audio_subtext"),
                icon="msg_speed",
            ),
            Text(
                text=localization.get_string("settings_proxy"),
                icon="outline_shield_plain_24",
                create_sub_fragment=self.create_proxy_settings,
            ),
            Text(
                text=localization.get_string("settings_fallback_models"),
                icon="msg_photo_settings",
                create_sub_fragment=self.create_fallback_settings,
            ),
        ]
        return items

    def create_proxy_settings(self):
        items = [
            Header(text=localization.get_string("header_proxy")),
            Switch(
                key="enable_sni_proxy",
                text=localization.get_string("settings_sni_proxy"),
                subtext=localization.get_string("settings_sni_proxy_subtext"),
                default=False,
                icon="outline_shield_check",
            ),
            Switch(
                key="enable_proxy",
                text=localization.get_string("settings_enable_proxy"),
                default=False,
                icon="outline_shield_plain_24",
            ),
        ]
        if self.get_setting("enable_proxy"):
            items.extend(
                [
                    Text(
                        text=localization.get_string("settings_update_proxy"),
                        icon="msg_download",
                        on_click=self.update_proxy_list,
                    ),
                    Input(
                        key="custom_proxy",
                        text=localization.get_string("settings_custom_proxy"),
                        subtext=localization.get_string("settings_custom_proxy_subtext"),
                        icon="menu_feature_links",
                    ),
                ]
            )
        return items

    def create_fallback_settings(self):
        items = [
            Switch(
                key="enable_fallback",
                text=localization.get_string("settings_enable_fallback"),
                default=False,
                subtext=localization.get_string("settings_enable_fallback_subtext"),
                icon="msg_replace",
            )
        ]
        if self.get_setting("enable_fallback", False):
            m_len = len(MODELS)
            for i in range(m_len):
                fallback_options = ["-"] + MODELS
                for j in range(i):
                    index = self.get_setting(f"fallback_model_{j}")
                    if index == 0:
                        break
                    if index is None:
                        continue
                    model = fallback_options[index]
                    if model in fallback_options:
                        fallback_options.remove(model)
                current_setting = self.get_setting(f"fallback_model_{i}", 0)
                items.append(
                    Selector(
                        key=f"fallback_model_{i}",
                        text=f"{localization.get_string('settings_fallback_model')} {i + 1}",
                        default=0,
                        items=fallback_options,
                    )
                )
                if current_setting == 0:
                    break
        return items

    def update_proxy_list(self, _=None):  # Credits: BooruSearch by @ArThirtyFour
        def update_proxies_background():
            try:
                run_on_ui_thread(lambda: BulletinHelper.show_info(localization.get_string("bulletin_proxy_update_started")))

                src = int(self.get_setting("proxy_source", 0) or 0)
                all_proxies = []
                if src == 2:
                    raw_manual = str(self.get_setting("proxy_manual_list", "") or "")
                    for line in raw_manual.splitlines():
                        s = str(line).strip()
                        if not s or s.startswith("#"):
                            continue
                        all_proxies.append(s)
                else:
                    if src == 1:
                        proxy_url = str(self.get_setting("proxy_source_url", "") or "").strip()
                        if not proxy_url:
                            proxy_url = "https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/all/data.txt"
                    else:
                        proxy_url = "https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/all/data.txt"

                    all_proxies = get_proxy_list_from_url(proxy_url)

                if not all_proxies:
                    run_on_ui_thread(
                        lambda: BulletinHelper.show_error(localization.get_string("bulletin_proxy_update_error").format(error="Не удалось загрузить прокси"))
                    )
                    return

                unique_proxies = list(set(all_proxies))

                max_proxies_to_check = 2000
                if len(unique_proxies) > max_proxies_to_check:
                    unique_proxies = unique_proxies[:max_proxies_to_check]

                working_proxies = check_proxies_parallel(unique_proxies, max_workers=100, max_working=30)

                if working_proxies:
                    working_proxies.sort(key=lambda x: x["response_time"])

                    save_working_proxies_to_file(working_proxies)

                    run_on_ui_thread(
                        lambda: BulletinHelper.show_success(localization.get_string("bulletin_proxy_update_success").format(count=len(working_proxies)))
                    )
                else:
                    run_on_ui_thread(lambda: BulletinHelper.show_error(localization.get_string("bulletin_no_working_proxies")))

            except Exception as e:
                error_msg = str(e)
                self.log(f"[Transcriber] Proxy update failed: {error_msg}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(localization.get_string("bulletin_proxy_update_error").format(error=error_msg)))

        threading.Thread(target=update_proxies_background, daemon=True).start()

    def clear_transcription(self, context: Dict[str, Any]):
        messageObject = context.get("message")

        if not messageObject.type == 2 and not messageObject.type == 5:
            self.show_error_with_button(localization.get_string("error_message_not_voice"))
            return

        TranscribeButton = find_class("org.telegram.ui.Components.TranscribeButton")
        NotificationCenter = find_class("org.telegram.messenger.NotificationCenter")

        account = messageObject.currentAccount
        messageId = messageObject.messageOwner.id

        finalId = messageId
        finalText = None

        TranscribeButton.finishTranscription(messageObject, finalId, finalText)
        run_on_ui_thread(
            lambda: NotificationCenter.getInstance(account).postNotificationName(
                NotificationCenter.voiceTranscriptionUpdate, messageObject, finalId, f"[{localization.get_string('bulletin_reopen_chat')}]", False, True
            )
        )
        run_on_ui_thread(lambda: BulletinHelper.show_info(localization.get_string("bulletin_reopen_chat")))

    def enable_transcription_button(self):
        get_messages_controller().transcribeAudioTrialDurationMax = 1_000_000_000
        get_messages_controller().transcribeAudioTrialWeeklyNumber = 1_000_000_000

    def transcribe_with_different_model(self, context: Dict[str, Any]):
        try:
            messageObject = context.get("message")

            if not messageObject.type == 2 and not messageObject.type == 5:
                self.show_error_with_button(localization.get_string("error_message_not_voice"))

            current_fragment = get_last_fragment()
            activity = current_fragment.getParentActivity()

            def on_item_click(bld: AlertDialogBuilder, which: int):
                messageObject = context.get("message")
                if not messageObject:
                    return

                model = self.get_setting("model", 2)
                if model == 0:
                    token = self.get_setting("token_assemblyai", "")
                elif model == 1:
                    token = self.get_setting("token_deepgram", "")
                elif model == 2:
                    token = self.get_setting("token_mistral", MISTRAL_TOKEN)
                elif model in (3, 4):
                    token = self.get_setting("token_gemini", "")

                if token == "":
                    self.show_error_with_button(localization.get_string("error_no_token"))
                    return

                hook = self.CreateTranscribeButtonHook(self)
                hook.start_transcription_logic(messageObject, None, which)

                run_on_ui_thread(lambda: BulletinHelper.show_info(localization.get_string("bulletin_transcribing")))

                bld.dismiss()

            item_builder = AlertDialogBuilder(activity)
            item_builder.set_title(localization.get_string("alert_model_choice_title"))
            item_builder.set_items(MODELS, on_item_click)
            item_builder.set_negative_button(localization.get_string("alert_cancel"), lambda b, _: b.dismiss())
            item_builder.show()
        except Exception as e:
            error_prefix = localization.get_string("error_transcribing")
            self.show_error_with_button(str(e), error_prefix)
            self.log(f"[Transcriber] Error in transcribe_with_different_model: {e}")

    def open_pricing_alert(self, _):
        try:
            model = self.get_setting("model", 2)

            if model == 0:
                text = localization.get_string("pricing_assemblyai")
            elif model == 1:
                text = localization.get_string("pricing_deepgram")
            elif model == 2:
                text = localization.get_string("pricing_mistral")
            elif model == 3 or model == 4:
                text = localization.get_string("pricing_gemini")
            title = MODELS[model]

            current_fragment = get_last_fragment()
            if not current_fragment or not current_fragment.getParentActivity():
                return
            context = current_fragment.getParentActivity()
            builder = AlertDialogBuilder(context, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(title)
            builder.set_message(text)
            builder.set_positive_button(localization.get_string("alert_close"), lambda b, _: b.dismiss())
            builder.set_neutral_button(localization.get_string("alert_open_pricing_page"), self.open_pricing_page)
            builder.show()
        except Exception as e:
            error_prefix = localization.get_string("error_setup")
            self.show_error_with_button(str(e), error_prefix)
            self.log(f"[Transcriber] Error showing pricing alert: {e}")

    def open_model_choice_alert(self, _):
        try:
            current_fragment = get_last_fragment()
            if not current_fragment or not current_fragment.getParentActivity():
                return
            context = current_fragment.getParentActivity()
            builder = AlertDialogBuilder(context, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(localization.get_string("alert_model_choice_title"))
            builder.set_message(localization.get_string("alert_model_choice"))
            builder.set_positive_button(localization.get_string("alert_close"), lambda b, _: b.dismiss())
            builder.show()
        except Exception as e:
            error_prefix = localization.get_string("error_setup")
            self.show_error_with_button(str(e), error_prefix)
            self.log(f"[Transcriber] Error showing model choice alert: {e}")

    def open_pricing_page(self, *_):
        try:
            model = self.get_setting("model", 2)

            current_fragment = get_last_fragment()
            if not current_fragment or not current_fragment.getParentActivity():
                return
            context = current_fragment.getParentActivity()
            if model == 0:
                uri = "https://www.assemblyai.com/pricing"
            elif model == 1:
                uri = "https://deepgram.com/pricing"
            elif model == 2:
                uri = "https://mistral.ai/pricing"
            elif model == 3 or model == 4:
                uri = "https://ai.google.dev/gemini-api/docs/pricing"
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(uri))
            context.startActivity(intent)
        except Exception as e:
            error_prefix = localization.get_string("error_external_link")
            self.show_error_with_button(str(e), error_prefix)
            self.log(f"[Transcriber] Error opening pricing page: {e}")

    def open_token_page(self, _):
        try:
            model = self.get_setting("model", 2)

            current_fragment = get_last_fragment()
            if not current_fragment or not current_fragment.getParentActivity():
                return

            if model == 0:
                uri = "https://t.me/ginqusPlugins/8"
            elif model == 1:
                uri = "https://t.me/ginqusPlugins/9"
            elif model == 2:
                uri = "https://t.me/ginqusPlugins/10"
            elif model == 3 or model == 4:
                uri = "https://t.me/ginqusPlugins/11"

            Browser = find_class("org.telegram.messenger.browser.Browser")
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            activity = LaunchActivity.instance
            if activity:
                Browser.openUrl(activity, Uri.parse(uri))
        except Exception as e:
            error_prefix = localization.get_string("error_external_link")
            self.show_error_with_button(str(e), error_prefix)
            self.log(f"[Transcriber] Error opening token page: {e}")

    def open_channel(self, _):
        try:
            mc = get_messages_controller()
            current_fragment = get_last_fragment()
            if not current_fragment or not current_fragment.getParentActivity():
                return
            if mc and hasattr(mc, "openByUserName"):
                mc.openByUserName("ginqusPlugins", current_fragment, 0)
        except Exception as e:
            error_prefix = localization.get_string("error_external_link")
            self.show_error_with_button(str(e), error_prefix)
            self.log(f"[Transcriber] Error opening channel: {e}")

    def show_error_with_button(self, error_msg: str, prefix: str = ""):
        try:
            full_error = f"{prefix}{error_msg}"
            run_on_ui_thread(
                lambda: BulletinHelper.show_with_button(
                    full_error,
                    R_tg.raw.error,
                    localization.get_string("bulletin_view_error"),
                    lambda: self._view_error(error_msg),
                )
            )
        except Exception as e:
            run_on_ui_thread(BulletinHelper.show_error(localization.get_string("error_showing_error") + e))

    def _view_error(self, error: str):
        try:
            current_fragment = get_last_fragment()
            if not current_fragment:
                self.log("[Transcriber] Cannot show dialog, no current fragment.")
                return

            activity = current_fragment.getParentActivity()
            if not activity:
                self.log("[Transcriber] Cannot show dialog, no parent activity.")
                return

            builder = AlertDialogBuilder(activity)  # Default is ALERT_TYPE_MESSAGE
            builder.set_title(localization.get_string("alert_title_error"))
            builder.set_message(error)

            def on_positive_click(bld: AlertDialogBuilder, _: int):
                ClipData = find_class("android.content.ClipData")
                Context = find_class("android.content.Context")

                clipboard = activity.getSystemService(Context.CLIPBOARD_SERVICE)
                clip = ClipData.newPlainText("error", error)
                clipboard.setPrimaryClip(clip)

                # BulletinHelper.show_copied_to_clipboard doesn't work for some reason??
                run_on_ui_thread(lambda: BulletinHelper.show_info(localization.get_string("bulletin_copied_to_clipboard")))
                bld.dismiss()

            def on_negative_click(bld: AlertDialogBuilder, _: int):
                bld.dismiss()

            builder.set_positive_button(localization.get_string("alert_copy"), on_positive_click)
            builder.set_negative_button(localization.get_string("alert_close"), on_negative_click)

            builder.show()
        except Exception as e:
            self.log(f"[Transcriber] Error in _view_error: {e}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(str(e)))

    class CreateTranscribeButtonHook(MethodReplacement):
        def __init__(self, plugin_instance):
            super().__init__()
            self.plugin = plugin_instance

        def replace_hooked_method(self, param):
            self.onTap(param)

        # Mostly identical to TranscribeButton.java but with minor changes
        def onTap(self, param):
            try:
                this = param.thisObject

                parent = get_private_field(this, "parent")
                shouldBeOpen = get_private_field(this, "shouldBeOpen")
                loading = get_private_field(this, "loading")
                selectorDrawable = get_private_field(this, "selectorDrawable")

                RippleDrawable = find_class("android.graphics.drawable.RippleDrawable")
                StateSet = find_class("android.util.StateSet")

                if parent == None:
                    return
                set_private_field(this, "clickedToOpen", False)
                processClick = not shouldBeOpen
                toOpen = not shouldBeOpen
                if not shouldBeOpen:
                    processClick = not loading
                    this.setLoading(True, True)
                else:
                    processClick = True
                    this.setOpen(False, True)
                    this.setLoading(False, True)
                if not RippleDrawable is None and isinstance(selectorDrawable, RippleDrawable):
                    try:
                        selectorDrawable.setState(StateSet.NOTHING)
                        parent.invalidate()
                    except:
                        pass
                set_private_field(this, "pressed", False)
                if processClick:
                    if toOpen:
                        set_private_field(this, "clickedToOpen", True)
                    self.transcribePressed(param, parent.getMessageObject(), toOpen)
            except Exception as e:
                error_prefix = localization.get_string("error_general")
                self.plugin.show_error_with_button(str(e), error_prefix)
                self.plugin.log(f"[Transcriber] Error in onTap: {e}")

        def open_settings(self):
            # Credits: CactusLib plugin by @chillden4ik
            try:

                def _open_settings():
                    get_last_fragment().presentFragment(PluginSettingsActivity(PluginsController.getInstance().plugins.get(__id__)))

                run_on_ui_thread(_open_settings)

            except Exception as e:
                error_prefix = localization.get_string("error_opening_settings")
                self.plugin.show_error_with_button(str(e), error_prefix)
                self.plugin.log(f"[Transcriber] Error in open_settings: {e}")

        # The logic is mostly identical to TranscribeButton.java but with minor changes
        def transcribePressed(self, param, messageObject, open):
            try:
                model = self.plugin.get_setting("model", 2)
                if model == 0:
                    token = self.plugin.get_setting("token_assemblyai", "")
                elif model == 1:
                    token = self.plugin.get_setting("token_deepgram", "")
                elif model == 2:
                    token = self.plugin.get_setting("token_mistral", MISTRAL_TOKEN)
                elif model in (3, 4):
                    token = self.plugin.get_setting("token_gemini", "")

                TranscribeButton = find_class("org.telegram.ui.Components.TranscribeButton")
                MessagesStorage = find_class("org.telegram.messenger.MessagesStorage")
                DialogObject = find_class("org.telegram.messenger.DialogObject")
                MessagesController = find_class("org.telegram.messenger.MessagesController")
                NotificationCenter = find_class("org.telegram.messenger.NotificationCenter")

                this = param.thisObject
                transcribeOperationsByDialogPosition = get_private_field(this, "transcribeOperationsByDialogPosition")

                if messageObject == None or messageObject.messageOwner == None or not messageObject.isSent():
                    return

                account = messageObject.currentAccount
                peer = MessagesController.getInstance(account).getInputPeer(messageObject.messageOwner.peer_id)
                dialogId = DialogObject.getPeerDialogId(peer)
                messageId = messageObject.messageOwner.id

                if token == "":
                    run_on_ui_thread(
                        lambda: BulletinHelper.show_with_button(
                            localization.get_string("error_no_token"),
                            R_tg.raw.error,
                            localization.get_string("bulletin_open_settings"),
                            self.open_settings,
                        )
                    )
                    self.stop_animations(this, messageObject, account, messageId)
                    return

                if open:
                    if messageObject.messageOwner.voiceTranscription != None and messageObject.messageOwner.voiceTranscriptionFinal:
                        TranscribeButton.openVideoTranscription(messageObject)
                        messageObject.messageOwner.voiceTranscriptionOpen = True
                        MessagesStorage.getInstance(account).updateMessageVoiceTranscriptionOpen(dialogId, messageId, messageObject.messageOwner)
                        run_on_ui_thread(
                            lambda: NotificationCenter.getInstance(account).postNotificationName(
                                NotificationCenter.voiceTranscriptionUpdate, messageObject, None, None, True, True
                            )
                        )
                    else:
                        self.start_transcription_logic(messageObject, this, model=None)
                else:
                    if transcribeOperationsByDialogPosition != None:
                        transcribeOperationsByDialogPosition.remove(int(self.reqInfoHash(messageObject)))
                    messageObject.messageOwner.voiceTranscriptionOpen = False
                    MessagesStorage.getInstance(account).updateMessageVoiceTranscriptionOpen(dialogId, messageId, messageObject.messageOwner)
                    run_on_ui_thread(
                        lambda: NotificationCenter.getInstance(account).postNotificationName(
                            NotificationCenter.voiceTranscriptionUpdate, messageObject, None, None, False, None
                        )
                    )
            except Exception as e:
                error_prefix = localization.get_string("error_general")
                self.plugin.show_error_with_button(str(e), error_prefix)
                self.plugin.log(f"[Transcriber] Error in transcribePressed: {e}")
                self.stop_animations(this, messageObject, account, messageId)

        # Identical to TranscribeButton.java
        def reqInfoHash(self, messageObject):
            if messageObject == None:
                return 0
            return Objects.hash(messageObject.currentAccount, messageObject.getDialogId(), messageObject.getId())

        def start_transcription_logic(self, messageObject, this, model: Optional[int] = None):
            try:
                MessagesStorage = find_class("org.telegram.messenger.MessagesStorage")
                DialogObject = find_class("org.telegram.messenger.DialogObject")
                MessagesController = find_class("org.telegram.messenger.MessagesController")

                if messageObject == None or messageObject.messageOwner == None or not messageObject.isSent():
                    self.plguin.log("[Transcriber] either messageObject is None, messageOwner is None or message isn't sent")
                    return

                account = messageObject.currentAccount
                peer = MessagesController.getInstance(account).getInputPeer(messageObject.messageOwner.peer_id)
                dialogId = DialogObject.getPeerDialogId(peer)
                messageId = messageObject.messageOwner.id
                id = messageId

                if this is not None:
                    transcribeOperationsByDialogPosition = get_private_field(this, "transcribeOperationsByDialogPosition")
                    if transcribeOperationsByDialogPosition == None:
                        set_private_field(this, "transcribeOperationsByDialogPosition", HashMap())
                    transcribeOperationsByDialogPosition = get_private_field(this, "transcribeOperationsByDialogPosition")
                    transcribeOperationsByDialogPosition.put(int(self.reqInfoHash(messageObject)), messageObject)

                    transcribeOperationsById = get_private_field(this, "transcribeOperationsById")
                    if transcribeOperationsById == None:
                        set_private_field(this, "transcribeOperationsById", HashMap())
                    transcribeOperationsById = get_private_field(this, "transcribeOperationsById")
                    transcribeOperationsById.put(id, messageObject)

                messageObject.messageOwner.voiceTranscriptionId = id

                # Fixes loading animation not playing when reopening the chat
                MessagesStorage.getInstance(account).updateMessageVoiceTranscription(dialogId, messageId, "", messageObject.messageOwner)

                run_on_queue(lambda: self._transcribe(messageObject, account, dialogId, messageId, id, this, model))

            except Exception as e:
                error_prefix = localization.get_string("error_transcribing")
                self.plugin.show_error_with_button(str(e), error_prefix)
                self.plugin.log(f"[Transcriber] Error in start_transcription_logic: {e}")
                self.stop_animations(this, messageObject, account, messageId)

        def _transcribe(self, messageObject, account, dialogId, messageId, id, this, model: Optional[int] = None):
            try:
                path = self.get_audio_path(messageObject)
                if isinstance(path, Exception):
                    error_prefix = localization.get_string("error_get_audio_path")
                    self.plugin.show_error_with_button(str(path), error_prefix)
                    self.plugin.log(f"[Transcriber] Error getting audio path: {path}")
                    self.stop_animations(this, messageObject, account, messageId)
                    return

                TRANSCRIPTION_EXECUTOR.submit(self._perform_transcription, path, messageObject, account, dialogId, messageId, id, this, model)
            except Exception as e:
                error_prefix = localization.get_string("error_general")
                self.plugin.show_error_with_button(str(e), error_prefix)
                self.plugin.log(f"[Transcriber] Error in transcribe: {e}")
                self.stop_animations(this, messageObject, account, messageId)

        def _perform_transcription(self, path, messageObject, account, dialogId, messageId, id, this, model: Optional[int] = None):
            try:
                if self.plugin.get_setting("convert_to_audio", True) and messageObject.type == 5:  # TYPE_ROUND_VIDEO
                    try:
                        path = self.extract_audio_from_mp4(path)
                        if isinstance(path, Exception):
                            raise path
                    except Exception as e:
                        error_prefix = localization.get_string("error_extraction")
                        self.plugin.show_error_with_button(str(e), error_prefix)
                        self.plugin.log(f"[Transcriber] Error extracting audio: {e}")
                        self.stop_animations(this, messageObject, account, messageId)
                        return

                if model is None:
                    primary_model = self.plugin.get_setting("model", 2)
                else:
                    primary_model = model

                models_to_try = [primary_model]

                if self.plugin.get_setting("enable_fallback", False):
                    fallback_index = 0
                    while True:
                        fallback_model_setting = self.plugin.get_setting(f"fallback_model_{fallback_index}", 0)
                        if fallback_model_setting == 0 or fallback_model_setting is None:
                            break
                        models_to_try.append(fallback_model_setting - 1)
                        fallback_index += 1

                last_error = None
                for current_model in models_to_try:
                    try:
                        text = self.send_transcription_request(path, current_model)
                        if isinstance(text, Exception):
                            raise text

                        finalText = str(text)

                        TranscribeButton = find_class("org.telegram.ui.Components.TranscribeButton")
                        MessagesStorage = find_class("org.telegram.messenger.MessagesStorage")

                        messageObject.messageOwner.voiceTranscriptionOpen = True
                        messageObject.messageOwner.voiceTranscriptionFinal = True
                        MessagesStorage.getInstance(account).updateMessageVoiceTranscription(dialogId, messageId, finalText, messageObject.messageOwner)

                        transcribeOperationsByDialogPosition = get_private_field(this, "transcribeOperationsByDialogPosition")
                        if transcribeOperationsByDialogPosition:
                            transcribeOperationsByDialogPosition.remove(self.reqInfoHash(messageObject))

                        run_on_ui_thread(lambda: self.finish_transcription_ui(this, messageObject, id, finalText, TranscribeButton, account, messageId))
                        return

                    except Exception as e:
                        last_error = e
                        self.plugin.log(f"[Transcriber] Model {current_model} ({MODELS[current_model]}) failed: {e}")
                        continue

                if last_error:
                    raise last_error
                else:
                    raise RuntimeError("All transcription models failed")

            except Exception as e:
                err = str(e)
                error_prefix = localization.get_string("error_transcribing")
                self.plugin.show_error_with_button(err, error_prefix)
                self.plugin.log(f"[Transcriber] Error transcribing: {err}")
                self.stop_animations(this, messageObject, account, messageId)

        def finish_transcription_ui(self, this, messageObject, finalId, finalText, TranscribeButton, account, messageId):
            try:
                TranscribeButton.openVideoTranscription(messageObject)
                TranscribeButton.finishTranscription(messageObject, finalId, finalText)
                if this:
                    this.showOffTranscribe(messageObject)
                get_messages_controller().markMessageContentAsRead(messageObject)
            except Exception as e:
                error_prefix = localization.get_string("error_general")
                self.plugin.show_error_with_button(str(e), error_prefix)
                self.plugin.log(f"[Transcriber] Error in finish_transcription_ui: {e}")
                self.stop_animations(this, messageObject, account, messageId)

        def stop_animations(self, this, messageObject, account, messageId):
            try:
                NotificationCenter = find_class("org.telegram.messenger.NotificationCenter")

                if this:
                    transcribeOperationsByDialogPosition = get_private_field(this, "transcribeOperationsByDialogPosition")
                    transcribeOperationsById = get_private_field(this, "transcribeOperationsById")
                    if transcribeOperationsByDialogPosition != None:
                        transcribeOperationsByDialogPosition.remove(int(self.reqInfoHash(messageObject)))
                    if transcribeOperationsById != None:
                        transcribeOperationsById.remove(messageId, messageObject)

                run_on_ui_thread(
                    lambda: NotificationCenter.getInstance(account).postNotificationName(
                        NotificationCenter.voiceTranscriptionUpdate, messageObject, None, None, False, None
                    )
                )
            except Exception as e:
                error_prefix = localization.get_string("error_stopping_animations")
                self.plugin.show_error_with_button(str(e), error_prefix)
                self.plugin.log(f"[Transcriber] Error in stop_animations: {e}")

        def get_audio_path(self, msg):
            try:
                UserConfig = find_class("org.telegram.messenger.UserConfig")
                FileLoader = find_class("org.telegram.messenger.FileLoader")

                current_account = UserConfig.selectedAccount
                file_loader = FileLoader.getInstance(current_account)
                file_path_obj = file_loader.getPathToMessage(msg.messageOwner)

                if not file_path_obj.exists():
                    document = msg.messageOwner.media.document
                    file_loader.loadFile(document, msg, 1, 0)

                for _ in range(20):
                    if not file_path_obj.exists():
                        time.sleep(1)
                    else:
                        break
                else:
                    raise TimeoutError(localization.get_string("error_load_file_timeout"))

                return str(file_path_obj.getAbsolutePath())

            except Exception as e:
                return e

        def extract_audio_from_mp4(self, in_path):
            try:
                MediaExtractor = find_class("android.media.MediaExtractor")
                MediaMuxer = find_class("android.media.MediaMuxer")
                MediaFormat = find_class("android.media.MediaFormat")
                ByteBuffer = find_class("java.nio.ByteBuffer")
                BufferInfo = find_class("android.media.MediaCodec$BufferInfo")()

                extractor = MediaExtractor()
                muxer = None

                out_path = in_path.rsplit(".", 1)[0] + ".m4a"

                extractor.setDataSource(in_path)

                audio_track = -1
                for i in range(extractor.getTrackCount()):
                    format = extractor.getTrackFormat(i)
                    mime = format.getString(MediaFormat.KEY_MIME)
                    if mime.startswith("audio/"):
                        audio_track = i
                        break

                if audio_track == -1:
                    raise RuntimeError(localization.get_string("error_audio_not_found"))

                muxer = MediaMuxer(out_path, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)

                extractor.selectTrack(audio_track)
                audio_format = extractor.getTrackFormat(audio_track)
                audio_track_index = muxer.addTrack(audio_format)

                muxer.start()

                buffer = ByteBuffer.allocate(1024 * 1024)  # 1MB buffer

                while True:
                    sample_size = extractor.readSampleData(buffer, 0)
                    if sample_size < 0:
                        break

                    BufferInfo.offset = 0
                    BufferInfo.size = sample_size
                    BufferInfo.presentationTimeUs = extractor.getSampleTime()
                    BufferInfo.flags = extractor.getSampleFlags()

                    muxer.writeSampleData(audio_track_index, buffer, BufferInfo)
                    extractor.advance()

                return out_path

            except Exception as e:
                return RuntimeError(str(localization.get_string("error_extraction") + str(e)))

            finally:
                if muxer:
                    muxer.stop()
                    muxer.release()
                extractor.release()

        def send_transcription_request(self, path, custom_model: Optional[int] = None):
            try:
                if custom_model is None:
                    model = self.plugin.get_setting("model", 2)
                else:
                    model = custom_model

                if model == 0:
                    token = self.plugin.get_setting("token_assemblyai", "")
                elif model == 1:
                    token = self.plugin.get_setting("token_deepgram", "")
                elif model == 2:
                    token = self.plugin.get_setting("token_mistral", MISTRAL_TOKEN)
                elif model in (3, 4):
                    token = self.plugin.get_setting("token_gemini", "")

                custom_proxy_raw = self.plugin.get_setting("custom_proxy", "")
                custom_proxy = build_requests_proxies(custom_proxy_raw)
                proxy_dict = None
                if custom_proxy_raw and not custom_proxy:
                    self.plugin.show_error_with_button(localization.get_string("error_invalid_custom_proxy"))
                if self.plugin.get_setting("enable_proxy", False):
                    proxy_dict = custom_proxy or get_working_proxy()
                self.plugin.log(f"[Transcriber] Using proxy: {proxy_dict}")

                session = requests.Session()
                adapter = FakeDNSAdapter(HOSTS_MAP if self.plugin.get_setting("enable_sni_proxy") else {}, proxy_dict=proxy_dict)
                session.mount("https://", adapter)

                if model == 0:  # AssemblyAI
                    base_url = "https://api.assemblyai.com"
                    headers = {"authorization": token}

                    with open(path, "rb") as f:
                        response = session.post(base_url + "/v2/upload", headers=headers, data=f, timeout=60, proxies=proxy_dict)
                        if response.status_code != 200:
                            raise RuntimeError(
                                f"{localization.get_string('error_upload_file')}: {response.status_code}, {localization.get_string('response')}:"
                                f" {response.text}"
                            )
                        upload_url = response.json()["upload_url"]

                    data = {"audio_url": upload_url, "language_detection": True, "speaker_labels": True, "speech_models": ["universal-3-pro", "universal-2"]}
                    response = session.post(base_url + "/v2/transcript", headers=headers, json=data, timeout=60, proxies=proxy_dict)

                    if response.status_code != 200:
                        raise RuntimeError(
                            f"{localization.get_string('error_start_transcription')}: {response.status_code}, {localization.get_string('response')}:"
                            f" {response.text}"
                        )

                    transcript_id = response.json()["id"]
                    polling_endpoint = f"{base_url}/v2/transcript/{transcript_id}"

                    for _ in range(60):
                        transcript = session.get(polling_endpoint, headers=headers, proxies=proxy_dict).json()
                        if transcript["status"] == "completed":
                            if self.plugin.get_setting("separate_speakers", True):
                                result = ""
                                utterances = transcript.get("utterances")
                                if len(utterances) > 1:
                                    for utterance in utterances:
                                        speaker = utterance.get("speaker", "Unknown")
                                        text = utterance.get("text", "")
                                        result += f'{speaker}: "{text}"\n'
                                else:
                                    result = utterances[0].get("text", "") if utterances else ""
                                return result
                            else:
                                return transcript.get("text", "")
                        elif transcript["status"] == "error":
                            raise RuntimeError(f"{transcript['error']}")
                        else:
                            time.sleep(1)
                    else:
                        raise TimeoutError(localization.get_string("error_timed_out"))

                elif model == 1:  # Doxgram ☠️☠️
                    url = "https://api.deepgram.com/v1/listen?model=nova-3-general&smart_format=true&detect_language=true&diarize=true"
                    headers = {
                        "Authorization": f"Token {token}",
                        "Content-Type": "audio/*",
                    }
                    with open(path, "rb") as audio_file:
                        response = session.post(url, headers=headers, data=audio_file, timeout=60, proxies=proxy_dict)

                    if response.status_code != 200:
                        raise RuntimeError(f"{response.status_code}, {localization.get_string('response')}: {response.text}")

                    if self.plugin.get_setting("separate_speakers", True):
                        words = response.json()["results"]["channels"][0]["alternatives"][0]["words"]

                        # Determine unique speakers
                        unique_speakers = set()
                        for word_data in words:
                            if "speaker" in word_data:
                                unique_speakers.add(word_data["speaker"])

                        if len(unique_speakers) <= 1:
                            return response.json()["results"]["channels"][0]["alternatives"][0]["transcript"]

                        script_lines = []
                        current_speaker = None
                        current_dialogue_words = []

                        def flush_dialogue(speaker_id, dialogue_words):
                            if dialogue_words:
                                speaker_label = chr(65 + speaker_id)
                                full_line = " ".join(dialogue_words)
                                return f'{speaker_label}: "{full_line}"'
                            return None

                        for word_data in words:
                            speaker_id = word_data.get("speaker")
                            punctuated_word = word_data.get("punctuated_word")

                            if speaker_id is not None and speaker_id != current_speaker:
                                line = flush_dialogue(current_speaker, current_dialogue_words)
                                if line:
                                    script_lines.append(line)
                                current_speaker = speaker_id
                                current_dialogue_words = [punctuated_word]
                            elif punctuated_word:
                                current_dialogue_words.append(punctuated_word)

                        line = flush_dialogue(current_speaker, current_dialogue_words)
                        if line:
                            script_lines.append(line)

                        result = "\n".join(script_lines)
                    else:
                        result = response.json()["results"]["channels"][0]["alternatives"][0]["transcript"]
                    return str(result)

                elif model == 2:  # Mistral
                    url = "https://api.mistral.ai/v1/audio/transcriptions"
                    headers = {"x-api-key": token}
                    files = {
                        "file": open(path, "rb"),
                        "model": "voxtral-mini-latest",
                        "diarize": True,
                        "timestamp_granularities": "segment",
                    }
                    response = session.post(url, headers=headers, files=files, timeout=60, proxies=proxy_dict)

                    if response.status_code != 200:
                        raise RuntimeError(f"{response.status_code}, {localization.get_string('response')}: {response.text}")

                    response_data = response.json()

                    if self.plugin.get_setting("separate_speakers", True):
                        segments = response_data.get("segments", [])

                        if segments:
                            # Group segments by speaker
                            speaker_map = {}
                            speaker_order = []

                            for segment in segments:
                                speaker_id = segment.get("speaker_id")
                                if speaker_id not in speaker_map:
                                    speaker_map[speaker_id] = speaker_order.__len__()
                                    speaker_order.append(speaker_id)

                            # Check if there's only one speaker
                            if len(speaker_map) <= 1:
                                return response_data.get("text", "")

                            # Build formatted output
                            script_lines = []
                            current_speaker = None
                            current_text = []

                            for segment in segments:
                                speaker_id = segment.get("speaker_id")
                                text = segment.get("text", "").strip()

                                if speaker_id != current_speaker:
                                    if current_text and current_speaker is not None:
                                        speaker_label = chr(65 + speaker_map[current_speaker])
                                        full_text = " ".join(current_text).strip()
                                        script_lines.append(f'{speaker_label}: "{full_text}"')
                                    current_speaker = speaker_id
                                    current_text = [text] if text else []
                                elif text:
                                    current_text.append(text)

                            # Flush last speaker
                            if current_text and current_speaker is not None:
                                speaker_label = chr(65 + speaker_map[current_speaker])
                                full_text = " ".join(current_text).strip()
                                script_lines.append(f'{speaker_label}: "{full_text}"')

                            return "\n".join(script_lines)

                    return response_data.get("text", "")

                elif model in (3, 4):  # Gemini
                    # Credits: Voice to Text plugin by @PESSDES
                    with open(path, "rb") as f:
                        audio64 = base64.b64encode(f.read()).decode("utf-8")

                    if model == 4:
                        url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent?key={token}"
                    else:
                        url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key={token}"

                    mime_type = "video/mp4" if path.lower().endswith(".mp4") else "audio/ogg"
                    if self.plugin.get_setting("separate_speakers", True):
                        prompt = DEFAULT_PROMPT_DIARIZATION
                    else:
                        prompt = DEFAULT_PROMPT
                    payload = {
                        "contents": [{"parts": [{"text": prompt}, {"inline_data": {"mimeType": mime_type, "data": audio64}}]}],
                        "generationConfig": {
                            "thinkingConfig": {"thinkingLevel": "high" if self.plugin.get_setting("thinking_mode", False) else "minimal"},
                        },
                    }

                    response = session.post(url, json=payload, timeout=60, proxies=proxy_dict)
                    data = response.json()

                    if response.status_code != 200:
                        raise RuntimeError(f"{response.status_code}, {localization.get_string('response')}: {response.text}")

                    if "candidates" in data and data["candidates"]:
                        candidate = data["candidates"][0]
                        if "content" in candidate and "parts" in candidate["content"]:
                            parts = candidate["content"]["parts"]
                            if parts and "text" in parts[0]:
                                final_text = parts[0]["text"].strip()
                                return "" if final_text == "..." else final_text
                    if "error" in data:
                        error_msg = data["error"].get("message", "Unknown API error")
                        self.plugin.log(f"[Transcriber] Gemini API error: {error_msg}")
                        raise RuntimeError(error_msg)

                    self.plugin.log("[Transcriber] No text found in API response")
                    raise RuntimeError("No text found in API response.")
            except Exception as e:
                return e

    # Called when a chat is opened (maybe in some other cases too idk)
    class ActivityResumeHook(MethodHook):
        def __init__(self, plugin_instance):
            super().__init__()
            self.plugin = plugin_instance

        def before_hooked_method(self, _):
            try:
                self.plugin.enable_transcription_button()
            except Exception as e:
                error_prefix = localization.get_string("error_general")
                run_on_ui_thread(lambda: BulletinHelper.show_info(error_prefix + str(e)))
                self.plugin.log(f"[Transcriber] Error in ActivityResumeHook: {e}")

    # Called every 4 minutes or so (can also be called by a server push)
    # By default it resets the transcription quota so we're overwriting it here
    class ApplyAppConfigHook(MethodHook):
        def __init__(self, plugin_instance):
            super().__init__()
            self.plugin = plugin_instance

        def after_hooked_method(self, _):
            try:
                self.plugin.enable_transcription_button()
            except Exception as e:
                error_prefix = localization.get_string("error_general")
                run_on_ui_thread(lambda: BulletinHelper.show_info(error_prefix + str(e)))
                self.plugin.log(f"[Transcriber] Error in ApplyAppConfigHook: {e}")

    class CreateMenuHook(MethodHook):
        def __init__(self, plugin_instance):
            super().__init__()
            self.plugin = plugin_instance

        def before_hooked_method(self, param):
            try:
                self.plugin.remove_menu_item("clear_transcription")
                self.plugin.remove_menu_item("different_model")
                ChatActivity = param.args[0]
                currentMessageObject = get_private_field(ChatActivity, "currentMessageObject")
                messageObject = currentMessageObject
                if messageObject.type == 2 or messageObject.type == 5:
                    self.plugin.add_menu_item(
                        MenuItemData(
                            item_id="clear_transcription",
                            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                            text=localization.get_string("menu_clear_transcription"),
                            on_click=self.plugin.clear_transcription,
                            icon="menu_clear_cache",
                        )
                    )
                    self.plugin.add_menu_item(
                        MenuItemData(
                            item_id="different_model",
                            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                            text=localization.get_string("menu_transcribe_with_different_model"),
                            on_click=self.plugin.transcribe_with_different_model,
                            icon="msg_retry",
                        )
                    )
            except Exception as e:
                error_prefix = localization.get_string("error_menu")
                run_on_ui_thread(lambda: BulletinHelper.show_info(error_prefix + str(e)))
                self.plugin.log(f"[Transcriber] Error in CreateMenuHook: {e}")
