class _ChannelARHook(MethodHook):
    def __init__(self, plugin, key):
        self.p = weakref.ref(plugin)
        self.key = key

    def before_hooked_method(self, param):
        try:
            p = self.p()
            if p is None:
                return
            if int(param.args[0]) != p.CB_FILE_PICKER_CODE:
                return
            param.setResult(None)
            if int(param.args[1]) == Activity.RESULT_OK and param.args[2] is not None:
                uri = param.args[2].getData()
                if uri is not None:
                    _pick_gen = p._lifecycle_gen
                    threading.Thread(
                        target=p._cb_save_uri,
                        args=(uri, self.key, _pick_gen),
                        daemon=True,
                    ).start()
            try:
                if p._cb_activity_hook:
                    p.unhook_method(p._cb_activity_hook)
                    p._cb_activity_hook = None
            except Exception:
                pass
        except Exception:
            pass

class _ThemeGetColorIntHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def before_hooked_method(self, param):
        try:
            p = self.p()
            if p is None:
                return
            mode = p._last_frag_mode
            if not mode:
                return
            if p._last_frag_class != "org.telegram.ui.ProfileActivity":
                return
            key_int = int(param.args[0])
            name_color, sub_color = p._resolve_text_colors(mode)
            k = p._theme_keys
            if key_int == k.get("key_profile_title"):
                param.setResult(name_color)
            elif key_int in (k.get("key_avatar_subtitleInProfileBue"), k.get("key_avatar_subtitleInProfileBlue")):
                param.setResult(sub_color)
        except Exception:
            return

class _ThemeGetColorStrHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def before_hooked_method(self, param):
        try:
            p = self.p()
            if p is None:
                return
            mode = p._last_frag_mode
            if not mode:
                return
            if p._last_frag_class != "org.telegram.ui.ProfileActivity":
                return
            key_str = str(param.args[0] or "").strip()
            if not key_str:
                return
            name_color, sub_color = p._resolve_text_colors(mode)
            if key_str == "profile_title":
                param.setResult(name_color)
            elif key_str in ("avatar_subtitleInProfileBue", "avatar_subtitleInProfileBlue"):
                param.setResult(sub_color)
        except Exception:
            return

class _TopViewOnDrawHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)
        self._cached_outer_id = None
        self._cached_key = None
        self._cached_mode = ""
        self._field_cache: dict = {}
        self._matrix = None

    def _get_key(self, outer):
        oid = _java_id(outer)
        if oid != self._cached_outer_id:
            self._cached_outer_id = oid
            p = self.p()
            try:
                self._cached_key = p._get_profile_key_from_fragment(outer) if p is not None else "unknown"
            except Exception:
                self._cached_key = "unknown"
            try:
                if p is None:
                    self._cached_mode = ""
                elif p._last_frag_key == self._cached_key:
                    self._cached_mode = p._last_frag_mode
                else:
                    self._cached_mode = p._get_profile_text_mode(self._cached_key)
            except Exception:
                self._cached_mode = ""
        return self._cached_key or "unknown"

    def _cached_field(self, cls, fname):
        cls_id = cls.getName()
        cf = self._field_cache.get(cls_id)
        if cf is None:
            cf = {}
            self._field_cache[cls_id] = cf
        if fname not in cf:
            try:
                f = cls.getDeclaredField(fname)
                f.setAccessible(True)
                cf[fname] = f
            except Exception:
                cf[fname] = None
        return cf[fname]

    def before_hooked_method(self, param):
        try:
            p = self.p()
            if p is None or not p._enable_cached:
                return
            topview = param.thisObject
            if topview is None:
                return
            outer = None
            try:
                f = self._cached_field(topview.getClass(), "this$0")
                if f is not None:
                    outer = f.get(topview)
            except Exception:
                pass
            if outer is None:
                return
            key = self._get_key(outer)
            if self._cached_mode:
                p._apply_text_colors(topview, outer, self._cached_mode, self._field_cache)
        except Exception:
            pass

    def after_hooked_method(self, param):
        try:
            p = self.p()
            if p is None or not p._enable_cached:
                return
            topview = param.thisObject
            canvas = param.args[0]
            if canvas is None or topview is None:
                return
            outer = None
            try:
                f = self._cached_field(topview.getClass(), "this$0")
                if f is not None:
                    outer = f.get(topview)
            except Exception:
                pass
            key = self._get_key(outer) if outer is not None else "unknown"
            with p._bmp_lock:
                bmp = p._bmp_map.get(key)
            try:
                if bmp is not None and bmp.isRecycled():
                    bmp = None
            except Exception:
                bmp = None
            if bmp is None:
                p._prefetch_profile_bitmap(key)
                return

            try:
                effect = p._cache_profile_effect.get(key)
                if effect is None:
                    effect = p._get_profile_effect(key)
                    p._cache_profile_effect[key] = effect
            except Exception:
                effect = p._cache_effect_default
            if effect not in ("blur", "darken", "blur_darken", "none"):
                effect = "blur"
            y1 = None
            progress = 0.0
            try:
                actionBar = outer.getActionBar() if outer is not None else None
                status = AndroidUtilities.statusBarHeight
                try:
                    ab_h = JActionBar.getCurrentActionBarHeight()
                except Exception:
                    ab_h = AndroidUtilities.dp(56)
                height = ab_h + (status if (actionBar is not None and actionBar.getOccupyStatusBar()) else 0)
                extraHeight = searchTransitionOffset = mediaHeaderAnimationProgress = 0.0
                for fname in ("extraHeight", "searchTransitionOffset", "mediaHeaderAnimationProgress"):
                    try:
                        ff = self._cached_field(outer.getClass(), fname)
                        if ff is None:
                            continue
                        val = ff.get(outer)
                        if fname == "extraHeight":
                            extraHeight = float(val)
                        elif fname == "searchTransitionOffset":
                            searchTransitionOffset = float(val)
                        else:
                            mediaHeaderAnimationProgress = float(val)
                    except Exception:
                        pass
                progress = max(0.0, min(1.0, float(mediaHeaderAnimationProgress)))
                y1 = int(float(extraHeight + height + searchTransitionOffset) * (1.0 - progress))
            except Exception:
                pass
            if y1 is None or y1 <= 0:
                y1 = AndroidUtilities.dp(240)
            try:
                tvh = topview.getMeasuredHeight()
                if tvh > 0:
                    y1 = min(int(y1), int(tvh))
            except Exception:
                pass
            w = topview.getMeasuredWidth()
            if w <= 0 or y1 <= 0:
                return

            if effect in ("blur", "blur_darken"):
                blurred = p._get_blurred_bitmap_for_key(key, bmp)
                if blurred is None or blurred.isRecycled():
                    return
                bmp_draw = blurred
            else:
                if bmp is None or bmp.isRecycled():
                    return
                bmp_draw = bmp

            bw = bmp_draw.getWidth()
            bh = bmp_draw.getHeight()
            if bw <= 0 or bh <= 0:
                return
            if 1.0 - progress <= 0.02:
                return

            scale = max(w / float(bw), y1 / float(bh)) * 1.02
            if self._matrix is None:
                self._matrix = Matrix()
            else:
                self._matrix.reset()
            matrix = self._matrix
            matrix.postScale(float(scale), float(scale))
            matrix.postTranslate((w - bw * scale) * 0.5, (y1 - bh * scale) * 0.5)

            save_id = canvas.save()
            try:
                try:
                    canvas.clipRect(0, 0, int(w), int(y1))
                except Exception:
                    canvas.clipRect(int(0), int(0), int(w), int(y1))
                if p._paint_bmp is None:
                    p._paint_bmp = Paint()
                    p._paint_bmp.setFilterBitmap(True)
                    p._paint_bmp.setDither(True)
                p._paint_bmp.setAlpha(255)
                canvas.drawBitmap(bmp_draw, matrix, p._paint_bmp)
                if effect in ("darken", "blur_darken"):
                    try:
                        overlay_alpha = int(255 * (p._cache_profile_dark / 100.0))
                        if overlay_alpha > 0:
                            if p._paint_darken is None:
                                p._paint_darken = Paint()
                                p._paint_darken.setStyle(Paint.Style.FILL)
                                p._paint_darken.setDither(True)
                                p._paint_darken.setAntiAlias(True)
                            p._paint_darken.setARGB(overlay_alpha, 0, 0, 0)
                            canvas.drawRect(0, 0, w, y1, p._paint_darken)
                    except Exception:
                        pass
                fade_alpha = int(max(0, min(255, p._cache_fade * (1.0 - progress))))
                if fade_alpha > 0:
                    grad_h = int(max(1, y1 * 0.35))
                    if p._paint_fade is None:
                        p._paint_fade = Paint()
                    fade_key = (y1, grad_h, fade_alpha)
                    if getattr(p, "_last_fade_key", None) != fade_key:
                        p._last_fade_key = fade_key
                        p._paint_fade.setShader(LinearGradient(
                            0, y1 - grad_h, 0, y1,
                            Color.argb(0, 0, 0, 0),
                            Color.argb(fade_alpha, 0, 0, 0),
                            Shader.TileMode.CLAMP
                        ))
                    canvas.drawRect(0, y1 - grad_h, w, y1, p._paint_fade)
            finally:
                try:
                    canvas.restoreToCount(save_id)
                except Exception:
                    try:
                        canvas.restore()
                    except Exception:
                        pass
        except Exception:
            pass

class _FragmentResumeHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)

    def after_hooked_method(self, param):
        try:
            p = self.p()
            if p is None:
                return
            fragment = param.thisObject
            if not fragment:
                return
            fragment_class_name = fragment.getClass().getName()
            if fragment_class_name in p.AB_BLACKLISTED_FRAGMENTS:
                if hasattr(fragment, "getActionBar") and (ab := fragment.getActionBar()):
                    ab.setBackgroundDrawable(ColorDrawable(Color.TRANSPARENT))
                return
            if "TopicsFragment" in fragment_class_name:
                p._make_topics_transparent(fragment)
            p._request_banner_update(fragment)
        except Exception as e:
            log(f"{_TAG} FragmentResumeHook error: {e}\n{traceback.format_exc()}")

