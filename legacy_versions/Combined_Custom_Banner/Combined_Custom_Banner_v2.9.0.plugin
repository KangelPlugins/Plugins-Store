_MAX_IMPORT_BYTES = 32 * 1024 * 1024


def _java_id(obj):
    if obj is None:
        return 0
    try:
        return int(obj.hashCode())
    except Exception:
        pass
    try:
        return id(obj)
    except Exception:
        return 0


def _cached_field(store, obj, name, limit=32):
    try:
        cls = obj.getClass()
        ck = str(cls.getName())
    except Exception:
        return None
    if ck in store:
        return store[ck]
    fld = None
    try:
        c = cls
        while c is not None:
            try:
                fld = c.getDeclaredField(name)
                break
            except Exception:
                try:
                    c = c.getSuperclass()
                except Exception:
                    c = None
        if fld is not None:
            fld.setAccessible(True)
    except Exception:
        fld = None
    try:
        if len(store) > limit:
            store.clear()
        store[ck] = fld
    except Exception:
        pass
    return fld


def _dp(value):
    try:
        return int(AndroidUtilities.dp(float(value)))
    except Exception:
        return int(value * 2)


class _ChannelCellDrawHook(MethodHook):
    def __init__(self, plugin):
        self.p = weakref.ref(plugin)
        self._paint_bmp = None
        self._paint_darken = None
        self._matrix = None

    def before_hooked_method(self, param):
        p = self.p()
        if p is None:
            return
        try:
            if not p._cache_cb_enable:
                return
            cell = param.thisObject
            canvas = param.args[0]
            if cell is None or canvas is None:
                return
            if not p._cb_current_channel_key:
                return
            key = p._cb_current_channel_key
            with p._cb_bmp_lock:
                bmp = p._cb_bmp_map.get(key)
            try:
                if bmp is not None and bmp.isRecycled():
                    bmp = None
            except Exception:
                bmp = None
            if bmp is None:

                p._cb_prefetch_bitmap(key)
                return
            w = cell.getMeasuredWidth()
            h = cell.getMeasuredHeight()
            if w <= 0 or h <= 0:
                return

            eff = p._cache_cb_effect
            bmp_d = p._cb_get_blurred(key, bmp) if p._cb_has_blur(eff) else bmp
            if bmp_d is None:
                bmp_d = bmp
            bw = bmp_d.getWidth()
            bh = bmp_d.getHeight()
            if bw <= 0 or bh <= 0:
                return

            scale = max(w / float(bw), h / float(bh))
            tx = (w - bw * scale) / 2.0
            ty = (h - bh * scale) / 2.0

            if self._matrix is None:
                self._matrix = Matrix()
            else:
                self._matrix.reset()
            mat = self._matrix
            mat.postScale(float(scale), float(scale))
            mat.postTranslate(float(tx), float(ty))

            sid = canvas.save()
            try:
                canvas.clipRect(0, 0, int(w), int(h))
                if self._paint_bmp is None:
                    self._paint_bmp = Paint()
                    self._paint_bmp.setFilterBitmap(True)
                canvas.drawBitmap(bmp_d, mat, self._paint_bmp)
                if p._cb_has_darken(eff):
                    a = int(255 * p._cache_cb_darken / 100.0)
                    if a > 0:
                        if self._paint_darken is None:
                            self._paint_darken = Paint()
                            self._paint_darken.setStyle(Paint.Style.FILL)
                        self._paint_darken.setARGB(a, 0, 0, 0)
                        canvas.drawRect(0, 0, float(w), float(h), self._paint_darken)
            finally:
                try:
                    canvas.restoreToCount(sid)
                except Exception:
                    try:
                        canvas.restore()
                    except Exception:
                        pass
        except Exception as e:
            log(f"{_CB_TAG} draw error: {e}")

    def after_hooked_method(self, param):
        p = self.p()
        if p is None:
            return
        try:
            if not p._cache_cb_enable:
                return
            cell = param.thisObject
            if cell is None or not p._cb_current_channel_key:
                return
            with p._cb_bmp_lock:
                _bmp = p._cb_bmp_map.get(p._cb_current_channel_key)
            try:
                if _bmp is not None and _bmp.isRecycled():
                    _bmp = None
            except Exception:
                _bmp = None
            if _bmp is None:
                p._cb_prefetch_bitmap(p._cb_current_channel_key)
                return
            p._cb_tint_views_white(cell)
        except Exception:
            pass

