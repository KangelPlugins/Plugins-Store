OnSeekBarChangeListener = jclass("android.widget.SeekBar$OnSeekBarChangeListener")


def _decode_github_base64(encoded: str, limit: int, label: str) -> bytes:
    """Decode a GitHub Contents payload without accepting oversized input."""
    compact = "".join(encoded.split())
    if not compact:
        raise ValueError(f"{label} is empty")

    max_encoded = 4 * ((int(limit) + 2) // 3)
    if len(compact) > max_encoded:
        raise ValueError(f"{label} is too large")

    try:
        data = base64.b64decode(compact, validate=True)
    except (binascii.Error, ValueError) as exc:
        raise ValueError(f"{label} has invalid base64") from exc
    if not data or len(data) > limit:
        raise ValueError(f"{label} has invalid size")
    return data


def _note_suppressed(exc: Any):
    """Keep compatibility fallbacks observable without flooding the log."""
    global _SUPPRESSED_FAILURE_TOTAL
    try:
        frame = sys._getframe(1)
        location = f"{frame.f_code.co_name}:{frame.f_lineno}"
        message = f"{type(exc).__name__}: {exc}"
        key = f"{location}:{message}"
        if key not in _SUPPRESSED_FAILURES and len(_SUPPRESSED_FAILURES) >= 256:
            key = "__overflow__"
            message = "additional compatibility failures"
        count = int(_SUPPRESSED_FAILURES.get(key, 0)) + 1
        _SUPPRESSED_FAILURES[key] = count
        _SUPPRESSED_FAILURE_TOTAL += 1
        plugin = _ACTIVE_PLUGIN
        if plugin is not None and (
            (count == 1 and len(_SUPPRESSED_FAILURES) <= 32) or count in (8, 32, 128)
        ):
            plugin.log(
                f"Glassify: compatibility fallback at {location} ({count}): {message}"
            )
    except Exception:
        return


def _identity(obj: Any) -> int:
    try:
        return int(System.identityHashCode(obj))
    except Exception:
        return id(obj)


def _active_strength() -> int:
    plugin = _ACTIVE_PLUGIN
    if plugin is None:
        return 50
    return plugin.current_strength()


def _theme_color(key: int, resources_provider: Any = None) -> int:
    try:
        return int(Theme.getColor(key, resources_provider))
    except Exception:
        try:
            return int(Theme.getColor(key))
        except Exception:
            return 0xFFFFFFFF


@java_subclass(Object, OnSeekBarChangeListener)
class _StrengthSeekListener(Base):
    def __init__(self, value_view):
        self.value_view = value_view

    @joverride()
    def onProgressChanged(self, seek_bar, progress, from_user):
        value = max(1, min(100, int(progress) + 1))
        try:
            self.value_view.setText(f"{value}%")
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if bool(from_user):
            plugin = _ACTIVE_PLUGIN
            if plugin is not None:
                plugin.preview_strength(value)

    @joverride()
    def onStartTrackingTouch(self, seek_bar):
        return

    @joverride()
    def onStopTrackingTouch(self, seek_bar):
        plugin = _ACTIVE_PLUGIN
        if plugin is None:
            return

        try:
            value = max(1, min(100, int(seek_bar.getProgress()) + 1))
        except Exception:
            value = plugin.current_strength()

        plugin.commit_strength(value)


def _create_strength_view(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    outer = LinearLayout(context)
    outer.setOrientation(LinearLayout.VERTICAL)
    outer.setGravity(Gravity.CENTER_VERTICAL)
    outer.setPadding(
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(14),
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(12),
    )
    try:
        screen_width = int(context.getResources().getDisplayMetrics().widthPixels)
        outer.setMinimumWidth(
            max(AndroidUtilities.dp(280), screen_width - AndroidUtilities.dp(24))
        )
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)

    header = LinearLayout(context)
    header.setOrientation(LinearLayout.HORIZONTAL)
    header.setGravity(Gravity.CENTER_VERTICAL)

    title = TextView(context)
    title.setText("Сила Liquid Glass")
    title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16.0)
    title.setTextColor(
        _theme_color(
            Theme.key_windowBackgroundWhiteBlackText,
            resources_provider,
        )
    )

    value_view = TextView(context)
    value_view.setText(f"{_active_strength()}%")
    value_view.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14.0)
    value_view.setGravity(Gravity.RIGHT | Gravity.CENTER_VERTICAL)
    value_view.setTypeface(AndroidUtilities.bold())
    value_view.setTextColor(
        _theme_color(
            getattr(
                Theme,
                "key_windowBackgroundWhiteBlueText",
                Theme.key_windowBackgroundWhiteBlackText,
            ),
            resources_provider,
        )
    )

    title_params = LinearLayout.LayoutParams(
        0,
        ViewGroup.LayoutParams.WRAP_CONTENT,
        1.0,
    )
    value_params = LinearLayout.LayoutParams(
        ViewGroup.LayoutParams.WRAP_CONTENT,
        ViewGroup.LayoutParams.WRAP_CONTENT,
    )
    header.addView(title, title_params)
    header.addView(value_view, value_params)

    seek_bar = SeekBar(context)
    seek_bar.setMax(99)
    seek_bar.setProgress(_active_strength() - 1)
    seek_bar.setContentDescription("Сила Liquid Glass от 1 до 100")
    seek_bar.setPadding(0, 0, 0, 0)
    try:
        seek_bar.setSplitTrack(False)
        seek_bar.setThumbOffset(0)
        seek_bar.setMinimumHeight(AndroidUtilities.dp(36))
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)

    accent = _theme_color(
        getattr(
            Theme,
            "key_windowBackgroundWhiteBlueText",
            Theme.key_windowBackgroundWhiteBlackText,
        ),
        resources_provider,
    )
    try:
        tint = ColorStateList.valueOf(accent)
        seek_bar.setProgressTintList(tint)
        seek_bar.setThumbTintList(tint)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)

    listener = _StrengthSeekListener.new_instance(init_args=[value_view])
    seek_bar.setOnSeekBarChangeListener(listener.java)
    _SLIDER_LISTENERS[_identity(seek_bar)] = listener
    while len(_SLIDER_LISTENERS) > 16:
        oldest = next(iter(_SLIDER_LISTENERS))
        _SLIDER_LISTENERS.pop(oldest, None)

    outer.addView(
        header,
        LinearLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            ViewGroup.LayoutParams.WRAP_CONTENT,
        ),
    )
    seek_params = LinearLayout.LayoutParams(
        ViewGroup.LayoutParams.MATCH_PARENT,
        AndroidUtilities.dp(44),
    )
    seek_params.topMargin = AndroidUtilities.dp(7)
    seek_params.leftMargin = 0
    seek_params.rightMargin = 0
    outer.addView(seek_bar, seek_params)

    return outer


def _bind_strength_view(view, item, divider, adapter, list_view):
    value = _active_strength()
    try:
        header = view.getChildAt(0)
        value_view = header.getChildAt(1)
        seek_bar = view.getChildAt(1)

        value_view.setText(f"{value}%")
        if int(seek_bar.getProgress()) != value - 1:
            seek_bar.setProgress(value - 1)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)


StrengthSliderFactory = SimpleSettingFactory(
    _create_strength_view,
    _bind_strength_view,
    is_clickable=False,
)


def _create_extension_preview_view(
    extension_id: str,
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    outer = FrameLayout(context)
    outer.setPadding(
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(8),
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(10),
    )

    image = ImageView(context)
    image.setScaleType(ImageView.ScaleType.CENTER_CROP)
    image.setContentDescription(f"Предпросмотр расширения {extension_id}")
    try:
        image.setClipToOutline(True)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)
    preview_background_key = getattr(
        Theme,
        "key_windowBackgroundGray",
        getattr(
            Theme,
            "key_windowBackgroundWhite",
            Theme.key_windowBackgroundWhiteBlackText,
        ),
    )
    image.setBackgroundColor(
        _theme_color(
            preview_background_key,
            resources_provider,
        )
    )
    try:
        background = GradientDrawable()
        background.setShape(GradientDrawable.RECTANGLE)
        background.setColor(
            _theme_color(
                preview_background_key,
                resources_provider,
            )
        )
        background.setCornerRadius(float(AndroidUtilities.dp(18)))
        image.setBackground(background)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)

    try:
        screen_width = int(context.getResources().getDisplayMetrics().widthPixels)
    except Exception:
        screen_width = AndroidUtilities.dp(360)
    card_width = max(AndroidUtilities.dp(280), screen_width - AndroidUtilities.dp(32))
    card_height = max(
        AndroidUtilities.dp(150),
        min(AndroidUtilities.dp(220), int(card_width * 0.5)),
    )
    outer.addView(
        image,
        FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            card_height,
        ),
    )

    placeholder = TextView(context)
    placeholder.setText("Загружаем предпросмотр…")
    placeholder.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14.0)
    placeholder.setGravity(Gravity.CENTER)
    placeholder.setTextColor(
        _theme_color(
            getattr(
                Theme,
                "key_windowBackgroundWhiteGrayText",
                Theme.key_windowBackgroundWhiteBlackText,
            ),
            resources_provider,
        )
    )
    outer.addView(
        placeholder,
        FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            card_height,
        ),
    )
    return outer


def _bind_extension_preview_view(
    extension_id: str,
    view,
    item,
    divider,
    adapter,
    list_view,
):
    plugin = _ACTIVE_PLUGIN
    if plugin is not None:
        plugin._bind_extension_preview_view(extension_id, view)


def _extension_preview_factory(extension_id: str):
    factory = _EXTENSION_PREVIEW_FACTORIES.get(extension_id)
    if factory is not None:
        return factory

    def create(context, list_view, current_account, class_guid, resources_provider):
        return _create_extension_preview_view(
            extension_id,
            context,
            list_view,
            current_account,
            class_guid,
            resources_provider,
        )

    def bind(view, item, divider, adapter, list_view):
        _bind_extension_preview_view(
            extension_id,
            view,
            item,
            divider,
            adapter,
            list_view,
        )

    factory = SimpleSettingFactory(create, bind, is_clickable=False)
    _EXTENSION_PREVIEW_FACTORIES[extension_id] = factory
    return factory


class _EnsureNativeBeforeHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        self.plugin.ensure_native_flags()


class _RememberDrawableAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        drawable = param.getResult()
        if drawable is None:
            return

        view = None
        try:
            if len(param.args) > 0:
                candidate = param.args[0]
                if candidate is not None and hasattr(candidate, "invalidate"):
                    view = candidate
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        self.plugin.remember_liquid_drawable(drawable, view)


class _FragmentCreatedAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin", kind: str, delay: int = 80):
        self.plugin = plugin
        self.kind = kind
        self.delay = delay

    def after_hooked_method(self, param):
        fragment = param.thisObject
        root = param.getResult()
        self.plugin.schedule(
            lambda: self.plugin.decorate_fragment(fragment, root, self.kind),
            self.delay,
        )


class _MainTabsCreatedAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin", delay: int = 96):
        self.plugin = plugin
        self.delay = delay

    def after_hooked_method(self, param):
        activity = param.thisObject
        root = param.getResult()
        self.plugin.schedule(
            lambda: self.plugin.decorate_main_tabs(activity, root),
            self.delay,
        )


class _TabSelectedAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        tab = param.thisObject
        try:
            selected = bool(param.args[0])
        except Exception:
            try:
                selected = bool(tab.isTabSelected())
            except Exception:
                return

        self.plugin.schedule(
            lambda: self.plugin.apply_tab_state(tab, selected),
            0,
        )


class _DialogsStoriesRefreshHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        fragment = param.thisObject
        for delay in (0, 80, 220, 420):
            self.plugin.schedule(
                lambda fragment=fragment: self.plugin.refresh_dialogs_stories(fragment),
                delay,
            )


class _DialogsSearchVisibilityHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        show = True
        try:
            show = bool(param.args[0])
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if show:
            self.plugin.set_dialogs_overlay_visible(
                param.thisObject,
                False,
            )

    def after_hooked_method(self, param):
        fragment = param.thisObject
        for delay in (0, 80, 220):
            self.plugin.schedule(
                lambda fragment=fragment: self.plugin.refresh_dialogs_stories(fragment),
                delay,
            )


