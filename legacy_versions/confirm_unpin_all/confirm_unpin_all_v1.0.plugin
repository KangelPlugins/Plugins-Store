from typing import Any, List
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from android_utils import log, run_on_ui_thread
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from android.view import View

__id__ = "confirm_unpin_all"
__name__ = "Confirm Unpin All"
__description__ = "Показывает диалог подтверждения после уведомления об откреплении всех сообщений (окошко высвечивается только когда уведомление исчезает!). @bobrplugins"
__author__ = "@bober41"
__version__ = "1.0"
__icon__ = "bobrplugins/16"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"


def get_view_text(view):
    """Пытается получить текст из любой View."""
    try:
        return str(view.getText())
    except:
        pass
    try:
        return str(get_private_field(view, "text"))
    except:
        pass
    try:
        return str(view.getContentDescription())
    except:
        pass
    return ""


def get_onclick_listener(view):
    """Через reflection достаёт установленный OnClickListener из View."""
    try:
        # Android: View.mListenerInfo.mOnClickListener
        li_field = View.getDeclaredField("mListenerInfo")
        li_field.setAccessible(True)
        li = li_field.get(view)
        if li:
            oc_field = li.getClass().getDeclaredField("mOnClickListener")
            oc_field.setAccessible(True)
            return oc_field.get(li)
    except Exception as e:
        log("get_onclick_listener error: " + str(e))
    return None


class PerformClickHook(MethodHook):
    """Перехватывает View.performClick() — срабатывает мгновенно при клике."""
    _skip_next = False
    _pending_view = None
    _pending_listener = None

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if PerformClickHook._skip_next:
                PerformClickHook._skip_next = False
                return

            view = param.thisObject
            text = get_view_text(view)
            lower = text.lower()

            # Проверяем, что это кнопка открепления
            if "откреп" not in lower and "unpin" not in lower:
                return

            # Получаем оригинальный listener
            original_listener = get_onclick_listener(view)
            if not original_listener:
                return

            # Сохраняем для повторного вызова
            PerformClickHook._pending_view = view
            PerformClickHook._pending_listener = original_listener

            # Отменяем оригинальный performClick
            param.setResult(True)

            # Показываем диалог подтверждения
            self._show_dialog(view, original_listener)
        except Exception as e:
            log("PerformClickHook error: " + str(e))

    def _show_dialog(self, view, original_listener):
        try:
            context = view.getContext()
            if not context:
                self._proceed()
                return

            builder = AlertDialogBuilder(context)
            builder.set_title("Открепить все сообщения?")
            builder.set_message("Вы точно хотите открепить все сообщения?")

            def on_yes(bld, which):
                bld.dismiss()
                self._proceed()

            def on_no(bld, which):
                bld.dismiss()
                PerformClickHook._pending_view = None
                PerformClickHook._pending_listener = None
                BulletinHelper.show_info("Открепление отменено")

            builder.set_positive_button("Открепить", on_yes)
            builder.set_negative_button("Отмена", on_no)
            builder.show()
        except Exception as e:
            log("Dialog error: " + str(e))
            self._proceed()

    def _proceed(self):
        """Вызывает оригинальный onClick, пропуская хук."""
        view = PerformClickHook._pending_view
        listener = PerformClickHook._pending_listener
        PerformClickHook._pending_view = None
        PerformClickHook._pending_listener = None
        if view and listener:
            PerformClickHook._skip_next = True
            try:
                listener.onClick(view)
            except Exception as e:
                log("Proceed error: " + str(e))
                PerformClickHook._skip_next = False


class ConfirmUnpinPlugin(BasePlugin):
    hooks = []

    def on_plugin_load(self):
        try:
            ViewClass = find_class("android.view.View")
            if not ViewClass:
                log("View class not found")
                return

            method = ViewClass.getDeclaredMethod("performClick")
            method.setAccessible(True)

            hook = self.hook_method(method, PerformClickHook(self))
            if hook:
                self.hooks.append(hook)
                log("Hooked View.performClick")
            else:
                log("Failed to hook performClick")
        except Exception as e:
            log("Plugin load error: " + str(e))

    def on_plugin_unload(self):
        for h in self.hooks:
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self.hooks.clear()

    def create_settings(self) -> List[Any]:
        from ui.settings import Header, Text
        return [
            Header(text="Confirm Unpin All"),
            Text(
                text="Плагин активен",
                subtext="Показывает диалог подтверждения при откреплении всех сообщений",
            ),
        ]
