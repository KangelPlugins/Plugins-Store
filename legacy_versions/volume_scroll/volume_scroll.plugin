import time
from typing import Any, List

from base_plugin import BasePlugin, MethodHook
from ui.settings import Header, Selector
from android_utils import run_on_ui_thread
from client_utils import get_last_fragment
from ui.bulletin import BulletinHelper
from hook_utils import find_class, get_private_field
from java import jclass

__id__ = "volume_scroll"
__name__ = "Volume Scroll"
__description__ = "Листает чат кнопками громкости. Двойное нажатие любой кнопки громкости вкл/выкл режим. Громкость больше - чат вверх, громкость меньше - чат вниз."
__author__ = "@SSmolot"
__version__ = "1.0"
__icon__ = "Ssmolot/0"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

KEYCODE_VOLUME_UP = 24
KEYCODE_VOLUME_DOWN = 25
ACTION_DOWN = 0

DOUBLE_TAP_WINDOW = 0.4
TOGGLE_COOLDOWN = 0.6


class VolumeScrollPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._unhooks = []
        self._scroll_mode = False
        self._last_tap_time = 0.0
        self._toggle_lock_until = 0.0

    def on_plugin_load(self):
        self._hook_key_events()

    def on_plugin_unload(self):
        self._scroll_mode = False

    def _hook_key_events(self):
        try:
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            if LaunchActivity is None:
                return

            plugin = self

            class DispatchKeyHook(MethodHook):
                def before_hooked_method(self, param):
                    try:
                        event = param.args[0]
                        if plugin._on_key_event(event):
                            param.setResult(True)
                    except Exception:
                        pass

            try:
                unhooks = self.hook_all_methods(LaunchActivity, "dispatchKeyEvent", DispatchKeyHook())
                if unhooks:
                    for u in unhooks:
                        self._unhooks.append(u)
            except Exception:
                pass

        except Exception:
            pass

    def _on_key_event(self, event) -> bool:
        try:
            keycode = event.getKeyCode()
            action = event.getAction()
        except Exception:
            return False

        if keycode not in (KEYCODE_VOLUME_UP, KEYCODE_VOLUME_DOWN):
            return False

        if action != ACTION_DOWN:
            return self._scroll_mode

        try:
            if event.getRepeatCount() != 0:
                if self._scroll_mode:
                    self._scroll(up=(keycode == KEYCODE_VOLUME_UP))
                    return True
                return False
        except Exception:
            pass

        now = time.time()

        if now < self._toggle_lock_until:
            if self._scroll_mode:
                self._scroll(up=(keycode == KEYCODE_VOLUME_UP))
                return True
            return False

        is_double = (now - self._last_tap_time) <= DOUBLE_TAP_WINDOW

        if is_double:
            self._last_tap_time = 0.0
            self._toggle_lock_until = now + TOGGLE_COOLDOWN
            self._toggle_mode()
            return True

        self._last_tap_time = now

        if self._scroll_mode:
            self._scroll(up=(keycode == KEYCODE_VOLUME_UP))
            return True

        return False

    def _toggle_mode(self):
        self._scroll_mode = not self._scroll_mode
        state = "включён" if self._scroll_mode else "выключен"
        run_on_ui_thread(lambda: BulletinHelper.show_info(f"Скролл громкостью: {state}"))

    def _scroll(self, up: bool):
        def do():
            try:
                fragment = get_last_fragment()
                if fragment is None:
                    return
                list_view = self._find_chat_list(fragment)
                if list_view is None:
                    return
                distance = self._scroll_distance()
                dy = -distance if up else distance
                list_view.smoothScrollBy(0, dy)
            except Exception:
                pass
        run_on_ui_thread(do)

    def _find_chat_list(self, fragment):
        for attr in ("chatListView", "listView"):
            try:
                lv = get_private_field(fragment, attr)
                if lv is not None:
                    return lv
            except Exception:
                continue
        return None

    def _scroll_distance(self) -> int:
        AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
        idx = self.get_setting("scroll_amount", 1)
        dp_map = {0: 120, 1: 260, 2: 500}
        return AndroidUtilities.dp(dp_map.get(idx, 260))

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Volume Scroll"),
            Selector(
                key="scroll_amount",
                text="Сила прокрутки",
                default=1,
                items=["Короткая", "Средняя", "Длинная"],
                icon="msg_sort",
            ),
        ]
