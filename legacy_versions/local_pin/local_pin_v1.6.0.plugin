View = jclass("android.view.View")
AlertDialog = jclass("org.telegram.ui.ActionBar.AlertDialog")
DialogInterface = jclass("android.content.DialogInterface")


def get_private_field(obj, field_name):
    """Helper to access private fields on Java objects via reflection if direct getattr returns None."""
    try:
        val = getattr(obj, field_name, None)
        if val is not None:
            return val
        cls = obj.getClass()
        while cls is not None:
            try:
                field = cls.getDeclaredField(field_name)
                field.setAccessible(True)
                return field.get(obj)
            except Exception:
                cls = cls.getSuperclass()
    except Exception:
        pass
    return None


class ViewClickListener(dynamic_proxy(View.OnClickListener)):
    def __init__(self, callback):
        super().__init__()
        self.callback = callback

    def onClick(self, view):
        try:
            if self.callback:
                self.callback(view)
        except Exception:
            pass


class DialogClickListener(dynamic_proxy(AlertDialog.OnButtonClickListener)):
    def __init__(self, callback):
        super().__init__()
        self.callback = callback

    def onClick(self, dialog, which):
        try:
            if self.callback:
                self.callback(dialog, which)
        except Exception:
            pass


class DismissListener(dynamic_proxy(DialogInterface.OnDismissListener)):
    def __init__(self, callback):
        super().__init__()
        self.callback = callback

    def onDismiss(self, dialog):
        try:
            if self.callback:
                self.callback(dialog)
        except Exception:
            pass


class FillMessageMenuHook(MethodHook):
    """Hook to capture MessageObject and append Pin or Unpin option at correct priority position."""
    def __init__(self, plugin):
        self.plugin = plugin

    def is_group_message_menu_enabled(self):
        try:
            ExteraConfig = jclass("com.exteragram.messenger.ExteraConfig")
            return bool(ExteraConfig.getGroupMessageMenu())
        except Exception:
            return False

    def get_insert_index(self, options):
        """Find priority position to insert Pin/Unpin option based on ExteraConfig groupMessageMenu setting."""
        is_group = self.is_group_message_menu_enabled()

        if is_group:
            before_options = {5, 201, 205, 16, 27}
            after_options = {28, 29, 21}
            fallback_before = {0, 4, 10, 2}
            fallback_after = {3, 1}
        else:
            before_options = {0, 4, 10, 2, 5, 201, 205, 16, 27}
            after_options = {28, 29, 3, 21, 1}
            fallback_before = set()
            fallback_after = set()

        last_before = -1
        first_after = -1
        last_fallback_before = -1
        first_fallback_after = -1

        for i in range(options.size()):
            opt = int(options.get(i))
            if opt in before_options:
                last_before = i
            elif opt in after_options and first_after == -1:
                first_after = i
            elif opt in fallback_before:
                last_fallback_before = i
            elif opt in fallback_after and first_fallback_after == -1:
                first_fallback_after = i

        if last_before != -1:
            idx = last_before + 1
        elif first_after != -1:
            idx = first_after
        elif last_fallback_before != -1:
            idx = last_fallback_before + 1
        elif first_fallback_after != -1:
            idx = first_fallback_after
        else:
            idx = options.size()

        self.plugin.log(f"get_insert_index: is_group={is_group}, insert_index={idx}")
        return idx

    def before_hooked_method(self, param):
        try:
            if param.args and len(param.args) > 0 and param.args[0]:
                self.plugin.last_message_object = param.args[0]
        except Exception:
            pass

    def after_hooked_method(self, param):
        try:
            if not param.args or len(param.args) < 4:
                return

            chat_activity = param.thisObject
            if not chat_activity:
                return

            # Skip comments section (isThreadChat and not isTopic)
            is_thread_chat = False
            try:
                if hasattr(chat_activity, "isThreadChat"):
                    is_thread_fn = getattr(chat_activity, "isThreadChat")
                    if callable(is_thread_fn):
                        is_thread_chat = is_thread_fn()
                    else:
                        is_thread_chat = bool(is_thread_fn)
            except Exception:
                pass

            is_topic = getattr(chat_activity, "isTopic", False)
            if is_thread_chat and not is_topic:
                self.plugin.log("fillMessageMenu: Skipped (thread chat and not topic)")
                return

            current_user = getattr(chat_activity, "currentUser", None)
            # Private chats already have native Pin/Unpin buttons
            if current_user is not None:
                self.plugin.log("fillMessageMenu: Skipped (private chat)")
                return

            message_object = param.args[0]
            if not message_object:
                return

            mid = message_object.getId()

            options = param.args[3]
            if not options:
                return

            current_chat = getattr(chat_activity, "currentChat", None)
            dialog_id = -current_chat.id if current_chat else 0

            Integer = jclass("java.lang.Integer")
            mid_obj = Integer(mid)

            # 1. Check if message is pinned on Telegram server by an admin
            is_server_pinned = False
            try:
                if hasattr(message_object, "messageOwner"):
                    owner = message_object.messageOwner
                    if owner and getattr(owner, "pinned", False):
                        is_server_pinned = True
            except Exception:
                pass

            if not is_server_pinned:
                try:
                    is_pinned_fn = getattr(message_object, "isPinned", None)
                    if callable(is_pinned_fn):
                        is_server_pinned = bool(is_pinned_fn())
                except Exception:
                    pass

            # 2. Check if message is in local database (pinnedMessageObjects / pinnedMessageIds)
            is_in_local_db = False
            pinned_message_objects = get_private_field(chat_activity, "pinnedMessageObjects")
            pinned_message_ids = get_private_field(chat_activity, "pinnedMessageIds")

            if pinned_message_objects:
                try:
                    if pinned_message_objects.containsKey(mid_obj):
                        is_in_local_db = True
                except Exception:
                    pass

            if not is_in_local_db and pinned_message_ids:
                try:
                    if pinned_message_ids.contains(mid_obj):
                        is_in_local_db = True
                except Exception:
                    pass

            # 3. Check if message is registered in self.plugin.local_pins
            is_pinned_locally = (dialog_id, mid) in self.plugin.local_pins

            # Auto-recover local pin if message is in local DB but not server-pinned
            if not is_pinned_locally and is_in_local_db and not is_server_pinned:
                is_pinned_locally = True
                self.plugin.local_pins.add((dialog_id, mid))
                self.plugin.save_local_pins()
                self.plugin.log(f"Auto-recovered local pin for mid={mid} in dialog={dialog_id}")

            ChatObject = jclass("org.telegram.messenger.ChatObject")
            can_pin_globally = ChatObject.canPinMessages(current_chat)

            self.plugin.log(f"Message mid={mid} in dialog={dialog_id} -> local={is_pinned_locally}, server_pinned={is_server_pinned}, can_pin={can_pin_globally}")

            icons = param.args[1]
            items = param.args[2]

            LocaleController = jclass("org.telegram.messenger.LocaleController")
            R = jclass("org.telegram.messenger.R")

            # Collect indices of any existing Pin (13) or Unpin (14) items
            existing_indices = []
            for i in range(options.size()):
                opt = int(options.get(i))
                if opt in (13, 14):
                    existing_indices.append(i)

            if is_pinned_locally:
                # Message is pinned locally by user -> show Unpin (14) at priority position
                if existing_indices:
                    first_idx = existing_indices[0]
                    options.set(first_idx, Integer(14))
                    items.set(first_idx, LocaleController.getString(R.string.UnpinMessage))
                    icons.set(first_idx, Integer(R.drawable.msg_unpin))
                    for idx in reversed(existing_indices[1:]):
                        options.remove(idx)
                        items.remove(idx)
                        icons.remove(idx)
                else:
                    insert_idx = self.get_insert_index(options)
                    options.add(insert_idx, Integer(14))
                    items.add(insert_idx, LocaleController.getString(R.string.UnpinMessage))
                    icons.add(insert_idx, Integer(R.drawable.msg_unpin))
                self.plugin.log(f"Configured Unpin option (14) for mid={mid}")
            elif not can_pin_globally and is_server_pinned:
                # Message is pinned globally by admin on server, but user has NO pin rights -> remove all Pin (13) and Unpin (14)
                for idx in reversed(existing_indices):
                    options.remove(idx)
                    items.remove(idx)
                    icons.remove(idx)
                self.plugin.log(f"Removed Pin/Unpin option for mid={mid} (pinned by admin on server, no rights)")
            elif is_server_pinned:
                # Message is pinned globally on server by admin, user HAS pin rights -> native Unpin (14) is kept as is
                pass
            else:
                # Message is not pinned -> show Pin (13) at priority position
                if existing_indices:
                    first_idx = existing_indices[0]
                    options.set(first_idx, Integer(13))
                    items.set(first_idx, LocaleController.getString(R.string.PinMessage))
                    icons.set(first_idx, Integer(R.drawable.msg_pin))
                    for idx in reversed(existing_indices[1:]):
                        options.remove(idx)
                        items.remove(idx)
                        icons.remove(idx)
                else:
                    insert_idx = self.get_insert_index(options)
                    options.add(insert_idx, Integer(13))
                    items.add(insert_idx, LocaleController.getString(R.string.PinMessage))
                    icons.add(insert_idx, Integer(R.drawable.msg_pin))
                self.plugin.log(f"Configured Pin option (13) for mid={mid}")
        except Exception as e:
            self.plugin.log(f"FillMessageMenuHook after error: {e}")


class ProcessSelectedOptionHook(MethodHook):
    """Hook for intercepting ChatActivity.processSelectedOption calls."""
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not param.args or len(param.args) == 0:
                return

            option = int(param.args[0])
            self.plugin.log(f"processSelectedOption called with option={option}")

            if option not in (13, 14):  # 13: OPTION_PIN, 14: OPTION_UNPIN
                return

            chat_activity = param.thisObject
            if not chat_activity:
                return

            # Skip comments section (isThreadChat and not isTopic)
            is_thread_chat = False
            try:
                if hasattr(chat_activity, "isThreadChat"):
                    is_thread_fn = getattr(chat_activity, "isThreadChat")
                    if callable(is_thread_fn):
                        is_thread_chat = is_thread_fn()
                    else:
                        is_thread_chat = bool(is_thread_fn)
            except Exception:
                pass

            is_topic = getattr(chat_activity, "isTopic", False)
            if is_thread_chat and not is_topic:
                self.plugin.log("processSelectedOption: Skipped (thread chat and not topic)")
                return

            current_user = getattr(chat_activity, "currentUser", None)
            if current_user is not None:
                # Private chat: let native Telegram handle pin/unpin
                self.plugin.log("Private chat: letting native Telegram handle pin/unpin")
                return

            current_chat = getattr(chat_activity, "currentChat", None)
            if not current_chat:
                self.plugin.log("currentChat is None")
                return

            # Comprehensive context menu dismissal
            self.plugin.dismiss_context_menu(chat_activity)

            selected_object = getattr(self.plugin, "last_message_object", None)
            if not selected_object:
                selected_object = getattr(chat_activity, "selectedObject", None)

            selected_object_group = getattr(chat_activity, "selectedObjectGroup", None)

            mid = 0
            if selected_object_group:
                try:
                    msgs = getattr(selected_object_group, "messages", None)
                    if msgs and not msgs.isEmpty():
                        mid = msgs.get(0).getId()
                except Exception:
                    pass

            if mid == 0 and selected_object:
                try:
                    mid = selected_object.getId()
                except Exception:
                    try:
                        mid = int(getattr(selected_object, "id", 0))
                    except Exception:
                        pass

            if option == 14:
                # OPTION_UNPIN
                ChatObject = jclass("org.telegram.messenger.ChatObject")
                can_pin_globally = ChatObject.canPinMessages(current_chat)
                if not can_pin_globally:
                    # User has no pin permissions in group/channel -> perform local unpin
                    if mid != 0:
                        self.plugin.log(f"Performing local unpin for mid={mid} in chat {current_chat.id}")
                        run_on_ui_thread(lambda: self.plugin.unpin_message_locally(chat_activity, mid))
                    param.setResult(None)
                return

            # option == 13: OPTION_PIN
            if mid == 0:
                self.plugin.log("Could not determine message ID in before_hooked_method")
                return

            self.plugin.log(f"Displaying custom pin dialog for mid={mid}")

            # Dispatch UI creation to main thread passing extracted mid
            run_on_ui_thread(lambda: self.plugin.show_pin_dialog(chat_activity, mid))

            # Suppress native processSelectedOption dialog
            param.setResult(None)
        except Exception as e:
            self.log(f"ProcessSelectedOptionHook error: {e}\n{traceback.format_exc()}")


class LocalPinPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.unhooks = []
        self.last_message_object = None
        self.local_pins = set()

    def load_local_pins(self):
        """Restore local pins set from plugin settings."""
        try:
            pins_list = self.get_setting("local_pins", [])
            self.local_pins = set()
            if pins_list and isinstance(pins_list, (list, tuple)):
                for item in pins_list:
                    if isinstance(item, str) and ":" in item:
                        parts = item.split(":", 1)
                        try:
                            self.local_pins.add((int(parts[0]), int(parts[1])))
                        except ValueError:
                            pass
            self.log(f"Loaded {len(self.local_pins)} local pins from settings")
        except Exception as e:
            self.log(f"load_local_pins error: {e}")

    def save_local_pins(self):
        """Save local pins set to plugin settings."""
        try:
            pins_list = [f"{did}:{mid}" for did, mid in self.local_pins]
            self.set_setting("local_pins", pins_list, True)
            self.log(f"Saved {len(pins_list)} local pins to settings")
        except Exception as e:
            try:
                pins_list = [f"{did}:{mid}" for did, mid in self.local_pins]
                self.set_setting("local_pins", pins_list)
            except Exception:
                pass
            self.log(f"save_local_pins error: {e}")

    def get_string(self, key):
        try:
            LocaleController = jclass("org.telegram.messenger.LocaleController")
            lang = LocaleController.getInstance().getCurrentLocaleInfo().pluralLangCode
            if lang and "_" in lang:
                lang = lang.split("_")[0]
        except Exception:
            lang = "en"
        lang_dict = locales.get(lang, locales.get("en", {}))
        return lang_dict.get(key, locales.get("en", {}).get(key, key))

    def open_cache_control(self):
        """Open native Telegram CacheControlActivity screen to allow user to manage/clear local database."""
        try:
            self.log("Opening Telegram CacheControlActivity screen")
            CacheControlActivity = jclass("org.telegram.ui.CacheControlActivity")
            fragment = get_last_fragment()
            if fragment:
                fragment.presentFragment(CacheControlActivity())
        except Exception as e:
            self.log(f"open_cache_control error: {e}")

    def clear_all_local_pins(self):
        """Unpin all local pins from SQLite database and clear plugin settings."""
        try:
            if not self.local_pins:
                self.log("clear_all_local_pins: No local pins to clear")
                return

            UserConfig = jclass("org.telegram.messenger.UserConfig")
            MessagesStorage = jclass("org.telegram.messenger.MessagesStorage")
            NotificationCenter = jclass("org.telegram.messenger.NotificationCenter")
            Integer = jclass("java.lang.Integer")
            Long = jclass("java.lang.Long")
            ArrayList = jclass("java.util.ArrayList")

            storage = MessagesStorage.getInstance(UserConfig.selectedAccount)
            notif_center = NotificationCenter.getInstance(UserConfig.selectedAccount)

            dialog_map = {}
            for did, mid in self.local_pins:
                if did not in dialog_map:
                    dialog_map[did] = ArrayList()
                dialog_map[did].add(Integer(mid))

            self.log(f"Starting clear_all_local_pins for {len(self.local_pins)} pins across {len(dialog_map)} dialogs")

            for did, ids in dialog_map.items():
                try:
                    storage.updatePinnedMessages(did, ids, False, -1, 0, False, None)
                    notif_center.postNotificationName(
                        NotificationCenter.updateInterfaces,
                        Integer(0)
                    )
                    notif_center.postNotificationName(
                        NotificationCenter.didLoadPinnedMessages,
                        Long(did),
                        ids,
                        False,
                        None,
                        None,
                        Integer(0),
                        Integer(0),
                        True
                    )
                    self.log(f"Cleared {ids.size()} local pins in dialog={did}")
                except Exception as err:
                    self.log(f"clear_all_local_pins error for dialog {did}: {err}")

            self.local_pins.clear()
            self.save_local_pins()
            self.log("Successfully cleared all local pins")

            fragment = get_last_fragment()
            if fragment:
                parent_activity = fragment.getParentActivity()
                if parent_activity:
                    try:
                        try:
                            resource_provider = fragment.getResourceProvider()
                        except Exception:
                            resource_provider = None

                        Bulletin = jclass("org.telegram.ui.Components.Bulletin")
                        R = jclass("org.telegram.messenger.R")

                        layout = Bulletin.LottieLayout(parent_activity, resource_provider)
                        layout.setAnimation(R.raw.ic_unpin, 28, 28, "Unpin", "Line")
                        layout.textView.setText(self.get_string("all_pins_cleared_bulletin"))
                        bulletin = Bulletin.make(fragment, layout, 1500)
                        bulletin.show()
                    except Exception as b_err:
                        self.log(f"Custom bulletin error: {b_err}")
        except Exception as e:
            self.log(f"clear_all_local_pins error: {e}\n{traceback.format_exc()}")

    def show_clear_all_confirmation(self):
        """Show confirmation dialog before unpinning all local pins."""
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if not activity:
                return

            self.log("Displaying clear_all_pins confirmation dialog")

            try:
                resource_provider = fragment.getResourceProvider()
            except Exception:
                resource_provider = None

            AlertDialog = jclass("org.telegram.ui.ActionBar.AlertDialog")
            builder = AlertDialog.Builder(activity, resource_provider)
            builder.setTitle(self.get_string("confirm_clear_all_title"))
            builder.setMessage(self.get_string("confirm_clear_all_message"))

            def on_confirm(dialog, which):
                self.log("User confirmed clearing all local pins")
                run_on_ui_thread(lambda: self.clear_all_local_pins())

            builder.setPositiveButton(self.get_string("clear_button"), DialogClickListener(on_confirm))
            builder.setNegativeButton(self.get_string("cancel_button"), None)

            dialog = builder.create()
            if fragment:
                fragment.showDialog(dialog)
        except Exception as e:
            self.log(f"show_clear_all_confirmation error: {e}")

    def create_settings(self):
        """Reworked plugin settings UI displaying active local pins count, clear action, and storage management."""
        self.load_local_pins()
        count = len(self.local_pins)
        subtext_template = self.get_string("active_pins_subtext")
        subtext_str = subtext_template.format(count) if "{}" in subtext_template else f"{count}"

        active_pins_item = Text(
            text=self.get_string("active_pins_title"),
            icon="msg_pin",
        )
        setattr(active_pins_item, "value", str(count))
        setattr(active_pins_item, "subtext", subtext_str)

        clear_pins_item = Text(
            text=self.get_string("clear_all_pins_title"),
            icon="msg_delete",
            red=True,
            on_click=lambda *args: self.show_clear_all_confirmation()
        )
        setattr(clear_pins_item, "subtext", self.get_string("clear_all_pins_subtext"))

        return [
            Header(text=self.get_string("settings_header")),
            active_pins_item,
            clear_pins_item,
            Divider(),
            Header(text=self.get_string("storage_header")),
            Text(
                text=self.get_string("storage_settings_title"),
                subtext=self.get_string("storage_settings_subtext"),
                icon="msg_settings",
                on_click=lambda *args: self.open_cache_control()
            ),
            Divider(text=self.get_string("clear_database_info"))
        ]

    def dismiss_context_menu(self, chat_activity):
        """Properly dismiss all context menus, popups and action bar modes before showing dialogs."""
        try:
            if hasattr(chat_activity, "closeMenu"):
                try:
                    chat_activity.closeMenu(False)
                except Exception:
                    try:
                        chat_activity.closeMenu()
                    except Exception:
                        pass
        except Exception:
            pass

        try:
            if hasattr(chat_activity, "actionBarPopupWindow"):
                popup = getattr(chat_activity, "actionBarPopupWindow", None)
                if popup:
                    popup.dismiss()
        except Exception:
            pass

        try:
            if hasattr(chat_activity, "dismissCurrentDialog"):
                chat_activity.dismissCurrentDialog()
            elif getattr(chat_activity, "visibleDialog", None):
                chat_activity.visibleDialog.dismiss()
        except Exception:
            pass

        try:
            if hasattr(chat_activity, "popupMenu"):
                popup_menu = getattr(chat_activity, "popupMenu", None)
                if popup_menu:
                    popup_menu.dismiss()
        except Exception:
            pass

        try:
            if hasattr(chat_activity, "itemOptions"):
                item_options = getattr(chat_activity, "itemOptions", None)
                if item_options and hasattr(item_options, "dismiss"):
                    item_options.dismiss()
        except Exception:
            pass

        try:
            if hasattr(chat_activity, "hideActionMode"):
                chat_activity.hideActionMode()
            elif hasattr(chat_activity, "finishActionMode"):
                chat_activity.finishActionMode()
        except Exception:
            pass

        try:
            ab = chat_activity.getActionBar()
            if ab and hasattr(ab, "closeSubMenu"):
                ab.closeSubMenu()
        except Exception:
            pass

    def on_plugin_load(self):
        """Hook processSelectedOption and fillMessageMenu in ChatActivity."""
        try:
            self.load_local_pins()
            chat_activity_cls = find_class("org.telegram.ui.ChatActivity")
            target_cls = getattr(chat_activity_cls, "getClass", lambda: None)() or chat_activity_cls

            if target_cls:
                for method in target_cls.getDeclaredMethods():
                    method_name = method.getName()
                    param_types = method.getParameterTypes()
                    if method_name == "processSelectedOption":
                        if len(param_types) == 1 and param_types[0].getName() == "int":
                            method.setAccessible(True)
                            unhook = self.hook_method(method, ProcessSelectedOptionHook(self))
                            if unhook:
                                self.unhooks.append(unhook)
                                self.log("Successfully hooked ChatActivity.processSelectedOption")
                    elif method_name == "fillMessageMenu":
                        if len(param_types) == 4:
                            method.setAccessible(True)
                            unhook = self.hook_method(method, FillMessageMenuHook(self))
                            if unhook:
                                self.unhooks.append(unhook)
                                self.log("Successfully hooked ChatActivity.fillMessageMenu")
        except Exception as e:
            self.log(f"Failed to hook ChatActivity methods: {e}\n{traceback.format_exc()}")

    def on_plugin_unload(self):
        """Remove hooks on plugin unload."""
        try:
            for unhook in self.unhooks:
                if unhook:
                    try:
                        self.unhook_method(unhook)
                    except Exception:
                        pass
            self.unhooks.clear()
            self.last_message_object = None
            self.local_pins.clear()
            self.log("LocalPin plugin unloaded")
        except Exception as e:
            self.log(f"Unload error: {e}")

    def unpin_message_locally(self, chat_activity, mid):
        """Unpin message locally without sending RPC request to Telegram server."""
        try:
            current_chat = getattr(chat_activity, "currentChat", None)
            dialog_id = -current_chat.id if current_chat else 0
            self.log(f"unpin_message_locally initiated for mid={mid} in dialog={dialog_id}")
            if dialog_id != 0:
                self.local_pins.discard((dialog_id, mid))
                self.save_local_pins()

                Integer = jclass("java.lang.Integer")
                Long = jclass("java.lang.Long")
                ArrayList = jclass("java.util.ArrayList")

                ids = ArrayList()
                mid_obj = Integer(mid)
                ids.add(mid_obj)

                # 1. Update SQLite DB
                try:
                    chat_activity.getMessagesStorage().updatePinnedMessages(dialog_id, ids, False, -1, 0, False, None)
                    self.log(f"Successfully unpinned local pin for mid={mid} in dialog={dialog_id}")
                except Exception as db_err:
                    self.log(f"updatePinnedMessages unpin error: {db_err}")

                # 2. Update ChatActivity in-memory collections
                try:
                    pinned_message_ids = get_private_field(chat_activity, "pinnedMessageIds")
                    pinned_message_objects = get_private_field(chat_activity, "pinnedMessageObjects")

                    if pinned_message_ids is not None:
                        pinned_message_ids.remove(mid_obj)

                    if pinned_message_objects is not None:
                        pinned_message_objects.remove(mid_obj)
                except Exception as mem_err:
                    self.log(f"Memory update unpin error: {mem_err}")

                # 3. Post NotificationCenter events
                try:
                    NotificationCenter = jclass("org.telegram.messenger.NotificationCenter")
                    chat_activity.getNotificationCenter().postNotificationName(
                        NotificationCenter.updateInterfaces,
                        Integer(0)
                    )
                    chat_activity.getNotificationCenter().postNotificationName(
                        NotificationCenter.didLoadPinnedMessages,
                        Long(dialog_id),
                        ids,
                        False,
                        None,
                        None,
                        Integer(0),
                        Integer(0),
                        True
                    )
                except Exception as notif_err:
                    self.log(f"NotificationCenter unpin error: {notif_err}")

            parent_activity = chat_activity.getParentActivity()
            try:
                resource_provider = chat_activity.getResourceProvider()
            except Exception:
                resource_provider = None

            BulletinFactory = jclass("org.telegram.ui.Components.BulletinFactory")
            bulletin = BulletinFactory.createUnpinMessageBulletin(chat_activity, None, None, resource_provider)
            bulletin.show()
            self.log(f"unpin_message_locally finished for mid={mid}")
        except Exception as e:
            self.log(f"unpin_message_locally error: {e}\n{traceback.format_exc()}")

    def show_pin_dialog(self, chat_activity, mid):
        """Build and show pin dialog formatted according to chat type and permissions."""
        try:
            parent_activity = chat_activity.getParentActivity()
            if not parent_activity:
                self.log("show_pin_dialog: parentActivity is None")
                return

            current_user = getattr(chat_activity, "currentUser", None)
            current_chat = getattr(chat_activity, "currentChat", None)
            pinned_message_ids = get_private_field(chat_activity, "pinnedMessageIds")
            is_topic = getattr(chat_activity, "isTopic", False)

            try:
                resource_provider = chat_activity.getResourceProvider()
            except Exception:
                resource_provider = None

            LocaleController = jclass("org.telegram.messenger.LocaleController")
            R = jclass("org.telegram.messenger.R")
            Theme = jclass("org.telegram.ui.ActionBar.Theme")
            LayoutHelper = jclass("org.telegram.ui.Components.LayoutHelper")
            RadioColorCell = jclass("org.telegram.ui.Cells.RadioColorCell")
            CheckBoxCell = jclass("org.telegram.ui.Cells.CheckBoxCell")
            AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
            ChatObject = jclass("org.telegram.messenger.ChatObject")
            LinearLayout = jclass("android.widget.LinearLayout")

            builder = AlertDialog.Builder(parent_activity, resource_provider)
            builder.setTitle(LocaleController.getString(R.string.PinMessageAlertTitle))

            try:
                setattr(chat_activity, "preserveDim", True)
            except Exception:
                pass

            builder.setDimAlpha(0.5)

            def on_pre_dismiss(di):
                try:
                    dim_fn = getattr(chat_activity, "dimBehindView", None)
                    if dim_fn:
                        dim_fn(False)
                except Exception:
                    pass

            builder.setOnPreDismissListener(DismissListener(on_pre_dismiss))

            checks = [False, False]

            can_pin_globally = ChatObject.canPinMessages(current_chat)
            is_channel_not_megagroup = ChatObject.isChannel(current_chat) and not current_chat.megagroup

            is_old_pin = False
            if pinned_message_ids:
                try:
                    if not pinned_message_ids.isEmpty() and mid < pinned_message_ids.get(0):
                        is_old_pin = True
                except Exception:
                    pass

            self.log(f"show_pin_dialog: mid={mid}, can_pin={can_pin_globally}, is_channel={is_channel_not_megagroup}, is_old_pin={is_old_pin}")

            if (ChatObject.isChannel(current_chat) and current_chat.megagroup) or (current_chat is not None and not ChatObject.isChannel(current_chat)):
                if is_old_pin:
                    builder.setMessage(LocaleController.getString(R.string.PinOldMessageAlert))
                    checks = [False, True]
                else:
                    if is_topic:
                        builder.setMessage(LocaleController.getString(R.string.PinMessageInTopicAlert))
                    else:
                        builder.setMessage(LocaleController.getString(R.string.PinMessageAlert))
                    checks = [True, True]
            else:
                current_pinned_id = getattr(chat_activity, "currentPinnedMessageId", 0)
                if current_pinned_id != 0 and mid < current_pinned_id:
                    builder.setMessage(LocaleController.getString(R.string.PinOldMessageAlert))
                else:
                    builder.setMessage(LocaleController.getString(R.string.PinMessageAlertChannel))
                checks = [False, True]

            container = LinearLayout(parent_activity)
            container.setOrientation(LinearLayout.VERTICAL)

            is_rtl = LocaleController.isRTL
            left_pad = 16 if is_rtl else 8
            right_pad = 8 if is_rtl else 16

            cell_local_checkbox = None
            cell_notify_radio = None
            cell_local_radio = None

            notify_selected = [checks[0] if can_pin_globally else False]
            local_selected = [False]

            if not can_pin_globally:
                # Case 2: Group/Channel WITHOUT Admin Pin Rights
                # No checkboxes, no radiobuttons. Positive button text set to "Pin locally".
                builder.setView(None)
                positive_btn_text = self.get_string("pin_locally")
            elif is_channel_not_megagroup:
                # Case 3: Channel WITH Admin Pin Rights
                # CheckBoxCell only
                cell_local_checkbox = CheckBoxCell(parent_activity, 1, resource_provider)
                cell_local_checkbox.setBackgroundDrawable(Theme.getSelectorDrawable(False))
                cell_local_checkbox.setText(self.get_string("pin_locally"), "", False, False)
                cell_local_checkbox.setPadding(AndroidUtilities.dp(left_pad), 0, AndroidUtilities.dp(right_pad), 0)

                def on_checkbox_click(v):
                    try:
                        cell = v
                        cell.setChecked(not cell.isChecked(), True)
                    except Exception as err:
                        self.log(f"on_checkbox_click error: {err}")

                cell_local_checkbox.setOnClickListener(ViewClickListener(on_checkbox_click))
                container.addView(cell_local_checkbox, LayoutHelper.createLinear(-1, 48))

                builder.setCustomViewOffset(9)
                builder.setView(container)
                positive_btn_text = LocaleController.getString(R.string.PinMessage)
            else:
                # Case 4: Group WITH Admin Pin Rights
                # RadioColorCells for mutually exclusive "Notify all members" vs "Pin locally"
                has_notify_cell = not is_old_pin

                if has_notify_cell:
                    cell_notify_radio = RadioColorCell(parent_activity, resource_provider)
                    cell_notify_radio.setTextAndValue(LocaleController.getString(R.string.PinNotify), notify_selected[0])
                    cell_notify_radio.setPadding(AndroidUtilities.dp(left_pad), 0, AndroidUtilities.dp(right_pad), 0)

                    def on_notify_click(v):
                        try:
                            if notify_selected[0]:
                                notify_selected[0] = False
                            else:
                                notify_selected[0] = True
                                local_selected[0] = False

                            cell_notify_radio.setChecked(notify_selected[0], True)
                            if cell_local_radio:
                                cell_local_radio.setChecked(local_selected[0], True)
                            self.log(f"Radio notify clicked -> notify={notify_selected[0]}, local={local_selected[0]}")
                        except Exception as err:
                            self.log(f"on_notify_click error: {err}")

                    cell_notify_radio.setOnClickListener(ViewClickListener(on_notify_click))
                    container.addView(cell_notify_radio, LayoutHelper.createLinear(-1, 50))

                cell_local_radio = RadioColorCell(parent_activity, resource_provider)
                cell_local_radio.setTextAndValue(self.get_string("pin_locally"), local_selected[0])
                cell_local_radio.setPadding(AndroidUtilities.dp(left_pad), 0, AndroidUtilities.dp(right_pad), 0)

                def on_local_click(v):
                    try:
                        if local_selected[0]:
                            local_selected[0] = False
                        else:
                            local_selected[0] = True
                            notify_selected[0] = False

                        cell_local_radio.setChecked(local_selected[0], True)
                        if cell_notify_radio:
                            cell_notify_radio.setChecked(notify_selected[0], True)
                        self.log(f"Radio local clicked -> local={local_selected[0]}, notify={notify_selected[0]}")
                    except Exception as err:
                        self.log(f"on_local_click error: {err}")

                cell_local_radio.setOnClickListener(ViewClickListener(on_local_click))
                container.addView(cell_local_radio, LayoutHelper.createLinear(-1, 50))

                builder.setCustomViewOffset(9)
                builder.setView(container)
                positive_btn_text = LocaleController.getString(R.string.PinMessage)

            def on_positive_click(dialog_interface, i):
                try:
                    if not can_pin_globally:
                        is_one_side = True
                        notify = False
                    elif is_channel_not_megagroup:
                        is_one_side = cell_local_checkbox.isChecked() if cell_local_checkbox else False
                        notify = False
                    else:
                        is_one_side = local_selected[0]
                        notify = notify_selected[0]
                    self.log(f"Pin confirming: is_one_side={is_one_side}, notify={notify}")

                    if is_one_side:
                        # Local pin: update local SQLite database directly without sending RPC request to Telegram server
                        dialog_id = -current_chat.id if current_chat else (current_user.id if current_user else 0)
                        if dialog_id != 0:
                            self.local_pins.add((dialog_id, mid))
                            self.save_local_pins()

                            Integer = jclass("java.lang.Integer")
                            Long = jclass("java.lang.Long")
                            ArrayList = jclass("java.util.ArrayList")

                            ids = ArrayList()
                            mid_obj = Integer(mid)
                            ids.add(mid_obj)

                            selected_object = getattr(self, "last_message_object", None)
                            if not selected_object:
                                selected_object = getattr(chat_activity, "selectedObject", None)

                            # 1. Save to SQLite database
                            try:
                                chat_activity.getMessagesStorage().updatePinnedMessages(dialog_id, ids, True, -1, 0, False, None)
                                self.log(f"Successfully saved local pin for mid={mid} in dialog={dialog_id}")
                            except Exception as db_err:
                                self.log(f"updatePinnedMessages error: {db_err}")

                            # 2. Update ChatActivity in-memory fields directly
                            try:
                                pinned_message_ids = get_private_field(chat_activity, "pinnedMessageIds")
                                pinned_message_objects = get_private_field(chat_activity, "pinnedMessageObjects")

                                if pinned_message_ids is not None and not pinned_message_ids.contains(mid_obj):
                                    pinned_message_ids.add(mid_obj)

                                if pinned_message_objects is not None and selected_object:
                                    pinned_message_objects.put(mid_obj, selected_object)
                            except Exception as mem_err:
                                self.log(f"Memory update pin error: {mem_err}")

                            # 3. Post NotificationCenter events with non-empty objects list
                            try:
                                NotificationCenter = jclass("org.telegram.messenger.NotificationCenter")
                                objects = ArrayList()
                                if selected_object:
                                    objects.add(selected_object)

                                chat_activity.getNotificationCenter().postNotificationName(
                                    NotificationCenter.updateInterfaces,
                                    Integer(0)
                                )
                                chat_activity.getNotificationCenter().postNotificationName(
                                    NotificationCenter.didLoadPinnedMessages,
                                    Long(dialog_id),
                                    ids,
                                    True,
                                    objects,
                                    None,
                                    Integer(0),
                                    Integer(0),
                                    True
                                )
                            except Exception as notif_err:
                                self.log(f"NotificationCenter error: {notif_err}\n{traceback.format_exc()}")

                        Bulletin = jclass("org.telegram.ui.Components.Bulletin")
                        layout = Bulletin.LottieLayout(parent_activity, resource_provider)
                        layout.setAnimation(R.raw.ic_pin, 28, 28, "Pin", "Line")
                        layout.textView.setText(self.get_string("pin_locally_bulletin"))
                        bulletin = Bulletin.make(chat_activity, layout, 1500)
                        bulletin.show()
                    else:
                        # Global pin: send request to Telegram server
                        messages_controller = chat_activity.getMessagesController()
                        messages_controller.pinMessage(current_chat, current_user, mid, False, False, notify)

                        BulletinFactory = jclass("org.telegram.ui.Components.BulletinFactory")
                        bulletin = BulletinFactory.createPinMessageBulletin(chat_activity, resource_provider)
                        bulletin.show()

                    try:
                        view = bulletin.getLayout()
                        HapticFeedbackConstants = jclass("android.view.HapticFeedbackConstants")
                        run_on_ui_thread(lambda: view.performHapticFeedback(
                            HapticFeedbackConstants.KEYBOARD_TAP,
                            HapticFeedbackConstants.FLAG_IGNORE_GLOBAL_SETTING
                        ), delay=550)
                    except Exception:
                        pass
                except Exception as err:
                    self.log(f"on_positive_click error: {err}\n{traceback.format_exc()}")

            builder.setPositiveButton(positive_btn_text, DialogClickListener(on_positive_click))
            builder.setNegativeButton(LocaleController.getString(R.string.Cancel), None)

            dialog = builder.create()
            chat_activity.showDialog(dialog)
            self.log("show_pin_dialog: Dialog created and shown successfully")
        except Exception as e:
            self.log(f"show_pin_dialog error: {e}\n{traceback.format_exc()}")
