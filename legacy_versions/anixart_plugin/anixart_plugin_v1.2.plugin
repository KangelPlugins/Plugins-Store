class AnixartPlugin(BasePlugin):
    def on_plugin_load(self):
        self._token = self.get_setting("auth_token", None)
        self._profile_id = self.get_setting("profile_id", None)
        self._login = None
        self._base_url = BASE_URL
        self._static_domain = None
        self._tracker_scheduled = False
        self._genre_cache = {}
        self.add_on_send_message_hook()
        self._try_auto_login()
        self._maybe_start_tracker()

