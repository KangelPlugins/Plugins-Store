    def _show_dialog(self, title: str, message: str):
        def _do():
            try:
                current_fragment = get_last_fragment()
                if not current_fragment:
                    return
                activity = current_fragment.getParentActivity()
                if not activity:
                    return
                builder = AlertDialogBuilder(activity)
                builder.set_title(title)
                builder.set_message(message)
                builder.set_positive_button("OK", lambda b, w: b.dismiss())
                builder.show()
            except Exception:
                pass
        run_on_ui_thread(_do)

    def _try_auto_login(self):
        base_url = self.get_setting("base_url", BASE_URL).strip()
        if base_url:
            self._base_url = base_url.rstrip("/")
        if self._token:
            return
        login = self.get_setting("login", "").strip()
        password = self.get_setting("password", "").strip()
        if login and password:
            run_on_queue(lambda: self._do_login(login, password, silent=True))

    def _manual_login(self, view=None):
        login = self.get_setting("login", "").strip()
        password = self.get_setting("password", "").strip()
        base_url = self.get_setting("base_url", BASE_URL).strip()
        if not login or not password:
            self._show_dialog("Ошибка", "Введите логин и пароль в настройках плагина.")
            return
        if base_url:
            self._base_url = base_url.rstrip("/")
        run_on_queue(lambda: self._do_login(login, password, silent=False))

    def _do_login(self, login: str, password: str, silent: bool = False):
        try:
            url = f"{self._base_url}/auth/signIn?login={requests.utils.quote(login)}&password={requests.utils.quote(password)}"
            resp = requests.post(
                url,
                headers={"User-Agent": USER_AGENT, "Accept": "application/json"},
                timeout=15,
            )
            resp.raise_for_status()
            data = resp.json()
            code = data.get("code", -1)
            if code != 0:
                msg = self._error_msg(code)
                if not silent:
                    self._show_dialog("Ошибка входа", msg)
                return
            token = data.get("profileToken", {}).get("token")
            if not token:
                if not silent:
                    self._show_dialog("Ошибка", "Не удалось получить токен.")
                return
            self._token = token
            self.set_setting("auth_token", token, reload_settings=False)
            profile_data = data.get("profile") or {}
            self._login = profile_data.get("login") or login
            self._profile_id = profile_data.get("id")
            if self._profile_id:
                self.set_setting("profile_id", self._profile_id, reload_settings=False)
            if not silent:
                self._show_dialog("Успех", f"Вход выполнен!\nПользователь: {self._login}")
            self._refresh_static_domain()
        except Exception as e:
            if not silent:
                self._show_dialog("Ошибка соединения", str(e))

    def _ensure_token(self) -> bool:
        if self._token:
            if not self._profile_id:
                saved_id = self.get_setting("profile_id", None)
                if saved_id:
                    self._profile_id = saved_id
            return True
        saved_token = self.get_setting("auth_token", None)
        if saved_token:
            self._token = saved_token
            saved_id = self.get_setting("profile_id", None)
            if saved_id:
                self._profile_id = saved_id
            return True
        login = self.get_setting("login", "").strip()
        password = self.get_setting("password", "").strip()
        if login and password:
            self._do_login(login, password, silent=True)
        return bool(self._token)

    def _error_msg(self, code: int) -> str:
        codes = {
            0: "Успех",
            1: "Неизвестная ошибка",
            2: "Неверный логин",
            3: "Неверный пароль",
            401: "Не авторизован",
            402: "Бан",
            403: "Перманентный бан",
        }
        return codes.get(code, f"Код {code}")

    def _refresh_static_domain(self):
        try:
            url = f"{self._base_url}/config/toggles?version_code=25082901&is_beta=true"
            if self._token:
                url += f"&token={requests.utils.quote(self._token)}"
            resp = requests.get(url, headers={"User-Agent": USER_AGENT}, timeout=15)
            resp.raise_for_status()
            data = resp.json()
            domain = data.get("staticDomain") or data.get("baseUrl") or ""
            if domain:
                self._static_domain = self._normalize_domain(domain)
            else:
                self._static_domain = STATIC_FALLBACK
        except Exception:
            self._static_domain = STATIC_FALLBACK

    def _normalize_domain(self, domain: str) -> str:
        domain = domain.strip()
        if not domain.startswith("http://") and not domain.startswith("https://"):
            domain = "https://" + domain
        if not domain.endswith("/"):
            domain += "/"
        return domain

    def _get_static_domain(self) -> str:
        if self._static_domain is None:
            self._refresh_static_domain()
        return self._static_domain or STATIC_FALLBACK

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        try:
            msg = getattr(params, "message", None)
            if not isinstance(msg, str):
                return HookResult()
            text = msg.strip()

            # Команда .alias — верхнеуровневая, без префикса .a
            if text.startswith(".alias"):
                arg = text[len(".alias"):].strip()
                peer = getattr(params, "peer", None)
                if peer is None:
                    peer = getattr(params, "dialog_id", None)
                peer_id = self._extract_peer_id(peer)
                if peer_id:
                    run_on_queue(lambda: self._handle_alias_command(peer_id, arg))
                return HookResult(strategy=HookStrategy.CANCEL)

            # Применяем пользовательские алиасы: .r → .a random
            text = self._apply_aliases(text)

            if text.startswith(".a "):
                query = text[len(".a "):].strip()
            elif text.startswith(".anixart "):
                query = text[len(".anixart "):].strip()
            else:
                return HookResult()

            if not query:
                return HookResult(strategy=HookStrategy.CANCEL)

            peer = getattr(params, "peer", None)
            if peer is None:
                peer = getattr(params, "dialog_id", None)
            peer_id = self._extract_peer_id(peer)
            if not peer_id:
                return HookResult(strategy=HookStrategy.CANCEL)

            run_on_queue(lambda: self._handle_command(query, peer_id))
            return HookResult(strategy=HookStrategy.CANCEL)
        except Exception:
            return HookResult()

    def _extract_peer_id(self, peer) -> int:
        if peer is None:
            return 0
        if isinstance(peer, int):
            return peer
        try:
            uid = getattr(peer, "user_id", 0)
            if uid:
                return uid
            cid = getattr(peer, "chat_id", 0)
            if cid:
                return -cid
            chid = getattr(peer, "channel_id", 0)
            if chid:
                return -(1000000000000 + chid)
            return 0
        except Exception:
            return 0

    def _headers(self) -> dict:
        return {
            "User-Agent": USER_AGENT,
            "Accept": "application/json",
        }

    def _build_url(self, path: str, query: dict = None) -> str:
        url = f"{self._base_url}{path}"
        params = {}
        if self._token:
            params["token"] = self._token
        if query:
            params.update(query)
        if params:
            url += "?" + urlencode(params)
        return url

    def _api_get(self, path: str, query: dict = None) -> dict:
        url = self._build_url(path, query)
        resp = requests.get(url, headers=self._headers(), timeout=15)
        resp.raise_for_status()
        return resp.json()

    def _api_post(self, path: str, json_body: dict = None, api_v2: bool = False, query: dict = None) -> dict:
        url = self._build_url(path, query)
        headers = self._headers()
        headers["Content-Type"] = "application/json"
        if api_v2:
            headers["Api-Version"] = "v2"
        resp = requests.post(url, headers=headers, json=json_body, timeout=15)
        resp.raise_for_status()
        return resp.json()

    def _get_image_url(self, url: str) -> str:
        if not url:
            return ""
        if url.startswith("http://") or url.startswith("https://"):
            return url
        if url.startswith("//"):
            return "https:" + url

        domain = self._get_static_domain().rstrip("/")
        parsed = urlparse(domain)
        host = parsed.netloc
        scheme = parsed.scheme or "https"
        if not host.startswith("s."):
            host = "s." + host
        base = f"{scheme}://{host}"

        if url.startswith("/"):
            return base + url

        if "." not in url:
            url += ".jpg"
        return f"{base}/posters/{url}"

    def _format_release(self, rel: dict, release_id: int = 0) -> str:
        title_ru = rel.get("title_ru") or "N/A"
        title_orig = rel.get("title_original") or ""
        title_alt = rel.get("title_alt") or ""
        year = rel.get("year") or "?"
        status_obj = rel.get("status")
        status = status_obj.get("name") if isinstance(status_obj, dict) else str(status_obj)
        rating = rel.get("rating", 0)
        grade = rel.get("grade", 0)
        ep_rel = rel.get("episodes_released", 0)
        ep_tot = rel.get("episodes_total", 0)
        genres = rel.get("genres") or "N/A"
        full_desc = rel.get("description") or ""
        desc = full_desc[:400]
        has_more = len(full_desc) > 400

        lines = [f"<b>{title_ru}</b>"]
        if title_orig and title_orig != title_ru:
            lines.append(f"<i>{title_orig}</i>")
        if title_alt and title_alt not in (title_ru, title_orig):
            lines.append(f"<i>{title_alt}</i>")
        lines.append("")
        lines.append(f"📅 <b>Год:</b> {year}")
        lines.append(f"📊 <b>Рейтинг:</b> {rating} ({grade})")
        lines.append(f"📺 <b>Эпизоды:</b> {ep_rel}/{ep_tot if ep_tot else '?'}")
        lines.append(f"🏷 <b>Жанры:</b> {genres}")
        lines.append(f"📌 <b>Статус:</b> {status}")
        lines.append("")
        if desc:
            text = f"{desc}{'...' if has_more else ''}"
            lines.append(f'<blockquote expandable>{text}</blockquote>')
        if release_id:
            lines.append("")
            lines.append(f'📱 <a href="https://anixart-app.com/release/{release_id}">Смотреть в приложении</a>')
        return "\n".join(lines)

    def _send_formatted(self, peer_id: int, text: str, parse_mode: str = "HTML"):
        if not peer_id:
            return
        try:
            parsed = parse_text(text, parse_mode=parse_mode)
            send_message({
                "peer": peer_id,
                "message": parsed["message"],
                "entities": parsed.get("entities"),
            })
        except Exception:
            try:
                send_text(peer_id, text)
            except Exception:
                pass

    def _show_genres_dialog(self, peer_id: int):
        def show():
            current_fragment = get_last_fragment()
            if not current_fragment:
                return
            activity = current_fragment.getParentActivity()
            if not activity:
                return

            genres = [
                "Экшен", "Комедия", "Драма", "Фэнтези", "Фантастика",
                "Романтика", "Приключения", "Ужасы", "Триллер", "Тайна",
                "Спорт", "Сёнен", "Сёдзё", "Повседневность", "Исэкай",
                "Меха", "Музыка", "Школа", "Сверхъестественное", "Этти",
                "Боевые искусства", "Вампиры", "Военное", "Гарем", "Детектив",
                "Исторический", "Гурман", "Махо-сёдзё", "Мифология", "Психологическое",
                "Работа", "Самураи", "Сёдзё-ай", "Сёнен-ай", "Сэйнэн", "Дзёсей"
            ]

            def on_genre_click(bld, index):
                genre = genres[index]
                bld.dismiss()
                self._load_genre_page(peer_id, genre, 0)

            builder = AlertDialogBuilder(activity)
            builder.set_title("Выберите жанр")
            builder.set_items(genres, on_genre_click)
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()

        run_on_ui_thread(show)

    def _load_genre_page(self, peer_id: int, genre: str, page: int):
        def load():
            try:
                cached = self._genre_cache.get(genre, {}).get(page)
                if cached is not None:
                    run_on_ui_thread(lambda: self._show_genre_page(peer_id, genre, page, cached))
                    return

                data = self._api_post(
                    f"/filter/{page}",
                    json_body={"genres": [genre.lower()], "sort": 0},
                    query={"extended_mode": "true"}
                )
                items = data.get("content", [])

                if genre not in self._genre_cache:
                    self._genre_cache[genre] = {}
                self._genre_cache[genre][page] = items

                if not items and page == 0:
                    run_on_ui_thread(lambda: self._show_dialog(
                        "Жанр", f"По жанру «{genre}» ничего не найдено."
                    ))
                    return

                run_on_ui_thread(lambda: self._show_genre_page(peer_id, genre, page, items))

            except Exception as e:
                run_on_ui_thread(lambda: self._show_dialog(
                    "Ошибка", f"Не удалось загрузить жанр: {e}"
                ))

        run_on_queue(load)

    def _show_genre_page(self, peer_id: int, genre: str, page: int, items: list):
        has_next = len(items) == 25
        has_prev = page > 0
        is_empty = len(items) == 0

        display_names = []
        item_ids = []
        nav_indices = {}

        for item in items:
            title = item.get("title_ru") or item.get("title_original") or "Без названия"
            year = item.get("year") or "?"
            st = item.get("status", {})
            status = st.get("name") if isinstance(st, dict) else str(st)
            display_names.append(f"{title} ({year}, {status})")
            item_ids.append(item.get("id", 0))

        if has_next:
            display_names.append(f"➡️ Вперёд (стр. {page + 2})")
            nav_indices[len(display_names) - 1] = "next"

        if has_prev:
            display_names.append(f"⬅️ Назад (стр. {page})")
            nav_indices[len(display_names) - 1] = "prev"

        if has_prev and not has_next:
            display_names.append("⏮ Вернуться в начало")
            nav_indices[len(display_names) - 1] = "first"

        def on_item_click(bld, index):
            if index in nav_indices:
                action = nav_indices[index]
                bld.dismiss()
                if action == "next":
                    self._load_genre_page(peer_id, genre, page + 1)
                elif action == "prev":
                    self._load_genre_page(peer_id, genre, page - 1)
                elif action == "first":
                    self._load_genre_page(peer_id, genre, 0)
                return
            if index < len(item_ids):
                rid = item_ids[index]
                bld.dismiss()
                self._cmd_info(peer_id, rid)

        def show_dialog():
            try:
                current_fragment = get_last_fragment()
                if not current_fragment:
                    return
                activity = current_fragment.getParentActivity()
                if not activity:
                    return

                builder = AlertDialogBuilder(activity)

                if is_empty:
                    builder.set_title(f"🎭 {genre}")
                    builder.set_message("Больше нет результатов.")
                    if has_prev:
                        builder.set_positive_button(
                            "⬅️ Назад",
                            lambda b, w: (b.dismiss(), self._load_genre_page(peer_id, genre, page - 1))
                        )
                        builder.set_neutral_button(
                            "⏮ В начало",
                            lambda b, w: (b.dismiss(), self._load_genre_page(peer_id, genre, 0))
                        )
                    builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
                else:
                    builder.set_title(f"🎭 {genre} (стр. {page + 1})")
                    builder.set_items(display_names, on_item_click)
                    builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())

                builder.show()
            except Exception:
                pass

        run_on_ui_thread(show_dialog)

    def _maybe_start_tracker(self):
        if self._tracker_scheduled:
            return
        if not self.get_setting("track_enabled", False):
            return
        self._tracker_scheduled = True
        run_on_queue(self._tracker_loop)

    def _tracker_loop(self):
        if not self._tracker_scheduled:
            return
        if not self.get_setting("track_enabled", False):
            self._tracker_scheduled = False
            return
        try:
            self._check_new_episodes()
        except Exception:
            pass
        finally:
            if self._tracker_scheduled:
                period_index = self.get_setting("track_period", 2)
                try:
                    delay = TRACK_PERIODS[int(period_index)]
                except (IndexError, ValueError, TypeError):
                    delay = TRACK_PERIODS[2]
                run_on_queue(self._tracker_loop, None, delay)

    def _get_tracked_lists(self) -> List[str]:
        lists = []
        if self.get_setting("track_fav", True):
            lists.append("fav")
        if self.get_setting("track_watch", True):
            lists.append("watch")
        if self.get_setting("track_plan", False):
            lists.append("plan")
        if self.get_setting("track_completed", False):
            lists.append("completed")
        if self.get_setting("track_hold", False):
            lists.append("hold")
        if self.get_setting("track_dropped", False):
            lists.append("dropped")
        return lists

    def _fetch_list_page(self, list_type: str, page: int) -> List[dict]:
        try:
            if list_type == "fav":
                data = self._api_get(f"/favorite/all/{page}", {"sort": 1, "filter_announce": 0})
            else:
                lid = LIST_MAP.get(list_type, 1)
                data = self._api_get(f"/profile/list/all/{lid}/{page}", {"sort": 1, "filter_announce": 0})
            return data.get("content", [])
        except Exception:
            return []

    def _collect_tracked_state(self) -> dict:
        state = {}
        tracked = self._get_tracked_lists()
        if not tracked:
            return state

        for lst in tracked:
            page = 0
            max_pages = 20
            while page < max_pages:
                items = self._fetch_list_page(lst, page)
                if not items:
                    break
                for item in items:
                    rid = str(item.get("id", 0))
                    ep = item.get("episodes_released") or 0
                    if rid != "0":
                        state[rid] = {
                            "ep": int(ep),
                            "title": item.get("title_ru") or item.get("title_original") or "Без названия",
                            "total": item.get("episodes_total") or 0,
                        }
                if len(items) < 25:
                    break
                page += 1
        return state

    def _check_new_episodes(self):
        if not self._ensure_token():
            return
        try:
            current_state = self._collect_tracked_state()
            raw_prev = self.get_setting("track_state", "")
            prev_state = {}
            if raw_prev:
                try:
                    prev_state = json.loads(raw_prev)
                except Exception:
                    pass

            if not prev_state:
                self.set_setting("track_state", json.dumps(current_state), reload_settings=False)
                self.set_setting("track_last_check", int(time.time()), reload_settings=False)
                return

            updates = []
            for rid, data in current_state.items():
                prev = prev_state.get(rid, {})
                prev_ep = prev.get("ep", 0) if isinstance(prev, dict) else 0
                curr_ep = data.get("ep", 0)
                if curr_ep > prev_ep:
                    updates.append({
                        "title": data.get("title", "Без названия"),
                        "prev": prev_ep,
                        "curr": curr_ep,
                        "total": data.get("total", 0),
                    })

            self.set_setting("track_state", json.dumps(current_state), reload_settings=False)
            self.set_setting("track_last_check", int(time.time()), reload_settings=False)

            if updates:
                self._send_tracker_notifications(updates)
        except Exception:
            pass

    def _send_tracker_notifications(self, updates: List[dict]):
        lines = ["<b>🎬 Новые серии на Anixart:</b>\n"]
        for u in updates[:20]:
            title = u["title"]
            prev = u["prev"]
            curr = u["curr"]
            total = u["total"]
            total_str = f" из {total}" if total else ""
            if prev == 0:
                lines.append(f"📺 <b>{title}</b>\n   Вышло <b>{curr}</b>{total_str} серий")
            else:
                lines.append(f"📺 <b>{title}</b>\n   Новая серия <b>{curr}</b>{total_str} (было {prev})")

        if len(updates) > 20:
            lines.append(f"\n<i>…и ещё {len(updates) - 20} обновлений</i>")

        chat_id_str = self.get_setting("track_chat_id", "").strip()
        if chat_id_str:
            try:
                chat_id = int(chat_id_str)
            except ValueError:
                chat_id = self._get_saved_messages_peer()
        else:
            chat_id = self._get_saved_messages_peer()

        if not chat_id:
            return

        text = "\n".join(lines)
        run_on_ui_thread(lambda: self._send_formatted(chat_id, text, "HTML"))

    def _get_saved_messages_peer(self) -> int:
        try:
            uc = get_user_config()
            if uc:
                user = uc.getCurrentUser()
                if user:
                    return user.id
        except Exception:
            pass
        return 0

    def _handle_alias_command(self, peer_id: int, arg: str):
        if not arg:
            aliases = self._get_aliases()
            if not aliases:
                text = (
                    "<b>📝 Алиасы</b>\n\n"
                    "Алиасы не настроены.\n\n"
                    "<code>.alias &lt;имя&gt; &lt;команда&gt;</code> — добавить\n"
                    "Пример: <code>.alias r random</code>\n\n"
                    "<code>.alias remove &lt;имя&gt;</code> — удалить\n"
                    "<code>.alias reset</code> — сбросить все"
                )
            else:
                lines = ["<b>📝 Ваши алиасы:</b>"]
                for a, t in aliases.items():
                    lines.append(f"<code>.{a}</code> → <code>.a {t}</code>")
                lines.append("\n<code>.alias &lt;имя&gt; &lt;команда&gt;</code> — добавить")
                lines.append("<code>.alias remove &lt;имя&gt;</code> — удалить")
                lines.append("<code>.alias reset</code> — сбросить все")
                text = "\n".join(lines)
            run_on_ui_thread(lambda: self._send_formatted(peer_id, text, "HTML"))
            return

        parts = arg.split(" ", 1)
        sub = parts[0].lower()

        if sub == "remove" and len(parts) > 1:
            alias = parts[1].strip()
            self._remove_alias(alias)
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"✅ Алиас <code>.{alias}</code> удалён.", "HTML"))
            return
        elif sub == "reset":
            self.set_setting("aliases", "{}", reload_settings=False)
            run_on_ui_thread(lambda: self._send_formatted(peer_id, "✅ Все алиасы сброшены.", "HTML"))
            return

        alias_parts = arg.split(" ", 1)
        if len(alias_parts) < 2:
            run_on_ui_thread(lambda: self._send_formatted(
                peer_id,
                "❌ Использование: <code>.alias &lt;имя&gt; &lt;команда&gt;</code>\n"
                "Пример: <code>.alias r random</code>",
                "HTML"
            ))
            return

        alias = alias_parts[0].strip()
        target = alias_parts[1].strip()

        if not alias or not target:
            run_on_ui_thread(lambda: self._send_formatted(
                peer_id,
                "❌ Имя и команда не могут быть пустыми.",
                "HTML"
            ))
            return

        self._set_alias(alias, target)
        run_on_ui_thread(lambda: self._send_formatted(
            peer_id,
            f"✅ Алиас добавлен: <code>.{alias}</code> → <code>.a {target}</code>",
            "HTML"
        ))

    def _handle_command(self, query: str, peer_id: int):
        try:
            parts = query.split(" ", 1)
            cmd = parts[0].lower()
            arg = parts[1] if len(parts) > 1 else ""

            if cmd == "random":
                self._cmd_random(peer_id)
            elif cmd == "info" and arg.isdigit():
                self._cmd_info(peer_id, int(arg))
            elif cmd == "search" and arg:
                self._cmd_search(peer_id, arg)
            elif cmd == "genres":
                self._show_genres_dialog(peer_id)
            elif cmd == "profile":
                self._cmd_profile(peer_id)
            elif cmd == "track":
                if arg.lower() == "now":
                    run_on_queue(self._check_new_episodes)
                else:
                    self._cmd_tracker_status(peer_id)
            elif cmd in ("watching", "planned", "completed", "hold", "dropped", "favorites"):
                page = int(arg) if arg.isdigit() else 0
                self._cmd_list(peer_id, cmd, page)
            else:
                self._cmd_help(peer_id)
        except Exception as e:
            if peer_id:
                run_on_ui_thread(lambda: self._send_formatted(
                    peer_id,
                    f"<b>❌ Ошибка:</b> <code>{str(e)}</code>",
                    "HTML"
                ))

    def _cmd_tracker_status(self, peer_id: int):
        enabled = self.get_setting("track_enabled", False)
        period_index = self.get_setting("track_period", 2)
        try:
            period_label = TRACK_LABELS[int(period_index)]
        except (IndexError, ValueError, TypeError):
            period_label = "?"
        last_check = self.get_setting("track_last_check", 0)
        last_str = time.strftime("%d.%m.%Y %H:%M", time.localtime(last_check)) if last_check else "никогда"

        tracked = self._get_tracked_lists()
        names = {
            "fav": "Избранное",
            "watch": "Смотрю",
            "plan": "В планах",
            "completed": "Просмотрено",
            "hold": "Отложено",
            "dropped": "Брошено",
        }
        lists_str = ", ".join(names.get(l, l) for l in tracked) if tracked else "нет"

        raw_state = self.get_setting("track_state", "")
        try:
            state_count = len(json.loads(raw_state)) if raw_state else 0
        except Exception:
            state_count = 0

        status = "✅ Включено" if enabled else "❌ Выключено"
        text = (
            f"<b>🔔 Трекер Anixart</b>\n\n"
            f"Статус: {status}\n"
            f"Период: {period_label}\n"
            f"Списки: {lists_str}\n"
            f"Отслеживается аниме: {state_count}\n"
            f"Последняя проверка: {last_str}\n\n"
            f"<code>.a track now</code> — проверить вручную"
        )
        run_on_ui_thread(lambda: self._send_formatted(peer_id, text, "HTML"))

    def _cmd_random(self, peer_id: int):
        try:
            data = self._api_get("/release/random", {"extended_mode": "true"})
            release = data.get("release")
            if not release:
                run_on_ui_thread(lambda: self._send_formatted(peer_id, "❌ Не удалось получить случайный релиз.", "HTML"))
                return
            self._send_release(peer_id, release)
        except Exception as e:
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Ошибка random: {e}", "HTML"))

    def _cmd_info(self, peer_id: int, rid: int):
        try:
            data = self._api_get(f"/release/{rid}", {"extended_mode": "true"})
            release = data.get("release")
            if not release:
                run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Релиз <code>{rid}</code> не найден.", "HTML"))
                return
            self._send_release(peer_id, release)
        except Exception as e:
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Ошибка info: {e}", "HTML"))

    def _cmd_search(self, peer_id: int, query: str):
        try:
            data = self._api_post(
                "/search/releases/0",
                json_body={"query": query, "searchBy": 0},
                api_v2=True
            )
            content = data.get("releases") or data.get("content", [])
            if not content:
                run_on_ui_thread(lambda: self._show_dialog(
                    "Поиск", f"🔍 По запросу «{query}» ничего не найдено."
                ))
                return

            display_names = []
            item_ids = []

            for item in content:
                title = item.get("title_ru") or item.get("title_original") or "Без названия"
                year = item.get("year") or "?"
                st = item.get("status", {})
                status = st.get("name") if isinstance(st, dict) else str(st)
                display_names.append(f"{title} ({year}, {status})")
                item_ids.append(item.get("id", 0))

            def on_item_click(bld, index):
                rid = item_ids[index]
                bld.dismiss()
                self._cmd_info(peer_id, rid)

            def show_dialog():
                try:
                    current_fragment = get_last_fragment()
                    if not current_fragment:
                        return
                    activity = current_fragment.getParentActivity()
                    if not activity:
                        return

                    builder = AlertDialogBuilder(activity)
                    builder.set_title(f"🔍 {query} ({len(content)})")
                    builder.set_items(display_names, on_item_click)
                    builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
                    builder.show()
                except Exception:
                    pass

            run_on_ui_thread(show_dialog)

        except Exception as e:
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Ошибка поиска: {e}", "HTML"))

    def _cmd_list(self, peer_id: int, list_type: str, page: int):
        if not self._ensure_token():
            run_on_ui_thread(lambda: self._send_formatted(peer_id, "🔒 Для просмотра списков нужно авторизоваться. Введите логин и пароль в настройках плагина и нажмите 🔑 Авторизоваться.", "HTML"))
            return
        self._load_list_page(peer_id, list_type, page)

    def _load_list_page(self, peer_id: int, list_type: str, page: int):
        def load():
            try:
                if list_type == "favorites":
                    data = self._api_get(f"/favorite/all/{page}", {"sort": 1, "filter_announce": 0})
                else:
                    lid = LIST_MAP.get(list_type, 1)
                    data = self._api_get(f"/profile/list/all/{lid}/{page}", {"sort": 1, "filter_announce": 0})
                items = data.get("content", [])
                if not items and page == 0:
                    name = LIST_NAMES.get(list_type, list_type)
                    run_on_ui_thread(lambda: self._show_dialog(name, "Список пуст."))
                    return
                run_on_ui_thread(lambda: self._show_list_page(peer_id, list_type, page, items))
            except Exception as e:
                run_on_ui_thread(lambda: self._show_dialog("Ошибка", f"Не удалось загрузить список: {e}"))
        run_on_queue(load)

    def _show_list_page(self, peer_id: int, list_type: str, page: int, items: list):
        has_next = len(items) == 25
        has_prev = page > 0
        is_empty = len(items) == 0

        display_names = []
        item_ids = []
        nav_indices = {}

        for item in items:
            title = item.get("title_ru") or item.get("title_original") or "Без названия"
            year = item.get("year") or "?"
            st = item.get("status", {})
            status = st.get("name") if isinstance(st, dict) else str(st)
            ep_rel = item.get("episodes_released", 0)
            ep_tot = item.get("episodes_total", 0)
            ep_str = f"{ep_rel}/{ep_tot if ep_tot else '?'}"
            display_names.append(f"{title} ({year}, {ep_str} эп., {status})")
            item_ids.append(item.get("id", 0))

        if has_next:
            display_names.append(f"➡️ Вперёд (стр. {page + 2})")
            nav_indices[len(display_names) - 1] = "next"

        if has_prev:
            display_names.append(f"⬅️ Назад (стр. {page})")
            nav_indices[len(display_names) - 1] = "prev"

        if has_prev and not has_next:
            display_names.append("⏮ Вернуться в начало")
            nav_indices[len(display_names) - 1] = "first"

        def on_item_click(bld, index):
            if index in nav_indices:
                action = nav_indices[index]
                bld.dismiss()
                if action == "next":
                    self._load_list_page(peer_id, list_type, page + 1)
                elif action == "prev":
                    self._load_list_page(peer_id, list_type, page - 1)
                elif action == "first":
                    self._load_list_page(peer_id, list_type, 0)
                return
            if index < len(item_ids):
                rid = item_ids[index]
                bld.dismiss()
                self._cmd_info(peer_id, rid)

        def show_dialog():
            try:
                current_fragment = get_last_fragment()
                if not current_fragment:
                    return
                activity = current_fragment.getParentActivity()
                if not activity:
                    return

                builder = AlertDialogBuilder(activity)
                title = LIST_NAMES.get(list_type, list_type)

                if is_empty:
                    builder.set_title(f"📂 {title}")
                    builder.set_message("Больше нет результатов.")
                    if has_prev:
                        def go_back(b, w):
                            b.dismiss()
                            self._load_list_page(peer_id, list_type, page - 1)
                        def go_first(b, w):
                            b.dismiss()
                            self._load_list_page(peer_id, list_type, 0)
                        builder.set_positive_button("⬅️ Назад", go_back)
                        builder.set_neutral_button("⏮ В начало", go_first)
                    builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
                else:
                    builder.set_title(f"📂 {title} (стр. {page + 1})")
                    builder.set_items(display_names, on_item_click)
                    builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())

                builder.show()
            except Exception:
                pass

        run_on_ui_thread(show_dialog)

    def _cmd_profile(self, peer_id: int):
        if not self._ensure_token():
            run_on_ui_thread(lambda: self._send_formatted(peer_id, "🔒 Для просмотра профиля нужно авторизоваться. Введите логин и пароль в настройках плагина и нажмите 🔑 Авторизоваться.", "HTML"))
            return
        try:
            profile_id = self._profile_id or self.get_setting("profile_id", None)
            if not profile_id:
                run_on_ui_thread(lambda: self._send_formatted(peer_id, "⚠️ Не удалось определить ID профиля. Нажмите 🔑 Авторизоваться в настройках.", "HTML"))
                return

            data = self._api_get(f"/profile/{profile_id}")
            p = data.get("profile") or {}

            login = p.get("login") or self._login or "Unknown"
            status = p.get("status", "")
            is_online = p.get("is_online", False)
            online_str = "🟢 Онлайн" if is_online else ""

            badge_obj = p.get("badge")
            badge_name = ""
            if isinstance(badge_obj, dict):
                badge_name = badge_obj.get("name", "")
            roles = p.get("roles", [])
            role_names = [r.get("name", "") for r in roles if isinstance(r, dict)]
            role_str = ", ".join(role_names) if role_names else ""

            privilege = p.get("privilege_level", 0)
            verified = "✅ Verified" if p.get("is_verified") else ""
            sponsor = "✨ Sponsor" if p.get("is_sponsor") else ""
            perm_ban = "⛔ Перманентный бан" if p.get("is_perm_banned") else ""
            ban = "🚫 Бан" if p.get("is_banned") and not p.get("is_perm_banned") else ""

            is_counts_hidden = p.get("is_counts_hidden", False)
            is_stats_hidden = p.get("is_stats_hidden", False)
            stats_hidden = is_counts_hidden or is_stats_hidden

            watching = p.get("watching_count")
            plan = p.get("plan_count")
            completed = p.get("completed_count")
            hold = p.get("hold_on_count")
            dropped = p.get("dropped_count")
            fav = p.get("favorite_count")
            rating = p.get("rating_score")
            friends = p.get("friend_count")
            collections = p.get("collection_count")
            videos = p.get("video_count")
            comments = p.get("comment_count")
            watched_eps = p.get("watched_episode_count")
            watched_time = p.get("watched_time")

            reg_ts = p.get("register_date", 0)
            last_ts = p.get("last_activity_time", 0)
            reg_str = time.strftime("%d.%m.%Y", time.localtime(reg_ts)) if reg_ts else ""
            last_str = time.strftime("%d.%m.%Y %H:%M", time.localtime(last_ts)) if last_ts else ""

            socials = []
            for key, icon in [("vk_page", "VK"), ("tg_page", "TG"), ("inst_page", "IG"), ("tt_page", "TT"), ("discord_page", "DC")]:
                val = p.get(key, "")
                if val and str(val).strip():
                    socials.append(f"{icon}: {val}")

            lines = [f"👤 <b>{login}</b>"]
            if status:
                lines.append(f"<i>{status}</i>")
            if online_str:
                lines.append(online_str)
            if badge_name:
                lines.append(f"🏷 {badge_name}")
            if role_str:
                lines.append(f"🎭 {role_str}")

            tags = [t for t in [verified, sponsor, ban, perm_ban] if t]
            if tags:
                lines.append(" ".join(tags))

            lines.append("")

            if stats_hidden:
                lines.append("🔒 Статистика скрыта")
            else:
                if watching is not None:
                    lines.append(f"📺 Смотрю: {watching}")
                if plan is not None:
                    lines.append(f"📅 В планах: {plan}")
                if completed is not None:
                    lines.append(f"✅ Просмотрено: {completed}")
                if hold is not None:
                    lines.append(f"⏸ Отложено: {hold}")
                if dropped is not None:
                    lines.append(f"❌ Брошено: {dropped}")
                if fav is not None:
                    lines.append(f"❤️ Избранное: {fav}")
                if rating is not None:
                    lines.append(f"⭐ Рейтинг: {rating}")
                if friends is not None:
                    lines.append(f"👥 Друзья: {friends}")
                if collections is not None:
                    lines.append(f"📁 Коллекции: {collections}")
                if videos is not None:
                    lines.append(f"🎬 Видео: {videos}")
                if comments is not None:
                    lines.append(f"💬 Комментарии: {comments}")
                if watched_eps is not None:
                    lines.append(f"▶️ Серий просмотрено: {watched_eps}")
                if watched_time is not None:
                    hours = watched_time // 3600
                    lines.append(f"⏱ Время просмотра: {hours} ч")

            lines.append("")
            if reg_str:
                lines.append(f"📆 Регистрация: {reg_str}")
            if last_str:
                lines.append(f"🕐 Активность: {last_str}")
            if socials:
                lines.append("")
                lines.append("🔗 " + " | ".join(socials))

            text = "\n".join(lines)
            run_on_ui_thread(lambda: self._send_formatted(peer_id, text, "HTML"))
        except Exception as e:
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Ошибка профиля: {e}", "HTML"))

    def _cmd_help(self, peer_id: int):
        text = (
            f"<b>🎬 Anixart Plugin v{__version__}</b>\n\n"
            f"<code>.a random</code> — Случайный релиз\n"
            f"<code>.a info &lt;id&gt;</code> — Инфо по ID\n"
            f"<code>.a search &lt;запрос&gt;</code> — Поиск\n"
            f"<code>.a genres</code> — Жанры (всплывающее окно)\n"
            f"<code>.a watching [стр]</code> — Смотрю\n"
            f"<code>.a planned [стр]</code> — В планах\n"
            f"<code>.a completed [стр]</code> — Просмотрено\n"
            f"<code>.a hold [стр]</code> — Отложено\n"
            f"<code>.a dropped [стр]</code> — Брошено\n"
            f"<code>.a favorites [стр]</code> — Избранное\n"
            f"<code>.a profile</code> — Профиль\n"
            f"<code>.a track</code> — Статус трекера\n"
            f"<code>.a track now</code> — Проверить новые серии\n"
            f"<code>.alias</code> — Управление алиасами\n"
            f"<code>.alias r random</code> — создать алиас .r\n\n"
            f"<i>Для списков, профиля и трекера нужна авторизация в настройках.</i>"
        )
        run_on_ui_thread(lambda: self._send_formatted(peer_id, text, "HTML"))

    def _send_release(self, peer_id: int, release: dict):
        rid = release.get("id", 0)
        try:
            caption = self._format_release(release, release_id=rid)
            poster_raw = release.get("poster") or release.get("image")
            poster_url = self._get_image_url(poster_raw) if poster_raw else None

            if not poster_url:
                run_on_ui_thread(lambda: self._send_formatted(peer_id, caption, "HTML"))
                return

            def do_download():
                tmp = None
                try:
                    tmp = self._download_temp(poster_url)
                    run_on_ui_thread(lambda: self._do_send_photo(peer_id, tmp, caption))
                except Exception:
                    run_on_ui_thread(lambda: self._send_formatted(peer_id, caption, "HTML"))
                    if tmp:
                        delete_file(tmp)

            run_on_queue(do_download)
        except Exception as e:
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Ошибка отправки релиза: {e}", "HTML"))

    def _do_send_photo(self, peer_id: int, tmp: str, caption: str):
        try:
            send_photo(peer_id, tmp, caption=caption, parse_mode="HTML")
        except Exception:
            self._send_formatted(peer_id, caption, "HTML")
        finally:
            delete_file(tmp)

    def _download_temp(self, url: str) -> str:
        try:
            cache = get_cache_dir()
            fname = f"anixart_{hashlib.md5(url.encode()).hexdigest()}.jpg"
            path = os.path.join(cache, fname)
            r = requests.get(url, headers={"User-Agent": USER_AGENT}, timeout=15)
            r.raise_for_status()
            with open(path, "wb") as f:
                f.write(r.content)
            return path
        except Exception as e:
            raise
