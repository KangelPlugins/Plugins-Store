    def _reset_aliases_ui(self, view=None):
        self.set_setting("aliases", "{}", reload_settings=False)
        self._show_dialog("Алиасы", "Все алиасы сброшены.")

    def _get_aliases(self) -> dict:
        raw = self.get_setting("aliases", "{}")
        try:
            return json.loads(raw)
        except Exception:
            return {}

    def _set_alias(self, alias: str, target: str):
        aliases = self._get_aliases()
        aliases[alias.lower().strip()] = target.strip()
        self.set_setting("aliases", json.dumps(aliases), reload_settings=False)

    def _remove_alias(self, alias: str):
        aliases = self._get_aliases()
        key = alias.lower().strip()
        if key in aliases:
            del aliases[key]
            self.set_setting("aliases", json.dumps(aliases), reload_settings=False)

    def _apply_aliases(self, text: str) -> str:
        aliases = self._get_aliases()
        if not aliases:
            return text
        lower_text = text.lower()
        for alias, target in sorted(aliases.items(), key=lambda x: -len(x[0])):
            alias_key = "." + alias.lower()
            if lower_text.startswith(alias_key):
                after = text[len(alias_key):]
                if after == "" or after.startswith(" "):
                    return f".a {target}{after}"
        return text

    def _on_track_switch(self, new_value: bool):
        if new_value:
            self._tracker_scheduled = False
            self._maybe_start_tracker()
        else:
            self._tracker_scheduled = False

