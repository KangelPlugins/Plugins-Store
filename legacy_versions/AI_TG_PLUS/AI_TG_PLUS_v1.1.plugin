_ORIG_GETADDRINFO = socket.getaddrinfo
_DNS_CACHE = {}
_PLUGIN_INSTANCE = None
_MALW_IPS = ["185.246.223.127", "62.133.62.97"]

def _query_dns_dot(host="dns.malw.link", port=853, domain="generativelanguage.googleapis.com"):
    try:
        header = struct.pack(">HHHHHH", 0x1234, 0x0100, 1, 0, 0, 0)
        qname = b"".join(bytes([len(p)]) + p.encode() for p in domain.split(".")) + b"\x00"
        query = header + qname + struct.pack(">HH", 1, 1)
        msg = len(query).to_bytes(2, "big") + query
        ctx = ssl.create_default_context()
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(3)
        s_ssl = ctx.wrap_socket(s, server_hostname=host)
        s_ssl.connect((host, port))
        s_ssl.sendall(msg)
        l_bytes = s_ssl.recv(2)
        if not l_bytes:
            return None
        length = int.from_bytes(l_bytes, "big")
        data = s_ssl.recv(length)
        s_ssl.close()
        if len(data) < 12:
            return None
        id, flags, qdcount, ancount, nscount, arcount = struct.unpack(">HHHHHH", data[:12])
        idx = 12
        for _ in range(qdcount):
            while idx < len(data) and data[idx] != 0:
                if (data[idx] & 0xC0) == 0xC0:
                    idx += 2
                    break
                idx += 1 + data[idx]
            if idx < len(data) and data[idx] == 0:
                idx += 1
            idx += 4
        for _ in range(ancount):
            if idx >= len(data):
                break
            if (data[idx] & 0xC0) == 0xC0:
                idx += 2
            else:
                while idx < len(data) and data[idx] != 0:
                    idx += 1 + data[idx]
                idx += 1
            rtype, rclass, ttl, rdlength = struct.unpack(">HHIH", data[idx:idx+10])
            idx += 10
            if rtype == 1 and rdlength == 4:
                return ".".join(str(b) for b in data[idx:idx+4])
            idx += rdlength
    except Exception:
        pass
    return None

def _resolve_malw_dns(domain="generativelanguage.googleapis.com"):
    now = time.time()
    cached = _DNS_CACHE.get(domain)
    if cached and cached["expires"] > now:
        return cached["ip"]
    ip = _query_dns_dot("dns.malw.link", 853, domain)
    if not ip:
        ip = _MALW_IPS[int(now) % len(_MALW_IPS)]
    if ip:
        _DNS_CACHE[domain] = {"ip": ip, "expires": now + 300}
        return ip
    return None

def _custom_getaddrinfo(host, port, family=0, type=0, proto=0, flags=0):
    if host and any(d in host.lower() for d in ["googleapis.com", "groq.com", "cloudflare.com", "openai.com"]):
        if _PLUGIN_INSTANCE and _PLUGIN_INSTANCE.get_setting("use_custom_dns", True):
            ip = _resolve_malw_dns(host)
            if ip:
                return _ORIG_GETADDRINFO(ip, port, family, type, proto, flags)
    return _ORIG_GETADDRINFO(host, port, family, type, proto, flags)

