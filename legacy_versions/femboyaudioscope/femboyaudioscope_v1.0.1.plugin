import os
import traceback

from java.lang import String as JavaString

from android.media import MediaMetadataRetriever
from org.telegram.messenger import AndroidUtilities, FileLoader, MediaController, R

from android_utils import copy_to_clipboard, run_on_ui_thread
from base_plugin import BasePlugin
from client_utils import run_on_queue
from hook_utils import find_class, get_private_field
from mutagen import File as MutagenFile
from ui.alert import AlertDialogBuilder


__id__ = "femboyaudioscope"
__name__ = "AudioScope"
__description__ = "Показывает формат, кодек, битрейт, частоту дискретизации, разрядность, каналы и теги текущего трека прямо из меню плеера.\n**Использование:** Три точки в плеере -> «Информация о треке»"
__author__ = "@Beefba"
__version__ = "1.0.1"
__icon__ = "Wypher4/28"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__requirements__ = ["mutagen>=1.47,<2"]

MENU_ID = 0x5BEEF

FORMAT_NAMES = {
    "MP3": "MP3 (MPEG Audio)",
    "MP4": "MP4 / M4A",
    "FLAC": "FLAC",
    "AAC": "AAC / ADTS",
    "AC3": "Dolby AC-3",
    "WAVE": "WAV",
    "AIFF": "AIFF",
    "ASF": "ASF / WMA",
    "OggVorbis": "Ogg Vorbis",
    "OggOpus": "Ogg Opus",
    "OggFLAC": "Ogg FLAC",
    "OggSpeex": "Ogg Speex",
    "MonkeysAudio": "Monkey's Audio (APE)",
    "Musepack": "Musepack",
    "WavPack": "WavPack",
    "TrueAudio": "True Audio (TTA)",
    "DSF": "DSD / DSF",
    "DFF": "DSD / DFF",
}

LOSSLESS = {
    "FLAC", "OggFLAC", "WAVE", "AIFF", "MonkeysAudio",
    "WavPack", "TrueAudio", "DSF", "DFF",
}

LOSSY = {
    "MP3", "AAC", "AC3", "ASF", "OggVorbis",
    "OggOpus", "OggSpeex", "Musepack",
}


def as_text(value):
    if value is None:
        return None
    value = str(value).strip()
    return value or None


def as_number(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def first_number(*values):
    for value in values:
        value = as_number(value)
        if value is not None and value > 0:
            return value
    return None


def call(obj, method):
    try:
        return getattr(obj, method)()
    except Exception:
        return None


class AudioScopePlugin(BasePlugin):
    def on_plugin_load(self):
        player = find_class("org.telegram.ui.Components.AudioPlayerAlert")
        if player is None:
            self.log("AudioScope: AudioPlayerAlert не найден")
            return

        #цепляем клик
        click_hooks = self.hook_all_methods(
            player,
            "onSubItemClick",
            before=self._menu_clicked,
        )
        if not click_hooks:
            self.log("AudioScope: не удалось подключиться к меню плеера")
            return

        constructor_hooks = self.hook_all_constructors(
            player,
            after=self._player_ready,
        )
        if not constructor_hooks:
            self.log("AudioScope: не удалось подключиться к плееру")
            return

        self.hook_all_methods(player, "updateTitle", after=self._title_updated)
        self.log("AudioScope: готов")

    def _player_ready(self, param):
        try:
            button = get_private_field(param.thisObject, "optionsButton")
            if button is None:
                return

            if not button.isSubItemVisible(MENU_ID):
                button.addSubItem(
                    MENU_ID,
                    R.drawable.msg_info,
                    "Информация о треке",
                )
                self._move_menu(button)
        except Exception:
            self.log("AudioScope: не добавилась кнопка\n" + traceback.format_exc())

    def _title_updated(self, param):
        try:
            if MediaController.getInstance().getPlayingMessageObject() is None:
                return

            button = get_private_field(param.thisObject, "optionsButton")
            if button is not None and button.isSubItemVisible(MENU_ID):
                self._move_menu(button)
        except Exception:
            pass

    @staticmethod
    def _move_menu(button):
       
        offset = get_private_field(button, "additionalYOffset")
        if offset is not None:
            button.setAdditionalYOffset(int(offset) - AndroidUtilities.dp(48))

    def _menu_clicked(self, param):
        try:
            item_id = int(param.args[0])
        except Exception:
            return

        if item_id != MENU_ID:
            return

        param.setResult(None)
        self._show_info(param.thisObject)

    def _show_info(self, player):
        activity = get_private_field(player, "parentActivity")
        message = MediaController.getInstance().getPlayingMessageObject()

        if activity is None:
            return
        if message is None:
            self._message(activity, "Сейчас ничего не воспроизводится.")
            return

        loading = AlertDialogBuilder(activity, AlertDialogBuilder.ALERT_TYPE_SPINNER)
        loading.set_title("Анализ трека")
        loading.set_message("Читаю данные файла…")
        loading.show()
        loading.set_cancelable(False)

        def read_file():
            try:
                report = self._make_report(message)
                error = None
            except Exception:
                report = None
                error = traceback.format_exc()

            run_on_ui_thread(
                lambda: self._show_result(activity, loading, report, error)
            )

     
        run_on_queue(read_file)

    def _show_result(self, activity, loading, report, error):
        try:
            loading.dismiss()

            if error:
                self.log("AudioScope: ошибка чтения файла\n" + error)
                self._message(activity, "Не удалось прочитать данные этого файла.")
                return

            dialog = AlertDialogBuilder(activity)
            dialog.set_title("Информация о треке")
            dialog.set_message(report)
            dialog.set_positive_button("Закрыть", lambda d, _w: d.dismiss())
            dialog.set_neutral_button(
                "Копировать",
                lambda _d, _w: copy_to_clipboard(report),
            )
            dialog.show()
        except Exception:
            self.log("AudioScope: не показалось окно\n" + traceback.format_exc())

    @staticmethod
    def _message(activity, text):
        dialog = AlertDialogBuilder(activity)
        dialog.set_title("Информация о треке")
        dialog.set_message(text)
        dialog.set_positive_button("Закрыть", lambda d, _w: d.dismiss())
        dialog.show()

    def _make_report(self, message):
        path = self._find_file(message)
        document = call(message, "getDocument")

        file_name = as_text(call(message, "getFileName"))
        if not file_name:
            file_name = as_text(call(message, "getDocumentName"))
        if not file_name and path:
            file_name = os.path.basename(path)
        file_name = file_name or "неизвестный файл"

        extension = os.path.splitext(file_name)[1].lower() or "—"
        mime = as_text(getattr(document, "mime_type", None))
        telegram_size = first_number(getattr(document, "size", None))
        duration_hint = first_number(call(message, "getDuration"))

        lines = []

        def add(name, value):
            if value not in (None, ""):
                lines.append(f"{name}: {value}")

        add("Файл", file_name)
        add("Формат", extension)

        if path is None:
            add("MIME", mime)
            if telegram_size:
                add("Размер", self._size(telegram_size))
            if duration_hint:
                add("Длительность", self._duration(duration_hint))
            add("Статус", "файл ещё не загружен полностью")
            add("Примечание", "битрейт и дискретизация появятся после загрузки")
            return "\n".join(lines)

        size = os.path.getsize(path)
        android_info = self._android_info(path)

        try:
            audio = MutagenFile(path, easy=False)
        except Exception:
            audio = None

        if audio is None:
            add("MIME", mime or android_info.get("mime"))
            add("Размер", self._size(size))

            duration = first_number(android_info.get("duration"), duration_hint)
            bitrate = first_number(android_info.get("bitrate"))
            sample_rate = first_number(android_info.get("sample_rate"))
            bits = first_number(android_info.get("bits"))

            if duration:
                add("Длительность", self._duration(duration))
            if bitrate:
                add("Битрейт", self._bitrate(bitrate))
            if sample_rate:
                add("Дискретизация", self._sample_rate(sample_rate))
            if bits:
                add("Разрядность", f"{int(bits)} бит")

            add("Статус", "формат частично распознан Android")
            return "\n".join(lines)

        info = getattr(audio, "info", None)
        format_key = audio.__class__.__name__
        codec = self._codec(format_key, info)

        add("Контейнер", FORMAT_NAMES.get(format_key, format_key))
        add("Кодек", codec)
        add("MIME", mime or android_info.get("mime"))
        add("Размер", self._size(size))

        duration = first_number(
            getattr(info, "length", None),
            android_info.get("duration"),
            duration_hint,
        )
        if duration:
            add("Длительность", self._duration(duration))

        bitrate = first_number(
            getattr(info, "bitrate", None),
            android_info.get("bitrate"),
        )
        estimated_bitrate = False
        if not bitrate and duration:
            bitrate = size * 8 / duration
            estimated_bitrate = True
        if bitrate:
            value = self._bitrate(bitrate)
            if estimated_bitrate:
                value += " (средний, по размеру файла)"
            add("Битрейт", value)

        bitrate_mode = getattr(info, "bitrate_mode", None)
        if bitrate_mode is not None:
            mode = getattr(bitrate_mode, "name", None) or str(bitrate_mode).rsplit(".", 1)[-1]
            add("Режим битрейта", mode)

        sample_rate = first_number(
            getattr(info, "sample_rate", None),
            android_info.get("sample_rate"),
        )
        if not sample_rate and format_key == "OggOpus":
            #опус все равно декодируется на 48 кгц
            sample_rate = 48000
        if sample_rate:
            add("Дискретизация", self._sample_rate(sample_rate))

        bits = first_number(
            getattr(info, "bits_per_sample", None),
            android_info.get("bits"),
        )
        if bits:
            add("Разрядность", f"{int(bits)} бит")

        channels = first_number(getattr(info, "channels", None))
        if channels:
            add("Каналы", self._channels(channels))

        add("Сжатие", self._compression(format_key, codec))

        tags = self._read_tags(path)
        if tags:
            lines.append("────────────")
            for name, value in tags:
                add(name, value)

        return "\n".join(lines)

    def _find_file(self, message):
        try:
            path = as_text(message.messageOwner.attachPath)
            if path and os.path.isfile(path):
                return path
        except Exception:
            pass

        try:
            file = FileLoader.getInstance(int(message.currentAccount)).getPathToMessage(
                message.messageOwner
            )
            path = as_text(file.getAbsolutePath())
            if path and os.path.isfile(path):
                return path
        except Exception:
            pass

        try:
            document = call(message, "getDocument")
            if document is not None:
                file = FileLoader.getInstance(int(message.currentAccount)).getPathToAttach(
                    document
                )
                path = as_text(file.getAbsolutePath())
                if path and os.path.isfile(path):
                    return path
        except Exception:
            pass

        return None

    @staticmethod
    def _android_info(path):
        result = {}
        retriever = None

        try:
            retriever = MediaMetadataRetriever()
            retriever.setDataSource(JavaString(path))

            duration = as_number(retriever.extractMetadata(9))
            result["duration"] = duration / 1000 if duration else None
            result["mime"] = as_text(retriever.extractMetadata(12))
            result["bitrate"] = as_number(retriever.extractMetadata(20))
            result["sample_rate"] = as_number(retriever.extractMetadata(38))
            result["bits"] = as_number(retriever.extractMetadata(39))
        except Exception:
            pass
        finally:
            if retriever is not None:
                try:
                    retriever.release()
                except Exception:
                    pass

        return result

    @staticmethod
    def _read_tags(path):
        try:
            audio = MutagenFile(path, easy=True)
            tags = getattr(audio, "tags", None) if audio is not None else None
            if not tags:
                return []

            fields = [
                ("Название", ("title",)),
                ("Исполнитель", ("artist", "albumartist")),
                ("Альбом", ("album",)),
                ("Год", ("date", "year")),
                ("Номер трека", ("tracknumber",)),
                ("Жанр", ("genre",)),
            ]

            result = []
            for label, keys in fields:
                value = None
                for key in keys:
                    values = tags.get(key)
                    if values:
                        value = ", ".join(str(item) for item in values)
                        break
                if value:
                    result.append((label, value))
            return result
        except Exception:
            return []

    @staticmethod
    def _codec(format_key, info):
        if info is None:
            return None

        codec = as_text(getattr(info, "codec_description", None))
        if codec:
            return codec

        codec = as_text(getattr(info, "codec", None))
        if codec:
            return codec

        if format_key == "MP3":
            version = getattr(info, "version", None)
            layer = getattr(info, "layer", None)
            if version and layer:
                return f"MPEG {version:g} Layer {int(layer)}"
            return "MPEG Layer III"

        return {
            "FLAC": "FLAC",
            "OggFLAC": "FLAC",
            "OggOpus": "Opus",
            "OggVorbis": "Vorbis",
            "OggSpeex": "Speex",
            "AAC": "AAC",
            "AC3": "AC-3",
            "WAVE": "PCM / WAV",
            "AIFF": "PCM / AIFF",
        }.get(format_key)

    @staticmethod
    def _compression(format_key, codec):
        if format_key == "MP4":
            codec = (codec or "").lower()
            if "alac" in codec or "apple lossless" in codec:
                return "без потерь (lossless)"
            if "aac" in codec or "mp4a" in codec:
                return "с потерями (lossy)"
            return None
        if format_key in LOSSLESS:
            return "без потерь (lossless)"
        if format_key in LOSSY:
            return "с потерями (lossy)"
        return None

    @staticmethod
    def _size(size):
        size = float(size)
        for unit in ("Б", "КиБ", "МиБ", "ГиБ"):
            if size < 1024 or unit == "ГиБ":
                return f"{int(size)} {unit}" if unit == "Б" else f"{size:.2f} {unit}"
            size /= 1024

    @staticmethod
    def _duration(seconds):
        seconds = max(0, int(round(float(seconds))))
        hours, seconds = divmod(seconds, 3600)
        minutes, seconds = divmod(seconds, 60)
        if hours:
            return f"{hours}:{minutes:02d}:{seconds:02d}"
        return f"{minutes}:{seconds:02d}"

    @staticmethod
    def _bitrate(bitrate):
        bitrate = float(bitrate) / 1000
        if abs(bitrate - round(bitrate)) < 0.05:
            return f"{round(bitrate)} кбит/с"
        return f"{bitrate:.1f} кбит/с"

    @staticmethod
    def _sample_rate(rate):
        rate = int(round(float(rate)))
        khz = rate / 1000
        value = str(int(khz)) if khz.is_integer() else f"{khz:.1f}"
        return f"{value} кГц ({rate} Гц)"

    @staticmethod
    def _channels(channels):
        channels = int(channels)
        if channels == 1:
            return "1 (моно)"
        if channels == 2:
            return "2 (стерео)"
        return str(channels)


