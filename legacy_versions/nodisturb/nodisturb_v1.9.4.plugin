BLOCK_FULL, BLOCK_NAME, BLOCK_AVATAR, BLOCK_NONE = "full", "name", "avatar", "none"
HIDDEN_NAME = "Unknown Name"
HIDDEN_STATUS = "Был(а) давно"
BANNED_KEY = "nodisturb_banned_v3"
ADD_INPUT_KEY = "add_target_input"
BLOCK_CHAT_KEY = "block_chat"

VIEW_VISIBLE, VIEW_GONE = 0, 8
LP_MATCH_PARENT, LP_WRAP_CONTENT = -1, -2

UPDATE_CHANNEL_ID = -1004488913096
UPDATE_MESSAGE_ID = 25

CHANNEL_LIKE_UID = 1000000000000


def _bt_label(bt):
    return {BLOCK_FULL: "Полное скрытие", BLOCK_NAME: "Скрыть имя",
            BLOCK_AVATAR: "Скрыть аватарку"}.get(bt, "Неизвестно")


def _is_channel_like(uid):
    return uid < 0 or uid >= CHANNEL_LIKE_UID


def _TL(name):
    for mod in (TLRPC, TLRPC_NEW):
        if mod is None:
            continue
        c = getattr(mod, name, None)
        if c is not None:
            return c
    key = name.replace("TL_", "").lower()
    for mod in (TLRPC, TLRPC_NEW):
        if mod is None:
            continue
        try:
            for dn in dir(mod):
                if key in dn.lower():
                    return getattr(mod, dn)
        except Exception:
            pass
    return None


def _offline_status():
    cls = _TL("TL_userStatusOffline")
    if cls is None:
        return None
    try:
        st = cls()
        st.expires = 0
        return st
    except Exception:
        return None


def _valid_uid(uid):
    try:
        uid = int(uid)
    except Exception:
        return 0
    return uid if 0 < uid < 2**63 else 0


def _is_outgoing(obj):
    if obj is None:
        return False
    try:
        if obj.isOut():
            return True
    except Exception:
        pass
    try:
        if bool(getattr(obj, "out", False)):
            return True
    except Exception:
        pass
    try:
        owner = getattr(obj, "messageOwner", None)
        if owner is not None and bool(getattr(owner, "out", False)):
            return True
    except Exception:
        pass
    return False


def _extract_uid_any(obj):
    if obj is None:
        return None
    try:
        owner = getattr(obj, "messageOwner", None) or obj
        from_id = getattr(owner, "from_id", None)
        if from_id is not None:
            for attr in ("user_id", "channel_id", "chat_id"):
                v = getattr(from_id, attr, None)
                if v and int(v) > 0:
                    return int(v)
    except Exception:
        pass
    try:
        get_from_id = getattr(obj, "getFromId", None)
        if get_from_id:
            fid = get_from_id()
            if fid and int(fid) > 0:
                return int(fid)
    except Exception:
        pass
    return None


def _bundle_get_positive_id(bundle):
    if bundle is None:
        return None
    for key in ("user_id", "userId", "dialog_id", "dialogId", "uid"):
        try:
            if hasattr(bundle, "containsKey") and not bundle.containsKey(key):
                continue
        except Exception:
            pass
        for getter in ("getLong", "getInt"):
            try:
                val = getattr(bundle, getter)(key)
                uid = int(val)
                if uid > 0:
                    return uid
            except Exception:
                pass
    return None


def _extract_usernames(user):
    try:
        u = (getattr(user, "username", "") or "").strip().lower()
        return [u] if u else []
    except Exception:
        return []


def _user_title(user, fallback="Пользователь"):
    try:
        full = ((getattr(user, "first_name", "") or "") + " " +
                (getattr(user, "last_name", "") or "")).strip()
        if full:
            return full
        un = (getattr(user, "username", "") or "").strip()
        if un:
            return "@" + un
    except Exception:
        pass
    return fallback


def _parse_target_id(raw: str) -> int:
    if not raw:
        return 0
    raw = raw.strip()
    m = re.search(r"(?i)tg://user\?id=(\d+)", raw)
    if m:
        return _valid_uid(m.group(1))
    m = re.search(r"(?i)t\.me/user\?id=(\d+)", raw)
    if m:
        return _valid_uid(m.group(1))
    if raw.isdigit():
        return _valid_uid(raw)
    return 0


def _ctx_get(context, key):
    try:
        return context.get(key)
    except Exception:
        pass
    try:
        return context.get(str(key))
    except Exception:
        return None


def _ctx_keys(context):
    try:
        return list(context.keys())
    except Exception:
        pass
    try:
        return [str(k) for k in context.keySet()]
    except Exception:
        return []


class NotifyHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if not p._enabled or not p._banned_cache:
            return
        try:
            args = param.args
            if not args or len(args) < 4:
                return
            if args[0] != NotificationCenter.pushReceived:
                return
            msg_obj = args[3]
            if msg_obj is None:
                return
            if _is_outgoing(msg_obj):
                return
            uid = _extract_uid_any(msg_obj)
            if not uid:
                return
            info = p._banned_cache.get(uid)
            if info and info.get("block_type") == BLOCK_FULL:
                p._dbg(f"NotifyHook: уведомление скрыто uid={uid}")
                param.setResult(None)
        except Exception:
            pass


class CellHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            msg = param.args[0] if param.args else None
            if msg is None:
                msg = get_private_field(param.thisObject, "currentMessageObject")
            if msg is None:
                return
            cell = param.thisObject

            if _is_outgoing(msg):
                self._restore(cell, None)
                return

            uid = _extract_uid_any(msg)
            info = p._banned_cache.get(uid) if uid is not None else None

            if not info or info.get("block_type") != BLOCK_FULL:
                self._restore(cell, uid)
                return

            p._dbg(f"CellHook: ячейка скрыта uid={uid}")
            try:
                cell.setAlpha(0.0)
            except Exception:
                pass
            cell.setVisibility(VIEW_GONE)
            lp = cell.getLayoutParams()
            if lp is not None:
                lp.height = 0
                lp.width = 0
                cell.setLayoutParams(lp)
        except Exception:
            pass

    def _restore(self, cell, uid):
        try:
            lp = cell.getLayoutParams()
            hidden = (cell.getVisibility() == VIEW_GONE
                      or cell.getAlpha() == 0.0
                      or (lp is not None and (lp.height == 0 or lp.width == 0)))
            if hidden:
                self.p._dbg(f"CellHook: ячейка восстановлена uid={uid}")
                cell.setAlpha(1.0)
                cell.setVisibility(VIEW_VISIBLE)
                if lp is not None:
                    lp.height = LP_WRAP_CONTENT
                    lp.width = LP_MATCH_PARENT
                    cell.setLayoutParams(lp)
        except Exception:
            pass


class UserNameHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            arg = param.args[0]
        except Exception:
            return
        if arg is None:
            return
        uid = arg if isinstance(arg, int) else getattr(arg, "id", None)
        if not uid:
            return
        info = p._banned_cache.get(int(uid))
        if info and info.get("block_type") in (BLOCK_FULL, BLOCK_NAME):
            p._dbg(f"UserNameHook: имя скрыто uid={uid}")
            param.setResult(HIDDEN_NAME)


class LastSeenHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._hide_online or not p._banned_cache:
            return
        try:
            arg = param.args[0]
        except Exception:
            return
        if arg is None:
            return
        uid = getattr(arg, "id", None)
        if uid and int(uid) in p._banned_cache:
            p._dbg(f"LastSeenHook: статус скрыт uid={uid}")
            param.setResult(HIDDEN_STATUS)


class PutUsersHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            for arg in (param.args or []):
                if arg is None:
                    continue
                if hasattr(arg, "size"):
                    for i in range(arg.size()):
                        try:
                            p._apply_user_mod(arg.get(i), "PutUsersHook")
                        except Exception:
                            pass
                elif hasattr(arg, "first_name") or hasattr(arg, "id"):
                    p._apply_user_mod(arg, "PutUsersHook")
        except Exception:
            pass


class FragmentBlockHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def _frag_uid(self, obj):
        if obj is None:
            return None
        try:
            cn = obj.getClass().getName()
            if "ProfileActivity" not in cn and "ChatActivity" not in cn:
                return None
        except Exception:
            return None
        try:
            args = None
            for getter in ("getArguments", "getArgumentsBundle"):
                try:
                    g = getattr(obj, getter, None)
                    if g is not None:
                        args = g()
                        if args is not None:
                            break
                except Exception:
                    pass
            return _bundle_get_positive_id(args)
        except Exception:
            return None

    def before_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            mn = param.method.getName()
            if mn in ("showPinnedBar", "updatePinnedMessage"):
                for arg in (param.args or []):
                    if _is_outgoing(arg):
                        continue
                    uid = _extract_uid_any(arg)
                    if uid:
                        info = p._banned_cache.get(uid)
                        if info and info.get("block_type") == BLOCK_FULL:
                            p._dbg(f"FragmentBlockHook: pinned скрыт uid={uid} method={mn}")
                            param.setResult(None)
                            return
                return
            if not p._block_chat:
                return
            uid = self._frag_uid(param.thisObject)
            if uid and uid in p._banned_cache:
                if mn in ("presentFragment", "addFragmentToStack", "onFragmentCreate"):
                    p._dbg(f"FragmentBlockHook: открытие чата заблокировано uid={uid} method={mn}")
                    p._toast("Чат недоступен")
                    self._cancel_open(param)
                return
            for arg in (param.args or []):
                uid = self._frag_uid(arg)
                if uid and uid in p._banned_cache:
                    if mn in ("presentFragment", "addFragmentToStack", "onFragmentCreate"):
                        p._dbg(f"FragmentBlockHook: открытие чата заблокировано uid={uid} method={mn}")
                        p._toast("Чат недоступен")
                        self._cancel_open(param)
                    return
        except Exception:
            pass

    def after_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache or not p._block_chat:
            return
        try:
            mn = param.method.getName()
            if mn in ("showPinnedBar", "updatePinnedMessage"):
                return
            uid = self._frag_uid(param.thisObject)
            if uid and uid in p._banned_cache:
                p._dbg(f"FragmentBlockHook: закрытие фрагмента uid={uid} method={mn}")
                run_on_ui_thread(lambda f=param.thisObject: self._close_fragment(f))
        except Exception:
            pass

    def _cancel_open(self, param):
        try:
            ret = param.method.getReturnType().getName()
            if ret in ("boolean", "java.lang.Boolean"):
                param.setResult(False)
            elif ret in ("int", "java.lang.Integer", "long", "java.lang.Long"):
                param.setResult(0)
            else:
                param.setResult(None)
        except Exception:
            try:
                param.setResult(None)
            except Exception:
                pass

    def _close_fragment(self, fragment):
        try:
            fragment.finishFragment()
            return
        except Exception:
            pass
        try:
            fragment.removeSelfFromStack()
            return
        except Exception:
            pass
        try:
            fragment.getParentLayout().closeLastFragment(True)
        except Exception:
            pass


class NoDisturbPlugin(BasePlugin):

    def _dbg(self, msg):
        if getattr(self, "_debug", False):
            try:
                self.log(f"[NoDisturb v{__version__}][DBG] {msg}")
            except Exception:
                pass

    def on_plugin_load(self):
        self._last_input_key = None
        self._debug = bool(self.get_setting("debug_mode", False))
        self._add_handler = None
        self._add_pending = None
        try:
            from android.os import Handler, Looper
            self._add_handler = Handler(Looper.getMainLooper())
        except Exception:
            pass
        self.log(f"[NoDisturb v{__version__}] libs: zwy={HAS_ZWYLIB}, mandre={HAS_MANDRELIB}")
        self._dbg(f"on_plugin_load: debug={self._debug}")

        if HAS_MANDRELIB:
            try:
                Mandre.use_persistent_storage(self)
                self._dbg("MandreLib: персистентное хранилище активировано")
            except Exception as e:
                self.log(f"[NoDisturb v{__version__}] MandreLib storage error: {e}")

        self._banned_cache = self._load_banned()
        self._enabled = bool(self.get_setting("enabled", True))
        self._hide_online = bool(self.get_setting("hide_online", True))
        self._block_chat = bool(self.get_setting(BLOCK_CHAT_KEY, True))
        self._my_id = self._detect_my_id()
        self._dbg(f"настройки: enabled={self._enabled}, hide_online={self._hide_online}, "
                  f"block_chat={self._block_chat}, my_id={self._my_id}, "
                  f"banned={len(self._banned_cache)}")
        self._xposed_hooks = []
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.PROFILE_ACTION_MENU,
            text="NoDisturb", on_click=self._on_profile_click,
            icon="msg_block", subtext="Скрыть профиль", priority=5))
        self._dbg("меню профиля добавлено")
        self.add_hook("TL_updateNewMessage")
        self.add_hook("TL_updateNewChannelMessage")
        self.add_hook("TL_updateUserStatus")
        self.add_hook("Typing", match_substring=True)
        self.add_hook("TL_updates")
        self.add_hook("TL_updatesCombined")
        self.add_hook("TL_updateShort")
        self._dbg("event-хуки зарегистрированы (7)")

        if HAS_ZWYLIB:
            try:
                zwylib.add_autoupdater_task(__id__, UPDATE_CHANNEL_ID, UPDATE_MESSAGE_ID)
                self.log(f"[NoDisturb v{__version__}] ZwyLib: автообновление зарегистрировано")
            except Exception as e:
                self.log(f"[NoDisturb v{__version__}] ZwyLib: ошибка регистрации: {e}")

        self._install_hooks()
        self._patch_cached_users()
        libs_status = []
        if HAS_MANDRELIB: libs_status.append("MandreLib")
        if HAS_ZWYLIB: libs_status.append("ZwyLib")
        libs_str = ", ".join(libs_status) if libs_status else "нет"
        self.log(f"[NoDisturb v{__version__}] готов. Скрыто: {len(self._banned_cache)}, my_id={self._my_id}, допы: {libs_str}")

    def on_plugin_unload(self):
        if HAS_ZWYLIB:
            try:
                zwylib.remove_autoupdater_task(__id__)
            except Exception:
                pass
        self._cancel_pending_add()
        self.log(f"[NoDisturb v{__version__}] выгружен.")

    def _ui(self, fn):
        try:
            run_on_ui_thread(fn)
        except Exception:
            try:
                fn()
            except Exception:
                pass

    def _popup(self, kind, text):
        self._dbg(f"popup[{kind}]: {text}")
        def do():
            if kind == "err":
                BulletinHelper.show_error(text)
            elif kind == "ok":
                BulletinHelper.show_success(text)
            else:
                BulletinHelper.show_info(text)
        self._ui(do)

    def _post_delayed(self, fn, ms):
        try:
            from android.os import Handler, Looper

            class _R(dynamic_proxy(_JRunnable)):
                def run(self):
                    try:
                        fn()
                    except Exception:
                        pass
            Handler(Looper.getMainLooper()).postDelayed(_R(), ms)
        except Exception:
            self._ui(fn)

    def _detect_my_id(self):
        try:
            u = get_user_config().getCurrentUser()
            return int(u.id) if u else 0
        except Exception:
            return 0

    def _is_chat_or_channel(self, user):
        if user is None:
            return False
        try:
            uid = int(getattr(user, "id", 0) or 0)
            if _is_channel_like(uid):
                return True
        except Exception:
            pass
        try:
            if getattr(user, "broadcast", False):
                return True
            if getattr(user, "megagroup", False):
                return True
            if getattr(user, "gigagroup", False):
                return True
        except Exception:
            pass
        return False

    def _toast(self, msg):
        self._popup("err", msg)

    def _notify_user_status(self, uid, user):
        if NotificationCenter is None:
            return
        try:
            nc = NotificationCenter.getInstance(0)
            nc.postNotificationName(
                NotificationCenter.updateUserStatus, int(uid), user, False)
            self._dbg(f"notifyUserStatus uid={uid}")
        except Exception:
            pass

    def _force_offline(self, uid):
        def do():
            try:
                mc = get_messages_controller()
                u = mc.getUser(uid)
                if u is not None:
                    st = _offline_status()
                    if st is not None:
                        u.status = st
                    self._dbg(f"force_offline uid={uid}")
                    self._notify_user_status(uid, u)
            except Exception:
                pass
        run_on_ui_thread(do)

    def _apply_user_mod(self, user, src=""):
        if user is None:
            return
        uid = _valid_uid(getattr(user, "id", 0))
        if not uid:
            return
        if uid == self._my_id:
            return
        info = self._banned_cache.get(uid)
        if not info:
            return
        bt = info.get("block_type")
        try:
            if bt in (BLOCK_FULL, BLOCK_NAME):
                user.first_name = HIDDEN_NAME
                user.last_name = ""
                user.username = None
            if bt in (BLOCK_FULL, BLOCK_AVATAR):
                user.photo = None
            if self._hide_online:
                st = _offline_status()
                if st is not None:
                    user.status = st
            self._dbg(f"{src}: применены модификации uid={uid} type={_bt_label(bt)}")
        except Exception:
            pass

    def _patch_cached_users(self):
        if not self._banned_cache:
            return

        def do():
            try:
                mc = get_messages_controller()
                cnt = 0
                for uid in list(self._banned_cache.keys()):
                    try:
                        u = mc.getUser(uid)
                        if u is not None:
                            self._apply_user_mod(u, "patch_cached")
                            self._notify_user_status(uid, u)
                            cnt += 1
                    except Exception:
                        pass
                self._dbg(f"patch_cached_users: обработано {cnt}")
                if NotificationCenter is not None:
                    nc = NotificationCenter.getInstance(0)
                    nc.postNotificationName(NotificationCenter.dialogsNeedReload)
            except Exception:
                pass
        run_on_ui_thread(do)

    def _load_banned(self):
        try:
            raw = json.loads(self.get_setting(BANNED_KEY, "{}"))
            out = {}
            for k, v in raw.items():
                uid = _valid_uid(k)
                if not uid:
                    continue
                if isinstance(v, dict):
                    out[uid] = {"name": v.get("name") or f"id{uid}",
                                "block_type": v.get("block_type") or BLOCK_FULL,
                                "usernames": v.get("usernames") or []}
                else:
                    out[uid] = {"name": str(v), "block_type": BLOCK_FULL,
                                "usernames": []}
            self._dbg(f"load_banned: {len(out)} записей")
            return out
        except Exception:
            return {}

    def _save_banned(self):
        payload = json.dumps({str(k): v for k, v in self._banned_cache.items()},
                             ensure_ascii=False)
        self._dbg(f"save_banned: {len(self._banned_cache)} записей")

        def do():
            try:
                self.set_setting(BANNED_KEY, payload, reload_settings=True)
            except Exception:
                pass
        self._ui(do)

    def is_banned(self, uid):
        return uid in self._banned_cache

    def get_block_type(self, uid):
        info = self._banned_cache.get(uid)
        return info.get("block_type", BLOCK_NONE) if info else BLOCK_NONE

    def ban_user(self, uid, name, usernames, bt):
        uid = _valid_uid(uid)
        if not uid:
            return
        if self._my_id and uid == self._my_id:
            self._popup("err", "Нельзя забанить самого себя")
            return
        if _is_channel_like(uid):
            self._popup("err", "Нельзя забанить группу или канал")
            return
        self._banned_cache[uid] = {"name": name, "block_type": bt,
                                   "usernames": usernames}
        self._save_banned()
        self._patch_cached_users()
        self.log(f"[NoDisturb v{__version__}] {name} → {_bt_label(bt)}")
        self._dbg(f"ban_user: uid={uid} name={name} type={_bt_label(bt)}")
        self._notify_ban(name, _bt_label(bt))

    def set_block_type(self, uid, bt):
        if uid in self._banned_cache:
            self._banned_cache[uid]["block_type"] = bt
            self._save_banned()
            self._patch_cached_users()
            self._dbg(f"set_block_type: uid={uid} → {_bt_label(bt)}")

    def unban_user(self, uid):
        name = self._banned_cache.get(uid, {}).get("name", f"id{uid}")
        self._banned_cache.pop(uid, None)
        self._save_banned()
        self._patch_cached_users()
        self.log(f"[NoDisturb v{__version__}] {name}: бан снят")
        self._dbg(f"unban_user: uid={uid} name={name}")
        self._notify_unban(name)

    def _clear_input(self):
        self._dbg("clear_input")
        def do():
            try:
                self.set_setting(ADD_INPUT_KEY, "", reload_settings=True)
            except Exception:
                pass
        self._ui(do)
        self._post_delayed(do, 400)

    def _cancel_pending_add(self):
        if self._add_pending is not None and self._add_handler is not None:
            try:
                self._add_handler.removeCallbacks(self._add_pending)
            except Exception:
                pass
            self._add_pending = None

    def _quick_add_from_input(self, value: str):
        raw = value.strip()
        if not raw:
            self._cancel_pending_add()
            return
        now = time.time()
        key = "|".join(sorted(t.lower() for t in re.split(r"[,\s]+", raw) if t))
        last = self._last_input_key
        if last and last[0] == key and now - last[1] < 2.0:
            self._dbg(f"input: дедуп, пропуск '{raw}'")
            return
        self._last_input_key = (key, now)
        self._dbg(f"input: '{raw}'")
        self._schedule_add(raw)

    def _schedule_add(self, raw):
        if self._add_handler is None or not _HAS_PROXY:
            self._do_add(raw)
            return
        self._cancel_pending_add()
        task = _DebouncedRunnable(lambda: self._do_add(raw))
        self._add_pending = task
        self._add_handler.postDelayed(task, 600)

    def _do_add(self, raw):
        self._add_pending = None
        try:
            cur = str(self.get_setting(ADD_INPUT_KEY, "") or "").strip()
        except Exception:
            cur = raw
        if cur and cur != raw:
            self._dbg(f"do_add: ввод изменился, пропуск '{raw}'")
            return
        tokens = [t for t in re.split(r"[,\s]+", raw) if t]
        if len(tokens) >= 2:
            self._process_multi(tokens)
        else:
            if "," in raw:
                return
            self._process_single(raw)

    def _process_single(self, raw):
        uid = _parse_target_id(raw)
        if uid:
            if self._my_id and uid == self._my_id:
                self._popup("err", "Нельзя забанить самого себя")
                self._clear_input()
                return
            if _is_channel_like(uid):
                self._popup("err", "Нельзя забанить группу или канал")
                self._clear_input()
                return
            name = f"id{uid}"
            try:
                u = get_messages_controller().getUser(uid)
                if u is not None:
                    name = _user_title(u, name)
            except Exception:
                pass
            if self.is_banned(uid):
                self._popup("info", f"{name} уже в бане")
                self._clear_input()
                return
            self.ban_user(uid, name, [], BLOCK_FULL)
            self._popup("ok", f"{name} добавлен в бан")
            self._clear_input()
            return

        username = raw.lstrip("@").strip()
        if not username or not re.match(r"^[a-zA-Z0-9_]{3,}$", username):
            self._popup("err", "Введите ID или @username")
            self._clear_input()
            return
        self._resolve_and_ban(username, clear_on_done=True, silent_success=False)

    def _process_multi(self, tokens):
        self._dbg(f"multi: токены={tokens}")
        added = 0
        already = 0
        rejected = 0
        invalid = []
        usernames = []

        for tok in tokens:
            uid = _parse_target_id(tok)
            if uid:
                if (self._my_id and uid == self._my_id) or _is_channel_like(uid):
                    rejected += 1
                    continue
                if self.is_banned(uid):
                    already += 1
                    continue
                name = f"id{uid}"
                try:
                    u = get_messages_controller().getUser(uid)
                    if u is not None:
                        name = _user_title(u, name)
                except Exception:
                    pass
                self.ban_user(uid, name, [], BLOCK_FULL)
                added += 1
                continue
            un = tok.lstrip("@").strip()
            if un and re.match(r"^[a-zA-Z0-9_]{3,}$", un):
                usernames.append(un)
            else:
                invalid.append(tok)

        for un in usernames:
            self._resolve_and_ban(un, clear_on_done=False, silent_success=True)

        parts = []
        if added:
            parts.append(f"добавлено: {added}")
        if already:
            parts.append(f"уже в бане: {already}")
        if usernames:
            parts.append(f"обрабатывается: {len(usernames)}")
        if rejected:
            parts.append(f"отклонено: {rejected}")
        if invalid:
            parts.append(f"не распознано: {', '.join(invalid[:3])}")
        if parts:
            self._popup("info", "🚫 " + "; ".join(parts))
        self._clear_input()

    def _resolve_and_ban(self, username, clear_on_done=False, silent_success=False):
        if TLRPC is None:
            self._popup("err", "TLRPC недоступен")
            return
        self._dbg(f"resolve: @{username}")
        try:
            req = TLRPC.TL_contacts_resolveUsername()
            req.username = username

            def on_resp(response, error):
                try:
                    if error is not None or response is None:
                        self._dbg(f"resolve @{username}: ошибка {getattr(error, 'text', error)}")
                        if not silent_success:
                            self._popup("err",
                                        f"Пользователь не найден: {getattr(error, 'text', '') or '@' + username}")
                        if clear_on_done:
                            self._clear_input()
                        return
                    users = getattr(response, "users", None)
                    if users is None or not hasattr(users, "size") or users.size() == 0:
                        self._dbg(f"resolve @{username}: пустой ответ")
                        if not silent_success:
                            self._popup("err", f"Пользователь не найден: @{username}")
                        if clear_on_done:
                            self._clear_input()
                        return
                    user = users.get(0)
                    uid = int(getattr(user, "id", 0))
                    self._dbg(f"resolve @{username}: uid={uid}")
                    if not uid:
                        if not silent_success:
                            self._popup("err", "Не удалось получить ID")
                        if clear_on_done:
                            self._clear_input()
                        return
                    if self._my_id and uid == self._my_id:
                        self._popup("err", "Нельзя забанить самого себя")
                        if clear_on_done:
                            self._clear_input()
                        return
                    if self._is_chat_or_channel(user):
                        self._popup("err", "Нельзя забанить группу или канал")
                        if clear_on_done:
                            self._clear_input()
                        return
                    name = _user_title(user, f"@{username}")
                    if self.is_banned(uid):
                        self._popup("info", f"{name} уже в бане")
                        if clear_on_done:
                            self._clear_input()
                        return
                    usernames = _extract_usernames(user)
                    self.ban_user(uid, name, usernames, BLOCK_FULL)
                    if not silent_success:
                        self._popup("ok", f"{name} добавлен в бан")
                    if clear_on_done:
                        self._clear_input()
                except Exception:
                    self.log(f"[NoDisturb v{__version__}] on_resp error: {traceback.format_exc()}")

            send_request(req, on_resp)
        except Exception as e:
            self.log(f"[NoDisturb v{__version__}] resolve error: {e}")
            self._popup("err", f"Ошибка: {e}")
            if clear_on_done:
                self._clear_input()

    def _install_hooks(self):
        try:
            cls = find_class("org.telegram.messenger.NotificationCenter")
            if cls:
                r = self.hook_all_methods(cls, "postNotificationName", NotifyHook(self))
                if r:
                    self._xposed_hooks.extend(r)
                    self._dbg(f"xposed: NotificationCenter.postNotificationName ×{len(r)}")
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.ui.Cells.ChatMessageCell")
            if cls:
                r = self.hook_all_methods(cls, "setMessageObject", CellHook(self))
                if r:
                    self._xposed_hooks.extend(r)
                    self._dbg(f"xposed: ChatMessageCell.setMessageObject ×{len(r)}")
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.messenger.MessagesController")
            if cls:
                r = self.hook_all_methods(cls, "putUsers", PutUsersHook(self))
                if r:
                    self._xposed_hooks.extend(r)
                    self._dbg(f"xposed: MessagesController.putUsers ×{len(r)}")
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.messenger.UserObject")
            if cls:
                r = self.hook_all_methods(cls, "getUserName", UserNameHook(self))
                if r:
                    self._xposed_hooks.extend(r)
                    self._dbg(f"xposed: UserObject.getUserName ×{len(r)}")
                r = self.hook_all_methods(cls, "getLastSeenString", LastSeenHook(self))
                if r:
                    self._xposed_hooks.extend(r)
                    self._dbg(f"xposed: UserObject.getLastSeenString ×{len(r)}")
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.ui.ActionBar.ActionBarLayout")
            if cls:
                hook = FragmentBlockHook(self)
                for name in ("presentFragment", "addFragmentToStack"):
                    r = self.hook_all_methods(cls, name, hook)
                    if r:
                        self._xposed_hooks.extend(r)
                        self._dbg(f"xposed: ActionBarLayout.{name} ×{len(r)}")
        except Exception:
            pass
        try:
            hook = FragmentBlockHook(self)
            for cls_name in ("org.telegram.ui.ProfileActivity",
                             "org.telegram.ui.ChatActivity"):
                cls = find_class(cls_name)
                if not cls:
                    continue
                for name in ("onFragmentCreate", "createView", "onResume"):
                    r = self.hook_all_methods(cls, name, hook)
                    if r:
                        self._xposed_hooks.extend(r)
                        self._dbg(f"xposed: {cls_name.split('.')[-1]}.{name} ×{len(r)}")
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.ui.ChatActivity")
            if cls:
                hook = FragmentBlockHook(self)
                for name in ("showPinnedBar", "updatePinnedMessage"):
                    try:
                        r = self.hook_all_methods(cls, name, hook)
                        if r:
                            self._xposed_hooks.extend(r)
                            self._dbg(f"xposed: ChatActivity.{name} ×{len(r)}")
                    except Exception:
                        pass
        except Exception:
            pass
        self._dbg(f"xposed итого хуков: {len(self._xposed_hooks)}")

    def on_update_hook(self, update_name, account, update):
        if not self._enabled or not self._banned_cache:
            return HookResult()

        if "typing" in update_name.lower():
            uid = 0
            try:
                uid = int(getattr(update, "user_id", 0) or 0)
            except Exception:
                uid = 0
            if not uid:
                try:
                    fid = getattr(update, "from_id", None)
                    if fid is not None:
                        uid = int(getattr(fid, "user_id", 0) or 0)
                except Exception:
                    uid = 0
            if uid and uid in self._banned_cache:
                self._dbg(f"update {update_name}: typing скрыт uid={uid}")
                return HookResult(strategy=HookStrategy.CANCEL)
            return HookResult()

        if update_name == "TL_updateUserStatus":
            if not self._hide_online:
                return HookResult()
            try:
                uid = int(getattr(update, "user_id", 0) or 0)
            except Exception:
                uid = 0
            if not uid or uid not in self._banned_cache:
                return HookResult()
            self._dbg(f"update TL_updateUserStatus: скрыт uid={uid}")
            self._force_offline(uid)
            return HookResult(strategy=HookStrategy.CANCEL)

        if update_name not in ("TL_updateNewMessage", "TL_updateNewChannelMessage"):
            return HookResult()
        try:
            msg = getattr(update, "message", None)
            if msg is None:
                return HookResult()
            if _is_outgoing(msg):
                return HookResult()
            uid = _extract_uid_any(msg)
            if uid:
                info = self._banned_cache.get(uid)
                if info and info.get("block_type") == BLOCK_FULL:
                    self._dbg(f"update {update_name}: сообщение скрыто uid={uid}")
                    return HookResult(strategy=HookStrategy.CANCEL)
        except Exception:
            pass
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        if not self._enabled or not self._banned_cache:
            return HookResult()
        changed = False
        dropped = 0
        try:
            lst = getattr(updates, "updates", None)
            if lst is not None and hasattr(lst, "size"):
                i = lst.size() - 1
                while i >= 0:
                    try:
                        u = lst.get(i)
                        cn = u.getClass().getName()
                        drop = False
                        uid = 0
                        if "updateUserStatus" in cn:
                            uid = int(getattr(u, "user_id", 0) or 0)
                            if uid and uid in self._banned_cache and self._hide_online:
                                self._force_offline(uid)
                                drop = True
                        elif "Typing" in cn:
                            uid = int(getattr(u, "user_id", 0) or 0)
                            if not uid:
                                fid = getattr(u, "from_id", None)
                                if fid is not None:
                                    uid = int(getattr(fid, "user_id", 0) or 0)
                            if uid and uid in self._banned_cache:
                                drop = True
                        if drop:
                            lst.remove(i)
                            changed = True
                            dropped += 1
                            self._dbg(f"updates {container_name}: удалён {cn} uid={uid}")
                    except Exception:
                        pass
                    i -= 1
        except Exception:
            pass
        if changed:
            self._dbg(f"on_updates_hook: всего удалено {dropped}")
            return HookResult(strategy=HookStrategy.MODIFY, updates=updates)
        return HookResult()

    def _on_profile_click(self, context):
        try:
            self._dbg(f"profile_click: keys={_ctx_keys(context)}")
            for chat_key in ("chat", "chatId", "chatFull", "encryptedChat"):
                v = _ctx_get(context, chat_key)
                if v is None:
                    continue
                try:
                    if int(v) == 0:
                        continue
                except Exception:
                    pass
                self._popup("err", "Нельзя забанить группу или канал")
                return

            user = _ctx_get(context, "user")
            if user is None:
                self._popup("err", "Не удалось получить данные пользователя")
                return

            uid = _valid_uid(getattr(user, "id", 0))
            if not uid:
                self._popup("err", "Не удалось получить ID")
                return

            if self._is_chat_or_channel(user):
                self._popup("err", "Нельзя забанить группу или канал")
                return

            if self._my_id and uid == self._my_id:
                self._popup("err", "Нельзя забанить самого себя")
                return
            name = _user_title(user, f"id{uid}")
            usernames = _extract_usernames(user)
            self._dbg(f"profile_click: uid={uid} name={name} banned={self.is_banned(uid)}")
            if self.is_banned(uid):
                self._show_actions(uid, name)
            else:
                self._show_add(uid, name, usernames)
        except Exception:
            self.log(f"[NoDisturb v{__version__}] profile_click error: {traceback.format_exc()}")

    def _show_add(self, uid, name, usernames):
        self._dbg(f"show_add: uid={uid}")
        if HAS_MANDRELIB:
            try:
                MandreUI.show(
                    title=f"NoDisturb: {name}",
                    items=[
                        "🚫 Полное скрытие",
                        "❗ Скрыть имя",
                        "❗ Скрыть аватарку",
                    ],
                    on_select=lambda i, t: self._on_add_pick_mandre(i, uid, name, usernames),
                    message="Выберите тип скрытия:",
                    cancel_text="Отмена",
                )
                return
            except Exception as e:
                self.log(f"[NoDisturb v{__version__}] MandreUI error, fallback: {e}")
        
        def do():
            act = self._activity()
            if not act:
                return
            b = AlertDialogBuilder(act)
            b.set_title("NoDisturb: " + name)
            b.set_message("Выберите действие:")
            b.set_items(
                ["🚫 Полное скрытие", "❗Скрыть имя", "❗Скрыть аватарку"],
                lambda bld, which: self._on_add_pick(bld, uid, name, usernames, which),
            )
            b.show()
        run_on_ui_thread(do)

    def _on_add_pick_mandre(self, index, uid, name, usernames):
        self._dbg(f"add_pick: uid={uid} index={index}")
        if index == 0:
            self.ban_user(uid, name, usernames, BLOCK_FULL)
            self._popup("ok", f"{name}: полное скрытие")
        elif index == 1:
            self.ban_user(uid, name, usernames, BLOCK_NAME)
            self._popup("ok", f"{name}: имя скрыто")
        elif index == 2:
            self.ban_user(uid, name, usernames, BLOCK_AVATAR)
            self._popup("ok", f"{name}: аватарка скрыта")

    def _on_add_pick(self, bld, uid, name, usernames, which):
        bld.dismiss()
        self._dbg(f"add_pick(fallback): uid={uid} which={which}")
        if which == 0:
            self.ban_user(uid, name, usernames, BLOCK_FULL)
            self._popup("ok", f"{name}: полное скрытие")
        elif which == 1:
            self.ban_user(uid, name, usernames, BLOCK_NAME)
            self._popup("ok", f"{name}: имя скрыто")
        elif which == 2:
            self.ban_user(uid, name, usernames, BLOCK_AVATAR)
            self._popup("ok", f"{name}: аватарка скрыта")

    def _show_actions(self, uid, name):
        self._dbg(f"show_actions: uid={uid}")
        if HAS_MANDRELIB:
            try:
                bt = self.get_block_type(uid)
                labels = {
                    BLOCK_FULL: "🚫 Полное скрытие",
                    BLOCK_NAME: "❗ Скрыть имя",
                    BLOCK_AVATAR: "❗ Скрыть аватарку",
                }
                current = labels.get(bt)
                actions = [(k, labels[k]) for k in (BLOCK_FULL, BLOCK_NAME, BLOCK_AVATAR)
                           if k != bt]
                items = [lb for _, lb in actions]
                items.append("⚠️ Снятие бана")
                
                MandreUI.show(
                    title=f"{name} — {current}" if current else f"NoDisturb: {name}",
                    items=items,
                    on_select=lambda i, t: self._on_action_pick_mandre(i, uid, name, actions),
                    message="Выберите действие:",
                    cancel_text="Отмена",
                )
                return
            except Exception as e:
                self.log(f"[NoDisturb v{__version__}] MandreUI error, fallback: {e}")
        
        def do():
            act = self._activity()
            if not act:
                return
            bt = self.get_block_type(uid)
            labels = {
                BLOCK_FULL: "🚫 Полное скрытие",
                BLOCK_NAME: "❗Скрыть имя",
                BLOCK_AVATAR: "❗Скрыть аватарку",
            }
            current = labels.get(bt)
            actions = [(k, labels[k]) for k in (BLOCK_FULL, BLOCK_NAME, BLOCK_AVATAR)
                       if k != bt]
            items = [lb for _, lb in actions]
            items.append("⚠️ Снятие бана")

            b = AlertDialogBuilder(act)
            if current:
                b.set_title(f"{name} — {current}")
            else:
                b.set_title("NoDisturb: " + name)
            b.set_message("Выберите действие:")
            b.set_items(
                items,
                lambda bld, which: self._on_action_pick(bld, uid, name, actions, which),
            )
            b.show()
        run_on_ui_thread(do)

    def _on_action_pick_mandre(self, index, uid, name, actions):
        self._dbg(f"action_pick: uid={uid} index={index}")
        if index < len(actions):
            key, _lb = actions[index]
            self.set_block_type(uid, key)
            self._popup("ok", f"{name}: {_bt_label(key)}")
        else:
            self.unban_user(uid)
            self._popup("ok", f"{name}: бан снят")

    def _on_action_pick(self, bld, uid, name, actions, which):
        bld.dismiss()
        self._dbg(f"action_pick(fallback): uid={uid} which={which}")
        if which < len(actions):
            key, _lb = actions[which]
            self.set_block_type(uid, key)
            self._popup("ok", f"{name}: {_bt_label(key)}")
        else:
            self.unban_user(uid)
            self._popup("ok", f"{name}: бан снят")

    def _notify_ban(self, name, action):
        if not HAS_MANDRELIB:
            return
        try:
            Mandre.Notification.show_dialog(
                sender_name="NoDisturb",
                message=f"{name}: {action}",
                channel_id="nodisturb_actions",
            )
            self._dbg(f"notification: {name}: {action}")
        except Exception as e:
            self.log(f"[NoDisturb v{__version__}] notification error: {e}")

    def _notify_unban(self, name):
        if not HAS_MANDRELIB:
            return
        try:
            Mandre.Notification.show_dialog(
                sender_name="NoDisturb",
                message=f"{name}: бан снят",
                channel_id="nodisturb_actions",
            )
            self._dbg(f"notification: {name}: бан снят")
        except Exception as e:
            self.log(f"[NoDisturb v{__version__}] notification error: {e}")

    def _activity(self):
        try:
            frag = get_last_fragment()
            if frag:
                return frag.getParentActivity()
        except Exception:
            pass
        return None

    def create_settings(self):
        global HAS_MANDRELIB, HAS_ZWYLIB
        HAS_MANDRELIB, mandre_label = _lib_info(_MANDRE_IMPORTED, "mandre_lib")
        HAS_ZWYLIB, zwy_label = _lib_info(_ZWY_IMPORTED, "zwylib")
        self._dbg(f"create_settings: zwy={zwy_label}, mandre={mandre_label}")

        banned = self._banned_cache
        rows = [
            Header(text="Основные"),
            Switch(key="enabled", text="Включить NoDisturb", default=True,
                   icon="msg_block",
                   on_change=lambda v: setattr(self, "_enabled", bool(v))),
            Switch(key="hide_online", text="Скрывать онлайн цели", default=True,
                   subtext="Цель всегда «Был(а) давно»",
                   icon="msg_stealth_locked",
                   on_change=lambda v: setattr(self, "_hide_online", bool(v))),
            Switch(key=BLOCK_CHAT_KEY, text="Запрет на открытие чата", default=True,
                   subtext="Запрещает открывать профиль/чат цели",
                   icon="msg_filled_blocked",
                   on_change=lambda v: setattr(self, "_block_chat", bool(v))),
            Input(key=ADD_INPUT_KEY,
                  text="Добавление по @username",
                  subtext="",
                  default="",
                  icon="msg_add",
                  on_change=self._quick_add_from_input),
            Divider(),
            Header(text="Скрытые профили"),
        ]
        if not banned:
            rows.append(Text(text="Список пуст",
                             subtext="Профиль ➜︙ Плагины ➜ NoDisturb",
                             icon="msg_view_file"))
        else:
            for uid, info in sorted(banned.items(),
                                     key=lambda x: x[1].get("name", "").lower()):
                n = info.get("name", f"id{uid}")
                bt = info.get("block_type", BLOCK_FULL)
                unames = info.get("usernames", []) or []
                sub = f"ID: {uid}"
                if unames:
                    sub += " @" + ", @".join(unames[:2])
                sub += f" • {_bt_label(bt)}"
                rows.append(Text(
                    text=n,
                    subtext=sub,
                    icon="msg_block",
                    red=True,
                    on_click=lambda _v, _u=uid, _n=n:
                        self._show_actions(int(_u), _n),
                ))
        rows += [
            Text(text="Очистить всё",
                 subtext="Снять блокировки со всех профилей",
                 icon="msg_delete",
                 red=True,
                 on_click=self._settings_clear),
            Divider(),
            Header(text="Информация"),
            Switch(key="debug_mode", text="Отладочный режим", default=False,
                   subtext="Подробные логи всех действий плагина",
                   icon="msg_settings",
                   on_change=lambda v: setattr(self, "_debug", bool(v))),
            Text(text="ZwyLib",
                 subtext=zwy_label,
                 icon="msg_info"),
            Text(text="MandreLib",
                 subtext=mandre_label,
                 icon="msg_info"),
            Text(text=f"NoDisturb v{__version__}",
                 subtext="Автор @cobra_S0FT | Мой тгк @excess_plugins",
                 icon="msg_info"),
        ]
        return rows

    def _settings_clear(self, _v=None):
        if not self._banned_cache:
            BulletinHelper.show_info("Список уже пуст")
            return

        self._dbg(f"settings_clear: {len(self._banned_cache)} записей")
        if HAS_MANDRELIB:
            try:
                count = len(self._banned_cache)
                MandreUI.show(
                    title="Очистить список?",
                    items=["Да, очистить всё", "Отмена"],
                    on_select=lambda i, t: self._confirm_clear(i, count),
                    message=f"Будет снято блокировок: {count}",
                    cancel_text="Отмена",
                )
                return
            except Exception:
                pass
        
        def do():
            act = self._activity()
            if not act:
                return
            b = AlertDialogBuilder(act)
            b.set_title("Очистить список?")
            b.set_message("Все блокировки будут сняты.")

            def ok(bld, _):
                n = len(self._banned_cache)
                self._banned_cache.clear()
                self._save_banned()
                bld.dismiss()
                BulletinHelper.show_success(f"Снято блокировок: {n}")

            b.set_positive_button("Очистить", ok)
            b.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
            b.set_negative_button("Отмена", lambda x, _: x.dismiss())
            b.show()
        run_on_ui_thread(do)

    def _confirm_clear(self, index, count):
        self._dbg(f"confirm_clear: index={index}")
        if index == 0:
            self._banned_cache.clear()
            self._save_banned()
            BulletinHelper.show_success(f"Снято блокировок: {count}")
            if HAS_MANDRELIB:
                try:
                    Mandre.Notification.show_simple(
                        title="NoDisturb",
                        text=f"Очищено блокировок: {count}",
                        channel_id="nodisturb_actions",
                    )
                except Exception:
                    pass