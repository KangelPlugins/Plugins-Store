try:
    from java.chaquopy import dynamic_proxy
    from java.lang import Runnable as _JRunnable

    class _DebouncedRunnable(dynamic_proxy(_JRunnable)):
        def __init__(self, fn):
            super().__init__()
            self._fn = fn

        def run(self):
            try:
                self._fn()
            except Exception:
                pass

    _HAS_PROXY = True
except Exception:
    _HAS_PROXY = False


def _lib_enabled_pref(lib_id):
    try:
        import os
        from android.app import ActivityThread
        pkg = ActivityThread.currentApplication().getPackageName()
        path = "/data/data/%s/shared_prefs/plugin_settings.xml" % pkg
        if not os.path.exists(path):
            return None
        with open(path, "r", encoding="utf-8") as fh:
            txt = fh.read()
        m = re.search(r'name="plugin_enabled_%s"\s+value="(true|false)"'
                      % re.escape(lib_id), txt, re.I)
        if m:
            return m.group(1) == "true"
    except Exception:
        pass
    return None


def _lib_info(imported, lib_id):
    if not imported:
        return False, "Не установлена"
    st = _lib_enabled_pref(lib_id)
    if st is False:
        return False, "Выключено"
    return True, "Активно"


HAS_MANDRELIB, _MANDRE_LABEL = _lib_info(_MANDRE_IMPORTED, "mandre_lib")
HAS_ZWYLIB, _ZWY_LABEL = _lib_info(_ZWY_IMPORTED, "zwylib")

