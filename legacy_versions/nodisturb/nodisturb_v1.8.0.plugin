import json
from typing import Any, Dict, List, Optional

from base_plugin import (BasePlugin, HookResult, HookStrategy, MenuItemData,
                         MenuItemType, MethodHook)
from hook_utils import find_class, get_private_field
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Switch, Text
from client_utils import get_last_fragment, get_messages_controller
from android_utils import run_on_ui_thread

try:
    from org.telegram.messenger import NotificationCenter
except Exception:
    NotificationCenter = None

__id__ = "nodisturb"
__name__ = "NoDisturb"
__description__ = (
    "Ru:\n"
    "Теневой бан. Позволяет скрыть имя, аватарку, сообщения и уведомления цели, а также всё вместе.\n"
    "Автор идеи: @WneDom\n"
    "На основе Shadowban (@kester & @pulseplugin)\n\n"
    "En:\n"
    "Shadowban. Allows you to hide the target's name, avatar, messages, and notifications—or all of the above.\n"
    "Idea by: @WneDom\n"
    "Based on Shadowban (@kester & @pulseplugin)"
)
__author__ = "@cobra_S0FT & @excess_plugins"
__version__ = "1.8.0"
__icon__ = "alegquin33/81"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

BLOCK_FULL, BLOCK_NAME, BLOCK_AVATAR, BLOCK_NONE = "full", "name", "avatar", "none"
HIDDEN_NAME = "Unknown Name"
BANNED_KEY = "nodisturb_banned_v3"


def _bt_label(bt):
    return {BLOCK_FULL: "Полное скрытие", BLOCK_NAME: "Скрыть имя",
            BLOCK_AVATAR: "Скрыть аватарку"}.get(bt, "Неизвестно")


def _extract_uid_any(obj):
    if obj is None:
        return None
    try:
        fid = obj.getFromId()
        if fid and int(fid) > 0:
            return int(fid)
    except Exception:
        pass
    try:
        did = obj.getDialogId()
        if did and int(did) > 0:
            return int(did)
    except Exception:
        pass
    try:
        owner = getattr(obj, "messageOwner", None) or obj
        peer = getattr(owner, "from_id", None)
        if peer is not None:
            uid = getattr(peer, "user_id", None)
            if uid and int(uid) > 0:
                return int(uid)
        for field in ("sender_id", "dialog_id"):
            val = getattr(owner, field, None)
            if val and int(val) > 0:
                return int(val)
    except Exception:
        pass
    return None


def _extract_usernames(user):
    try:
        u = (getattr(user, "username", "") or "").strip().lower()
        return [u] if u else []
    except Exception:
        return []


def _user_title(user, fallback="Пользователь"):
    try:
        full = ((getattr(user, "first_name", "") or "") + " " +
                (getattr(user, "last_name", "") or "")).strip()
        if full:
            return full
        un = (getattr(user, "username", "") or "").strip()
        if un:
            return "@" + un
    except Exception:
        pass
    return fallback


class NotifyHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if not p._enabled or not p._banned_cache:
            return
        try:
            args = param.args
            if not args or len(args) < 2:
                return
            name = args[0]
            if name != NotificationCenter.pushReceived:
                return
            if len(args) < 4:
                return
            msg_obj = args[3]
            if msg_obj is None:
                return
            uid = _extract_uid_any(msg_obj)
            if not uid:
                return
            info = p._banned_cache.get(uid)
            if info and info.get("block_type") == BLOCK_FULL:
                param.setResult(None)
        except Exception:
            pass


class CellHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            msg = param.args[0] if param.args else None
            if msg is None:
                msg = get_private_field(param.thisObject, "currentMessageObject")
            if msg is None:
                return
            uid = _extract_uid_any(msg)
            if not uid:
                return
            info = p._banned_cache.get(uid)
            if not info or info.get("block_type") != BLOCK_FULL:
                return
            cell = param.thisObject
            try:
                cell.setAlpha(0.0)
            except Exception:
                pass
            cell.setVisibility(8)
            lp = cell.getLayoutParams()
            if lp is not None:
                lp.height = 0
                lp.width = 0
                cell.setLayoutParams(lp)
        except Exception:
            pass


class UserNameHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            arg = param.args[0]
        except Exception:
            return
        if arg is None:
            return
        uid = arg if isinstance(arg, int) else getattr(arg, "id", None)
        if not uid:
            return
        info = p._banned_cache.get(int(uid))
        if info and info.get("block_type") in (BLOCK_FULL, BLOCK_NAME):
            param.setResult(HIDDEN_NAME)


class PutUsersHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            for arg in (param.args or []):
                if arg is None:
                    continue
                if hasattr(arg, "size"):
                    for i in range(arg.size()):
                        try:
                            p._apply_user_mod(arg.get(i))
                        except Exception:
                            pass
                elif hasattr(arg, "first_name") or hasattr(arg, "id"):
                    p._apply_user_mod(arg)
        except Exception:
            pass


class FragmentBlockHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            mn = param.method.getName()
            if mn in ("showPinnedBar", "updatePinnedMessage"):
                for arg in (param.args or []):
                    uid = _extract_uid_any(arg)
                    if uid:
                        info = p._banned_cache.get(uid)
                        if info and info.get("block_type") == BLOCK_FULL:
                            param.setResult(None)
                            return
                return
            for arg in (param.args or []):
                uid = self._uid_frag(arg)
                if uid:
                    info = p._banned_cache.get(uid)
                    if info and info.get("block_type") == BLOCK_FULL:
                        param.setResult(None)
                        p._toast("Пользователь скрыт")
                        return
        except Exception:
            pass

    def _uid_frag(self, obj):
        if obj is None:
            return None
        try:
            cn = obj.getClass().getName()
            if "ProfileActivity" not in cn and "ChatActivity" not in cn:
                return None
        except Exception:
            return None
        try:
            args = obj.getArguments()
            if args is not None:
                for key in ("user_id", "dialog_id", "uid"):
                    try:
                        uid = int(args.getLong(key))
                        if uid > 0:
                            return uid
                    except Exception:
                        pass
        except Exception:
            pass
        return None


class NoDisturbPlugin(BasePlugin):

    def on_plugin_load(self):
        self._banned_cache = self._load_banned()
        self._enabled = bool(self.get_setting("enabled", True))
        self._xposed_hooks = []
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.PROFILE_ACTION_MENU,
            text="NoDisturb", on_click=self._on_profile_click,
            icon="msg_block", subtext="Скрыть профиль", priority=5))
        self.add_hook("TL_updateNewMessage")
        self.add_hook("TL_updateNewChannelMessage")
        self._install_hooks()
        self._patch_cached_users()
        self.log(f"[NoDisturb] готов. Скрыто: {len(self._banned_cache)}")

    def on_plugin_unload(self):
        self.log("[NoDisturb] выгружен.")

    def _toast(self, msg):
        run_on_ui_thread(lambda: BulletinHelper.show_error(msg))

    def _apply_user_mod(self, user):
        if user is None:
            return
        uid = getattr(user, "id", None)
        if not uid:
            return
        info = self._banned_cache.get(int(uid))
        if not info:
            return
        bt = info.get("block_type")
        try:
            if bt in (BLOCK_FULL, BLOCK_NAME):
                user.first_name = HIDDEN_NAME
                user.last_name = ""
                user.username = None
            if bt in (BLOCK_FULL, BLOCK_AVATAR):
                user.photo = None
        except Exception:
            pass

    def _patch_cached_users(self):
        if not self._banned_cache:
            return

        def do():
            try:
                mc = get_messages_controller()
                for uid in list(self._banned_cache.keys()):
                    try:
                        u = mc.getUser(uid)
                        if u is not None:
                            self._apply_user_mod(u)
                    except Exception:
                        pass
                if NotificationCenter is not None:
                    nc = NotificationCenter.getInstance(0)
                    nc.postNotificationName(NotificationCenter.dialogsNeedReload)
            except Exception:
                pass
        run_on_ui_thread(do)

    def _load_banned(self):
        try:
            raw = json.loads(self.get_setting(BANNED_KEY, "{}"))
            out = {}
            for k, v in raw.items():
                uid = int(k)
                if isinstance(v, dict):
                    out[uid] = {"name": v.get("name") or f"id{uid}",
                                "block_type": v.get("block_type") or BLOCK_FULL,
                                "usernames": v.get("usernames") or []}
                else:
                    out[uid] = {"name": str(v), "block_type": BLOCK_FULL,
                                "usernames": []}
            return out
        except Exception:
            return {}

    def _save_banned(self):
        self.set_setting(BANNED_KEY,
                         json.dumps({str(k): v for k, v in self._banned_cache.items()},
                                    ensure_ascii=False),
                         reload_settings=True)

    def is_banned(self, uid):
        return uid in self._banned_cache

    def get_block_type(self, uid):
        info = self._banned_cache.get(uid)
        return info.get("block_type", BLOCK_NONE) if info else BLOCK_NONE

    def ban_user(self, uid, name, usernames, bt):
        self._banned_cache[uid] = {"name": name, "block_type": bt,
                                   "usernames": usernames}
        self._save_banned()
        self._patch_cached_users()
        self.log(f"[NoDisturb] {name} → {_bt_label(bt)}")

    def set_block_type(self, uid, bt):
        if uid in self._banned_cache:
            self._banned_cache[uid]["block_type"] = bt
            self._save_banned()
            self._patch_cached_users()

    def unban_user(self, uid):
        self._banned_cache.pop(uid, None)
        self._save_banned()
        self._patch_cached_users()

    def _install_hooks(self):
        try:
            cls = find_class("org.telegram.messenger.NotificationCenter")
            if cls:
                r = self.hook_all_methods(cls, "postNotificationName", NotifyHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.ui.Cells.ChatMessageCell")
            if cls:
                r = self.hook_all_methods(cls, "setMessageObject", CellHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.messenger.MessagesController")
            if cls:
                r = self.hook_all_methods(cls, "putUsers", PutUsersHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.messenger.UserObject")
            if cls:
                r = self.hook_all_methods(cls, "getUserName", UserNameHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.ui.ActionBar.ActionBarLayout")
            if cls:
                r = self.hook_all_methods(cls, "presentFragment", FragmentBlockHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.ui.ChatActivity")
            if cls:
                hook = FragmentBlockHook(self)
                for name in ("showPinnedBar", "updatePinnedMessage"):
                    try:
                        r = self.hook_all_methods(cls, name, hook)
                        if r:
                            self._xposed_hooks.extend(r)
                    except Exception:
                        pass
        except Exception:
            pass

    def on_update_hook(self, update_name, account, update):
        if not self._enabled or not self._banned_cache:
            return HookResult()
        if update_name not in ("TL_updateNewMessage", "TL_updateNewChannelMessage"):
            return HookResult()
        try:
            msg = getattr(update, "message", None)
            if msg is None:
                return HookResult()
            uid = _extract_uid_any(msg)
            if uid:
                info = self._banned_cache.get(uid)
                if info and info.get("block_type") == BLOCK_FULL:
                    return HookResult(strategy=HookStrategy.CANCEL)
        except Exception:
            pass
        return HookResult()

    def _on_profile_click(self, context):
        user = context.get("user")
        if user is None:
            BulletinHelper.show_error("Не удалось получить данные пользователя")
            return
        uid = int(getattr(user, "id", 0) or 0)
        if not uid:
            BulletinHelper.show_error("Не удалось получить ID")
            return
        name = _user_title(user, f"id{uid}")
        usernames = _extract_usernames(user)
        if self.is_banned(uid):
            self._show_actions(uid, name)
        else:
            self._show_add(uid, name, usernames)

    def _show_add(self, uid, name, usernames):
        def do():
            act = self._activity()
            if not act:
                return
            b = AlertDialogBuilder(act)
            b.set_title("NoDisturb: " + name)
            b.set_message("Выберите действие:")
            b.set_items(
                ["Полное скрытие", "Скрыть имя", "Скрыть аватарку"],
                lambda bld, which: self._on_add_pick(bld, uid, name, usernames, which),
            )
            b.show()
        run_on_ui_thread(do)

    def _on_add_pick(self, bld, uid, name, usernames, which):
        bld.dismiss()
        if which == 0:
            self.ban_user(uid, name, usernames, BLOCK_FULL)
            BulletinHelper.show_success(f"{name}: полное скрытие")
        elif which == 1:
            self.ban_user(uid, name, usernames, BLOCK_NAME)
            BulletinHelper.show_success(f"{name}: имя скрыто")
        elif which == 2:
            self.ban_user(uid, name, usernames, BLOCK_AVATAR)
            BulletinHelper.show_success(f"{name}: аватарка скрыта")

    def _show_actions(self, uid, name):
        def do():
            act = self._activity()
            if not act:
                return
            bt = self.get_block_type(uid)
            b = AlertDialogBuilder(act)
            b.set_title("NoDisturb: " + name)
            b.set_message(f"Текущий режим: {_bt_label(bt)}\n\nВыберите действие:")
            b.set_items(
                ["Полное скрытие", "Скрыть имя", "Скрыть аватарку", "Снять бан"],
                lambda bld, which: self._on_action_pick(bld, uid, name, which),
            )
            b.show()
        run_on_ui_thread(do)

    def _on_action_pick(self, bld, uid, name, which):
        bld.dismiss()
        if which == 0:
            self.set_block_type(uid, BLOCK_FULL)
            BulletinHelper.show_success(f"{name}: полное скрытие")
        elif which == 1:
            self.set_block_type(uid, BLOCK_NAME)
            BulletinHelper.show_success(f"{name}: имя скрыто")
        elif which == 2:
            self.set_block_type(uid, BLOCK_AVATAR)
            BulletinHelper.show_success(f"{name}: аватарка скрыта")
        elif which == 3:
            self.unban_user(uid)
            BulletinHelper.show_success(f"{name}: бан снят")

    def _activity(self):
        try:
            frag = get_last_fragment()
            if frag:
                return frag.getParentActivity()
        except Exception:
            pass
        return None

    def create_settings(self):
        banned = self._banned_cache
        rows = [
            Header(text="Основные"),
            Switch(key="enabled", text="Включить NoDisturb", default=True,
                   icon="msg_block",
                   on_change=lambda v: setattr(self, "_enabled", bool(v))),
            Divider(),
            Header(text=f"Скрытые профили ({len(banned)})"),
        ]
        if not banned:
            rows.append(Text(text="Список пуст",
                             subtext="Откройте профиль → «NoDisturb»",
                             icon="msg_info"))
        else:
            for uid, info in sorted(banned.items(),
                                     key=lambda x: x[1].get("name", "").lower()):
                n = info.get("name", f"id{uid}")
                bt = info.get("block_type", BLOCK_FULL)
                unames = info.get("usernames", []) or []
                sub = f"ID: {uid} • {_bt_label(bt)}"
                if unames:
                    sub += " • @" + ", @".join(unames[:2])
                rows.append(Text(
                    text=n,
                    subtext=sub + " • нажмите для действий",
                    icon="msg_block",
                    red=True,
                    on_click=lambda _v, _u=uid, _n=n:
                        self._show_actions(int(_u), _n),
                ))
        rows += [
            Divider(),
            Text(text="Очистить всё",
                 subtext="Снять блокировки со всех профилей",
                 icon="msg_clear_history",
                 red=True,
                 on_click=self._settings_clear),
        ]
        return rows

    def _settings_clear(self, _v=None):
        if not self._banned_cache:
            BulletinHelper.show_info("Список уже пуст")
            return

        def do():
            act = self._activity()
            if not act:
                return
            b = AlertDialogBuilder(act)
            b.set_title("Очистить список?")
            b.set_message("Все блокировки будут сняты.")

            def ok(bld, _):
                n = len(self._banned_cache)
                self._banned_cache.clear()
                self._save_banned()
                bld.dismiss()
                BulletinHelper.show_success(f"Снято блокировок: {n}")

            b.set_positive_button("Очистить", ok)
            b.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
            b.set_negative_button("Отмена", lambda x, _: x.dismiss())
            b.show()
        run_on_ui_thread(do)