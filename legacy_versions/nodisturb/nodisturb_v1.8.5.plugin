try:
    from org.telegram.messenger import NotificationCenter
except Exception:
    NotificationCenter = None

try:
    from org.telegram.tgnet import TLRPC
except Exception:
    TLRPC = None

try:
    from org.telegram.tgnet.tl import TLRPC as TLRPC_NEW
except Exception:
    TLRPC_NEW = None

__id__ = "nodisturb"
__name__ = "NoDisturb"
__description__ = (
    "Ru:\n"
    "Плагин скрывает профили, сообщения и онлайн-статус выбранных пользователей в Telegram.\n"
    "Автор идеи: @WneDom\n\n" 
    "En:\n"
    "The plugin hides profiles, messages, and online status of selected users in Telegram.\n"
    "Idea by: @WneDom"
)
__author__ = "@cobra_S0FT & @excess_plugins"
__version__ = "1.8.5"
__icon__ = "alegquin33/81"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

BLOCK_FULL, BLOCK_NAME, BLOCK_AVATAR, BLOCK_NONE = "full", "name", "avatar", "none"
HIDDEN_NAME = "Unknown Name"
HIDDEN_STATUS = "Был(а) давно"
BANNED_KEY = "nodisturb_banned_v3"
ADD_INPUT_KEY = "add_target_input"
BLOCK_CHAT_KEY = "block_chat"

VIEW_VISIBLE, VIEW_GONE = 0, 8
LP_MATCH_PARENT, LP_WRAP_CONTENT = -1, -2


def _bt_label(bt):
    return {BLOCK_FULL: "Полное скрытие", BLOCK_NAME: "Скрыть имя",
            BLOCK_AVATAR: "Скрыть аватарку"}.get(bt, "Неизвестно")


def _TL(name):
    for mod in (TLRPC, TLRPC_NEW):
        if mod is None:
            continue
        c = getattr(mod, name, None)
        if c is not None:
            return c
    key = name.replace("TL_", "").lower()
    for mod in (TLRPC, TLRPC_NEW):
        if mod is None:
            continue
        try:
            for dn in dir(mod):
                if key in dn.lower():
                    return getattr(mod, dn)
        except Exception:
            pass
    return None


def _offline_status():
    cls = _TL("TL_userStatusOffline")
    if cls is None:
        return None
    try:
        st = cls()
        st.expires = 0
        return st
    except Exception:
        return None


def _valid_uid(uid):
    try:
        uid = int(uid)
    except Exception:
        return 0
    return uid if 0 < uid < 2**63 else 0


def _is_outgoing(obj):
    if obj is None:
        return False
    try:
        if obj.isOut():
            return True
    except Exception:
        pass
    try:
        if bool(getattr(obj, "out", False)):
            return True
    except Exception:
        pass
    try:
        owner = getattr(obj, "messageOwner", None)
        if owner is not None and bool(getattr(owner, "out", False)):
            return True
    except Exception:
        pass
    return False


def _extract_uid_any(obj):
    if obj is None:
        return None
    try:
        owner = getattr(obj, "messageOwner", None) or obj
        from_id = getattr(owner, "from_id", None)
        if from_id is not None:
            for attr in ("user_id", "channel_id", "chat_id"):
                v = getattr(from_id, attr, None)
                if v and int(v) > 0:
                    return int(v)
    except Exception:
        pass
    try:
        get_from_id = getattr(obj, "getFromId", None)
        if get_from_id:
            fid = get_from_id()
            if fid and int(fid) > 0:
                return int(fid)
    except Exception:
        pass
    return None


def _extract_usernames(user):
    try:
        u = (getattr(user, "username", "") or "").strip().lower()
        return [u] if u else []
    except Exception:
        return []


def _user_title(user, fallback="Пользователь"):
    try:
        full = ((getattr(user, "first_name", "") or "") + " " +
                (getattr(user, "last_name", "") or "")).strip()
        if full:
            return full
        un = (getattr(user, "username", "") or "").strip()
        if un:
            return "@" + un
    except Exception:
        pass
    return fallback


def _parse_target_id(raw: str) -> int:
    if not raw:
        return 0
    raw = raw.strip()
    m = re.search(r"(?i)tg://user\?id=(\d+)", raw)
    if m:
        return _valid_uid(m.group(1))
    m = re.search(r"(?i)t\.me/user\?id=(\d+)", raw)
    if m:
        return _valid_uid(m.group(1))
    if raw.isdigit():
        return _valid_uid(raw)
    return 0


class NotifyHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if not p._enabled or not p._banned_cache:
            return
        try:
            args = param.args
            if not args or len(args) < 4:
                return
            if args[0] != NotificationCenter.pushReceived:
                return
            msg_obj = args[3]
            if msg_obj is None:
                return
            if _is_outgoing(msg_obj):
                return
            uid = _extract_uid_any(msg_obj)
            if not uid:
                return
            info = p._banned_cache.get(uid)
            if info and info.get("block_type") == BLOCK_FULL:
                param.setResult(None)
        except Exception:
            pass


class CellHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            msg = param.args[0] if param.args else None
            if msg is None:
                msg = get_private_field(param.thisObject, "currentMessageObject")
            if msg is None:
                return
            cell = param.thisObject

            if _is_outgoing(msg):
                self._restore(cell)
                return

            uid = _extract_uid_any(msg)
            info = p._banned_cache.get(uid) if uid is not None else None

            if not info or info.get("block_type") != BLOCK_FULL:
                self._restore(cell)
                return

            try:
                cell.setAlpha(0.0)
            except Exception:
                pass
            cell.setVisibility(VIEW_GONE)
            lp = cell.getLayoutParams()
            if lp is not None:
                lp.height = 0
                lp.width = 0
                cell.setLayoutParams(lp)
        except Exception:
            pass

    def _restore(self, cell):
        try:
            lp = cell.getLayoutParams()
            hidden = (cell.getVisibility() == VIEW_GONE
                      or cell.getAlpha() == 0.0
                      or (lp is not None and (lp.height == 0 or lp.width == 0)))
            if hidden:
                cell.setAlpha(1.0)
                cell.setVisibility(VIEW_VISIBLE)
                if lp is not None:
                    lp.height = LP_WRAP_CONTENT
                    lp.width = LP_MATCH_PARENT
                    cell.setLayoutParams(lp)
        except Exception:
            pass


class UserNameHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            arg = param.args[0]
        except Exception:
            return
        if arg is None:
            return
        uid = arg if isinstance(arg, int) else getattr(arg, "id", None)
        if not uid:
            return
        info = p._banned_cache.get(int(uid))
        if info and info.get("block_type") in (BLOCK_FULL, BLOCK_NAME):
            param.setResult(HIDDEN_NAME)


class LastSeenHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._hide_online or not p._banned_cache:
            return
        try:
            arg = param.args[0]
        except Exception:
            return
        if arg is None:
            return
        uid = getattr(arg, "id", None)
        if uid and int(uid) in p._banned_cache:
            param.setResult(HIDDEN_STATUS)


class PutUsersHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            for arg in (param.args or []):
                if arg is None:
                    continue
                if hasattr(arg, "size"):
                    for i in range(arg.size()):
                        try:
                            p._apply_user_mod(arg.get(i))
                        except Exception:
                            pass
                elif hasattr(arg, "first_name") or hasattr(arg, "id"):
                    p._apply_user_mod(arg)
        except Exception:
            pass


class FragmentBlockHook(MethodHook):
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        p = self.p
        if not p._enabled or not p._banned_cache:
            return
        try:
            mn = param.method.getName()
            if mn in ("showPinnedBar", "updatePinnedMessage"):
                for arg in (param.args or []):
                    if _is_outgoing(arg):
                        continue
                    uid = _extract_uid_any(arg)
                    if uid:
                        info = p._banned_cache.get(uid)
                        if info and info.get("block_type") == BLOCK_FULL:
                            param.setResult(None)
                            return
                return
            if p._block_chat:
                for arg in (param.args or []):
                    uid = self._uid_frag(arg)
                    if uid:
                        info = p._banned_cache.get(uid)
                        if info:
                            p._toast("Чат недоступен")
                            param.setResult(None)
                            return
        except Exception:
            pass

    def _uid_frag(self, obj):
        if obj is None:
            return None
        try:
            cn = obj.getClass().getName()
            if "ProfileActivity" not in cn and "ChatActivity" not in cn:
                return None
        except Exception:
            return None
        try:
            args = obj.getArguments()
            if args is not None:
                for key in ("user_id", "uid"):
                    try:
                        uid = int(args.getLong(key))
                        if uid > 0:
                            return uid
                    except Exception:
                        pass
        except Exception:
            pass
        return None


class NoDisturbPlugin(BasePlugin):

    def on_plugin_load(self):
        self._banned_cache = self._load_banned()
        self._enabled = bool(self.get_setting("enabled", True))
        self._hide_online = bool(self.get_setting("hide_online", True))
        self._block_chat = bool(self.get_setting(BLOCK_CHAT_KEY, True))
        self._my_id = self._detect_my_id()
        self._xposed_hooks = []
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.PROFILE_ACTION_MENU,
            text="NoDisturb", on_click=self._on_profile_click,
            icon="msg_block", subtext="Скрыть профиль", priority=5))
        self.add_hook("TL_updateNewMessage")
        self.add_hook("TL_updateNewChannelMessage")
        self.add_hook("TL_updateUserStatus")
        self.add_hook("Typing", match_substring=True)
        self._install_hooks()
        self._patch_cached_users()
        self.log(f"[NoDisturb] готов. Скрыто: {len(self._banned_cache)}, my_id={self._my_id}")

    def on_plugin_unload(self):
        self.log("[NoDisturb] выгружен.")

    def _detect_my_id(self):
        try:
            u = get_user_config().getCurrentUser()
            return int(u.id) if u else 0
        except Exception:
            return 0

    def _is_chat_or_channel(self, user):
        if user is None:
            return False
        try:
            uid = int(getattr(user, "id", 0) or 0)
            if uid < 0:
                return True
        except Exception:
            pass
        try:
            if getattr(user, "broadcast", False):
                return True
            if getattr(user, "megagroup", False):
                return True
            if getattr(user, "gigagroup", False):
                return True
        except Exception:
            pass
        return False

    def _toast(self, msg):
        run_on_ui_thread(lambda: BulletinHelper.show_error(msg))

    def _notify_user_status(self, uid, user):
        if NotificationCenter is None:
            return
        try:
            nc = NotificationCenter.getInstance(0)
            nc.postNotificationName(
                NotificationCenter.updateUserStatus, int(uid), user, False)
        except Exception:
            pass

    def _apply_user_mod(self, user):
        if user is None:
            return
        uid = _valid_uid(getattr(user, "id", 0))
        if not uid:
            return
        if uid == self._my_id:
            return
        info = self._banned_cache.get(uid)
        if not info:
            return
        bt = info.get("block_type")
        try:
            if bt in (BLOCK_FULL, BLOCK_NAME):
                user.first_name = HIDDEN_NAME
                user.last_name = ""
                user.username = None
            if bt in (BLOCK_FULL, BLOCK_AVATAR):
                user.photo = None
            if self._hide_online:
                st = _offline_status()
                if st is not None:
                    user.status = st
        except Exception:
            pass

    def _patch_cached_users(self):
        if not self._banned_cache:
            return

        def do():
            try:
                mc = get_messages_controller()
                for uid in list(self._banned_cache.keys()):
                    try:
                        u = mc.getUser(uid)
                        if u is not None:
                            self._apply_user_mod(u)
                            self._notify_user_status(uid, u)
                    except Exception:
                        pass
                if NotificationCenter is not None:
                    nc = NotificationCenter.getInstance(0)
                    nc.postNotificationName(NotificationCenter.dialogsNeedReload)
            except Exception:
                pass
        run_on_ui_thread(do)

    def _load_banned(self):
        try:
            raw = json.loads(self.get_setting(BANNED_KEY, "{}"))
            out = {}
            for k, v in raw.items():
                uid = _valid_uid(k)
                if not uid:
                    continue
                if isinstance(v, dict):
                    out[uid] = {"name": v.get("name") or f"id{uid}",
                                "block_type": v.get("block_type") or BLOCK_FULL,
                                "usernames": v.get("usernames") or []}
                else:
                    out[uid] = {"name": str(v), "block_type": BLOCK_FULL,
                                "usernames": []}
            return out
        except Exception:
            return {}

    def _save_banned(self):
        self.set_setting(BANNED_KEY,
                         json.dumps({str(k): v for k, v in self._banned_cache.items()},
                                    ensure_ascii=False),
                         reload_settings=True)

    def is_banned(self, uid):
        return uid in self._banned_cache

    def get_block_type(self, uid):
        info = self._banned_cache.get(uid)
        return info.get("block_type", BLOCK_NONE) if info else BLOCK_NONE

    def ban_user(self, uid, name, usernames, bt):
        uid = _valid_uid(uid)
        if not uid:
            return
        if self._my_id and uid == self._my_id:
            BulletinHelper.show_error("Нельзя забанить самого себя")
            return
        if uid < 0:
            BulletinHelper.show_error("Нельзя забанить чат или канал")
            return
        self._banned_cache[uid] = {"name": name, "block_type": bt,
                                   "usernames": usernames}
        self._save_banned()
        self._patch_cached_users()
        self.log(f"[NoDisturb] {name} → {_bt_label(bt)}")

    def set_block_type(self, uid, bt):
        if uid in self._banned_cache:
            self._banned_cache[uid]["block_type"] = bt
            self._save_banned()
            self._patch_cached_users()

    def unban_user(self, uid):
        self._banned_cache.pop(uid, None)
        self._save_banned()
        self._patch_cached_users()

    def _quick_add_from_input(self, value: str):
        uid = _parse_target_id(value)
        if not uid:
            BulletinHelper.show_error("Введите корректный Telegram ID")
            return
        if self._my_id and uid == self._my_id:
            BulletinHelper.show_error("Нельзя забанить самого себя")
            return
        if uid < 0:
            BulletinHelper.show_error("Нельзя забанить чат или канал")
            return
        name = f"id{uid}"
        try:
            mc = get_messages_controller()
            u = mc.getUser(uid)
            if u is not None:
                name = _user_title(u, name)
        except Exception:
            pass
        self.ban_user(uid, name, [], BLOCK_FULL)
        BulletinHelper.show_success(f"{name} добавлен в бан")
        self.set_setting(ADD_INPUT_KEY, "", reload_settings=True)

    def _install_hooks(self):
        try:
            cls = find_class("org.telegram.messenger.NotificationCenter")
            if cls:
                r = self.hook_all_methods(cls, "postNotificationName", NotifyHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.ui.Cells.ChatMessageCell")
            if cls:
                r = self.hook_all_methods(cls, "setMessageObject", CellHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.messenger.MessagesController")
            if cls:
                r = self.hook_all_methods(cls, "putUsers", PutUsersHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.messenger.UserObject")
            if cls:
                r = self.hook_all_methods(cls, "getUserName", UserNameHook(self))
                if r:
                    self._xposed_hooks.extend(r)
                r = self.hook_all_methods(cls, "getLastSeenString", LastSeenHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.ui.ActionBar.ActionBarLayout")
            if cls:
                r = self.hook_all_methods(cls, "presentFragment", FragmentBlockHook(self))
                if r:
                    self._xposed_hooks.extend(r)
        except Exception:
            pass
        try:
            cls = find_class("org.telegram.ui.ChatActivity")
            if cls:
                hook = FragmentBlockHook(self)
                for name in ("showPinnedBar", "updatePinnedMessage"):
                    try:
                        r = self.hook_all_methods(cls, name, hook)
                        if r:
                            self._xposed_hooks.extend(r)
                    except Exception:
                        pass
        except Exception:
            pass

    def on_update_hook(self, update_name, account, update):
        if not self._enabled or not self._banned_cache:
            return HookResult()

        if "typing" in update_name.lower():
            uid = 0
            try:
                uid = int(getattr(update, "user_id", 0) or 0)
            except Exception:
                uid = 0
            if not uid:
                try:
                    fid = getattr(update, "from_id", None)
                    if fid is not None:
                        uid = int(getattr(fid, "user_id", 0) or 0)
                except Exception:
                    uid = 0
            if uid and uid in self._banned_cache:
                return HookResult(strategy=HookStrategy.CANCEL)
            return HookResult()

        if update_name == "TL_updateUserStatus":
            if not self._hide_online:
                return HookResult()
            try:
                uid = int(getattr(update, "user_id", 0) or 0)
            except Exception:
                uid = 0
            if not uid or uid not in self._banned_cache:
                return HookResult()
            st = _offline_status()
            if st is not None:
                try:
                    update.status = st
                    return HookResult(strategy=HookStrategy.MODIFY, update=update)
                except Exception:
                    pass
            return HookResult(strategy=HookStrategy.CANCEL)

        if update_name not in ("TL_updateNewMessage", "TL_updateNewChannelMessage"):
            return HookResult()
        try:
            msg = getattr(update, "message", None)
            if msg is None:
                return HookResult()
            if _is_outgoing(msg):
                return HookResult()
            uid = _extract_uid_any(msg)
            if uid:
                info = self._banned_cache.get(uid)
                if info and info.get("block_type") == BLOCK_FULL:
                    return HookResult(strategy=HookStrategy.CANCEL)
        except Exception:
            pass
        return HookResult()

    def _on_profile_click(self, context):
        for chat_key in ("chat", "chatId", "chatFull", "encryptedChat"):
            if context.get(chat_key) is not None:
                BulletinHelper.show_error("Нельзя забанить чат или канал")
                return
        
        user = context.get("user")
        if user is None:
            BulletinHelper.show_error("Не удалось получить данные пользователя")
            return
        
        uid = _valid_uid(getattr(user, "id", 0))
        if not uid:
            BulletinHelper.show_error("Не удалось получить ID")
            return
        
        if self._is_chat_or_channel(user):
            BulletinHelper.show_error("Нельзя забанить чат или канал")
            return
        
        if self._my_id and uid == self._my_id:
            BulletinHelper.show_error("Нельзя забанить самого себя")
            return
        name = _user_title(user, f"id{uid}")
        usernames = _extract_usernames(user)
        if self.is_banned(uid):
            self._show_actions(uid, name)
        else:
            self._show_add(uid, name, usernames)

    def _show_add(self, uid, name, usernames):
        def do():
            act = self._activity()
            if not act:
                return
            b = AlertDialogBuilder(act)
            b.set_title("NoDisturb: " + name)
            b.set_message("Выберите действие:")
            b.set_items(
                ["🚫 Полное скрытие", "❗Скрыть имя", "❗Скрыть аватарку"],
                lambda bld, which: self._on_add_pick(bld, uid, name, usernames, which),
            )
            b.show()
        run_on_ui_thread(do)

    def _on_add_pick(self, bld, uid, name, usernames, which):
        bld.dismiss()
        if which == 0:
            self.ban_user(uid, name, usernames, BLOCK_FULL)
            BulletinHelper.show_success(f"{name}: полное скрытие")
        elif which == 1:
            self.ban_user(uid, name, usernames, BLOCK_NAME)
            BulletinHelper.show_success(f"{name}: имя скрыто")
        elif which == 2:
            self.ban_user(uid, name, usernames, BLOCK_AVATAR)
            BulletinHelper.show_success(f"{name}: аватарка скрыта")

    def _show_actions(self, uid, name):
        def do():
            act = self._activity()
            if not act:
                return
            bt = self.get_block_type(uid)
            b = AlertDialogBuilder(act)
            b.set_title("NoDisturb: " + name)
            b.set_message(f"Текущий режим: {_bt_label(bt)}\n\nВыберите действие:")
            b.set_items(
                ["🚫 Полное скрытие", "❗Скрыть имя", "❗Скрыть аватарку", "⚠️ Снять бан"],
                lambda bld, which: self._on_action_pick(bld, uid, name, which),
            )
            b.show()
        run_on_ui_thread(do)

    def _on_action_pick(self, bld, uid, name, which):
        bld.dismiss()
        if which == 0:
            self.set_block_type(uid, BLOCK_FULL)
            BulletinHelper.show_success(f"{name}: полное скрытие")
        elif which == 1:
            self.set_block_type(uid, BLOCK_NAME)
            BulletinHelper.show_success(f"{name}: имя скрыто")
        elif which == 2:
            self.set_block_type(uid, BLOCK_AVATAR)
            BulletinHelper.show_success(f"{name}: аватарка скрыта")
        elif which == 3:
            self.unban_user(uid)
            BulletinHelper.show_success(f"{name}: бан снят")

    def _activity(self):
        try:
            frag = get_last_fragment()
            if frag:
                return frag.getParentActivity()
        except Exception:
            pass
        return None

    def create_settings(self):
        banned = self._banned_cache
        rows = [
            Header(text="Основные"),
            Switch(key="enabled", text="Включить NoDisturb", default=True,
                   icon="msg_block",
                   on_change=lambda v: setattr(self, "_enabled", bool(v))),
            Switch(key="hide_online", text="Скрывать онлайн цели", default=True,
                   subtext="Цель всегда «Был(а) давно»",
                   icon="msg_stealth_locked",
                   on_change=lambda v: setattr(self, "_hide_online", bool(v))),
            Switch(key=BLOCK_CHAT_KEY, text="Запрет на открытие чата", default=True,
                   subtext="Запрещает открывать профиль/чат цели",
                   icon="msg_filled_blocked",
                   on_change=lambda v: setattr(self, "_block_chat", bool(v))),
            Divider(),
            Header(text="Добавление"),
            Input(key=ADD_INPUT_KEY,
                  text="Добавление по ID",
                  default="",
                  icon="msg_add",
                  on_change=self._quick_add_from_input),
            Divider(),
            Header(text=f"Скрытые профили ({len(banned)})"),
        ]
        if not banned:
            rows.append(Text(text="Список пуст",
                             subtext="Профиль ➜ 3 точки ➜ NoDisturb",
                             icon="msg_info"))
        else:
            for uid, info in sorted(banned.items(),
                                     key=lambda x: x[1].get("name", "").lower()):
                n = info.get("name", f"id{uid}")
                bt = info.get("block_type", BLOCK_FULL)
                unames = info.get("usernames", []) or []
                sub = f"ID: {uid} • {_bt_label(bt)}"
                if unames:
                    sub += " • @" + ", @".join(unames[:2])
                rows.append(Text(
                    text=n,
                    subtext=sub + " • нажмите для действий",
                    icon="msg_block",
                    red=True,
                    on_click=lambda _v, _u=uid, _n=n:
                        self._show_actions(int(_u), _n),
                ))
        rows += [
            Divider(),
            Text(text="Очистить всё",
                 subtext="Снять блокировки со всех профилей",
                 icon="msg_clear_history",
                 red=True,
                 on_click=self._settings_clear),
        ]
        return rows

    def _settings_clear(self, _v=None):
        if not self._banned_cache:
            BulletinHelper.show_info("Список уже пуст")
            return

        def do():
            act = self._activity()
            if not act:
                return
            b = AlertDialogBuilder(act)
            b.set_title("Очистить список?")
            b.set_message("Все блокировки будут сняты.")

            def ok(bld, _):
                n = len(self._banned_cache)
                self._banned_cache.clear()
                self._save_banned()
                bld.dismiss()
                BulletinHelper.show_success(f"Снято блокировок: {n}")

            b.set_positive_button("Очистить", ok)
            b.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
            b.set_negative_button("Отмена", lambda x, _: x.dismiss())
            b.show()
        run_on_ui_thread(do)