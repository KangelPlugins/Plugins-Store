    "min_rating_x10": R_RATE[3],
    "min_reviews_n": R_REVIEWS[3],
    "hide_ads": True,
    "mark_ads": True,
    "require_price": True,
    "net_timeout": R_TIMEOUT[3],
    "net_tries": R_TRIES[3],
    "cache_min": R_CACHE[3],
    "warm_up": True,
    "ua_mode": 0,
    "ua_custom": "",
