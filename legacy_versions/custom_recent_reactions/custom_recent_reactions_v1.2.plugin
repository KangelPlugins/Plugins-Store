__id__ = "custom_recent_reactions"
__name__ = "Custom Recent Reactions"
__description__ = "Replace the recent reactions in the message reaction panel with your own set."
__author__ = "@itNotMax - @MaxExteraPlugins"
__version__ = "1.2"
__icon__ = "MaxExteraPluginsStickers/25"
__min_version__ = "12.1.1"
__app_version__ = ">=12.1.1"
__sdk_version__ = ">=1.4.3.3"

DEFAULT_EMOJI = "\U0001F44D \U0001F44E \u2764 \U0001F525 \U0001F973 \U0001F631 \U0001F622"
PREFS_NAME = "custom_recent_reactions_prefs"

_vr_emoji = None
_vr_custom = None
_available_cache = [None, 0.0]
_packs_meta_cache = [None, 0.0]
_pack_docs_cache = {}

import time as _time


def _to_py_int(v):
    if isinstance(v, int):
        return v
    try:
        return int(v)
    except Exception:
        try:
            return int(v.longValue())
        except Exception:
            return int(str(v))


def _identity_hash(obj):
    try:
        from java.lang import System
        return int(System.identityHashCode(obj))
    except Exception:
        return 0


def _safe_bool(obj, name):
    try:
        return bool(getattr(obj, name))
    except Exception:
        return False


def _log_err(plugin_ref, tag):
    try:
        plugin_ref.log(tag + ": " + traceback.format_exc())
    except Exception:
        try:
            import sys
            sys.stderr.write(tag + ": " + traceback.format_exc() + "\n")
        except Exception:
            pass


def _prefs():
    return ApplicationLoader.applicationContext.getSharedPreferences(PREFS_NAME, 0)


def _save_reactions(items):
    try:
        _prefs().edit().putString("reactions", json.dumps(items)).apply()
    except Exception:
        pass


def _save_enabled(value):
    try:
        _prefs().edit().putBoolean("enabled", bool(value)).apply()
    except Exception:
        pass


def _load_reactions():
    try:
        raw = _prefs().getString("reactions", None)
        if not raw:
            return list(DEFAULT_EMOJI.split())
        items = json.loads(raw)
        if isinstance(items, list):
            return [str(x) for x in items]
    except Exception:
        pass
    return list(DEFAULT_EMOJI.split())


def _get_available():
    now = _time.time()
    if _available_cache[0] is not None and now - _available_cache[1] < 60:
        return _available_cache[0]
    try:
        acc = UserConfig.selectedAccount
        rl = MediaDataController.getInstance(acc).getEnabledReactionsList()
        result = []
        if rl:
            for i in range(rl.size()):
                r = rl.get(i)
                if r and r.reaction:
                    result.append(str(r.reaction))
        _available_cache[0] = result
        _available_cache[1] = now
        return result
    except Exception:
        return []


def _get_emoji_packs_meta():
    now = _time.time()
    if _packs_meta_cache[0] is not None and now - _packs_meta_cache[1] < 120:
        return _packs_meta_cache[0]
    packs = []
    seen_ids = set()
    try:
        acc = UserConfig.selectedAccount
        mdc = MediaDataController.getInstance(acc)
        sets = mdc.getStickerSets(5)
        if sets and sets.size() > 0:
            for i in range(sets.size()):
                s = sets.get(i)
                if s and s.set and s.documents and s.documents.size() > 0:
                    if not s.set.emojis:
                        continue
                    set_id = _to_py_int(s.set.id)
                    if set_id in seen_ids:
                        continue
                    seen_ids.add(set_id)
                    title = str(s.set.title) if s.set.title else "Pack"
                    packs.append({"id": set_id, "title": title, "set": s})
        _packs_meta_cache[0] = packs
        _packs_meta_cache[1] = now
    except Exception:
        pass
    return packs


def _get_pack_docs(pack):
    set_id = pack["id"]
    if set_id in _pack_docs_cache:
        return _pack_docs_cache[set_id]
    docs = []
    try:
        s = pack["set"]
        if s and s.documents:
            for j in range(s.documents.size()):
                doc = s.documents.get(j)
                if doc:
                    docs.append(_to_py_int(doc.id))
    except Exception:
        pass
    _pack_docs_cache[set_id] = docs
    return docs


_std_emojis_cache = [None, 0.0]


def _get_standard_emojis():
    now = _time.time()
    if _std_emojis_cache[0] is not None and now - _std_emojis_cache[1] < 300:
        return _std_emojis_cache[0]
    out = []
    try:
        acc = UserConfig.selectedAccount
        mdc = MediaDataController.getInstance(acc)
        lst = mdc.getEnabledReactionsList()
        if lst:
            for i in range(lst.size()):
                try:
                    ar = lst.get(i)
                    if ar is not None and not bool(ar.premium):
                        e = str(ar.reaction)
                        if e and e not in out:
                            out.append(e)
                except Exception:
                    pass
    except Exception:
        pass
    _std_emojis_cache[0] = out
    _std_emojis_cache[1] = now
    return out


def _init_vr():
    global _vr_emoji, _vr_custom
    if _vr_emoji is not None and _vr_custom is not None:
        return True
    try:
        cls = JClass.forName(
            "org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble$VisibleReaction")
        _vr_emoji = cls.getDeclaredMethod("fromEmojicon", JClass.forName("java.lang.String"))
        _vr_emoji.setAccessible(True)
        _vr_custom = cls.getDeclaredMethod("fromCustomEmoji", JClass.forName("java.lang.Long"))
        _vr_custom.setAccessible(True)
        return True
    except Exception:
        return False


def _match_emoticon(user_input):
    available = _get_available()
    if user_input in available:
        return user_input
    stripped = user_input.replace("\ufe0f", "")
    for a in available:
        if a == stripped or a.replace("\ufe0f", "") == stripped:
            return a
    return user_input


def _build_reactions_list(plugin_ref=None):
    try:
        items = _load_reactions()
        if not items:
            return None
        if not _init_vr():
            return None
        from java.util import ArrayList as JAL
        new_list = JAL()
        seen = set()
        for item in items:
            item = str(item).strip()
            if not item:
                continue
            vr = None
            key = None
            if item.startswith("doc:"):
                try:
                    doc_id = int(item[4:].strip())
                    vr = _vr_custom.invoke(None, JLong(doc_id))
                    key = "d:" + str(doc_id)
                except Exception:
                    pass
            else:
                if item.startswith("e:"):
                    item = item[2:].strip()
                if item.endswith("\ufe0f"):
                    item = item[:-1]
                if not item:
                    continue
                matched = _match_emoticon(item)
                vr = _vr_emoji.invoke(None, matched)
                key = "e:" + matched
            if vr is not None and key not in seen:
                new_list.add(vr)
                seen.add(key)
        show_std = True
        if plugin_ref is not None:
            try:
                show_std = plugin_ref._is_show_standard()
            except Exception:
                pass
        if show_std:
            std = _get_standard_emojis()
            for se in std:
                try:
                    se = str(se).strip().replace("\ufe0f", "")
                    if not se:
                        continue
                    nk = "e:" + se
                    dup = False
                    for k in seen:
                        if k.startswith("e:") and k[2:].replace("\ufe0f", "") == se:
                            dup = True
                            break
                    if dup:
                        continue
                    matched = _match_emoticon(se)
                    if not matched:
                        continue
                    vr = _vr_emoji.invoke(None, matched)
                    if vr is not None:
                        new_list.add(vr)
                        seen.add(nk)
                except Exception:
                    pass
        if new_list.size() > 0:
            return new_list
    except Exception:
        pass
    return None


def dp(v):
    return AndroidUtilities.dp(v)


COLS = 7
CELL_SIZE = 50


def _make_tab_tv(ctx, text, active):
    tv = TextView(ctx)
    tv.setText(text)
    tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
    tv.setGravity(Gravity.CENTER)
    tv.setSingleLine(True)
    tv.setMinHeight(dp(40))
    tv.setPadding(dp(16), dp(8), dp(16), dp(8))
    if active:
        tv.setTypeface(Typeface.DEFAULT_BOLD)
        tv.setTextColor(-1)
        tv.setBackground(Theme.createRoundRectDrawable(
            Theme.getColor(Theme.key_featuredStickers_addButton), dp(20)))
    else:
        tv.setTypeface(Typeface.DEFAULT)
        tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        gd = GradientDrawable()
        gd.setColor(Theme.getColor(Theme.key_dialogBackground))
        gd.setCornerRadius(dp(20))
        gd.setStroke(dp(1), Theme.getColor(Theme.key_divider))
        tv.setBackground(gd)
    return tv


def _make_preview_item(ctx, item, acc, on_tap, on_remove):
    cell = FrameLayout(ctx)
    cell.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 16))
    try:
        if item.startswith("doc:"):
            try:
                doc_id = int(item[4:].strip())
                aed = None
                for cache_type in (4, 0):
                    try:
                        aed = AnimatedEmojiDrawable(cache_type, acc, doc_id)
                    except Exception:
                        aed = None
                    if aed is not None:
                        break
                if aed is not None:
                    img = BackupImageView(ctx)
                    img.setAnimatedEmojiDrawable(aed)
                    cell.addView(img, LayoutHelper.createFrame(24, 24, Gravity.CENTER))
                else:
                    tv = TextView(ctx)
                    tv.setText("\u2b50")
                    tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
                    tv.setGravity(Gravity.CENTER)
                    tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                    cell.addView(tv, LayoutHelper.createFrame(24, 24, Gravity.CENTER))
            except Exception:
                tv = TextView(ctx)
                tv.setText("\u2b50")
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
                tv.setGravity(Gravity.CENTER)
                tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                cell.addView(tv, LayoutHelper.createFrame(24, 24, Gravity.CENTER))
        else:
            emoji = item[2:] if item.startswith("e:") else item
            tv = TextView(ctx)
            tv.setText(emoji)
            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            tv.setGravity(Gravity.CENTER)
            tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            cell.addView(tv, LayoutHelper.createFrame(28, 28, Gravity.CENTER))
    except Exception:
        pass
    cell.setOnClickListener(OnClickListener(lambda v, it=item: on_tap(it)))
    cell.setOnLongClickListener(_PreviewLongPress(lambda: on_remove(item)))
    return cell


def _make_custom_emoji_cell(ctx, doc_id, acc, selected, on_tap):
    cell = FrameLayout(ctx)
    cell.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 18))
    if selected:
        cell.setBackground(Theme.createRoundRectDrawable(
            Theme.getColor(Theme.key_chat_inReactionButtonBackground), 18))
    aed = None
    try:
        aed = AnimatedEmojiDrawable(4, acc, doc_id)
    except Exception:
        aed = None
    if aed is None:
        try:
            aed = AnimatedEmojiDrawable(0, acc, doc_id)
        except Exception:
            aed = None
    badge = None
    if aed is not None:
        try:
            img = BackupImageView(ctx)
            img.setAnimatedEmojiDrawable(aed)
            cell.addView(img, LayoutHelper.createFrame(32, 32, Gravity.CENTER))
        except Exception:
            aed = None
    if aed is None:
        tv = TextView(ctx)
        tv.setText("\u2b50")
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 24)
        tv.setGravity(Gravity.CENTER)
        cell.addView(tv, LayoutHelper.createFrame(32, 32, Gravity.CENTER))
    if selected:
        badge = _make_badge(ctx)
        cell.addView(badge, LayoutHelper.createFrame(18, 18, Gravity.RIGHT | Gravity.BOTTOM, 2, 0, 2, 2))
    cell.setOnClickListener(OnClickListener(on_tap))
    return cell, badge


def _make_badge(ctx):
    badge = TextView(ctx)
    badge.setText("\u2713")
    badge.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
    badge.setGravity(Gravity.CENTER)
    badge.setTypeface(Typeface.DEFAULT_BOLD)
    badge.setBackground(Theme.createRoundRectDrawable(
        Theme.getColor(Theme.key_featuredStickers_buttonText), 9))
    badge.setTextColor(-1)
    return badge


def _make_std_emoji_cell(ctx, emoji, selected, on_tap):
    cell = FrameLayout(ctx)
    cell.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 18))
    if selected:
        cell.setBackground(Theme.createRoundRectDrawable(
            Theme.getColor(Theme.key_chat_inReactionButtonBackground), 18))
    tv = TextView(ctx)
    tv.setText(emoji)
    tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 24)
    tv.setGravity(Gravity.CENTER)
    cell.addView(tv, LayoutHelper.createFrame(32, 32, Gravity.CENTER))
    badge = None
    if selected:
        badge = _make_badge(ctx)
        cell.addView(badge, LayoutHelper.createFrame(18, 18, Gravity.RIGHT | Gravity.BOTTOM, 2, 0, 2, 2))
    cell.setOnClickListener(OnClickListener(on_tap))
    return cell, badge


def _make_cursor(ctx):
    cursor = TextView(ctx)
    cursor.setText("|")
    cursor.setTag("crr_cursor")
    cursor.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 24)
    cursor.setTypeface(Typeface.DEFAULT_BOLD)
    cursor.setGravity(Gravity.CENTER)
    cursor.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
    return cursor


class _PreviewLongPress(dynamic_proxy(View.OnLongClickListener)):
    def __init__(self_d, on_remove):
        super().__init__()
        self_d._on_remove = on_remove

    def onLongClick(self_d, v):
        try:
            self_d._on_remove()
            return True
        except Exception:
            return False


def _add_row(container, cells):
    row = LinearLayout(container.getContext())
    row.setOrientation(LinearLayout.HORIZONTAL)
    row.setGravity(Gravity.CENTER_VERTICAL)
    for c in cells:
        lp = LinearLayout.LayoutParams(0, dp(CELL_SIZE), 1.0)
        lp.setMargins(dp(2), dp(2), dp(2), dp(2))
        row.addView(c, lp)
    pad_count = COLS - len(cells)
    for _ in range(pad_count):
        spacer = View(container.getContext())
        lp = LinearLayout.LayoutParams(0, dp(CELL_SIZE), 1.0)
        lp.setMargins(dp(2), dp(2), dp(2), dp(2))
        row.addView(spacer, lp)
    container.addView(row, LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT))


def _show_reaction_picker(ctx, plugin_ref):
    try:
        emoji_packs = _get_emoji_packs_meta()
        try:
            acc = UserConfig.selectedAccount
        except Exception:
            acc = 0

        selected = _load_reactions()
        selected = [s for s in selected if s]

        tabs = []
        for i, pack in enumerate(emoji_packs):
            label = pack["title"]
            if len(label) > 18:
                label = label[:17] + "\u2026"
            tabs.append((label, "pack", i))
        std_emojis = _get_standard_emojis()
        tabs.insert(0, ("Standard", "std", -1))

        custom_cells = {}
        std_cells = {}
        status_tv = [None]
        current_tab = [0]
        preview_row_ref = [None]
        preview_scroll_ref = [None]
        ins_idx = [len(selected)]

        def update_status():
            if status_tv[0]:
                status_tv[0].setText(str(len(selected)))

        def scroll_cursor_into_view():
            try:
                ps = preview_scroll_ref[0]
                if ps is not None:
                    x = ins_idx[0] * dp(40) + dp(8)
                    ps.scrollTo(max(0, x - ps.getWidth() // 2), 0)
            except Exception:
                pass

        def render_preview():
            if preview_row_ref[0]:
                preview_row_ref[0].removeAllViews()
                if not selected:
                    hint = TextView(ctx)
                    hint.setText("Tap emoji to add \u2014 no limit")
                    hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                    hint.setGravity(Gravity.CENTER)
                    hint.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
                    preview_row_ref[0].addView(hint, LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT,
                        LinearLayout.LayoutParams.WRAP_CONTENT))
                else:
                    for idx, item in enumerate(selected):
                        if idx == ins_idx[0]:
                            preview_row_ref[0].addView(
                                _make_cursor(ctx), LinearLayout.LayoutParams(dp(14), dp(40)))
                        cell = _make_preview_item(ctx, item, acc, on_preview_tap, on_preview_remove)
                        preview_row_ref[0].addView(cell, LinearLayout.LayoutParams(dp(40), dp(40)))
                    if ins_idx[0] >= len(selected):
                        preview_row_ref[0].addView(
                            _make_cursor(ctx), LinearLayout.LayoutParams(dp(14), dp(40)))
                update_status()

        def refresh_highlights():
            sel_set = set(selected)
            for key, cell_data in std_cells.items():
                cell, badge = cell_data
                if key in sel_set:
                    cell.setBackground(Theme.createRoundRectDrawable(
                        Theme.getColor(Theme.key_chat_inReactionButtonBackground), 18))
                    if badge is not None:
                        badge.setVisibility(View.VISIBLE)
                else:
                    cell.setBackground(Theme.createSelectorDrawable(
                        Theme.getColor(Theme.key_listSelector), 18))
                    if badge is not None:
                        badge.setVisibility(View.GONE)
            for key, cell_data in custom_cells.items():
                cell, badge = cell_data
                doc_key = "doc:" + str(key)
                if doc_key in sel_set:
                    cell.setBackground(Theme.createRoundRectDrawable(
                        Theme.getColor(Theme.key_chat_inReactionButtonBackground), 18))
                    if badge is not None:
                        badge.setVisibility(View.VISIBLE)
                else:
                    cell.setBackground(Theme.createSelectorDrawable(
                        Theme.getColor(Theme.key_listSelector), 18))
                    if badge is not None:
                        badge.setVisibility(View.GONE)

        def on_preview_remove(item):
            try:
                p = selected.index(item)
            except ValueError:
                p = -1
            if p >= 0:
                selected.pop(p)
                if ins_idx[0] > p:
                    ins_idx[0] -= 1
            refresh_highlights()
            render_preview()

        def on_preview_tap(item):
            try:
                ins_idx[0] = selected.index(item)
            except ValueError:
                ins_idx[0] = 0
            render_preview()
            scroll_cursor_into_view()

        def on_custom_tap(doc_id):
            key = "doc:" + str(doc_id)
            if key in selected:
                on_preview_remove(key)
            else:
                pos = min(ins_idx[0], len(selected))
                selected.insert(pos, key)
                ins_idx[0] = pos + 1
                refresh_highlights()
                render_preview()
            scroll_cursor_into_view()

        def on_std_tap(emoji):
            key = "e:" + emoji
            if key in selected:
                on_preview_remove(key)
            else:
                pos = min(ins_idx[0], len(selected))
                selected.insert(pos, key)
                ins_idx[0] = pos + 1
                refresh_highlights()
                render_preview()
            scroll_cursor_into_view()

        root = LinearLayout(ctx)
        root.setOrientation(LinearLayout.VERTICAL)

        header = LinearLayout(ctx)
        header.setOrientation(LinearLayout.HORIZONTAL)
        header.setGravity(Gravity.CENTER_VERTICAL)
        header.setPadding(dp(20), dp(12), dp(20), dp(4))

        title_tv = TextView(ctx)
        title_tv.setText("Pick reactions")
        title_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
        title_tv.setTypeface(Typeface.DEFAULT_BOLD)
        title_tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))

        chip = TextView(ctx)
        chip.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        chip.setTypeface(Typeface.DEFAULT_BOLD)
        chip.setGravity(Gravity.CENTER)
        chip.setMinWidth(dp(34))
        chip.setPadding(dp(10), dp(3), dp(10), dp(3))
        chip.setTextColor(-1)
        chip.setBackground(Theme.createRoundRectDrawable(
            Theme.getColor(Theme.key_featuredStickers_buttonText), dp(12)))
        status_tv[0] = chip
        update_status()

        header.addView(title_tv)
        header.addView(View(ctx), LinearLayout.LayoutParams(0, 1, 1.0))
        header.addView(chip)
        root.addView(header, LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT))

        preview_container = FrameLayout(ctx)
        preview_container.setBackground(Theme.createRoundRectDrawable(
            Theme.getColor(Theme.key_chat_inReactionButtonBackground), dp(16)))
        preview_scroll = HorizontalScrollView(ctx)
        preview_scroll.setHorizontalScrollBarEnabled(False)
        preview_row = LinearLayout(ctx)
        preview_row.setOrientation(LinearLayout.HORIZONTAL)
        preview_row.setGravity(Gravity.CENTER_VERTICAL)
        preview_row.setPadding(dp(8), 0, dp(8), 0)
        preview_row_ref[0] = preview_row
        preview_scroll_ref[0] = preview_scroll
        preview_scroll.addView(preview_row)
        preview_container.addView(preview_scroll, FrameLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(44)))
        root.addView(preview_container, LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(52)))

        tabs_scroll = HorizontalScrollView(ctx)
        tabs_scroll.setHorizontalScrollBarEnabled(False)
        tabs_row = LinearLayout(ctx)
        tabs_row.setOrientation(LinearLayout.HORIZONTAL)
        tabs_row.setGravity(Gravity.CENTER_VERTICAL)
        tabs_row.setPadding(dp(6), dp(2), dp(6), dp(4))
        tab_views = []

        for i, (label, kind, pack_idx) in enumerate(tabs):
            tv = _make_tab_tv(ctx, label, i == current_tab[0])

            def on_tab_click(v, idx=i):
                current_tab[0] = idx
                for j, tab_tv in enumerate(tab_views):
                    if j == current_tab[0]:
                        tab_tv.setTypeface(Typeface.DEFAULT_BOLD)
                        tab_tv.setTextColor(-1)
                        tab_tv.setBackground(Theme.createRoundRectDrawable(
                            Theme.getColor(Theme.key_featuredStickers_addButton), dp(20)))
                    else:
                        tab_tv.setTypeface(Typeface.DEFAULT)
                        tab_tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                        gd = GradientDrawable()
                        gd.setColor(Theme.getColor(Theme.key_dialogBackground))
                        gd.setCornerRadius(dp(20))
                        gd.setStroke(dp(1), Theme.getColor(Theme.key_divider))
                        tab_tv.setBackground(gd)
                rebuild_grid()

            tv.setOnClickListener(OnClickListener(on_tab_click))
            tab_views.append(tv)
            tabs_row.addView(tv)

        tabs_scroll.addView(tabs_row)
        root.addView(tabs_scroll, LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT))

        scroll = ScrollView(ctx)
        grid_layout = LinearLayout(ctx)
        grid_layout.setOrientation(LinearLayout.VERTICAL)
        grid_layout.setPadding(dp(6), dp(4), dp(6), dp(8))
        scroll.addView(grid_layout)
        root.addView(scroll, LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, 0, 1.0))

        def rebuild_grid():
            grid_layout.removeAllViews()
            custom_cells.clear()
            std_cells.clear()
            if not tabs:
                hint = TextView(ctx)
                hint.setText("No custom emoji packs found")
                hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                hint.setGravity(Gravity.CENTER)
                hint.setPadding(0, dp(20), 0, 0)
                hint.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
                grid_layout.addView(hint)
                return
            _, kind, pack_idx = tabs[current_tab[0]]
            if kind == "std":
                row_cells = []
                for emoji in std_emojis:
                    key = "e:" + emoji
                    cell, badge = _make_std_emoji_cell(
                        ctx, emoji, key in selected,
                        lambda v, e=emoji: on_std_tap(e))
                    std_cells[key] = (cell, badge)
                    row_cells.append(cell)
                    if len(row_cells) == COLS:
                        _add_row(grid_layout, row_cells)
                        row_cells = []
                if row_cells:
                    _add_row(grid_layout, row_cells)
                return
            pack = emoji_packs[pack_idx]
            row_cells = []
            for doc_id in _get_pack_docs(pack):
                cell, badge = _make_custom_emoji_cell(
                    ctx, doc_id, acc, ("doc:" + str(doc_id)) in selected,
                    lambda v, d=doc_id: on_custom_tap(d))
                custom_cells[doc_id] = (cell, badge)
                row_cells.append(cell)
                if len(row_cells) == COLS:
                    _add_row(grid_layout, row_cells)
                    row_cells = []
            if row_cells:
                _add_row(grid_layout, row_cells)

        rebuild_grid()
        render_preview()

        class OnDone(dynamic_proxy(AlertDialog.OnButtonClickListener)):
            def __init__(self_d):
                super().__init__()

            def onClick(self_d, dialog, which):
                try:
                    _save_reactions(selected)
                except Exception:
                    pass

        builder = AlertDialog.Builder(ctx)
        builder.setView(root)
        builder.setPositiveButton("Done", OnDone())
        builder.setNegativeButton("Cancel", None)
        builder.show()

    except Exception:
        _log_err(plugin_ref, "CRR-PICKER-ERR")


class CustomRecentReactions(BasePlugin):

    def on_plugin_load(self):
        self._unhook_refs = []
        self._last_rcl = None
        self._last_delegate = None
        self._hooked_del_classes = set()
        self._panel_props_hid = 0
        self._props_clamped = 0
        self._fill_saved = {}
        self._plus_moved = False
        self._wrapped_pluses = set()
        self._height_was_bad = {}
        self._last_items = None
        # Track panels being set up to prevent double execution
        self._setup_pending = set()
        self._setup_complete = set()
        self._install_crash_handler()
        try:
            last = _prefs().getString("last_crash", None)
            if last:
                self.log("CRR-LAST-CRASH:\n" + str(last))
                _prefs().edit().remove("last_crash").apply()
        except Exception:
            pass
        self._setup_hook()

    def on_plugin_unload(self):
        for h in getattr(self, "_unhook_refs", []):
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._unhook_refs.clear()

    def _setup_hook(self):
        plugin_ref = self

        class Hook(MethodHook):
            def before_hooked_method(hook_self, param):
                try:
                    if not plugin_ref._is_enabled():
                        return
                    if param.thisObject is None:
                        return
                    t = get_private_field(param.thisObject, "type")
                    if t is not None and int(t) != 0:
                        return
                    if plugin_ref._is_channel_panel(param.thisObject):
                        return
                    new_list = _build_reactions_list(plugin_ref)
                    if new_list is None:
                        return
                    param.args[0] = new_list
                except Exception:
                    _log_err(plugin_ref, "CRR-HOOK-ERR")

            def after_hooked_method(hook_self, param):
                try:
                    if not plugin_ref._is_enabled():
                        return
                    if param.thisObject is None or param.args is None or len(param.args) == 0:
                        return
                    rcl = param.thisObject
                    plugin_ref._last_rcl = rcl
                    t = None
                    try:
                        t = get_private_field(rcl, "type")
                    except Exception:
                        t = None
                    if t is not None and int(t) != 0:
                        plugin_ref._last_rcl = None
                        return
                    if not plugin_ref._is_extra_row():
                        return
                    if plugin_ref._is_channel_panel(rcl):
                        return
                    full = param.args[0]
                    if full is None or full.size() <= 7:
                        return
                    try:
                        if not bool(rcl.showCustomEmojiReaction()):
                            return
                    except Exception:
                        pass
                    plugin_ref._build_extra_row(rcl, full)
                except Exception:
                    _log_err(plugin_ref, "CRR-EXTRA-ERR")

        class SetGlassBgHook(MethodHook):
            def after_hooked_method(hook_self, param):
                try:
                    rcl = param.thisObject
                    if rcl is None:
                        return
                    t = None
                    try:
                        t = get_private_field(rcl, "type")
                    except Exception:
                        t = None
                    if t is not None and int(t) != 0:
                        return
                    plugin_ref._last_rcl = rcl
                    glass = None
                    try:
                        glass = get_private_field(rcl, "glassBackground")
                    except Exception:
                        glass = None
                    if glass is None:
                        return
                    props = None
                    try:
                        props = get_private_field(glass, "boundProps")
                    except Exception:
                        props = None
                    if props is None:
                        return
                    plugin_ref._panel_props_hid = _identity_hash(props)
                except Exception as e:
                    plugin_ref.log("CRR-SETGLASS-ERR: " + repr(e))

        class RclDdHook(MethodHook):
            def _is_target(self, rcl):
                try:
                    if not plugin_ref._is_extra_row():
                        return False
                    if plugin_ref._is_channel_panel(rcl):
                        return False
                    last = plugin_ref._last_rcl
                    return last is not None and _identity_hash(last) == _identity_hash(rcl)
                except Exception:
                    return False

            def before_hooked_method(hook_self, param):
                try:
                    rcl = param.thisObject
                    if rcl is None:
                        return
                    glass = None
                    try:
                        glass = get_private_field(rcl, "glassBackground")
                    except Exception:
                        glass = None
                    if plugin_ref._panel_props_hid == 0 and glass is not None:
                        try:
                            props = get_private_field(glass, "boundProps")
                            if props is not None:
                                plugin_ref._panel_props_hid = _identity_hash(props)
                        except Exception:
                            pass
                    if not hook_self._is_target(rcl):
                        return
                    try:
                        if getattr(plugin_ref, "_plus_moved", False):
                            crc = get_private_field(rcl, "customReactionsContainer")
                            if crc is not None:
                                crc.setVisibility(View.INVISIBLE)
                    except Exception:
                        pass
                    bg = None
                    try:
                        bg = get_private_field(rcl, "bgPaint")
                    except Exception:
                        bg = None
                    if bg is None:
                        return
                    hid = _identity_hash(rcl)
                    if hid not in plugin_ref._fill_saved:
                        try:
                            plugin_ref._fill_saved[hid] = int(bg.getAlpha())
                        except Exception:
                            plugin_ref._fill_saved[hid] = 255
                    try:
                        canvas = param.args[0]
                        rect = None
                        try:
                            rect = get_private_field(rcl, "rect")
                        except Exception:
                            rect = None
                        if rect is not None:
                            target = float(AndroidUtilities.dp(20.0))
                            canvas.drawRoundRect(rect, target, target, bg)
                    except Exception:
                        pass
                    try:
                        bg.setAlpha(0)
                    except Exception:
                        pass
                except Exception:
                    pass

            def after_hooked_method(hook_self, param):
                try:
                    rcl = param.thisObject
                    if rcl is None:
                        return
                    hid = _identity_hash(rcl)
                    try:
                        if plugin_ref._is_extra_row() and hook_self._is_target(rcl):
                            plugin_ref._force_x_visible(rcl)
                            plugin_ref._sync_heights(rcl)
                    except Exception:
                        pass
                    if hid not in plugin_ref._fill_saved:
                        return
                    saved_alpha = plugin_ref._fill_saved.pop(hid)
                    bg = None
                    try:
                        bg = get_private_field(rcl, "bgPaint")
                    except Exception:
                        bg = None
                    if bg is None:
                        return
                    try:
                        bg.setAlpha(saved_alpha)
                    except Exception:
                        pass
                    if not hook_self._is_target(rcl):
                        return
                    try:
                        row2 = rcl.findViewWithTag("crr_row2")
                        plus = plugin_ref._get_plus_button(rcl)
                        if plus is not None and row2 is not None and _identity_hash(plus.getParent()) == _identity_hash(row2):
                            plus.setVisibility(View.VISIBLE)
                            plus.setTranslationX(0)
                            plus.setTranslationY(0)
                    except Exception:
                        pass
                except Exception:
                    pass

        class PropsBuildHook(MethodHook):
            def before_hooked_method(hook_self, param):
                try:
                    props = param.thisObject
                    if props is None:
                        return
                    if _identity_hash(props) != plugin_ref._panel_props_hid:
                        return
                    if plugin_ref._panel_props_hid == 0:
                        return
                    if not plugin_ref._is_extra_row():
                        return
                    target = float(AndroidUtilities.dp(4.0))
                    for arr_name in ("radii", "shaderRadii"):
                        arr = None
                        try:
                            arr = get_private_field(props, arr_name)
                        except Exception:
                            arr = None
                        if arr is None:
                            continue
                        try:
                            for i in range(len(arr)):
                                if float(arr[i]) > target:
                                    arr[i] = target
                        except Exception:
                            pass
                except Exception:
                    pass

        class CanvasRRHook(MethodHook):
            def before_hooked_method(hook_self, param):
                try:
                    args = param.args
                    if args is None or len(args) != 4:
                        return
                    if not plugin_ref._is_extra_row():
                        return
                    rcl = plugin_ref._last_rcl
                    if rcl is None:
                        return
                    rect = args[0]
                    rx = float(args[1])
                    target = float(AndroidUtilities.dp(4.0))
                    if rx <= target:
                        return
                    pr = None
                    try:
                        pr = get_private_field(rcl, "rect")
                    except Exception:
                        pr = None
                    if pr is None:
                        return
                    try:
                        close = (abs(float(rect.left) - float(pr.left)) <= 2.0 and
                                 abs(float(rect.top) - float(pr.top)) <= 2.0 and
                                 abs(float(rect.right) - float(pr.right)) <= 2.0 and
                                 abs(float(rect.bottom) - float(pr.bottom)) <= 2.0)
                    except Exception:
                        close = False
                    if not close:
                        return
                    canvas = param.thisObject
                    try:
                        canvas.drawRoundRect(rect, target, target, args[3])
                    except Exception:
                        return
                    try:
                        param.setResult(None)
                    except Exception:
                        pass
                except Exception:
                    pass

        try:
            from org.telegram.ui.Components import ReactionsContainerLayout as RCL
            java_cls = RCL.getClass()
            method = None
            list_cls = JClass.forName("java.util.List")
            for name in ["setVisibleReactionsList", "setReactionsList"]:
                if method:
                    break
                for params in [[list_cls, JBoolean.TYPE], [list_cls]]:
                    try:
                        method = java_cls.getDeclaredMethod(name, *params)
                        break
                    except Exception:
                        method = None
            if method:
                method.setAccessible(True)
                uh = self.hook_method(method, Hook())
                if uh:
                    self._unhook_refs.append(uh)
            else:
                self.log("Reaction hook method not found")
            try:
                set_glass = None
                for m in RCL.getClass().getDeclaredMethods():
                    try:
                        if m.getName() != "setGlassBackground" or len(m.getParameterTypes()) != 2:
                            continue
                        set_glass = m
                        break
                    except Exception:
                        continue
                if set_glass is not None:
                    set_glass.setAccessible(True)
                    uh = self.hook_method(set_glass, SetGlassBgHook())
                    if uh:
                        self._unhook_refs.append(uh)
                else:
                    self.log("setGlassBackground hook FAILED: not found")
            except Exception as e:
                self.log("setGlassBackground hook FAILED: " + repr(e))
            try:
                dd_method = None
                for m in RCL.getClass().getDeclaredMethods():
                    try:
                        if m.getName() != "dispatchDraw" or len(m.getParameterTypes()) != 1:
                            continue
                        dd_method = m
                        break
                    except Exception:
                        continue
                if dd_method is not None:
                    uh = self.hook_method(dd_method, RclDdHook())
                    if uh:
                        self._unhook_refs.append(uh)
                else:
                    self.log("rcl dispatchDraw hook FAILED: not found")
            except Exception as e:
                self.log("rcl dispatchDraw hook FAILED: " + repr(e))
            try:
                props_cls = JClass.forName(
                    "org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawable$Props")
                build_method = props_cls.getDeclaredMethod("build")
                uh = self.hook_method(build_method, PropsBuildHook())
                if uh:
                    self._unhook_refs.append(uh)
            except Exception as e:
                self.log("Props.build hook FAILED: " + repr(e))
            try:
                canvas_cls = JClass.forName("android.graphics.Canvas")
                rr_method = None
                for m in canvas_cls.getDeclaredMethods():
                    try:
                        if m.getName() != "drawRoundRect":
                            continue
                        pt = m.getParameterTypes()
                        if len(pt) == 4 and str(pt[0].getName()) == "android.graphics.RectF":
                            rr_method = m
                            break
                    except Exception:
                        continue
                if rr_method is not None:
                    uh = self.hook_method(rr_method, CanvasRRHook())
                    if uh:
                        self._unhook_refs.append(uh)
                else:
                    self.log("canvas drawRoundRect hook FAILED: not found")
            except Exception as e:
                self.log("canvas drawRoundRect hook FAILED: " + repr(e))
        except Exception:
            self.log("Hook setup err: " + traceback.format_exc())

    def _is_enabled(self):
        try:
            return bool(self.get_setting("enabled", True))
        except Exception:
            pass
        try:
            return bool(_prefs().getBoolean("enabled", True))
        except Exception:
            return True

    def _is_extra_row(self):
        try:
            return bool(self.get_setting("extra_row", False))
        except Exception:
            pass
        try:
            return bool(_prefs().getBoolean("extra_row", False))
        except Exception:
            return False

    def _is_show_standard(self):
        try:
            return bool(self.get_setting("show_standard", True))
        except Exception:
            pass
        try:
            return bool(_prefs().getBoolean("show_standard", True))
        except Exception:
            return True

    def _is_channel_panel(self, rcl):
        try:
            if _safe_bool(rcl, "channelReactions"):
                return True
        except Exception:
            pass
        try:
            mo = getattr(rcl, "messageObject", None)
            if mo is not None:
                owner = getattr(mo, "messageOwner", None)
                if owner is not None:
                    cid = getattr(owner, "chat_id", None)
                    if cid is not None and int(cid) < 0:
                        megagroup = False
                        try:
                            chat = getattr(owner, "chat", None)
                            if chat is not None:
                                megagroup = bool(chat.megagroup)
                        except Exception:
                            pass
                        if not megagroup:
                            try:
                                frag = get_private_field(rcl, "fragment")
                                if frag is not None and hasattr(frag, "getChat"):
                                    chat2 = frag.getChat()
                                    if chat2 is not None and hasattr(chat2, "megagroup"):
                                        megagroup = bool(chat2.megagroup)
                            except Exception:
                                pass
                        if not megagroup:
                            return True
        except Exception:
            pass
        return False

    def _set_radius(self, rcl, val):
        try:
            f = rcl.getClass().getDeclaredField("radius")
            f.setAccessible(True)
            f.setFloat(rcl, val)
        except Exception:
            pass

    def _set_x_hidden(self, rcl, val):
        try:
            f = rcl.getClass().getField("isHiddenNextReaction")
            f.setBoolean(rcl, bool(val))
        except Exception:
            try:
                f = rcl.getClass().getDeclaredField("isHiddenNextReaction")
                f.setAccessible(True)
                f.setBoolean(rcl, bool(val))
            except Exception:
                pass

    def _install_crash_handler(self):
        try:
            from java.lang import Thread
            ueh = None
            try:
                ueh = Thread.UncaughtExceptionHandler
            except Exception:
                ueh = None
            if ueh is None:
                try:
                    ueh = JClass.forName("java.lang.Thread$UncaughtExceptionHandler")
                except Exception:
                    ueh = None
            if ueh is None:
                return
            prev = None
            try:
                prev = Thread.getDefaultUncaughtExceptionHandler()
            except Exception:
                prev = None
            plugin_ref = self

            class _CrashHandler(dynamic_proxy(ueh)):
                def uncaughtException(self_d, thread, throwable):
                    try:
                        stack = ""
                        try:
                            sw = StringWriter()
                            throwable.printStackTrace(PrintWriter(sw))
                            stack = str(sw.toString())
                        except Exception:
                            pass
                        if not stack:
                            stack = str(throwable)
                        try:
                            plugin_ref.log("CRR-CRASH:\n" + stack)
                        except Exception:
                            pass
                        try:
                            _prefs().edit().putString("last_crash", stack).apply()
                        except Exception:
                            pass
                    except Exception:
                        pass
                    try:
                        if prev is not None:
                            prev.uncaughtException(thread, throwable)
                    except Exception:
                        pass

            Thread.setDefaultUncaughtExceptionHandler(_CrashHandler())
        except Exception:
            _log_err(self, "CRR-CRASH-HANDLER-ERR")

    def _wrap_plus_click(self, view, rcl):
        if view is None:
            return
        hid = _identity_hash(view)
        wrapped = getattr(self, "_wrapped_pluses", None)
        if wrapped is None:
            wrapped = set()
            self._wrapped_pluses = wrapped
        if hid in wrapped:
            return
        try:
            wrapped.add(hid)
            method = rcl.getClass().getDeclaredMethod("showCustomEmojiReactionDialog")
            method.setAccessible(True)
            plugin_ref = self

            def on_click(v):
                try:
                    method.invoke(rcl)
                except Exception as e:
                    _log_err(plugin_ref, "CRR-PLUS-CLICK")
                    try:
                        sw = StringWriter()
                        e.printStackTrace(PrintWriter(sw))
                        stack = str(sw.toString())
                        if stack:
                            plugin_ref.log("CRR-PLUS-STACK:\n" + stack)
                    except Exception:
                        pass

            view.setOnClickListener(OnClickListener(on_click))
        except Exception:
            _log_err(self, "CRR-PLUS-WRAP")

    def _force_x_visible(self, rcl):
        try:
            win = None
            try:
                win = get_private_field(rcl, "reactionsWindow")
            except Exception:
                win = None
            if win is not None:
                return
            try:
                x = rcl.nextRecentReaction
                if x is not None:
                    if x.getVisibility() != View.GONE:
                        x.setVisibility(View.GONE)
                    self._set_x_hidden(rcl, True)
            except Exception:
                pass
            x8 = None
            try:
                x8 = rcl.findViewWithTag("crr_x8")
            except Exception:
                x8 = None
            if x8 is None:
                return
            crc8 = None
            try:
                crc8 = get_private_field(rcl, "customReactionsContainer")
            except Exception:
                crc8 = None
            rv = None
            try:
                rv = rcl.recyclerListView
            except Exception:
                rv = None
            if crc8 is None or crc8.getWidth() <= 0 or crc8.getHeight() <= 0:
                if rv is None or rv.getChildCount() <= 7:
                    return
                crc8 = rv.getChildAt(7)
                if crc8 is None or crc8.getWidth() <= 0 or crc8.getHeight() <= 0:
                    return
            lp = x8.getLayoutParams()
            if lp is not None:
                new_l = int(rv.getLeft()) - int(rcl.getPaddingLeft()) + int(crc8.getLeft())
                new_t = int(rv.getTop()) - int(rcl.getPaddingTop()) + int(crc8.getTop())
                new_w = int(crc8.getWidth())
                new_h = int(crc8.getHeight())
                changed = (
                    int(lp.leftMargin) != new_l or int(lp.topMargin) != new_t or
                    int(lp.width) != new_w or int(lp.height) != new_h or
                    lp.gravity != (Gravity.TOP | Gravity.LEFT)
                )
                if changed:
                    lp.leftMargin = new_l
                    lp.topMargin = new_t
                    lp.width = new_w
                    lp.height = new_h
                    lp.gravity = Gravity.TOP | Gravity.LEFT
                    x8.setLayoutParams(lp)
            if x8.getVisibility() != View.VISIBLE:
                x8.setVisibility(View.VISIBLE)
        except Exception:
            pass

    def _sync_heights(self, rcl):
        try:
            rid = _identity_hash(rcl)
            
            # FIX: Don't do anything while setup is pending
            pending = getattr(self, "_setup_pending", set())
            if rid in pending:
                return
            
            items = getattr(self, "_last_items", None)
            if not items:
                return
            rv = None
            try:
                rv = rcl.recyclerListView
            except Exception:
                rv = None
            if rv is None:
                return
            try:
                if rcl.getPullingLeftProgress() > 0.0:
                    return
            except Exception:
                pass
            row2 = None
            try:
                row2 = rcl.findViewWithTag("crr_row2")
            except Exception:
                row2 = None
            state = getattr(self, "_row2_state", None)
            keys = self._vr_keys(items)
            stale = False
            if row2 is not None and state is not None:
                try:
                    if state.get(rid, None) != keys:
                        stale = True
                except Exception:
                    stale = True
            
            # FIX: Removed the direct call to _finish_extra_row here
            # This was causing double execution - let _build_extra_row handle it
            if row2 is None or stale:
                # Just return and wait for the scheduled _finish_extra_row
                return
            
            cache = getattr(self, "_row2_cache", None)
            if not self._cache_ok(cache):
                return
            rcl_h, row_h, btn_h, bottom_pad, cell_w, rv_top = cache
            
            # FIX: Check if row2 has been properly laid out
            # If row2 has zero dimensions, setup is still in progress
            try:
                row2_w = row2.getWidth() if row2 is not None else 0
                row2_h = row2.getHeight() if row2 is not None else 0
                if row2_w <= 0 or row2_h <= 0:
                    return  # Row2 not laid out yet, skip height fix
            except Exception:
                return
            
            was_bad = getattr(self, "_height_was_bad", {}).get(rid, False)
            rcl_ok = True
            try:
                if rcl.getHeight() > 0 and int(rcl.getHeight()) != int(rcl_h):
                    rcl_ok = False
            except Exception:
                pass
            rv_ok = True
            try:
                if rv.getHeight() > 0 and int(rv.getHeight()) != int(row_h):
                    rv_ok = False
            except Exception:
                pass
            bad = (not rcl_ok) or (not rv_ok)
            if bad and not was_bad:
                self._height_was_bad[rid] = True
                try:
                    rv_lp = rv.getLayoutParams()
                    rv_lp.height = int(row_h)
                    rv.setLayoutParams(rv_lp)
                except Exception:
                    pass
                try:
                    rcl_lp = rcl.getLayoutParams()
                    rcl_lp.height = int(rcl_h)
                    rcl.setLayoutParams(rcl_lp)
                except Exception:
                    pass
                try:
                    rcl.requestLayout()
                except Exception:
                    pass
                try:
                    rcl.getParent().requestLayout()
                except Exception:
                    pass
            elif not bad:
                self._height_was_bad[rid] = False
        except Exception:
            pass

    def _post_delayed(self, fn, ms):
        class _Runnable(dynamic_proxy(Runnable)):
            def run(self):
                self._fn()

        runner = _Runnable()
        runner._fn = fn
        Handler(Looper.getMainLooper()).postDelayed(runner, ms)

    def _vr_keys(self, vrs):
        keys = []
        for vr in vrs:
            try:
                e = getattr(vr, "emojicon", None)
                if e:
                    keys.append("e:" + str(e))
                else:
                    keys.append("d:" + str(_to_py_int(vr.documentId)))
            except Exception:
                keys.append("?")
        return keys

    def _build_extra_row(self, rcl, full):
        n = min(full.size(), 15)
        if n <= 7:
            return
        items = [full.get(i) for i in range(8, n)]
        try:
            self._x8_vr = full.get(7)
        except Exception:
            self._x8_vr = None
        state = getattr(self, "_row2_state", None)
        if state is None:
            state = {}
            self._row2_state = state
        if len(state) > 20:
            state.clear()
        rid = _identity_hash(rcl)
        keys = self._vr_keys(items)
        row2 = None
        try:
            row2 = rcl.findViewWithTag("crr_row2")
        except Exception:
            row2 = None

        # FIX: Mark this panel as having setup pending
        pending = getattr(self, "_setup_pending", set())
        pending.add(rid)
        self._setup_pending = pending
        
        # Clear any previous "bad height" state for this new panel
        height_was_bad = getattr(self, "_height_was_bad", {})
        if rid in height_was_bad:
            del height_was_bad[rid]
        
        if rid in state and state[rid] == keys and row2 is not None:
            self._last_items = items
            self._post_delayed(lambda: self._finish_extra_row(rcl, items, 0, True), 40)
            return
        self._last_items = items
        self._post_delayed(lambda: self._finish_extra_row(rcl, items), 40)

    def _reclip_row2(self, rcl):
        try:
            row2 = rcl.findViewWithTag("crr_row2")
            if row2 is None:
                return
            rad = float(AndroidUtilities.dp(16.0))
            gd = GradientDrawable()
            gd.setColor(0)
            gd.setCornerRadius(rad)
            row2.setBackground(gd)
            row2.setClipToOutline(True)
        except Exception:
            pass

    def _restore_row1(self, rcl):
        try:
            rv = rcl.recyclerListView
            if rv is None:
                return
            w = AndroidUtilities.dp(36.0)
            for i in range(rv.getChildCount()):
                c = rv.getChildAt(i)
                lp = c.getLayoutParams()
                if lp is None:
                    continue
                if lp.width != w or lp.leftMargin != 0:
                    lp.width = w
                    lp.leftMargin = 0
                    c.setLayoutParams(lp)
        except Exception:
            pass

    def _get_plus_button(self, rcl):
        try:
            return get_private_field(rcl, "customEmojiReactionsIconView")
        except Exception:
            return None

    def _move_plus_to_row2(self, rcl, row2, cell_w, btn_h):
        if row2 is None:
            return
        try:
            plus_cell = row2.findViewWithTag("crr_plus2_cell")
            if plus_cell is not None and _identity_hash(plus_cell.getParent()) == _identity_hash(row2):
                return
            ctx = rcl.getContext()
            iiv_cls = JClass.forName("org.telegram.ui.Components.ReactionsContainerLayout$InternalImageView")
            rcl_cls = JClass.forName("org.telegram.ui.Components.ReactionsContainerLayout")
            ctx_cls = JClass.forName("android.content.Context")
            ctor = iiv_cls.getDeclaredConstructor(rcl_cls, ctx_cls)
            ctor.setAccessible(True)
            plus2 = ctor.newInstance(rcl, ctx)
            plus2.setTag("crr_plus2")
            orig = self._get_plus_button(rcl)
            if orig is not None:
                try:
                    d = orig.getDrawable()
                    if d is not None:
                        plus2.setImageDrawable(d)
                except Exception:
                    pass
                try:
                    plus2.setScaleType(orig.getScaleType())
                except Exception:
                    pass
                try:
                    cf = orig.getColorFilter()
                    if cf is not None:
                        plus2.setColorFilter(cf)
                except Exception:
                    pass
            try:
                circle = GradientDrawable()
                circle.setShape(GradientDrawable.OVAL)
                c1 = Theme.getColor(Theme.key_actionBarDefaultSubmenuItemIcon)
                c2 = Theme.getColor(Theme.key_dialogBackground)
                circle.setColor(ColorUtils.blendARGB(c1, c2, 0.7))
                plus2.setBackground(circle)
            except Exception:
                pass
            dia = int(cell_w) - int(AndroidUtilities.dp(6.0))
            if dia < 20:
                dia = int(cell_w)
            # Wrap plus2 in a FrameLayout cell so Gravity.CENTER works
            # (row2 is a LinearLayout which ignores FrameLayout.LayoutParams gravity)
            plus_cell = FrameLayout(ctx)
            plus_cell.setTag("crr_plus2_cell")
            plus_cell.addView(plus2, FrameLayout.LayoutParams(dia, dia, Gravity.CENTER))
            row2.addView(plus_cell, FrameLayout.LayoutParams(cell_w, btn_h))
            plus2.setVisibility(View.VISIBLE)
            self._wrap_plus_click(plus2, rcl)
        except Exception:
            _log_err(self, "CRR-PLUS2-ERR")

    def _ensure_x8(self, rcl, ctx, cell_w, btn_h):
        try:
            x8 = rcl.findViewWithTag("crr_x8")
            if x8 is not None:
                return
            vr8 = getattr(self, "_x8_vr", None)
            if vr8 is None:
                return
            holder_cls = JClass.forName("org.telegram.ui.Components.ReactionsContainerLayout$ReactionHolderView")
            rcl_cls = JClass.forName("org.telegram.ui.Components.ReactionsContainerLayout")
            ctx_cls = JClass.forName("android.content.Context")
            ctor = holder_cls.getDeclaredConstructor(rcl_cls, ctx_cls, JBoolean.TYPE)
            set_reaction = holder_cls.getMethod("-$$Nest$msetReaction", holder_cls,
                                                JClass.forName("org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble$VisibleReaction"),
                                                JInteger.TYPE)
            x8h = ctor.newInstance(rcl, ctx, True)
            x8h.setTag("crr_x8")
            set_reaction.invoke(None, x8h, vr8, JInteger(-1))

            def _on_x8_click(v, h=x8h, r=rcl):
                try:
                    cr = getattr(h, "currentReaction", None)
                    if cr is not None:
                        r.onReactionClicked(v, cr, False)
                except Exception:
                    pass

            x8h.setOnClickListener(OnClickListener(_on_x8_click))
            lp = FrameLayout.LayoutParams(cell_w, btn_h, Gravity.TOP | Gravity.LEFT)
            rcl.addView(x8h, lp)
        except Exception:
            _log_err(self, "CRR-X8-ERR")

    def _plus_back_to_crc(self, rcl):
        try:
            crc = get_private_field(rcl, "customReactionsContainer")
            if crc is None:
                return
            plus = self._get_plus_button(rcl)
            if plus is None:
                return
            pp = plus.getParent()
            if pp is not None and _identity_hash(pp) != _identity_hash(crc):
                pp.removeView(plus)
            if plus.getParent() is None:
                crc.addView(plus, FrameLayout.LayoutParams(
                    AndroidUtilities.dp(30.0), AndroidUtilities.dp(30.0), Gravity.CENTER))
            crc.setVisibility(View.VISIBLE)
        except Exception:
            pass

    def _create_row2(self, rcl, items, cell_w, btn_h):
        try:
            ctx = rcl.getContext()
            row2 = LinearLayout(ctx)
            row2.setOrientation(LinearLayout.HORIZONTAL)
            row2.setTag("crr_row2")
            row2.setPadding(AndroidUtilities.dp(8.0), 0, 0, 0)
            holder_cls = JClass.forName("org.telegram.ui.Components.ReactionsContainerLayout$ReactionHolderView")
            rcl_cls = JClass.forName("org.telegram.ui.Components.ReactionsContainerLayout")
            vr_cls = JClass.forName("org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble$VisibleReaction")
            ctx_cls = JClass.forName("android.content.Context")
            ctor = holder_cls.getDeclaredConstructor(rcl_cls, ctx_cls, JBoolean.TYPE)
            set_reaction = holder_cls.getMethod("-$$Nest$msetReaction", holder_cls, vr_cls, JInteger.TYPE)
            for i, vr in enumerate(items):
                holder = ctor.newInstance(rcl, ctx, True)
                set_reaction.invoke(None, holder, vr, JInteger(i + 8))
                try:
                    def _on_row2_click(v, h=holder, r=rcl):
                        try:
                            cr = getattr(h, "currentReaction", None)
                            if cr is not None:
                                r.onReactionClicked(v, cr, False)
                        except Exception:
                            pass
                    holder.setOnClickListener(OnClickListener(_on_row2_click))
                except Exception:
                    pass
                row2.addView(holder, FrameLayout.LayoutParams(cell_w, btn_h))
            return row2
        except Exception:
            _log_err(self, "CRR-ROW2-ERR")
            return None

    def _cache_ok(self, cache):
        try:
            if cache is None:
                return False
            rcl_h, row_h, btn_h, bottom_pad, cell_w, rv_top = cache
            if btn_h <= 0 or cell_w <= 0:
                return False
            if btn_h > AndroidUtilities.dp(90.0) or cell_w > AndroidUtilities.dp(120.0):
                return False
            if rcl_h <= 0 or row_h <= 0 or rcl_h > AndroidUtilities.dp(800.0):
                return False
            if bottom_pad < 0 or bottom_pad > AndroidUtilities.dp(400.0):
                return False
            return True
        except Exception:
            return False

    def _instant_extra_row(self, rcl, items):
        # no-op: heights are applied only from measured values in _finish_extra_row
        return

    def _finish_extra_row(self, rcl, items, tries=0, skip_build=False):
        try:
            rid = _identity_hash(rcl)
            
            try:
                if not bool(rcl.isAttachedToWindow()):
                    # FIX: Clear pending state if panel is gone
                    pending = getattr(self, "_setup_pending", set())
                    pending.discard(rid)
                    return
            except Exception:
                pass
            rv = rcl.recyclerListView
            if rv is None:
                pending = getattr(self, "_setup_pending", set())
                pending.discard(rid)
                return
            if rcl.getPullingLeftProgress() > 0.0:
                if tries < 10:
                    self._post_delayed(lambda: self._finish_extra_row(rcl, items, tries + 1, skip_build), 60)
                return
            if not items:
                prev2 = rcl.findViewWithTag("crr_row2")
                if prev2 is not None:
                    try:
                        x = rcl.nextRecentReaction
                        if x is not None and x.getParent() == prev2:
                            prev2.removeView(x)
                            rcl.addView(x, FrameLayout.LayoutParams(AndroidUtilities.dp(36.0), -1))
                    except Exception:
                        pass
                    try:
                        rcl.removeView(prev2)
                    except Exception:
                        pass
                    try:
                        lp2 = rcl.getLayoutParams()
                        lp2.height = -2
                        rcl.setLayoutParams(lp2)
                        rcl.requestLayout()
                    except Exception:
                        pass
                try:
                    rcl.nextRecentReaction.setVisibility(View.GONE)
                    self._set_x_hidden(rcl, True)
                except Exception:
                    pass
                self._plus_back_to_crc(rcl)
                self._plus_moved = False
                self._restore_row1(rcl)
                self._post_delayed(lambda: self._restore_row1(rcl), 250)
                # FIX: Clear pending state
                pending = getattr(self, "_setup_pending", set())
                pending.discard(rid)
                return
            row_h = rv.getMeasuredHeight()
            h_cur = rcl.getMeasuredHeight()
            btn = rv.getChildAt(0) if rv.getChildCount() > 0 else None
            btn_h = btn.getHeight() if btn is not None else 0
            cell_w = AndroidUtilities.dp(36.0)
            if row_h <= 0 or h_cur <= 0 or btn_h <= 0:
                if tries < 6:
                    self._post_delayed(lambda: self._finish_extra_row(rcl, items, tries + 1, skip_build), 100)
                return
            if btn_h > AndroidUtilities.dp(90.0) or h_cur > AndroidUtilities.dp(800.0):
                if tries < 8:
                    self._post_delayed(lambda: self._finish_extra_row(rcl, items, tries + 1, skip_build), 100)
                return
            prev = rcl.findViewWithTag("crr_row2")
            state = getattr(self, "_row2_state", None)
            stale = False
            if prev is not None and state is not None:
                try:
                    if state.get(rid, None) != self._vr_keys(items):
                        stale = True
                except Exception:
                    stale = True
            if stale:
                try:
                    rcl.removeView(prev)
                except Exception:
                    pass
                try:
                    x8o = rcl.findViewWithTag("crr_x8")
                    if x8o is not None:
                        rcl.removeView(x8o)
                except Exception:
                    pass
                prev = None
            if prev is None and not skip_build:
                row2 = self._create_row2(rcl, items, cell_w, btn_h)
                if row2 is not None:
                    rcl.addView(row2, FrameLayout.LayoutParams(-2, btn_h, Gravity.BOTTOM))
            rv_top = rv.getTop()
            bottom_pad = h_cur - rv_top - row_h
            if bottom_pad <= 0 or bottom_pad > AndroidUtilities.dp(100.0):
                cache2 = getattr(self, "_row2_cache", None)
                if cache2 is not None:
                    bottom_pad = int(cache2[3])
                else:
                    bottom_pad = AndroidUtilities.dp(66.0)
            row2 = rcl.findViewWithTag("crr_row2")
            if row2 is None:
                pending = getattr(self, "_setup_pending", set())
                pending.discard(rid)
                return
            
            # FIX: Calculate row2_top based on CURRENT measurements, not affected by previous layouts
            # Use the initial native height to avoid accumulated offsets
            btn_top = btn.getTop() if btn is not None else 0
            row2_top = rv_top + btn_top + btn_h
            
            rv_lp = rv.getLayoutParams()
            rv_lp.height = row_h
            rv.setLayoutParams(rv_lp)
            
            # FIX: Calculate target height from scratch
            # Reduce the gap between rows — cells are tall (144px) but emojis are small and centered,
            # so overlapping cell boundaries brings the visible emojis closer together.
            row_gap_reduce = AndroidUtilities.dp(10.0)
            target_rcl_h = row2_top + btn_h + bottom_pad - row_gap_reduce
            
            rcl_lp = rcl.getLayoutParams()
            rcl_lp.height = target_rcl_h
            rcl.setLayoutParams(rcl_lp)
            rcl.requestLayout()
            try:
                rcl.getParent().requestLayout()
            except Exception:
                pass
            self._restore_row1(rcl)
            self._reclip_row2(rcl)
            self._move_plus_to_row2(rcl, row2, cell_w, btn_h)
            try:
                ctx = rcl.getContext()
            except Exception:
                ctx = None
            if ctx is not None:
                self._ensure_x8(rcl, ctx, cell_w, btn_h)
            self._plus_moved = True
            try:
                self._row2_cache = (int(target_rcl_h), int(row_h), int(btn_h),
                                    int(bottom_pad), int(cell_w), int(rv_top))
            except Exception:
                pass
            self._post_delayed(lambda: self._restore_row1(rcl), 250)
            self._post_delayed(lambda: self._reclip_row2(rcl), 250)
            self._last_rcl = rcl
            if state is not None:
                state[rid] = self._vr_keys(items)

            # FIX: Clear pending state AFTER successful setup
            pending = getattr(self, "_setup_pending", set())
            pending.discard(rid)
            
            # FIX: Mark this panel as setup complete
            complete = getattr(self, "_setup_complete", set())
            complete.add(rid)
            self._setup_complete = complete
            # Clean up old entries
            if len(complete) > 20:
                self._setup_complete = set()
                
        except Exception:
            _log_err(self, "CRR-EXTRA-ERR")
            # FIX: Clear pending state on error too
            try:
                rid = _identity_hash(rcl)
                pending = getattr(self, "_setup_pending", set())
                pending.discard(rid)
            except Exception:
                pass

    def _on_pick_click(self, view):
        try:
            ctx = view.getContext()
            run_on_ui_thread(lambda: _show_reaction_picker(ctx, self))
        except Exception:
            _log_err(self, "CRR-CLICK-ERR")

    def _on_enabled_change(self, new_value):
        _save_enabled(new_value)

    def _on_reset_click(self, view):
        _save_reactions(list(DEFAULT_EMOJI.split()))

    def create_settings(self):
        return [
            Header(text="Custom Recent Reactions"),
            Switch(
                key="enabled",
                text="Enable Custom Reactions",
                default=True,
                subtext="Replace the recent reactions in the quick panel with your custom set",
                on_change=self._on_enabled_change,
            ),
            Divider(),
            Text(
                text="Choose reactions",
                icon="msg_emoji_smiles",
                on_click=self._on_pick_click,
            ),
            Divider(),
            Switch(
                key="extra_row",
                text="Show one more row of reactions",
                default=False,
                subtext="Show up to 14 reactions in the panel instead of 7",
            ),
            Divider(),
            Switch(
                key="show_standard",
                text="Show standard reactions in the recent list",
                default=True,
                subtext="Append all standard reactions after your custom set",
            ),
            Divider(),
            Text(
                text="Reset to defaults",
                icon="msg_reset",
                red=True,
                on_click=self._on_reset_click,
            ),
            Divider(text="Tap pack emoji to insert at the cursor, tap preview to move it, long-press preview to remove."),
        ]


