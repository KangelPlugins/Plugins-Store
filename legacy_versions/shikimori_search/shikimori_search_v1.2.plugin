def _resolve_search_icon_id(ctx) -> int:
    try:
        rid = getattr(R_tg.drawable, "outline_header_search", 0) or getattr(R_tg.drawable, "msg_search", 0)
        if rid:
            return int(rid)
    except Exception:
        pass
    try:
        res = ctx.getResources()
        pkg = ctx.getPackageName()
        for name in _SEARCH_ICON_NAMES:
            rid = res.getIdentifier(name, "drawable", pkg)
            if rid != 0:
                return int(rid)
    except Exception:
        pass
    return 0

