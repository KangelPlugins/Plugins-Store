BASE_URL = "https://shikimori.one/api"
SITE_URL = "https://shikimori.one"
USER_AGENT = "exteraGramShikimoriPlugin/2.0"

STATUS_LABELS = {"anons": "Анонс", "ongoing": "Онгоинг", "released": "Вышло"}
STATUS_ICONS = {"anons": "🔜", "ongoing": "⏸", "released": "✅"}
STATUS_COLORS = {"anons": "#FFA726", "ongoing": "#66BB6A", "released": None}
KIND_LABELS = {
    "tv": "ТВ", "movie": "Фильм", "ova": "OVA", "ona": "ONA",
    "special": "Спешл", "tv_special": "ТВ-спешл", "music": "Клип"
}

DEFAULT_TIMEOUT = (5, 10)
PAGE_TIMEOUT = (5, 12)
SEARCH_LIMIT = 20
STATS_PAGE_LIMIT = 100
STATS_BATCH_SIZE = 4

SEARCH_TTL = 90
ANIME_TTL = 300
PROFILE_TTL = 45
POSTER_TTL = 600

SEARCH_DEBOUNCE_MS = 380

def _build_session() -> requests.Session:
    session = requests.Session()
    session.headers.update({"User-Agent": USER_AGENT, "Accept": "application/json"})
    try:
        from urllib3.util.retry import Retry
        retry = Retry(
            total=2,
            connect=2,
            read=1,
            backoff_factor=0.3,
            status_forcelist=(500, 502, 503, 504),
        )
        adapter = HTTPAdapter(pool_connections=8, pool_maxsize=16, max_retries=retry)
    except Exception:
        adapter = HTTPAdapter(pool_connections=8, pool_maxsize=16)
    session.mount("https://", adapter)
    session.mount("http://", adapter)
    return session

SESSION = _build_session()

_CACHE: dict = {}

def _cache_get(key, ttl: int):
    entry = _CACHE.get(key)
    if not entry:
        return None
    ts, value = entry
    if time.time() - ts > ttl:
        return None
    return value

def _cache_set(key, value):
    _CACHE[key] = (time.time(), value)
    if len(_CACHE) > 200:
        for k, _ in sorted(_CACHE.items(), key=lambda kv: kv[1][0])[:50]:
            _CACHE.pop(k, None)

def dp(value: float) -> int:
    return AndroidUtilities.dp(value)

@java_subclass(JObject, TextWatcher)
class _QueryWatcher(Base):
    def __init__(self, callback):
        self.callback = callback

    @joverride()
    def beforeTextChanged(self, s, start, count, after):
        pass

    @joverride()
    def onTextChanged(self, s, start, before, count):
        pass

    @joverride()
    def afterTextChanged(self, s):
        try:
            self.callback("" if s is None else str(s))
        except Exception:
            pass

class ShikimoriPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        try:
            self.search_menu_item_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="Поиск аниме",
                    on_click=self._handle_menu_search,
                    icon="msg_media",
                    subtext="Shikimori",
                    priority=5,
                )
            )
        except Exception as e:
            self.log(f"Не удалось добавить пункт меню: {e}")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Shikimori"),
            Input(
                key="nickname",
                text="Никнейм",
                default="",
                subtext="Ваш ник на Shikimori — нужен для команды .i",
                icon="settings_account",
            ),
            Text(
                text="Проверить никнейм",
                subtext="Проверка аккаунта на Shikimori",
                icon="menu_verification",
                on_click=self._manual_check_nickname,
            ),
            Text(
                text="Команды",
                subtext="Как искать аниме и смотреть статистику",
                icon="msg_help",
                on_click=self._show_help_dialog,
            ),
        ]

    def _show_help_dialog(self, view=None):
        self._show_dialog(
            "Команды",
            ".s <запрос> — открыть inline-поиск аниме "
            "(можно сразу с текстом или пустым полем)\n\n"
            ".i — ваша статистика (нужен никнейм в настройках)"
        )

    def _manual_check_nickname(self, view=None):
        nick = self.get_setting("nickname", "").strip()
        if not nick:
            self._show_dialog("Никнейм не указан", "Сначала введите его в поле выше")
            return
        run_on_queue(lambda: self._do_check_nickname(nick))

    def _do_check_nickname(self, nickname: str, silent: bool = False):
        try:
            data = self._api_get(f"/users/{nickname}", {"is_nickname": 1})
            if not data or not data.get("id"):
                if not silent:
                    self._show_dialog("Профиль не найден", f"На Shikimori нет пользователя «{nickname}»")
                return None
            if not silent:
                self._show_dialog("Всё в порядке", f"Профиль {data.get('nickname')} найден и доступен")
            return data
        except Exception as e:
            if not silent:
                self._show_dialog("Не удалось проверить", str(e))
            return None

    def _resolve_user_id(self):
        nick = self.get_setting("nickname", "").strip()
        return nick or None

    def _api_get(self, path: str, query: dict = None, timeout=DEFAULT_TIMEOUT) -> Any:
        url = f"{BASE_URL}{path}"
        if query:
            url += "?" + urlencode(query)
        resp = SESSION.get(url, timeout=timeout)
        resp.raise_for_status()
        return resp.json()

    def _bulletin_info(self, text: str):
        try:
            BulletinHelper.show_info(text)
        except Exception:
            pass

    def _bulletin_error(self, text: str):
        try:
            BulletinHelper.show_error(text)
        except Exception:
            pass

    def _send_formatted(self, peer_id: int, text: str, parse_mode: str = "HTML"):
        if not peer_id: return
        try:
            if parse_mode and parse_mode.upper() == "HTML":
                text_to_parse = _apply_custom_emoji(text)
            else:
                text_to_parse = text
            parsed = parse_text(text_to_parse, parse_mode=parse_mode)
            send_message({"peer": peer_id, "message": parsed["message"], "entities": parsed.get("entities")})
        except Exception:
            try: send_text(peer_id, text)
            except: pass

    def _show_dialog(self, title: str, message: str):
        def _do():
            try:
                frag = get_last_fragment()
                if not frag: return
                act = frag.getParentActivity()
                if not act: return
                b = AlertDialogBuilder(act)
                b.set_title(title); b.set_message(message); b.set_positive_button("OK", lambda b,w: b.dismiss())
                b.show()
            except: pass
        run_on_ui_thread(_do)

    def _format_anime(self, a: dict, anime_id: int = 0) -> str:
        title_ru = a.get("russian") or a.get("name") or "Без названия"
        year = ""
        aired = a.get("aired_on")
        if aired and len(str(aired)) >= 4:
            year = str(aired)[:4]
        status_key = a.get("status")
        status = STATUS_LABELS.get(status_key, status_key or "?")
        status_icon = STATUS_ICONS.get(status_key, "❔")
        kind = KIND_LABELS.get(a.get("kind"), a.get("kind") or "?")
        score = a.get("score") or 0
        ep_aired = a.get("episodes_aired") or 0
        ep_total = a.get("episodes") or 0

        lines = []
        lines.append(f"<b>{title_ru}</b>")
        lines.append("")
        lines.append(f"⭐ <b>Рейтинг:</b> {score}")
        lines.append(f"{status_icon} <b>Статус:</b> {status}")
        lines.append(f"📅 <b>Год:</b> {year or '—'}")
        lines.append(f"<emoji id=\"5447512780515078098\">🎬</emoji> <b>Тип:</b> {kind}")
        lines.append(f"📺 <b>Эпизоды:</b> {ep_aired}/{ep_total if ep_total else '?'}")

        card = f"<blockquote>{chr(10).join(lines)}</blockquote>"
        if anime_id:
            card += f"\n🔗 <a href='{SITE_URL}/animes/{anime_id}'>Открыть на Shikimori</a>"
        return card

    def _send_anime(self, peer_id: int, anime: dict):
        aid = anime.get("id", 0)
        caption = self._format_anime(anime, anime_id=aid)
        run_on_ui_thread(lambda: self._send_formatted(peer_id, caption, "HTML"))

    def _get_user_stats(self, nickname: str) -> dict:
        stats = {
            "watching": {"count": 0, "episodes": 0},
            "planned": {"count": 0, "episodes": 0},
            "rewatching": {"count": 0, "episodes": 0},
            "completed": {"count": 0, "episodes": 0},
            "on_hold": {"count": 0, "episodes": 0},
            "dropped": {"count": 0, "episodes": 0},
        }
        page = 1
        limit = STATS_PAGE_LIMIT

        def fetch_page(p: int):
            return self._api_get(
                f"/users/{nickname}/anime_rates",
                {"is_nickname": 1, "page": p, "limit": limit},
                timeout=PAGE_TIMEOUT,
            )

        with ThreadPoolExecutor(max_workers=STATS_BATCH_SIZE) as ex:
            while True:
                batch_pages = list(range(page, page + STATS_BATCH_SIZE))
                futures = {ex.submit(fetch_page, p): p for p in batch_pages}
                page_results, page_errors = {}, {}
                for fut in as_completed(futures):
                    p = futures[fut]
                    try:
                        page_results[p] = fut.result() or []
                    except Exception as e:
                        page_errors[p] = e

                stop = False
                for p in batch_pages:
                    if p in page_errors:
                        raise page_errors[p]
                    rates = page_results.get(p, [])
                    for rate in rates:
                        status = rate.get("status")
                        if status not in stats:
                            continue
                        stats[status]["count"] += 1
                        anime = rate.get("anime", {})
                        stats[status]["episodes"] += anime.get("episodes_aired", 0)
                    if len(rates) < limit:
                        stop = True
                        break
                if stop:
                    break
                page += STATS_BATCH_SIZE
        return stats

    def _cmd_profile(self, peer_id: int):
        nickname = self._resolve_user_id()
        if not nickname:
            run_on_ui_thread(lambda: self._send_formatted(
                peer_id,
                "❌ Укажите никнейм в настройках плагина",
                "HTML"
            ))
            return
        run_on_queue(lambda: self._fetch_profile(peer_id, nickname))

    def _fetch_profile(self, peer_id: int, nickname: str):
        try:
            cache_key = ("profile", nickname.lower())
            cached = _cache_get(cache_key, PROFILE_TTL)
            if cached:
                user, stats = cached
            else:
                self._bulletin_info("Загружаю статистику…")
                user = self._api_get(f"/users/{nickname}", {"is_nickname": 1})
                if not user or not user.get("id"):
                    run_on_ui_thread(lambda: self._send_formatted(
                        peer_id, f"❌ Профиль «{nickname}» не найден", "HTML"
                    ))
                    return
                stats = self._get_user_stats(nickname)
                _cache_set(cache_key, (user, stats))
            self._send_profile(peer_id, user, stats)
        except Exception as e:
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Ошибка: {e}", "HTML"))

    def _send_profile(self, peer_id: int, user: dict, stats: dict):
        total_count = sum(s["count"] for s in stats.values())
        total_episodes = sum(s["episodes"] for s in stats.values())

        status_map = {
            "watching": ("📺", "Смотрю"),
            "rewatching": ("🔄", "Пересматриваю"),
            "completed": ("✅", "Просмотрено"),
            "planned": ("📅", "В планах"),
            "on_hold": ("⏸", "Отложено"),
            "dropped": ("❌", "Брошено"),
        }

        lines = []
        lines.append(f"👤 <b>{user.get('nickname', 'Unknown')}</b>")
        if user.get("name"):
            lines.append(f"<i>{user['name']}</i>")
        lines.append("")

        shown_any = False
        for status, (icon, label) in status_map.items():
            data = stats.get(status, {"count": 0, "episodes": 0})
            if data["count"] > 0:
                lines.append(f"{icon} {label}: {data['count']} · {data['episodes']} эп.")
                shown_any = True
        if not shown_any:
            lines.append("<i>Список пуст</i>")

        lines.append("")
        lines.append(f"📊 Итого: {total_count} тайтлов, {total_episodes} серий")

        text = f"<blockquote expandable>{chr(10).join(lines)}</blockquote>"
        text += f"\n🔗 <a href='{SITE_URL}/{user['nickname']}'>Открыть профиль на Shikimori</a>"
        run_on_ui_thread(lambda: self._send_formatted(peer_id, text, "HTML"))

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        try:
            msg = getattr(params, "message", None)
            if not isinstance(msg, str): return HookResult()
            text = msg.strip()

            low = text.lower()

            if low == ".i":
                mode, arg = "i", ""
            elif low.startswith(".i "):
                peer = getattr(params, "peer", None) or getattr(params, "dialog_id", None)
                peer_id = self._extract_peer_id(peer)
                if peer_id:
                    run_on_ui_thread(lambda: self._send_formatted(peer_id, "❌ Команда .i не принимает аргументов. Используйте просто .i", "HTML"))
                return HookResult(strategy=HookStrategy.CANCEL)
            elif low == ".s" or low.startswith(".s "):
                mode, arg = "s", text[2:].strip()
            else:
                return HookResult()

            peer = getattr(params, "peer", None) or getattr(params, "dialog_id", None)
            peer_id = self._extract_peer_id(peer)
            if not peer_id: return HookResult()

            if mode == "s":
                run_on_ui_thread(lambda: self._open_inline_search(peer_id, arg))
                return HookResult(strategy=HookStrategy.CANCEL)

            if mode == "i":
                run_on_queue(lambda: self._cmd_profile(peer_id))
                return HookResult(strategy=HookStrategy.CANCEL)

            return HookResult()
        except:
            return HookResult()

    def _handle_menu_search(self, context: dict):
        try:
            peer_id = 0
            dialog_id = context.get("dialog_id")
            if isinstance(dialog_id, int):
                peer_id = dialog_id
            if not peer_id:
                user_id = context.get("userId")
                chat_id = context.get("chatId")
                if user_id:
                    peer_id = user_id
                elif chat_id:
                    peer_id = -chat_id
            if not peer_id:
                return
            self._open_inline_search(peer_id, "")
        except Exception as e:
            self.log(f"Не удалось открыть поиск из меню: {e}")

    def _extract_peer_id(self, peer) -> int:
        if peer is None: return 0
        if isinstance(peer, int): return peer
        try:
            uid = getattr(peer, "user_id", 0)
            if uid: return uid
            cid = getattr(peer, "chat_id", 0)
            if cid: return -cid
            chid = getattr(peer, "channel_id", 0)
            if chid: return -(1000000000000 + chid)
            return 0
        except:
            return 0

    def _search_animes(self, query: str, page: int = 1, limit: int = SEARCH_LIMIT) -> list:
        key = ("search", query.lower(), page, limit)
        cached = _cache_get(key, SEARCH_TTL)
        if cached is not None:
            return cached
        results = self._api_get("/animes", {"search": query, "limit": limit, "page": page}) or []
        _cache_set(key, results)
        return results

    def _search_with_fallback(self, query: str, page: int = 1) -> Tuple[list, str]:
        attempts = [query]
        stripped = query.strip(" .,!?-_\u2014\u2013\"'")
        if stripped and stripped != query:
            attempts.append(stripped)
        words = query.split()
        if len(words) > 1:
            attempts.append(" ".join(words[:-1]))
            if len(words) > 2:
                attempts.append(" ".join(words[:1]))

        seen = set()
        for q in attempts:
            q = q.strip()
            if not q or q in seen:
                continue
            seen.add(q)
            try:
                res = self._search_animes(q, page)
            except Exception:
                continue
            if res:
                return res, q
        return [], query

    def _cmd_info(self, peer_id: int, aid: int):
        try:
            cache_key = ("anime", aid)
            data = _cache_get(cache_key, ANIME_TTL)
            if data is None:
                self._bulletin_info(f"📥 Загружаю карточку #{aid}…")
                data = self._api_get(f"/animes/{aid}")
                if data and data.get("id"):
                    _cache_set(cache_key, data)
            if not data or not data.get("id"):
                run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Аниме с ID {aid} не найдено", "HTML"))
                return
            self._send_anime(peer_id, data)
        except Exception as e:
            run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Ошибка: {e}", "HTML"))

    def _load_poster_bitmap(self, url: str):
        if not url:
            return None
        key = ("poster", url)
        cached = _cache_get(key, POSTER_TTL)
        if cached is not None:
            return cached
        try:
            resp = SESSION.get(url, timeout=(6, 10))
            resp.raise_for_status()
            data = resp.content
            bmp = BitmapFactory.decodeByteArray(data, 0, len(data))
            if bmp is not None:
                _cache_set(key, bmp)
            else:
                self.log(f"Не удалось декодировать постер: {url}")
            return bmp
        except Exception as e:
            self.log(f"Ошибка загрузки постера {url}: {e}")
            return None

    def _rounded_background(self, color_hex: str, radius_dp: float) -> "GradientDrawable":
        d = GradientDrawable()
        d.setShape(GradientDrawable.RECTANGLE)
        d.setColor(AndroidColor.parseColor(color_hex))
        d.setCornerRadius(dp(radius_dp))
        return d

    def _theme_color(self, key_name: str, fallback_hex: str) -> int:
        try:
            key = getattr(Theme, key_name)
            return Theme.getColor(key)
        except Exception:
            return AndroidColor.parseColor(fallback_hex)

    def _status_color_hex(self, status_key: str) -> str:
        """Цвет для бейджа/плейсхолдера обложки по статусу тайтла.
        Для 'released' берём акцентный цвет темы (как у бейджа «Вышло»),
        чтобы плейсхолдер не выбивался из общей палитры чата."""
        if status_key == "released":
            try:
                accent_color = self._theme_color("key_dialogButtonSelector", "#5C9EFF")
                return "#" + format(accent_color & 0x00FFFFFF, '06x')
            except Exception:
                return "#5C9EFF"
        return STATUS_COLORS.get(status_key) or "#888888"

    # ---------- ИСПРАВЛЕННАЯ ЛОГИКА ОБОГАЩЕНИЯ ----------
    def _enrich_with_poster(self, item: dict) -> dict:
        aid = item.get("id")
        if not aid:
            return item

        # Проверяем, есть ли уже нормальная обложка
        image = item.get("image")
        has_poster = False
        if isinstance(image, dict):
            # Проверяем наличие хотя бы одного поля с URL
            for field in ("original", "preview", "x96", "small", "medium"):
                if image.get(field):
                    has_poster = True
                    break
        elif isinstance(image, str) and image.startswith("http"):
            has_poster = True

        if has_poster:
            return item  # уже есть

        # Иначе дозапрашиваем
        cache_key = ("anime_full", aid)
        full = _cache_get(cache_key, ANIME_TTL)
        if full is None:
            try:
                self.log(f"Загружаю полную карточку для #{aid}")
                full = self._api_get(f"/animes/{aid}")
                if full and full.get("id"):
                    _cache_set(cache_key, full)
            except Exception as e:
                self.log(f"Не удалось загрузить карточку #{aid}: {e}")
                return item

        # Обновляем только те поля, которых нет или они пустые
        for key, value in full.items():
            if key not in item:
                item[key] = value
            else:
                # Специальная обработка для image
                if key == "image" and value:
                    cur = item.get("image")
                    # Если текущее image пустое или не содержит ни одного URL, заменяем
                    if not cur or (isinstance(cur, dict) and not any(cur.get(f) for f in ("original", "preview", "x96"))):
                        item[key] = value
                # Для остальных полей: если текущее значение None или пустая строка/число 0, заменяем
                elif item.get(key) in (None, "", 0, [], {}):
                    item[key] = value
        return item

    def _make_result_cell(self, activity, item: dict, on_pick):
        # Обогащаем данными
        item = self._enrich_with_poster(item)

        ctx = activity
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        pad_v, pad_h = dp(8), dp(10)
        row.setPadding(pad_h, pad_v, pad_h, pad_v)

        card_bg = self._rounded_background("#00000000", 12)
        try:
            card_color = self._theme_color("key_windowBackgroundWhite", "#FFFFFF")
            card_bg.setColor(card_color)
        except Exception:
            pass
        row.setBackground(card_bg)

        lp_row = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
        lp_row.setMargins(0, dp(4), 0, dp(4))
        row.setLayoutParams(lp_row)

        poster = ImageView(ctx)
        poster.setScaleType(ImageView.ScaleType.CENTER_CROP)
        poster_bg = self._rounded_background("#22000000", 8)
        poster.setBackground(poster_bg)
        poster_lp = LinearLayout.LayoutParams(dp(48), dp(66))
        poster.setLayoutParams(poster_lp)
        row.addView(poster)

        # ---- Ищем URL постера ----
        poster_url = None
        image_data = item.get("image")
        if isinstance(image_data, dict):
            for field in ("original", "preview", "x96", "small", "medium"):
                val = image_data.get(field)
                if val:
                    poster_url = val
                    break
        elif isinstance(image_data, str):
            poster_url = image_data

        if not poster_url:
            poster_url = item.get("poster") or item.get("cover") or ""

        if poster_url and not poster_url.startswith("http"):
            poster_url = SITE_URL + poster_url

        # У Shikimori для тайтлов без обложки (обычно свежие «Анонс» и
        # некоторые «Онгоинг») API отдаёт не пустое поле, а служебную
        # заглушку — картинку с девочкой и надписью "404 not found".
        # Показывать её как настоящую обложку выглядит как баг, поэтому
        # распознаём такие ссылки по характерному пути и вместо загрузки
        # рисуем аккуратный цветной плейсхолдер под цвет статуса.
        is_placeholder = bool(poster_url) and any(
            marker in poster_url.lower() for marker in ("missing", "no_avatar", "404")
        )

        status_key_for_poster = item.get("status")
        if is_placeholder or not poster_url:
            placeholder_hex = self._status_color_hex(status_key_for_poster)
            soft_hex = "#33" + placeholder_hex.lstrip("#")
            poster.setBackground(self._rounded_background(soft_hex, 8))
        elif poster_url:
            def load():
                bmp = self._load_poster_bitmap(poster_url)
                if bmp is not None:
                    def apply():
                        try:
                            poster.setImageBitmap(bmp)
                        except Exception:
                            pass
                    run_on_ui_thread(apply)
            run_on_queue(load)

        # ---------- Текстовая часть ----------
        text_col = LinearLayout(ctx)
        text_col.setOrientation(LinearLayout.VERTICAL)
        text_lp = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0)
        text_lp.setMargins(dp(10), 0, 0, 0)
        text_col.setLayoutParams(text_lp)

        title = item.get("russian") or item.get("name") or "Без названия"
        title_view = TextView(ctx)
        title_view.setText(title)
        title_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        title_view.setMaxLines(2)
        try:
            title_view.setTextColor(self._theme_color("key_windowBackgroundWhiteBlackText", "#000000"))
        except Exception:
            pass
        text_col.addView(title_view)

        meta_row = LinearLayout(ctx)
        meta_row.setOrientation(LinearLayout.HORIZONTAL)
        meta_row.setGravity(Gravity.CENTER_VERTICAL)
        meta_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT)
        meta_lp.setMargins(0, dp(4), 0, 0)
        meta_row.setLayoutParams(meta_lp)

        # Бейдж статуса
        status_key = item.get("status")
        status_label = STATUS_LABELS.get(status_key, "")
        if status_label:
            badge = TextView(ctx)
            badge.setText(status_label)
            badge.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
            badge.setTextColor(AndroidColor.parseColor("#FFFFFF"))
            badge.setPadding(dp(6), dp(2), dp(6), dp(2))
            if status_key == "released":
                accent_color = self._theme_color("key_dialogButtonSelector", "#5C9EFF")
                accent_hex = "#" + format(accent_color & 0x00FFFFFF, '06x')
                badge.setBackground(self._rounded_background(accent_hex, 6))
            else:
                badge.setBackground(self._rounded_background(STATUS_COLORS.get(status_key, "#888888"), 6))
            badge_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT)
            badge_lp.setMargins(0, 0, dp(6), 0)
            badge.setLayoutParams(badge_lp)
            meta_row.addView(badge)

        def make_meta_text(text: str, icon_id: int = 0, tint_color: int = None):
            tv = TextView(ctx)
            tv.setText(text)
            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            try:
                color = tint_color if tint_color is not None else self._theme_color("key_windowBackgroundWhiteGrayText", "#888888")
                tv.setTextColor(color)
            except Exception:
                pass
            if icon_id:
                try:
                    drawable = ctx.getResources().getDrawable(icon_id, None)
                    if drawable is not None:
                        drawable = drawable.mutate()
                        try:
                            drawable.setTint(tint_color if tint_color is not None else self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
                        except Exception:
                            pass
                        size = dp(12)
                        drawable.setBounds(0, 0, size, size)
                        tv.setCompoundDrawables(drawable, None, None, None)
                        tv.setCompoundDrawablePadding(dp(4))
                except Exception:
                    pass
            return tv

        score = item.get("score") or 0
        if score:
            star_id = _resolve_star_icon_id(ctx)
            star_tv = make_meta_text(f"{score:.2f}" if isinstance(score, float) else str(score), star_id)
            meta_row.addView(star_tv)
            dot = TextView(ctx)
            dot.setText(" · ")
            dot.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            try:
                dot.setTextColor(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
            except Exception:
                pass
            meta_row.addView(dot)

        year = ""
        aired = item.get("aired_on")
        if aired and len(str(aired)) >= 4:
            year = str(aired)[:4]
        if year:
            cal_id = _resolve_calendar_icon_id(ctx)
            cal_tv = make_meta_text(year, cal_id)
            meta_row.addView(cal_tv)
            dot = TextView(ctx)
            dot.setText(" · ")
            dot.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            try:
                dot.setTextColor(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
            except Exception:
                pass
            meta_row.addView(dot)

        kind_short = KIND_LABELS.get(item.get("kind"), "") if item.get("kind") != "tv" else ""
        if kind_short:
            kind_tv = make_meta_text(kind_short)
            meta_row.addView(kind_tv)

        text_col.addView(meta_row)
        row.addView(text_col)

        row.setClickable(True)
        row.setOnClickListener(OnClickListener(lambda v: on_pick(item)))
        return row

    def _append_results(self, results, replace, activity, on_pick, results_col):
        def _do():
            try:
                if replace:
                    results_col.removeAllViews()
                for i, item in enumerate(results):
                    cell = self._make_result_cell(activity, item, on_pick)
                    results_col.addView(cell)
                    if i < len(results) - 1:
                        divider = View(activity)
                        divider.setLayoutParams(LinearLayout.LayoutParams(
                            LinearLayout.LayoutParams.MATCH_PARENT, dp(1)
                        ))
                        try:
                            divider.setBackgroundColor(self._theme_color("key_divider", "#DCDCDC"))
                        except Exception:
                            divider.setBackgroundColor(AndroidColor.parseColor("#DCDCDC"))
                        results_col.addView(divider)
                if len(results) >= SEARCH_LIMIT:
                    more_row = TextView(activity)
                    more_row.setText("Показать ещё ⌄")
                    more_row.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                    more_row.setGravity(Gravity.CENTER)
                    more_row.setPadding(0, dp(10), 0, dp(10))
                    try:
                        more_row.setTextColor(self._theme_color("key_windowBackgroundWhiteBlueText", "#4EA4F5"))
                    except Exception:
                        pass

                    def on_more(v):
                        try:
                            results_col.removeView(more_row)
                        except Exception:
                            pass
                        do_load_more()
                    more_row.setOnClickListener(OnClickListener(on_more))
                    results_col.addView(more_row)
            except Exception as e:
                self.log(f"Не удалось отрисовать результаты: {e}")
        run_on_ui_thread(_do)

    def _open_inline_search(self, peer_id: int, initial_query: str = ""):
        try:
            frag = get_last_fragment()
            if not frag: return
            activity = frag.getParentActivity()
            if not activity: return

            root = LinearLayout(activity)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(dp(16), dp(8), dp(16), dp(4))

            query_field = EditText(activity)
            query_field.setHint("Название аниме…")
            query_field.setSingleLine(True)
            query_field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
            query_field.setPadding(dp(14), dp(10), dp(14), dp(10))

            bg = GradientDrawable()
            bg.setShape(GradientDrawable.RECTANGLE)
            bg.setCornerRadius(dp(10))
            try:
                bg_color = self._theme_color("key_windowBackgroundWhite", "#FFFFFF")
                bg.setColor(bg_color)
            except Exception:
                bg.setColor(AndroidColor.parseColor("#FFFFFF"))
            try:
                stroke_color = self._theme_color("key_windowBackgroundWhiteGrayText", "#888888")
                bg.setStroke(dp(1), stroke_color)
            except Exception:
                pass
            query_field.setBackground(bg)

            try:
                _qf_icon_id = _resolve_search_icon_id(activity)
                if _qf_icon_id:
                    _qf_icon = activity.getResources().getDrawable(_qf_icon_id, None)
                    if _qf_icon is not None:
                        _qf_icon = _qf_icon.mutate()
                        try:
                            _qf_icon.setTint(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
                        except Exception:
                            pass
                        _qf_size = dp(20)
                        _qf_icon.setBounds(0, 0, _qf_size, _qf_size)
                        query_field.setCompoundDrawables(_qf_icon, None, None, None)
                        query_field.setCompoundDrawablePadding(dp(10))
            except Exception:
                pass

            try:
                query_field.setTextColor(self._theme_color("key_windowBackgroundWhiteBlackText", "#000000"))
                query_field.setHintTextColor(self._theme_color("key_windowBackgroundWhiteHintText", "#888888"))
                cursor_color = self._theme_color("key_windowBackgroundWhiteBlackText", "#000000")
                try:
                    query_field.setCursorVisible(True)
                    query_field.setTextCursorDrawable(None)
                except Exception:
                    pass
                try:
                    query_field.setHighlightColor((cursor_color & 0x00FFFFFF) | 0x55000000)
                except Exception:
                    pass
            except Exception:
                pass
            if initial_query:
                query_field.setText(initial_query)
                query_field.setSelection(len(initial_query))

            lp_field = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
            lp_field.setMargins(0, 0, 0, dp(8))
            root.addView(query_field, lp_field)

            status_view = TextView(activity)
            status_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            try:
                status_view.setTextColor(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
            except Exception:
                pass
            _status_icon_id = _resolve_status_icon_id(activity)
            _status_uses_icon = False
            if _status_icon_id:
                try:
                    _icon_drawable = activity.getResources().getDrawable(_status_icon_id, None)
                    if _icon_drawable is not None:
                        _size = dp(14)
                        _icon_drawable.setBounds(0, 0, _size, _size)
                        try:
                            _icon_drawable.setTint(self._theme_color("key_windowBackgroundWhiteGrayText", "#888888"))
                        except Exception:
                            pass
                        status_view.setCompoundDrawables(_icon_drawable, None, None, None)
                        status_view.setCompoundDrawablePadding(dp(6))
                        _status_uses_icon = True
                except Exception:
                    _status_uses_icon = False

            def _search_prefix(with_space: bool = True) -> str:
                if _status_uses_icon:
                    return ""
                return "🔍 " if with_space else "🔍"

            status_view.setText("Начните вводить название…")
            status_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
            status_lp.setMargins(dp(4), dp(6), dp(4), dp(6))
            root.addView(status_view, status_lp)

            scroll = ScrollView(activity)
            scroll_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(360))
            scroll.setLayoutParams(scroll_lp)
            results_col = LinearLayout(activity)
            results_col.setOrientation(LinearLayout.VERTICAL)
            scroll.addView(results_col)
            root.addView(scroll)

            builder = AlertDialogBuilder(activity)
            _search_icon_id = _resolve_search_icon_id(activity)
            if _search_icon_id:
                builder.set_title("Поиск аниме")
                try:
                    builder.set_icon(_search_icon_id)
                except Exception:
                    builder.set_title("Поиск аниме")
            else:
                builder.set_title("Поиск аниме")
            builder.set_view(root, -2)
            builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
            builder.set_cancelable(True)

            state = {"seq": 0, "runnable": None, "page": 1, "query": "", "used_query": "", "closed": False}

            def on_pick(item: dict):
                state["closed"] = True
                builder.dismiss()
                self._send_anime(peer_id, item)

            def set_status(text: str):
                def _do():
                    try:
                        status_view.setText(text)
                    except Exception:
                        pass
                run_on_ui_thread(_do)

            def clear_results():
                def _do():
                    try:
                        results_col.removeAllViews()
                    except Exception:
                        pass
                run_on_ui_thread(_do)

            def append_results(results: list, replace: bool):
                self._append_results(results, replace, activity, on_pick, results_col)

            def do_load_more():
                query = state["used_query"] or state["query"]
                if not query:
                    return
                next_page = state["page"] + 1
                set_status(f"{_search_prefix()}«{query}» · загружаю ещё…")

                def work():
                    try:
                        results = self._search_animes(query, next_page)
                    except Exception as e:
                        set_status(f"❌ Не удалось загрузить: {e}")
                        return
                    if state["closed"]:
                        return
                    if not results:
                        set_status(f"{_search_prefix()}«{query}» · больше результатов нет")
                        return
                    state["page"] = next_page
                    set_status(f"{_search_prefix()}«{query}» · страница {next_page}")
                    append_results(results, replace=False)

                run_on_queue(work)

            def run_search(query: str):
                if state["closed"]:
                    return
                query = query.strip()
                state["query"] = query
                if not query:
                    clear_results()
                    set_status("Начните вводить название…")
                    return
                set_status(f"{_search_prefix()}Ищу «{query}»…")

                def work():
                    try:
                        results, used_query = self._search_with_fallback(query, page=1)
                    except Exception as e:
                        if not state["closed"]:
                            set_status(f"❌ Ошибка поиска: {e}")
                        return
                    if state["closed"] or state["query"] != query:
                        return
                    state["page"] = 1
                    state["used_query"] = used_query
                    if not results:
                        clear_results()
                        site_url = f"{SITE_URL}/animes?" + urlencode({"search": query})
                        set_status(f"Ничего не найдено по «{query}». Открыть на сайте: {site_url}")
                        return
                    if used_query != query:
                        set_status(f"{_search_prefix()}«{used_query}» · похоже на «{query}» · {len(results)}")
                    else:
                        set_status(f"{_search_prefix()}«{used_query}» · найдено {len(results)}")
                    append_results(results, replace=True)

                run_on_queue(work)

            def schedule_search(text: str):
                state["seq"] += 1
                seq = state["seq"]
                if state["runnable"] is not None:
                    try:
                        query_field.removeCallbacks(state["runnable"])
                    except Exception:
                        pass

                def fire():
                    if state["seq"] == seq:
                        run_search(text)

                runnable = R(fire)
                state["runnable"] = runnable
                query_field.postDelayed(runnable, SEARCH_DEBOUNCE_MS)

            watcher = _QueryWatcher.new_instance(init_args=[schedule_search])
            query_field.addTextChangedListener(watcher.java)

            def on_dismiss(b):
                state["closed"] = True
            builder.set_on_dismiss_listener(on_dismiss)

            builder.show()

            if initial_query:
                run_search(initial_query)
            else:
                try:
                    query_field.requestFocus()
                except Exception:
                    pass
        except Exception as e:
            self.log(f"Inline-поиск недоступен, использую резервный вариант: {e}")
            self._fallback_search_dialog(peer_id, initial_query)

    def _fallback_search_dialog(self, peer_id: int, query: str):
        query = (query or "").strip()
        if not query:
            self._send_help_fallback(peer_id)
            return
        self._bulletin_info(f"🔍 Ищу «{query}»…")

        def work():
            try:
                results, used_query = self._search_with_fallback(query, page=1)
            except Exception as e:
                run_on_ui_thread(lambda: self._send_formatted(peer_id, f"❌ Ошибка поиска: {e}", "HTML"))
                return
            if not results:
                self._bulletin_error(f"Ничего не найдено по «{query}»")
                return
            self._show_fallback_results(peer_id, query, used_query, results)

        run_on_queue(work)

    def _show_fallback_results(self, peer_id: int, orig_query: str, used_query: str, results: list):
        names, ids = [], []
        for item in results:
            title = item.get("russian") or item.get("name") or "Без названия"
            year = ""
            aired = item.get("aired_on")
            if aired and len(str(aired)) >= 4: year = str(aired)[:4]
            icon = STATUS_ICONS.get(item.get("status"), "❔")
            score = item.get("score") or 0
            meta = f"📅 {year}" if year else "—"
            if score:
                meta += f" ⭐{score}"
            names.append(f"{icon} {meta}  ·  {title}")
            ids.append(item.get("id", 0))

        def on_click(bld, idx):
            bld.dismiss()
            run_on_queue(lambda: self._cmd_info(peer_id, ids[idx]))

        def show():
            try:
                frag = get_last_fragment()
                if not frag: return
                act = frag.getParentActivity()
                if not act: return
                b = AlertDialogBuilder(act)
                _fb_icon_id = _resolve_search_icon_id(act)
                if _fb_icon_id:
                    b.set_title(f"«{used_query}»  ·  {len(results)}")
                    try:
                        b.set_icon(_fb_icon_id)
                    except Exception:
                        b.set_title(f"«{used_query}»  ·  {len(results)}")
                else:
                    b.set_title(f"«{used_query}»  ·  {len(results)}")
                b.set_items(names, on_click)
                b.set_negative_button("Закрыть", lambda b,w: b.dismiss())
                b.show()
            except Exception as e:
                self._bulletin_error(f"Не удалось показать результаты: {e}")

        run_on_ui_thread(show)

    def _send_help_fallback(self, peer_id: int):
        text = (
            "<b>Shikimori Search</b>\n\n"
            ".s <запрос>  — поиск аниме\n"
            ".i           — статистика профиля (нужен никнейм в настройках)"
        )
        run_on_ui_thread(lambda: self._send_formatted(peer_id, text, "HTML"))