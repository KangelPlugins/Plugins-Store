def _wrap_custom_emoji(emoji_char: str) -> str:
    eid = CUSTOM_EMOJI_IDS.get(emoji_char)
    if not eid:
        return emoji_char
    return f'<emoji id="{eid}">{emoji_char}</emoji>'

def _apply_custom_emoji(text: str) -> str:
    if not text:
        return text
    if not any(ch in text for ch in CUSTOM_EMOJI_IDS):
        return text
    out = []
    i, n = 0, len(text)
    while i < n:
        if text.startswith("<emoji", i):
            end = text.find("</emoji>", i)
            if end != -1:
                end += len("</emoji>")
                out.append(text[i:end])
                i = end
                continue
        ch = text[i]
        if ch in CUSTOM_EMOJI_IDS:
            out.append(_wrap_custom_emoji(ch))
            i += 1
            continue
        out.append(ch)
        i += 1
    return "".join(out)

__id__ = "shikimori_search"
__name__ = "Shikimori Search"
__description__ = "Поиск аниме и статистика на Shikimori. Команды: .s — поиск, .i — профиль."
